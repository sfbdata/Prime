# Docker volumes e logs
/db_data/
/*.log

# Configurações de IDE
/.idea/
/.vscode/

# Histórico e cache locais
.bash_history
.composer/
/.cache/

# Dependências (instaladas via composer)
/vendor/
/app/vendor/

# Arquivos de ambiente com credenciais
/app/.env
.env.local
.env.*.local
.env.prod

# Uploads de usuários
/app/public/uploads/

# Cache e logs do Symfony
/app/var/cache/*
/app/var/log/*
!/app/var/cache/.gitkeep
!/app/var/log/.gitkeep

# Build context
.docker/

# Certificados TLS
/certs/*
!/certs/.gitkeep

# ACME challenge webroot
/certbot/*
!/certbot/.gitkeep
# mantém o dir do webroot no clone (necessário para o mount do nginx),
# mas ignora os tokens de desafio gerados pelo certbot
!/certbot/www/
/certbot/www/*
!/certbot/www/.gitkeep
# AdminLTE assets (baixar separadamente)
AdminLTE-4.0.0-rc4/
app/public/adminlte4/

# Artefatos de processo / relatórios de sessão
DAY*_COMPLETION_REPORT.md
HANDOFF_FINAL.md

# Exemplos e referências locais
/exemplo/

# Claude Code — configuração local
.claude/settings.local.json
.claude/settings.local.json.backup

# Pasta temporária (backups, restore prod→dev, dumps)
/tmp/
*:Zone.Identifier

# Documentos de contexto/relatório com dados sensíveis (PII, infra) — nunca versionar
dossie-system-overview.md
relatorio-commits-10-11-jun-2026.md
*.bak

# Flag de manutenção gerada pelo deploy (a página em si é versionada)
/nginx/maintenance/maintenance.on

# Snapshots/saída do Playwright MCP (descartável, fora do git)
/.playwright-mcp/
# Worktrees de frentes paralelas. `.claude/worktrees/` é o caminho que o Claude Code
# usa; estava coberto só por .git/info/exclude, que não é versionado e não sobrevive
# a um clone novo (aí as worktrees apareceriam como untracked no repo principal).
.worktrees/
/.claude/worktrees/
# Marcador da frente lido pelo hook pre-commit. É local por definição: diz de qual
# frente ESTA pasta é, e cada worktree tem o seu.
.frente

# Snapshots de prod usados como fixture de dev (contêm PII — nunca versionar)
/fixtures/

# Relatórios reais da fonte de importação de Cobranças (PII) — nunca versionar.
# `**/` cobre subpastas: sem ele, um arquivo colado em
# `docs/gestao-cobrancas/planilhas atualizadas/` escapava da regra.
docs/gestao-cobrancas/**/*.xlsx
docs/gestao-cobrancas/**/*.pdf
docs/gestao-cobrancas/*.xlsx
docs/gestao-cobrancas/*.pdf

# A pasta INTEIRA, e não só as extensões acima: em 03/08 um .txt derivado das planilhas (com nome de
# devedor e NN) caiu aqui e ficou versionável, porque a regra só olhava .xlsx/.pdf. Todo arquivo que
# nasce dessa pasta carrega a PII da fonte, seja qual for o formato.
docs/gestao-cobrancas/planilhas atualizadas/

# Destino designado para a saída de `app:cobranca:espelho:encargos --duplicadas` — a lista da
# reconciliação, que traz unidade + número do boleto e portanto identifica o devedor. Mesmo motivo da
# regra acima: em 03/08 uma saída derivada das planilhas ficou versionável porque não havia onde pôr.
# Redirecione para cá (`> docs/gestao-cobrancas/listas-reconciliacao/tl1.txt`) em vez de improvisar.
docs/gestao-cobrancas/listas-reconciliacao/

# Credenciais OAuth do cron de sincronização Drive (segredos) — só o .example é versionado
/.sync-oauth.env

# Superpowers (ledgers de execucao e mockups do brainstorm) — nao versionar
.superpowers/

# Artefatos temporários de smoke manual (Playwright fora da suíte e2e). Contêm credencial de dev
# e capturas de tela com dado real — nunca podem entrar na história.
/e2e/tmp-smoke/
/e2e/pw.smoke.tmp.config.js

# Credencial do sistema da contábil (groupcondominios). É senha de terceiro, em texto puro:
# nunca versionar. Se um dia entrar na história, não basta apagar — tem de trocar a senha.
docs/gestao-cobrancas/credencial.txt
docs/gestao-cobrancas/credencial*.txt

# Folhas de ponto exportadas para conferência manual (PDF). Trazem nome de funcionário e a jornada
# batida dia a dia — dado pessoal de terceiro. Ficam no disco de quem confere e nunca na história:
# depois de commitado, PII só sai reescrevendo o repositório inteiro.
docs/folha-de-ponto/

# Dumps do banco de PRODUÇÃO trazidos para ensaio/depuração. São a base real inteira: nome, CPF,
# endereço e dívida de gente de verdade. Nunca versionar — nem uma vez, porque depois de commitado
# só sai reescrevendo o repositório.
*.dump
prod-antes-*.dump

# Gravação da animação da tela de entrada: 1,3 MB de binário que não precisa
# entrar na história. O modelo aprovado (HTML + imagens) esse fica versionado.
docs/tela_login/*.mp4
