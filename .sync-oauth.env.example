# Credenciais OAuth do Google Drive usadas pelo cron de sincronização (Fase 1b).
#
# COMO USAR (na VPS):
#   cp .sync-oauth.env.example /opt/jusprime/.sync-oauth.env
#   # preencha os valores reais, depois:
#   chmod 600 /opt/jusprime/.sync-oauth.env
#
# NUNCA versionar o arquivo real (.sync-oauth.env está no .gitignore) — só este .example.
# Como gerar/obter os valores e publicar o app OAuth: docs/specs/sincronizacao-drive-bidirecional.md §21.
#
# O app OAuth deve estar PUBLICADO (status "Em produção" no Google Cloud) para o
# refresh_token não expirar (no modo "Teste" ele dura só ~7 dias).

GOOGLE_DRIVE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Folder id da raiz do acervo no Drive (não é um Shared Drive; é um folder id comum).
GOOGLE_DRIVE_SHARED_DRIVE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
