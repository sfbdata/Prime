# Copie para .env e ajuste. Lido por playwright.config.js.
# Senha do usuário dedicado de testes (e2e@jusprime.local). Obrigatória: sem ela o teste para.
# A migration Version20260508170000 só cria esse usuário em banco _test/_e2e ou com E2E_SEMEAR_USUARIO=1.
E2E_USER_PASSWORD=
# Banco que o localhost:8080 usa (o auth.setup.js preenche nele o gênero do usuário de testes).
# Vazio: lê o DATABASE_URL do app/.env.local da pasta principal, dentro do container.
# E2E_DB_NAME=saas_ux
