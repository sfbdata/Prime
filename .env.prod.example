# ===========================================
# BANCO DE DADOS
# ===========================================
POSTGRES_USER=symfony
POSTGRES_PASSWORD=troque_para_senha_forte
POSTGRES_DB=saas
DATABASE_URL=pgsql://symfony:troque_para_senha_forte@db:5432/saas

# ===========================================
# SYMFONY
# ===========================================
# Gere com: php bin/console security:generate-secret
APP_SECRET=troque_para_secret_forte_32_chars

# ===========================================
# MAILER
# ===========================================
# Exemplo Gmail:
# MAILER_DSN=smtp://usuario%40gmail.com:senha_app@smtp.gmail.com:587?encryption=tls&auth_mode=login
# Exemplo SMTP genérico:
# MAILER_DSN=smtp://usuario:senha@smtp.seuservidor.com:587?encryption=tls&auth_mode=login
MAILER_DSN=smtp://usuario:senha@smtp.seuservidor.com:587?encryption=tls&auth_mode=login
# Identidade institucional. MAILER_REPLY_TO vazio/ausente omite o cabeçalho com segurança.
MAILER_FROM="BlueJus <nao-responda@bluejus.com.br>"
MAILER_REPLY_TO=infra@bluejus.com.br
# Comercial e e-mails: cota da caixa (Hostinger Business Standard/Premium, 3.000 por caixa em 24 h corridas). Defaults
# em config/services.yaml: 10 por minuto, teto de 2.400 em 24 h corridas contando TODOS os e-mails, 1.600 deles para
# campanhas (a reserva dos demais é a diferença, 800) e aviso ao Master em 80% do teto.
# COMERCIAL_ENVIOS_POR_MINUTO=10
# COMERCIAL_TETO_DIARIO=2400
# COMERCIAL_TETO_DIARIO_CAMPANHAS=1600
# COMERCIAL_AVISO_DA_COTA_PERCENTUAL=80
# Rastreio de abertura e clique: só vale com a Política citando o rastreio (CITA_RASTREIO_DE_EMAIL).
# COMERCIAL_RASTREIO_LIGADO=false

# ===========================================
# DATAJUD
# ===========================================
DATAJUD_API_KEY=sua_chave_aqui
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ===========================================
# GOOGLE AGENDA (sincronia da Agenda com a conta Google de cada pessoa; spec docs/specs/agenda-google.md §6)
# Sem as duas do cliente OAuth, ou sem SYNC_CRYPTO_KEY, o painel mostra "indisponível".
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# Entrar com o Google na tela de login (spec docs/specs/entrar-com-google.md): credencial "Aplicativo da Web"
# própria, com o redirecionamento https://<domínio>/login/google/callback. Sem as duas, o botão não aparece.
GOOGLE_LOGIN_OAUTH_CLIENT_ID=
GOOGLE_LOGIN_OAUTH_CLIENT_SECRET=
# Continuar com Facebook na tela de login (spec docs/specs/login-cupom-e-facebook.md, PR B): app na Meta com o
# redirecionamento https://<domínio>/login/facebook/callback. Sem o ID e o segredo, o botão some e a rota dá 404.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
# Chave (base64 de 32 bytes) que cifra os tokens OAuth guardados (Drive e Agenda). Gerar: base64 de random_bytes(32).
SYNC_CRYPTO_KEY=
# ===========================================

# ===========================================
# GOOGLE DRIVE (sincronização — Fase 0)
# ===========================================
# Caminho do JSON da service account, montado read-only no container, FORA do git.
GOOGLE_DRIVE_CREDENTIALS=/run/secrets/google-drive-sa.json
# ID do Shared Drive "GRUPO PRIME" (capturar no Drive Compartilhado).
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# ===========================================
# APLICAÇÃO
# ===========================================
TZ=America/Sao_Paulo

# URL base da aplicação (usado para gerar links em e-mails)
# Sem TLS: http://IP_DO_SERVIDOR
# Com TLS: https://seudominio.com
DEFAULT_URI=http://IP_DO_SERVIDOR

# Proxy confiável: NENHUM na prática. O nginx fala com o php por FastCGI e já entrega o IP real do
# cliente em REMOTE_ADDR (fastcgi_params), então o php não precisa ler X-Forwarded-For. NÃO use
# REMOTE_ADDR nem private_ranges aqui: em FastCGI, REMOTE_ADDR é o próprio cliente, e confiar nele
# deixa qualquer um forjar o IP no X-Forwarded-For e furar os limitadores por IP (login, cadastro,
# convite, senha). 127.0.0.1 só existe para a variável não ficar vazia (scripts/go-live-check.sh).
SYMFONY_TRUSTED_PROXIES=127.0.0.1
# Valida o header Host (anti host-header-injection). Ajuste para o SEU domínio:
SYMFONY_TRUSTED_HOSTS='^(www\.)?seudominio\.com\.br$'

# BlueJus IA (Anthropic). A chave é gravada SÓ pelo dono, direto no .env.prod da VPS
# (runbook docs/runbooks/ligar-ia-em-producao.md). Vazia = IA dormente. O nome é ANTHROPIC_API_KEY
# (IA_API_KEY não é lido). O modelo inicial pode ser trocado depois pelo Master.
ANTHROPIC_API_KEY=
IA_MODELO=claude-haiku-5-5
IA_ESFORCO=medium
IA_HABILITADA=0

# Espelho dos arquivos no Cloudflare R2 (docs/specs/p2-gravacao-dupla.md). Tudo vazio = desligado.
# A cópia só liga com ARMAZENAMENTO_ESPELHO_CATEGORIAS preenchida (lista separada por vírgula, uma
# categoria por vez, na ordem da spec, §9: foto_perfil primeiro). Esvaziar a variável desliga na hora.
# A chave do R2 é restrita ao bucket dos arquivos e ao IP da VPS; nunca a do bucket de backup.
ESPELHO_R2_ENDPOINT=
ESPELHO_R2_BUCKET=
ESPELHO_R2_CHAVE=
ESPELHO_R2_SEGREDO=
ARMAZENAMENTO_ESPELHO_CATEGORIAS=
# Teto em bytes do cache de leitura do R2 (var/espelho-cache, na camada do contêiner: some no recreate).
# Opcional: sem a linha, vale 512 MB. Arquivo usado nos últimos 30 minutos não sai, então o cache pode
# passar do teto por pouco tempo.
# ESPELHO_CACHE_MAX_BYTES=536870912
