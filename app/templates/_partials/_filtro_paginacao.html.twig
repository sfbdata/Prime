{# ───────────────────────────────────────────────────────────────────────────
   Paginação genérica do fragmento de resultado. Fica DENTRO do
   [data-filtro-resultado], então re-renderiza a cada recarga. Os botões são
   delegados no root por public/js/filtro-tabela.js (classe .js-filtro-pagina).

   Parâmetros: pagina (1-based), total_paginas
─────────────────────────────────────────────────────────────────────────── #}
{% if total_paginas|default(1) > 1 %}
    <nav class="filtro-paginacao" aria-label="Paginação">
        <button type="button" class="btn btn-sm btn-outline-secondary js-filtro-pagina"
                data-page="{{ pagina - 1 }}" {{ pagina <= 1 ? 'disabled' : '' }} aria-label="Página anterior">
            <i class="bi bi-chevron-left"></i>
        </button>
        <span class="filtro-paginacao-info">{{ pagina }} / {{ total_paginas }}</span>
        <button type="button" class="btn btn-sm btn-outline-secondary js-filtro-pagina"
                data-page="{{ pagina + 1 }}" {{ pagina >= total_paginas ? 'disabled' : '' }} aria-label="Próxima página">
            <i class="bi bi-chevron-right"></i>
        </button>
    </nav>
{% endif %}
