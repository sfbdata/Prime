{# ── Modal: nova pasta ── #}
{# `desenho11` (só o Expediente, E12): a Nova Pasta do desenho 1.1 (dc L.265-279): 520px, cabeçalho azul que
   arrasta, o próximo número (só informativo; o servidor numera de novo ao salvar), cliente obrigatório com
   sugestões e a ação liberada depois do cliente. O envio é o mesmo nas duas variantes (script abaixo). #}
{% set desenho11 = desenho11 ?? false %}
<div class="modal fade{{ desenho11 ? ' exp-nova' }}"{% if desenho11 %} data-fica-na-lista="1"{% endif %} id="modalNovaPasta" tabindex="-1" aria-labelledby="modalNovaPastaLabel" aria-hidden="true"
     {% if desenho11 %}data-url-sugestoes="{{ path('expediente_nova_pasta_sugestoes') }}"{% endif %}>
    <div class="modal-dialog modal-dialog-centered" style="max-width:{{ desenho11 ? 'min(520px, calc(100vw - 32px))' : '480px' }};">
        <div class="modal-content">
            {% if desenho11 %}
            <div class="exp-nova-cab js-nova-arrastar">
                <i class="bi bi-folder-plus" aria-hidden="true"></i>
                <span class="exp-nova-titulo" id="modalNovaPastaLabel">Nova Pasta</span>
                <button type="button" class="exp-nova-x" data-bs-dismiss="modal" aria-label="Fechar" data-tip="Fechar"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            {% else %}
            <div class="modal-header py-2">
                <h6 class="modal-title" id="modalNovaPastaLabel">
                    <i class="bi bi-folder-plus me-1"></i> Nova Pasta
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            {% endif %}
            <form method="post" action="{{ path('pasta_new') }}" id="form-nova-pasta-modal">
                {% if desenho11 %}
                <div class="exp-nova-corpo">
                    <div class="exp-nova-info"><i class="bi bi-info-circle" aria-hidden="true"></i><span>O número da pasta é gerado automaticamente pelo sistema.</span><span class="exp-nova-prox js-nova-prox"></span></div>
                    <label class="exp-nova-campo">
                        <span>NOME DO CLIENTE <span class="exp-nova-obrig">*</span></span>
                        <input type="text" id="modal_nome_cliente" name="nome_cliente" list="expNovaClientes" autocomplete="off" required placeholder="Digite o nome do cliente">
                        <datalist id="expNovaClientes"></datalist>
                        <span class="exp-nova-existe js-nova-existe" hidden><i class="bi bi-people" aria-hidden="true"></i> <span></span></span>
                    </label>
                    <label class="exp-nova-campo exp-nova-campo--acao">
                        <span>NOME DA AÇÃO</span>
                        <input type="text" id="modal_nome_acao" name="nome_acao" autocomplete="off" disabled placeholder="Informe primeiro o nome do cliente">
                    </label>
                    <div id="modalNovaPastaErro" class="text-danger small" style="display:none;"></div>
                </div>
                <div class="exp-nova-rodape">
                    <button type="button" class="exp-btn exp-btn--cinza" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="exp-btn exp-btn--azul js-nova-salvar" disabled><i class="bi bi-check-lg" aria-hidden="true"></i>Salvar</button>
                </div>
                {% else %}
                <div class="modal-body py-3">

                    {# O número da pasta saiu daqui de propósito (R1): é sequência interna do
                       escritório e o sistema atribui sozinho o próximo livre. Digitá-lo à mão
                       gerava colisão quando duas pessoas criavam a mesma pasta ao mesmo tempo. #}
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        O número da pasta é gerado automaticamente pelo sistema.
                    </p>

                    <div class="mb-3">
                        <label for="modal_nome_cliente" class="form-label form-label-sm">Nome do cliente</label>
                        <input type="text" id="modal_nome_cliente" name="nome_cliente"
                               class="form-control form-control-sm" autocomplete="off">
                    </div>

                    <div class="mb-3">
                        <label for="modal_nome_acao" class="form-label form-label-sm">Nome da Ação</label>
                        <input type="text" id="modal_nome_acao" name="nome_acao"
                               class="form-control form-control-sm" autocomplete="off">
                    </div>

                    <div id="modalNovaPastaErro" class="text-danger small mt-1" style="display:none;"></div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
                {% endif %}
            </form>
        </div>
    </div>
</div>

{# ── Modal: aviso de pasta parecida (D12.5) ── conteúdo injetado via AJAX pelo PastaController.
   O aviso deixou de ser página inteira; agora abre sobre a tela de nova pasta. #}
<div class="modal fade" id="modalAvisoDuplicada" tabindex="-1" aria-labelledby="modalAvisoDuplicadaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:620px;">
        <div class="modal-content" id="avisoDuplicadaConteudo"></div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('form-nova-pasta-modal');
    if (!form) { return; }

    var novaEl     = document.getElementById('modalNovaPasta');
    var novaErro   = document.getElementById('modalNovaPastaErro');
    var avisoEl    = document.getElementById('modalAvisoDuplicada');
    var avisoMiolo = document.getElementById('avisoDuplicadaConteudo');

    function mostrarErro(box, msg) {
        if (!box) { return; }
        box.textContent = msg;
        box.style.display = '';
    }
    function limparErro(box) {
        if (!box) { return; }
        box.textContent = '';
        box.style.display = 'none';
    }

    function fecharModais() {
        [novaEl, avisoEl].forEach(function (m) {
            var inst = m && window.bootstrap ? bootstrap.Modal.getInstance(m) : null;
            if (inst) { inst.hide(); }
        });
    }

    // POST via fetch. O controller responde JSON {status: ok|duplicada|erro} quando é AJAX.
    // erroBox = onde mostrar a falha (tem de ser a modal VISÍVEL no momento do envio).
    function enviar(dados, erroBox) {
        return fetch(form.getAttribute('action'), {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: dados,
        }).then(function (resp) {
            return resp.json().catch(function () { return {}; });
        }).then(function (json) {
            if (json.status === 'ok' && json.redirect) {
                // No Expediente (desenho 03, dc `salvarNovaFn`) a pasta nova entra na lista, que volta ao NUP do
                // maior para o menor na página 1, com o aviso "Pasta N aberta para CLIENTE". Fora dele, abre a pasta.
                if (novaEl && novaEl.getAttribute('data-fica-na-lista') === '1' && json.nup) {
                    fecharModais();
                    document.dispatchEvent(new CustomEvent('exp:pasta-criada', { detail: { nup: json.nup, cliente: json.cliente || '' } }));
                    form.reset();
                    return;
                }
                window.location = json.redirect;
                return;
            }
            if (json.status === 'duplicada') {
                avisoMiolo.innerHTML = json.html || '';
                var abrirAviso = function () { bootstrap.Modal.getOrCreateInstance(avisoEl).show(); };
                // Fecha a modal de nova pasta e só abre a de aviso QUANDO ela terminou de sumir
                // (o hidden.bs.modal). Mostrar as duas juntas deixa o backdrop preso — bug clássico
                // de modais empilhadas no Bootstrap.
                var instNova = novaEl ? bootstrap.Modal.getInstance(novaEl) : null;
                if (instNova) {
                    novaEl.addEventListener('hidden.bs.modal', function once() {
                        novaEl.removeEventListener('hidden.bs.modal', once);
                        abrirAviso();
                    });
                    instNova.hide();
                } else {
                    abrirAviso();
                }
                return;
            }
            mostrarErro(erroBox, (json && json.mensagem) ? json.mensagem : 'Não foi possível criar a pasta.');
        }).catch(function () {
            mostrarErro(erroBox, 'Falha de conexão ao criar a pasta. Tente de novo.');
        });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        limparErro(novaErro);
        enviar(new FormData(form), novaErro);
    });

    // "Criar mesmo assim" está no HTML injetado — captura por delegação e reenvia com confirmar=1.
    if (avisoEl) {
        avisoEl.addEventListener('click', function (e) {
            var btn = e.target.closest('#btnCriarDuplicadaMesmoAssim');
            if (!btn) { return; }
            e.preventDefault();
            var avisoErro = document.getElementById('avisoDuplicadaErro');
            limparErro(avisoErro);
            btn.disabled = true;
            var fd = new FormData();
            fd.append('nome_cliente', btn.getAttribute('data-nome-cliente') || '');
            fd.append('nome_acao', btn.getAttribute('data-nome-acao') || '');
            fd.append('confirmar', '1');
            enviar(fd, avisoErro).then(function () { btn.disabled = false; });
        });
    }
})();
</script>
