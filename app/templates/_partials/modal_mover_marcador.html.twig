{#
    Partial: modal_mover_marcador.html.twig
    Parametros:
      - todosMarcadores: lista de marcadores do tenant
      - urlPastaMarcadores: URL base da rota expediente_pasta_marcadores com id=0
      - delegateSelector: seletor CSS do container pai dos botoes js-mover-para (null = document)
      - onSucessoCallback: nome de funcao JS global chamada apos salvar, recebe (data, escHtml)
                           se omitido, apenas fecha o modal e atualiza data-marcadores-ativos
#}
<div class="modal fade" id="modalMoverPara" tabindex="-1" aria-labelledby="modalMoverParaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="modalMoverParaLabel">
                    <i class="bi bi-tags me-1"></i> Marcadores da pasta
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <input type="hidden" id="moverParaPastaId">
                <input type="hidden" id="moverParaCsrfToken">

                {# Cabeçalho com nome da pasta e busca #}
                <div class="px-3 pt-3 pb-2 border-bottom">
                    <p class="text-muted small mb-2 lh-sm">
                        <i class="bi bi-folder2 me-1"></i><strong id="moverParaPastaNome"></strong>
                    </p>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-body border-end-0 pe-1">
                            <i class="bi bi-search text-muted" style="font-size:.8rem;"></i>
                        </span>
                        <input type="text" id="moverParaBusca" class="form-control border-start-0 ps-1"
                               placeholder="Buscar marcador…" autocomplete="off">
                        <button type="button" class="btn btn-outline-secondary border-start-0" id="moverParaBuscaLimpar"
                                style="display:none;" title="Limpar busca">
                            <i class="bi bi-x" style="font-size:.8rem;"></i>
                        </button>
                    </div>
                </div>

                {# Lista de marcadores #}
                <div id="moverParaLista" style="max-height:340px;overflow-y:auto;padding:6px 10px;"></div>

                {# Estado vazio #}
                <div id="moverParaVazio" class="text-muted small text-center py-4 px-3" style="display:none;">
                    <i class="bi bi-tags d-block mb-1" style="font-size:1.6rem;opacity:.3;"></i>
                    <span id="moverParaVazioTexto">Nenhum marcador criado ainda.</span>
                </div>

                <div id="moverParaErro" class="text-danger small px-3 pt-2" style="display:none;"></div>
            </div>
            <div class="modal-footer py-2 justify-content-between align-items-center">
                <span class="text-muted small" id="moverParaContador" style="display:none;"></span>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnSalvarMoverPara">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ── Scroll da lista ──────────────────────────────────────────── */
#moverParaLista::-webkit-scrollbar { width: 4px; }
#moverParaLista::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 4px; }

/* ── Item de marcador (chip clicável) ─────────────────────────── */
.mover-chip-wrap {
    margin-bottom: 3px;
}

.mover-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px 7px 6px;
    border-radius: 8px;
    border: 1.5px solid transparent;
    cursor: pointer;
    user-select: none;
    transition: background .12s, border-color .12s, box-shadow .12s;
    position: relative;
    background: var(--bs-tertiary-bg);
}

.mover-chip:hover {
    background: var(--bs-secondary-bg);
    border-color: var(--bs-border-color);
}

/* Estado selecionado */
.mover-chip.selecionado {
    border-color: #0d6efd;
    box-shadow: 0 0 0 3px rgba(13,110,253,.10);
}

/* Stripe colorida à esquerda */
.mover-chip-stripe {
    width: 4px;
    min-height: 28px;
    border-radius: 3px;
    flex-shrink: 0;
    align-self: stretch;
}

/* Ícone do marcador */
.mover-chip-icon {
    font-size: .82rem;
    flex-shrink: 0;
    opacity: .8;
}

/* Nome */
.mover-chip-nome {
    flex: 1;
    min-width: 0;
    font-size: .85rem;
    font-weight: 500;
    color: var(--bs-body-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Badge com contagem de filhos */
.mover-chip-count {
    font-size: .68rem;
    color: var(--bs-secondary-color);
    background: var(--bs-border-color);
    border-radius: 10px;
    padding: 1px 6px;
    flex-shrink: 0;
    transition: background .12s, color .12s;
}
.mover-chip.selecionado .mover-chip-count {
    background: rgba(13,110,253,.12);
    color: #0d6efd;
}

/* Chevron expandir sub-marcadores */
.mover-chip-chevron {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-size: .72rem;
    color: var(--bs-secondary-color);
    transition: background .1s, color .1s, transform .18s;
    cursor: pointer;
    margin-left: -4px;
}
.mover-chip-chevron:hover { background: rgba(0,0,0,.08); color: var(--bs-body-color); }
.mover-chip-chevron.expandido { transform: rotate(90deg); }

/* Ícone de check (aparece quando selecionado) */
.mover-chip-check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--bs-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .72rem;
    color: transparent;
    transition: background .15s, border-color .15s, color .15s;
    background: var(--bs-body-bg);
}
.mover-chip.selecionado .mover-chip-check {
    background: #0d6efd;
    border-color: #0d6efd;
    color: #fff;
}

/* Checkbox oculto mas funcional */
.mover-para-cb {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
}

/* ── Grupo de filhos ──────────────────────────────────────────── */
.mover-grupo-filhos {
    overflow: hidden;
    padding-left: 14px;
    border-left: 2px solid var(--bs-border-color);
    margin-left: 18px;
    margin-bottom: 3px;
}
.mover-grupo-filhos.oculto { display: none; }

.mover-chip.filho {
    background: var(--bs-body-bg);
    border-color: var(--bs-border-color);
}
.mover-chip.filho:hover {
    background: var(--bs-secondary-bg);
    border-color: var(--bs-border-color);
}
.mover-chip.filho.selecionado {
    background: var(--bs-secondary-bg);
    border-color: #0d6efd;
}

/* ── Contador no footer ───────────────────────────────────────── */
#moverParaContador {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: .8rem;
    font-weight: 500;
    color: #0d6efd;
    background: rgba(13,110,253,.08);
    border-radius: 20px;
    padding: 3px 10px;
}
</style>

<script>
(function () {
    var urlPastaMarcadores = '{{ urlPastaMarcadores }}';
    var todosMarcadores    = {{ todosMarcadores|map(m => {id: m.id, nome: m.nome, cor: m.cor, paiId: m.pai ? m.pai.id : null})|json_encode|raw }};
    var delegateSelector   = {{ delegateSelector is defined ? delegateSelector|json_encode|raw : 'null' }};
    var callbackNome       = {{ onSucessoCallback is defined ? onSucessoCallback|json_encode|raw : 'null' }};

    var modalEl        = document.getElementById('modalMoverPara');
    var inputPastaId   = document.getElementById('moverParaPastaId');
    var inputCsrf      = document.getElementById('moverParaCsrfToken');
    var spanPastaNome  = document.getElementById('moverParaPastaNome');
    var lista          = document.getElementById('moverParaLista');
    var vazioEl        = document.getElementById('moverParaVazio');
    var erroEl         = document.getElementById('moverParaErro');
    var buscaEl        = document.getElementById('moverParaBusca');
    var buscaLimparBtn = document.getElementById('moverParaBuscaLimpar');
    var contadorEl     = document.getElementById('moverParaContador');

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function escurecer(hex) {
        if (!hex || hex === '#e9ecef') return '#555';
        try {
            var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
            return 'rgb('+Math.max(0,r-50)+','+Math.max(0,g-50)+','+Math.max(0,b-50)+')';
        } catch(_) { return '#555'; }
    }

    function getAtivos() {
        return Array.from(lista.querySelectorAll('.mover-para-cb:checked')).map(function (c) { return c.value; });
    }

    function atualizarContador() {
        var n = lista.querySelectorAll('.mover-para-cb:checked').length;
        if (n === 0) {
            contadorEl.style.display = 'none';
        } else {
            contadorEl.style.display = '';
            contadorEl.innerHTML = '<i class="bi bi-check2-circle"></i> ' + n + ' selecionado' + (n !== 1 ? 's' : '');
        }
    }

    function criarChip(marcador, ativo, corStripe, ehFilho) {
        var cor = marcador.cor || '#e9ecef';
        var stripe = corStripe || cor;
        var wrap = document.createElement('div');
        wrap.className = 'mover-chip-wrap';

        var chip = document.createElement('div');
        chip.className = 'mover-chip' + (ativo ? ' selecionado' : '') + (ehFilho ? ' filho' : '');
        chip.style.setProperty('background-color', ativo ? (cor !== '#e9ecef' ? cor + '22' : '#eef2ff') : '');

        var cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.name = 'marcadores[]';
        cb.value = String(marcador.id);
        cb.checked = ativo;
        cb.className = 'mover-para-cb';
        cb.id = 'mcb-' + marcador.id;

        chip.innerHTML =
            '<span class="mover-chip-stripe" style="background:' + stripe + ';"></span>' +
            '<i class="bi bi-tag mover-chip-icon" style="color:' + escurecer(cor) + ';"></i>' +
            '<span class="mover-chip-nome">' + escHtml(marcador.nome) + '</span>' +
            '<span class="mover-chip-check"><i class="bi bi-check" style="font-size:.72rem;line-height:1;"></i></span>';

        chip.insertBefore(cb, chip.firstChild);

        chip.addEventListener('click', function (e) {
            if (e.target.closest('.mover-chip-chevron')) return;
            cb.checked = !cb.checked;
            chip.classList.toggle('selecionado', cb.checked);
            chip.style.setProperty('background-color', cb.checked ? (cor !== '#e9ecef' ? cor + '22' : '#eef2ff') : '');
            atualizarContador();
        });

        wrap.appendChild(chip);
        return { wrap: wrap, chip: chip, cb: cb };
    }

    function renderizarArvore(ativos, filtro) {
        lista.innerHTML = '';
        filtro = (filtro || '').toLowerCase().trim();

        var raizes = todosMarcadores.filter(function (m) { return m.paiId === null; });
        var filhosMap = {};
        todosMarcadores.forEach(function (m) {
            if (m.paiId !== null) {
                if (!filhosMap[m.paiId]) filhosMap[m.paiId] = [];
                filhosMap[m.paiId].push(m);
            }
        });

        var totalVisiveis = 0;

        raizes.forEach(function (raiz) {
            var filhos = filhosMap[raiz.id] || [];
            var raizBate = !filtro || raiz.nome.toLowerCase().indexOf(filtro) !== -1;
            var filhosBatidos = filtro
                ? filhos.filter(function (f) { return f.nome.toLowerCase().indexOf(filtro) !== -1; })
                : filhos;
            if (!raizBate && filhosBatidos.length === 0) return;

            totalVisiveis++;

            var corRaiz   = raiz.cor || '#e9ecef';
            var raizAtivo = ativos.indexOf(String(raiz.id)) !== -1;
            var temFilhos = filhosBatidos.length > 0;
            var expandido = filtro
                ? true
                : filhos.some(function (f) { return ativos.indexOf(String(f.id)) !== -1; });

            var criado = criarChip(raiz, raizAtivo, corRaiz, false);
            var chip   = criado.chip;

            // Adicionar badge de contagem de filhos e chevron
            if (temFilhos) {
                var countSpan = document.createElement('span');
                countSpan.className = 'mover-chip-count';
                countSpan.textContent = filhos.length;
                chip.querySelector('.mover-chip-check').insertAdjacentElement('beforebegin', countSpan);

                var chevron = document.createElement('span');
                chevron.className = 'mover-chip-chevron' + (expandido ? ' expandido' : '');
                chevron.innerHTML = '<i class="bi bi-chevron-right"></i>';
                chip.appendChild(chevron);
            }

            lista.appendChild(criado.wrap);

            if (temFilhos) {
                var grupoDiv = document.createElement('div');
                grupoDiv.className = 'mover-grupo-filhos' + (expandido ? '' : ' oculto');

                (filtro ? filhosBatidos : filhos).forEach(function (filho) {
                    var filhoAtivo = ativos.indexOf(String(filho.id)) !== -1;
                    totalVisiveis++;
                    var criadoFilho = criarChip(filho, filhoAtivo, corRaiz, true);
                    grupoDiv.appendChild(criadoFilho.wrap);
                });

                lista.appendChild(grupoDiv);

                // Chevron toggle
                chip.querySelector('.mover-chip-chevron').addEventListener('click', function (e) {
                    e.stopPropagation();
                    var aberto = !grupoDiv.classList.contains('oculto');
                    grupoDiv.classList.toggle('oculto', aberto);
                    this.classList.toggle('expandido', !aberto);
                });
            }
        });

        atualizarContador();

        if (totalVisiveis === 0) {
            vazioEl.style.display = '';
            document.getElementById('moverParaVazioTexto').textContent =
                filtro ? 'Nenhum marcador encontrado para "' + filtro + '".' : 'Nenhum marcador criado ainda.';
        } else {
            vazioEl.style.display = 'none';
        }
    }

    function abrirModal(btn) {
        var pastaId   = btn.dataset.pastaId;
        var pastaNome = btn.dataset.pastaNome;
        var ativos    = (btn.dataset.marcadoresAtivos || '').split(',').filter(Boolean);

        inputPastaId.value        = pastaId;
        spanPastaNome.textContent = pastaNome;
        erroEl.style.display      = 'none';
        buscaEl.value             = '';
        buscaLimparBtn.style.display = 'none';
        inputCsrf.value           = btn.dataset.csrfToken;

        renderizarArvore(ativos, '');
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
        setTimeout(function () { buscaEl.focus(); }, 350);
    }

    // Limpar busca
    buscaEl.addEventListener('input', function () {
        buscaLimparBtn.style.display = this.value ? '' : 'none';
        var ativos = getAtivos();
        renderizarArvore(ativos, this.value);
    });

    buscaLimparBtn.addEventListener('click', function () {
        buscaEl.value = '';
        this.style.display = 'none';
        var ativos = getAtivos();
        renderizarArvore(ativos, '');
        buscaEl.focus();
    });

    // Delegação de clique
    var delegateEl = delegateSelector ? (document.querySelector(delegateSelector) || document) : document;
    delegateEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-mover-para');
        if (!btn) return;
        e.preventDefault();
        abrirModal(btn);
    });

    document.getElementById('btnSalvarMoverPara').addEventListener('click', function () {
        var btn     = this;
        var pastaId = inputPastaId.value;
        var url     = urlPastaMarcadores.replace('/0/', '/' + pastaId + '/');
        var csrf    = inputCsrf.value;

        var params = new URLSearchParams({ _token: csrf });
        lista.querySelectorAll('.mover-para-cb:checked').forEach(function (cb) {
            params.append('marcadores[]', cb.value);
        });

        btn.disabled = true;
        erroEl.style.display = 'none';

        fetch(url, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString(),
        })
        .then(function (r) {
            return r.text().then(function (txt) {
                try { return { ok: r.ok, data: JSON.parse(txt) }; }
                catch (_) { return { ok: false, data: { erro: 'Resposta inválida do servidor.' } }; }
            });
        })
        .then(function (res) {
            btn.disabled = false;
            if (!res.ok) {
                erroEl.textContent   = res.data.erro || 'Erro ao salvar.';
                erroEl.style.display = '';
                return;
            }

            if (callbackNome && typeof window[callbackNome] === 'function') {
                window[callbackNome](res.data, escHtml);
            }

            var btnOrigem = delegateEl.querySelector('.js-mover-para[data-pasta-id="' + res.data.pastaId + '"]');
            if (btnOrigem) {
                btnOrigem.dataset.marcadoresAtivos = res.data.marcadores.map(function (m) { return m.id; }).join(',');
            }

            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        })
        .catch(function (err) {
            btn.disabled = false;
            erroEl.textContent   = 'Erro de comunicação.';
            erroEl.style.display = '';
            console.error('[mover-para] erro inesperado:', err);
        });
    });
}());
</script>
