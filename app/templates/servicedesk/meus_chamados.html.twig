{% extends 'base.html.twig' %}

{% block title %}{{ 'servicedesk.comum.meus_chamados'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-ticket-detailed me-2"></i>{{ 'servicedesk.comum.meus_chamados'|trans }}</h1>
        <a href="{{ path('servicedesk_novo') }}" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> {{ 'servicedesk.comum.abrir_chamado'|trans }}
        </a>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# Resumo #}
        <div class="row mb-4">
            <div class="col-md-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon text-bg-warning"><i class="bi bi-inbox"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">{{ 'servicedesk.comum.abertos'|trans }}</span>
                        <span class="info-box-number">{{ chamados|filter(c => c.status == 'aberto')|length }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon text-bg-primary"><i class="bi bi-gear-wide-connected"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">{{ 'servicedesk.comum.em_andamento'|trans }}</span>
                        <span class="info-box-number">{{ chamados|filter(c => c.status == 'em_andamento')|length }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon text-bg-success"><i class="bi bi-check-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">{{ 'servicedesk.comum.resolvidos'|trans }}</span>
                        <span class="info-box-number">{{ chamados|filter(c => c.status == 'resolvido')|length }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon text-bg-secondary"><i class="bi bi-archive"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">{{ 'servicedesk.comum.fechados'|trans }}</span>
                        <span class="info-box-number">{{ chamados|filter(c => c.status == 'fechado')|length }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Lista de chamados #}
        <div class="card">
            <div class="card-body table-responsive p-0">
                {% if chamados|length > 0 %}
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'servicedesk.comum.titulo'|trans }}</th>
                            <th>{{ 'servicedesk.comum.categoria'|trans }}</th>
                            <th>{{ 'servicedesk.comum.prioridade'|trans }}</th>
                            <th>{{ 'servicedesk.comum.status'|trans }}</th>
                            <th>{{ 'servicedesk.comum.aberto_em'|trans }}</th>
                            <th>{{ 'servicedesk.meus_chamados.ultima_atualizacao'|trans }}</th>
                            <th>{{ 'servicedesk.comum.acoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for chamado in chamados %}
                        <tr>
                            <td><strong>{{ chamado.id }}</strong></td>
                            <td>{{ chamado.titulo|length > 50 ? chamado.titulo|slice(0, 50) ~ '...' : chamado.titulo }}</td>
                            <td>
                                <span class="badge text-bg-secondary">
                                    {{ chamado.categoriaLabel }}
                                </span>
                            </td>
                            <td>
                                <span class="badge {{ chamado.prioridadeBadgeClass }}">
                                    {{ chamado.prioridadeLabel }}
                                </span>
                            </td>
                            <td>
                                <span class="badge {{ chamado.statusBadgeClass }}">
                                    {{ chamado.statusLabel }}
                                </span>
                            </td>
                            <td>
                                <small>{{ chamado.criadoEm|data_hora }}</small>
                            </td>
                            <td>
                                <small>{{ chamado.atualizadoEm ? chamado.atualizadoEm|data_hora : '-' }}</small>
                            </td>
                            <td>
                                <a href="{{ path('servicedesk_show', {id: chamado.id}) }}"
                                   class="btn-action btn-action-view"
                                   title="{{ 'servicedesk.comum.visualizar_chamado'|trans }}"
                                   aria-label="{{ 'servicedesk.comum.visualizar_chamado'|trans }}">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% else %}
                <div class="p-5 text-center">
                    <i class="bi bi-ticket display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">{{ 'servicedesk.meus_chamados.vazio_titulo'|trans }}</h4>
                    <p class="text-muted">{{ 'servicedesk.meus_chamados.vazio_texto'|trans }}</p>
                    <a href="{{ path('servicedesk_novo') }}" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-lg me-1"></i> {{ 'servicedesk.meus_chamados.primeiro_chamado'|trans }}
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
