{% extends 'base.html.twig' %}

{% block title %}{{ 'servicedesk.comum.meus_chamados'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-ticket-detailed me-2"></i>{{ 'servicedesk.comum.meus_chamados'|trans }}</h1>
        <a href="{{ path('servicedesk_novo') }}" class="bjp-btn bjp-btn--sucesso">
            <i class="bi bi-plus-lg me-1"></i> {{ 'servicedesk.comum.abrir_chamado'|trans }}
        </a>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# Resumo #}
        <div class="row mb-4">
            <div class="col-md-3 col-6">
                <div class="bjp-painel h-100">
                    <div class="bjp-painel-corpo d-flex align-items-center justify-content-between">
                        <div>
                            <div class="bjp-titulo-tela">{{ chamados|filter(c => c.status == 'aberto')|length }}</div>
                            <div class="bjp-texto-apoio">{{ 'servicedesk.comum.abertos'|trans }}</div>
                        </div>
                        <i class="bi bi-inbox" style="font-size:24px;color:#8a5a12"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="bjp-painel h-100">
                    <div class="bjp-painel-corpo d-flex align-items-center justify-content-between">
                        <div>
                            <div class="bjp-titulo-tela">{{ chamados|filter(c => c.status == 'em_andamento')|length }}</div>
                            <div class="bjp-texto-apoio">{{ 'servicedesk.comum.em_andamento'|trans }}</div>
                        </div>
                        <i class="bi bi-gear-wide-connected" style="font-size:24px;color:#0f6fc4"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="bjp-painel h-100">
                    <div class="bjp-painel-corpo d-flex align-items-center justify-content-between">
                        <div>
                            <div class="bjp-titulo-tela">{{ chamados|filter(c => c.status == 'resolvido')|length }}</div>
                            <div class="bjp-texto-apoio">{{ 'servicedesk.comum.resolvidos'|trans }}</div>
                        </div>
                        <i class="bi bi-check-circle" style="font-size:24px;color:#1f9d61"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="bjp-painel h-100">
                    <div class="bjp-painel-corpo d-flex align-items-center justify-content-between">
                        <div>
                            <div class="bjp-titulo-tela">{{ chamados|filter(c => c.status == 'fechado')|length }}</div>
                            <div class="bjp-texto-apoio">{{ 'servicedesk.comum.fechados'|trans }}</div>
                        </div>
                        <i class="bi bi-archive" style="font-size:24px;color:#5f7684"></i>
                    </div>
                </div>
            </div>
        </div>

        {# Lista de chamados #}
        <div class="bjp-painel">
            <div class="bjp-painel-corpo table-responsive p-0">
                {% if chamados|length > 0 %}
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'servicedesk.comum.titulo'|trans }}</th>
                            <th>{{ 'servicedesk.comum.categoria'|trans }}</th>
                            <th>{{ 'servicedesk.comum.prioridade'|trans }}</th>
                            <th>{{ 'servicedesk.comum.status'|trans }}</th>
                            <th>{{ 'servicedesk.comum.aberto_em'|trans }}</th>
                            <th>{{ 'servicedesk.meus_chamados.ultima_atualizacao'|trans }}</th>
                            <th>{{ 'servicedesk.comum.acoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for chamado in chamados %}
                        <tr>
                            <td><strong>{{ chamado.id }}</strong></td>
                            <td>{{ chamado.titulo|length > 50 ? chamado.titulo|slice(0, 50) ~ '...' : chamado.titulo }}</td>
                            <td>
                                <span class="bjp-etiqueta bjp-etiqueta--neutro bjp-etiqueta--sem-ponto">
                                    {{ chamado.categoriaLabel }}
                                </span>
                            </td>
                            <td>
                                <span class="bjp-etiqueta bjp-etiqueta--{{ {'bg-success': 'ok', 'bg-danger': 'critico', 'bg-warning text-dark': 'atencao', 'bg-primary': 'info', 'bg-info': 'info'}[chamado.prioridadeBadgeClass] ?? 'neutro' }}">
                                    {{ chamado.prioridadeLabel }}
                                </span>
                            </td>
                            <td>
                                <span class="bjp-etiqueta bjp-etiqueta--{{ {'bg-success': 'ok', 'bg-danger': 'critico', 'bg-warning text-dark': 'atencao', 'bg-primary': 'info', 'bg-info': 'info'}[chamado.statusBadgeClass] ?? 'neutro' }}">
                                    {{ chamado.statusLabel }}
                                </span>
                            </td>
                            <td>
                                <small>{{ chamado.criadoEm|data_hora }}</small>
                            </td>
                            <td>
                                <small>{{ chamado.atualizadoEm ? chamado.atualizadoEm|data_hora : '-' }}</small>
                            </td>
                            <td>
                                <a href="{{ path('servicedesk_show', {id: chamado.id}) }}"
                                   class="btn-action btn-action-view"
                                   title="{{ 'servicedesk.comum.visualizar_chamado'|trans }}"
                                   aria-label="{{ 'servicedesk.comum.visualizar_chamado'|trans }}">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% else %}
                <div class="p-5 text-center">
                    <i class="bi bi-ticket display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">{{ 'servicedesk.meus_chamados.vazio_titulo'|trans }}</h4>
                    <p class="text-muted">{{ 'servicedesk.meus_chamados.vazio_texto'|trans }}</p>
                    <a href="{{ path('servicedesk_novo') }}" class="bjp-btn bjp-btn--primario mt-2">
                        <i class="bi bi-plus-lg me-1"></i> {{ 'servicedesk.meus_chamados.primeiro_chamado'|trans }}
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
