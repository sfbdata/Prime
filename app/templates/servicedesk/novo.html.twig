{% extends 'base.html.twig' %}

{% block title %}{{ 'servicedesk.comum.abrir_chamado'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="m-0"><i class="bi bi-plus-circle me-2"></i>{{ 'servicedesk.comum.abrir_chamado'|trans }}</h1>
            <a href="{{ path('servicedesk_meus_chamados') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> {{ 'servicedesk.comum.voltar'|trans }}
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-pencil-square me-2"></i>{{ 'servicedesk.novo.dados_do_chamado'|trans }}</h3>
                    </div>
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                    <div class="card-body">
                        <div class="mb-3">
                            {{ form_label(form.titulo) }}
                            {{ form_widget(form.titulo, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.titulo) }}
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                {{ form_label(form.categoria) }}
                                {{ form_widget(form.categoria, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.categoria) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.prioridade) }}
                                {{ form_widget(form.prioridade, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.prioridade) }}
                                <small class="text-muted">
                                    <b>{{ 'servicedesk.novo.prioridade_critica'|trans }}</b> {{ 'servicedesk.novo.prioridade_critica_ajuda'|trans }} | <b>{{ 'servicedesk.novo.prioridade_alta'|trans }}</b> {{ 'servicedesk.novo.prioridade_alta_ajuda'|trans }} | <b>{{ 'servicedesk.novo.prioridade_media'|trans }}</b> {{ 'servicedesk.novo.prioridade_media_ajuda'|trans }} | <b>{{ 'servicedesk.novo.prioridade_baixa'|trans }}</b> {{ 'servicedesk.novo.prioridade_baixa_ajuda'|trans }}
                                </small>
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.departamento) }}
                            {{ form_widget(form.departamento, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.departamento) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.descricao) }}
                            {{ form_widget(form.descricao, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.descricao) }}
                            <small class="text-muted">
                                {{ 'servicedesk.novo.descricao_ajuda'|trans }}
                            </small>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.anexos) }}
                            {{ form_widget(form.anexos, {'attr': {'class': 'form-control', 'multiple': 'multiple'}}) }}
                            {{ form_errors(form.anexos) }}
                            <small class="text-muted">
                                {{ 'servicedesk.novo.anexos_ajuda'|trans }}
                            </small>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i> {{ 'servicedesk.comum.abrir_chamado'|trans }}
                        </button>
                        <a href="{{ path('servicedesk_meus_chamados') }}" class="btn btn-outline-secondary">
                            {{ 'servicedesk.novo.cancelar'|trans }}
                        </a>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card bg-body-tertiary text-body-secondary">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-info-circle me-2"></i>{{ 'servicedesk.novo.dicas'|trans }}</h3>
                    </div>
                    <div class="card-body">
                        <h6><i class="bi bi-1-circle text-primary me-2"></i>{{ 'servicedesk.novo.dica_especifico'|trans }}</h6>
                        <p class="small text-muted">{{ 'servicedesk.novo.dica_especifico_texto'|trans }}</p>

                        <h6><i class="bi bi-2-circle text-primary me-2"></i>{{ 'servicedesk.novo.dica_detalhes'|trans }}</h6>
                        <p class="small text-muted">{{ 'servicedesk.novo.dica_detalhes_texto'|trans }}</p>

                        <h6><i class="bi bi-3-circle text-primary me-2"></i>{{ 'servicedesk.novo.dica_imagens'|trans }}</h6>
                        <p class="small text-muted">{{ 'servicedesk.novo.dica_imagens_texto'|trans }}</p>

                        <h6><i class="bi bi-4-circle text-primary me-2"></i>{{ 'servicedesk.novo.dica_prioridade'|trans }}</h6>
                        <p class="small text-muted">{{ 'servicedesk.novo.dica_prioridade_texto'|trans }}</p>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-book me-2"></i>{{ 'servicedesk.novo.categorias'|trans }}</h3>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <i class="bi bi-pc-display text-primary me-2"></i>
                                <strong>{{ 'servicedesk.novo.categoria.software'|trans }}</strong>
                                <small class="d-block text-muted">{{ 'servicedesk.novo.categoria.software_ajuda'|trans }}</small>
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-motherboard text-success me-2"></i>
                                <strong>{{ 'servicedesk.novo.categoria.hardware'|trans }}</strong>
                                <small class="d-block text-muted">{{ 'servicedesk.novo.categoria.hardware_ajuda'|trans }}</small>
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-printer text-warning me-2"></i>
                                <strong>{{ 'servicedesk.novo.categoria.impressora'|trans }}</strong>
                                <small class="d-block text-muted">{{ 'servicedesk.novo.categoria.impressora_ajuda'|trans }}</small>
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-wifi text-danger me-2"></i>
                                <strong>{{ 'servicedesk.novo.categoria.rede'|trans }}</strong>
                                <small class="d-block text-muted">{{ 'servicedesk.novo.categoria.rede_ajuda'|trans }}</small>
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-key text-info me-2"></i>
                                <strong>{{ 'servicedesk.novo.categoria.acesso'|trans }}</strong>
                                <small class="d-block text-muted">{{ 'servicedesk.novo.categoria.acesso_ajuda'|trans }}</small>
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-envelope text-secondary me-2"></i>
                                <strong>{{ 'servicedesk.novo.categoria.email'|trans }}</strong>
                                <small class="d-block text-muted">{{ 'servicedesk.novo.categoria.email_ajuda'|trans }}</small>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
