{# ============================================================================
   Conversa da aba "Perguntar" do drawer BlueJus IA (spec inteligencia-drawer-
   da-pasta, F3; desenho dc L1072-1092 e L5972-5974).

   Mensagens em coluna: as minhas à direita em degradê, as da IA à esquerda em
   branco com borda (`max-width:88%`, `pre-wrap`), tudo ESCAPADO (sem |raw: a
   resposta é texto do modelo). Sem mensagens, o texto do desenho; as quatro
   sugestões literais do desenho ficam sempre embaixo (clique envia, pelo
   pasta-ia-conversa.js). Pergunta em andamento: nenhuma resposta inventada,
   só o cartão "Consultando os dados desta pasta" (dc L1086-1092) até o
   polling trazer a resposta. Falha diz a falha (regra 1).

   Só a conversa da pessoa logada (o UseCase consulta por autor).
   `data-ia-em-andamento` é o que o polling lê.

   Renderizado em dois lugares: dentro do drawer, com `conversa = null`
   ("carregando"), e sozinho por `GET /pasta/{id}/ia/conversa`
   (`inteligencia_conversa_listar`), que o JS busca e troca inteiro.

   Contexto: `conversa` (App\Inteligencia\DTO\ConversaDaPastaOutput ou null),
   `pastaId` (int).
   ============================================================================ #}
{% set ia = ia_disponibilidade() %}
{% set emAndamento = conversa is not null and conversa.temEmAndamento %}
{% set sugestoes = ['inteligencia.conversa.sugestao_parado'|trans, 'inteligencia.conversa.sugestao_falta'|trans, 'inteligencia.conversa.sugestao_prazo'|trans, 'inteligencia.conversa.sugestao_risco'|trans] %}
<div class="ia-conversa" data-ia-conversa
     data-ia-carregado="{{ conversa is null ? '0' : '1' }}"
     data-ia-em-andamento="{{ emAndamento ? '1' : '0' }}">
    {% if conversa is null %}
        <p class="ia-ag-vazio" data-ia-carregando>{{ 'inteligencia.conversa.carregando'|trans }}</p>
    {% else %}
        <div class="ia-conversa-msgs" data-ia-mensagens>
            {% for m in conversa.mensagens %}
                <div class="ia-conversa-msg ia-conversa-msg--eu" data-ia-pergunta="{{ m.perguntaId }}">{{ m.texto }}</div>
                {% if m.resposta is not null %}
                    <div class="ia-conversa-msg ia-conversa-msg--ia" data-ia-resposta="{{ m.perguntaId }}">{{ m.resposta }}</div>
                {% elseif m.falha is not null %}
                    <div class="ia-conversa-msg ia-conversa-msg--ia is-falha" data-ia-resposta="{{ m.perguntaId }}">{{ m.falha }}</div>
                {% endif %}
            {% endfor %}
            {% if conversa.vazia %}
                <p class="ia-conversa-vazia">{{ 'inteligencia.conversa.vazia'|trans }}</p>
            {% endif %}
            <div class="ia-conversa-sugestoes" role="group" aria-label="{{ 'inteligencia.conversa.sugestoes'|trans }}">
                {% for s in sugestoes %}
                    <button type="button" class="ia-conversa-sugestao" data-ia-sugestao="{{ s }}"{{ emAndamento or not ia.estaDisponivel ? ' disabled' : '' }}>{{ s }}</button>
                {% endfor %}
            </div>
        </div>
        {% if emAndamento %}
            {# Carregamento do desenho 02 VS 28.10.26: faixa varrendo, símbolo girando, etapa em gradiente, frase,
               passos (feito/atual/futuro) e barra. O servidor só diz "em andamento": o avanço dos passos e a troca
               da frase são do pasta-ia-conversa.js, por tempo decorrido. #}
            {% set etapas = ['inteligencia.conversa.consultando'|trans, 'inteligencia.conversa.lendo'|trans, 'inteligencia.conversa.redigindo'|trans] %}
            {% set frases = [] %}
            {% for i in 1..7 %}{% set frases = frases|merge([('inteligencia.conversa.frase_' ~ i)|trans]) %}{% endfor %}
            <div class="ia-conversa-carregando" role="status" data-ia-consultando data-frases="{{ frases|json_encode|e('html_attr') }}">
                <span class="ia-carga-varre" aria-hidden="true"></span>
                <div class="ia-carga-topo">
                    <span class="ia-carga-simbolo" aria-hidden="true"><span class="ia-carga-halo"></span><img src="{{ asset('images/bluejus-simbolo-petroleo.png') }}" alt=""></span>
                    <span class="ia-carga-textos">
                        <span class="ia-conversa-etapa" data-ia-etapa>{{ etapas[0] }}…</span>
                        <span class="ia-carga-frase" data-ia-frase>{{ frases[0] }}</span>
                    </span>
                </div>
                <div class="ia-carga-passos">
                    {% for e in etapas %}
                        <div class="ia-carga-passo" data-ia-passo data-rotulo="{{ e }}" data-estado="{{ loop.first ? 'atual' : 'futuro' }}"><i class="bi bi-circle" aria-hidden="true"></i>{{ e }}<span class="ia-carga-pontos" aria-hidden="true"><i></i><i></i><i></i></span></div>
                    {% endfor %}
                </div>
                <div class="ia-carga-barra" aria-hidden="true"><div data-ia-barra style="width:17%"></div></div>
            </div>
        {% endif %}
    {% endif %}
</div>
