{# ============================================================================
   Lista de análises da BlueJus IA de UMA pasta (aba Push Processual).

   Renderizado em dois lugares: dentro da aba, pelo `PastaController::show` (1B),
   e sozinho por `GET /pasta/{id}/ia/push/analises` (recarga sem F5 depois do
   polling). Por isso NÃO tem o botão "Resumir com IA" nem o cabeçalho do card —
   isso é do `_push_processual.html.twig`; aqui só a lista.

   Arranjo do desenho 1.2.3 (dc L.2427-2497): coluna da marca (✦ + dia) à
   esquerda; no corpo, a linha do selo com o cadeado e o menu ⋮; resumo, pontos,
   quem deve agir, base; ações em linha. "Enviar ao cliente" / "Reenviar ao cliente" e o "Enviado dd/mm às
   HH:MM" (dc L.2618-2619, `mailIAVals`; spec push-avisar-cliente §3) vêm de
   `avisar_cliente()`: só na análise concluída, para quem edita a pasta viva e tem a IA;
   a análise interna mostra o botão travado com o motivo (o modal é do pasta-push-cliente.js).

   Editar (P4h, desenho N:2602-2624): o formulário de edição mora no cartão,
   escondido pelo CSS; a classe `ps-ia-cartao--editando` (pasta-ia-push.js)
   troca a leitura pela edição. A versão do
   advogado fica ao lado da saída do modelo e ganha o selo "editado".

   Recolher/expandir (IA-010, dc L2440 e L2452): chevron no cabeçalho e, recolhida,
   uma prévia de uma linha ("resumo · N ponto(s)") no lugar do conteúdo. A escolha
   é do usuário e fica no servidor (`ia_push_recolhidas()`, `preferencia_usuario`).

   Tudo escapado: a resposta do modelo nunca é HTML (`|raw` proibido aqui).
   O motivo técnico de uma falha só aparece para quem administra a IA.
   O comportamento (POST por XHR, menu, criar meta) é do `pasta-ia-push.js`; sem
   JS, os formulários continuam funcionando por POST comum.

   Contexto: `analisesIa` (App\Inteligencia\DTO\AnalisesDaPastaOutput), `pastaId` (int).
   ============================================================================ #}
{% set podeVerMotivoTecnico = can_administer('admin.inteligencia.manage') %}
{% set hojeIa = 'now'|date('Y-m-d') %}
{# IA-010: as análises que ESTE usuário recolheu (preferência no servidor, `preferencia_usuario`). #}
{% set recolhidasIa = ia_push_recolhidas() %}
{# C6-IA-03: "Criar tarefa da providência" segue a regra do Push (FPN-014c, `pushPodeEscrever`):
   só com EDIT da pasta e pasta viva — quem só vê e a lápide não recebem o item (o modal de nova
   meta grava na pasta). O parcial chega só com o `pastaId` (também pela recarga XHR), então a
   lápide vem de `nota_tecnica_somente_leitura`, o ponto único "pasta lápide ou alheia" por id;
   `can_access_resource` guarda a resposta por requisição. #}
{% set iaPodeCriarTarefa = not nota_tecnica_somente_leitura(pastaId) and can_access_resource('pasta', pastaId, 'edit') %}
{# P4c: o envio ao cliente segue a mesma regra de escrita, mais o acesso à BlueJus IA. #}
{% set avisarClienteIa = iaPodeCriarTarefa and can_access_module('inteligencia') ? avisar_cliente(pastaId) : null %}
<div class="ps-ia-lista" id="ia-analises"
     data-ia-lista
     data-pasta-id="{{ pastaId }}"
     data-ia-url="{{ path('inteligencia_push_listar', {id: pastaId}) }}"
     data-ia-em-andamento="{{ analisesIa.temEmAndamento ? '1' : '0' }}"
     data-ia-tem-concluida="{{ analisesIa.ultimaConcluida is not null ? '1' : '0' }}"
     data-ia-total-movimentacoes="{{ analisesIa.totalMovimentacoes }}"
     data-ia-nao-analisadas="{{ analisesIa.naoAnalisadas }}">
    {% for a in analisesIa.analises %}
        {% set csrfAnalise = csrf_token('inteligencia_analise_' ~ a.id) %}
        {% set ehHoje = a.criadaEm|date('Y-m-d') == hojeIa %}
        {% set pontoDeAcao = a.pontos|filter(p => p.tipo in ['prazo', 'providencia'])|first %}
        {# Só a concluída recolhe: a prévia é o resumo (dc L5137, `previa`). #}
        {% set recolhivel = a.status == 'concluida' %}
        {% set aberta = not recolhivel or a.id not in recolhidasIa %}
        {# P4h: editar segue a regra do "Criar tarefa da providência" (EDIT e pasta viva). #}
        {% set podeEditarIa = a.status == 'concluida' and iaPodeCriarTarefa %}
        {% set dicaAberta = aberta ? 'inteligencia.push.recolher'|trans : 'inteligencia.push.expandir'|trans %}
        <article class="ps-ia-cartao ps-ia-cartao--{{ a.status }}{{ a.lida ? ' ps-ia-cartao--lida' : '' }}{{ aberta ? '' : ' ps-ia-cartao--recolhida' }}"
                 aria-label="{{ 'inteligencia.comum.analise_gerada_por_ia'|trans }}"
                 data-ia-analise="{{ a.id }}"
                 data-ia-status="{{ a.status }}"
                 data-ia-status-url="{{ path('inteligencia_analise_status', {id: pastaId, analiseId: a.id}) }}">
            <div class="ps-ia-marca" aria-hidden="true">
                <span class="ps-ia-marca-ico">✦</span>
                <span class="ps-ia-marca-dia">{{ ehHoje ? 'inteligencia.comum.hoje'|trans : a.criadaEm|date('d/m') }}</span>
            </div>
            <div class="ps-ia-corpo">
                <header class="ps-ia-cab">
                    <span class="ps-ia-selo">✦ {{ 'inteligencia.push.selo'|trans }}</span>
                    <span class="ps-ia-aviso">{{ 'inteligencia.push.aviso'|trans }} · <time class="ps-ia-quando ps-num" datetime="{{ a.criadaEm|date('c') }}">{{ ehHoje ? 'inteligencia.comum.hoje'|trans : a.criadaEm|data }}, {{ a.criadaEm|hora }}</time></span>
                    {% if a.editada %}
                        <span class="ps-ia-editado"{% if a.editadaEm %} title="{{ a.editadaPorNome ? 'inteligencia.push.editado_por'|trans({nome: a.editadaPorNome, dia: a.editadaEm|date('d/m'), hora: a.editadaEm|hora}) : 'inteligencia.push.editado_em'|trans({dia: a.editadaEm|date('d/m'), hora: a.editadaEm|hora}) }}"{% endif %}>{{ 'inteligencia.push.editado'|trans }}</span>
                    {% endif %}
                    {% if a.lida %}
                        <span class="ps-ia-lido"><i class="bi bi-check2-all" aria-hidden="true"></i>{{ 'inteligencia.comum.lido'|trans }}</span>
                    {% endif %}
                    <span class="ps-ia-cab-espaco"></span>
                    {% if a.terminal %}
                        {% set dicaInterna = a.internaDoEscritorio
                            ? 'inteligencia.comum.dica_interna_sim'|trans
                            : 'inteligencia.comum.dica_interna_nao'|trans %}
                        <form method="post" action="{{ path('inteligencia_analise_interna', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="interna">
                            <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                            <button type="submit" class="ps-ia-icone{{ a.internaDoEscritorio ? ' is-interna' : '' }}" title="{{ dicaInterna }}" aria-label="{{ dicaInterna }}">
                                <i class="bi {{ a.internaDoEscritorio ? 'bi-lock-fill' : 'bi-unlock' }}" aria-hidden="true"></i>
                                <span class="visually-hidden">{{ a.internaDoEscritorio ? 'inteligencia.push.liberar'|trans : 'inteligencia.push.tornar_interna'|trans }}</span>
                            </button>
                        </form>
                    {% elseif a.internaDoEscritorio %}
                        <span class="ps-ia-cadeado" title="{{ 'inteligencia.comum.cadeado'|trans }}"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
                    {% endif %}
                    {% if recolhivel %}
                        {# Chevron do desenho (dc L2440), entre o cadeado e o ⋮. Envia o formulário
                           `ps-ia-recolher-{id}` do fim do cartão: funciona sem JS (POST comum). #}
                        <button type="submit" form="ps-ia-recolher-{{ a.id }}" class="ps-ia-icone" data-ia-recolher
                                aria-expanded="{{ aberta ? 'true' : 'false' }}" title="{{ dicaAberta }}" aria-label="{{ dicaAberta }}">
                            <i class="bi {{ aberta ? 'bi-chevron-up' : 'bi-chevron-down' }}" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    <div class="ps-ia-menu-wrap">
                        <button type="button" class="ps-ia-icone" data-ia-menu aria-haspopup="menu" aria-expanded="false" aria-label="{{ 'inteligencia.comum.mais_opcoes'|trans }}" title="{{ 'inteligencia.comum.mais_opcoes'|trans }}">
                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                        </button>
                        <div class="ps-ia-menu" role="menu" hidden>
                            {% if podeEditarIa %}
                                <button type="button" class="ps-ia-menu-item" role="menuitem" data-ia-editar><i class="bi bi-pencil" aria-hidden="true"></i>{{ 'inteligencia.push.editar'|trans }}</button>
                            {% endif %}
                            {% if a.terminal and not a.lida %}
                                <form method="post" action="{{ path('inteligencia_analise_lida', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="lida">
                                    <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                                    <button type="submit" class="ps-ia-menu-item" role="menuitem"><i class="bi bi-check2-all" aria-hidden="true"></i>{{ 'inteligencia.comum.marcar_lido'|trans }}</button>
                                </form>
                            {% elseif a.lida %}
                                {# IA-011 (dc L5159-5160): lida, a opção vira "Marcar como não lido". #}
                                <form method="post" action="{{ path('inteligencia_analise_nao_lida', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="nao-lida">
                                    <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                                    <button type="submit" class="ps-ia-menu-item" role="menuitem"><i class="bi bi-check2-all" aria-hidden="true"></i>{{ 'inteligencia.comum.marcar_nao_lido'|trans }}</button>
                                </form>
                            {% endif %}
                            {% if a.status == 'concluida' and iaPodeCriarTarefa %}
                                <button type="button" class="ps-ia-menu-item" role="menuitem"
                                        data-ia-criar-meta
                                        data-meta-titulo="{{ pontoDeAcao ? pontoDeAcao.texto|slice(0, 90) : 'inteligencia.push.meta_titulo'|trans }}"
                                        data-meta-rotulo="{{ pontoDeAcao ? pontoDeAcao.rotulo : '' }}"
                                        data-meta-ponto="{{ pontoDeAcao ? pontoDeAcao.texto : '' }}"
                                        data-meta-resumo="{{ a.resumo }}"
                                        data-meta-quem="{{ a.quemAge }}"
                                        data-meta-quando="{{ a.criadaEm|data_hora }}">
                                    <i class="bi bi-check2-square" aria-hidden="true"></i>{{ 'inteligencia.push.criar_tarefa'|trans }}
                                </button>
                            {% endif %}
                            <form method="post" action="{{ path('inteligencia_analise_excluir', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="excluir"
                                  data-ia-confirmar="{{ 'inteligencia.push.confirmar_excluir'|trans }}">
                                <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                                <button type="submit" class="ps-ia-menu-item ps-ia-menu-item--perigo" role="menuitem"><i class="bi bi-trash3" aria-hidden="true"></i>{{ 'inteligencia.comum.excluir_analise'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </header>

                {% if recolhivel %}
                    {# Prévia de uma linha da análise recolhida (dc L2452-2454): clicar expande. #}
                    <button type="submit" form="ps-ia-recolher-{{ a.id }}" class="ps-ia-previa" data-ia-previa{{ aberta ? ' hidden' : '' }}>{{ a.resumo }}{{ a.pontos is not empty ? ' · ' ~ 'inteligencia.push.pontos'|trans({n: a.pontos|length ~ ''}) : '' }}</button>
                {% endif %}

                {% if a.emAndamento %}
                    <p class="ps-ia-andamento" role="status">
                        <span class="ps-ia-andamento-ico" aria-hidden="true">✦</span>
                        {{ a.totalMovimentacoes == 1 ? 'inteligencia.push.andamento_um'|trans({n: '1'}) : 'inteligencia.push.andamento_varios'|trans({n: a.totalMovimentacoes ~ ''}) }}
                    </p>
                {% elseif a.status == 'concluida' %}
                    <p class="ps-ia-resumo">{{ a.resumo }}</p>
                    {% if a.pontos is not empty %}
                        <ul class="ps-ia-pontos">
                            {% for p in a.pontos %}
                                <li class="ps-ia-ponto ps-ia-ponto--{{ p.tipo }}">
                                    <span class="ps-ia-chip ps-ia-chip--{{ p.tipo }}">{{ p.rotulo }}</span>
                                    <span class="ps-ia-ponto-txt">{{ p.texto }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if a.quemAge %}
                        <p class="ps-ia-quem"><i class="bi bi-person-check" aria-hidden="true"></i><strong>{{ 'inteligencia.comum.quem_deve_agir'|trans }}</strong> {{ a.quemAge }}</p>
                    {% endif %}
                    <p class="ps-ia-base">{{ a.totalMovimentacoes == 1 ? 'inteligencia.push.base_um'|trans({n: '1'}) : 'inteligencia.push.base_varios'|trans({n: a.totalMovimentacoes ~ ''}) }}</p>
                    {% if podeEditarIa %}
                        {# Modo edição (desenho N:2602-2612 e N:2621-2624). `pontos[i]`: i = posição na lista
                           exibida; o X tira a linha e o ponto sai. Sem incluir ponto nem trocar o tipo. #}
                        <form method="post" action="{{ path('inteligencia_analise_editar', {id: pastaId, analiseId: a.id}) }}"
                              class="ps-ia-acao ps-ia-edicao" data-ia-acao="editar" data-ia-edicao>
                            <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                            {# A edição que esta tela viu: se outra pessoa salvar antes, o servidor recusa. #}
                            <input type="hidden" name="versao" value="{{ a.editadaEm ? a.editadaEm|date('U') : '' }}">
                            <textarea name="resumo" class="ps-ia-ed-resumo" rows="3" maxlength="2000" aria-label="{{ 'inteligencia.push.resumo_rotulo'|trans }}">{{ a.resumo }}</textarea>
                            {% for p in a.pontos %}
                                <div class="ps-ia-ed-ponto" data-ia-ed-ponto>
                                    <span class="ps-ia-chip ps-ia-chip--{{ p.tipo }}">{{ p.rotulo }}</span>
                                    <input type="text" name="pontos[{{ loop.index0 }}]" value="{{ p.texto }}" maxlength="500" class="ps-ia-ed-ponto-txt" aria-label="{{ 'inteligencia.push.ponto_rotulo'|trans }}">
                                    <button type="button" class="ps-ia-icone ps-ia-ed-remover" data-ia-ed-remover aria-label="{{ 'inteligencia.push.remover_ponto'|trans }}" title="{{ 'inteligencia.push.remover_ponto'|trans }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                </div>
                            {% endfor %}
                            <p class="ps-ia-ed-nota">{{ 'inteligencia.push.nota_edicao'|trans }} "{{ 'inteligencia.push.editado'|trans }}".</p>
                            <div class="ps-ia-acoes">
                                <button type="submit" class="ps-ia-botao ps-ia-botao--salvar"><i class="bi bi-check2" aria-hidden="true"></i> {{ 'inteligencia.push.salvar'|trans }}</button>
                                <button type="button" class="ps-ia-botao" data-ia-ed-cancelar>{{ 'inteligencia.push.cancelar'|trans }}</button>
                            </div>
                        </form>
                    {% endif %}
                {% elseif a.status == 'falhou' %}
                    <p class="ps-ia-erro">{{ 'inteligencia.comum.falhou'|trans }}</p>
                    {% if podeVerMotivoTecnico and a.erroMotivo %}
                        <p class="ps-ia-erro-tecnico"><small>{{ 'inteligencia.comum.motivo_tecnico'|trans({motivo: a.erroMotivo}) }}</small></p>
                    {% endif %}
                {% else %}
                    <p class="ps-ia-erro">{{ 'inteligencia.comum.nao_configurada'|trans }}</p>
                {% endif %}

                <footer class="ps-ia-acoes" data-ia-rodape>
                    {% if podeEditarIa %}
                        <button type="button" class="ps-ia-botao ps-ia-botao--editar" data-ia-editar><i class="bi bi-pencil" aria-hidden="true"></i> {{ 'inteligencia.push.editar'|trans }}</button>
                    {% endif %}
                    <form method="post" action="{{ path('inteligencia_analise_excluir', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="excluir"
                          data-ia-confirmar="{{ 'inteligencia.push.confirmar_excluir'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                        <button type="submit" class="ps-ia-botao ps-ia-botao--perigo"><i class="bi bi-trash3" aria-hidden="true"></i> {{ 'inteligencia.comum.excluir'|trans }}</button>
                    </form>
                    {% if a.terminal and not a.lida %}
                        <form method="post" action="{{ path('inteligencia_analise_lida', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="lida">
                            <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                            <button type="submit" class="ps-ia-botao"><i class="bi bi-check2-all" aria-hidden="true"></i> {{ 'inteligencia.comum.marcar_lido'|trans }}</button>
                        </form>
                    {% elseif a.lida %}
                        <form method="post" action="{{ path('inteligencia_analise_nao_lida', {id: pastaId, analiseId: a.id}) }}" class="ps-ia-acao" data-ia-acao="nao-lida">
                            <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                            <button type="submit" class="ps-ia-botao"><i class="bi bi-envelope" aria-hidden="true"></i> {{ 'inteligencia.comum.marcar_nao_lido'|trans }}</button>
                        </form>
                    {% endif %}
                    {% if a.status == 'concluida' and avisarClienteIa is not null %}
                        {% set envioIa = avisarClienteIa.envioDaAnalise(a.id) %}
                        <button type="button" class="ps-ia-botao ps-ia-botao--cliente"
                                data-cliente-enviar="{{ a.id }}"
                                data-assunto="{{ avisarClienteIa.assuntoPadrao }}"
                                data-corpo="{{ avisarClienteIa.corpoPadrao(a) }}"
                                data-sub="{{ avisarClienteIa.subDoModal }}"
                                {% if a.internaDoEscritorio %}aria-disabled="true" data-cliente-interna="1"{% endif %}
                                title="{{ a.internaDoEscritorio ? 'inteligencia.push.interna_bloqueia'|trans : avisarClienteIa.dicaDoEnvio }}">
                            <i class="bi bi-envelope-paper" aria-hidden="true"></i><span data-cliente-enviar-txt>{{ envioIa ? 'inteligencia.push.reenviar'|trans : 'inteligencia.push.enviar'|trans }}</span>
                        </button>
                        <span class="ps-ia-enviado" data-cliente-enviado title="{{ envioIa ? envioIa.dica : '' }}"{{ envioIa ? '' : ' hidden' }}>
                            <i class="bi bi-envelope-check" aria-hidden="true"></i><span data-cliente-enviado-txt>{{ envioIa ? envioIa.quando : '' }}</span>
                        </span>
                    {% endif %}
                </footer>
                {% if recolhivel %}
                    {# Alvo do chevron e da prévia. `recolhida` é o estado PEDIDO (o contrário do atual);
                       o pasta-ia-push.js inverte o campo depois de cada troca. #}
                    <form id="ps-ia-recolher-{{ a.id }}" method="post" action="{{ path('inteligencia_analise_recolher', {id: pastaId, analiseId: a.id}) }}"
                          class="ps-ia-acao" data-ia-acao="recolher" hidden>
                        <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                        <input type="hidden" name="recolhida" value="{{ aberta ? '1' : '0' }}">
                    </form>
                {% endif %}
            </div>
        </article>
    {% else %}
        {# O desenho não mostra nada quando ainda não há análise (dc L.2427, lista vazia): o texto
           fica no markup, escondido, como gancho do `data-ia-vazio`. #}
        <p class="ps-ia-vazio" data-ia-vazio hidden>{{ 'inteligencia.push.vazia'|trans }}</p>
    {% endfor %}
</div>
