{# ============================================================================
   UM cartão de análise de agente/comando da BlueJus IA (drawer da pasta). Saiu
   do `_analises_agente.html.twig` para servir também ao `_analises_comando`
   (spec inteligencia-drawer-da-pasta, F1/F2): selo com o rótulo do comando (ou
   o nome do agente, nas análises antigas), aviso, cadeado, menu, resumo,
   pontos, quem age, "Análise completa", "Criar tarefa" (F5), base e ações.

   Tudo escapado: a resposta do modelo nunca é HTML (`|raw` proibido aqui).

   Contexto: `a` (App\Inteligencia\DTO\AnaliseOutput), `pastaId` (int),
   `podeVerMotivoTecnico` (bool), `hojeIa` (Y-m-d), `iaPodeCriarTarefa` (bool).
   ============================================================================ #}
{% set csrfAnalise = csrf_token('inteligencia_analise_' ~ a.id) %}
{% set ehHoje = a.criadaEm|date('Y-m-d') == hojeIa %}
{% set pontoDeAcao = a.pontos|filter(p => p.tipo in ['prazo', 'providencia'])|first %}
<article class="ia-cartao ia-cartao--{{ a.status }}{{ a.lida ? ' ia-cartao--lida' : '' }}"
         aria-label="{{ 'inteligencia.comum.analise_gerada_por_ia'|trans }}"
         data-ia-analise="{{ a.id }}"
         data-ia-status="{{ a.status }}"
         data-ia-status-url="{{ path('inteligencia_analise_status', {id: pastaId, analiseId: a.id}) }}"
         {%- if a.status == 'concluida' %}
         data-ia-registro-url="{{ path('inteligencia_analise_registro', {id: pastaId, analiseId: a.id}) }}"
         data-ia-registro-token="{{ csrf_token('inteligencia_analise_registro_' ~ a.id) }}"
         {%- endif %}>
    <div class="ia-marca" aria-hidden="true">
        <span class="ia-marca-ico">✦</span>
        <span class="ia-marca-dia">{{ ehHoje ? 'inteligencia.comum.hoje'|trans : a.criadaEm|date('d/m') }}</span>
    </div>
    <div class="ia-corpo">
        <header class="ia-cab">
            <span class="ia-selo"{% if a.comandoRotulo and a.agenteNome %} title="{{ a.agenteNome }}"{% endif %}>✦ {{ a.comandoRotulo ?? a.agenteNome ?? 'inteligencia.cartao.selo_padrao'|trans }}</span>
            <span class="ia-aviso">{{ 'inteligencia.cartao.aviso'|trans }} · <time class="ia-quando ps-num" datetime="{{ a.criadaEm|date('c') }}">{{ ehHoje ? 'inteligencia.comum.hoje'|trans : a.criadaEm|data }}, {{ a.criadaEm|hora }}</time></span>
            {% if a.lida %}
                <span class="ia-lido"><i class="bi bi-check2-all" aria-hidden="true"></i>{{ 'inteligencia.comum.lido'|trans }}</span>
            {% endif %}
            <span class="ia-cab-espaco"></span>
            {% if a.status == 'concluida' %}
                {# IA-007 (desenho, dc L1001-1003): Copiar · Baixar .txt · Imprimir, sobre a
                   análise JÁ GRAVADA. Baixar é link comum (funciona sem JS); copiar e
                   imprimir são do pasta-ia-agentes.js. #}
                <button type="button" class="ia-icone" data-ia-copiar title="{{ 'inteligencia.cartao.copiar'|trans }}" aria-label="{{ 'inteligencia.cartao.copiar'|trans }}">
                    <i class="bi bi-copy" aria-hidden="true"></i>
                </button>
                <a class="ia-icone" data-ia-baixar href="{{ path('inteligencia_analise_txt', {id: pastaId, analiseId: a.id}) }}" download title="{{ 'inteligencia.cartao.baixar_dica'|trans }}" aria-label="{{ 'inteligencia.cartao.baixar'|trans }}">
                    <i class="bi bi-download" aria-hidden="true"></i>
                </a>
                <button type="button" class="ia-icone" data-ia-imprimir title="{{ 'inteligencia.cartao.imprimir_dica'|trans }}" aria-label="{{ 'inteligencia.cartao.imprimir'|trans }}">
                    <i class="bi bi-printer" aria-hidden="true"></i>
                </button>
            {% endif %}
            {% if a.terminal %}
                {% set dicaInterna = a.internaDoEscritorio
                    ? 'inteligencia.comum.dica_interna_sim'|trans
                    : 'inteligencia.comum.dica_interna_nao'|trans %}
                <form method="post" action="{{ path('inteligencia_analise_interna', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="interna">
                    <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                    <button type="submit" class="ia-icone{{ a.internaDoEscritorio ? ' is-interna' : '' }}" title="{{ dicaInterna }}" aria-label="{{ dicaInterna }}">
                        <i class="bi {{ a.internaDoEscritorio ? 'bi-lock-fill' : 'bi-unlock' }}" aria-hidden="true"></i>
                    </button>
                </form>
            {% elseif a.internaDoEscritorio %}
                <span class="ia-cadeado" title="{{ 'inteligencia.comum.cadeado'|trans }}"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
            {% endif %}
            <div class="ia-menu-wrap">
                <button type="button" class="ia-icone" data-ia-menu aria-haspopup="menu" aria-expanded="false" aria-label="{{ 'inteligencia.comum.mais_opcoes'|trans }}" title="{{ 'inteligencia.comum.mais_opcoes'|trans }}">
                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                </button>
                <div class="ia-menu" role="menu" hidden>
                    {% if a.terminal and not a.lida %}
                        <form method="post" action="{{ path('inteligencia_analise_lida', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="lida">
                            <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                            <button type="submit" class="ia-menu-item" role="menuitem"><i class="bi bi-check2-all" aria-hidden="true"></i>{{ 'inteligencia.comum.marcar_lido'|trans }}</button>
                        </form>
                    {% elseif a.lida %}
                        {# IA-011: mesmo par lido/não lido do cartão do Push (dc L5159-5160). #}
                        <form method="post" action="{{ path('inteligencia_analise_nao_lida', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="nao-lida">
                            <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                            <button type="submit" class="ia-menu-item" role="menuitem"><i class="bi bi-check2-all" aria-hidden="true"></i>{{ 'inteligencia.comum.marcar_nao_lido'|trans }}</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('inteligencia_analise_excluir', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="excluir"
                          data-ia-confirmar="{{ 'inteligencia.cartao.confirmar_excluir'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                        <button type="submit" class="ia-menu-item ia-menu-item--perigo" role="menuitem"><i class="bi bi-trash3" aria-hidden="true"></i>{{ 'inteligencia.comum.excluir_analise'|trans }}</button>
                    </form>
                </div>
            </div>
        </header>

        {% if a.emAndamento %}
            <p class="ia-andamento" role="status">
                <span class="ia-andamento-ico" aria-hidden="true">✦</span>
                {{ a.totalMovimentacoes == 1 ? 'inteligencia.cartao.andamento_um'|trans({n: '1'}) : 'inteligencia.cartao.andamento_varios'|trans({n: a.totalMovimentacoes ~ ''}) }}
            </p>
        {% elseif a.status == 'concluida' %}
            <p class="ia-resumo">{{ a.resumo }}</p>
            {% if a.pontos is not empty %}
                <ul class="ia-pontos">
                    {% for p in a.pontos %}
                        <li class="ia-ponto ia-ponto--{{ p.tipo }}">
                            <span class="ia-chip-ponto ia-chip-ponto--{{ p.tipo }}">{{ p.rotulo }}</span>
                            <span class="ia-ponto-txt">{{ p.texto }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if a.quemAge %}
                <p class="ia-quem"><i class="bi bi-person-check" aria-hidden="true"></i><strong>{{ 'inteligencia.comum.quem_deve_agir'|trans }}</strong> {{ a.quemAge }}</p>
            {% endif %}
            {% if a.textoDaAnalise %}
                {# Texto integral do modelo, ESCAPADO, com as quebras preservadas (pre-wrap no CSS). #}
                <details class="ia-completa">
                    <summary><i class="bi bi-journal-text" aria-hidden="true"></i>{{ 'inteligencia.cartao.completa'|trans }}</summary>
                    <pre class="ia-texto">{{ a.textoDaAnalise }}</pre>
                </details>
            {% endif %}
            {% if iaPodeCriarTarefa %}
                {# F5 (dc L1101-1105): "Criar tarefa" visível embaixo do resultado. Abre a nova meta da pasta
                   pré-preenchida, uma por clique; quem confirma é a pessoa, no modal. "Criar prazo" (D-PRAZOS)
                   e "Enviar para revisão" (sem fluxo de revisão) não entram. #}
                <div class="ia-res-acoes">
                    <button type="button" class="ia-res-acao"
                            data-ia-criar-meta
                            data-meta-titulo="{{ pontoDeAcao ? pontoDeAcao.texto|slice(0, 90) : (a.comandoRotulo ?? 'inteligencia.cartao.meta_titulo'|trans({agente: a.agenteNome ?? 'inteligencia.cartao.agente_da_ia'|trans})) }}"
                            data-meta-rotulo="{{ pontoDeAcao ? pontoDeAcao.rotulo : '' }}"
                            data-meta-ponto="{{ pontoDeAcao ? pontoDeAcao.texto : '' }}"
                            data-meta-resumo="{{ a.resumo }}"
                            data-meta-quem="{{ a.quemAge }}"
                            data-meta-agente="{{ a.agenteNome }}"
                            data-meta-quando="{{ a.criadaEm|data_hora }}"
                            title="{{ 'inteligencia.cartao.criar_tarefa_dica'|trans }}">
                        <i class="bi bi-check2-square" aria-hidden="true"></i>{{ 'inteligencia.cartao.criar_tarefa'|trans }}
                    </button>
                </div>
            {% endif %}
            <p class="ia-base">{{ a.totalMovimentacoes == 1 ? 'inteligencia.cartao.base_um'|trans({n: '1'}) : 'inteligencia.cartao.base_varios'|trans({n: a.totalMovimentacoes ~ ''}) }}</p>
        {% elseif a.status == 'falhou' %}
            <p class="ia-erro">{{ 'inteligencia.comum.falhou'|trans }}</p>
            {% if podeVerMotivoTecnico and a.erroMotivo %}
                <p class="ia-erro-tecnico"><small>{{ 'inteligencia.comum.motivo_tecnico'|trans({motivo: a.erroMotivo}) }}</small></p>
            {% endif %}
        {% else %}
            <p class="ia-erro">{{ 'inteligencia.comum.nao_configurada'|trans }}</p>
        {% endif %}

        <footer class="ia-acoes">
            <form method="post" action="{{ path('inteligencia_analise_excluir', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="excluir"
                  data-ia-confirmar="{{ 'inteligencia.cartao.confirmar_excluir'|trans }}">
                <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                <button type="submit" class="ia-botao ia-botao--perigo"><i class="bi bi-trash3" aria-hidden="true"></i> {{ 'inteligencia.comum.excluir'|trans }}</button>
            </form>
            {% if a.terminal and not a.lida %}
                <form method="post" action="{{ path('inteligencia_analise_lida', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="lida">
                    <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                    <button type="submit" class="ia-botao"><i class="bi bi-check2-all" aria-hidden="true"></i> {{ 'inteligencia.comum.marcar_lido'|trans }}</button>
                </form>
            {% elseif a.lida %}
                <form method="post" action="{{ path('inteligencia_analise_nao_lida', {id: pastaId, analiseId: a.id}) }}" class="ia-acao" data-ia-acao="nao-lida">
                    <input type="hidden" name="_token" value="{{ csrfAnalise }}">
                    <button type="submit" class="ia-botao"><i class="bi bi-envelope" aria-hidden="true"></i> {{ 'inteligencia.comum.marcar_nao_lido'|trans }}</button>
                </form>
            {% endif %}
        </footer>
    </div>
</article>
