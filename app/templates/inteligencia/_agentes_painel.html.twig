{# ============================================================================
   Painel da BlueJus IA (corpo do drawer), desenho 02 - EXPEDIENTES - VS 18.10.26
   (dc L938-1139; spec inteligencia-drawer-da-pasta, F1, F2 e F4). Três abas,
   cada uma um `tabpanel` filho direto do painel, na ordem do desenho (os
   botões das abas moram no cabeçalho do drawer, `_agentes_drawer.html.twig`):

   · Análise (dc L963-1048): a grade "O que a IA sabe desta pasta" e os 10
     "Comandos para esta pasta" em grade de 2 colunas (ícone + rótulo, `CMDS`,
     dc L5894-5905). O botão do comando escolhe qual comando aparece embaixo,
     com o ciclo de sempre: "Gerar análise" / "Analisando…" / a lista das
     análises (`_comando_secao.html.twig`).
   · Documentos (F4, dc L1041-1058): a lista dos documentos por metadados e o
     "Índice inteligente" dos marcados (`_documentos_indice.html.twig`). Só
     para quem não tem a aba Documentos da pasta oculta.
   · Relatórios (dc L1072-1083): o texto do desenho, os 5 relatórios em grade
     (ícone, nome e descrição, `MOD`, dc L5906-5913) e o "Gerar <nome>" do
     relatório escolhido, com a lista dele.

   A aba Perguntar (F3) mora no `_agentes_drawer.html.twig`, fora deste painel
   (que o JS troca inteiro), com a conversa em `_conversa.html.twig`. O
   "Relatório do cliente" (todas as pastas do cliente) espera a D12; o "Ler N
   documentos" da aba Documentos, a D13.

   Renderizado em dois lugares: dentro do drawer, no HTML da pasta, com
   `painel = null` (comandos sem análises, listas "carregando", e a aba
   Documentos conforme `documentosVisivel`); e sozinho por
   `GET /pasta/{id}/ia/agentes` (`inteligencia_agentes_painel`), que o
   `pasta-ia-agentes.js` busca ao abrir o drawer e troca inteiro.

   Contexto: `painel` (App\Inteligencia\DTO\PainelDeComandosOutput ou null),
   `sabe` (App\Inteligencia\DTO\OQueAIaSabeOutput, opcional), `documentos`
   (App\Inteligencia\DTO\DocumentosDoIndiceOutput ou null com a aba Documentos
   oculta; só com o painel carregado), `documentosVisivel` (bool, só no HTML da
   pasta), `pastaId` (int).
   ============================================================================ #}
{% set ia = ia_disponibilidade() %}
{% set comandos = ia_comandos() %}
{% set relatorios = ia_relatorios() %}
{% set indice = ia_comando_indice() %}
{% set mostrarDocumentos = painel is null ? documentosVisivel|default(false) : documentos|default(null) is not null %}
{# Escolha inicial: o primeiro com análise em andamento (o polling mostra o resultado chegando),
   senão o primeiro da grade. O JS guarda a escolha quando o painel é trocado. #}
{% set comandosEmAndamento = painel is not null ? comandos|filter(c => painel.de(c).temEmAndamento) : [] %}
{% set relatoriosEmAndamento = painel is not null ? relatorios|filter(c => painel.de(c).temEmAndamento) : [] %}
{% set escolhidoAna = comandosEmAndamento is empty ? comandos|first : comandosEmAndamento|first %}
{% set escolhidoRel = relatoriosEmAndamento is empty ? relatorios|first : relatoriosEmAndamento|first %}
<div class="ia-agentes" data-ia-painel
     data-ia-carregado="{{ painel is null ? '0' : '1' }}"
     data-ia-em-andamento="{{ painel is not null and painel.temEmAndamento ? '1' : '0' }}">
    <div class="ia-aba-painel" id="ia-aba-analise" role="tabpanel" aria-labelledby="ia-aba-btn-analise" data-ia-aba-painel="analise">
        {# IA-006: grade "O que a IA sabe desta pasta" (dc L963-965, `sabe`). Só vem com o
           painel carregado (`sabe` do controller), porque cada número é uma consulta real.
           Cada número é o que o contexto LEVA (teto da seção no montador), não o total da pasta.
           Quatro dos cinco do desenho: "fontes" é heurística do protótipo e fica de fora. #}
        {% if sabe|default(null) is not null %}
            <div class="ia-sabe" title="O que a IA sabe desta pasta" data-ia-sabe>
                {% for k in sabe.itens %}
                    <div class="ia-sabe-item" data-ia-sabe-item="{{ k.chave }}">
                        <span class="ia-sabe-v">{{ k.valor }}</span>
                        <span class="ia-sabe-l">{{ k.rotulo }}</span>
                        {# IA-006b: o número é o que a IA recebe; se o teto da seção cortou, diz de quanto. #}
                        {% if k.corte is not null %}
                            <span class="ia-sabe-l ia-sabe-corte" data-ia-sabe-corte>{{ k.corte }}</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        <p class="ia-secao-titulo">Comandos para esta pasta</p>
        <div class="ia-comandos" role="group" aria-label="Comandos para esta pasta" data-ia-grade>
            {% for c in comandos %}
                {% set saidaDoBotao = painel is not null ? painel.de(c) : null %}
                <button type="button"
                        class="ia-comando-btn{{ saidaDoBotao is not null and saidaDoBotao.temEmAndamento ? ' is-andamento' : '' }}"
                        data-ia-escolher="{{ c.value }}" aria-controls="ia-comando-{{ c.value }}"
                        aria-pressed="{{ c is same as(escolhidoAna) ? 'true' : 'false' }}">
                    <span class="ia-comando-ico" aria-hidden="true"><i class="bi {{ c.icone }}"></i></span>
                    <span class="ia-comando-rotulo">{{ c.rotulo }}</span>
                </button>
            {% endfor %}
        </div>
        {% for c in comandos %}
            {{ include('inteligencia/_comando_secao.html.twig', {comando: c, saida: painel is not null ? painel.de(c) : null, pastaId: pastaId, ia: ia, escolhido: c is same as(escolhidoAna)}, with_context = false) }}
        {% endfor %}
    </div>
    {% if mostrarDocumentos %}
        <div class="ia-aba-painel" id="ia-aba-documentos" role="tabpanel" aria-labelledby="ia-aba-btn-documentos" data-ia-aba-painel="documentos" hidden>
            {{ include('inteligencia/_documentos_indice.html.twig', {documentos: painel is null ? null : documentos, comando: indice, saida: painel is not null ? painel.de(indice) : null, pastaId: pastaId, ia: ia}, with_context = false) }}
        </div>
    {% endif %}
    <div class="ia-aba-painel" id="ia-aba-relatorios" role="tabpanel" aria-labelledby="ia-aba-btn-relatorios" data-ia-aba-painel="relatorios" hidden>
        <p class="ia-aba-intro">Relatórios executivos montados com os dados autorizados desta pasta e do cliente.</p>
        <div class="ia-relatorios" role="group" aria-label="Relatórios" data-ia-grade>
            {% for r in relatorios %}
                {% set saidaDoBotao = painel is not null ? painel.de(r) : null %}
                <button type="button"
                        class="ia-relatorio-btn{{ saidaDoBotao is not null and saidaDoBotao.temEmAndamento ? ' is-andamento' : '' }}"
                        data-ia-escolher="{{ r.value }}" aria-controls="ia-comando-{{ r.value }}"
                        aria-pressed="{{ r is same as(escolhidoRel) ? 'true' : 'false' }}">
                    <i class="bi {{ r.icone }} ia-relatorio-ico" aria-hidden="true"></i>
                    <span class="ia-relatorio-nome">{{ r.rotulo }}</span>
                    <span class="ia-relatorio-desc">{{ r.descricao }}</span>
                </button>
            {% endfor %}
        </div>
        {% for r in relatorios %}
            {{ include('inteligencia/_comando_secao.html.twig', {comando: r, saida: painel is not null ? painel.de(r) : null, pastaId: pastaId, ia: ia, escolhido: r is same as(escolhidoRel)}, with_context = false) }}
        {% endfor %}
    </div>
</div>
