{# ============================================================================
   Drawer "BlueJus IA" da pasta (spec inteligencia-agentes-da-pasta §5).

   Desenho 02 - EXPEDIENTES - VS 18.10.26 (dc L938-957): painel fixo à direita,
   460px, cabeçalho em degradê com a estrela, "BLUEJUS IA / Assistente jurídica
   do escritório", X, chips do contexto carregado desta tela e as abas (spec
   inteligencia-drawer-da-pasta, F1 a F4). As quatro abas do desenho, na ordem:
   Análise, Documentos, Relatórios e Perguntar. Documentos (F4) só aparece para
   quem não tem a aba Documentos da pasta oculta (`ia_aba_documentos_visivel`).
   Os painéis de Análise, Documentos e Relatórios moram no
   `_agentes_painel.html.twig`; o de Perguntar mora aqui, fora do painel que o JS
   troca inteiro, com o rodapé do campo (dc L1126-1131), que só aparece nessa aba.

   Incluído pelo `pasta/_cabecalho.html.twig` logo depois do botão, só para quem
   tem `modules.inteligencia.view`. Nasce `hidden`; o `pasta-ia-agentes.js` abre,
   fecha e carrega o painel (`inteligencia_agentes_painel`) na primeira abertura —
   os comandos e relatórios já vêm no HTML (sem análises) para a tela não depender
   do JS para dizer o que existe.

   Contexto: `pasta` (entidade, a mesma do cabeçalho), `ia` (enum Disponibilidade).
   ============================================================================ #}
{# Chips do contexto (IA-005, dc L852-854 e L5686): Pasta nº · cliente · nº do processo ·
   responsável, do dado REAL da pasta — o cliente principal do cadastro (nunca o
   `nome_cliente`, que é o identificador da pasta), o processo principal e o responsável.
   "Sem processo" e "Sem responsável" são os textos do próprio desenho; "Sem cliente" segue
   o mesmo padrão para a pasta sem cliente vinculado. #}
{% set iaCliente = pasta.clientePrincipal %}
{% set iaProcesso = pasta.processoPrincipal %}
{% set iaResponsavel = pasta.responsavel %}
{% set iaDocsVisivel = ia_aba_documentos_visivel(pasta) %}
<div class="ia-drawer-fundo" data-ia-fundo hidden></div>
<aside class="ia-drawer" id="psIaDrawer" role="dialog" aria-modal="true" aria-label="BlueJus IA" hidden
       data-ia-drawer
       data-ia-painel-url="{{ path('inteligencia_agentes_painel', {id: pasta.id}) }}"
       data-ia-token="{{ csrf_token('inteligencia_agentes_' ~ pasta.id) }}">
    <header class="ia-drawer-cab">
        <div class="ia-drawer-titulo">
            <span class="ia-drawer-ico" aria-hidden="true"><i class="bi bi-stars"></i></span>
            <span class="ia-drawer-marca">
                <span class="ia-drawer-marca-sup">BLUEJUS IA</span>
                <span class="ia-drawer-marca-sub">{{ 'inteligencia.drawer.assistente'|trans }}</span>
            </span>
            <button type="button" class="ia-drawer-fechar" data-ia-fechar aria-label="{{ 'inteligencia.drawer.fechar'|trans }}" title="{{ 'inteligencia.drawer.fechar'|trans }}">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="ia-drawer-chips" title="{{ 'inteligencia.drawer.chips_dica'|trans }}">
            <span class="ia-chip" data-ia-chip="pasta"><i class="bi bi-folder2-open" aria-hidden="true"></i>{{ 'inteligencia.drawer.chip_pasta'|trans({nup: pasta.nup ~ ''}) }}</span>
            <span class="ia-chip" data-ia-chip="cliente"><i class="bi bi-person" aria-hidden="true"></i>{{ iaCliente ? iaCliente.nomeExibicao : 'inteligencia.drawer.sem_cliente'|trans }}</span>
            <span class="ia-chip" data-ia-chip="processo"><i class="bi bi-diagram-3" aria-hidden="true"></i>{{ iaProcesso ? iaProcesso.numeroProcesso|numero_cnj : 'inteligencia.drawer.sem_processo'|trans }}</span>
            <span class="ia-chip" data-ia-chip="responsavel"><i class="bi bi-person-badge" aria-hidden="true"></i>{{ iaResponsavel and iaResponsavel.fullName ? iaResponsavel.fullName : 'inteligencia.drawer.sem_responsavel'|trans }}</span>
        </div>
        {# Abas do desenho (dc L955-956, `tab`): ícone + rótulo; a ativa fica branca. O
           pasta-ia-agentes.js troca o painel visível (`data-ia-aba-painel`). #}
        <div class="ia-abas" role="tablist" aria-label="{{ 'inteligencia.drawer.abas'|trans }}">
            <button type="button" class="ia-aba is-ativa" role="tab" id="ia-aba-btn-analise" data-ia-aba="analise"
                    aria-selected="true" aria-controls="ia-aba-analise">
                <i class="bi bi-activity" aria-hidden="true"></i>{{ 'inteligencia.drawer.aba_analise'|trans }}
            </button>
            {% if iaDocsVisivel %}
                <button type="button" class="ia-aba" role="tab" id="ia-aba-btn-documentos" data-ia-aba="documentos"
                        aria-selected="false" aria-controls="ia-aba-documentos" tabindex="-1">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>{{ 'inteligencia.drawer.aba_documentos'|trans }}
                </button>
            {% endif %}
            <button type="button" class="ia-aba" role="tab" id="ia-aba-btn-relatorios" data-ia-aba="relatorios"
                    aria-selected="false" aria-controls="ia-aba-relatorios" tabindex="-1">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>{{ 'inteligencia.drawer.aba_relatorios'|trans }}
            </button>
            <button type="button" class="ia-aba" role="tab" id="ia-aba-btn-perguntar" data-ia-aba="perguntar"
                    aria-selected="false" aria-controls="ia-aba-perguntar" tabindex="-1">
                <i class="bi bi-chat-dots" aria-hidden="true"></i>{{ 'inteligencia.drawer.aba_perguntar'|trans }}
            </button>
        </div>
        {% if not ia.estaDisponivel %}
            {# O motivo REAL, uma vez, no topo; cada comando repete no lugar do botão. #}
            <p class="ia-drawer-motivo" role="status" data-ia-motivo-geral="{{ ia.value }}">
                <i class="bi bi-info-circle" aria-hidden="true"></i>{{ ia.mensagem }}
            </p>
        {% endif %}
    </header>
    <div class="ia-drawer-corpo">
        <p class="ia-msg" data-ia-msg role="status" hidden></p>
        {{ include('inteligencia/_agentes_painel.html.twig', {painel: null, pastaId: pasta.id, documentosVisivel: iaDocsVisivel}) }}
        {# Aba Perguntar (F3, dc L1072-1092): a conversa nasce "carregando"; o
           pasta-ia-conversa.js busca `inteligencia_conversa_listar` quando a aba aparece. #}
        <div class="ia-aba-painel" id="ia-aba-perguntar" role="tabpanel" aria-labelledby="ia-aba-btn-perguntar" data-ia-aba-painel="perguntar" hidden
             data-ia-conversa-url="{{ path('inteligencia_conversa_listar', {id: pasta.id}) }}">
            {{ include('inteligencia/_conversa.html.twig', {conversa: null, pastaId: pasta.id}, with_context = false) }}
        </div>
    </div>
    {{ include('inteligencia/_conversa_rodape.html.twig', {pastaId: pasta.id, ia: ia}, with_context = false) }}
    {# Rodapé "Registro de auditoria (N)" (dc L1030-1035): nasce sem dados; o JS busca
       `inteligencia_auditoria_da_pasta` ao abrir o drawer e troca o rodapé inteiro. #}
    {{ include('inteligencia/_auditoria.html.twig', {auditoria: null, pastaId: pasta.id}) }}
</aside>
<link rel="stylesheet" href="/css/pasta-ia-agentes.css">
{# Textos do pasta-ia-agentes.js e do pasta-ia-conversa.js (o drawer só existe aqui, uma vez por página). #}
{{ catalogo_js('inteligencia.js.agentes', 'inteligencia.js.conversa') }}
<script src="/js/pasta-ia-agentes.js" defer></script>
<script src="/js/pasta-ia-conversa.js" defer></script>
