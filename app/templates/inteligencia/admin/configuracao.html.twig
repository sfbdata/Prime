{% extends 'base.html.twig' %}

{% block title %}BlueJus IA{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-stars me-2"></i>BlueJus IA</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : (label == 'info' ? 'info' : 'warning')) }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# ---- Estado da plataforma: o que este escritório NÃO controla ---- #}
        <div class="card mb-3" id="ia-estado">
            <div class="card-header"><strong>{{ 'inteligencia.admin.estado'|trans }}</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">{{ 'inteligencia.admin.provedor'|trans }}</dt>
                    <dd class="col-sm-8">
                        <code>{{ configuracao.provedorNome }}</code>
                        {% if configuracao.provedorConfigurado %}
                            <span class="badge text-bg-success ms-1">{{ 'inteligencia.admin.configurado'|trans }}</span>
                        {% else %}
                            <span class="badge text-bg-secondary ms-1">{{ 'inteligencia.admin.nao_configurado'|trans }}</span>
                        {% endif %}
                    </dd>
                    <dt class="col-sm-4">{{ 'inteligencia.admin.flag'|trans }}</dt>
                    <dd class="col-sm-8">
                        {% if configuracao.plataformaHabilitada %}
                            <span class="badge text-bg-success">{{ 'inteligencia.admin.ligada'|trans }}</span>
                        {% else %}
                            <span class="badge text-bg-secondary">{{ 'inteligencia.admin.desligada'|trans }}</span>
                        {% endif %}
                    </dd>
                    <dt class="col-sm-4">{{ 'inteligencia.admin.uso'|trans }}</dt>
                    <dd class="col-sm-8">
                        <span class="ps-num">{{ configuracao.usoHoje }}</span> {{ 'inteligencia.admin.uso_hoje'|trans }} ·
                        <span class="ps-num">{{ configuracao.usoMes }}</span> {{ 'inteligencia.admin.uso_mes'|trans }}
                    </dd>
                </dl>
                {% if not configuracao.plataformaHabilitada or not configuracao.provedorConfigurado %}
                    <p class="text-muted small mb-0 mt-2" id="ia-aviso-plataforma">
                        {{ 'inteligencia.admin.aviso_plataforma'|trans }}
                    </p>
                {% elseif configuracao.operacional %}
                    <p class="text-success small mb-0 mt-2" id="ia-aviso-operacional">{{ 'inteligencia.admin.operacional'|trans }}</p>
                {% endif %}
            </div>
        </div>

        {# ---- Configuração do escritório ---- #}
        <div class="card" id="ia-configuracao">
            {{ form_start(form, {attr: {novalidate: 'novalidate', id: 'form-ia-configuracao'}}) }}
            <div class="card-header"><strong>{{ 'inteligencia.admin.configuracao'|trans }}</strong></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.habilitada, {attr: {class: 'form-check-input', role: 'switch'}}) }}
                                {{ form_label(form.habilitada, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                            </div>
                            {# O que sai do escritório, dito com honestidade (IA-001/IA-001b): a lista nunca
                               descreve menos do que é enviado. Amarrada ao código por AvisoDeEnvioCobreOContextoTest:
                               `data-ia-envio="pasta.<chave>"` = cada chave do cabeçalho do MontadorDeContextoDaPasta;
                               `data-ia-envio="processo.*"` = cada campo da linha do processo vinculado;
                               `data-ia-bloco` = cada bloco delimitado (<tag>) que os prompts enviam; as seções vêm
                               do enum que o montador usa. Campo ou bloco novo no prompt = item novo aqui. #}
                            <div class="form-text text-muted" id="ia-aviso-envio">
                                {{ 'inteligencia.admin.envio.intro'|trans }}
                                <ul class="mb-1 ps-3">
                                    <li id="ia-aviso-envio-pasta" data-ia-bloco="pasta equipe">
                                        {{ 'inteligencia.admin.envio.pasta'|trans }}
                                        <span data-ia-envio="pasta.pasta">{{ 'inteligencia.admin.envio.pasta_numero'|trans }}</span>,
                                        <span data-ia-envio="pasta.situacao">{{ 'inteligencia.admin.envio.pasta_situacao'|trans }}</span>,
                                        <span data-ia-envio="pasta.prioridade">{{ 'inteligencia.admin.envio.pasta_prioridade'|trans }}</span>,
                                        <span data-ia-envio="pasta.abertura">{{ 'inteligencia.admin.envio.pasta_abertura'|trans }}</span>,
                                        <span data-ia-envio="pasta.acao">{{ 'inteligencia.admin.envio.pasta_acao'|trans }}</span>,
                                        <span data-ia-envio="pasta.responsavel">{{ 'inteligencia.admin.envio.pasta_responsavel'|trans }}</span> {{ 'inteligencia.admin.envio.e'|trans }}
                                        <span data-ia-envio="pasta.equipe">{{ 'inteligencia.admin.envio.pasta_equipe'|trans }}</span>;
                                    </li>
                                    <li id="ia-aviso-envio-processos" data-ia-bloco="processos_vinculados processo">
                                        {{ 'inteligencia.admin.envio.processos'|trans }}
                                        <span data-ia-envio="processo.numero">{{ 'inteligencia.admin.envio.processo_numero'|trans }}</span>,
                                        <span data-ia-envio="processo.classe">{{ 'inteligencia.admin.envio.processo_classe'|trans }}</span>,
                                        <span data-ia-envio="processo.assunto">{{ 'inteligencia.admin.envio.processo_assunto'|trans }}</span>,
                                        <span data-ia-envio="processo.tribunal">{{ 'inteligencia.admin.envio.processo_tribunal'|trans }}</span>,
                                        <span data-ia-envio="processo.orgao">{{ 'inteligencia.admin.envio.processo_orgao'|trans }}</span> {{ 'inteligencia.admin.envio.e'|trans }}
                                        <span data-ia-envio="processo.situacao">{{ 'inteligencia.admin.envio.processo_situacao'|trans }}</span>;
                                    </li>
                                    <li id="ia-aviso-envio-agentes">
                                        {{ 'inteligencia.admin.envio.agentes'|trans }}
                                        <span id="ia-aviso-envio-secoes">
                                            {%- for secao in enum_cases('App\\Inteligencia\\Enum\\SecaoDoContexto') -%}
                                                <span data-ia-secao="{{ secao.value }}">{{ secao.rotuloCurto }}</span>
                                                {{- loop.last ? '' : (loop.revindex == 2 ? ' ' ~ 'inteligencia.admin.envio.e'|trans ~ ' ' : ', ') -}}
                                            {%- endfor -%}
                                        </span>;
                                    </li>
                                    <li id="ia-aviso-envio-push" data-ia-bloco="movimentacoes">
                                        {{ 'inteligencia.admin.envio.push'|trans }}
                                    </li>
                                    <li id="ia-aviso-envio-analise-anterior" data-ia-bloco="analise_anterior">
                                        {{ 'inteligencia.admin.envio.analise_anterior'|trans }}
                                    </li>
                                </ul>
                                {{ 'inteligencia.admin.envio.fim'|trans }}
                            </div>
                            {% if configuracao.consentimentoEnvioExternoEm %}
                                <div class="form-text" id="ia-consentimento">
                                    {% if configuracao.consentimentoPorNome %}{{ 'inteligencia.admin.consentimento_por'|trans({quando: configuracao.consentimentoEnvioExternoEm|data_hora, nome: configuracao.consentimentoPorNome}) }}{% else %}{{ 'inteligencia.admin.consentimento'|trans({quando: configuracao.consentimentoEnvioExternoEm|data_hora}) }}{% endif %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.limiteDiario, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.limiteDiario, {attr: {class: 'form-control' ~ (form.limiteDiario.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {% if form.limiteDiario.vars.errors|length %}
                                <div class="invalid-feedback">
                                    {% for error in form.limiteDiario.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.limiteMensal, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.limiteMensal, {attr: {class: 'form-control' ~ (form.limiteMensal.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {% if form.limiteMensal.vars.errors|length %}
                                <div class="invalid-feedback">
                                    {% for error in form.limiteMensal.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                            <div class="form-text text-muted">
                                {{ 'inteligencia.admin.cotas'|trans }}
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                {{ form_widget(form.mascararDadosPessoais, {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(form.mascararDadosPessoais, null, {label_attr: {class: 'form-check-label'}}) }}
                            </div>
                            <div class="form-text text-muted">
                                {{ 'inteligencia.admin.mascarar'|trans }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> {{ 'inteligencia.admin.salvar'|trans }}
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</section>
{% endblock %}
