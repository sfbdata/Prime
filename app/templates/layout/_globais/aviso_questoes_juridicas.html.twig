{#
    Aviso das questões jurídicas da BlueJus IA (bloco "Questões jurídicas" da aba "Configurações da I.A." do Master),
    no topo de toda tela, com o componente do aviso do desenho 08 (o mesmo .ae-aviso do espaço, da falha do agendador
    e da cota de e-mail) no visual de atenção (⚠️). Só para o Master; aviso_de_questoes_juridicas() devolve null para
    os demais sem consultar o banco, e null também quando todas as questões estão resolvidas. Sem "Dispensar": o
    aviso fica enquanto houver questão não resolvida (pedido do dono, 24/10/2026). O botão leva à aba "ia" do painel,
    rolada até o bloco.
#}
{% set questoes_juridicas = aviso_de_questoes_juridicas() %}
{% if questoes_juridicas %}
    <link rel="stylesheet" href="{{ asset('css/aviso-espaco.css') }}">
    <div class="ae-aviso" data-aviso-questoes-juridicas data-print="hide" role="status">
        <span class="ae-icone" aria-hidden="true">⚠️</span>
        <div class="ae-texto">
            <b>{{ 'moldura.aviso_questoes_juridicas.titulo'|trans }}</b>
            <div>{{ 'moldura.aviso_questoes_juridicas.texto'|trans({n: questoes_juridicas.emAberto}) }}</div>
        </div>
        <a class="ae-aumentar" href="{{ questoes_juridicas.link }}">{{ 'moldura.aviso_questoes_juridicas.ver'|trans }}</a>
    </div>
{% endif %}
