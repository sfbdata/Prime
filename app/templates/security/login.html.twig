{#
    Tela de entrada: desenho "10 - Login - VS 19.10.26" (spec docs/specs/login-desenho-10.md).

    Página autônoma, sem o base.html.twig: o Master logado também vê esta tela (com as ferramentas
    SÓ MASTER), e o base trocaria a tela do desenho pelo layout do sistema. A tela é sempre clara.

    Contrato do formulário (tela-login-redesenho.md): name="email", name="password", _csrf_token
    ('authenticate'), _remember_me, botão "Entrar" e exatamente um a[href="/senha/esqueci"].
    Todo o comportamento mora em /js/auth/entrada.js; os dados chegam por data-attributes.
#}
{% set ehMaster = pagina.ehMaster %}
{% set erroLogin = error ? error.messageKey|trans(error.messageData, 'security') : '' %}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Entrar | BlueJus</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="preload" as="image" href="/images/fundo/ceu-hero-1920.avif" fetchpriority="high">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/auth/entrada.css') }}">
</head>
<body>
{#- Só http(s) vira href: o endereço é editável pelo Master. -#}
{%- set termos_href = pagina.termosUrl matches '{^https?://}i' ? pagina.termosUrl : '#' -%}
{%- set priv_href = pagina.privUrl matches '{^https?://}i' ? pagina.privUrl : '#' -%}
<div class="lg-raiz" id="lgRaiz"
     data-abrir="{{ abrir ?? '' }}"
     data-token-senha="{{ csrf_token('senha_codigo') }}"
     data-token-cadastro="{{ csrf_token('cadastro_criar') }}"
     data-token-suporte="{{ csrf_token('suporte_entrada') }}"
     {% if ehMaster %}
     data-master="1"
     data-token-ajuste="{{ csrf_token('entrada_ajuste') }}"
     data-links="{{ pagina.links|json_encode|e('html_attr') }}"
     {% endif %}>

    {# ------------------------------------------------------------------ tarja ---- #}
    <header class="lg-tarja">
        <span class="lg-tarja__logo"><img src="/images/logo/bluejus-logo-branco-completo.png" alt="BlueJus · sistema de gestão jurídica e de arquivos"></span>
        <span class="lg-tarja__div" aria-hidden="true"></span>
        {# Frase do dia: o servidor escolhe; cada palavra entra com lgPal, 0,9 s + i × 0,07 s, como no desenho. #}
        <span class="lg-frase" id="lgFrase">{% for p in frase|split(' ') %}<span class="lg-pal" style="animation-delay:{{ '%.2F'|format(0.9 + loop.index0 * 0.07) }}s">{{ p }}{{ loop.last ? '' : ' ' }}</span>{% endfor %}</span>
        <button type="button" class="lg-tarja__seg" data-seg-abrir title="Como protegemos os seus dados"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i><b>Conexão segura</b><span class="lg-ponto">·</span><span class="lg-cripto">Criptografia de ponta a ponta</span><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
    </header>

    {# -------------------------------------------------------------------- céu ---- #}
    <div class="lg-ceu" aria-hidden="true"></div>
    <div class="lg-nuvens" aria-hidden="true"></div>
    <div class="lg-veu-ceu" aria-hidden="true"></div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="lg-flash lg-flash--{{ label }}" role="status">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# ----------------------------------------------------------------- cartão ---- #}
    <main class="lg-main">
        <div class="lg-cartao-caixa" id="lgCartao">
            <form class="lg-cartao" id="lgForm" method="post" action="{{ path('app_login') }}" novalidate>
                <div class="lg-cartao__topo">
                    <span class="lg-cartao__logo"><img src="/images/logo/bluejus-logo-cor-completo.png" alt="BlueJus · sistema de gestão jurídica e de arquivos"></span>
                    <h1 class="lg-cartao__titulo">Bem-vindo de volta</h1>
                    <div class="lg-cartao__sub">Acesse sua conta para continuar</div>
                </div>
                <div class="lg-cartao__corpo">
                    <label class="lg-rotulo">E-mail<input class="lg-entrada" id="lgEmail" name="email" type="email" value="{{ last_username }}" placeholder="nome@escritorio.com.br" autocomplete="username" inputmode="email" spellcheck="false" autocapitalize="none"{% if error %} aria-invalid="true"{% endif %}></label>
                    <label class="lg-rotulo">Senha<span class="lg-senha"><input class="lg-entrada" id="lgSenha" name="password" type="password" autocomplete="current-password"{% if error %} aria-invalid="true" autofocus{% endif %}><button type="button" class="lg-olho" id="lgOlho" title="Mostrar senha" aria-label="Mostrar senha" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></span></label>
                    <div class="lg-caps" id="lgCaps" role="status" aria-live="polite" hidden><i class="bi bi-capslock-fill" aria-hidden="true"></i> Caps Lock está ativado.</div>
                    <div class="lg-linha">
                        <label class="lg-manter"><input type="checkbox" name="_remember_me" id="lgManter">Manter conectado</label>
                        <a href="{{ path('auth_senha_esqueci') }}" id="lgEsqueci">Esqueceu a senha?</a>
                    </div>
                    <div class="lg-erro" id="lgErro" role="alert"{% if erroLogin == '' %} hidden{% endif %}>{{ erroLogin }}</div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="lg-entrar" id="lgEntrar"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Entrar</button>
                    {% if googleLigado %}
                        {# Entrar com o Google (spec entrar-com-google, decisão do dono 21/10): abaixo do Entrar, com "ou". O token só
                           deixa o "Manter conectado" valer quando a ida sai deste botão. #}
                        <div class="lg-ou" aria-hidden="true"><span>ou</span></div>
                        <a class="lg-google" id="lgGoogle" href="{{ path('app_login_google', {_token: csrf_token('login_google')}) }}"><svg class="lg-google__g" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92a8.78 8.78 0 0 0 2.68-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.97 10.72A5.41 5.41 0 0 1 3.69 9c0-.6.1-1.18.28-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.05l3.01-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59A9 9 0 0 0 9 0 9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/></svg>Entrar com o Google</a>
                    {% endif %}

                    <button type="button" class="lg-selo" data-seg-abrir><span class="lg-selo__icone" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span><span class="lg-selo__texto"><b>Criptografia de ponta a ponta</b><span>O BlueJus não tem acesso aos seus arquivos nem ao conteúdo das pastas.</span></span><i class="bi bi-chevron-down lg-selo__seta" aria-hidden="true"></i></button>

                    <div class="lg-semconta">Não tem conta? <a href="{{ path('auth_cadastro') }}" id="lgCriar">Criar minha conta e escritório</a></div>
                </div>
            </form>
        </div>
    </main>

    {# ------------------------------------------------ editar link (SÓ MASTER) ---- #}
    {% if ehMaster %}
        <div id="lgLk" hidden>
            <div class="lg-lk-fundo" data-lk-fechar></div>
            <div class="lg-lk" id="lgLkCaixa" role="dialog" aria-labelledby="lgLkTit">
                <div class="lg-lk__topo"><i class="bi bi-link-45deg" id="lgLkIc" aria-hidden="true"></i><span id="lgLkTit">Editar link</span><span class="lg-mola"></span><span class="lg-lk__master">SÓ MASTER</span></div>
                <form class="lg-lk__corpo" id="lgLkForm" novalidate>
                    <input class="lg-lk__entrada" id="lgLkVal" placeholder="https://" aria-label="Endereço do link" autocomplete="off">
                    <div class="lg-lk__erro" id="lgLkErro" role="alert" hidden></div>
                    <div class="lg-lk__botoes">
                        <button type="submit" class="lg-lk__salvar">Salvar</button>
                        <button type="button" class="lg-lk__btn" data-lk="abrir">Abrir</button>
                        <button type="button" class="lg-lk__btn" data-lk="restaurar">Restaurar</button>
                        <span class="lg-mola"></span>
                        <button type="button" class="lg-lk__ocultar" id="lgLkOcultar" data-lk="ocultar">Ocultar do rodapé</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    {# ------------------------------------------------ segurança e privacidade ---- #}
    <div id="lgSeg" hidden>
        <div class="lg-fundo lg-seg-fundo" data-seg-fechar></div>
        <div class="lg-centro lg-seg-centro">
            <div class="lg-seg" role="dialog" aria-modal="true" aria-label="Segurança e privacidade">
                <div class="lg-seg__topo">
                    <button type="button" class="lg-seg__x" data-seg-fechar aria-label="Fechar"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                    <img class="lg-seg__logo" src="/images/logo/bluejus-logo-branco-completo.png" alt="BlueJus">
                    <div class="lg-seg__tag"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i>SEGURANÇA E PRIVACIDADE</div>
                    <div class="lg-seg__titulo">O sigilo do seu escritório começa aqui.</div>
                    <div class="lg-seg__lead">Advocacia é confiança. O BlueJus foi construído para que as informações dos seus clientes fiquem só com quem tem direito a elas: você e a equipe que você autorizar.</div>
                </div>
                <div class="lg-seg__corpo">
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-lock-fill"></i></span><span><b>Criptografia de ponta a ponta</b><span class="lg-seg__item-texto">Documentos, registros e conversas são cifrados antes de sair do seu aparelho e só são abertos por quem o escritório autorizou. Nem a equipe BlueJus tem acesso ao conteúdo das suas pastas.</span></span></div>
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-incognito"></i></span><span><b>Nenhum terceiro vê os seus dados</b><span class="lg-seg__item-texto">Não vendemos, não compartilhamos e não usamos as informações do escritório para publicidade. Cada conta fica isolada das demais.</span></span></div>
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-person-lock"></i></span><span><b>Você controla quem acessa</b><span class="lg-seg__item-texto">O usuário primário define permissões, oculta abas e tranca pastas sigilosas. Cada acesso e alteração fica registrado com data, hora e autor.</span></span></div>
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-globe2"></i></span><span><b>Conexão protegida</b><span class="lg-seg__item-texto">Todo o tráfego usa HTTPS com certificado válido, e as sessões de aparelhos sem uso são encerradas automaticamente.</span></span></div>
                    <div class="lg-lgpd">
                        <div class="lg-lgpd__titulo"><i class="bi bi-patch-check-fill" aria-hidden="true"></i>Em conformidade com a LGPD (Lei nº 13.709/2018)</div>
                        <div class="lg-lgpd__grade">
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> O escritório é o controlador; o BlueJus atua como operador.</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> Dados usados só para prestar o serviço contratado.</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> Direitos do titular: acesso, correção, portabilidade e exclusão.</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> Incidentes comunicados ao escritório e à ANPD.</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> Encarregado de dados (DPO) disponível.</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> Exportação completa dos seus dados quando quiser.</span>
                        </div>
                    </div>
                    <div class="lg-cresce">
                        <div class="lg-cresce__texto"><b>Segurança que ajuda o escritório a crescer</b><span>Mostrar ao cliente que os dados dele estão protegidos é diferencial na hora de fechar contrato. Com o BlueJus você atende a LGPD e transmite profissionalismo desde o primeiro atendimento.</span></div>
                        <button type="button" class="lg-cresce__btn" data-seg-fechar><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Entrar com segurança</button>
                    </div>
                    <div class="lg-seg__links">
                        <a href="{{ priv_href }}" target="_blank" rel="noopener">Política de privacidade</a>
                        <a href="{{ termos_href }}" target="_blank" rel="noopener">Termos de uso</a>
                        <a href="mailto:bluejus.86@gmail.com?subject=Encarregado%20de%20dados%20(LGPD)">Falar com o encarregado de dados</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------------------------- modal: senha por código e cadastro ---- #}
    <div id="lgMd" hidden>
        <div class="lg-fundo lg-md-fundo" data-md-fechar></div>
        <div class="lg-centro lg-md-centro">
            <div class="lg-md" role="dialog" aria-modal="true" aria-labelledby="lgMdTit">
                <div class="lg-md__topo">
                    <div class="lg-md__barra"><img src="/images/logo/bluejus-logo-branco-completo.png" alt="BlueJus"><span class="lg-mola"></span><button type="button" class="lg-md__x" data-md-fechar aria-label="Fechar"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                    <div class="lg-md__titulo" id="lgMdTit"><i class="bi" id="lgMdIc" aria-hidden="true"></i><span id="lgMdTitTxt"></span></div>
                </div>
                <form class="lg-md__corpo" id="lgMdForm" novalidate>
                    <div class="lg-md__passo" data-passo="rs1" hidden>
                        <div class="lg-md__texto">Informe o e-mail da sua conta. Enviaremos um código de 6 números para criar uma nova senha.</div>
                        <label class="lg-md__rotulo">E-mail<input class="lg-md__entrada" id="lgRsEmail" type="email" placeholder="nome@escritorio.com.br" autocomplete="username"></label>
                    </div>
                    <div class="lg-md__passo" data-passo="rs2" hidden>
                        <div class="lg-md__texto">Enviamos o código para <b id="lgRsEmailMostra"></b>. Ele vale por 15 minutos.</div>
                        <label class="lg-md__rotulo">Código<input class="lg-md__entrada" id="lgRsCod" type="text" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code"></label>
                        <label class="lg-md__rotulo">Nova senha<input class="lg-md__entrada" id="lgRsNova" type="password" placeholder="Mínimo de 8 caracteres" autocomplete="new-password"></label>
                        <div class="lg-forca" data-forca="lgRsNova"><span class="lg-forca__trilho"><span class="lg-forca__barra"></span></span><span class="lg-forca__txt"></span></div>
                        <label class="lg-md__rotulo">Confirmar nova senha<input class="lg-md__entrada" id="lgRsConf" type="password" autocomplete="new-password"></label>
                        <a href="#" class="lg-md__reenviar" id="lgRsReenviar">Reenviar código</a>
                    </div>
                    <div class="lg-md__passo" data-passo="rs3" hidden>
                        <div class="lg-pronto"><span class="lg-pronto__icone" aria-hidden="true"><i class="bi bi-check2-circle"></i></span><b>Senha alterada</b><div class="lg-pronto__texto">Entre com a nova senha. Por segurança, as outras sessões foram encerradas.</div></div>
                    </div>
                    <div class="lg-md__passo" data-passo="cad" hidden>
                        <div class="lg-md__texto">Crie seu escritório digital em 1 minuto. Você entra como usuário primário e depois convida a sua equipe.</div>
                        <label class="lg-md__rotulo">Seu nome completo<input class="lg-md__entrada" id="lgCdNome" type="text" autocomplete="name"></label>
                        <label class="lg-md__rotulo">Nome do escritório<input class="lg-md__entrada" id="lgCdEsc" type="text" placeholder="Ex.: Silva Advogados Associados" autocomplete="organization"></label>
                        <label class="lg-md__rotulo">E-mail<input class="lg-md__entrada" id="lgCdEmail" type="email" placeholder="nome@escritorio.com.br" autocomplete="email"></label>
                        <label class="lg-md__rotulo">Senha<input class="lg-md__entrada" id="lgCdSenha" type="password" placeholder="Mínimo de 8 caracteres" autocomplete="new-password"></label>
                        <div class="lg-forca" data-forca="lgCdSenha"><span class="lg-forca__trilho"><span class="lg-forca__barra"></span></span><span class="lg-forca__txt"></span></div>
                        <label class="lg-aceite"><input type="checkbox" id="lgCdAceite"><span>Li e aceito os <a href="{{ termos_href }}" target="_blank" rel="noopener">Termos de uso</a> e a <a href="{{ priv_href }}" target="_blank" rel="noopener">Política de privacidade</a>.</span></label>
                    </div>
                    <div class="lg-md__erro" id="lgMdErro" role="alert" hidden><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <span id="lgMdErroTxt"></span></div>
                    <button type="submit" class="lg-md__acao" id="lgMdAcao"><i class="bi" id="lgMdBtnIc" aria-hidden="true"></i><span id="lgMdBtnTxt"></span></button>
                    <div class="lg-md__jatem" data-passo="cad" hidden>Já tem conta? <a href="#" data-md-fechar>Entrar</a></div>
                </form>
            </div>
        </div>
    </div>

    {# ---------------------------------------------- véu da conta recém-criada ---- #}
    <div class="lg-veu" id="lgVeu" hidden>
        <span class="lg-veu__anel"><img src="/images/logo/bluejus-simbolo-branco.png" alt=""></span>
        <div class="lg-veu__textos"><div class="lg-veu__titulo" id="lgVeuTit"></div><div class="lg-veu__sub">Abrindo o seu escritório digital…</div></div>
        <div class="lg-veu__trilho"><div class="lg-veu__barra"></div></div>
    </div>

    {# ----------------------------------------------------------------- rodapé ---- #}
    <footer class="lg-rodape">
        <span>© {{ 'now'|date('Y') }} BlueJus</span><span>·</span>
        <span class="lg-links" id="lgLinks">
            {%- for l in pagina.links -%}
                {%- if not loop.first and not (l.icone != '' and pagina.links[loop.index0 - 1].icone != '') -%}<span>·</span>{%- endif -%}
                {%- set href = l.url matches '{^https?://}i' ? l.url : '#' -%}
                <a href="{{ href }}" target="_blank" rel="noopener" data-chave="{{ l.chave }}" class="{{ l.icone != '' ? 'lg-link--icone' : 'lg-link--texto' }}" title="{{ l.rotulo }}{{ ehMaster ? ' · botão direito para editar' : '' }}"{% if l.icone != '' %} aria-label="{{ l.rotulo }}"{% endif %}>
                    {%- if l.icone != '' %}<i class="bi {{ l.icone }}" aria-hidden="true"></i>{% else %}{{ l.rotulo }}{% endif -%}
                </a>
            {%- endfor -%}
        </span>
        <span class="lg-mola"></span>

        {# ------------------------------------------------------------- suporte ---- #}
        <div class="lg-sup" id="lgSup" role="dialog" aria-label="Falar com suporte" hidden>
            <div class="lg-sup__topo">
                <span class="lg-sup__avatar" aria-hidden="true"><i class="bi bi-headset"></i></span>
                <span class="lg-sup__cab"><b>Suporte BlueJus</b><span>Sua mensagem vai direto para a equipe</span></span>
                {% if ehMaster %}
                    <button type="button" class="lg-sup__icbtn" id="lgDlgTg" title="Quem recebe o suporte" aria-expanded="false"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                {% endif %}
                <button type="button" class="lg-sup__icbtn" id="lgSupFechar" aria-label="Fechar"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            {% if ehMaster %}
                <div class="lg-dlg" id="lgDlg" hidden>
                    <div class="lg-dlg__titulo">QUEM RECEBE AS MENSAGENS DE SUPORTE · SÓ MASTER VÊ</div>
                    <div class="lg-dlg__lista">
                        {% for d in pagina.destinatarios %}
                            <button type="button" class="lg-dlg__op{{ d.escolhido ? ' lg-on' : '' }}" data-user-id="{{ d.id }}" aria-pressed="{{ d.escolhido ? 'true' : 'false' }}"><i class="bi {{ d.escolhido ? 'bi-check-circle-fill' : 'bi-circle' }}" aria-hidden="true"></i><span class="lg-dlg__nome">{{ d.nome }}</span><span class="lg-dlg__cargo">{{ d.cargo }}</span></button>
                        {% endfor %}
                    </div>
                    <div class="lg-dlg__texto" id="lgDlgTxt">{{ pagina.textoDestinatario }}</div>
                </div>
            {% endif %}
            <div class="lg-sup__ok" id="lgSupOk" hidden>
                <span class="lg-sup__ok-icone" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                <b>Mensagem enviada</b>
                <div class="lg-sup__ok-texto">A equipe BlueJus recebeu no chat e vai responder no e-mail <span id="lgSupOkEmail"></span>.</div>
            </div>
            <form class="lg-sup__form" id="lgSupForm" novalidate>
                <input class="lg-sup__entrada" id="lgSupNome" placeholder="Seu nome" aria-label="Seu nome" autocomplete="name">
                <input class="lg-sup__entrada" id="lgSupEmail" type="email" placeholder="E-mail para resposta" aria-label="E-mail para resposta" autocomplete="email">
                <div class="lg-pote" aria-hidden="true"><input name="site" id="lgSupSite" tabindex="-1" autocomplete="off"></div>
                <div class="lg-sup__chips">
                    {% for assunto in ['Não consigo entrar', 'Esqueci a senha', 'Criar conta', 'Outro assunto'] %}
                        <button type="button" class="lg-chip" data-assunto="{{ assunto }}" aria-pressed="false">{{ assunto }}</button>
                    {% endfor %}
                </div>
                <textarea class="lg-sup__msg" id="lgSupMsg" rows="3" placeholder="Como podemos ajudar?" aria-label="Como podemos ajudar?"></textarea>
                <div class="lg-sup__erro" id="lgSupErro" role="alert" hidden></div>
