{#
    Tela de entrada: desenho "10 - Login - VS 25.10.26" (specs docs/specs/login-desenho-10.md e
    docs/specs/login-desenho-10-24-10.md, o delta da VS 24.10.26).

    Página autônoma, sem o base.html.twig: o Master logado também vê esta tela (com as ferramentas
    SÓ MASTER), e o base trocaria a tela do desenho pelo layout do sistema. A tela é sempre clara.

    Contrato do formulário (tela-login-redesenho.md): name="email", name="password", _csrf_token
    ('authenticate'), _remember_me, botão "Entrar" e exatamente um a[href="/senha/esqueci"].
    Todo o comportamento mora em /js/auth/entrada.js; os dados chegam por data-attributes.
#}
{% set ehMaster = pagina.ehMaster %}
{% set erroLogin = error ? error.messageKey|trans(error.messageData, 'security') : (a_confirmar ?? '') %}
{# Google sem o cliente OAuth no servidor (decisão do dono de 24/10): nenhum botão do Google na tela; quem abre a URL
   direto volta com o aviso, no cartão ou no "Criar conta". #}
{% set googleDisponivel = googleDisponivel ?? false %}
{# Facebook sem o app da Meta no servidor: o botão some (spec login-cupom-e-facebook, PR B). #}
{% set facebookDisponivel = facebookDisponivel ?? false %}
{% set cadastroSocial = cadastroSocial ?? null %}
{% set avisoGoogle = avisoGoogle ?? null %}
{# Política de cadastro do Master (spec login-config-cadastro): `on` aberto, `convite` ou `off` escondem o "Criar conta"
   e os botões sociais do cadastro; quem chega por ?abrir=cadastro, /cadastro ou /i/ lê o aviso no cartão de login. #}
{% set cadastro = cadastro ?? 'on' %}
{% set cadastroAberto = cadastro == 'on' %}
{% set avisoCadastro = cadastroAberto ? '' : ('entrada.cadastro.aviso.' ~ (cadastro == 'off' ? 'off' : 'convite'))|trans %}
{% set avisoGoogleTexto = 'entrada.login.google_nao_configurado'|trans %}
{% if avisoGoogle == 'login' and erroLogin == '' %}{% set erroLogin = avisoGoogleTexto %}{% endif %}
{% if not cadastroAberto and erroLogin == '' and ((abrir ?? '') == 'cadastro' or (cupom ?? '') != '') %}{% set erroLogin = avisoCadastro %}{% endif %}
{% set ContaAConfirmar = 'App\\Auth\\Service\\ContaAConfirmar' %}
{# Os assuntos são dado (o servidor compara o português, EnviarMensagemSuporteInput::ASSUNTOS); só o rótulo é do catálogo. #}
{% set assuntosDoSuporte = {'Não consigo entrar': 'entrada.suporte.assunto.nao_consigo_entrar'|trans, 'Esqueci a senha': 'entrada.suporte.assunto.esqueci_a_senha'|trans, 'Criar conta': 'entrada.suporte.assunto.criar_conta'|trans, 'Outro assunto': 'entrada.suporte.assunto.outro'|trans} %}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ 'entrada.login.titulo_pagina'|trans }}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="preload" as="image" href="/images/fundo/ceu-hero-1920.avif" fetchpriority="high">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/auth/entrada.css') }}">
</head>
<body>
{#- Só http(s) vira href: o endereço é editável pelo Master. -#}
{%- set termos_href = pagina.termosUrl matches '{^https?://}i' ? pagina.termosUrl : '#' -%}
{%- set priv_href = pagina.privUrl matches '{^https?://}i' ? pagina.privUrl : '#' -%}
<div class="lg-raiz" id="lgRaiz"
     data-abrir="{{ abrir ?? '' }}"
     data-ind="{{ cupom ?? '' }}"
     data-token-senha="{{ csrf_token('senha_codigo') }}"
     data-token-cadastro="{{ csrf_token('cadastro_criar') }}"
     data-token-reenvio="{{ csrf_token(constant(ContaAConfirmar ~ '::CSRF')) }}"
     data-token-suporte="{{ csrf_token('suporte_entrada') }}"
     {% if not cadastroAberto %}data-cadastro-bloqueado="1"{% endif %}
     {% if avisoGoogle == 'cadastro' and cadastroAberto %}data-aviso-cadastro="{{ avisoGoogleTexto }}"{% endif %}
     {% if ehMaster %}
     data-master="1"
     data-token-ajuste="{{ csrf_token('entrada_ajuste') }}"
     data-links="{{ pagina.links|json_encode|e('html_attr') }}"
     {% endif %}>

    {# ------------------------------------------------------------------ tarja ---- #}
    <header class="lg-tarja" data-bjt-cabecalho>
        <span class="lg-tarja__logo"><img src="/images/logo/bluejus-logo-branco-completo.png" data-bjt-logo alt="{{ 'entrada.login.logo_alt'|trans }}"></span>
        <span class="lg-tarja__div" aria-hidden="true"></span>
        {# Frase do dia: o servidor escolhe; cada palavra entra com lgPal, 0,9 s + i × 0,07 s, como no desenho. #}
        <span class="lg-frase" id="lgFrase">{% for p in frase|split(' ') %}<span class="lg-pal" style="animation-delay:{{ '%.2F'|format(0.9 + loop.index0 * 0.07) }}s">{{ p }}{{ loop.last ? '' : ' ' }}</span>{% endfor %}</span>
        <button type="button" class="lg-tarja__seg" data-seg-abrir title="{{ 'entrada.login.como_protegemos'|trans }}"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i><b>{{ 'entrada.login.conexao_segura'|trans }}</b><span class="lg-ponto">·</span><span class="lg-cripto">{{ 'entrada.login.criptografia'|trans }}</span><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
    </header>

    {# -------------------------------------------------------------------- céu ---- #}
    <div class="lg-ceu" aria-hidden="true"></div>
    <div class="lg-nuvens" aria-hidden="true"></div>
    <div class="lg-veu-ceu" aria-hidden="true"></div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="lg-flash lg-flash--{{ label }}" role="status">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# ----------------------------------------------------------------- cartão ---- #}
    <main class="lg-main">
        <div class="lg-cartao-caixa" id="lgCartao">
            <form class="lg-cartao" id="lgForm" method="post" action="{{ path('app_login') }}" novalidate>
                <div class="lg-cartao__topo">
                    <span class="lg-cartao__logo"><img src="/images/logo/bluejus-logo-cor-completo.png" data-bjt-logo alt="{{ 'entrada.login.logo_alt'|trans }}"></span>
                    <h1 class="lg-cartao__titulo">{{ 'entrada.login.bem_vindo'|trans }}</h1>
                    <div class="lg-cartao__sub">{{ 'entrada.login.acesse'|trans }}</div>
                </div>
                <div class="lg-cartao__corpo">
                    <label class="lg-rotulo">{{ 'entrada.login.email'|trans }}<input class="lg-entrada" id="lgEmail" name="email" type="email" value="{{ last_username }}" placeholder="{{ 'entrada.login.email_exemplo'|trans }}" autocomplete="username" inputmode="email" spellcheck="false" autocapitalize="none"{% if error %} aria-invalid="true"{% endif %}></label>
                    <label class="lg-rotulo">{{ 'entrada.login.senha'|trans }}<span class="lg-senha"><input class="lg-entrada" id="lgSenha" name="password" type="password" autocomplete="current-password"{% if error %} aria-invalid="true" autofocus{% endif %}><button type="button" class="lg-olho" id="lgOlho" title="{{ 'entrada.login.mostrar_senha'|trans }}" aria-label="{{ 'entrada.login.mostrar_senha'|trans }}" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></span></label>
                    <div class="lg-caps" id="lgCaps" role="status" aria-live="polite" hidden><i class="bi bi-capslock-fill" aria-hidden="true"></i> {{ 'entrada.login.caps_lock'|trans }}</div>
                    <div class="lg-linha">
                        <label class="lg-manter"><input type="checkbox" name="_remember_me" id="lgManter">{{ 'entrada.login.manter_conectado'|trans }}</label>
                        <a href="{{ path('auth_senha_esqueci') }}" id="lgEsqueci">{{ 'entrada.login.esqueceu'|trans }}</a>
                    </div>
                    <div class="lg-erro" id="lgErro" role="alert"{% if erroLogin == '' %} hidden{% endif %}>{{ erroLogin }}</div>
                    {# Conta a confirmar (spec cadastro-exige-confirmacao): o botão envia o form #lgReenvio, fora deste form. #}
                    {% if a_confirmar %}
                        <button type="submit" class="lg-reenviar" id="lgReenviar" form="lgReenvio"><i class="bi bi-envelope-arrow-up" aria-hidden="true"></i>{{ constant(ContaAConfirmar ~ '::BOTAO_REENVIAR') }}</button>
                    {% endif %}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="lg-entrar" id="lgEntrar"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>{{ 'entrada.login.entrar'|trans }}</button>
                    {# Entrar com o Google (spec entrar-com-google, decisões do dono 21/10 e 24/10): abaixo do Entrar, com "ou",
                       só quando o cliente OAuth está configurado (sem ele, nem o botão nem o "ou"). O token só deixa o
                       "Manter conectado" valer quando a ida sai deste botão. #}
                    {% if googleDisponivel %}
                    <div class="lg-ou" aria-hidden="true"><span>{{ 'entrada.login.ou'|trans }}</span></div>
                    <a class="lg-google" id="lgGoogle" href="{{ path('app_login_google', {_token: csrf_token('login_google')}) }}"><svg class="lg-google__g" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92a8.78 8.78 0 0 0 2.68-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.97 10.72A5.41 5.41 0 0 1 3.69 9c0-.6.1-1.18.28-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.05l3.01-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59A9 9 0 0 0 9 0 9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/></svg>{{ 'entrada.login.entrar_google'|trans }}</a>
                    {% endif %}

                    <button type="button" class="lg-selo" data-seg-abrir><span class="lg-selo__icone" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span><span class="lg-selo__texto"><b>{{ 'entrada.login.criptografia'|trans }}</b><span>{{ 'entrada.login.selo_texto'|trans }}</span></span><i class="bi bi-chevron-down lg-selo__seta" aria-hidden="true"></i></button>

                    {% if cadastroAberto %}
                    <div class="lg-semconta">{{ 'entrada.login.sem_conta'|trans }} <a href="{{ path('auth_cadastro') }}" id="lgCriar">{{ 'entrada.login.criar_conta'|trans }}</a></div>
                    {% endif %}
                </div>
            </form>
            {% if a_confirmar %}
                <form id="lgReenvio" method="post" action="{{ path('auth_confirmacao_reenviar_publico') }}" hidden>
                    <input type="hidden" name="_token" value="{{ csrf_token(constant(ContaAConfirmar ~ '::CSRF')) }}">
                </form>
            {% endif %}
        </div>
    </main>

    {# ------------------------------------------------ editar link (SÓ MASTER) ---- #}
    {% if ehMaster %}
        <div id="lgLk" hidden>
            <div class="lg-lk-fundo" data-lk-fechar></div>
            <div class="lg-lk" id="lgLkCaixa" role="dialog" aria-labelledby="lgLkTit">
                <div class="lg-lk__topo"><i class="bi bi-link-45deg" id="lgLkIc" aria-hidden="true"></i><span id="lgLkTit">{{ 'entrada.link.titulo'|trans }}</span><span class="lg-mola"></span><span class="lg-lk__master">{{ 'entrada.link.so_master'|trans({papel: 'termos.master'|trans|upper}) }}</span></div>
                <form class="lg-lk__corpo" id="lgLkForm" novalidate>
                    <input class="lg-lk__entrada" id="lgLkVal" placeholder="https://" aria-label="{{ 'entrada.link.endereco'|trans }}" autocomplete="off">
                    <div class="lg-lk__erro" id="lgLkErro" role="alert" hidden></div>
                    <div class="lg-lk__botoes">
                        <button type="submit" class="lg-lk__salvar">{{ 'entrada.link.salvar'|trans }}</button>
                        <button type="button" class="lg-lk__btn" data-lk="abrir">{{ 'entrada.link.abrir'|trans }}</button>
                        <button type="button" class="lg-lk__btn" data-lk="restaurar">{{ 'entrada.link.restaurar'|trans }}</button>
                        <span class="lg-mola"></span>
                        <button type="button" class="lg-lk__ocultar" id="lgLkOcultar" data-lk="ocultar">{{ 'entrada.link.ocultar'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    {# ------------------------------------------------ segurança e privacidade ---- #}
    <div id="lgSeg" hidden>
        <div class="lg-fundo lg-seg-fundo" data-seg-fechar></div>
        <div class="lg-centro lg-seg-centro">
            <div class="lg-seg" role="dialog" aria-modal="true" aria-label="{{ 'entrada.seguranca.rotulo'|trans }}">
                <div class="lg-seg__topo">
                    <button type="button" class="lg-seg__x" data-seg-fechar aria-label="{{ 'entrada.login.fechar'|trans }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                    <img class="lg-seg__logo" src="/images/logo/bluejus-logo-branco-completo.png" data-bjt-logo alt="BlueJus">
                    <div class="lg-seg__tag"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i>{{ 'entrada.seguranca.tag'|trans }}</div>
                    <div class="lg-seg__titulo">{{ 'entrada.seguranca.titulo'|trans }}</div>
                    <div class="lg-seg__lead">{{ 'entrada.seguranca.lead'|trans }}</div>
                </div>
                <div class="lg-seg__corpo">
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-lock-fill"></i></span><span><b>{{ 'entrada.login.criptografia'|trans }}</b><span class="lg-seg__item-texto">{{ 'entrada.seguranca.criptografia_texto'|trans }}</span></span></div>
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-incognito"></i></span><span><b>{{ 'entrada.seguranca.terceiros'|trans }}</b><span class="lg-seg__item-texto">{{ 'entrada.seguranca.terceiros_texto'|trans }}</span></span></div>
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-person-lock"></i></span><span><b>{{ 'entrada.seguranca.controle'|trans }}</b><span class="lg-seg__item-texto">{{ 'entrada.seguranca.controle_texto'|trans }}</span></span></div>
                    <div class="lg-seg__item"><span class="lg-seg__item-icone" aria-hidden="true"><i class="bi bi-globe2"></i></span><span><b>{{ 'entrada.seguranca.conexao'|trans }}</b><span class="lg-seg__item-texto">{{ 'entrada.seguranca.conexao_texto'|trans }}</span></span></div>
                    <div class="lg-lgpd">
                        <div class="lg-lgpd__titulo"><i class="bi bi-patch-check-fill" aria-hidden="true"></i>{{ 'entrada.seguranca.lgpd.titulo'|trans }}</div>
                        <div class="lg-lgpd__grade">
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> {{ 'entrada.seguranca.lgpd.controlador'|trans }}</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> {{ 'entrada.seguranca.lgpd.finalidade'|trans }}</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> {{ 'entrada.seguranca.lgpd.direitos'|trans }}</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> {{ 'entrada.seguranca.lgpd.incidentes'|trans }}</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> {{ 'entrada.seguranca.lgpd.encarregado'|trans }}</span>
                            <span><i class="bi bi-check2 lg-ok" aria-hidden="true"></i> {{ 'entrada.seguranca.lgpd.exportacao'|trans }}</span>
                        </div>
                    </div>
                    <div class="lg-cresce">
                        <div class="lg-cresce__texto"><b>{{ 'entrada.seguranca.cresce'|trans }}</b><span>{{ 'entrada.seguranca.cresce_texto'|trans }}</span></div>
                        <button type="button" class="lg-cresce__btn" data-seg-fechar><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>{{ 'entrada.seguranca.entrar'|trans }}</button>
                    </div>
                    <div class="lg-seg__links">
                        <a href="{{ priv_href }}" target="_blank" rel="noopener">{{ 'entrada.seguranca.privacidade'|trans }}</a>
                        <a href="{{ termos_href }}" target="_blank" rel="noopener">{{ 'entrada.seguranca.termos'|trans }}</a>
                        <a href="mailto:bluejus.86@gmail.com?subject=Encarregado%20de%20dados%20(LGPD)">{{ 'entrada.seguranca.falar_com_encarregado'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------------------------- modal: senha por código e cadastro ---- #}
    <div id="lgMd" hidden>
        <div class="lg-fundo lg-md-fundo" data-md-fechar></div>
        <div class="lg-centro lg-md-centro">
            <div class="lg-md" role="dialog" aria-modal="true" aria-labelledby="lgMdTit">
                <div class="lg-md__topo">
                    <div class="lg-md__barra"><img src="/images/logo/bluejus-logo-branco-completo.png" data-bjt-logo alt="BlueJus"><span class="lg-mola"></span><button type="button" class="lg-md__x" data-md-fechar aria-label="{{ 'entrada.login.fechar'|trans }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                    <div class="lg-md__titulo" id="lgMdTit"><i class="bi" id="lgMdIc" aria-hidden="true"></i><span id="lgMdTitTxt"></span></div>
                </div>
                <form class="lg-md__corpo" id="lgMdForm" novalidate>
                    <div class="lg-md__passo" data-passo="rs1" hidden>
                        <div class="lg-md__texto">{{ 'entrada.modal.recuperar_texto'|trans }}</div>
                        <label class="lg-md__rotulo">{{ 'entrada.login.email'|trans }}<input class="lg-md__entrada" id="lgRsEmail" type="email" placeholder="{{ 'entrada.login.email_exemplo'|trans }}" autocomplete="username"></label>
                    </div>
                    <div class="lg-md__passo" data-passo="rs2" hidden>
                        <div class="lg-md__texto">{{ 'entrada.modal.enviamos_antes'|trans }} <b id="lgRsEmailMostra"></b>{{ 'entrada.modal.enviamos_depois'|trans }}</div>
                        <label class="lg-md__rotulo">{{ 'entrada.modal.codigo'|trans }}<input class="lg-md__entrada" id="lgRsCod" type="text" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code"></label>
                        <label class="lg-md__rotulo">{{ 'entrada.modal.nova_senha'|trans }}<input class="lg-md__entrada" id="lgRsNova" type="password" placeholder="{{ 'entrada.modal.minimo'|trans }}" autocomplete="new-password"></label>
                        <div class="lg-forca" data-forca="lgRsNova"><span class="lg-forca__trilho"><span class="lg-forca__barra"></span></span><span class="lg-forca__txt"></span></div>
                        <label class="lg-md__rotulo">{{ 'entrada.modal.confirmar_nova'|trans }}<input class="lg-md__entrada" id="lgRsConf" type="password" autocomplete="new-password"></label>
                        <a href="#" class="lg-md__reenviar" id="lgRsReenviar">{{ 'entrada.modal.reenviar_codigo'|trans }}</a>
                    </div>
                    <div class="lg-md__passo" data-passo="rs3" hidden>
                        <div class="lg-pronto"><span class="lg-pronto__icone" aria-hidden="true"><i class="bi bi-check2-circle"></i></span><b>{{ 'entrada.modal.senha_alterada'|trans }}</b><div class="lg-pronto__texto">{{ 'entrada.modal.senha_alterada_texto'|trans }}</div></div>
                    </div>
                    <div class="lg-md__passo" data-passo="cad" hidden>
                        <div class="lg-md__texto">{{ 'entrada.modal.cadastro_texto'|trans }}</div>
                        {# Desenho 10 VS 24.10.26: Continuar com Google acima dos campos; conectado, o cartão da conta no lugar dos
                           botões e sem o campo E-mail (spec entrar-com-google, entrega 2). O Google só aparece com o cliente OAuth
                           configurado (decisão do dono de 24/10: nenhum botão que não funciona). O Facebook (PR B da spec
                           login-cupom-e-facebook) vem logo depois e some sem o app da Meta; conectado por ele, o campo E-mail
                           continua visível (o Facebook não prova e-mail). #}
                        {% if cadastroAberto and (googleDisponivel or facebookDisponivel) %}
                        <div class="lg-soc" id="lgCdSoc"{% if cadastroSocial %} hidden{% endif %}>
                            {% if googleDisponivel %}
                            <a class="lg-soc__btn" id="lgCdGoogle" href="{{ path('app_login_google', {_token: csrf_token('login_google'), origem: 'cadastro'}) }}"><svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>{{ 'entrada.modal.continuar_google'|trans }}</a>
                            {% endif %}
                            {% if facebookDisponivel %}
                            <a class="lg-soc__btn" id="lgCdFacebook" href="{{ path('app_login_facebook', {_token: csrf_token('login_facebook')}) }}"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/><path fill="#fff" d="M16.67 15.56l.53-3.49h-3.33V9.82c0-.96.47-1.89 1.96-1.89h1.51V4.96s-1.37-.24-2.68-.24c-2.74 0-4.53 1.67-4.53 4.69v2.66H7.08v3.49h3.05V24c.61.1 1.24.14 1.87.14s1.26-.05 1.87-.14v-8.44h2.8z"/></svg>{{ 'entrada.modal.continuar_facebook'|trans }}</a>
                            {% endif %}
                            <div class="lg-soc__ou"><span></span>{{ 'entrada.modal.ou_outro_email'|trans }}<span></span></div>
                        </div>
                        {% endif %}
                        <div class="lg-socok" id="lgCdSocOk" data-provedor="{{ cadastroSocial ? cadastroSocial.chave }}" data-email="{{ cadastroSocial and not cadastroSocial.emailVisivel ? cadastroSocial.email }}"{% if not cadastroSocial %} hidden{% endif %}>
                            <span class="lg-socok__ini" id="lgCdSocIni" aria-hidden="true"></span>
                            <span class="lg-socok__txt"><b id="lgCdSocNome">{{ cadastroSocial ? (cadastroSocial.nome ?: cadastroSocial.email) }}</b><span>{% if cadastroSocial and cadastroSocial.emailVisivel %}{{ 'entrada.modal.conectado_pelo_sem_email'|trans({provedor: cadastroSocial.provedor}) }}{% else %}{{ 'entrada.modal.conectado_pelo'|trans({email: cadastroSocial ? cadastroSocial.email : '', provedor: cadastroSocial ? cadastroSocial.provedor : 'Google'}) }}{% endif %}</span></span>
                            <button type="button" class="lg-socok__trocar" id="lgCdSocTrocar">{{ 'entrada.modal.usar_outro_email'|trans }}</button>
                        </div>
                        <label class="lg-md__rotulo">{{ 'entrada.modal.nome_completo'|trans }}<input class="lg-md__entrada" id="lgCdNome" type="text" autocomplete="name" value="{{ cadastroSocial ? cadastroSocial.nome }}"></label>
                        <label class="lg-md__rotulo" id="lgCdEscCampo">{{ 'entrada.modal.escritorio'|trans }}<input class="lg-md__entrada" id="lgCdEsc" type="text" placeholder="{{ 'entrada.modal.escritorio_exemplo'|trans }}" autocomplete="organization"></label>
                        {# Desenho 10 VS 25.10.26: cupom de indicação entre o escritório e o e-mail. Conferido ao vivo pelo
                           entrada.js (spec login-cupom-ao-vivo: só "Cupom válido", sem o nome de quem indicou) e de novo ao
                           enviar; o "5 GB extras" é o bônus real (spec bonus-de-espaco-por-indicacao), com o valor vindo da
                           constante do bônus para a tela não prometer mais do que se concede. O texto de status fica
                           dentro do rótulo, abaixo do campo, como no desenho. #}
                        <button type="button" class="lg-cupom" id="lgCdIndTg" role="switch" aria-checked="false" aria-controls="lgCdIndCampo"><span class="lg-chave" aria-hidden="true"><span class="lg-chave__bola"></span></span>{{ 'entrada.modal.cupom'|trans }}</button>
                        <label class="lg-md__rotulo" id="lgCdIndCampo" hidden><input class="lg-md__entrada lg-cupom__entrada" id="lgCdInd" type="text" placeholder="{{ 'entrada.modal.cupom_exemplo'|trans }}" maxlength="11" autocomplete="off" spellcheck="false" aria-label="{{ 'entrada.modal.cupom'|trans }}"><span class="lg-cupom__status" id="lgCdIndStatus" role="status" aria-live="polite" data-url="{{ path('auth_cadastro_cupom_conferir') }}" data-valido="{{ 'entrada.modal.cupom_valido'|trans({'gb': constant('App\\Contribua\\Entity\\BonusDeEspaco::GIGABYTES_DA_INDICACAO')}) }}" data-nao-encontrado="{{ 'entrada.modal.cupom_nao_encontrado'|trans }}" hidden></span></label>
                        <label class="lg-md__rotulo" id="lgCdEmailCampo"{% if cadastroSocial and not cadastroSocial.emailVisivel %} hidden{% endif %}>{{ 'entrada.login.email'|trans }}<input class="lg-md__entrada" id="lgCdEmail" type="email" placeholder="{{ 'entrada.login.email_exemplo'|trans }}" autocomplete="email" value="{{ cadastroSocial and cadastroSocial.emailVisivel ? cadastroSocial.email }}"></label>
                        {# Gênero obrigatório, sem valor escolhido (spec genero-no-cadastro; desvio autorizado do desenho 10). #}
                        <label class="lg-md__rotulo">{{ 'entrada.modal.genero'|trans }}<select class="lg-md__entrada" id="lgCdGenero" name="genero"><option value="">{{ 'entrada.modal.genero_escolha'|trans }}</option><option value="feminino">{{ 'entrada.modal.genero_feminino'|trans }}</option><option value="masculino">{{ 'entrada.modal.genero_masculino'|trans }}</option></select></label>
                        <label class="lg-aceite"><input type="checkbox" id="lgCdAceite"><span>{{ 'entrada.modal.li_e_aceito_os'|trans }} <a href="{{ termos_href }}" target="_blank" rel="noopener">{{ 'entrada.seguranca.termos'|trans }}</a> {{ 'entrada.modal.e_a'|trans }} <a href="{{ priv_href }}" target="_blank" rel="noopener">{{ 'entrada.seguranca.privacidade'|trans }}</a>.</span></label>
                    </div>
                    {# Depois do cadastro: a conta só entra com o e-mail confirmado (spec cadastro-exige-confirmacao). #}
                    <div class="lg-md__passo" data-passo="conf" data-titulo="{{ constant(ContaAConfirmar ~ '::TITULO') }}" data-botao="{{ constant(ContaAConfirmar ~ '::BOTAO_REENVIAR') }}" hidden>
                        <div class="lg-md__texto">{{ constant(ContaAConfirmar ~ '::TEXTO_ENVIAMOS_ANTES') }} <b id="lgCfEmail"></b>{{ constant(ContaAConfirmar ~ '::TEXTO_ENVIAMOS_DEPOIS') }}</div>
                        <div class="lg-md__texto">{{ constant(ContaAConfirmar ~ '::TEXTO_NAO_RECEBEU') }}</div>
                        <div class="lg-md__aviso" id="lgCfAviso" role="status" hidden></div>
                    </div>
                    <div class="lg-md__erro" id="lgMdErro" role="alert" hidden><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <span id="lgMdErroTxt"></span></div>
                    <button type="submit" class="lg-md__acao" id="lgMdAcao"><i class="bi" id="lgMdBtnIc" aria-hidden="true"></i><span id="lgMdBtnTxt"></span></button>
                    <div class="lg-md__jatem" data-passo="cad" hidden>{{ 'entrada.modal.ja_tem_conta'|trans }} <a href="#" data-md-fechar>{{ 'entrada.login.entrar'|trans }}</a></div>
                    <div class="lg-md__jatem" data-passo="conf" hidden><a href="#" data-md-fechar>{{ constant(ContaAConfirmar ~ '::LINK_LOGIN') }}</a></div>
                </form>
            </div>
        </div>
    </div>

    {# ---------------------------------------------- véu da conta recém-criada ---- #}
    <div class="lg-veu" id="lgVeu" hidden>
        <span class="lg-veu__anel"><img src="/images/logo/bluejus-simbolo-branco.png" alt=""></span>
        <div class="lg-veu__textos"><div class="lg-veu__titulo" id="lgVeuTit"></div><div class="lg-veu__sub">{{ 'entrada.abrindo'|trans }}</div></div>
        <div class="lg-veu__trilho"><div class="lg-veu__barra"></div></div>
    </div>

    {# ----------------------------------------------------------------- rodapé ---- #}
    <footer class="lg-rodape">
        <span>{{ 'entrada.login.direitos'|trans({ano: 'now'|date('Y')}) }}</span><span>·</span>
        <span class="lg-links" id="lgLinks">
            {%- for l in pagina.links -%}
                {%- if not loop.first and not (l.icone != '' and pagina.links[loop.index0 - 1].icone != '') -%}<span>·</span>{%- endif -%}
                {%- set href = l.url matches '{^https?://}i' ? l.url : '#' -%}
                <a href="{{ href }}" target="_blank" rel="noopener" data-chave="{{ l.chave }}" class="{{ l.icone != '' ? 'lg-link--icone' : 'lg-link--texto' }}" title="{{ ehMaster ? 'entrada.login.link_do_master'|trans({rotulo: l.rotulo}) : l.rotulo }}"{% if l.icone != '' %} aria-label="{{ l.rotulo }}"{% endif %}>
                    {%- if l.icone != '' %}<i class="bi {{ l.icone }}" aria-hidden="true"></i>{% else %}{{ l.rotulo }}{% endif -%}
                </a>
            {%- endfor -%}
        </span>
        <span class="lg-mola"></span>

        {# ------------------------------------------------------------- suporte ---- #}
        <div class="lg-sup" id="lgSup" role="dialog" aria-label="{{ 'entrada.suporte.falar'|trans }}" hidden>
            <div class="lg-sup__topo">
                <span class="lg-sup__avatar" aria-hidden="true"><i class="bi bi-headset"></i></span>
                <span class="lg-sup__cab"><b>{{ 'entrada.suporte.titulo'|trans }}</b><span>{{ 'entrada.suporte.subtitulo'|trans }}</span></span>
                {% if ehMaster %}
                    <button type="button" class="lg-sup__icbtn" id="lgDlgTg" title="{{ 'entrada.suporte.quem_recebe'|trans }}" aria-expanded="false"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                {% endif %}
                <button type="button" class="lg-sup__icbtn" id="lgSupFechar" aria-label="{{ 'entrada.login.fechar'|trans }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            {% if ehMaster %}
                <div class="lg-dlg" id="lgDlg" hidden>
                    <div class="lg-dlg__titulo">{{ 'entrada.suporte.quem_recebe_titulo'|trans({papel: 'termos.master'|trans|upper}) }}</div>
                    <div class="lg-dlg__lista">
                        {% for d in pagina.destinatarios %}
                            <button type="button" class="lg-dlg__op{{ d.escolhido ? ' lg-on' : '' }}" data-user-id="{{ d.id }}" aria-pressed="{{ d.escolhido ? 'true' : 'false' }}"><i class="bi {{ d.escolhido ? 'bi-check-circle-fill' : 'bi-circle' }}" aria-hidden="true"></i><span class="lg-dlg__nome">{{ d.nome }}</span><span class="lg-dlg__cargo">{{ d.cargo }}</span></button>
                        {% endfor %}
                    </div>
                    <div class="lg-dlg__texto" id="lgDlgTxt">{{ pagina.textoDestinatario }}</div>
                </div>
            {% endif %}
            <div class="lg-sup__ok" id="lgSupOk" hidden>
                <span class="lg-sup__ok-icone" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                <b>{{ 'entrada.suporte.enviada'|trans }}</b>
                <div class="lg-sup__ok-texto">{{ 'entrada.suporte.enviada_texto'|trans }} <span id="lgSupOkEmail"></span>.</div>
            </div>
            <form class="lg-sup__form" id="lgSupForm" novalidate>
                <input class="lg-sup__entrada" id="lgSupNome" placeholder="{{ 'entrada.suporte.seu_nome'|trans }}" aria-label="{{ 'entrada.suporte.seu_nome'|trans }}" autocomplete="name">
                <input class="lg-sup__entrada" id="lgSupEmail" type="email" placeholder="{{ 'entrada.suporte.email_resposta'|trans }}" aria-label="{{ 'entrada.suporte.email_resposta'|trans }}" autocomplete="email">
                <div class="lg-pote" aria-hidden="true"><input name="site" id="lgSupSite" tabindex="-1" autocomplete="off"></div>
                <div class="lg-sup__chips">
                    {% for assunto, rotulo in assuntosDoSuporte %}
                        <button type="button" class="lg-chip" data-assunto="{{ assunto }}" aria-pressed="false">{{ rotulo }}</button>
                    {% endfor %}
                </div>
                <textarea class="lg-sup__msg" id="lgSupMsg" rows="3" placeholder="{{ 'entrada.suporte.como_ajudar'|trans }}" aria-label="{{ 'entrada.suporte.como_ajudar'|trans }}"></textarea>
                <div class="lg-sup__erro" id="lgSupErro" role="alert" hidden></div>
                <button type="submit" class="lg-sup__enviar" id="lgSupEnviar"><i class="bi bi-send" aria-hidden="true"></i>{{ 'entrada.suporte.enviar'|trans }}</button>
                <div class="lg-sup__aviso"><i class="bi bi-lock" aria-hidden="true"></i> {{ 'entrada.suporte.aviso'|trans }}</div>
            </form>
        </div>
        <button type="button" class="lg-sup-btn" id="lgSupBtn" aria-label="{{ 'entrada.suporte.falar'|trans }}" aria-expanded="false"><span class="lg-sup-btn__texto">{{ 'entrada.suporte.falar'|trans }}</span><span class="lg-sup-btn__icone" aria-hidden="true"><i class="bi bi-chat-dots-fill"></i></span></button>
    </footer>
</div>
{# Textos do entrada.js: a página não usa o base, por isso traz o próprio bj-traducao.js. #}
{{ catalogo_js('entrada.js', 'auth.js.forca') }}
<script src="{{ asset('js/bj-traducao.js') }}"></script>
<script src="{{ asset('js/auth/entrada.js') }}" defer></script>
{# Tema comemorativo (desenho 10 VS 24.10.26, bj-tema.js): cores, fita e ícones na tarja; no login não há selo. #}
{% include 'layout/_globais/tema_comemorativo.html.twig' with {bjtSemSelo: true} only %}
</body>
</html>
