{#
    Véu "Abrindo o seu escritório digital…" entre o login e o destino (desenho 10, `ok`).
    Página inteira, sem base.html.twig: só o véu em tela cheia, e em seguida o destino.

    - o título usa a hora do APARELHO (Bom dia antes das 12, Boa tarde antes das 18, senão Boa noite), com os textos
      de entrada.js.saudacao.* (catálogo do idioma);
    - o destino já chega validado pelo controller (DestinoPosLogin) e só é lido do data-attribute;
    - sem JS, o <meta refresh> leva em 3 s e o <noscript> oferece o link;
    - quem pediu menos movimento não recebe animação e segue na hora.
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <meta http-equiv="refresh" content="3;url={{ destino|e('html_attr') }}">
    <title>{{ 'entrada.entrando.titulo_pagina'|trans }}</title>
    <link rel="icon" href="/favicon.ico">
    <style>
        html, body { margin:0; height:100%; }
        body { font-family:Arial, Helvetica, sans-serif; color:#fff; background:#0b4f75; }
        @keyframes lgVeu { from { opacity:0; } to { opacity:1; } }
        @keyframes lgAnel { from { transform:rotate(0); } to { transform:rotate(360deg); } }
        @keyframes lgOk { 0% { transform:scale(.4); opacity:0; } 60% { transform:scale(1.12); opacity:1; } 100% { transform:scale(1); } }
        @keyframes lgBarra { from { width:0; } to { width:100%; } }
        @keyframes lgIn { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }
        .veu { position:fixed; inset:0; z-index:50; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; background:linear-gradient(160deg, #0a76a8, #0b4f75); color:#fff; animation:lgVeu .45s ease .25s both; }
        .veu__selo { position:relative; width:96px; height:96px; display:flex; align-items:center; justify-content:center; }
        .veu__anel { position:absolute; inset:0; border-radius:50%; border:3px solid rgba(255,255,255,.18); border-top-color:#fff; animation:lgAnel 1s linear infinite; }
        .veu__simbolo { width:52px; height:52px; animation:lgOk .7s cubic-bezier(.3,1.6,.5,1) .4s both; }
        .veu__textos { text-align:center; }
        .veu__titulo { margin:0; font-size:20px; font-weight:bold; animation:lgIn .5s ease .55s both; }
        .veu__sub { font-size:14px; opacity:.85; margin-top:5px; animation:lgIn .5s ease .7s both; }
        .veu__trilho { width:min(240px, 60vw); height:3px; border-radius:2px; background:rgba(255,255,255,.2); overflow:hidden; }
        .veu__barra { height:100%; background:#fff; animation:lgBarra 1.6s cubic-bezier(.4,0,.2,1) .4s both; }
        .veu__link { color:#fff; text-decoration:underline; font-size:14px; }
        @media (prefers-reduced-motion: reduce) {
            .veu, .veu__anel, .veu__simbolo, .veu__titulo, .veu__sub, .veu__barra { animation:none; }
            .veu__barra { width:100%; }
        }
    </style>
</head>
<body>
    <div id="veuEntrada" class="veu" role="status" aria-live="polite"
         data-destino="{{ destino|json_encode|e('html_attr') }}"
         data-nome="{{ nome|json_encode|e('html_attr') }}">
        <span class="veu__selo">
            <span class="veu__anel"></span>
            <img class="veu__simbolo" src="/images/logo/bluejus-simbolo-branco.png" alt="">
        </span>
        <div class="veu__textos">
            <h1 class="veu__titulo" id="veuTitulo">{{ nome != '' ? 'entrada.entrando.ola'|trans({nome: nome}) : 'entrada.entrando.ola_sem_nome'|trans }}</h1>
            <div class="veu__sub">{{ 'entrada.abrindo'|trans }}</div>
        </div>
        <div class="veu__trilho"><div class="veu__barra"></div></div>
        <noscript><a class="veu__link" href="{{ destino|e('html_attr') }}">{{ 'entrada.entrando.continuar'|trans }}</a></noscript>
    </div>
    {# A saudação do script vem do catálogo (a página não usa o base, por isso traz o bj-traducao.js). #}
    {{ catalogo_js('entrada.js.saudacao') }}
    <script src="{{ asset('js/bj-traducao.js') }}"></script>
    <script>
        (function () {
            var raiz = document.getElementById('veuEntrada');
            var destino = JSON.parse(raiz.getAttribute('data-destino'));
            var nome = JSON.parse(raiz.getAttribute('data-nome'));
            var hora = new Date().getHours();
            var t = window.BJ_T.t;
            var saudacao = hora < 12 ? t('entrada.js.saudacao.bom_dia') : (hora < 18 ? t('entrada.js.saudacao.boa_tarde') : t('entrada.js.saudacao.boa_noite'));
            document.getElementById('veuTitulo').textContent = nome ? t('entrada.js.saudacao.com_nome', {saudacao: saudacao, nome: nome}) : t('entrada.js.saudacao.sem_nome', {saudacao: saudacao});

            var semMovimento = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.setTimeout(function () { window.location.replace(destino); }, semMovimento ? 0 : 2100);
        })();
    </script>
</body>
</html>
