{% extends 'base.html.twig' %}

{% block title %}{{ 'djen.index.titulo_pagina'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0">{{ 'djen.index.titulo'|trans }}</h1>
        <div class="d-flex gap-2 flex-wrap justify-content-end">
            <a href="{{ path('push_processual_oabs') }}" class="btn btn-outline-secondary">
                <i class="bi bi-person-badge me-1"></i> {{ 'djen.oabs.titulo'|trans }}
            </a>
            {# Processos e Push Processual unificados: o cadastro mora aqui. Todo processo cadastrado
               sem baixa também é acompanhado pelo número na sincronização. #}
            {% if can_access_module('processos') %}
                <a href="{{ path('processo_index') }}" class="btn btn-outline-secondary" data-push-processos>
                    <i class="bi bi-briefcase me-1"></i> {{ 'djen.index.processos_monitorados'|trans }}
                    <span class="badge bg-secondary ms-1">{{ processosAcompanhados }}</span>
                </a>
                <a href="{{ path('processo_new') }}" class="btn btn-success" data-push-cadastrar-processo>
                    <i class="bi bi-plus-lg me-1"></i> {{ 'djen.index.cadastrar_processo'|trans }}
                </a>
            {% endif %}
            <form method="POST" action="{{ path('push_processual_sincronizar') }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('push_processual_sincronizar') }}">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat me-1"></i> {{ 'djen.index.sincronizar'|trans }}
                </button>
            </form>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary mb-3">
            <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#filtrosDjen">
                <h3 class="card-title"><i class="bi bi-funnel me-1"></i> {{ 'djen.index.filtros'|trans }}</h3>
            </div>
            <div class="collapse{% if filtros.busca or filtros.tribunal or filtros.meio or filtros.vinculo or filtros.data_de or filtros.data_ate %} show{% endif %}" id="filtrosDjen">
                <div class="card-body">
                    <form method="GET" action="{{ path('push_processual_index') }}">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="f_busca" class="form-label">{{ 'djen.index.busca'|trans }}</label>
                                <input type="text" id="f_busca" name="busca" value="{{ filtros.busca }}" class="form-control" placeholder="{{ 'djen.index.busca_placeholder'|trans }}">
                            </div>
                            <div class="col-md-2">
                                <label for="f_tribunal" class="form-label">{{ 'djen.comum.tribunal'|trans }}</label>
                                <select id="f_tribunal" name="tribunal" class="form-control">
                                    <option value="">{{ 'djen.index.todos'|trans }}</option>
                                    {% for sigla in tribunais %}
                                        <option value="{{ sigla }}" {% if filtros.tribunal == sigla %}selected{% endif %}>{{ sigla }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="f_meio" class="form-label">{{ 'djen.comum.meio'|trans }}</label>
                                <select id="f_meio" name="meio" class="form-control">
                                    <option value="">{{ 'djen.index.todos'|trans }}</option>
                                    <option value="D" {% if filtros.meio == 'D' %}selected{% endif %}>{{ 'djen.index.diario'|trans }}</option>
                                    <option value="E" {% if filtros.meio == 'E' %}selected{% endif %}>{{ 'djen.index.edital'|trans }}</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="f_vinculo" class="form-label">{{ 'djen.index.vinculo'|trans }}</label>
                                <select id="f_vinculo" name="vinculo" class="form-control">
                                    <option value="">{{ 'djen.index.todas'|trans }}</option>
                                    <option value="vinculada" {% if filtros.vinculo == 'vinculada' %}selected{% endif %}>{{ 'djen.index.vinculadas'|trans }}</option>
                                    <option value="avulsa" {% if filtros.vinculo == 'avulsa' %}selected{% endif %}>{{ 'djen.index.avulsas'|trans }}</option>
                                </select>
                            </div>
                            <div class="col-md-3 row g-1">
                                <div class="col-6">
                                    <label for="f_de" class="form-label">{{ 'djen.index.de'|trans }}</label>
                                    <input type="date" id="f_de" name="data_de" value="{{ filtros.data_de }}" class="form-control">
                                </div>
                                <div class="col-6">
                                    <label for="f_ate" class="form-label">{{ 'djen.index.ate'|trans }}</label>
                                    <input type="date" id="f_ate" name="data_ate" value="{{ filtros.data_ate }}" class="form-control">
                                </div>
                            </div>
                            <div class="col-12 d-flex gap-2">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i> {{ 'djen.index.filtrar'|trans }}</button>
                                <a href="{{ path('push_processual_index') }}" class="btn btn-outline-secondary">{{ 'djen.index.limpar'|trans }}</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'djen.index.data'|trans }}</th>
                            <th>{{ 'djen.comum.tribunal'|trans }}</th>
                            <th>{{ 'djen.comum.tipo'|trans }}</th>
                            <th>{{ 'djen.comum.processo'|trans }}</th>
                            <th>{{ 'djen.comum.orgao'|trans }}</th>
                            <th class="text-end">{{ 'djen.comum.acoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pub in publicacoes %}
                            <tr {% if not pub.lida %}class="fw-semibold"{% endif %}>
                                <td>{% if (pub.dataDisponibilizacao ?? null) is not null %}{{ pub.dataDisponibilizacao }}{% else %}<span class="text-muted small">{{ 'djen.comum.sem_registro'|trans }}</span>{% endif %}</td>
                                <td>{{ pub.siglaTribunal }}</td>
                                <td>{% if (pub.tipoComunicacao ?? null) is not null %}{{ pub.tipoComunicacao }}{% else %}<span class="text-muted small">{{ 'djen.comum.nao_informado'|trans }}</span>{% endif %}</td>
                                <td>
                                    {% if (pub.numeroProcessoExibicao ?? null) is not null %}{{ pub.numeroProcessoExibicao }}{% else %}<span class="text-muted small">{{ 'djen.comum.nao_informado'|trans }}</span>{% endif %}
                                    {% if pub.avulsa %}
                                        <span class="badge bg-secondary">{{ 'djen.comum.avulsa'|trans }}</span>
                                    {% else %}
                                        <span class="badge bg-success">{{ 'djen.index.vinculada'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{% if (pub.nomeOrgao ?? null) is not null %}{{ pub.nomeOrgao }}{% else %}<span class="text-muted small">{{ 'djen.comum.nao_informado'|trans }}</span>{% endif %}</td>
                                <td class="text-end">
                                    <a href="{{ path('push_processual_show', {id: pub.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> {{ 'djen.index.ver'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    {{ 'djen.index.vazio'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if totalPaginas > 1 %}
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small class="text-muted">{{ 'djen.index.paginacao'|trans({total: total ~ '', pagina: pagina ~ '', paginas: totalPaginas ~ ''}) }}</small>
                    <div class="btn-group">
                        {% if pagina > 1 %}
                            <a href="{{ path('push_processual_index', app.request.query.all|merge({'pagina': pagina - 1})) }}" class="btn btn-outline-secondary btn-sm">{{ 'djen.index.anterior'|trans }}</a>
                        {% endif %}
                        {% if pagina < totalPaginas %}
                            <a href="{{ path('push_processual_index', app.request.query.all|merge({'pagina': pagina + 1})) }}" class="btn btn-outline-secondary btn-sm">{{ 'djen.index.proxima'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
