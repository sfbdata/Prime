{% extends 'base.html.twig' %}

{% block title %}{{ 'djen.index.titulo_pagina'|trans }}{% endblock %}

{% block body %}
{% include 'djen/_abas.html.twig' with {ativa: 'publicacoes'} %}

{% set temFiltro = filtros.busca or filtros.tribunal or filtros.vinculo or filtros.leitura or filtros.data_de or filtros.data_ate %}
{% set hoje = 'now'|date('Y-m-d') %}
{% set classeNaoLidas = indicadores.naoLidas > 0 ? 'pp-kpi__valor pp-kpi__valor--alerta' : 'pp-kpi__valor' %}
<div class="pp-pagina" data-pp-publicacoes
     data-t-confirma-excluir-lote="{{ 'djen.index.confirma_excluir_lote'|trans({n: '%n%'})|e('html_attr') }}"
     data-t-prompt-excluir-lote="{{ 'djen.index.prompt_excluir_lote'|trans({n: '%n%'})|e('html_attr') }}"
     data-t-confirma-excluir-uma="{{ 'djen.index.confirma_excluir_uma'|trans({data: '%data%', processo: '%processo%'})|e('html_attr') }}"
     data-t-prompt-excluir-uma="{{ 'djen.index.prompt_excluir_uma'|trans|e('html_attr') }}"
     data-t-confirma-limpar="{{ 'djen.index.confirma_limpar'|trans({n: '%n%'})|e('html_attr') }}"
     data-t-prompt-limpar="{{ 'djen.index.prompt_limpar'|trans({n: '%n%'})|e('html_attr') }}"
     data-t-cancelada="{{ 'djen.index.exclusao_cancelada'|trans|e('html_attr') }}"
     data-t-limpeza-cancelada="{{ 'djen.index.limpeza_cancelada'|trans|e('html_attr') }}"
     data-t-sem-lidas="{{ 'djen.index.sem_lidas'|trans|e('html_attr') }}"
     data-t-copiado="{{ 'djen.index.numero_copiado'|trans|e('html_attr') }}"
     data-t-n-selecionadas="{{ 'djen.index.n_selecionadas'|trans({n: '%n%'})|e('html_attr') }}"
     data-t-menu-abrir="{{ 'djen.index.menu_abrir'|trans|e('html_attr') }}"
     data-t-menu-lida="{{ 'djen.index.menu_marcar_lida'|trans|e('html_attr') }}"
     data-t-menu-nao-lida="{{ 'djen.index.menu_marcar_nao_lida'|trans|e('html_attr') }}"
     data-t-menu-copiar="{{ 'djen.index.menu_copiar'|trans|e('html_attr') }}"
     data-t-menu-excluir="{{ 'djen.index.menu_excluir'|trans|e('html_attr') }}"
     data-t-menu-abrir-pasta="{{ 'djen.index.menu_abrir_pasta'|trans({n: '%n%'})|e('html_attr') }}"
     data-t-menu-trocar="{{ 'djen.index.menu_trocar_pasta'|trans|e('html_attr') }}"
     data-t-menu-desvincular="{{ 'djen.index.desvincular_pasta'|trans|e('html_attr') }}"
     data-t-menu-vincular="{{ 'djen.index.vincular_pasta'|trans|e('html_attr') }}"
     data-t-confirma-desvincular="{{ 'djen.index.confirma_desvincular'|trans({processo: '%processo%', n: '%n%'})|e('html_attr') }}"
     data-total-lidas="{{ lidas_na_caixa }}">
    <div class="pp-topo">
        <i class="bi bi-broadcast"></i>
        <h1>{{ 'djen.index.titulo'|trans }}</h1>
        <a href="{{ path('push_processual_oabs') }}" class="pp-btn" data-pp-oabs>
            <i class="bi bi-person-badge"></i>{{ 'djen.abas.oabs'|trans }}<span class="pp-btn__n">{{ abas.oabs }}</span>
        </a>
        {# Processos e Push Processual unificados: o cadastro mora aqui. Todo processo cadastrado
           sem baixa também é acompanhado pelo número na sincronização. #}
        {% if can_access_module('processos') %}
            <button type="button" class="pp-btn pp-btn--verde" data-push-cadastrar-processo>
                <i class="bi bi-plus-lg"></i>{{ 'djen.index.cadastrar_processo'|trans }}
            </button>
        {% endif %}
        <form method="POST" action="{{ path('push_processual_sincronizar') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('push_processual_sincronizar') }}">
            <button type="submit" class="pp-btn pp-btn--azul">
                <i class="bi bi-arrow-repeat"></i>{{ 'djen.index.sincronizar'|trans }}
            </button>
        </form>
    </div>

    <div class="pp-kpis" data-pp-kpis>
        <a class="pp-kpi" href="{{ path('push_processual_index', {leitura: 'nao_lidas'}) }}" data-pp-kpi="nao_lidas">
            <span class="pp-kpi__corpo"><span class="pp-kpi__rotulo">{{ 'djen.kpi.nao_lidas'|trans }}</span><b class="{{ classeNaoLidas }}">{{ indicadores.naoLidas }}</b></span>
            <i class="bi bi-envelope"></i>
        </a>
        <a class="pp-kpi" href="{{ path('push_processual_index', {data_de: hoje, data_ate: hoje}) }}" data-pp-kpi="hoje">
            <span class="pp-kpi__corpo"><span class="pp-kpi__rotulo">{{ 'djen.kpi.hoje'|trans }}</span><b class="pp-kpi__valor">{{ indicadores.hoje }}</b></span>
            <i class="bi bi-calendar-event"></i>
        </a>
        <a class="pp-kpi" href="{{ path('push_processual_index', {vinculo: 'vinculada'}) }}" data-pp-kpi="vinculadas">
            <span class="pp-kpi__corpo"><span class="pp-kpi__rotulo">{{ 'djen.kpi.vinculadas'|trans }}</span><b class="pp-kpi__valor pp-kpi__valor--verde">{{ indicadores.vinculadas }}</b></span>
            <i class="bi bi-link-45deg"></i>
        </a>
        <a class="pp-kpi" href="{{ path('push_processual_index', {vinculo: 'avulsa'}) }}" data-pp-kpi="avulsas">
            <span class="pp-kpi__corpo"><span class="pp-kpi__rotulo">{{ 'djen.kpi.avulsas'|trans }}</span><b class="pp-kpi__valor pp-kpi__valor--ambar">{{ indicadores.avulsas }}</b></span>
            <i class="bi bi-exclamation-diamond"></i>
        </a>
    </div>

    <section class="pp-caixa pp-caixa--filtros">
        <form method="GET" action="{{ path('push_processual_index') }}" class="pp-filtros" data-pp-filtros>
            <label class="pp-busca"><i class="bi bi-search"></i><input type="search" name="busca" value="{{ filtros.busca }}" placeholder="{{ 'djen.index.busca_placeholder'|trans }}"></label>
            <select name="tribunal" class="pp-campo" onchange="this.form.submit()">
                <option value="">{{ 'djen.index.tribunal_todos'|trans }}</option>
                {% for sigla in tribunais %}
                    <option value="{{ sigla }}" {% if filtros.tribunal == sigla %}selected{% endif %}>{{ sigla }}</option>
                {% endfor %}
            </select>
            <select name="vinculo" class="pp-campo" onchange="this.form.submit()">
                <option value="">{{ 'djen.index.vinculo_todos'|trans }}</option>
                <option value="vinculada" {% if filtros.vinculo == 'vinculada' %}selected{% endif %}>{{ 'djen.index.vinculadas_pasta'|trans }}</option>
                <option value="avulsa" {% if filtros.vinculo == 'avulsa' %}selected{% endif %}>{{ 'djen.index.avulsas'|trans }}</option>
            </select>
            <select name="leitura" class="pp-campo" onchange="this.form.submit()">
                <option value="">{{ 'djen.index.leitura_todas'|trans }}</option>
                <option value="nao_lidas" {% if filtros.leitura == 'nao_lidas' %}selected{% endif %}>{{ 'djen.index.nao_lidas'|trans }}</option>
                <option value="lidas" {% if filtros.leitura == 'lidas' %}selected{% endif %}>{{ 'djen.index.lidas'|trans }}</option>
            </select>
            <input type="date" name="data_de" value="{{ filtros.data_de }}" class="pp-campo" title="{{ 'djen.index.de'|trans }}" onchange="this.form.submit()">
            <span class="pp-ate">{{ 'djen.index.a'|trans }}</span>
            <input type="date" name="data_ate" value="{{ filtros.data_ate }}" class="pp-campo" title="{{ 'djen.index.ate'|trans }}" onchange="this.form.submit()">
            {% if temFiltro %}
                <a href="{{ path('push_processual_index') }}" class="pp-limpar" data-pp-limpar>{{ 'djen.index.limpar_filtros'|trans }}</a>
            {% endif %}
        </form>
    </section>

    <section class="pp-caixa pp-tabela" data-pp-tabela>
        <form method="POST" action="{{ path('push_processual_lote_leitura') }}" class="pp-lote" data-pp-lote hidden>
            <input type="hidden" name="_token" value="{{ csrf_token('push_publicacoes') }}">
            <input type="hidden" name="voltar" value="{{ app.request.requestUri }}">
            <input type="hidden" name="lida" value="1">
        </form>
        <div class="pp-barra">
            <button type="button" class="pp-barra__btn" data-pp-selecionar-todas title="{{ 'djen.index.selecionar_todas'|trans }}"><i class="bi bi-square"></i>{{ 'djen.index.selecionar'|trans }}</button>
            <span class="pp-barra__sel" data-pp-sel-grupo hidden>
                <span class="pp-barra__n" data-pp-sel-n></span>
                <button type="button" class="pp-barra__btn" data-pp-acao-lote="leitura"><i class="bi bi-envelope-open"></i> {{ 'djen.index.marcar_lidas'|trans }}</button>
                <button type="button" class="pp-barra__btn pp-barra__btn--perigo" data-pp-acao-lote="excluir"><i class="bi bi-trash3"></i> {{ 'djen.index.excluir'|trans }}</button>
            </span>
            <span class="pp-barra__espaco"></span>
            <button type="button" class="pp-barra__limpar" data-pp-acao-lote="limpar"><i class="bi bi-trash3"></i> {{ 'djen.index.limpar_lidas'|trans }}</button>
        </div>
        <div class="pp-tabela__corpo">
            <div class="pp-linha pp-linha--cab">
                <span>{{ 'djen.index.data_maiusculo'|trans }}</span>
                <span>{{ 'djen.comum.tribunal_maiusculo'|trans }}</span>
                <span>{{ 'djen.comum.tipo_maiusculo'|trans }}</span>
                <span>{{ 'djen.comum.processo_maiusculo'|trans }}</span>
                <span>{{ 'djen.comum.orgao_maiusculo'|trans }}</span>
                <span>{{ 'djen.comum.acoes_maiusculo'|trans }}</span>
            </div>
            {% for pub in publicacoes %}
                <div class="pp-linha pp-linha--dado{{ pub.lida ? '' : ' pp-linha--nova' }}" data-pp-linha data-id="{{ pub.id }}" data-lida="{{ pub.lida ? '1' : '0' }}" data-numero="{{ pub.numeroProcessoExibicao ?? '' }}" data-data="{{ pub.dataDisponibilizacao ?? '' }}" data-url="{{ path('push_processual_show', {id: pub.id}) }}" data-pasta-id="{{ pub.pastaId ?? '' }}" data-pasta-nup="{{ pub.pastaNup ?? '' }}"{% if pub.pastaId %} data-pasta-url="{{ path('pasta_show', {id: pub.pastaId}) }}"{% endif %} title="{{ 'djen.index.dica_botao_direito'|trans }}">
                    <span class="pp-c-data"><button type="button" class="pp-marca" data-pp-marca aria-pressed="false" aria-label="{{ 'djen.index.selecionar_publicacao'|trans }}"><i class="bi bi-square"></i></button>{% if (pub.dataDisponibilizacao ?? null) is not null %}{{ pub.dataDisponibilizacao }}{% else %}{{ 'djen.comum.sem_registro'|trans }}{% endif %}</span>
                    <span>{{ pub.siglaTribunal }}</span>
                    <span>{% if (pub.tipoComunicacao ?? null) is not null %}{{ pub.tipoComunicacao }}{% else %}{{ 'djen.comum.nao_informado'|trans }}{% endif %}</span>
                    <span class="pp-c-proc">
                        <span class="pp-c-proc__linha">
                            <span class="pp-c-proc__num">{% if (pub.numeroProcessoExibicao ?? null) is not null %}{{ pub.numeroProcessoExibicao }}{% else %}{{ 'djen.comum.nao_informado'|trans }}{% endif %}</span>
                            {% if pub.avulsa %}
                                <span class="pp-selo pp-selo--avulsa" title="{{ 'djen.index.avulsa_dica'|trans }}">{{ 'djen.comum.avulsa'|trans }}</span>
                            {% else %}
                                <span class="pp-selo pp-selo--vinc" title="{{ pub.pastaNup ? 'djen.index.pasta_n'|trans({n: pub.pastaNup}) : 'djen.index.vinculada_dica'|trans }}">{{ 'djen.index.vinculada'|trans }}</span>
                            {% endif %}
                            {% set prazo = prazos[pub.id] ?? null %}
                            {% if prazo %}
                                <span class="pp-selo pp-selo--prazo{{ prazo.cumprido ? ' pp-selo--cumprido' : '' }}" style="{{ prazo.cumprido ? '' : 'background:' ~ prazo.corDoSelo ~ ';' }}{{ not prazo.cumprido and prazo.textoDoSeloClaro ? 'color:#34505f;' : '' }}" title="{{ prazo.inicio ? 'djen.detalhe.selo_dica'|trans({dias: prazo.dias ~ '', inicio: prazo.inicio|date('d/m/Y'), fim: prazo.vencimento|date('d/m/Y')}) : 'djen.detalhe.selo_dica_teor'|trans({fim: prazo.vencimento|date('d/m/Y')}) }}">{% if prazo.cumprido %}<i class="bi bi-check-lg"></i>{% endif %}{{ prazo.vencido ? 'djen.detalhe.selo_vencido'|trans : (prazo.restante == 0 ? 'djen.detalhe.selo_hoje'|trans : 'djen.detalhe.selo_dias'|trans({n: prazo.restante ~ ''})) }}</span>
                            {% endif %}
                            {% if pub.tarefaId %}<span class="pp-meta-criada"><i class="bi bi-bullseye"></i> {{ 'djen.detalhe.meta_criada_selo'|trans }}</span>{% endif %}
                        </span>
                    </span>
                    <span class="pp-c-orgao" title="{{ pub.nomeOrgao ?? '' }}">{% if (pub.nomeOrgao ?? null) is not null %}{{ pub.nomeOrgao }}{% else %}{{ 'djen.comum.nao_informado'|trans }}{% endif %}</span>
                    <span class="pp-c-acoes">
                        {% if pub.avulsa %}
                            <button type="button" class="pp-icone pp-icone--vincular" data-pp-vincular title="{{ 'djen.index.vincular_pasta'|trans }}"><i class="bi bi-link-45deg"></i></button>
                        {% else %}
                            <button type="button" class="pp-icone pp-icone--desvincular" data-pp-desvincular title="{{ 'djen.index.desvincular_pasta'|trans }}"><i class="bi bi-scissors"></i></button>
                        {% endif %}
                        <a href="{{ path('push_processual_show', {id: pub.id}) }}" class="pp-ver"><i class="bi bi-eye"></i>{{ 'djen.index.ver'|trans }}</a>
                    </span>
                </div>
            {% else %}
                <div class="pp-vazio">{{ 'djen.index.vazio_filtros'|trans }}</div>
            {% endfor %}
        </div>
        {% if totalPaginas > 1 %}
            <div class="pp-rodape">
                <span>{{ 'djen.index.paginacao'|trans({total: total ~ '', pagina: pagina ~ '', paginas: totalPaginas ~ ''}) }}</span>
                <span class="pp-rodape__nav">
                    {% if pagina > 1 %}<a href="{{ path('push_processual_index', app.request.query.all|merge({'pagina': pagina - 1})) }}">{{ 'djen.index.anterior'|trans }}</a>{% endif %}
                    {% if pagina < totalPaginas %}<a href="{{ path('push_processual_index', app.request.query.all|merge({'pagina': pagina + 1})) }}">{{ 'djen.index.proxima'|trans }}</a>{% endif %}
                </span>
            </div>
        {% endif %}
    </section>
</div>

<form method="POST" class="pp-vinculo-form" data-pp-vinculo-form hidden>
    <input type="hidden" name="_token" value="{{ csrf_token('push_publicacoes') }}">
    <input type="hidden" name="voltar" value="{{ app.request.requestUri }}">
    <input type="hidden" name="numero" value="">
    <input type="hidden" name="pasta_id" value="">
    <input type="hidden" name="nup" value="">
    <input type="hidden" name="trocar_da_pasta_id" value="">
</form>
<div class="pp-detalhe" data-pp-detalhe data-url="/push-processual/publicacoes/%id%/detalhe" data-abrir="{{ abrir ?? 0 }}" data-t-pergunta-outro="{{ 'djen.detalhe.outro_pergunta'|trans|e('html_attr') }}" hidden>
    <div class="pp-modal__fundo" data-pp-det-fechar></div>
    <div class="pp-modal__centro"><div class="pp-det__caixa" role="dialog" aria-modal="true" data-pp-det-conteudo></div></div>
</div>
{% include 'djen/_modal_pasta.html.twig' with {url_vincular: '/push-processual/publicacoes/%id%/vincular', url_desvincular: '/push-processual/publicacoes/%id%/desvincular', url_partes: '/push-processual/publicacoes/%id%/partes'} only %}
{% if can_access_module('processos') %}
{% include 'djen/_modal_vincular_processo.html.twig' only %}
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/push-publicacoes.js') }}"></script>
<script src="{{ asset('js/push-vincular-processo.js') }}"></script>
{% endblock %}
