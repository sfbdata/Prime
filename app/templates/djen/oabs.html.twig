{% extends 'base.html.twig' %}

{% block title %}Push Processual — OABs monitoradas{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0">OABs monitoradas</h1>
        <a href="{{ path('push_processual_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Voltar às publicações
        </a>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-success mb-3">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-plus-circle me-1"></i> Adicionar OAB</h3></div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            {{ form_label(form.numero) }}
                            {{ form_widget(form.numero) }}
                            {{ form_errors(form.numero) }}
                        </div>
                        <div class="col-md-2">
                            {{ form_label(form.uf) }}
                            {{ form_widget(form.uf) }}
                            {{ form_errors(form.uf) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.apelido) }}
                            {{ form_widget(form.apelido) }}
                            {{ form_errors(form.apelido) }}
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-lg me-1"></i> Adicionar</button>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>OAB</th>
                            <th>Apelido</th>
                            <th>Status</th>
                            <th>Desde</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for oab in oabs %}
                            <tr>
                                <td>{{ oab.numero }}/{{ oab.uf }}</td>
                                <td>{{ oab.apelido ?? '—' }}</td>
                                <td>
                                    {% if oab.ativo %}
                                        <span class="badge bg-success">Ativa</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Pausada</span>
                                    {% endif %}
                                </td>
                                <td>{{ oab.criadoEm ?? '—' }}</td>
                                <td class="text-end">
                                    <form method="POST" action="{{ path('push_processual_oab_alternar', {id: oab.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('push_processual_oab_' ~ oab.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            {{ oab.ativo ? 'Pausar' : 'Reativar' }}
                                        </button>
                                    </form>
                                    <form method="POST" action="{{ path('push_processual_oab_remover', {id: oab.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Remover esta OAB do monitoramento?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('push_processual_oab_' ~ oab.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Nenhuma OAB monitorada ainda. Adicione uma acima para captar as publicações.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
{% endblock %}
