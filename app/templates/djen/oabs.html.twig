{% extends 'base.html.twig' %}

{% block title %}{{ 'djen.oabs.titulo_pagina'|trans }}{% endblock %}

{% block body %}
{% include 'djen/_abas.html.twig' with {ativa: 'oabs'} %}

<div class="pp-pagina" data-pp-oabs>
    <div class="pp-topo">
        <i class="bi bi-person-badge"></i>
        <h1>{{ 'djen.oabs.titulo'|trans }}</h1>
        <a href="{{ path('push_processual_index') }}" class="pp-btn">
            <i class="bi bi-arrow-left"></i>{{ 'djen.oabs.voltar'|trans }}
        </a>
    </div>

    <section class="pp-caixa pp-caixa--verde" data-pp-oab-adicionar>
        <div class="pp-caixa__titulo">
            <i class="bi bi-plus-circle"></i><b>{{ 'djen.oabs.adicionar_oab'|trans }}</b>
            <span>{{ 'djen.oabs.adicionar_dica'|trans }}</span>
        </div>
        {{ form_start(form, {attr: {class: 'pp-oab-form'}}) }}
            <label class="pp-rotulo" for="{{ form.numero.vars.id }}">{{ 'djen.oabs.numero_da_oab'|trans }}{{ form_widget(form.numero) }}</label>
            <label class="pp-rotulo" for="{{ form.uf.vars.id }}">{{ 'djen.oabs.uf'|trans }}{{ form_widget(form.uf) }}</label>
            <label class="pp-rotulo" for="{{ form.apelido.vars.id }}">{{ 'djen.oabs.apelido_maiusculo'|trans }} <span class="pp-rotulo__opc">{{ 'djen.oabs.opcional'|trans }}</span>{{ form_widget(form.apelido) }}</label>
            <button type="submit" class="pp-btn pp-btn--verde pp-oab-form__enviar"><i class="bi bi-plus-lg"></i>{{ 'djen.oabs.adicionar'|trans }}</button>
        {{ form_end(form) }}
        {% set erros = [form.numero.vars.errors, form.uf.vars.errors, form.apelido.vars.errors] %}
        {% for lista in erros %}{% for erro in lista %}<div class="pp-erro">{{ erro.message }}</div>{% endfor %}{% endfor %}
    </section>

    <section class="pp-caixa pp-tabela" data-pp-oab-tabela>
        <div class="pp-tabela__corpo pp-tabela__corpo--oab">
            <div class="pp-linha pp-linha--oab pp-linha--cab">
                <span>{{ 'djen.oabs.oab_maiusculo'|trans }}</span>
                <span>{{ 'djen.oabs.apelido_maiusculo'|trans }}</span>
                <span>{{ 'djen.oabs.status_maiusculo'|trans }}</span>
                <span>{{ 'djen.oabs.publicacoes_maiusculo'|trans }}</span>
                <span>{{ 'djen.oabs.desde_maiusculo'|trans }}</span>
                <span>{{ 'djen.comum.acoes_maiusculo'|trans }}</span>
            </div>
            {% for oab in oabs %}
                <div class="pp-linha pp-linha--oab pp-linha--dado">
                    <b>{{ oab.numero }}/{{ oab.uf }}</b>
                    <span>{% if oab.apelido is not null and oab.apelido != '' %}{{ oab.apelido }}{% else %}<span class="pp-mudo">{{ 'djen.oabs.sem_apelido'|trans }}</span>{% endif %}</span>
                    <span><span class="pp-selo pp-selo--status {{ oab.ativo ? 'pp-selo--vinc' : 'pp-selo--pausada' }}">{{ (oab.ativo ? 'djen.oabs.ativa' : 'djen.oabs.pausada')|trans }}</span></span>
                    <span>{{ oab.publicacoes }}</span>
                    <span>{{ oab.criadoEm }}</span>
                    <span class="pp-c-acoes">
                        <button type="button" class="pp-acao pp-acao--icone" title="{{ 'djen.oabs.editar_apelido'|trans }}" data-pp-oab-editar
                                data-url="{{ path('push_processual_oab_apelido', {id: oab.id}) }}"
                                data-token="{{ csrf_token('push_processual_oab_' ~ oab.id) }}"
                                data-oab="{{ oab.numero }}/{{ oab.uf }}"
                                data-apelido="{{ oab.apelido ?? '' }}"><i class="bi bi-pencil"></i></button>
                        <form method="POST" action="{{ path('push_processual_oab_alternar', {id: oab.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('push_processual_oab_' ~ oab.id) }}">
                            <button type="submit" class="pp-acao">{{ (oab.ativo ? 'djen.oabs.pausar' : 'djen.oabs.retomar')|trans }}</button>
                        </form>
                        <form method="POST" action="{{ path('push_processual_oab_remover', {id: oab.id}) }}"
                              onsubmit="return confirm('{{ 'djen.oabs.remover_confirmar'|trans({oab: oab.numero ~ '/' ~ oab.uf})|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('push_processual_oab_' ~ oab.id) }}">
                            <button type="submit" class="pp-acao pp-acao--perigo" title="{{ 'djen.oabs.remover'|trans }}"><i class="bi bi-trash3"></i></button>
                        </form>
                    </span>
                </div>
            {% else %}
                <div class="pp-vazio">{{ 'djen.oabs.vazio'|trans }}</div>
            {% endfor %}
        </div>
    </section>
</div>

<div class="pp-modal" data-pp-oab-modal hidden>
    <div class="pp-modal__fundo" data-pp-oab-fechar></div>
    <div class="pp-modal__centro">
        <form method="POST" class="pp-modal__caixa" role="dialog" aria-modal="true" aria-label="{{ 'djen.oabs.editar_apelido'|trans }}" data-pp-oab-form>
            <div class="pp-modal__topo"><i class="bi bi-pencil"></i><b>{{ 'djen.oabs.editar_apelido'|trans }}</b><button type="button" class="pp-modal__x" data-pp-oab-fechar aria-label="{{ 'djen.index.fechar'|trans }}"><i class="bi bi-x-lg"></i></button></div>
            <div class="pp-modal__corpo">
                <input type="hidden" name="_token" value="" data-pp-oab-token>
                <div class="pp-modal__proc"><b data-pp-oab-rotulo></b><span>{{ 'djen.oabs.editar_dica'|trans }}</span></div>
                <label class="pp-rotulo" for="pp-oab-apelido">{{ 'djen.oabs.apelido_maiusculo'|trans }} <span class="pp-rotulo__opc">{{ 'djen.oabs.opcional'|trans }}</span>
                    <input type="text" id="pp-oab-apelido" name="apelido" maxlength="255" autocomplete="off" placeholder="{{ 'djen.oabs.apelido_ph'|trans }}" data-pp-oab-apelido>
                </label>
                <div class="pp-modal__rodape">
                    <span class="pp-modal__espaco"></span>
                    <button type="button" class="pp-btn" data-pp-oab-fechar>{{ 'djen.oabs.cancelar'|trans }}</button>
                    <button type="submit" class="pp-btn pp-btn--verde"><i class="bi bi-check-lg"></i>{{ 'djen.oabs.salvar'|trans }}</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="{{ asset('js/push-oabs.js') }}"></script>
{% endblock %}
