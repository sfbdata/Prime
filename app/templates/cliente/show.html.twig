{% extends 'base.html.twig' %}

{% block title %}{{ 'cliente.show.titulo_pagina'|trans({nome: cliente.cpf is defined ? cliente.nomeCompleto : cliente.razaoSocial}) }}{% endblock %}

{% block body %}
{# Content Header #}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-person me-2"></i>{{ cliente.cpf is defined ? cliente.nomeCompleto : cliente.razaoSocial }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">{{ 'cliente.show.migalha.inicio'|trans }}</a></li>
                    <li class="breadcrumb-item">{{ 'cliente.show.migalha.clientes'|trans }}</li>
                    <li class="breadcrumb-item active">{{ 'cliente.show.migalha.detalhes'|trans }}</li>
                </ol>
            </div>
        </div>
    </div>
</div>

{# Main Content #}
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">{{ cliente.cpf is defined ? 'cliente.show.pessoa_fisica'|trans : 'cliente.show.pessoa_juridica'|trans }}</h3>
                <div class="card-tools">
                    <span class="badge text-bg-primary">
                        {{ cliente.cpf is defined ? cliente.cpf : cliente.cnpj }}
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    {# Left Column - Tabs #}
                    <div class="col-12 col-md-12 col-lg-8 order-2 order-md-1">
                        {# Info Boxes #}
                        <div class="row">
                            <div class="col-12 col-sm-4">
                                <div class="info-box bg-body-tertiary">
                                    <div class="info-box-content">
                                        <span class="info-box-text text-center text-muted">{{ 'cliente.show.tipo'|trans }}</span>
                                        <span class="info-box-number text-center text-muted mb-0">{{ cliente.cpf is defined ? 'cliente.show.sigla_pf'|trans : 'cliente.show.sigla_pj'|trans }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Tabs #}
                        <ul class="nav nav-tabs" id="clienteTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true">
                                    <i class="bi bi-person-vcard me-1"></i> {{ 'cliente.show.aba.dados'|trans }}
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="false">
                                    <i class="bi bi-info-circle me-1"></i> {{ 'cliente.show.aba.detalhes'|trans }}
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content mt-3" id="clienteTabsContent">
                            {# Tab: Dados do Cliente #}
                            <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
                                {% if cliente.cpf is defined %}
                                    {# Pessoa Física #}
                                    <h5 class="mb-3"><i class="bi bi-person-badge me-1"></i> {{ 'cliente.show.secao.dados_pessoais'|trans }}</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.nome_completo'|trans }}
                                                    <b class="d-block">{{ cliente.nomeCompleto }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.nomeCompleto }}" title="{{ 'cliente.comum.copiar'|trans }}"></i></b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.cpf'|trans }}
                                                    <b class="d-block">{{ cliente.cpf }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cpf }}" title="{{ 'cliente.comum.copiar'|trans }}"></i></b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.data_nascimento'|trans }}
                                                    <b class="d-block">{% if cliente.dataNascimento %}{{ cliente.dataNascimento|data }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.dataNascimento|data }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% else %}-{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.estado_civil'|trans }}
                                                    <b class="d-block">{{ cliente.estadoCivil ?: '-' }}{% if cliente.estadoCivil %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.estadoCivil }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.profissao'|trans }}
                                                    <b class="d-block">{{ cliente.profissao ?: '-' }}{% if cliente.profissao %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.profissao }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <h5 class="mb-3"><i class="bi bi-card-text me-1"></i> {{ 'cliente.show.secao.documento_rg'|trans }}</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-4">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.rg'|trans }}
                                                    <b class="d-block">{{ cliente.rg ?: '-' }}{% if cliente.rg %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.rg }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.orgao_expedidor'|trans }}
                                                    <b class="d-block">{{ cliente.rgOrgaoExpedidor ?: '-' }}{% if cliente.rgOrgaoExpedidor %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.rgOrgaoExpedidor }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.data_emissao'|trans }}
                                                    <b class="d-block">{% if cliente.rgDataEmissao %}{{ cliente.rgDataEmissao|data }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.rgDataEmissao|data }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% else %}-{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    {# Pessoa Jurídica #}
                                    <h5 class="mb-3"><i class="bi bi-building me-1"></i> {{ 'cliente.show.secao.dados_empresa'|trans }}</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.razao_social'|trans }}
                                                    <b class="d-block">{{ cliente.razaoSocial }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.razaoSocial }}" title="{{ 'cliente.comum.copiar'|trans }}"></i></b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.nome_fantasia'|trans }}
                                                    <b class="d-block">{{ cliente.nomeFantasia ?: '-' }}{% if cliente.nomeFantasia %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.nomeFantasia }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.cnpj'|trans }}
                                                    <b class="d-block">{{ cliente.cnpj }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cnpj }}" title="{{ 'cliente.comum.copiar'|trans }}"></i></b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.inscricao_estadual'|trans }}
                                                    <b class="d-block">{{ cliente.inscricaoEstadual ?: '-' }}{% if cliente.inscricaoEstadual %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.inscricaoEstadual }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.inscricao_municipal'|trans }}
                                                    <b class="d-block">{{ cliente.inscricaoMunicipal ?: '-' }}{% if cliente.inscricaoMunicipal %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.inscricaoMunicipal }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <h5 class="mb-3"><i class="bi bi-person-workspace me-1"></i> {{ 'cliente.show.secao.representante_legal'|trans }}</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.nome'|trans }}
                                                    <b class="d-block">{{ cliente.representanteLegal ?: '-' }}{% if cliente.representanteLegal %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteLegal }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.cpf'|trans }}
                                                    <b class="d-block">{{ cliente.representanteCpf ?: '-' }}{% if cliente.representanteCpf %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteCpf }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.rg'|trans }}
                                                    <b class="d-block">{{ cliente.representanteRg ?: '-' }}{% if cliente.representanteRg %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteRg }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">{{ 'cliente.show.campo.cargo'|trans }}
                                                    <b class="d-block">{{ cliente.representanteCargo ?: '-' }}{% if cliente.representanteCargo %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteCargo }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                <h5 class="mb-3"><i class="bi bi-telephone me-1"></i> {{ 'cliente.show.secao.contato'|trans }}</h5>
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2">{{ 'cliente.show.campo.email'|trans }}
                                                <b class="d-block">{{ cliente.email }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.email }}" title="{{ 'cliente.comum.copiar'|trans }}"></i></b>
                                            </p>
                                            <p class="text-sm mb-2">{{ 'cliente.show.campo.celular'|trans }}
                                                <b class="d-block">{{ cliente.telefoneCelular ?: '-' }}{% if cliente.telefoneCelular %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.telefoneCelular }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2">{{ 'cliente.show.campo.telefone_fixo'|trans }}
                                                <b class="d-block">{{ cliente.telefoneFixo ?: '-' }}{% if cliente.telefoneFixo %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.telefoneFixo }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <h5 class="mb-3"><i class="bi bi-geo-alt me-1"></i> {{ 'cliente.show.secao.endereco'|trans }}</h5>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2">{{ 'cliente.show.campo.cep'|trans }}
                                                <b class="d-block">{{ cliente.cep ?: '-' }}{% if cliente.cep %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cep }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                            </p>
                                            <p class="text-sm mb-2">{{ 'cliente.show.campo.endereco'|trans }}
                                                <b class="d-block">{{ cliente.endereco ?: '-' }}{% if cliente.endereco %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.endereco }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                            </p>
                                            {% if cliente.complemento %}
                                            <p class="text-sm mb-2">{{ 'cliente.show.campo.complemento'|trans }}
                                                <b class="d-block">{{ cliente.complemento }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.complemento }}" title="{{ 'cliente.comum.copiar'|trans }}"></i></b>
                                            </p>
                                            {% endif %}
                                            <p class="text-sm mb-0">{{ 'cliente.show.campo.cidade_estado'|trans }}
                                                <b class="d-block">{{ cliente.cidade ?: '-' }} - {{ cliente.estado ?: '-' }}{% if cliente.cidade %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cidade }} - {{ cliente.estado }}" title="{{ 'cliente.comum.copiar'|trans }}"></i>{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Tab: Informações #}
                            <div class="tab-pane fade" id="info" role="tabpanel" aria-labelledby="info-tab">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-plus me-2"></i> {{ 'cliente.show.campo.criado_em'|trans }}
                                                <b class="d-block">{% if cliente.criadoAt %}{{ cliente.criadoAt|data_hora }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-check me-2"></i> {{ 'cliente.show.campo.modificado_em'|trans }}
                                                <b class="d-block">{% if cliente.modificadoEm %}{{ cliente.modificadoEm|data_hora }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-check me-2"></i> {{ 'cliente.show.campo.criado_por'|trans }}
                                                <b class="d-block">{% if cliente.criadoPor %}{{ cliente.criadoPor.fullName }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Right Column - Sidebar #}
                    <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2">
                        <div class="card card-primary card-outline">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-link-45deg me-1"></i> {{ 'cliente.show.vinculos.titulo'|trans }}</h3>
                            </div>
                            <div class="card-body">
                                {# Processos #}
                                <h6 class="text-muted mb-3"><i class="bi bi-briefcase me-1"></i> {{ 'cliente.show.vinculos.processos'|trans }}</h6>
                                <p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i> {{ 'cliente.show.vinculos.sem_processo'|trans }}</p>

                                {# Pastas #}
                                <h6 class="text-muted mb-3"><i class="bi bi-folder me-1"></i> {{ 'cliente.show.vinculos.pastas'|trans }}</h6>
                                {% if pastas is empty %}
                                    <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> {{ 'cliente.show.vinculos.sem_pasta'|trans }}</p>
                                {% else %}
                                    {% for pasta in pastas %}
                                        <div class="vinculo-link mb-1">
                                            <a href="{{ path('pasta_show', {id: pasta.id}) }}" class="text-decoration-none">
                                                <i class="bi bi-folder2-open me-1 text-warning"></i>
                                                <span class="fw-semibold">{{ pasta.nup }}</span>
                                            </a>
                                            {% if (pastasOcultas ?? {})[pasta.id] is defined %}
                                                <i class="bi bi-lock exp-cadeado ms-1" title="{{ 'cliente.show.vinculos.cadeado_dica'|trans }}" aria-label="{{ 'cliente.show.vinculos.cadeado'|trans }}"></i>
                                            {% else %}
                                            <span class="badge ms-1 {% if pasta.situacao == 'ativo' %}text-bg-success{% else %}text-bg-secondary{% endif %} small">
                                                {{ pasta.situacao|capitalize }}
                                            </span>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        {# Card: Arquivos do Cliente #}
                        <div class="card card-primary card-outline mt-3">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-paperclip me-1"></i> {{ 'cliente.show.arquivos.titulo'|trans }}</h3>
                            </div>
                            <div class="card-body">
                                {# Formulário de upload inline #}
                                <form id="formAnexosCliente" method="post" enctype="multipart/form-data"
                                      action="{{ path('cliente_documento_upload', {id: cliente.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_cliente_' ~ cliente.id) }}">

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <button type="button" id="btnAdicionarAnexoCliente" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> {{ 'cliente.show.arquivos.adicionar'|trans }}
                                        </button>
                                        <button type="button" id="btnLimparAnexosCliente" class="btn btn-sm btn-outline-secondary d-none">
                                            <i class="bi bi-x-circle me-1"></i> {{ 'cliente.show.arquivos.limpar'|trans }}
                                        </button>
                                        <input type="file" id="inputAnexoOcultoCliente" multiple
                                               accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,audio/*,video/*"
                                               class="d-none">
                                    </div>

                                    <div id="listaAnexosCliente"></div>

                                    <div id="areaEnviarCliente" class="d-none mt-3">
                                        <div class="form-check form-switch">
                                            <input type="checkbox" class="form-check-input" id="reduzirTamanhoCliente" name="reduzir_tamanho" value="1">
                                            <label class="form-check-label" for="reduzirTamanhoCliente">
                                                {{ 'cliente.show.arquivos.reduzir'|trans }}
                                            </label>
                                        </div>
                                        <div class="form-text text-muted mb-2">
                                            {{ 'cliente.show.arquivos.reduzir_nota'|trans }}
                                            <span class="d-block text-warning-emphasis">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                {{ 'cliente.show.arquivos.reduzir_aviso'|trans }}
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-cloud-upload me-1"></i> {{ 'cliente.show.arquivos.enviar_todos'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                {# Documentos já enviados #}
                                {% set hasDocuments = false %}
                                {% for tipo, docs in documentosPorTipo %}
                                    {% if docs|length > 0 %}{% set hasDocuments = true %}{% endif %}
                                {% endfor %}

                                {% if hasDocuments %}
                                <hr>
                                <div class="mb-3">
                                    {% for tipo, docs in documentosPorTipo %}
                                        {% if docs|length > 0 %}
                                            {% set label = documentTypeOptions[tipo] ?? tipo %}
                                            {% for doc in docs %}
                                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-2 gap-3">
                                                    <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <a href="{{ path('cliente_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold">
                                                            {{ doc.nomeOriginal }}
                                                        </a>
                                                        <small class="text-muted">
                                                            {{ label }}
                                                            {% if doc.descricao %} · {{ doc.descricao }}{% endif %}
                                                            {% if doc.numero %} · {{ 'cliente.show.arquivos.numero'|trans({numero: doc.numero}) }}{% endif %}
                                                            {% if doc.vinculado %}{# vinculado do menu Documentos: sem arquivo próprio, a data é a do envio à pasta #}
                                                            · {{ doc.pastaDocumento.carregadoEm|data }}
                                                            · {{ 'cliente.show.arquivos.na_pasta'|trans({nup: doc.pastaDocumento.pasta.nup ?: ('#' ~ doc.pastaDocumento.pasta.id)}) }}
                                                            {% else %}
                                                            · {{ doc.uploadedAt|data }}
                                                            · {{ (doc.tamanhoBytes / 1024 / 1024) < 1 ? 'cliente.show.arquivos.tamanho_kb'|trans({n: (doc.tamanhoBytes / 1024)|round(1) ~ ''}) : 'cliente.show.arquivos.tamanho_mb'|trans({n: (doc.tamanhoBytes / 1024 / 1024)|round(2) ~ ''}) }}
                                                            {% endif %}
                                                        </small>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0">
                                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                                title="{{ 'cliente.comum.visualizar'|trans }}"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#previewDocModal"
                                                                data-url="{{ path('cliente_documento_view', {id: doc.id}) }}"
                                                                data-nome="{{ doc.nomeOriginal }}"
                                                                data-mime="{{ doc.mimeType }}">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        {% if not doc.vinculado %}
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="{{ 'cliente.comum.editar'|trans }}"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editDocModal{{ doc.id }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        {% endif %}
                                                        <form method="post" action="{{ path('cliente_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('{{ 'cliente.show.arquivos.excluir_confirma'|trans|e('js') }}');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_doc_cliente_' ~ doc.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'cliente.comum.excluir'|trans }}">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-end">
                    <div class="d-flex gap-2">
                        <a href="{{ path('cliente_edit', {id: cliente.id}) }}"
                           class="btn btn-outline-primary btn-sm"
                           title="{{ 'cliente.show.editar_cliente'|trans }}"
                           aria-label="{{ 'cliente.show.editar_cliente'|trans }}">
                            <i class="bi bi-pencil me-1"></i> {{ 'cliente.comum.editar'|trans }}
                        </a>
                        <form method="post" action="{{ path('cliente_delete', {id: cliente.id}) }}" onsubmit="return confirm('{{ 'cliente.show.excluir_confirma'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cliente.id) }}">
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                    title="{{ 'cliente.show.excluir_cliente'|trans }}"
                                    aria-label="{{ 'cliente.show.excluir_cliente'|trans }}">
                                <i class="bi bi-trash me-1"></i> {{ 'cliente.show.excluir_cliente_botao'|trans }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# Modal: Preview de Documento — conteúdo montado por public/js/visualizador-documento.js #}
<link rel="stylesheet" href="{{ asset('css/visualizador-documento.css') }}">
<script src="{{ asset('js/visualizador-documento.js') }}"></script>
<div class="modal fade" id="previewDocModal" tabindex="-1" aria-labelledby="previewDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="previewDocModalLabel">
                    <i class="bi bi-eye me-1"></i>
                    <span id="previewDocNome"></span>
                </h6>
                <div class="ms-auto d-flex gap-2 align-items-center">
                    <a id="previewDocDownload" href="#" class="btn btn-sm btn-outline-primary" download>
                        <i class="bi bi-download me-1"></i> {{ 'cliente.show.previa.baixar'|trans }}
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cliente.comum.fechar'|trans }}"></button>
