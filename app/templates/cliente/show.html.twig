{# Modais: Editar Documento #}
{% for tipo, docs in documentosPorTipo %}
    {% for doc in docs %}
        {% set label = documentTypeOptions[tipo] ?? tipo %}
        <div class="modal fade" id="editDocModal{{ doc.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="{{ path('cliente_documento_edit', {id: doc.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_doc_cliente_' ~ doc.id) }}">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-pencil me-1"></i> {{ 'cliente.show.editar_doc.titulo'|trans }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cliente.comum.fechar'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            {% set ext = doc.nomeOriginal|split('.')|last %}
                            {% set nomeBase = doc.nomeOriginal ends with ('.' ~ ext) and doc.nomeOriginal != ext
                                ? doc.nomeOriginal|slice(0, doc.nomeOriginal|length - ext|length - 1)
                                : doc.nomeOriginal %}
                            <div class="mb-3">
                                <label class="form-label">{{ 'cliente.show.editar_doc.nome'|trans }}</label>
                                <div class="input-group">
                                    <input type="text" name="nomeBase" class="form-control"
                                           value="{{ nomeBase }}" maxlength="250" required>
                                    <span class="input-group-text text-muted">.{{ ext }}</span>
                                </div>
                                <div class="form-text">{{ 'cliente.show.editar_doc.extensao_antes'|trans }} <strong>.{{ ext }}</strong> {{ 'cliente.show.editar_doc.extensao_depois'|trans }}</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'cliente.comum.tipo_documento'|trans }}</label>
                                <select name="categoria" class="form-select" required>
                                    {% for valor, texto in documentTypeOptions %}
                                        <option value="{{ valor }}" {{ doc.categoria == valor ? 'selected' : '' }}>{{ texto }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'cliente.comum.descricao'|trans }}</label>
                                <input type="text" name="descricao" class="form-control"
                                       value="{{ doc.descricao ?? '' }}" maxlength="500" placeholder="{{ 'cliente.comum.descricao_opcional'|trans }}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'cliente.comum.numero_opcional'|trans }}</label>
                                <input type="text" name="numero" class="form-control"
                                       value="{{ doc.numero ?? '' }}" maxlength="255" placeholder="{{ 'cliente.comum.numero'|trans }}">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'cliente.comum.cancelar'|trans }}</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> {{ 'cliente.comum.salvar'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endfor %}
{% endfor %}


<style>
.copy-btn {
    cursor: pointer;
    opacity: 0.6;
    font-size: 0.85em;
    transition: opacity 0.2s, color 0.2s;
}
.copy-btn:hover {
    opacity: 1;
}
.copy-btn.copied {
    color: #198754 !important;
}
.vinculo-link {
    transition: background-color 0.2s;
    border-radius: 4px;
    padding: 8px;
    margin-left: -8px;
    margin-right: -8px;
}
