{% extends 'base.html.twig' %}

{% block title %}Cliente - {{ cliente.cpf is defined ? cliente.nomeCompleto : cliente.razaoSocial }}{% endblock %}

{% block body %}
{# Content Header #}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-person me-2"></i>{{ cliente.cpf is defined ? cliente.nomeCompleto : cliente.razaoSocial }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('cliente_index') }}">Clientes</a></li>
                    <li class="breadcrumb-item active">Detalhes</li>
                </ol>
            </div>
        </div>
    </div>
</div>

{# Main Content #}
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">{{ cliente.cpf is defined ? 'Pessoa Física' : 'Pessoa Jurídica' }}</h3>
                <div class="card-tools">
                    <span class="badge text-bg-primary">
                        {{ cliente.cpf is defined ? cliente.cpf : cliente.cnpj }}
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    {# Left Column - Tabs #}
                    <div class="col-12 col-md-12 col-lg-8 order-2 order-md-1">
                        {# Info Boxes #}
                        <div class="row">
                            <div class="col-12 col-sm-4">
                                <div class="info-box bg-light">
                                    <div class="info-box-content">
                                        <span class="info-box-text text-center text-muted">Tipo</span>
                                        <span class="info-box-number text-center text-muted mb-0">{{ cliente.cpf is defined ? 'PF' : 'PJ' }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Tabs #}
                        <ul class="nav nav-tabs" id="clienteTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true">
                                    <i class="bi bi-person-vcard me-1"></i> Dados do Cliente
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="false">
                                    <i class="bi bi-info-circle me-1"></i> Detalhes
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content mt-3" id="clienteTabsContent">
                            {# Tab: Dados do Cliente #}
                            <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
                                {% if cliente.cpf is defined %}
                                    {# Pessoa Física #}
                                    <h5 class="mb-3"><i class="bi bi-person-badge me-1"></i> Dados Pessoais</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Nome Completo
                                                    <b class="d-block">{{ cliente.nomeCompleto }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.nomeCompleto }}" title="Copiar"></i></b>
                                                </p>
                                                <p class="text-sm mb-2">CPF
                                                    <b class="d-block">{{ cliente.cpf }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cpf }}" title="Copiar"></i></b>
                                                </p>
                                                <p class="text-sm mb-2">Data de Nascimento
                                                    <b class="d-block">{% if cliente.dataNascimento %}{{ cliente.dataNascimento|date('d/m/Y') }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.dataNascimento|date('d/m/Y') }}" title="Copiar"></i>{% else %}-{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Estado Civil
                                                    <b class="d-block">{{ cliente.estadoCivil ?: '-' }}{% if cliente.estadoCivil %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.estadoCivil }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">Profissão
                                                    <b class="d-block">{{ cliente.profissao ?: '-' }}{% if cliente.profissao %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.profissao }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <h5 class="mb-3"><i class="bi bi-card-text me-1"></i> Documento RG</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-4">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">RG
                                                    <b class="d-block">{{ cliente.rg ?: '-' }}{% if cliente.rg %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.rg }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Órgão Expedidor
                                                    <b class="d-block">{{ cliente.rgOrgaoExpedidor ?: '-' }}{% if cliente.rgOrgaoExpedidor %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.rgOrgaoExpedidor }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Data de Emissão
                                                    <b class="d-block">{% if cliente.rgDataEmissao %}{{ cliente.rgDataEmissao|date('d/m/Y') }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.rgDataEmissao|date('d/m/Y') }}" title="Copiar"></i>{% else %}-{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    {# Pessoa Jurídica #}
                                    <h5 class="mb-3"><i class="bi bi-building me-1"></i> Dados da Empresa</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Razão Social
                                                    <b class="d-block">{{ cliente.razaoSocial }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.razaoSocial }}" title="Copiar"></i></b>
                                                </p>
                                                <p class="text-sm mb-2">Nome Fantasia
                                                    <b class="d-block">{{ cliente.nomeFantasia ?: '-' }}{% if cliente.nomeFantasia %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.nomeFantasia }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">CNPJ
                                                    <b class="d-block">{{ cliente.cnpj }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cnpj }}" title="Copiar"></i></b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Inscrição Estadual
                                                    <b class="d-block">{{ cliente.inscricaoEstadual ?: '-' }}{% if cliente.inscricaoEstadual %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.inscricaoEstadual }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">Inscrição Municipal
                                                    <b class="d-block">{{ cliente.inscricaoMunicipal ?: '-' }}{% if cliente.inscricaoMunicipal %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.inscricaoMunicipal }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <h5 class="mb-3"><i class="bi bi-person-workspace me-1"></i> Representante Legal</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">Nome
                                                    <b class="d-block">{{ cliente.representanteLegal ?: '-' }}{% if cliente.representanteLegal %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteLegal }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">CPF
                                                    <b class="d-block">{{ cliente.representanteCpf ?: '-' }}{% if cliente.representanteCpf %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteCpf }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted">
                                                <p class="text-sm mb-2">RG
                                                    <b class="d-block">{{ cliente.representanteRg ?: '-' }}{% if cliente.representanteRg %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteRg }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                                <p class="text-sm mb-2">Cargo
                                                    <b class="d-block">{{ cliente.representanteCargo ?: '-' }}{% if cliente.representanteCargo %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.representanteCargo }}" title="Copiar"></i>{% endif %}</b>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                <h5 class="mb-3"><i class="bi bi-telephone me-1"></i> Contato</h5>
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2">E-mail
                                                <b class="d-block">{{ cliente.email }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.email }}" title="Copiar"></i></b>
                                            </p>
                                            <p class="text-sm mb-2">Celular
                                                <b class="d-block">{{ cliente.telefoneCelular ?: '-' }}{% if cliente.telefoneCelular %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.telefoneCelular }}" title="Copiar"></i>{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2">Telefone Fixo
                                                <b class="d-block">{{ cliente.telefoneFixo ?: '-' }}{% if cliente.telefoneFixo %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.telefoneFixo }}" title="Copiar"></i>{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <h5 class="mb-3"><i class="bi bi-geo-alt me-1"></i> Endereço</h5>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2">CEP
                                                <b class="d-block">{{ cliente.cep ?: '-' }}{% if cliente.cep %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cep }}" title="Copiar"></i>{% endif %}</b>
                                            </p>
                                            <p class="text-sm mb-2">Endereço
                                                <b class="d-block">{{ cliente.endereco ?: '-' }}{% if cliente.endereco %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.endereco }}" title="Copiar"></i>{% endif %}</b>
                                            </p>
                                            {% if cliente.complemento %}
                                            <p class="text-sm mb-2">Complemento
                                                <b class="d-block">{{ cliente.complemento }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.complemento }}" title="Copiar"></i></b>
                                            </p>
                                            {% endif %}
                                            <p class="text-sm mb-0">Cidade/Estado
                                                <b class="d-block">{{ cliente.cidade ?: '-' }} - {{ cliente.estado ?: '-' }}{% if cliente.cidade %} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ cliente.cidade }} - {{ cliente.estado }}" title="Copiar"></i>{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Tab: Informações #}
                            <div class="tab-pane fade" id="info" role="tabpanel" aria-labelledby="info-tab">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-plus me-2"></i> Criado em
                                                <b class="d-block">{% if cliente.criadoAt %}{{ cliente.criadoAt|date('d/m/Y H:i') }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-check me-2"></i> Modificado em
                                                <b class="d-block">{% if cliente.modificadoEm %}{{ cliente.modificadoEm|date('d/m/Y H:i') }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-check me-2"></i> Criado por
                                                <b class="d-block">{% if cliente.criadoPor %}{{ cliente.criadoPor.fullName }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Right Column - Sidebar #}
                    <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2">
                        <div class="card card-primary card-outline">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-link-45deg me-1"></i> Vínculos</h3>
                            </div>
                            <div class="card-body">
                                {# Processos #}
                                <h6 class="text-muted mb-3"><i class="bi bi-briefcase me-1"></i> Processos</h6>
                                <p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i> Nenhum processo cadastrado.</p>

                                {# Pastas #}
                                <h6 class="text-muted mb-3"><i class="bi bi-folder me-1"></i> Pastas</h6>
                                {% if pastas is empty %}
                                    <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhuma pasta vinculada.</p>
                                {% else %}
                                    {% for pasta in pastas %}
                                        <div class="vinculo-link mb-1">
                                            <a href="{{ path('pasta_show', {id: pasta.id}) }}" class="text-decoration-none">
                                                <i class="bi bi-folder2-open me-1 text-warning"></i>
                                                <span class="fw-semibold">{{ pasta.nup }}</span>
                                            </a>
                                            <span class="badge ms-1 {% if pasta.status == 'ativo' %}text-bg-success{% else %}text-bg-secondary{% endif %} small">
                                                {{ pasta.status|capitalize }}
                                            </span>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        {# Card: Arquivos do Cliente #}
                        <div class="card card-primary card-outline mt-3">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-paperclip me-1"></i> Arquivos do Cliente</h3>
                            </div>
                            <div class="card-body">
                                {# Formulário de upload inline #}
                                <form id="formAnexosCliente" method="post" enctype="multipart/form-data"
                                      action="{{ path('cliente_documento_upload', {id: cliente.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_cliente_' ~ cliente.id) }}">

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <button type="button" id="btnAdicionarAnexoCliente" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                        </button>
                                        <button type="button" id="btnLimparAnexosCliente" class="btn btn-sm btn-outline-secondary d-none">
                                            <i class="bi bi-x-circle me-1"></i> Limpar
                                        </button>
                                        <input type="file" id="inputAnexoOcultoCliente" multiple
                                               accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,audio/*,video/*"
                                               class="d-none">
                                    </div>

                                    <div id="listaAnexosCliente"></div>

                                    <div id="areaEnviarCliente" class="d-none mt-3 text-end">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-cloud-upload me-1"></i> Enviar todos
                                        </button>
                                    </div>
                                </form>

                                {# Documentos já enviados #}
                                {% set hasDocuments = false %}
                                {% for tipo, docs in documentosPorTipo %}
                                    {% if docs|length > 0 %}{% set hasDocuments = true %}{% endif %}
                                {% endfor %}

                                {% if hasDocuments %}
                                <hr>
                                <div class="mb-3">
                                    {% for tipo, docs in documentosPorTipo %}
                                        {% if docs|length > 0 %}
                                            {% set label = documentTypeOptions[tipo] ?? tipo %}
                                            {% for doc in docs %}
                                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-2 gap-3">
                                                    <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <a href="{{ path('cliente_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold">
                                                            {{ doc.nomeOriginal }}
                                                        </a>
                                                        <small class="text-muted">
                                                            {{ label }}
                                                            {% if doc.descricao %} · {{ doc.descricao }}{% endif %}
                                                            {% if doc.numero %} · Nº {{ doc.numero }}{% endif %}
                                                            · {{ doc.uploadedAt|date('d/m/Y') }}
                                                            · {{ (doc.tamanhoBytes / 1024 / 1024) < 1 ? (doc.tamanhoBytes / 1024)|round(1) ~ ' KB' : (doc.tamanhoBytes / 1024 / 1024)|round(2) ~ ' MB' }}
                                                        </small>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0">
                                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                                title="Visualizar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#previewDocModal"
                                                                data-url="{{ path('cliente_documento_view', {id: doc.id}) }}"
                                                                data-nome="{{ doc.nomeOriginal }}"
                                                                data-mime="{{ doc.mimeType }}">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="Editar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editDocModal{{ doc.id }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <form method="post" action="{{ path('cliente_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_doc_cliente_' ~ doc.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('cliente_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar aos Clientes
                    </a>
                    <div class="d-flex gap-2">
                        <a href="{{ path('cliente_edit', {id: cliente.id}) }}"
                           class="btn btn-outline-primary btn-sm"
                           title="Editar cliente"
                           aria-label="Editar cliente">
                            <i class="bi bi-pencil me-1"></i> Editar
                        </a>
                        <form method="post" action="{{ path('cliente_delete', {id: cliente.id}) }}" onsubmit="return confirm('Tem certeza que deseja excluir este cliente?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cliente.id) }}">
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                    title="Excluir cliente"
                                    aria-label="Excluir cliente">
                                <i class="bi bi-trash me-1"></i> Excluir Cliente
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# Modal: Preview de Documento #}
<div class="modal fade" id="previewDocModal" tabindex="-1" aria-labelledby="previewDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="previewDocModalLabel">
                    <i class="bi bi-eye me-1"></i>
                    <span id="previewDocNome"></span>
                </h6>
                <div class="ms-auto d-flex gap-2 align-items-center">
                    <a id="previewDocDownload" href="#" class="btn btn-sm btn-outline-primary" download>
                        <i class="bi bi-download me-1"></i> Download
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
            </div>
            <div class="modal-body p-0 d-flex align-items-stretch" style="min-height:60vh;">
                <div id="previewDocConteudo" class="w-100 d-flex align-items-center justify-content-center"></div>
            </div>
        </div>
    </div>
</div>

{# Modais: Editar Documento #}
{% for tipo, docs in documentosPorTipo %}
    {% for doc in docs %}
        {% set label = documentTypeOptions[tipo] ?? tipo %}
        <div class="modal fade" id="editDocModal{{ doc.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="{{ path('cliente_documento_edit', {id: doc.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_doc_cliente_' ~ doc.id) }}">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-pencil me-1"></i> Editar documento</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            {% set ext = doc.nomeOriginal|split('.')|last %}
                            {% set nomeBase = doc.nomeOriginal ends with ('.' ~ ext) and doc.nomeOriginal != ext
                                ? doc.nomeOriginal|slice(0, doc.nomeOriginal|length - ext|length - 1)
                                : doc.nomeOriginal %}
                            <div class="mb-3">
                                <label class="form-label">Nome do arquivo</label>
                                <div class="input-group">
                                    <input type="text" name="nomeBase" class="form-control"
                                           value="{{ nomeBase }}" maxlength="250" required>
                                    <span class="input-group-text text-muted">.{{ ext }}</span>
                                </div>
                                <div class="form-text">A extensão <strong>.{{ ext }}</strong> é preservada automaticamente.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Tipo de documento</label>
                                <select name="categoria" class="form-select" required>
                                    {% for valor, texto in documentTypeOptions %}
                                        <option value="{{ valor }}" {{ doc.categoria == valor ? 'selected' : '' }}>{{ texto }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Descrição</label>
                                <input type="text" name="descricao" class="form-control"
                                       value="{{ doc.descricao ?? '' }}" maxlength="500" placeholder="Descrição (opcional)">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Número (opcional)</label>
                                <input type="text" name="numero" class="form-control"
                                       value="{{ doc.numero ?? '' }}" maxlength="255" placeholder="Número">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Salvar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endfor %}
{% endfor %}


<style>
.copy-btn {
    cursor: pointer;
    opacity: 0.6;
    font-size: 0.85em;
    transition: opacity 0.2s, color 0.2s;
}
.copy-btn:hover {
    opacity: 1;
}
.copy-btn.copied {
    color: #198754 !important;
}
.vinculo-link {
    transition: background-color 0.2s;
    border-radius: 4px;
    padding: 8px;
    margin-left: -8px;
    margin-right: -8px;
}
.vinculo-link:hover {
    background-color: rgba(0,0,0,0.03);
}
.anexo-item {
    background: #fafafa;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 12px 14px;
    margin-bottom: 10px;
}
.anexo-item .anexo-nome {
    font-weight: 600;
    font-size: .92rem;
    word-break: break-all;
}
.anexo-item .anexo-tamanho {
    font-size: .8rem;
    color: #6c757d;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Tooltips ── */
    var tooltipEls = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });

    /* ── Copiar para clipboard ── */
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const text = this.getAttribute('data-copy');
            navigator.clipboard.writeText(text).then(() => {
                this.classList.replace('bi-copy', 'bi-check-lg');
                this.classList.add('copied');
                setTimeout(() => {
                    this.classList.replace('bi-check-lg', 'bi-copy');
                    this.classList.remove('copied');
                }, 1500);
            });
        });
    });

    /* ── Preview de documento ── */
    const previewModal    = document.getElementById('previewDocModal');
    const previewConteudo = document.getElementById('previewDocConteudo');
    const previewNome     = document.getElementById('previewDocNome');
    const previewDownload = document.getElementById('previewDocDownload');

    if (previewModal) {
        previewModal.addEventListener('show.bs.modal', function (e) {
            const btn  = e.relatedTarget;
            const url  = btn.dataset.url;
            const nome = btn.dataset.nome;
            const mime = btn.dataset.mime;

            previewNome.textContent = nome;
            previewDownload.href = url.replace('/visualizar', '/download');
            previewConteudo.innerHTML = '';

            if (mime === 'application/pdf') {
                previewConteudo.innerHTML =
                    `<iframe src="${url}" class="w-100 border-0" style="height:75vh;" title="${nome}"></iframe>`;
            } else if (mime.startsWith('image/')) {
                previewConteudo.innerHTML =
                    `<img src="${url}" class="img-fluid d-block mx-auto p-3" style="max-height:75vh;object-fit:contain;" alt="${nome}">`;
            } else if (mime.startsWith('audio/')) {
                previewConteudo.innerHTML =
                    `<div class="p-4 text-center w-100">
                        <i class="bi bi-file-earmark-music display-1 text-muted d-block mb-3"></i>
                        <p class="text-muted mb-3">${nome}</p>
                        <audio controls class="w-100" style="max-width:500px;">
                            <source src="${url}" type="${mime}">
                        </audio>
                     </div>`;
            } else if (mime.startsWith('video/')) {
                previewConteudo.innerHTML =
                    `<video controls class="w-100 d-block" style="max-height:75vh;">
                        <source src="${url}" type="${mime}">
                     </video>`;
            } else {
                previewConteudo.innerHTML =
                    `<div class="p-5 text-center text-muted w-100">
                        <i class="bi bi-file-earmark display-1 d-block mb-3"></i>
                        <p>Pré-visualização não disponível para este tipo de arquivo.</p>
                        <a href="${url.replace('/visualizar', '/download')}" class="btn btn-primary">
                            <i class="bi bi-download me-1"></i> Baixar arquivo
                        </a>
                     </div>`;
            }
        });

        previewModal.addEventListener('hide.bs.modal', function () {
            previewConteudo.innerHTML = '';
        });
    }

    /* ── Anexos ── */
    const documentTypeOptions = {{ documentTypeOptions|json_encode|raw }};

    const btnAdicionar = document.getElementById('btnAdicionarAnexoCliente');
    const inputOculto  = document.getElementById('inputAnexoOcultoCliente');
    const listaAnexos  = document.getElementById('listaAnexosCliente');
    const areaEnviar   = document.getElementById('areaEnviarCliente');
    const btnLimpar    = document.getElementById('btnLimparAnexosCliente');

    if (!btnAdicionar) { return; }

    let indiceGlobal = 0;

    function formatarTamanho(bytes) {
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    function buildSelectOpcoes() {
        let html = '<option value="">Selecione o tipo</option>';
        for (const [valor, texto] of Object.entries(documentTypeOptions)) {
            html += `<option value="${valor}">${texto}</option>`;
        }
        return html;
    }

    function adicionarItem(file) {
        const idx = indiceGlobal++;
        const div = document.createElement('div');
        div.className = 'anexo-item';
        div.dataset.idx = idx;
        div._file = file;

        div.innerHTML = `
            <div class="d-flex align-items-start gap-3">
                <i class="bi bi-file-earmark-text fs-4 text-primary flex-shrink-0 mt-1"></i>
                <div class="flex-grow-1">
                    <div class="anexo-nome">${file.name}</div>
                    <div class="anexo-tamanho mb-2">${formatarTamanho(file.size)}</div>
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label form-label-sm mb-1">Tipo de documento</label>
                            <select name="categorias[${idx}]" class="form-select form-select-sm" required>
                                ${buildSelectOpcoes()}
                            </select>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label form-label-sm mb-1">Descrição</label>
                            <input type="text" name="descricoes[${idx}]" class="form-control form-control-sm"
                                   placeholder="Descrição (opcional)" maxlength="500">
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label form-label-sm mb-1">Número (opcional)</label>
                            <input type="text" name="numeros[${idx}]" class="form-control form-control-sm"
                                   placeholder="Número" maxlength="255">
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0 mt-1 btn-remover-anexo" title="Remover">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;

        div.querySelector('.btn-remover-anexo').addEventListener('click', function () {
            div.remove();
            atualizarVisibilidade();
        });

        listaAnexos.appendChild(div);
    }

    function atualizarVisibilidade() {
        const temItens = listaAnexos.children.length > 0;
        areaEnviar.classList.toggle('d-none', !temItens);
        btnLimpar.classList.toggle('d-none', !temItens);
    }

    btnLimpar.addEventListener('click', function () {
        listaAnexos.innerHTML = '';
        inputOculto.value = '';
        atualizarVisibilidade();
    });

    btnAdicionar.addEventListener('click', function () {
        inputOculto.value = '';
        inputOculto.click();
    });

    inputOculto.addEventListener('change', function () {
        Array.from(this.files).forEach(function (file) { adicionarItem(file); });
        atualizarVisibilidade();
    });

    document.getElementById('formAnexosCliente').addEventListener('submit', function (e) {
        const itens = Array.from(listaAnexos.querySelectorAll('.anexo-item'));

        if (itens.length === 0) {
            e.preventDefault();
            return;
        }

        itens.forEach(function (item, novoIdx) {
            ['categorias', 'descricoes', 'numeros'].forEach(function (campo) {
                const el = item.querySelector(`[name^="${campo}["]`);
                if (el) el.name = `${campo}[${novoIdx}]`;
            });
        });

        const dt = new DataTransfer();
        itens.forEach(function (item) {
            if (item._file) dt.items.add(item._file);
        });

        inputOculto.name = 'arquivos[]';
        inputOculto.files = dt.files;
    });
});
</script>
{% endblock %}
