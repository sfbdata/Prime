{# ============================================================================
   Janela "Cadastro e qualificação do cliente" (desenho 1.2.3, `cadAbrir`/`cadVals`; E12f fatia 3a).
   Fragmento devolvido por `cliente_cadastro`; quem monta e controla é public/js/cliente-cadastro.js.

   Abas: Cliente, Réu (3c), Endereço, Contato, Documentos (3b), Qualificação e Histórico (3d: o histórico próprio do
   cadastro, só rótulos, nunca valores; `HistoricoDoCliente`). Spec E12, §13. Pessoa jurídica usa a mesma janela
   adaptada (decisão do dono, sem desenho próprio).
   Nenhum campo é obrigatório para salvar (decisão do dono, 21/10/2026); o que falta vira pendência, sem asterisco.
   As regras de pendência vêm do servidor (`PendenciasDoCadastro`): cada campo cobrado leva o texto e a aba
   da pendência dele em data-*, para o JS recalcular a cada tecla como o desenho; as de documento chegam prontas.
   Sem permissão de EDITAR o cliente, os campos vêm travados e não há Salvar.

   Contexto: cliente, novo (Novo cliente: sem id, pela pasta ou, sem pasta, pelo modal Nova carteira), autores, pf, pendencias, pendenciasDocs, qualificacao, podeEditar, pasta, podeVincular, estadosCivis, docs,
   abaInicial, mostrarOcr, reus (null sem pasta de contexto), historico (lista de {q, t}, a mais nova primeiro).
   ============================================================================ #}
{% set novo = novo ?? false %}
{% set autores = autores ?? [] %}
{% set historico = historico ?? [] %}
{% set travado = not podeEditar %}
{% set documento = pf ? cliente.cpf : cliente.cnpj %}
{% set ROTULO_CIVIL = {SOLTEIRO: 'cliente.cadastro.civil.solteiro'|trans, CASADO: 'cliente.cadastro.civil.casado'|trans, DIVORCIADO: 'cliente.cadastro.civil.divorciado'|trans, SEPARADO: 'cliente.cadastro.civil.separado'|trans, VIUVO: 'cliente.cadastro.civil.viuvo'|trans, UNIAO_ESTAVEL: 'cliente.cadastro.civil.uniao_estavel'|trans} %}
{% set UFS = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'] %}
{% macro campo(rotulo, nome, valor, larg, opcoes = {}) %}
    {% set o = {obrig: null, aba: 'pessoais', tipo: 'text', placeholder: '', mascara: null, travado: false, inputmode: null, maxlength: 100}|merge(opcoes) %}
    <label class="cad-campo cad-campo--{{ larg }}">
        <span class="cad-rotulo">{{ rotulo }}</span>
        <input type="{{ o.tipo }}" name="{{ nome }}" value="{{ valor }}" class="cad-input" autocomplete="off"
               {% if o.placeholder %}placeholder="{{ o.placeholder }}"{% endif %}
               {% if o.mascara %}data-mascara="{{ o.mascara }}"{% endif %}
               {% if o.inputmode %}inputmode="{{ o.inputmode }}"{% endif %}
               {% if o.maxlength %}maxlength="{{ o.maxlength }}"{% endif %}
               {% if o.obrig %}data-obrig="{{ o.obrig }}" data-aba="{{ o.aba }}"{% endif %}
               {% if o.travado %}disabled{% endif %}>
    </label>
{% endmacro %}
{% import _self as f %}
<div class="cad-veu" data-cad-janela
     data-url-cadastro="{{ path('cliente_cadastro', {id: 0}) }}"
     {% if novo and not pasta %}
     data-novo="1"
     data-url-salvar="{{ path('cliente_cadastro_novo_salvar') }}"
     data-url-documento="{{ path('cliente_cadastro_novo_documento') }}"
     data-csrf="{{ csrf_token('cliente_cadastro_novo') }}"
     data-url-janela="{{ path('cliente_cadastro_novo') }}"
     {% elseif novo %}
     data-novo="1"
     data-url-salvar="{{ path('pasta_cadastro_novo_salvar', {id: pasta.id}) }}"
     data-url-documento="{{ path('pasta_cadastro_novo_documento', {id: pasta.id}) }}"
     data-csrf="{{ csrf_token('pasta_cadastro_novo_' ~ pasta.id) }}"
     data-url-janela="{{ path('pasta_cadastro_novo', {id: pasta.id}) }}"
     {% else %}
     data-url-salvar="{{ path('cliente_cadastro_salvar', {id: cliente.id}) }}"
     data-url-documento="{{ path('cliente_cadastro_documento', {id: cliente.id}) }}"
     data-csrf="{{ csrf_token('cliente_cadastro_' ~ cliente.id) }}"
     data-cliente-id="{{ cliente.id }}"
     data-url-upload="{{ path('cliente_documento_upload', {id: cliente.id}) }}"
     data-csrf-upload="{{ csrf_token('upload_documento_cliente_' ~ cliente.id) }}"
     data-url-janela="{{ path('cliente_cadastro', {id: cliente.id, pasta: pasta ? pasta.id : null}) }}"
     {% endif %}
     data-tipo="{{ pf ? 'pf' : 'pj' }}"
     data-pasta="{{ pasta ? pasta.id : '' }}"
     data-tem-fixo="{{ cliente.telefoneFixo ? '1' : '' }}"
     data-fixo="{{ cliente.telefoneFixo }}"
     {% if podeVincular %}
     data-url-vincular="{{ path('pasta_cliente_vincular', {id: pasta.id}) }}"
     data-csrf-vincular="{{ csrf_token('pasta_cliente_vincular_' ~ pasta.id) }}"
     data-url-principal="{{ path('pasta_cliente_principal', {id: pasta.id, cliente: 0}) }}"
     {% endif %}
     data-pend-docs="{{ pendenciasDocs|json_encode|e('html_attr') }}">
    <div class="cad-janela" role="dialog" aria-modal="true" aria-label="{{ 'cliente.cadastro.titulo'|trans }}">
        <header class="cad-topo">
            <span class="cad-topo-icone" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
            <div class="cad-topo-texto">
                <div class="cad-topo-nome js-cad-nome">{{ cliente.nomeExibicao ? cliente.nomeExibicao|upper : 'cliente.cadastro.novo_cliente'|trans }}</div>
                <div class="cad-topo-sub">
                    <span class="js-cad-doc">{{ documento ? documento|documento_br_rotulo ~ ' ' ~ documento|documento_br : (pf ? 'cliente.cadastro.pend.cpf'|trans : 'cliente.cadastro.pend.cnpj'|trans) }}</span>
                    <span class="cad-status js-cad-status"><span class="cad-status-ponto" aria-hidden="true"></span><span class="js-cad-status-texto"></span></span>
                </div>
            </div>
            <button type="button" class="cad-fechar js-cad-fechar" aria-label="{{ 'cliente.comum.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
        </header>

        {# Seletor de autores (decisão do dono, E12i): os clientes da pasta; clicar troca de cadastro sem fechar a
           janela (com alteração não salva, pede para salvar antes). "Novo autor" abre um cadastro novo ligado à pasta. #}
        {% if pasta and (autores|length > 1 or (podeVincular and autores is not empty)) %}
            <div class="cad-autores" role="group" aria-label="{{ 'cliente.cadastro.autores.grupo'|trans }}">
                <span class="cad-autores-rotulo">{{ 'cliente.cadastro.autores.rotulo'|trans }}</span>
                {% for a in autores %}
                    <button type="button" class="cad-autor js-cad-autor{{ not novo and a.id == cliente.id ? ' is-ativo' : '' }}"
                            data-url="{{ path('cliente_cadastro', {id: a.id, pasta: pasta.id}) }}"
                            {% if not novo and a.id == cliente.id %}aria-current="true"{% endif %}>
                        {{ a.nome|upper }}{% if a.principal %}<span class="cad-autor-tag">{{ 'cliente.cadastro.autores.principal'|trans }}</span>{% endif %}
                    </button>
                {% endfor %}
                {% if podeVincular %}
                    <button type="button" class="cad-autor cad-autor--novo js-cad-autor{{ novo ? ' is-ativo' : '' }}"
                            data-url="{{ path('pasta_cadastro_novo', {id: pasta.id, autor: 1}) }}"><i class="bi bi-plus-lg" aria-hidden="true"></i>{{ 'cliente.cadastro.autores.novo'|trans }}</button>
                {% endif %}
            </div>
        {% endif %}

        <nav class="cad-abas" role="tablist">
            {% for aba in [
                {k: 'pessoais', rotulo: pf ? 'cliente.cadastro.aba.cliente'|trans : 'cliente.cadastro.aba.empresa'|trans, icone: 'bi-person'},
                {k: 'endereco', rotulo: 'cliente.cadastro.aba.endereco'|trans, icone: 'bi-geo-alt'},
                {k: 'contato',  rotulo: 'cliente.cadastro.aba.contato'|trans,  icone: 'bi-telephone'},
                {k: 'docs',     rotulo: 'cliente.cadastro.aba.documentos'|trans, icone: 'bi-paperclip', so: not novo},
                {k: 'reu',      rotulo: 'cliente.cadastro.aba.reu'|trans,      icone: 'bi-person-x', so: reus is not null},
                {k: 'qual',     rotulo: 'cliente.cadastro.aba.qualificacao'|trans, icone: 'bi-file-text'},
                {k: 'hist',     rotulo: 'cliente.cadastro.aba.historico'|trans, icone: 'bi-clock-history'},
            ]|filter(a => a.so ?? true) %}
                <button type="button" class="cad-aba{{ aba.k == abaInicial ? ' is-ativa' : '' }}" role="tab" data-cad-aba="{{ aba.k }}"
                        aria-selected="{{ aba.k == abaInicial ? 'true' : 'false' }}">
                    <i class="bi {{ aba.icone }}" aria-hidden="true"></i>{{ aba.rotulo }}<span class="cad-aba-ponto" aria-hidden="true" hidden></span>
                </button>
            {% endfor %}
        </nav>

        <form class="cad-corpo" novalidate>
            <section class="cad-painel cad-grade" data-cad-painel="pessoais"{{ abaInicial != 'pessoais' ? ' hidden' : '' }}>
                {% if novo and podeEditar %}
                    {# Novo cadastro: pessoa física ou empresa (a janela adaptada para PJ, decisão do dono). #}
                    <div class="cad-campo cad-campo--6 cad-tipo" role="radiogroup" aria-label="{{ 'cliente.cadastro.tipo.grupo'|trans }}">
                        {% for t in [{v: 'pf', rotulo: 'cliente.cadastro.tipo.pf'|trans}, {v: 'pj', rotulo: 'cliente.cadastro.aba.empresa'|trans}] %}
                            <button type="button" class="cad-tipo-op js-cad-tipo{{ (t.v == 'pf') == pf ? ' is-ativo' : '' }}" role="radio"
                                    aria-checked="{{ (t.v == 'pf') == pf ? 'true' : 'false' }}"
                                    data-url="{{ pasta ? path('pasta_cadastro_novo', {id: pasta.id, tipo: t.v, autor: app.request.query.get('autor')}) : path('cliente_cadastro_novo', {tipo: t.v}) }}">{{ t.rotulo }}</button>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if pf %}
                    {{ f.campo('cliente.cadastro.campo.nome_completo'|trans, 'nome', cliente.nomeCompleto, 6, {obrig: 'cliente.cadastro.pend.nome_completo'|trans, travado: travado, maxlength: 150}) }}
                    <label class="cad-campo cad-campo--2">
                        <span class="cad-rotulo">{{ 'cliente.cadastro.campo.cpf'|trans }}</span>
                        <input type="text" name="cpf" value="{{ cliente.cpf|documento_br }}" class="cad-input js-cad-cpf" autocomplete="off"
                               inputmode="numeric" placeholder="000.000.000-00" data-mascara="cpf" data-obrig="{{ 'cliente.cadastro.pend.cpf'|trans }}" data-aba="pessoais"
                               {% if travado %}disabled{% endif %}>
                        <span class="cad-aviso js-cad-cpf-aviso" hidden>{{ 'cliente.cadastro.aviso.cpf_invalido'|trans }}</span>
                    </label>
                    <div class="cad-campo cad-campo--2 cad-campo--par">
                        <label class="cad-sub">
                            <span class="cad-rotulo">{{ 'cliente.cadastro.campo.rg'|trans }}</span>
                            <input type="text" name="rg" value="{{ cliente.rg }}" class="cad-input" autocomplete="off" placeholder="{{ 'cliente.comum.numero'|trans }}" maxlength="20"
                                   data-obrig="{{ 'cliente.cadastro.pend.rg'|trans }}" data-aba="pessoais" {% if travado %}disabled{% endif %}>
                        </label>
                        <label class="cad-sub">
                            <span class="cad-rotulo">{{ 'cliente.cadastro.campo.orgao'|trans }}</span>
                            <input type="text" name="rg_orgao" value="{{ cliente.rgOrgaoExpedidor }}" class="cad-input" autocomplete="off" placeholder="{{ 'cliente.cadastro.campo.orgao_exemplo'|trans }}"
                                   {% if travado %}disabled{% endif %}>
                        </label>
                    </div>
                    {{ f.campo('cliente.cadastro.campo.nascimento'|trans, 'nascimento', cliente.dataNascimento ? cliente.dataNascimento|date('Y-m-d') : '', 2, {tipo: 'date', travado: travado}) }}
                    <label class="cad-campo cad-campo--2">
                        <span class="cad-rotulo">{{ 'cliente.cadastro.campo.estado_civil'|trans }}</span>
                        <select name="estado_civil" class="cad-input" data-obrig="{{ 'cliente.cadastro.pend.estado_civil'|trans }}" data-aba="pessoais" {% if travado %}disabled{% endif %}>
                            <option value=""></option>
                            {% for codigo in estadosCivis %}
                                <option value="{{ codigo }}" {{ cliente.estadoCivil == codigo ? 'selected' : '' }}>{{ ROTULO_CIVIL[codigo] }}</option>
                            {% endfor %}
                            {% if cliente.estadoCivil and cliente.estadoCivil not in estadosCivis %}
                                <option value="{{ cliente.estadoCivil }}" selected>{{ cliente.estadoCivil|capitalize }}</option>
                            {% endif %}
                        </select>
                    </label>
                    {{ f.campo('cliente.cadastro.campo.profissao'|trans, 'profissao', cliente.profissao|capitalize, 2, {obrig: 'cliente.cadastro.pend.profissao'|trans, travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.nacionalidade'|trans, 'nacionalidade', cliente.nacionalidade ?? 'brasileiro(a)', 1, {travado: travado, maxlength: 50}) }}
                    <label class="cad-campo cad-campo--1">
                        <span class="cad-rotulo">{{ 'cliente.cadastro.campo.genero'|trans }}</span>
                        <select name="genero" class="cad-input" {% if travado %}disabled{% endif %}>
                            <option value=""></option>
                            <option value="MASCULINO" {{ cliente.genero == 'MASCULINO' ? 'selected' : '' }}>{{ 'cliente.cadastro.genero.masculino'|trans }}</option>
                            <option value="FEMININO" {{ cliente.genero == 'FEMININO' ? 'selected' : '' }}>{{ 'cliente.cadastro.genero.feminino'|trans }}</option>
                        </select>
                    </label>
                {% else %}
                    {{ f.campo('cliente.cadastro.campo.razao_social'|trans, 'razao_social', cliente.razaoSocial, 6, {obrig: 'cliente.cadastro.pend.razao_social'|trans, travado: travado}) }}
                    <label class="cad-campo cad-campo--2">
                        <span class="cad-rotulo">{{ 'cliente.cadastro.campo.cnpj'|trans }}</span>
                        <input type="text" name="cnpj" value="{{ cliente.cnpj|documento_br }}" class="cad-input js-cad-cpf" autocomplete="off"
                               inputmode="numeric" placeholder="00.000.000/0000-00" data-mascara="cnpj" data-obrig="{{ 'cliente.cadastro.pend.cnpj'|trans }}" data-aba="pessoais"
                               {% if travado %}disabled{% endif %}>
                        <span class="cad-aviso js-cad-cpf-aviso" hidden>{{ 'cliente.cadastro.aviso.cnpj_invalido'|trans }}</span>
                    </label>
                    {{ f.campo('cliente.cadastro.campo.nome_fantasia'|trans, 'nome_fantasia', cliente.nomeFantasia, 4, {travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.inscricao_estadual'|trans, 'inscricao_estadual', cliente.inscricaoEstadual, 2, {travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.inscricao_municipal'|trans, 'inscricao_municipal', cliente.inscricaoMunicipal, 2, {travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.representante_cargo'|trans, 'representante_cargo', cliente.representanteCargo, 2, {travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.representante_legal'|trans, 'representante_legal', cliente.representanteLegal, 4, {obrig: 'cliente.cadastro.pend.representante_legal'|trans, travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.representante_cpf'|trans, 'representante_cpf', cliente.representanteCpf|documento_br, 2, {obrig: 'cliente.cadastro.pend.representante_cpf'|trans, mascara: 'cpf', inputmode: 'numeric', placeholder: '000.000.000-00', travado: travado}) }}
                    {{ f.campo('cliente.cadastro.campo.representante_rg'|trans, 'representante_rg', cliente.representanteRg, 2, {travado: travado}) }}
                {% endif %}
            </section>

            {% if reus is not null %}
                {# Aba Réu (desenho 1.2.3, L.699-720; E12h): grava na hora, pelas rotas pasta_reu_*. Os campos não têm
                   `name` de propósito: não entram no Salvar do cliente nem no "há alterações". #}
                <section class="cad-painel" data-cad-painel="reu"{{ abaInicial != 'reu' ? ' hidden' : '' }}
                         data-reus="{{ reus|json_encode|e('html_attr') }}"
                         data-url-reu="{{ path('pasta_reu_adicionar', {id: pasta.id}) }}"
                         data-csrf-reu="{{ csrf_token('pasta_reus_' ~ pasta.id) }}"
                         data-pode-reu="{{ podeVincular ? '1' : '' }}">
                    <p class="cad-nota cad-nota--topo">{{ 'cliente.cadastro.reu.nota_antes'|trans }} <strong>{{ 'cliente.cadastro.aba.reu'|trans }}</strong> {{ 'cliente.cadastro.reu.nota_meio'|trans }} "{{ 'cliente.cadastro.reu.nota_e_outros'|trans }}".</p>
                    {% if podeVincular %}
                        <div class="cad-grade cad-reu-form">
                            <label class="cad-campo cad-campo--4">
                                <span class="cad-rotulo">{{ 'cliente.cadastro.reu.nome'|trans }} <b aria-hidden="true">*</b></span>
                                <input type="text" class="cad-input js-cad-reu-nome" placeholder="{{ 'cliente.cadastro.reu.nome_exemplo'|trans }}" maxlength="255" autocomplete="off">
                            </label>
                            <label class="cad-campo cad-campo--2">
                                <span class="cad-rotulo">{{ 'cliente.cadastro.reu.documento'|trans }}</span>
                                <input type="text" class="cad-input js-cad-reu-doc" placeholder="{{ 'cliente.cadastro.reu.opcional'|trans }}" inputmode="numeric" maxlength="18" autocomplete="off">
                            </label>
                            <div class="cad-campo cad-campo--6 cad-reu-linha-acao">
                                <span class="cad-aviso js-cad-reu-aviso" hidden></span>
                                <button type="button" class="cad-btn cad-btn--pri is-pronto js-cad-reu-add"><i class="bi bi-plus-lg" aria-hidden="true"></i>{{ 'cliente.cadastro.reu.adicionar'|trans }}</button>
                            </div>
                        </div>
                    {% endif %}
                    <ul class="cad-reus js-cad-reus"></ul>
                </section>
            {% endif %}

            <section class="cad-painel cad-grade" data-cad-painel="endereco"{{ abaInicial != 'endereco' ? ' hidden' : '' }}>
                {{ f.campo('cliente.cadastro.campo.cep'|trans, 'cep', cliente.cep|length == 8 ? cliente.cep|slice(0, 5) ~ '-' ~ cliente.cep|slice(5) : cliente.cep, 2, {obrig: 'cliente.cadastro.pend.cep'|trans, aba: 'endereco', mascara: 'cep', inputmode: 'numeric', placeholder: '00000-000', travado: travado, maxlength: 9}) }}
                {{ f.campo('cliente.cadastro.campo.logradouro'|trans, 'logradouro', cliente.endereco, 4, {obrig: 'cliente.cadastro.pend.logradouro'|trans, aba: 'endereco', travado: travado}) }}
                {{ f.campo('cliente.comum.numero'|trans, 'numero', cliente.numero, 1, {obrig: 'cliente.cadastro.pend.numero'|trans, aba: 'endereco', travado: travado, maxlength: 20}) }}
                {{ f.campo('cliente.cadastro.campo.complemento'|trans, 'complemento', cliente.complemento, 2, {travado: travado}) }}
                {{ f.campo('cliente.cadastro.campo.bairro'|trans, 'bairro', cliente.bairro, 3, {obrig: 'cliente.cadastro.pend.bairro'|trans, aba: 'endereco', travado: travado}) }}
                {{ f.campo('cliente.cadastro.campo.cidade'|trans, 'cidade', cliente.cidade, 4, {obrig: 'cliente.cadastro.pend.cidade'|trans, aba: 'endereco', travado: travado}) }}
                <label class="cad-campo cad-campo--2">
                    <span class="cad-rotulo">{{ 'cliente.cadastro.campo.uf'|trans }}</span>
                    <select name="uf" class="cad-input" data-obrig="{{ 'cliente.cadastro.pend.uf'|trans }}" data-aba="endereco" {% if travado %}disabled{% endif %}>
                        <option value=""></option>
                        {% for uf in UFS %}<option value="{{ uf }}" {{ cliente.estado|upper == uf ? 'selected' : '' }}>{{ uf }}</option>{% endfor %}
                    </select>
                </label>
                <p class="cad-nota js-cad-cep-nota" hidden>{{ 'cliente.cadastro.aviso.cep_preenchido'|trans }}</p>
            </section>

            <section class="cad-painel cad-grade js-cad-contatos" data-cad-painel="contato"{{ abaInicial != 'contato' ? ' hidden' : '' }}>
                {{ f.campo('cliente.cadastro.campo.telefone'|trans, 'telefone', cliente.telefoneCelular, 2, {tipo: 'tel', mascara: 'tel', travado: travado, maxlength: 20}) }}
                {{ f.campo('cliente.cadastro.campo.whatsapp'|trans, 'whatsapp', cliente.whatsapp, 2, {tipo: 'tel', mascara: 'tel', travado: travado, maxlength: 20}) }}
                <label class="cad-campo cad-campo--2">
                    <span class="cad-rotulo">{{ 'cliente.cadastro.campo.email'|trans }}</span>
                    <input type="email" name="email" value="{{ cliente.email }}" class="cad-input js-cad-email" autocomplete="off" placeholder="{{ 'cliente.cadastro.campo.email_exemplo'|trans }}"
                           {% if travado %}disabled{% endif %}>
                    <span class="cad-aviso js-cad-email-aviso" hidden>{{ 'cliente.cadastro.aviso.email_invalido'|trans }}</span>
                </label>
            </section>

            {# Aba Documentos (desenho 1.2.3, L.736-810; E12f fatia 3b): os dois anexos que o cadastro cobra. As ações
               usam as rotas de documento de cliente que já existem (enviar, ver, baixar, excluir), que conferem a
               permissão de EDITAR o cliente e o CSRF. "Substituir" envia o novo e só depois exclui o antigo. #}
            {% if not novo %}
            <section class="cad-painel" data-cad-painel="docs"{{ abaInicial != 'docs' ? ' hidden' : '' }}>
                {# Inteligência cadastral (desenho 02, l.740 a 791; spec cliente-inteligencia-cadastral, F-A): carregada ao abrir
                   a aba (`cliente_inteligencia_cadastral`), desenhada pelo JS. Só com CPF/CNPJ válido; sem leitura de
                   documento, sem sugestões e sem "Atualizar sozinho" (fatias futuras). #}
                <div class="cad-ii js-cad-ii" hidden
                     data-url="{{ path('cliente_inteligencia_cadastral', {id: cliente.id}) }}"
                     data-url-vincular="{{ path('cliente_inteligencia_cadastral_vincular', {id: cliente.id, documentoId: 0}) }}"></div>
                {% for cat, info in {
                    IDENTIFICACAO: {titulo: 'cliente.cadastro.doc.identificacao'|trans, sub: 'cliente.cadastro.doc.identificacao_sub'|trans, icone: 'bi-person-badge'},
                    COMPROVANTE_RESIDENCIA: {titulo: 'cliente.cadastro.doc.residencia'|trans, sub: 'cliente.cadastro.doc.residencia_sub'|trans, icone: 'bi-house-door'},
                } %}
                    {% set doc = docs[cat] %}
                    <div class="cad-doc{{ doc ? ' is-anexado' : '' }}" data-cad-doc="{{ cat }}"{% if doc %} data-doc-id="{{ doc.id }}"{% endif %}>
                        <span class="cad-doc-icone" aria-hidden="true"><i class="bi {{ info.icone }}"></i></span>
                        <div class="cad-doc-texto">
                            <div class="cad-doc-titulo">{{ info.titulo }}</div>
                            <div class="cad-doc-info">
                                {% if doc and doc.vinculado %}{{ doc.nomeOriginal }} · {{ 'cliente.cadastro.doc.anexado_em'|trans({data: doc.pastaDocumento.carregadoEm|data}) }}{% elseif doc %}{{ doc.nomeOriginal }} · {{ 'cliente.cadastro.doc.anexado_em'|trans({data: doc.uploadedAt|data}) }} · {{ 'cliente.cadastro.doc.tamanho_kb'|trans({n: (doc.tamanhoBytes / 1024)|round(0, 'ceil') ~ ''}) }}{% else %}{{ info.sub }} · {{ 'cliente.cadastro.doc.nao_anexado'|trans }}{% endif %}
                            </div>
                        </div>
                        <div class="cad-doc-acoes">
                            {% if doc %}
                                <a class="cad-btn cad-btn--sec" href="{{ path('cliente_documento_view', {id: doc.id}) }}" target="_blank" rel="noopener">{{ 'cliente.comum.visualizar'|trans }}</a>
                                <a class="cad-btn cad-btn--sec" href="{{ path('cliente_documento_download', {id: doc.id}) }}">{{ 'cliente.cadastro.doc.baixar'|trans }}</a>
                                {% if podeEditar %}
                                    <button type="button" class="cad-btn cad-btn--sec js-cad-doc-anexar" data-substituir="1">{{ 'cliente.cadastro.doc.substituir'|trans }}</button>
                                    <button type="button" class="cad-btn cad-btn--sec js-cad-doc-excluir"
                                            data-url="{{ path('cliente_documento_delete', {id: doc.id}) }}"
                                            data-csrf="{{ csrf_token('delete_doc_cliente_' ~ doc.id) }}">{{ 'cliente.comum.excluir'|trans }}</button>
                                {% endif %}
                            {% elseif podeEditar %}
                                <button type="button" class="cad-btn cad-btn--pri is-pronto js-cad-doc-anexar">{{ 'cliente.cadastro.doc.anexar'|trans }}</button>
                            {% endif %}
                        </div>
                        <div class="cad-doc-confirma js-cad-doc-confirma" hidden>
                            <span>{{ 'cliente.cadastro.doc.excluir_confirma'|trans({nome: doc ? doc.nomeOriginal : ''}) }}</span>
                            <button type="button" class="cad-btn cad-btn--perigo js-cad-doc-excluir-sim">{{ 'cliente.comum.excluir'|trans }}</button>
                            <button type="button" class="cad-btn cad-btn--link js-cad-doc-excluir-nao">{{ 'cliente.comum.cancelar'|trans }}</button>
                        </div>
                    </div>
                {% endfor %}
                {% if mostrarOcr %}
                    <div class="cad-ocr">
                        <div class="cad-ocr-titulo"><i class="bi bi-magic" aria-hidden="true"></i>{{ 'cliente.cadastro.ocr.titulo'|trans }}</div>
                        <p>{{ 'cliente.cadastro.ocr.texto'|trans }}</p>
                    </div>
                {% endif %}
                {% if podeEditar %}
                    <input type="file" class="js-cad-doc-arquivo" accept="image/*,.pdf" hidden>
                {% endif %}
            </section>

            {% endif %}

            <section class="cad-painel" data-cad-painel="qual"{{ abaInicial != 'qual' ? ' hidden' : '' }}>
                <div class="cad-qual js-cad-qual">{{ qualificacao }}</div>
                <p class="cad-nota">{{ 'cliente.cadastro.qualificacao_nota'|trans }}</p>
            </section>

            {# Aba Histórico (desenho 1.2.3, `cq.hist`; E12 fatia 3d): quem fez o quê no cadastro, a mais nova primeiro, as
               40 mais novas. Só rótulos ("alterou nome, CPF"), nunca o valor. O bloco Pendências some nesta aba. #}
            <section class="cad-painel" data-cad-painel="hist"{{ abaInicial != 'hist' ? ' hidden' : '' }}>
                {% if historico is empty %}
                    <div class="cad-hist-vazio">{{ 'cliente.cadastro.historico_vazio'|trans }}</div>
                {% else %}
                    <ul class="cad-hist">
                        {% for h in historico %}
                            <li class="cad-hist-linha"><span class="cad-hist-q">{{ h.q }}</span><span class="cad-hist-t">{{ h.t }}</span></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <div class="cad-existente js-cad-existente" role="alert" hidden>
                <div class="cad-existente-titulo"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>{{ pf ? 'cliente.cadastro.existente.titulo_cpf'|trans : 'cliente.cadastro.existente.titulo_cnpj'|trans }}</div>
                <div class="cad-existente-quem js-cad-existente-quem"></div>
                <div class="cad-existente-acoes">
                    <button type="button" class="cad-btn cad-btn--sec js-cad-existente-abrir">{{ 'cliente.cadastro.existente.abrir'|trans }}</button>
                    {% if podeVincular %}<button type="button" class="cad-btn cad-btn--pri js-cad-existente-usar">{{ 'cliente.cadastro.existente.usar'|trans }}</button>{% endif %}
                    <button type="button" class="cad-btn cad-btn--link js-cad-existente-cancelar">{{ 'cliente.comum.cancelar'|trans }}</button>
                </div>
            </div>

            <div class="cad-pend js-cad-pend" hidden>
                <div class="cad-pend-titulo">{{ 'cliente.cadastro.pendencias'|trans }}</div>
                <div class="cad-pend-lista js-cad-pend-lista"></div>
            </div>
        </form>

        <footer class="cad-rodape">
            <span class="cad-msg js-cad-msg" aria-live="polite"></span>
            <button type="button" class="cad-btn cad-btn--sec js-cad-fechar">{{ 'cliente.comum.fechar'|trans }}</button>
            <button type="button" class="cad-btn cad-btn--sec js-cad-copiar"><i class="bi bi-clipboard" aria-hidden="true"></i>{{ 'cliente.comum.copiar_qualificacao'|trans }}</button>
            {% if podeEditar %}
                <button type="button" class="cad-btn cad-btn--pri js-cad-salvar"><i class="bi bi-check2" aria-hidden="true"></i>{{ 'cliente.comum.salvar'|trans }}</button>
            {% endif %}
        </footer>
    </div>
</div>
