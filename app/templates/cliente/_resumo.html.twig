{# ============================================================================
   Janela "Detalhes do cliente" — fragmento servido por `cliente_resumo`
   (ClienteResumoController) e posto na tela da pasta pelo pasta-clientes.js.
   Desenho aprovado: "02 - EXPEDIENTES 1.2.3.dc.html", L.779-836.

   Contatos editáveis aqui mesmo (dc L.810-836, lógica L.5748-5786): lápis abre
   o campo (Enter salva, Esc cancela), lixeira remove telefone, "+ Telefone" e
   "+ E-mail" abrem um campo novo. Quem salva é o POST `cliente_contatos`
   (pasta-clientes.js), que devolve esta janela re-renderizada. O modelo tem 3
   slots fixos (celular, fixo, e-mail): "+ Telefone" só enquanto houver slot de
   telefone vazio, "+ E-mail" só se o e-mail estiver vazio, e o e-mail não tem
   lixeira (é obrigatório no cadastro). Sem permissão de editar o cliente, nada
   disso aparece: a janela fica só de leitura. O campo de digitação nasce no JS
   (no HTML servido não há input).

   Depois dos "+", a linha que já existia: "Copiar qualificação" (que no desenho
   mora no modal de cadastro, que não existe aqui) e "Editar cadastro".

   Contexto: `resumo` (ClienteResumoOutput). As pastas já vêm filtradas pela
   permissão POR PASTA — o template não filtra nada.
   ============================================================================ #}
{% set tagRotulo = {atual: 'cliente.resumo.tag.atual'|trans, ativa: 'cliente.resumo.tag.ativa'|trans, arquivada: 'cliente.resumo.tag.arquivada'|trans} %}
<div class="ps-cli-janela" role="dialog" aria-label="{{ 'cliente.resumo.titulo'|trans }}" data-cliente-id="{{ resumo.clienteId }}"
     {%- if resumo.podeEditar %} data-contatos-url="{{ path('cliente_contatos', {id: resumo.clienteId}) }}" data-contatos-token="{{ csrf_token('cliente_contatos_' ~ resumo.clienteId) }}"{% endif %}>
    <div class="ps-cli-cab" data-ps-cli-arrastar title="{{ 'cliente.resumo.arrastar'|trans }}">
        <span class="ps-cli-cab-avatar" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
        <span class="ps-cli-cab-corpo">
            <span class="ps-cli-cab-rotulo">{{ 'cliente.resumo.titulo'|trans }}</span>
            <span class="ps-cli-cab-nome">{{ resumo.nome }}</span>
        </span>
        <button type="button" class="ps-cli-fechar js-ps-cli-fechar" aria-label="{{ 'cliente.comum.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="ps-cli-corpo">
        <div class="ps-cli-campo" data-campo="nome">
            <span class="ps-cli-campo-txt">
                <span class="ps-cli-campo-rotulo">{{ 'cliente.resumo.nome'|trans }}</span>
                <span class="ps-cli-campo-valor">{{ resumo.nome }}</span>
            </span>
            <button type="button" class="ps-cli-copiar js-ps-copiar" data-ps-copiar="{{ resumo.nome|e('html_attr') }}"
                    title="{{ 'cliente.comum.copiar'|trans }}" aria-label="{{ 'cliente.resumo.copiar_nome'|trans }}"><i class="bi bi-copy"></i></button>
        </div>

        {% if resumo.documento is not empty %}
            <div class="ps-cli-campo" data-campo="documento">
                <span class="ps-cli-campo-txt">
                    <span class="ps-cli-campo-rotulo">{{ resumo.documentoRotulo }}</span>
                    <span class="ps-cli-campo-valor ps-num">{{ resumo.documento }}</span>
                </span>
                <button type="button" class="ps-cli-copiar js-ps-copiar" data-ps-copiar="{{ resumo.documento|e('html_attr') }}"
                        title="{{ 'cliente.comum.copiar'|trans }}" aria-label="{{ 'cliente.resumo.copiar_item'|trans({item: resumo.documentoRotulo}) }}"><i class="bi bi-copy"></i></button>
            </div>
        {% endif %}

        <div class="ps-cli-numeros">
            <div class="ps-cli-numero"><span class="ps-cli-numero-v ps-num">{{ resumo.totalPastas }}</span><span class="ps-cli-numero-l">{{ resumo.totalPastas == 1 ? 'cliente.resumo.numero.pasta'|trans : 'cliente.resumo.numero.pastas'|trans }}</span></div>
            <div class="ps-cli-numero"><span class="ps-cli-numero-v ps-num">{{ resumo.pastasAtivas }}</span><span class="ps-cli-numero-l">{{ resumo.pastasAtivas == 1 ? 'cliente.resumo.numero.ativa'|trans : 'cliente.resumo.numero.ativas'|trans }}</span></div>
            <div class="ps-cli-numero"><span class="ps-cli-numero-v ps-num">{{ resumo.pastasComProcesso }}</span><span class="ps-cli-numero-l">{{ 'cliente.resumo.numero.com_processo'|trans }}</span></div>
        </div>

        <div class="ps-cli-pastas">
            <span class="ps-cli-secao">{{ 'cliente.resumo.pastas_mesmo'|trans({item: resumo.documentoRotulo in ['CPF', 'CNPJ'] ? resumo.documentoRotulo : 'cliente.resumo.pastas_mesmo_cliente'|trans}) }}</span>
            {% for p in resumo.pastas %}
                {% if p.tag == 'atual' %}
                    <span class="ps-cli-pasta ps-cli-pasta--atual" data-pasta-id="{{ p.id }}">
                        <i class="bi bi-folder2"></i>
                        <span class="ps-cli-pasta-num ps-num">{{ p.nup }}</span>
                        <span class="ps-cli-pasta-acao">{{ p.acao }}</span>
                        <span class="ps-cli-tag ps-cli-tag--atual">{{ tagRotulo[p.tag] }}</span>
                    </span>
                {% else %}
                    <a class="ps-cli-pasta" href="{{ path('pasta_show', {id: p.id}) }}" data-pasta-id="{{ p.id }}">
                        <i class="bi bi-folder2"></i>
                        <span class="ps-cli-pasta-num ps-num">{{ p.nup }}</span>
                        <span class="ps-cli-pasta-acao">{{ p.acao }}</span>
                        <span class="ps-cli-tag ps-cli-tag--{{ p.tag }}">{{ tagRotulo[p.tag] }}</span>
                    </a>
                {% endif %}
            {% else %}
                <span class="ps-cli-vazio">{{ 'cliente.resumo.sem_pasta'|trans }}</span>
            {% endfor %}
        </div>

        <div class="ps-cli-div"></div>

        <div class="ps-cli-desde"><i class="bi bi-calendar3"></i>{{ resumo.clienteDesde ? 'cliente.resumo.desde'|trans({data: resumo.clienteDesde|data}) : 'cliente.resumo.cadastrado'|trans }}</div>

        <div class="ps-cli-contatos">
            {% for c in resumo.contatos %}
                <div class="ps-cli-contato" data-contato="{{ c.rotulo|e('html_attr') }}" data-campo="{{ c.campo }}" data-tipo="{{ c.tipo }}" data-valor="{{ c.valor|e('html_attr') }}">
                    <i class="bi {{ c.icone }}" title="{{ c.rotulo }}"></i>
                    <span class="ps-cli-contato-valor">{{ c.valor }}</span>
                    <button type="button" class="ps-cli-copiar ps-cli-copiar--mini js-ps-copiar" data-ps-copiar="{{ c.valor|e('html_attr') }}"
                            title="{{ 'cliente.comum.copiar'|trans }}" aria-label="{{ 'cliente.resumo.copiar_item'|trans({item: c.rotulo|lower}) }}"><i class="bi bi-copy"></i></button>
                    {% if resumo.podeEditar %}
                        <button type="button" class="ps-cli-copiar ps-cli-copiar--mini js-ps-ct-editar"
                                title="{{ 'cliente.comum.editar'|trans }}" aria-label="{{ 'cliente.resumo.editar_item'|trans({item: c.rotulo|lower}) }}"><i class="bi bi-pencil"></i></button>
                    {% endif %}
                </div>
            {% else %}
                <div class="ps-cli-contato ps-cli-contato--vazio"><i class="bi bi-telephone-x"></i><span class="ps-cli-contato-valor">{{ 'cliente.resumo.sem_contato'|trans }}</span></div>
            {% endfor %}
        </div>

        {% if resumo.podeEditar and (resumo.telefoneLivre is not null or resumo.emailVazio) %}
            <div class="ps-cli-add">
                {% if resumo.telefoneLivre is not null %}
                    <button type="button" class="ps-cli-acao js-ps-ct-novo" data-campo="{{ resumo.telefoneLivre }}" data-tipo="tel"><i class="bi bi-plus-lg"></i><span>{{ 'cliente.resumo.mais_telefone'|trans }}</span></button>
                {% endif %}
                {% if resumo.emailVazio %}
                    <button type="button" class="ps-cli-acao js-ps-ct-novo" data-campo="email" data-tipo="email"><i class="bi bi-plus-lg"></i><span>{{ 'cliente.resumo.mais_email'|trans }}</span></button>
                {% endif %}
            </div>
        {% endif %}

        <div class="ps-cli-acoes">
            {% if resumo.qualificacao is not empty %}
                {% set dicaQual = resumo.pendencias is empty
                    ? 'cliente.resumo.qualificacao_dica'|trans
                    : (resumo.pendencias|length == 1 ? 'cliente.resumo.qualificacao_dica_pendencia'|trans({n: resumo.pendencias|length ~ '', lista: resumo.pendencias|join('; ')}) : 'cliente.resumo.qualificacao_dica_pendencias'|trans({n: resumo.pendencias|length ~ '', lista: resumo.pendencias|join('; ')})) %}
                <button type="button" class="ps-cli-acao js-ps-copiar js-ps-copiar-qualificacao"
                        data-ps-copiar="{{ resumo.qualificacao|e('html_attr') }}"
                        data-ps-copiado="{{ 'cliente.resumo.qualificacao_copiada'|trans }}"
                        title="{{ dicaQual }}"><i class="bi bi-clipboard-check"></i><span>{{ 'cliente.comum.copiar_qualificacao'|trans }}</span></button>
            {% endif %}
            {% if resumo.podeEditar %}
                <a class="ps-cli-acao ps-cli-acao--link" href="{{ path('cliente_edit', {id: resumo.clienteId}) }}"><i class="bi bi-pencil"></i><span>{{ 'cliente.resumo.editar_cadastro'|trans }}</span></a>
            {% endif %}
        </div>
    </div>
</div>
