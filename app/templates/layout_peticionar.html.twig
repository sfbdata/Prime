<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Peticionar{% endblock %} — BlueJus</title>

    {# Favicon #}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/app.css">

    <style>
    /* ═══════════════════════════════════════════════════════════════════════
       DESIGN TOKENS
       ═══════════════════════════════════════════════════════════════════════ */
    :root {
        --h:    var(--header-height);
        --tl-w: 340px;

        /* Azul judicial — tom primário */
        --blue:      #0084AC;
        --blue-hover:#029BCA;

        /* Painel timeline (esquerda) */
        --tl-bg:        #fff;
        --tl-surface:   #f9f9f9;
        --tl-hover:     #f3f3f3;
        --tl-active-bg: rgba(0, 132, 172, 0.07);
        --tl-active-bd: #0084AC;
        --tl-text:      #454545;
        --tl-muted:     #888;
        --tl-border:    var(--bs-border-color);
        --tl-sep:       #eee;

        /* Painel preview (direita) */
        --pv-bg: #f5f5f5;

        /* Marca BlueJus */
        --coral: #E86C50;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       BASE
       ═══════════════════════════════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; }

    body.petic-body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: var(--bs-body-bg);
        font-family: 'Open Sans', Arial, Verdana, sans-serif;
        font-size: 14px;
        color: var(--bs-body-color);
    }

    /* ═══════════════════════════════════════════════════════════════════════
       CABEÇALHO — mantém o padrão BlueJus com fix do position:fixed
       ═══════════════════════════════════════════════════════════════════════ */
    nav.app-header.navtop {
        position: relative !important;
        height: var(--h) !important;
        min-height: var(--h) !important;
        max-height: var(--h) !important;
    }

    .petic-navtop-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1px;
        min-width: 0;
    }
    .petic-navtop-nup {
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 420px;
        line-height: 1.2;
    }
    .petic-navtop-sub {
        font-size: 0.72rem;
        font-weight: 400;
        color: rgba(255,255,255,0.75);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 420px;
        line-height: 1.2;
    }

    /* ── Botão de processo na navbar ── */
    .petic-processo-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 4px;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 10px;
        cursor: pointer;
        transition: background 0.15s;
        white-space: nowrap;
    }
    .petic-processo-btn:hover,
    .petic-processo-btn[aria-expanded="true"] {
        background: rgba(255,255,255,0.22);
    }
    .petic-processo-btn::after { display: none !important; }
    .petic-processo-btn .bi-chevron-down {
        font-size: 10px;
        opacity: 0.7;
        transition: transform 0.2s;
    }
    .petic-processo-btn[aria-expanded="true"] .bi-chevron-down {
        transform: rotate(180deg);
    }

    /* ── Card do dropdown do processo ── */
    .petic-processo-card {
        min-width: 420px;
        max-width: 520px;
        padding: 0 !important;
        border: none !important;
        border-radius: 3px !important;
        box-shadow: 0 4px 16px rgba(0,0,0,0.22) !important;
        overflow: hidden;
        margin-top: 6px !important;
    }

    .petic-proc-header {
        background: #0078AA;
        padding: 10px 14px 12px;
    }
    .petic-proc-numero {
        display: block;
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.2px;
        margin-bottom: 4px;
    }
    .petic-proc-partes {
        display: block;
        font-size: 0.72rem;
        color: rgba(255,255,255,0.82);
        line-height: 1.35;
        word-break: break-word;
        white-space: normal;
    }

    .petic-proc-body {
        background: var(--bs-body-bg);
        padding: 6px 0 4px;
    }
    .petic-proc-row {
        display: flex;
        align-items: baseline;
        padding: 5px 14px;
        gap: 10px;
        border-bottom: 1px solid var(--bs-border-color);
    }
    .petic-proc-row:last-child { border-bottom: none; }
    .petic-proc-label {
        flex-shrink: 0;
        width: 130px;
        text-align: right;
        font-size: 0.77rem;
        font-weight: 600;
        color: var(--bs-secondary-color);
    }
    .petic-proc-value {
        font-size: 0.77rem;
        color: var(--bs-body-color);
        word-break: break-word;
        white-space: normal;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       LAYOUT PRINCIPAL
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-main {
        height: calc(100vh - var(--h));
        overflow: hidden;
    }

    .petic-layout {
        display: grid;
        grid-template-columns: var(--tl-w) 1fr;
        height: 100%;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       PAINEL ESQUERDO — TIMELINE
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-timeline {
        height: 100%;
        overflow: hidden;
        background: var(--tl-bg);
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--tl-border);
    }

    .petic-timeline-header {
        padding: 8px 14px;
        border-bottom: 1px solid var(--tl-border);
        display: flex;
        flex-direction: column;
        gap: 7px;
        flex-shrink: 0;
        background: var(--tl-surface);
    }

    .petic-search {
        position: relative;
        display: flex;
        align-items: center;
    }
    .petic-search-icon {
        position: absolute;
        left: 8px;
        font-size: 12px;
        color: var(--bs-secondary-color);
        pointer-events: none;
    }
    .petic-search-input {
        width: 100%;
        height: 28px;
        padding: 0 8px 0 26px;
        border: 1px solid var(--bs-border-color);
        border-radius: 3px;
        font-size: 12px;
        color: var(--bs-body-color);
        background: var(--bs-body-bg);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .petic-search-input::placeholder { color: var(--bs-secondary-color); }
    .petic-search-input:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 2px rgba(0,132,172,0.12);
    }

    .petic-timeline-header-title {
        font-size: 12px;
        font-weight: 600;
        color: var(--bs-secondary-color);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .petic-timeline-header-title i {
        font-size: 13px;
        color: var(--blue);
    }
    .petic-timeline-header-title .badge {
        font-size: 11px !important;
        font-weight: 500 !important;
        background: var(--bs-border-color) !important;
        color: var(--bs-secondary-color) !important;
        border-radius: 3px !important;
        padding: 2px 7px !important;
    }

    .petic-timeline-list {
        flex: 1;
        overflow-y: auto;
        padding: 4px 0;
        scrollbar-width: thin;
        scrollbar-color: var(--bs-border-color) transparent;
    }
    .petic-timeline-list::-webkit-scrollbar       { width: 4px; }
    .petic-timeline-list::-webkit-scrollbar-track  { background: transparent; }
    .petic-timeline-list::-webkit-scrollbar-thumb  { background: var(--bs-border-color); border-radius: 2px; }

    /* ── Timeline vertical ── */
    .petic-tl-inner {
        padding: 4px 10px 16px 8px;
        position: relative;
    }
    .petic-tl-inner::before {
        content: '';
        position: absolute;
        left: 18px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--bs-border-color);
        z-index: 0;
    }

    .petic-tl-datesep {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 0 6px;
        position: relative;
        z-index: 1;
    }
    .petic-tl-datesep span {
        background: var(--bs-tertiary-bg);
        border-radius: 20px;
        padding: 3px 12px;
        font-size: 11px;
        font-weight: 600;
        color: var(--bs-secondary-color);
        white-space: nowrap;
    }

    .petic-tl-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 6px;
        cursor: pointer;
        position: relative;
        z-index: 1;
    }

    .petic-tl-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 13px;
        background: var(--bs-secondary-color);
        border: 2px solid var(--bs-border-color);
        box-shadow: 0 0 0 1.5px #aaa;
        position: relative;
        z-index: 2;
    }
    .petic-tl-dot--primary   { background: #0084AC; box-shadow: 0 0 0 1.5px #0084AC; }
    .petic-tl-dot--success   { background: #198754; box-shadow: 0 0 0 1.5px #198754; }
    .petic-tl-dot--info      { background: #0dcaf0; box-shadow: 0 0 0 1.5px #0dcaf0; }
    .petic-tl-dot--warning   { background: #d08000; box-shadow: 0 0 0 1.5px #d08000; }
    .petic-tl-dot--dark      { background: var(--bs-body-color);    box-shadow: 0 0 0 1.5px #333; }
    .petic-tl-dot--secondary { background: var(--bs-secondary-color); box-shadow: 0 0 0 1.5px #6c757d; }

    .petic-tl-card {
        flex: 1;
        min-width: 0;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-left-width: 1px;
        border-radius: 4px;
        padding: 8px 10px 7px;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .petic-tl-row:hover .petic-tl-card {
        border-color: var(--bs-border-color);
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .petic-tl-row.ativo .petic-tl-card {
        border-left: 3px solid #0084AC;
        background: rgba(0,132,172,0.03);
    }

    .petic-tl-card-top {
        display: flex;
        align-items: flex-start;
        gap: 6px;
    }
    .petic-tl-icon {
        color: #0084AC;
        font-size: 14px;
        flex-shrink: 0;
        margin-top: 1px;
    }
    .petic-tl-titulo {
        font-size: 12.5px;
        font-weight: 500;
        color: var(--bs-body-color);
        line-height: 1.4;
        word-break: break-word;
    }
    .petic-tl-row.ativo .petic-tl-titulo { color: #0084AC; }

    .petic-tl-card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 6px;
    }
    .petic-item-cat {
        font-size: 10px !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px !important;
        border-radius: 3px !important;
        padding: 2px 6px !important;
        text-transform: uppercase;
    }
    .petic-tl-time {
        font-size: 11px;
        color: var(--bs-secondary-color);
        flex-shrink: 0;
    }

    .petic-tl-vazio {
        padding: 40px 20px;
        text-align: center;
        color: var(--bs-secondary-color);
        font-size: 13px;
        line-height: 1.8;
    }
    .petic-tl-vazio i { font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 0.5rem; }

    /* Rodapé da timeline */
    .petic-timeline-footer {
        flex-shrink: 0;
        padding: 10px 12px;
        border-top: 1px solid var(--tl-border);
        background: var(--tl-surface);
    }
    .petic-timeline-footer .btn.btn-primary {
        background: var(--blue) !important;
        border-color: var(--blue) !important;
        border-radius: 3px;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s, box-shadow 0.2s;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
    }
    .petic-timeline-footer .btn.btn-primary:hover {
        background: var(--blue-hover) !important;
        border-color: var(--blue-hover) !important;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       PAINEL DIREITO — PREVIEW
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-preview {
        height: 100%;
        overflow: hidden;
        background: var(--pv-bg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .petic-preview-placeholder {
        text-align: center;
        padding: 3rem;
        user-select: none;
    }
    .petic-preview-placeholder i {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 1rem;
        color: var(--bs-secondary-color);
        opacity: 0.6;
    }
    .petic-preview-placeholder p {
        font-size: 13px;
        color: var(--bs-secondary-color);
        margin: 0;
    }

    #previewIframe {
        width: 100%;
        height: 100%;
        border: none;
        display: none;
    }

    #previewImagem {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
        border-radius: 2px;
        box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12);
        display: none;
    }

    #previewAudio {
        width: 75%;
        max-width: 460px;
        display: none;
        accent-color: var(--blue);
    }

    #previewVideo {
        max-width: 92%;
        max-height: 88%;
        box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16);
        display: none;
    }

    .petic-download-panel {
        display: none;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 2rem;
    }
    .petic-download-panel i {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 1rem;
        color: var(--bs-secondary-color);
        opacity: 0.6;
    }
    .petic-download-panel p.text-muted {
        font-size: 13px;
        color: var(--bs-secondary-color) !important;
        margin-bottom: 1.25rem;
    }
    .petic-download-panel .btn-outline-primary {
        font-size: 13px;
        font-weight: 600;
        border-radius: 3px;
        padding: 8px 22px;
        border-color: var(--blue) !important;
        color: var(--blue) !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s, color 0.2s;
    }
    .petic-download-panel .btn-outline-primary:hover {
        background: var(--blue) !important;
        color: #fff !important;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       MODAL DE UPLOAD
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }
    .petic-modal-overlay.aberto { display: flex; }

    .petic-modal {
        background: var(--bs-body-bg);
        border-radius: 2px;
        padding: 24px 24px 20px;
        width: 460px;
        max-width: 95vw;
        box-shadow: 0 16px 28px 0 rgba(0,0,0,0.22), 0 25px 55px 0 rgba(0,0,0,0.21);
    }

    .petic-modal-title {
        font-size: 18px;
        font-weight: 400;
        color: var(--bs-body-color);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .petic-modal-title i { font-size: 16px; color: var(--blue); }

    .petic-modal .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--bs-body-color);
        margin-bottom: 4px;
        display: block;
    }

    .petic-modal .form-control,
    .petic-modal .form-select {
        font-size: 14px;
        border: 1px solid var(--bs-border-color);
        border-radius: 0;
        padding: 8px;
        height: 40px;
        color: var(--bs-body-color);
        background: var(--bs-body-bg);
        box-shadow: inset 0 1px 1px rgba(0,0,0,0.075);
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .petic-modal textarea.form-control { height: auto; }
    .petic-modal .form-control:focus,
    .petic-modal .form-select:focus {
        border-color: #66afe9;
        box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102,175,233,0.6);
        outline: 0;
    }
    .petic-modal .form-control::placeholder { color: var(--bs-secondary-color); }

    .petic-modal .form-text {
        font-size: 12px;
        color: var(--bs-secondary-color);
        margin-top: 3px;
    }

    .petic-modal .btn-secondary {
        font-size: 13px;
        font-weight: 400;
        background: var(--bs-body-bg) !important;
        border: 1px solid var(--bs-border-color) !important;
        color: var(--bs-body-color) !important;
        border-radius: 3px;
        padding: 6px 16px;
        text-transform: uppercase;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
        transition: background 0.2s;
    }
    .petic-modal .btn-secondary:hover { background: var(--bs-border-color) !important; }

    .petic-modal .btn-primary {
        font-size: 13px;
        font-weight: 400;
        background: var(--blue) !important;
        border-color: var(--blue) !important;
        color: #fff !important;
        border-radius: 3px;
        padding: 6px 16px;
        text-transform: uppercase;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
        transition: background 0.2s;
    }
    .petic-modal .btn-primary:hover {
        background: var(--blue-hover) !important;
        border-color: var(--blue-hover) !important;
    }

    .petic-modal .alert-danger {
        font-size: 13px;
        border-radius: 2px;
        border: 1px solid #ebccd1;
        background: #f2dede;
        color: #a94442;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       SPINNER
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.55s linear infinite;
        flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="petic-body">

    {# ── Cabeçalho ── #}
    <nav class="app-header navtop">

        {# ── Barra principal azul ── #}
        <div class="navtop-inner">

            <div class="navtop-left">
                <a href="{{ path('expediente_index') }}" class="navtop-brand">
                    <img src="/images/logo/bluejus-white-transparent-nav.png" alt="BlueJus" class="navtop-brand-logo" style="height:32px;">
                </a>
                <span class="navtop-page-sep">|</span>
                <div class="petic-navtop-info">
                    <span class="petic-navtop-nup">Número da Pasta: {{ pastaInfoNup }}</span>
                    {% set sub = [] %}
                    {% if pastaInfoCliente %}{% set sub = sub|merge(['Cliente: ' ~ pastaInfoCliente]) %}{% endif %}
                    {% if pasta.nomeAcao %}{% set sub = sub|merge([pasta.nomeAcao]) %}{% endif %}
                    {% if sub %}
                        <span class="petic-navtop-sub">{{ sub|join(' · ') }}</span>
                    {% endif %}
                </div>

                {% if pasta.processoPrincipal %}
                    {% set proc = pasta.processoPrincipal %}
                    <span class="navtop-page-sep">|</span>
                    <div class="dropdown">
                        <button class="petic-processo-btn dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-journal-text"></i>
                            {{ proc.siglaTribunal ? proc.siglaTribunal ~ ' ' : '' }}{{ proc.numeroProcesso }}
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu petic-processo-card">

                            <div class="petic-proc-header">
                                <span class="petic-proc-numero">
                                    <i class="bi bi-journal-text me-1"></i>
                                    {{ proc.siglaTribunal ? proc.siglaTribunal ~ ' ' : '' }}{{ proc.numeroProcesso }}
                                </span>
                                {% set poloAtivo   = proc.partes|filter(p => 'ATIVO'   in p.tipo) %}
                                {% set poloPassivo = proc.partes|filter(p => 'PASSIVO' in p.tipo) %}
                                {% if poloAtivo|length or poloPassivo|length %}
                                    <span class="petic-proc-partes">
                                        {% if poloAtivo|length %}{{ poloAtivo|first.nome }}{% endif %}
                                        {% if poloAtivo|length and poloPassivo|length %} X {% endif %}
                                        {% if poloPassivo|length %}{{ poloPassivo|first.nome }}{% endif %}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="petic-proc-body">
                                {% if proc.classeProcessual %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">Classe judicial</span>
                                        <span class="petic-proc-value">{{ proc.classeProcessual }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.assuntoProcessual %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">Assunto</span>
                                        <span class="petic-proc-value">{{ proc.assuntoProcessual }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.orgaoJulgador %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">Jurisdição</span>
                                        <span class="petic-proc-value">{{ proc.orgaoJulgador }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.dataDistribuicao %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">Distribuição</span>
                                        <span class="petic-proc-value">{{ proc.dataDistribuicao|date('d/m/Y') }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.instancia %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">Instância</span>
                                        <span class="petic-proc-value">{{ proc.instancia }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.situacaoProcesso %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">Situação</span>
                                        <span class="petic-proc-value">{{ proc.situacaoProcesso }}</span>
                                    </div>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="navtop-right">

                {# Notificações #}
                <div class="navtop-action dropdown">
                    <a href="#" class="navtop-action-btn"
                       data-bs-toggle="dropdown" id="notificacaoDropdownToggle"
                       aria-label="Notificações">
                        <i class="bi bi-bell-fill"></i>
                        <span class="navtop-badge" id="notificacaoBadge"
                              style="{% if notificacoesCount == 0 %}display:none;{% endif %}">
                            {{ notificacoesCount > 9 ? '9+' : notificacoesCount }}
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow notif-dropdown"
                         id="notificacaoDropdownMenu">
                        <div class="notif-header">
                            <i class="bi bi-bell me-1"></i>
                            <span id="notificacaoCountText">{{ notificacoesCount }}</span> notificação(ões)
                        </div>
                        <div class="dropdown-divider m-0"></div>
                        <div id="notificacaoListContainer">
                            {% if notificacoes|length > 0 %}
                                {% for notif in notificacoes %}
                                    <a href="{{ notif.url ?? (notif.tarefa ? path('tarefa_show', {id: notif.tarefa.id}) : '#') }}"
                                       class="dropdown-item notif-item{% if not notif.lida %} notif-unread{% endif %}">
                                        <i class="bi {{ notif.icone }} notif-icon"></i>
                                        <div class="notif-body">
                                            <div class="notif-title">{{ notif.titulo }}</div>
                                            <div class="notif-msg">{{ notif.mensagem }}</div>
                                            <div class="notif-time">{{ notif.tempoRelativo }}</div>
                                        </div>
                                    </a>
                                    <div class="dropdown-divider m-0"></div>
                                {% endfor %}
                            {% else %}
                                <a href="#" class="dropdown-item text-center text-muted py-3" id="notificacaoEmpty">
                                    <i class="bi bi-check-circle me-2"></i> Nenhuma notificação
                                </a>
                            {% endif %}
                        </div>
                        <a href="{{ path('notificacao_index') }}" class="dropdown-item text-center notif-footer">
                            <i class="bi bi-list-ul me-1"></i> Ver todas as notificações
                        </a>
                    </div>
                </div>

                {# Fullscreen #}
                <a href="#" class="navtop-action-btn" data-lte-toggle="fullscreen"
                   aria-label="Tela cheia">
                    <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                    <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display:none"></i>
                </a>

                {# Usuário #}
                <div class="navtop-action dropdown menu-usuario">
                    <a href="#" class="navtop-avatar-btn dropdown-toggle"
                       data-bs-toggle="dropdown" aria-expanded="false"
                       aria-label="Menu do usuário">
                        <div class="navtop-user-info d-none d-md-flex">
                            <span class="navtop-username">{{ app.user.fullName }}</span>
                        </div>
                        <span class="navtop-avatar" id="navtopAvatar">
                            {% if fotoPerfilUrl %}
                                <img src="{{ path('app_profile_foto_serve', {nome: fotoPerfilUrl}) }}"
                                     alt="{{ app.user.fullName }}"
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                            {% else %}
                                {{ app.user.fullName|slice(0,1)|upper }}
                            {% endif %}
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow usuario-dropdown">
                        <li class="usuario-dropdown-header">
                            <span class="usuario-avatar-lg" id="usuarioAvatarLg">
                                {% if fotoPerfilUrl %}
                                    <img src="{{ path('app_profile_foto_serve', {nome: fotoPerfilUrl}) }}"
                                         alt="{{ app.user.fullName }}"
                                         style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                                {% else %}
                                    {{ app.user.fullName|slice(0,1)|upper }}
                                {% endif %}
                            </span>
                            <div class="usuario-info">
                                <div class="usuario-name">{{ app.user.fullName }}</div>
                                <div class="usuario-email">{{ app.user.email }}</div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider my-0"></li>
                        <li>
                            <a href="{{ path('app_profile') }}" class="dropdown-item d-flex align-items-center gap-2">
                                <i class="bi bi-person"></i> Meu Perfil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-0"></li>
                        <li>
                            <a href="{{ path('app_logout') }}" class="dropdown-item d-flex align-items-center gap-2 text-danger">
                                <i class="bi bi-box-arrow-right"></i> Sair
                            </a>
                        </li>
                    </ul>
                </div>

            </div>{# /navtop-right #}
        </div>{# /navtop-inner #}

    </nav>

    {# ── Conteúdo principal ── #}
    <main class="petic-main">
        {% block content %}{% endblock %}
    </main>

    {# Scripts #}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>

    <script src="{{ asset('js/tinymce/tinymce.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
