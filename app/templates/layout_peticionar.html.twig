<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Peticionar{% endblock %} — JusPrime</title>

    <link rel="icon" href="/favicon.ico" sizes="any">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/app.css">

    <style>
    /* ═══════════════════════════════════════════════════════════════════════
       DESIGN TOKENS
       ═══════════════════════════════════════════════════════════════════════ */
    :root {
        --h:    58px;
        --tl-w: 340px;

        /* Azul judicial — tom primário */
        --blue:      #0084AC;
        --blue-hover:#029BCA;

        /* Painel timeline (esquerda) */
        --tl-bg:        #fff;
        --tl-surface:   #f9f9f9;
        --tl-hover:     #f3f3f3;
        --tl-active-bg: rgba(0, 132, 172, 0.07);
        --tl-active-bd: #0084AC;
        --tl-text:      #454545;
        --tl-muted:     #888;
        --tl-border:    #ddd;
        --tl-sep:       #eee;

        /* Painel preview (direita) */
        --pv-bg: #f5f5f5;

        /* Marca JusPrime */
        --coral: #E86C50;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       BASE
       ═══════════════════════════════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; }

    body.petic-body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #fff;
        font-family: 'Open Sans', Arial, Verdana, sans-serif;
        font-size: 14px;
        color: #454545;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       CABEÇALHO — mantém o padrão JusPrime com fix do position:fixed
       ═══════════════════════════════════════════════════════════════════════ */
    .app-header.navtop {
        position: relative !important;
        height: var(--h) !important;
        min-height: var(--h) !important;
        max-height: var(--h) !important;
    }

    .petic-header-inner {
        display: grid !important;
        grid-template-columns: 1fr auto 1fr !important;
        align-items: center !important;
        height: var(--h) !important;
        padding: 0 20px !important;
        width: 100% !important;
        gap: 16px;
    }

    .petic-header-left   { justify-self: start;  min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .petic-header-center { justify-self: center; }
    .petic-header-right  { justify-self: end; }

    .petic-pasta-nup {
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 280px;
    }

    .petic-pasta-cliente {
        font-size: 0.72rem;
        font-weight: 400;
        opacity: 0.65;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 280px;
    }

    .navtop-avatar-btn {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        text-decoration: none !important;
        padding: 5px 10px 5px 12px !important;
        border-radius: 6px !important;
        border: 1px solid transparent !important;
        transition: background 0.15s !important;
    }
    .navtop-avatar-btn:hover {
        background: rgba(255,255,255,0.08) !important;
        border-color: rgba(255,255,255,0.1) !important;
    }

    .navtop-username {
        font-size: 0.75rem !important;
        font-weight: 500 !important;
    }

    .navtop-avatar {
        width: 28px !important;
        height: 28px !important;
        border-radius: 50% !important;
        background: var(--coral) !important;
        color: #fff !important;
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex-shrink: 0 !important;
    }

    .petic-header-right .dropdown-menu {
        font-size: 0.82rem;
        min-width: 160px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12);
        border-radius: 3px;
        padding: 4px;
        margin-top: 6px !important;
    }
    .petic-header-right .dropdown-item {
        border-radius: 2px;
        padding: 8px 12px;
        font-size: 0.82rem;
        color: #454545;
        transition: background 0.15s, color 0.15s;
    }
    .petic-header-right .dropdown-item:hover {
        background: #f3f3f3;
        color: var(--blue);
    }

    /* ═══════════════════════════════════════════════════════════════════════
       LAYOUT PRINCIPAL
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-main {
        height: calc(100vh - var(--h));
        overflow: hidden;
    }

    .petic-layout {
        display: grid;
        grid-template-columns: var(--tl-w) 1fr;
        height: 100%;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       PAINEL ESQUERDO — TIMELINE
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-timeline {
        height: 100%;
        overflow: hidden;
        background: var(--tl-bg);
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--tl-border);
    }

    .petic-timeline-header {
        height: 40px;
        padding: 0 14px;
        border-bottom: 1px solid var(--tl-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        background: var(--tl-surface);
    }

    .petic-timeline-header-title {
        font-size: 12px;
        font-weight: 600;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .petic-timeline-header-title i {
        font-size: 13px;
        color: var(--blue);
    }
    .petic-timeline-header-title .badge {
        font-size: 11px !important;
        font-weight: 500 !important;
        background: #e0e0e0 !important;
        color: #666 !important;
        border-radius: 3px !important;
        padding: 2px 7px !important;
    }

    .petic-timeline-list {
        flex: 1;
        overflow-y: auto;
        padding: 4px 0;
        scrollbar-width: thin;
        scrollbar-color: #ddd transparent;
    }
    .petic-timeline-list::-webkit-scrollbar       { width: 4px; }
    .petic-timeline-list::-webkit-scrollbar-track  { background: transparent; }
    .petic-timeline-list::-webkit-scrollbar-thumb  { background: #ddd; border-radius: 2px; }

    /* ── Item da timeline ── */
    @keyframes itemReveal {
        from { opacity: 0; transform: translateX(-8px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    .petic-timeline-item {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-rows: auto auto;
        align-items: start;
        gap: 3px 8px;
        padding: 10px 14px;
        cursor: pointer;
        border-left: 3px solid transparent;
        transition: background 0.15s, border-color 0.15s;
        animation: itemReveal 0.32s ease both;
    }

    .petic-timeline-item:hover {
        background: var(--tl-hover);
        border-left-color: rgba(0,132,172,0.35);
    }
    .petic-timeline-item.ativo {
        background: var(--tl-active-bg);
        border-left-color: var(--tl-active-bd);
    }

    .petic-item-date {
        grid-column: 1;
        grid-row: 1;
        font-size: 11px;
        color: var(--tl-muted);
        font-weight: 400;
        display: flex;
        align-items: center;
        gap: 4px;
        line-height: 1;
    }
    .petic-item-date i { font-size: 10px; }

    .petic-item-titulo {
        grid-column: 1 / -1;
        grid-row: 2;
        font-size: 13px;
        font-weight: 500;
        color: var(--tl-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.35;
    }
    .petic-timeline-item.ativo .petic-item-titulo { color: var(--blue); }

    .petic-timeline-item > span:last-child {
        grid-column: 2;
        grid-row: 1;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .petic-item-cat {
        font-size: 10px !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px !important;
        border-radius: 3px !important;
        padding: 2px 6px !important;
        text-transform: uppercase;
    }

    .petic-item-sep {
        height: 1px;
        background: var(--tl-sep);
        margin: 0 14px;
    }

    .petic-vazio {
        padding: 40px 20px;
        text-align: center;
        color: #aaa;
        font-size: 13px;
        line-height: 1.8;
    }
    .petic-vazio i { color: #ccc !important; opacity: 1 !important; }

    /* Rodapé da timeline */
    .petic-timeline-footer {
        flex-shrink: 0;
        padding: 10px 12px;
        border-top: 1px solid var(--tl-border);
        background: var(--tl-surface);
    }
    .petic-timeline-footer .btn.btn-primary {
        background: var(--blue) !important;
        border-color: var(--blue) !important;
        border-radius: 3px;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s, box-shadow 0.2s;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
    }
    .petic-timeline-footer .btn.btn-primary:hover {
        background: var(--blue-hover) !important;
        border-color: var(--blue-hover) !important;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       PAINEL DIREITO — PREVIEW
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-preview {
        height: 100%;
        overflow: hidden;
        background: var(--pv-bg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .petic-preview-placeholder {
        text-align: center;
        padding: 3rem;
        user-select: none;
    }
    .petic-preview-placeholder i {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 1rem;
        color: #bbb;
        opacity: 0.6;
    }
    .petic-preview-placeholder p {
        font-size: 13px;
        color: #999;
        margin: 0;
    }

    #previewIframe {
        width: 100%;
        height: 100%;
        border: none;
        display: none;
    }

    #previewImagem {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
        border-radius: 2px;
        box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12);
        display: none;
    }

    #previewAudio {
        width: 75%;
        max-width: 460px;
        display: none;
        accent-color: var(--blue);
    }

    #previewVideo {
        max-width: 92%;
        max-height: 88%;
        box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16);
        display: none;
    }

    .petic-download-panel {
        display: none;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 2rem;
    }
    .petic-download-panel i {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 1rem;
        color: #bbb;
        opacity: 0.6;
    }
    .petic-download-panel p.text-muted {
        font-size: 13px;
        color: #888 !important;
        margin-bottom: 1.25rem;
    }
    .petic-download-panel .btn-outline-primary {
        font-size: 13px;
        font-weight: 600;
        border-radius: 3px;
        padding: 8px 22px;
        border-color: var(--blue) !important;
        color: var(--blue) !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s, color 0.2s;
    }
    .petic-download-panel .btn-outline-primary:hover {
        background: var(--blue) !important;
        color: #fff !important;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       MODAL DE UPLOAD
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }
    .petic-modal-overlay.aberto { display: flex; }

    .petic-modal {
        background: #fff;
        border-radius: 2px;
        padding: 24px 24px 20px;
        width: 460px;
        max-width: 95vw;
        box-shadow: 0 16px 28px 0 rgba(0,0,0,0.22), 0 25px 55px 0 rgba(0,0,0,0.21);
    }

    .petic-modal-title {
        font-size: 18px;
        font-weight: 400;
        color: #333;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .petic-modal-title i { font-size: 16px; color: var(--blue); }

    .petic-modal .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #454545;
        margin-bottom: 4px;
        display: block;
    }

    .petic-modal .form-control,
    .petic-modal .form-select {
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 0;
        padding: 8px;
        height: 40px;
        color: #333;
        background: #fff;
        box-shadow: inset 0 1px 1px rgba(0,0,0,0.075);
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .petic-modal textarea.form-control { height: auto; }
    .petic-modal .form-control:focus,
    .petic-modal .form-select:focus {
        border-color: #66afe9;
        box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102,175,233,0.6);
        outline: 0;
    }
    .petic-modal .form-control::placeholder { color: #999; }

    .petic-modal .form-text {
        font-size: 12px;
        color: #999;
        margin-top: 3px;
    }

    .petic-modal .btn-secondary {
        font-size: 13px;
        font-weight: 400;
        background: #fff !important;
        border: 1px solid #ccc !important;
        color: #454545 !important;
        border-radius: 3px;
        padding: 6px 16px;
        text-transform: uppercase;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
        transition: background 0.2s;
    }
    .petic-modal .btn-secondary:hover { background: #f0f0f0 !important; }

    .petic-modal .btn-primary {
        font-size: 13px;
        font-weight: 400;
        background: var(--blue) !important;
        border-color: var(--blue) !important;
        color: #fff !important;
        border-radius: 3px;
        padding: 6px 16px;
        text-transform: uppercase;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
        transition: background 0.2s;
    }
    .petic-modal .btn-primary:hover {
        background: var(--blue-hover) !important;
        border-color: var(--blue-hover) !important;
    }

    .petic-modal .alert-danger {
        font-size: 13px;
        border-radius: 2px;
        border: 1px solid #ebccd1;
        background: #f2dede;
        color: #a94442;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       SPINNER
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.55s linear infinite;
        flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="petic-body">

    {# ── Cabeçalho ── #}
    <nav class="app-header navtop" style="position:relative; z-index:100;">
        <div class="petic-header-inner">

            {# Esquerda: NUP + cliente #}
            <div class="petic-header-left">
                <span class="petic-pasta-nup">{{ pastaInfoNup }}</span>
                {% if pastaInfoCliente %}
                    <span class="petic-pasta-cliente">{{ pastaInfoCliente }}</span>
                {% endif %}
            </div>

            {# Centro: brand #}
            <div class="petic-header-center">
                <a href="{{ path('expediente_index') }}" class="navtop-brand" target="_blank" rel="noopener">
                    <span class="navtop-brand-text"><span style="color:#E86C50">Jus</span>Prime</span>
                </a>
            </div>

            {# Direita: usuário #}
            <div class="petic-header-right">
                <div class="navtop-action dropdown">
                    <a href="#" class="navtop-avatar-btn dropdown-toggle"
                       data-bs-toggle="dropdown" aria-expanded="false"
                       aria-label="Menu do usuário">
                        <div class="navtop-user-info d-none d-md-flex">
                            <span class="navtop-username">{{ app.user.fullName }}</span>
                        </div>
                        <span class="navtop-avatar">
                            {{ app.user.fullName|slice(0,1)|upper }}
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <a href="{{ path('app_profile') }}" class="dropdown-item d-flex align-items-center gap-2" target="_blank">
                                <i class="bi bi-person"></i> Meu Perfil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-0"></li>
                        <li>
                            <a href="{{ path('app_logout') }}" class="dropdown-item d-flex align-items-center gap-2 text-danger">
                                <i class="bi bi-box-arrow-right"></i> Sair
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </nav>

    {# ── Conteúdo principal ── #}
    <main class="petic-main">
        {% block content %}{% endblock %}
    </main>

    {# Scripts #}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
