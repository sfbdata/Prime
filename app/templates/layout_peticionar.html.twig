<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'peticionar.titulo'|trans }}{% endblock %} | BlueJus</title>

    {# Favicon #}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/app.css">

    <style>
    /* ═══════════════════════════════════════════════════════════════════════
       DESIGN TOKENS
       ═══════════════════════════════════════════════════════════════════════ */
    :root {
        --h:    var(--header-height);
        --tl-w: 390px;

        /* Esta tela é a única que carrega Open Sans de verdade (Google Fonts, acima) — aqui a
           fonte nunca esteve quebrada, nem quando o resto do sistema caía no Arial. Redefinir o
           token do app.css localmente é o que mantém o peticionar em Open Sans. */
        --jp-font-sans: 'Open Sans', Arial, Verdana, sans-serif;

        /* Azul judicial — tom primário */
        --blue:      #0084AC;
        --blue-hover:#029BCA;

        /* Marca BlueJus */
        --coral: #E86C50;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       BASE
       ═══════════════════════════════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; }

    body.petic-body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: var(--bs-body-bg);
        font-family: 'Open Sans', Arial, Verdana, sans-serif;
        font-size: 14px;
        color: var(--bs-body-color);
    }

    /* ═══════════════════════════════════════════════════════════════════════
       CABEÇALHO — mantém o padrão BlueJus com fix do position:fixed
       ═══════════════════════════════════════════════════════════════════════ */
    nav.app-header.navtop {
        background: #0a6fa0 !important;
        position: relative !important;
        height: var(--h) !important;
        min-height: var(--h) !important;
        max-height: var(--h) !important;
    }

    .petic-navtop-usuario {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        min-width: 0;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .navtop-right { display: flex; align-items: center; gap: 14px; }

    .petic-navtop-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1px;
        min-width: 0;
    }
    .petic-navtop-nup {
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 420px;
        line-height: 1.2;
    }
    .petic-navtop-sub {
        font-size: 12px;
        font-weight: 400;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.9);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 420px;
        line-height: 1.2;
    }

    /* ── Botão de processo na navbar ── */
    .petic-processo-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 4px;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 10px;
        cursor: pointer;
        transition: background 0.15s;
        white-space: nowrap;
    }
    .petic-processo-btn:hover,
    .petic-processo-btn[aria-expanded="true"] {
        background: rgba(255,255,255,0.22);
    }
    .petic-processo-btn::after { display: none !important; }
    .petic-processo-btn .bi-chevron-down {
        font-size: 10px;
        opacity: 0.7;
        transition: transform 0.2s;
    }
    .petic-processo-btn[aria-expanded="true"] .bi-chevron-down {
        transform: rotate(180deg);
    }

    /* ── Card do dropdown do processo ── */
    .petic-processo-card {
        min-width: 420px;
        max-width: 520px;
        padding: 0 !important;
        border: none !important;
        border-radius: 3px !important;
        box-shadow: 0 4px 16px rgba(0,0,0,0.22) !important;
        overflow: hidden;
        margin-top: 6px !important;
    }

    .petic-proc-header {
        background: #0078AA;
        padding: 10px 14px 12px;
    }
    .petic-proc-numero {
        display: block;
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.2px;
        margin-bottom: 4px;
    }
    .petic-proc-partes {
        display: block;
        font-size: 0.72rem;
        color: rgba(255,255,255,0.82);
        line-height: 1.35;
        word-break: break-word;
        white-space: normal;
    }

    .petic-proc-body {
        background: var(--bs-body-bg);
        padding: 6px 0 4px;
    }
    .petic-proc-row {
        display: flex;
        align-items: baseline;
        padding: 5px 14px;
        gap: 10px;
        border-bottom: 1px solid var(--bs-border-color);
    }
    .petic-proc-row:last-child { border-bottom: none; }
    .petic-proc-label {
        flex-shrink: 0;
        width: 130px;
        text-align: right;
        font-size: 0.77rem;
        font-weight: 600;
        color: var(--bs-secondary-color);
    }
    .petic-proc-value {
        font-size: 0.77rem;
        color: var(--bs-body-color);
        word-break: break-word;
        white-space: normal;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       LAYOUT PRINCIPAL
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-main {
        height: calc(100vh - var(--h));
        overflow: hidden;
    }

    .petic-layout {
        display: grid;
        grid-template-columns: var(--tl-w) 1fr;
        height: 100%;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       PAINEL ESQUERDO: LISTA DE DOCUMENTOS (desenho 07, L46-75)
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-timeline {
        height: 100%;
        min-height: 0;
        overflow: hidden;
        background: #fff;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #dde5eb;
    }

    /* Cabeçalho da lista (L47) */
    .petic-timeline-header {
        padding: 14px 16px 10px;
        border-bottom: 1px solid #eef2f5;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-shrink: 0;
        background: #fff;
    }
    .petic-timeline-header-title {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .petic-timeline-header-title > i {
        font-size: 16px;
        color: #0a6fa0;
    }
    .petic-timeline-header-title > .petic-timeline-titulo {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #12242f;
    }
    .petic-timeline-header-title > .petic-contador {
        font-size: 11.5px;
        font-weight: 700;
        color: #5b7383;
        background: #eef2f5;
        border-radius: 4px;
        padding: 1px 7px;
    }

    /* Busca (L49) */
    .petic-search {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 34px;
        padding: 0 10px;
        border: 1px solid #d3dde4;
        border-radius: 4px;
    }
    .petic-search > .petic-search-icon {
        color: #5b7383;
    }
    .petic-search > .petic-search-input {
        flex: 1;
        min-width: 0;
        height: 100%;
        padding: 0;
        border: none;
        outline: none;
        box-shadow: none;
        background: transparent;
        font: inherit;
        font-size: 13.5px;
        color: var(--bs-body-color);
    }

    /* Área da lista (L51): padding 10/12, gap 6, sem trilho nem bolinhas */
    .petic-timeline-list {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        background: #fff;
        scrollbar-width: thin;
        scrollbar-color: var(--bs-border-color) transparent;
    }
    .petic-timeline-list::-webkit-scrollbar       { width: 4px; }
    .petic-timeline-list::-webkit-scrollbar-track  { background: transparent; }
    .petic-timeline-list::-webkit-scrollbar-thumb  { background: var(--bs-border-color); border-radius: 2px; }

    .petic-tl-inner {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* Separador de dia (L53) */
    .petic-tl-datesep {
        display: flex;
        justify-content: center;
        margin: 8px 0 2px;
    }
    .petic-tl-datesep span {
        font-size: 12px;
        font-weight: 700;
        color: #3c4a54;
        background: #e6ebef;
        padding: 3px 14px;
        border-radius: 4px;
        white-space: nowrap;
    }

    /* Cartão da linha (L54) */
    .petic-tl-row {
        cursor: pointer;
    }
    .petic-tl-card {
        background: #fff;
        border: 1px solid #e6edf2;
        border-radius: 4px;
        padding: 9px 10px;
        transition: background .15s;
    }
    .petic-tl-row:hover .petic-tl-card {
        background: #f2f8fc;
    }
    .petic-tl-row.ativo .petic-tl-card {
        background: #e5f1f7;
        border-color: #9fc3d8;
    }

    .petic-tl-card-top {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }
    .petic-tl-icon {
        flex-shrink: 0;
    }
    .petic-tl-titulo {
        color: #12242f;
        line-height: 1.4;
        word-break: break-word;
    }
    .petic-tl-row.ativo .petic-tl-titulo { color: #0a6fa0; }

    .petic-tl-card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 5px;
    }
    .petic-item-cat {
        font-size: 10px !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px !important;
        border-radius: 3px !important;
        padding: 2px 6px !important;
        text-transform: uppercase;
    }
    .petic-tl-time {
        font-size: 11px;
        color: #7b93a2;
        flex-shrink: 0;
    }

    /* Rodapé: "Adicionar peça" (L65-74) */
    .petic-timeline-footer {
        flex-shrink: 0;
        position: relative;
        padding: 10px 12px 12px;
        border-top: 1px solid #eef2f5;
        background: #fff;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       PAINEL DIREITO: VISUALIZAÇÃO (desenho 07, L76-100)
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-preview {
        height: 100%;
        min-height: 0;
        overflow: hidden;
        background: #eef2f5;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    /* Corpo (L90): rola, centraliza e tem padding 20 */
    .petic-preview-corpo {
        flex: 1;
        min-height: 0;
        overflow: auto;
        display: flex;
        justify-content: center;
        padding: 20px;
    }

    /* Nada selecionado (L78) */
    .petic-preview-placeholder {
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        color: #34505f;
        font-size: 15px;
        text-align: center;
        user-select: none;
    }
    .petic-preview-placeholder > i {
        font-size: 52px;
        color: #9aabb7;
    }

    /* PDF em moldura (L91) */
    #previewIframe {
        display: none;
        width: 100%;
        max-width: 980px;
        height: 100%;
        min-height: 600px;
        border: 1px solid #dde5eb;
        border-radius: 4px;
        background: #fff;
    }

    /* Imagem (L92 e JS L127) */
    #previewImagem {
        display: none;
        max-width: 100%;
        height: auto;
        align-self: flex-start;
        border: 1px solid #dde5eb;
        border-radius: 4px;
        background: #fff;
    }

    /* Formato sem visualização (L94) */
    .petic-download-panel {
        display: none;
        flex-direction: column;
        align-items: center;
        align-self: center;
        text-align: center;
        color: #34505f;
        font-size: 14px;
    }
    .petic-download-panel > i {
        font-size: 44px;
        color: #9aabb7;
    }
    .petic-download-panel > .petic-download-texto {
        margin-top: 10px;
    }
    .petic-download-panel > .petic-download-btn {
        margin-top: 10px;
        height: 34px;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        border: none;
        border-radius: 4px;
        background: #0a6fa0;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }
    .petic-download-panel > .petic-download-btn:hover,
    .petic-download-panel > .petic-download-btn:focus {
        color: #fff;
        text-decoration: none;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       MODAL DE UPLOAD
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }
    .petic-modal-overlay.aberto { display: flex; }

    .petic-modal {
        background: var(--bs-body-bg);
        border-radius: 2px;
        padding: 24px 24px 20px;
        width: 460px;
        max-width: 95vw;
        box-shadow: 0 16px 28px 0 rgba(0,0,0,0.22), 0 25px 55px 0 rgba(0,0,0,0.21);
    }

    .petic-modal-title {
        font-size: 18px;
        font-weight: 400;
        color: var(--bs-body-color);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .petic-modal-title i { font-size: 16px; color: var(--blue); }

    .petic-modal .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--bs-body-color);
        margin-bottom: 4px;
        display: block;
    }

    .petic-modal .form-control,
    .petic-modal .form-select {
        font-size: 14px;
        border: 1px solid var(--bs-border-color);
        border-radius: 0;
        padding: 8px;
        height: 40px;
        color: var(--bs-body-color);
        background: var(--bs-body-bg);
        box-shadow: inset 0 1px 1px rgba(0,0,0,0.075);
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .petic-modal textarea.form-control { height: auto; }
    .petic-modal .form-control:focus,
    .petic-modal .form-select:focus {
        border-color: #66afe9;
        box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102,175,233,0.6);
        outline: 0;
    }
    .petic-modal .form-control::placeholder { color: var(--bs-secondary-color); }

    .petic-modal .form-text {
        font-size: 12px;
        color: var(--bs-secondary-color);
        margin-top: 3px;
    }

    .petic-modal .btn-secondary {
        font-size: 13px;
        font-weight: 400;
        background: var(--bs-body-bg) !important;
        border: 1px solid var(--bs-border-color) !important;
        color: var(--bs-body-color) !important;
        border-radius: 3px;
        padding: 6px 16px;
        text-transform: uppercase;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
        transition: background 0.2s;
    }
    .petic-modal .btn-secondary:hover { background: var(--bs-border-color) !important; }

    .petic-modal .btn-primary {
        font-size: 13px;
        font-weight: 400;
        background: var(--blue) !important;
        border-color: var(--blue) !important;
        color: #fff !important;
        border-radius: 3px;
        padding: 6px 16px;
        text-transform: uppercase;
        box-shadow: rgba(0,0,0,0.117647) 0px 1px 6px, rgba(0,0,0,0.239216) 0px 1px 4px;
        transition: background 0.2s;
    }
    .petic-modal .btn-primary:hover {
        background: var(--blue-hover) !important;
        border-color: var(--blue-hover) !important;
    }

    .petic-modal .alert-danger {
        font-size: 13px;
        border-radius: 2px;
        border: 1px solid #ebccd1;
        background: #f2dede;
        color: #a94442;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       SPINNER
       ═══════════════════════════════════════════════════════════════════════ */
    .petic-spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.55s linear infinite;
        flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="petic-body">
    {% include '_recurso_faixa_master.html.twig' %}

    {# ── Cabeçalho ── #}
    <nav class="app-header navtop">

        {# ── Barra principal azul ── #}
        <div class="navtop-inner">

            <div class="navtop-left">
                <a href="{{ path('expediente_index') }}" class="navtop-brand">
                    <img src="/images/logo/bluejus-white-transparent-nav.png" alt="BlueJus" class="navtop-brand-logo" style="height:32px;">
                </a>
                <span class="navtop-page-sep">|</span>
                <div class="petic-navtop-info">
                    <span class="petic-navtop-nup">{{ 'peticionar.cabecalho.numero_pasta'|trans({nup: pastaInfoNup}) }}</span>
                    {% set sub = [] %}
                    {% if pastaInfoCliente %}{% set sub = sub|merge(['peticionar.cabecalho.cliente'|trans({cliente: pastaInfoCliente})]) %}{% endif %}
                    {% if pasta.nomeAcao %}{% set sub = sub|merge([pasta.nomeAcao]) %}{% endif %}
                    {% if sub %}
                        <span class="petic-navtop-sub">{{ sub|join(' · ') }}</span>
                    {% endif %}
                </div>

                {% if pasta.processoPrincipal %}
                    {% set proc = pasta.processoPrincipal %}
                    <span class="navtop-page-sep">|</span>
                    <div class="dropdown">
                        <button class="petic-processo-btn dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-journal-text"></i>
                            {{ proc.siglaTribunal ? proc.siglaTribunal ~ ' ' : '' }}{{ proc.numeroProcesso }}
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu petic-processo-card">

                            <div class="petic-proc-header">
                                <span class="petic-proc-numero">
                                    <i class="bi bi-journal-text me-1"></i>
                                    {{ proc.siglaTribunal ? proc.siglaTribunal ~ ' ' : '' }}{{ proc.numeroProcesso }}
                                </span>
                                {% set poloAtivo   = proc.partes|filter(p => 'ATIVO'   in p.tipo) %}
                                {% set poloPassivo = proc.partes|filter(p => 'PASSIVO' in p.tipo) %}
                                {% if poloAtivo|length or poloPassivo|length %}
                                    <span class="petic-proc-partes">
                                        {% if poloAtivo|length %}{{ poloAtivo|first.nome }}{% endif %}
                                        {% if poloAtivo|length and poloPassivo|length %} {{ 'peticionar.processo.contra'|trans }} {% endif %}
                                        {% if poloPassivo|length %}{{ poloPassivo|first.nome }}{% endif %}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="petic-proc-body">
                                {% if proc.classeProcessual %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">{{ 'peticionar.processo.classe'|trans }}</span>
                                        <span class="petic-proc-value">{{ proc.classeProcessual }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.assuntoProcessual %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">{{ 'peticionar.processo.assunto'|trans }}</span>
                                        <span class="petic-proc-value">{{ proc.assuntoProcessual }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.orgaoJulgador %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">{{ 'peticionar.processo.jurisdicao'|trans }}</span>
                                        <span class="petic-proc-value">{{ proc.orgaoJulgador }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.dataDistribuicao %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">{{ 'peticionar.processo.distribuicao'|trans }}</span>
                                        <span class="petic-proc-value">{{ proc.dataDistribuicao|data }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.instancia %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">{{ 'peticionar.processo.instancia'|trans }}</span>
                                        <span class="petic-proc-value">{{ proc.instancia }}</span>
                                    </div>
                                {% endif %}
                                {% if proc.situacaoProcesso %}
                                    <div class="petic-proc-row">
                                        <span class="petic-proc-label">{{ 'peticionar.processo.situacao'|trans }}</span>
                                        <span class="petic-proc-value">{{ proc.situacaoProcesso }}</span>
                                    </div>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="navtop-right">
                <a href="{{ path('pasta_show', {id: pasta.id}) }}"
                   class="petic-voltar-pasta"
                   title="{{ 'pasta_peticionar.lista.voltar_dica'|trans }}"><i class="bi bi-arrow-left"></i>{{ 'pasta_peticionar.lista.voltar'|trans }}</a>
                <span class="petic-navtop-usuario">{{ app.user.fullName }}</span>
            </div>{# /navtop-right #}
        </div>{# /navtop-inner #}

    </nav>

    {# ── Conteúdo principal ── #}
    <main class="petic-main">
        {% block content %}{% endblock %}
    </main>

    {# Scripts #}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>

    <script src="{{ asset('js/tinymce/tinymce.min.js') }}"></script>
    <script src="{{ asset('js/bj-traducao.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
