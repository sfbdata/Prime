{% extends 'base.html.twig' %}

{% block title %}Conectar meu Drive{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0"><i class="bi bi-google me-2"></i>Conectar meu Drive</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-hdd-network me-2"></i>Sincronização com o Google Drive</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">
                            Conecte a conta do Google do escritório para sincronizar as pastas e documentos
                            com o seu Google Drive. Só administradores do escritório podem alterar esta conexão.
                        </p>

                        {% if conexao is not null and conexao.conectada %}
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th style="width:35%"><i class="bi bi-person-circle me-1"></i>Conta conectada</th>
                                        <td>{{ conexao.contaEmail ?? 'conta Google' }}</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-toggle-on me-1"></i>Status</th>
                                        <td>
                                            {% if conexao.ativa %}
                                                <span class="badge bg-success">Ativa</span>
                                            {% else %}
                                                <span class="badge bg-warning text-dark">Falta a pasta-raiz</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-folder me-1"></i>Pasta-raiz</th>
                                        <td>{{ conexao.rootFolderId ?? '—' }}</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-calendar-event me-1"></i>Conectado em</th>
                                        <td>{{ conexao.conectadoEm|date('d/m/Y H:i') }}</td>
                                    </tr>
                                </tbody>
                            </table>

                            <hr>

                            <form method="post" action="{{ path('app_sync_drive_pasta_raiz') }}" class="mb-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_pasta_raiz') }}">
                                <label for="pasta_raiz" class="form-label">Pasta-raiz do acervo no Drive (ID ou link)</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="pasta_raiz" name="pasta_raiz"
                                           placeholder="https://drive.google.com/drive/folders/…"
                                           value="{{ conexao.rootFolderId ?? '' }}">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="bi bi-check2 me-1"></i>Salvar pasta
                                    </button>
                                </div>
                                <small class="form-text text-muted">
                                    Cole o link da pasta do Drive que é a raiz do acervo deste escritório.
                                </small>
                            </form>

                            <div class="d-flex gap-2">
                                <a href="{{ path('app_sync_drive_iniciar') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-repeat me-1"></i>Reconectar conta
                                </a>
                                <form method="post" action="{{ path('app_sync_drive_desconectar') }}"
                                      onsubmit="return confirm('Desconectar o Drive deste escritório? A sincronização para até reconectar.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_desconectar') }}">
                                    <button class="btn btn-outline-danger" type="submit">
                                        <i class="bi bi-plug me-1"></i>Desconectar
                                    </button>
                                </form>
                            </div>
                        {% else %}
                            <a href="{{ path('app_sync_drive_iniciar') }}" class="btn btn-primary btn-lg">
                                <i class="bi bi-google me-2"></i>Conectar conta Google
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
