{% extends 'base.html.twig' %}

{% block title %}{{ 'sync.drive.titulo'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0"><i class="bi bi-google me-2"></i>{{ 'sync.drive.titulo'|trans }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-hdd-network me-2"></i>{{ 'sync.drive.cartao'|trans }}</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">
                            {{ 'sync.drive.explicacao'|trans }}
                        </p>

                        {% if conexao is not null and conexao.conectada %}
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th style="width:35%"><i class="bi bi-person-circle me-1"></i>{{ 'sync.drive.conta_conectada'|trans }}</th>
                                        <td>{{ conexao.contaEmail ?? 'sync.drive.conta_padrao'|trans }}</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-toggle-on me-1"></i>{{ 'sync.drive.status'|trans }}</th>
                                        <td>
                                            {% if conexao.ativa %}
                                                <span class="badge bg-success">{{ 'sync.drive.ativa'|trans }}</span>
                                            {% else %}
                                                <span class="badge bg-warning text-dark">{{ 'sync.drive.falta_pasta_raiz'|trans }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-folder me-1"></i>{{ 'sync.drive.pasta_raiz'|trans }}</th>
                                        <td>{% if (conexao.rootFolderId ?? null) is not null %}{{ conexao.rootFolderId }}{% else %}<span class="text-muted small">{{ 'sync.drive.nao_informado'|trans }}</span>{% endif %}</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-calendar-event me-1"></i>{{ 'sync.drive.conectado_em'|trans }}</th>
                                        <td>{{ conexao.conectadoEm|data_hora }}</td>
                                    </tr>
                                </tbody>
                            </table>

                            <hr>

                            <form method="post" action="{{ path('app_sync_drive_pasta_raiz') }}" class="mb-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_pasta_raiz') }}">
                                <label for="pasta_raiz" class="form-label">{{ 'sync.drive.pasta_raiz_rotulo'|trans }}</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="pasta_raiz" name="pasta_raiz"
                                           placeholder="https://drive.google.com/drive/folders/…"
                                           value="{{ conexao.rootFolderId ?? '' }}">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="bi bi-check2 me-1"></i>{{ 'sync.drive.salvar_pasta'|trans }}
                                    </button>
                                </div>
                                <small class="form-text text-muted">
                                    {{ 'sync.drive.pasta_raiz_ajuda'|trans }}
                                </small>
                            </form>

                            <div class="d-flex gap-2">
                                <a href="{{ path('app_sync_drive_iniciar') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-repeat me-1"></i>{{ 'sync.drive.reconectar'|trans }}
                                </a>
                                <form method="post" action="{{ path('app_sync_drive_desconectar') }}"
                                      onsubmit="return confirm('{{ 'sync.drive.desconectar_confirmar'|trans|e('js') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_desconectar') }}">
                                    <button class="btn btn-outline-danger" type="submit">
                                        <i class="bi bi-plug me-1"></i>{{ 'sync.drive.desconectar'|trans }}
                                    </button>
                                </form>
                            </div>
                        {% else %}
                            <a href="{{ path('app_sync_drive_iniciar') }}" class="btn btn-primary btn-lg">
                                <i class="bi bi-google me-2"></i>{{ 'sync.drive.conectar'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>

                {% if conexao is not null and conexao.ativa %}
                    <div class="card card-outline card-primary" id="reconhecimento-drive">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-search me-2"></i>{{ 'sync.drive.reconhecimento.cartao'|trans }}</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">{{ 'sync.drive.reconhecimento.explicacao'|trans }}</p>

                            {% if reconhecimentos is empty %}
                                <p class="text-muted small mb-0">{{ 'sync.drive.reconhecimento.vazio'|trans }}</p>
                            {% else %}
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>{{ 'sync.drive.reconhecimento.nome_no_drive'|trans }}</th>
                                            <th>{{ 'sync.drive.reconhecimento.ligar_a'|trans }}</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in reconhecimentos %}
                                            <tr data-reconhecimento="{{ item.id }}">
                                                <td><i class="bi bi-folder me-1"></i>{{ item.nomeNoDrive }}</td>
                                                <td>
                                                    <form method="post" action="{{ path('app_sync_drive_reconhecimento_ligar', {id: item.id}) }}" class="d-flex gap-2">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_reconhecimento_' ~ item.id) }}">
                                                        {% if item.candidatas is not empty %}
                                                            <select name="pasta_id" class="form-select form-select-sm" aria-label="{{ 'sync.drive.reconhecimento.ligar_a'|trans }}">
                                                                {% for candidata in item.candidatas %}
                                                                    <option value="{{ candidata.id }}">{{ 'sync.drive.reconhecimento.candidata'|trans({numero: candidata.nup, cliente: candidata.cliente}) }}</option>
                                                                {% endfor %}
                                                            </select>
                                                        {% else %}
                                                            <input type="text" name="nup" class="form-control form-control-sm"
                                                                   placeholder="{{ 'sync.drive.reconhecimento.numero_da_pasta'|trans }}"
                                                                   aria-label="{{ 'sync.drive.reconhecimento.numero_da_pasta'|trans }}">
                                                        {% endif %}
                                                        <button class="btn btn-sm btn-primary text-nowrap" type="submit">
                                                            <i class="bi bi-link-45deg me-1"></i>{{ 'sync.drive.reconhecimento.ligar'|trans }}
                                                        </button>
                                                    </form>
                                                </td>
                                                <td class="text-end">
                                                    <form method="post" action="{{ path('app_sync_drive_reconhecimento_ignorar', {id: item.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_reconhecimento_' ~ item.id) }}">
                                                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                                                            {{ 'sync.drive.reconhecimento.ignorar'|trans }}
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}

                            <form method="post" action="{{ path('app_sync_drive_reconhecer') }}" class="mt-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('sync_drive_reconhecer') }}">
                                <button class="btn btn-outline-primary" type="submit">
                                    <i class="bi bi-arrow-repeat me-1"></i>{{ 'sync.drive.reconhecimento.reconhecer_de_novo'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
