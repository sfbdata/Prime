{#
   Checklist de documentação — faixa de largura total no topo do explorador da aba Documentos
   (desenho 02 - EXPEDIENTES 1.2.3, dc L2079-2179; `pasta-dentro2.jpg`: visível também dentro
   das subpastas e durante a busca).

   Cartão, de cima para baixo, como no desenho:
     cabeçalho (ícone, título, selo "N/M itens", barra, Sugerir documentos, Modelos, ✎, +,
                interruptor "Ativo" — L2093)
     confirmação de desativar (L2095-2110: motivo obrigatório entre os quatro; só com o
                checklist ativo, nasce escondida)
     ATIVO:      corpo: painel de documentos sugeridos (L2112) → modelos → faixa de adicionar
                 (L2166) → itens em grade (L2172: caixa de 19px, texto riscado quando
                 concluído, selo "sem anexo").
     DESATIVADO: faixa "Checklist desativado · motivo · X em dd/mm/aaaa" + Reativar
                 (L2112-2117). Sem corpo e sem as ações do cabeçalho, como no desenho; os itens
                 continuam no banco e voltam ao reativar.

   Os `id` são contrato com `public/js/pasta-checklist.js` (marcar, editar, excluir, reordenar,
   modelos, selo, barra), com `pasta-documentos-sugeridos.js` e com os testes. Classes `pex-ck-*`
   são de estilo (`public/css/pasta-checklist.css`).

   O que o desenho tem e NÃO está aqui, de propósito:
     - o ✦ e o rótulo "BlueJus IA" (também no aviso de desativar e no "Atualizar o checklist"):
       as sugestões são regras sobre um catálogo fixo (S-4);
     (a cobrança automática do desenho, com o selo "cobrado Nx", entrou em 19/10: a D-DOC-S6 "adiar"
     foi superada; spec `docs/specs/pasta-cobranca-do-checklist.md`. O lembrete de 30 dias é da rotina
     diária, não da IA: por isso o texto diz "o sistema", mantendo a S-4.)

   Incluído por `pasta/_documentos_explorador.html.twig`; usa `pasta`, `checklistItens`,
   `totalChecklist`, `concluidosChecklist` e `conferenciaChecklist` do contexto.
#}
{% set pctChecklist = totalChecklist > 0 ? (concluidosChecklist / totalChecklist * 100)|round : 0 %}
{% set checklistCompleto = totalChecklist > 0 and concluidosChecklist == totalChecklist %}
{% set sugestao = documentos_sugeridos(pasta, checklistItens|default([])) %}
{% set conferencia = conferenciaChecklist|default(null) %}
{% set selosDeCobranca = cobrancas_do_checklist(pasta) %}
{% set checklistAtivo = pasta.checklistAtivo %}
{% set pendentesChecklist = totalChecklist - concluidosChecklist %}
{# Pasta excluída (lápide) é somente-leitura: o POST seria recusado pelo PastaSomenteLeituraListener,
   então o interruptor, a confirmação e o Reativar nem aparecem — o estado só é mostrado. #}
{% set podeAlterarEstado = not pasta.estaExcluida %}
<div class="pex-ck{{ checklistAtivo ? '' : ' pex-ck--desativado' }}" id="pexChecklist"
     data-pasta-id="{{ pasta.id }}"
     data-csrf-pasta="{{ csrf_token('checklist_pasta_' ~ pasta.id) }}"
     data-url-estado="{{ path('pasta_checklist_estado', {id: pasta.id}) }}"
     data-checklist-ativo="{{ checklistAtivo ? '1' : '0' }}">
    <div class="pex-ck-cab">
        <i class="bi bi-check2-square pex-ck-ico" aria-hidden="true"></i>
        <h6 class="pex-ck-titulo">{{ 'pasta_documentos.checklist.titulo'|trans }}</h6>
        <span id="checklistBadge" class="pex-ck-selo {{ checklistCompleto ? 'completo' : 'incompleto' }}">{{ 'pasta_documentos.checklist.selo'|trans({concluidos: concluidosChecklist ~ '', total: totalChecklist ~ ''}) }}</span>
        {# A barra diz de relance o que a contagem só diz depois de lida. #}
        <div class="pex-ck-barra" role="progressbar"
             aria-label="{{ 'pasta_documentos.checklist.barra'|trans }}"
             aria-valuenow="{{ concluidosChecklist }}" aria-valuemin="0" aria-valuemax="{{ totalChecklist }}">
            <div id="checklistBarra" class="pex-ck-barra-fill {{ checklistCompleto ? 'completo' : 'incompleto' }}" style="width: {{ pctChecklist }}%"></div>
        </div>
        <span class="pex-ck-espaco"></span>
        {% if checklistAtivo %}
        {% if sugestao is not null %}
            {# Rótulo neutro (S-4): o desenho tem ✦ aqui, mas o que roda é catálogo + regras. #}
            <button type="button" id="btnDocumentosSugeridos" class="pex-ck-sugerir"
                    aria-expanded="false" aria-controls="documentosSugeridos"
                    title="{{ 'pasta_documentos.checklist.sugerir_dica'|trans }}">
                <i class="bi bi-list-check" aria-hidden="true"></i>{{ 'pasta_documentos.checklist.sugerir'|trans }}
            </button>
        {% endif %}
        {# C6-DOC-01: escrita só para quem a teria (mesma flag do explorador: EDIT e fora da lápide);
           o pasta-checklist.js ainda as remove como segunda barreira. #}
        {% if explorador.podeEditar ?? false %}
        <button type="button" id="btnChecklistModelos" class="pex-ck-acao" title="{{ 'pasta_documentos.checklist.modelos_dica'|trans }}"
                aria-expanded="false" aria-controls="checklistModelosPainel">
            <i class="bi bi-bookmarks"></i>
        </button>
        <button type="button" id="btnChecklistEditar" class="pex-ck-acao" title="{{ 'pasta_documentos.checklist.editar_dica'|trans }}"
                aria-pressed="false">
            <i class="bi bi-pencil"></i>
        </button>
        <button type="button" id="btnChecklistAdicionar" class="pex-ck-acao" title="{{ 'pasta_documentos.checklist.adicionar_item'|trans }}"
                aria-expanded="false" aria-controls="checklistFormAdicionar">
            <i class="bi bi-plus-lg"></i>
        </button>
        {% endif %}
        {% endif %}
        {# Interruptor do desenho (L2093): "Ativo" verde / "Desativado" cinza. Ligado, abre a
           confirmação com o motivo; desligado, reativa direto (ckReativar, L4084). #}
        {% if podeAlterarEstado %}
        <button type="button" id="btnChecklistEstado" class="pex-ck-interruptor"
                role="switch" aria-checked="{{ checklistAtivo ? 'true' : 'false' }}"
                {% if checklistAtivo %}aria-expanded="false" aria-controls="checklistDesativarPainel"{% endif %}
                title="{{ (checklistAtivo ? 'pasta_documentos.checklist.desativar_dica' : 'pasta_documentos.checklist.reativar_dica')|trans }}">
            <span class="pex-ck-interruptor-txt">{{ (checklistAtivo ? 'pasta_documentos.checklist.ativo' : 'pasta_documentos.checklist.desativado')|trans }}</span>
            <span class="pex-ck-interruptor-trilho" aria-hidden="true"><span class="pex-ck-interruptor-bola"></span></span>
        </button>
        {% endif %}
    </div>
    {% if checklistAtivo %}
    {% if podeAlterarEstado %}
    {# Confirmação de desativar (L2095-2110). O motivo é obrigatório: "Desativar" só habilita
       depois de escolher um dos quatro. O texto do desenho é da "BlueJus IA" e promete cobrança
       pausada; aqui diz só o que de fato para (S-4, S-6). #}
    <div id="checklistDesativarPainel" class="pex-ck-desativar" hidden>
        <div class="pex-ck-desativar-aviso">
            <span class="pex-ck-desativar-ico" aria-hidden="true"><i class="bi bi-info-circle"></i></span>
            <p class="pex-ck-desativar-texto">
                {{ 'pasta_documentos.checklist.desativar_texto'|trans }}
                {% if pendentesChecklist > 0 %}{{ (pendentesChecklist == 1 ? 'pasta_documentos.checklist.pendentes_um' : 'pasta_documentos.checklist.pendentes_varios')|trans({total: pendentesChecklist ~ ''}) }}{% endif %}
                {{ 'pasta_documentos.checklist.desativar_preferir'|trans }}
            </p>
        </div>
        <div class="pex-ck-desativar-rotulo" id="checklistDesativarRotulo">{{ 'pasta_documentos.checklist.motivo'|trans }}</div>
        <div class="pex-ck-desativar-motivos" role="group" aria-labelledby="checklistDesativarRotulo">
            {% for motivo in enum_cases('App\\Pasta\\Entity\\MotivoDesativacaoChecklist') %}
                <button type="button" class="pex-ck-motivo" data-motivo="{{ motivo.value }}" aria-pressed="false">{{ motivo.rotulo }}</button>
            {% endfor %}
        </div>
        <div class="pex-ck-desativar-acoes">
            {% if sugestao is not null %}
                <button type="button" id="btnChecklistAtualizarEmVez" class="pex-ck-desativar-atualizar">{{ 'pasta_documentos.checklist.atualizar'|trans }}</button>
            {% endif %}
            <button type="button" id="btnChecklistManterAtivo" class="pex-ck-desativar-manter">{{ 'pasta_documentos.checklist.manter_ativo'|trans }}</button>
            <button type="button" id="btnChecklistDesativar" class="pex-ck-desativar-confirmar" disabled>{{ 'pasta_documentos.checklist.desativar'|trans }}</button>
        </div>
        <div id="checklistEstadoErro" class="pex-ck-desativar-erro" role="alert" hidden></div>
    </div>
    {% endif %}
    <div class="pex-ck-corpo">
        {# Painel de sugestões DENTRO do cartão do checklist, logo abaixo do cabeçalho (dc L2112). #}
        {{ include('pasta/_documentos_sugeridos.html.twig') }}

        {# ── Modelos de checklist ──────────────────────────
           Painel INLINE, não modal: o painel da aba é animado, e ancestral com
           `transform` prende modal abaixo do backdrop (foi o defeito de 28/08
           nesta mesma tela). Inline também deixa a lista da pasta visível
           enquanto se escolhe o modelo. A lista é carregada por AJAX na
           primeira abertura. #}
        <div id="checklistModelosPainel" class="pex-ck-modelos d-none"
             data-url-listar="{{ path('pasta_checklist_modelo_listar', {id: pasta.id}) }}"
             data-url-salvar="{{ path('pasta_checklist_modelo_salvar', {id: pasta.id}) }}"
             data-csrf-pasta="{{ csrf_token('checklist_modelo_pasta_' ~ pasta.id) }}">
            <div class="pex-ck-modelos-cab">
                <i class="bi bi-bookmarks"></i>
                <span>{{ 'pasta_documentos.checklist.modelos_titulo'|trans }}</span>
                <button type="button" id="btnChecklistModelosFechar" class="pex-ck-modelos-fechar" title="{{ 'pasta_documentos.fechar'|trans }}">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div id="checklistModelosCarregando" class="pex-ck-modelos-nota d-none">{{ 'pasta_documentos.checklist.carregando'|trans }}</div>
            <div id="checklistModelosVazio" class="pex-ck-modelos-nota d-none">
                {{ 'pasta_documentos.checklist.modelos_vazio'|trans }}
            </div>
            <ul id="checklistModelosLista" class="list-unstyled mb-0"></ul>

            <div class="pex-ck-modelos-salvar">
                <label class="pex-ck-modelos-rotulo" for="checklistModeloNome">{{ 'pasta_documentos.checklist.salvar_modelo_rotulo'|trans }}</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="checklistModeloNome" class="form-control" placeholder="{{ 'pasta_documentos.checklist.nome_modelo'|trans }}" maxlength="120">
                    <button type="button" id="btnChecklistModeloSalvar" class="btn btn-primary" title="{{ 'pasta_documentos.checklist.salvar_modelo'|trans }}">
                        <i class="bi bi-bookmark-plus"></i>
                    </button>
                </div>
            </div>

            <div id="checklistModelosErro" class="text-danger small mt-2 d-none"></div>
            <div id="checklistModelosAviso" class="text-success small mt-2 d-none"></div>
        </div>

        {# Faixa de adicionar (dc L2166-2170): Enter confirma, Esc cancela. #}
        <div id="checklistFormAdicionar" class="pex-ck-adicionar d-none">
            <div class="pex-ck-adicionar-linha">
                <input type="text" id="checklistNovoTitulo" class="pex-ck-adicionar-campo"
                       placeholder="{{ 'pasta_documentos.checklist.novo_placeholder'|trans }}"
                       aria-label="{{ 'pasta_documentos.checklist.novo_rotulo'|trans }}" maxlength="255">
                <button type="button" id="btnChecklistSalvarNovo" class="pex-ck-adicionar-btn">{{ 'pasta_documentos.checklist.adicionar'|trans }}</button>
            </div>
            <div id="checklistErroNovo" class="pex-ck-adicionar-erro d-none" role="alert"></div>
        </div>

        <ul id="checklistLista" class="pex-ck-lista list-unstyled mb-0">
            {% for item in checklistItens %}
                {% set temAnexo = conferencia is null or conferencia.temAnexo(item.id) %}
                <li class="checklist-item pex-ck-item{{ item.concluido ? ' concluido' : '' }}"
                    data-item-id="{{ item.id }}"
                    data-csrf-item="{{ csrf_token('checklist_item_' ~ item.id) }}"
                    data-concluido="{{ item.concluido ? '1' : '0' }}"
                    data-tem-anexo="{{ temAnexo ? '1' : '0' }}">
                    <span class="checklist-drag-handle pex-ck-alca d-none" title="{{ 'pasta_documentos.checklist.arrastar'|trans }}" aria-hidden="true">
                        <i class="bi bi-grip-vertical"></i>
                    </span>
                    <button type="button" class="pex-ck-linha js-checklist-toggle"
                            aria-pressed="{{ item.concluido ? 'true' : 'false' }}"
                            title="{{ (item.concluido ? 'pasta_documentos.checklist.marcar_pendente' : 'pasta_documentos.checklist.marcar_concluido')|trans }}">
                        <span class="pex-ck-caixa" aria-hidden="true"><i class="bi bi-check2"></i></span>
                        <span class="checklist-item-titulo pex-ck-texto">{{ item.titulo }}</span>
                        {% if not temAnexo %}
                            {# Selo do desenho (L2175, 6337): só aparece com o item MARCADO. A
                               regra é de nome (ConferenciaDeAnexosDoChecklist) — o title diz. #}
                            <span class="pex-ck-sem-anexo"{{ item.concluido ? '' : ' hidden' }}
                                  title="{{ 'pasta_documentos.checklist.sem_anexo_dica'|trans }}">
                                <i class="bi bi-megaphone-fill" aria-hidden="true"></i>{{ 'pasta_documentos.checklist.sem_anexo'|trans }}
                            </span>
                        {% endif %}
                        {% set selo = selosDeCobranca[item.id] ?? null %}
                        {% if selo and not item.concluido %}
                            {# Selo do desenho (dc 2311, 6745-6749): âmbar, vermelho a partir de 3 cobranças. #}
                            <span class="pex-ck-cobrado{{ selo.vermelho ? ' pex-ck-cobrado--vermelho' : '' }}" title="{{ selo.dica }}">
                                <i class="bi bi-megaphone-fill" aria-hidden="true"></i>{{ selo.texto }}
                            </span>
                        {% endif %}
                    </button>
                    <input type="text" class="checklist-item-input pex-ck-renomear d-none"
                           value="{{ item.titulo }}" maxlength="255" aria-label="{{ 'pasta_documentos.checklist.renomear_rotulo'|trans }}">
                    <button type="button" class="pex-ck-remover js-checklist-excluir d-none" title="{{ 'pasta_documentos.checklist.remover_item'|trans }}" aria-label="{{ 'pasta_documentos.checklist.remover_item'|trans }}">
                        <i class="bi bi-trash3"></i>
                    </button>
                </li>
            {% else %}
                <li id="checklistVazio" class="pex-ck-vazio">
                    {{ 'pasta_documentos.checklist.vazio_antes'|trans }} <i class="bi bi-plus-lg"></i> {{ 'pasta_documentos.checklist.vazio_depois'|trans }}
                </li>
            {% endfor %}
        </ul>
    </div>
    {% else %}
    {# Desativado (L2112-2117): quem, quando e por quê, e o Reativar. #}
    {% set desativadoPor = pasta.checklistDesativadoPor %}
    <div id="checklistDesativado" class="pex-ck-desativado">
        <i class="bi bi-pause-circle pex-ck-desativado-ico" aria-hidden="true"></i>
        <div class="pex-ck-desativado-texto">
            <b>{{ 'pasta_documentos.checklist.desativado_titulo'|trans }}</b>
            {%- if pasta.checklistMotivo %} · {{ pasta.checklistMotivo.rotulo }}{% endif %}
            · {{ desativadoPor ? (desativadoPor.fullName ?: desativadoPor.email) : 'pasta_documentos.checklist.usuario_removido'|trans }}
            {%- if pasta.checklistDesativadoEm %} {{ 'pasta_documentos.checklist.desativado_em'|trans({data: pasta.checklistDesativadoEm|data}) }}{% endif %}
            <div class="pex-ck-desativado-nota">{{ 'pasta_documentos.checklist.desativado_nota'|trans }}</div>
        </div>
        {% if podeAlterarEstado %}
        <button type="button" id="btnChecklistReativar" class="pex-ck-reativar">
            <i class="bi bi-play-circle" aria-hidden="true"></i>{{ 'pasta_documentos.checklist.reativar'|trans }}
        </button>
        <div id="checklistEstadoErro" class="pex-ck-desativar-erro" role="alert" hidden></div>
        {% endif %}
    </div>
    {% endif %}
    <link rel="stylesheet" href="{{ asset('css/pasta-checklist.css') }}">
</div>
