{# ============================================================================
   Timeline inteligente da pasta (L18 da Trilha B, item 14 do plano).
   Desenho aprovado: docs/design/claude-design-2026-10-05 (1)/bluejus-central.js
   (`tlRender`/`tlCard`, L.3345-3452) — painel à direita, cabeçalho em gradiente
   180deg #0d80a3→#0a6c90, busca, chips por tipo, período, pessoa, agrupado por dia.

   POR REGRAS, sem IA (decisão D-IA): sem ✦, sem "BlueJus IA", sem a "IA encontrou".
   O que o desenho mostra e não tem fonte no sistema NÃO é renderizado: mensagens e
   ligações do chat, detecção de tarefa/telefone/e-mail/CNJ com
   "Criar tarefa"/"Validar" (o estado da sugestão não existe no servidor).

   "Ver alteração" (PAS-045 / PAS-045b): o registro de Dados da pasta e as observações de
   Detalhes e do Financeiro guardam o texto INTEIRO de antes da última edição
   (`conteudo_anterior`); o cartão mostra Antes e Depois. A do Financeiro só chega a quem
   vê o financeiro.

   Notificações entram (PAS-047i): só as DO USUÁRIO LOGADO ligadas a esta pasta (pela meta
   ou pelo link), pendentes enquanto não lidas — chip "Notificações", `bi-bell`.

   "Enquanto você estava fora" (PAS-043): a abertura do painel é guardada POR USUÁRIO no
   servidor (`pasta_timeline_visita`, POST com CSRF em `data-visita-url`); o aviso conta o
   que outras pessoas fizeram depois da abertura anterior. Sem o 🧠 do desenho, pela mesma
   decisão D-IA que tirou o ✦.

   O esqueleto é estático; a lista vem de `pasta_timeline` (JSON) e é desenhada pelo
   pasta-timeline.js SÓ com textContent — nenhum texto de usuário passa por HTML.

   Contexto: `pasta`.
   ============================================================================ #}
{% set tlCliente = pasta.clientePrincipal ? pasta.clientePrincipal.nomeExibicao : pasta.nomeCliente %}
{% set tlProc = pasta.processoPrincipal %}
{# Textos do pasta-timeline.js: o show inclui este parcial sempre, antes do script. #}
{{ catalogo_js('pasta_resp.js.timeline') }}
<div class="ps-tl-overlay" id="psTimelineOverlay" tabindex="-1"></div>

<aside class="ps-tl" id="psTimeline" role="dialog" aria-modal="true"
       aria-labelledby="psTimelineTitulo" aria-hidden="true"
       data-url="{{ path('pasta_timeline', {id: pasta.id}) }}"
       data-visita-url="{{ path('pasta_timeline_visita', {id: pasta.id}) }}"
       data-visita-token="{{ csrf_token('pasta_timeline_visita_' ~ pasta.id) }}">
    <div class="ps-tl-cab">
        <i class="bi bi-activity ps-tl-cab-icone" aria-hidden="true"></i>
        <div class="ps-tl-cab-texto">
            <h2 id="psTimelineTitulo">{{ 'pasta_resp.timeline.titulo'|trans }}</h2>
            <div class="ps-tl-cab-sub">
                {{- 'pasta_resp.timeline.subtitulo'|trans({pasta: pasta.nup ~ ''}) -}}
                {%- if tlCliente %} · {{ tlCliente }}{% endif -%}
                {%- if tlProc %} · {{ tlProc.numeroProcesso|numero_cnj }}{% endif -%}
            </div>
        </div>
        <button type="button" class="ps-tl-fechar" aria-label="{{ 'pasta_resp.fechar'|trans }}" title="{{ 'pasta_resp.timeline.fechar_dica'|trans }}">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="ps-tl-barra">
        <input type="search" class="ps-tl-busca" data-tl-busca
               placeholder="{{ 'pasta_resp.timeline.busca'|trans }}"
               aria-label="{{ 'pasta_resp.timeline.busca_rotulo'|trans }}" maxlength="200" autocomplete="off">
        <div class="ps-tl-chips" data-tl-chips role="group" aria-label="{{ 'pasta_resp.timeline.filtrar_tipo'|trans }}"></div>
        <div class="ps-tl-linha">
            <select class="ps-tl-select" data-tl-periodo aria-label="{{ 'pasta_resp.timeline.periodo'|trans }}">
                <option value="tudo">{{ 'pasta_resp.timeline.periodo_tudo'|trans }}</option>
                <option value="hoje">{{ 'pasta_resp.timeline.hoje'|trans }}</option>
                <option value="ontem">{{ 'pasta_resp.timeline.ontem'|trans }}</option>
                <option value="semana">{{ 'pasta_resp.timeline.semana'|trans }}</option>
                <option value="mes">{{ 'pasta_resp.timeline.mes'|trans }}</option>
            </select>
            <select class="ps-tl-select ps-tl-select--pessoa" data-tl-pessoa aria-label="{{ 'pasta_resp.timeline.pessoa'|trans }}">
                <option value="">{{ 'pasta_resp.timeline.todas_pessoas'|trans }}</option>
            </select>
            <button type="button" class="ps-tl-resumir" data-tl-resumir aria-pressed="false">
                <i class="bi bi-list-ul" aria-hidden="true"></i> {{ 'pasta_resp.timeline.resumir'|trans }}
            </button>
        </div>
    </div>

    <div class="ps-tl-lista" data-tl-lista aria-live="polite" aria-busy="false"></div>

    <div class="ps-tl-rodape">
        <span class="ps-tl-rotulo">{{ 'pasta_resp.timeline.rodape'|trans }}</span>
        <button type="button" class="ps-tl-mais" data-tl-mais hidden>{{ 'pasta_resp.timeline.carregar_mais'|trans }}</button>
    </div>
</aside>
