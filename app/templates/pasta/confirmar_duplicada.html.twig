{% extends 'base.html.twig' %}

{# Aviso de pasta duplicada (spec fase2 §12.5/D12.5). NÃO é bloqueio: o mesmo cliente pode ter
   vários casos parecidos legitimamente. O sistema mostra o que já existe e devolve a decisão
   para quem está criando. #}

{% block title %}Já existe uma pasta parecida{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header py-2">
                    <h6 class="mb-0">
                        <i class="bi bi-exclamation-triangle me-1 text-warning"></i>
                        Já existe uma pasta parecida
                    </h6>
                </div>

                <div class="card-body">
                    {{ include('pasta/_aviso_duplicada_conteudo.html.twig') }}
                </div>

                <div class="card-footer d-flex justify-content-end gap-2 py-2">
                    <a href="{{ path('expediente_index') }}" class="btn btn-secondary btn-sm">Cancelar</a>

                    {# Reenvia os MESMOS dados com confirmar=1: o servidor então cria sem perguntar de novo. #}
                    <form method="post" action="{{ path('pasta_new') }}" class="d-inline">
                        <input type="hidden" name="nome_cliente" value="{{ nomeCliente }}">
                        <input type="hidden" name="nome_acao" value="{{ nomeAcao }}">
                        <input type="hidden" name="confirmar" value="1">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-check-lg me-1"></i> Criar mesmo assim
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
