{# Conteúdo do aviso de pasta duplicada (D12.5). COMPARTILHADO por dois lugares:
   - a página de fallback sem-JS (confirmar_duplicada.html.twig);
   - a modal AJAX (_aviso_duplicada_modal.html.twig).
   NÃO inclui o botão "Criar mesmo assim" — cada um dos dois monta o seu (a página
   reenvia um form com confirmar=1; a modal dispara via JS).

   Variáveis:
     total       (int)  — número REAL de semelhantes; NÃO é o tamanho da lista.
     semelhantes (list) — truncada em 5 (há par cliente+ação com 27 pastas em produção;
                          mostrar "5" como total seria número errado com cara de certo).
     nomeCliente (?str)
     nomeAcao    (?str)
#}
<p class="mb-3">
    {{ (total == 1 ? 'pasta_avisos.duplicada.encontramos_uma' : 'pasta_avisos.duplicada.encontramos_varias')|trans({total: total ~ ''}) }}
    {{ 'pasta_avisos.duplicada.para'|trans }} <strong>{{ nomeCliente }}</strong>{% if nomeAcao %} {{ 'pasta_avisos.duplicada.em'|trans }} <strong>{{ nomeAcao }}</strong>{% endif %}.
    {% if total > semelhantes|length %}
        {{ 'pasta_avisos.duplicada.mostrando'|trans({total: semelhantes|length ~ ''}) }}
    {% else %}
        {{ 'pasta_avisos.duplicada.confira'|trans }}
    {% endif %}
</p>

<div class="table-responsive mb-3">
    <table class="table table-sm align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">{{ 'pasta_avisos.duplicada.numero'|trans }}</th>
                <th scope="col">{{ 'pasta_avisos.duplicada.cliente'|trans }}</th>
                <th scope="col">{{ 'pasta_avisos.duplicada.acao'|trans }}</th>
                <th scope="col">{{ 'pasta_avisos.duplicada.criada_em'|trans }}</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            {% for pasta in semelhantes %}
                <tr>
                    <td>{{ pasta.nup }}</td>
                    <td>{{ pasta.nomeCliente }}</td>
                    <td>{% if (pasta.nomeAcao ?? null) is not null %}{{ pasta.nomeAcao }}{% else %}<span class="text-muted small">{{ 'pasta_avisos.duplicada.nao_informado'|trans }}</span>{% endif %}</td>
                    <td>{% if pasta.criadoEm %}{{ pasta.criadoEm|data }}{% else %}<span class="text-muted small">{{ 'pasta_avisos.duplicada.sem_registro'|trans }}</span>{% endif %}</td>
                    <td class="text-end">
                        {# novaAba: só a modal abre em nova aba (não perder o contexto da criação);
                           a página de fallback fica igual ao comportamento antigo (mesma aba). #}
                        <a href="{{ path('pasta_show', {id: pasta.id}) }}"
                           class="btn btn-outline-secondary btn-sm"{% if novaAba|default(false) %} target="_blank" rel="noopener"{% endif %}>{{ 'pasta_avisos.duplicada.abrir'|trans }}</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<p class="text-muted small mb-0">
    {{ 'pasta_avisos.duplicada.caso_novo'|trans }}
</p>
