{% set filters = filters ?? {} %}
{% set nups = nups ?? [] %}
{% set responsaveis = responsaveis ?? [] %}
{% set formAction = formAction ?? path('pasta_index') %}
{% set limparUrl = limparUrl ?? path('pasta_index') %}

<div class="card card-outline card-primary mb-3">
    <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#filtrosPasta">
        <h3 class="card-title"><i class="bi bi-funnel me-1"></i> Filtros</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
    </div>
    <div class="collapse{% if filters.nup or filters.status or filters.responsavel or filters.status_documentos %} show{% endif %}" id="filtrosPasta">
        <div class="card-body">
            <form method="GET" action="{{ formAction }}" id="formFiltrosPasta">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="filter_nup" class="form-label">NUP</label>
                        <select id="filter_nup" name="nup" class="form-control select2-filter">
                            <option value="">Todos</option>
                            {% for nup in nups %}
                                <option value="{{ nup }}" {% if filters.nup == nup %}selected{% endif %}>{{ nup }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filter_status" class="form-label">Status</label>
                        <select id="filter_status" name="status" class="form-control select2-filter">
                            <option value="">Todos</option>
                            <option value="ativo" {% if filters.status == 'ativo' %}selected{% endif %}>Ativo</option>
                            <option value="arquivado" {% if filters.status == 'arquivado' %}selected{% endif %}>Arquivado</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filter_responsavel" class="form-label">Responsável</label>
                        <select id="filter_responsavel" name="responsavel" class="form-control select2-filter">
                            <option value="">Todos</option>
                            {% for usuario in responsaveis %}
                                <option value="{{ usuario.id }}" {% if filters.responsavel == usuario.id ~ '' %}selected{% endif %}>{{ usuario.fullName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filter_status_documentos" class="form-label">Documentação</label>
                        <select id="filter_status_documentos" name="status_documentos" class="form-control select2-filter">
                            <option value="">Todos</option>
                            <option value="APTO_PARA_PROTOCOLAR" {% if filters.status_documentos == 'APTO_PARA_PROTOCOLAR' %}selected{% endif %}>Apto para Protocolar</option>
                            <option value="PENDENTE_DE_DOCUMENTACAO" {% if filters.status_documentos == 'PENDENTE_DE_DOCUMENTACAO' %}selected{% endif %}>Pendente de Documentação</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i> Filtrar
                        </button>
                        <a href="{{ limparUrl }}" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-1"></i> Limpar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

{% if pastas|length > 0 %}
<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">
        <i class="bi bi-list-ul me-1"></i> {{ pastas|length }} resultado(s) encontrado(s)
    </span>
</div>

<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover mb-0" id="tabelaPastas">
            <thead>
                <tr>
                    <th class="sortable" data-col="0"><i class="bi bi-upc me-1"></i> NUP <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="1"><i class="bi bi-person me-1"></i> Cliente <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="2"><i class="bi bi-briefcase me-1"></i> Nome da Ação <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="3"><i class="bi bi-file-earmark-check me-1"></i> Documentação <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="4"><i class="bi bi-flag me-1"></i> Status <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="5"><i class="bi bi-person-badge me-1"></i> Responsável <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="6"><i class="bi bi-calendar-plus me-1"></i> Criado <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable" data-col="7"><i class="bi bi-clock-history me-1"></i> Modificado <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th><i class="bi bi-gear me-1"></i> Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for pasta in pastas %}
                <tr>
                    <td class="fw-semibold">{{ pasta.nup }}</td>
                    <td>
                        {% if pasta.clientes|length > 0 %}
                            {% for cliente in pasta.clientes %}
                                <div>{{ cliente.nomeExibicao }}</div>
                            {% endfor %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if pasta.processo %}
                            {{ pasta.processo.classeProcessual ?: pasta.processo.assuntoProcessual ?: pasta.processo.numeroProcesso }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if pasta.statusDocumentos == 'APTO_PARA_PROTOCOLAR' %}
                            <span class="badge text-bg-success">
                                <i class="bi bi-check-circle me-1"></i>Regular
                            </span>
                        {% else %}
                            <span class="badge text-bg-warning text-dark">
                                <i class="bi bi-exclamation-circle me-1"></i>Pendente
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge {{ pasta.status == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}">
                            {{ pasta.status == 'ativo' ? 'Ativo' : 'Arquivado' }}
                        </span>
                    </td>
                    <td>{{ pasta.responsavel ? pasta.responsavel.fullName : '—' }}</td>
                    <td>{{ pasta.createdAt|date('d/m/Y') }}</td>
                    <td>
                        {% set dias = date().diff(pasta.dataAbertura).days %}
                        {% if dias == 0 %}
                            Hoje
                        {% elseif dias == 1 %}
                            1 dia atrás
                        {% else %}
                            {{ dias }} dias atrás
                        {% endif %}
                    </td>
                    <td>
                        <div class="acoes-grupo">
                            <a href="{{ path('pasta_show', {id: pasta.id}) }}"
                               class="btn-action btn-action-view"
                               title="Visualizar pasta"
                               aria-label="Visualizar pasta">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('pasta_edit', {id: pasta.id}) }}"
                               class="btn-action btn-action-edit"
                               title="Editar pasta"
                               aria-label="Editar pasta">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                                  onsubmit="return confirm('Tem certeza que deseja excluir a pasta {{ pasta.nup|e('js') }}?');" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                                <button type="submit"
                                        class="btn-action btn-action-delete"
                                        title="Excluir pasta"
                                        aria-label="Excluir pasta">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="alert alert-info mb-0">
    <i class="bi bi-info-circle me-1"></i>
    {% if filters.nup or filters.status or filters.responsavel or filters.status_documentos %}
        Nenhuma pasta encontrada com os filtros aplicados.
    {% else %}
        Nenhuma pasta cadastrada. <a href="{{ path('pasta_new') }}">Criar nova pasta</a>
    {% endif %}
</div>
{% endif %}

<style>
.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
.sortable:hover { background-color: rgba(0,0,0,0.05); }
.sort-icon { font-size: 0.7em; opacity: 0.4; flex-shrink: 0; }
.sortable.asc .sort-icon, .sortable.desc .sort-icon { opacity: 1; }
.sortable.asc .sort-icon::before { content: "\F148"; }
.sortable.desc .sort-icon::before { content: "\F128"; }
</style>
<script>
(function () {
    var table = document.getElementById('tabelaPastas');
    if (!table) return;
    var headers = table.querySelectorAll('th.sortable');
    var tbody = table.querySelector('tbody');
    headers.forEach(function (header) {
        header.addEventListener('click', function () {
            var col = parseInt(this.dataset.col);
            var isAsc = this.classList.contains('asc');
            headers.forEach(function (h) { h.classList.remove('asc', 'desc'); });
            this.classList.add(isAsc ? 'desc' : 'asc');
            var rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aVal = (a.cells[col] ? a.cells[col].textContent.trim() : '').toLowerCase();
                var bVal = (b.cells[col] ? b.cells[col].textContent.trim() : '').toLowerCase();
                return isAsc ? bVal.localeCompare(aVal, 'pt-BR') : aVal.localeCompare(bVal, 'pt-BR');
            });
            rows.forEach(function (row) { tbody.appendChild(row); });
        });
    });
})();
</script>
