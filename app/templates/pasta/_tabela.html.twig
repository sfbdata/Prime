{# Só os RESULTADOS da listagem de pastas. A barra de filtro fica em
   pasta/_filtros.html.twig (fora da área trocável). #}
{% set filters = filters ?? {} %}
{% set responsaveis = responsaveis ?? [] %}
{% set usuarios = usuarios ?? responsaveis %}
{% set ordCol = ordenar ?? '' %}
{% set ordDir = (direcao ?? '') == 'asc' ? 'asc' : 'desc' %}

<style>
@keyframes urgente-pulso {
    0%, 100% { opacity: 1; }
    50%       { opacity: .35; }
}
.badge-urgente-pulso {
    animation: urgente-pulso 1.2s ease-in-out infinite;
}
</style>

{% if pastas|length > 0 %}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
    <span class="text-muted">
        <i class="bi bi-list-ul me-1"></i> {{ pastas|length }} resultado(s) encontrado(s)
    </span>
    {% if pagination is defined and pagination is not null %}
        {{ include('expediente/_paginacao.html.twig') }}
    {% endif %}
</div>

{# ── Tabela desktop ─────────────────────────────────────────────── #}
<div class="card d-none d-md-block">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover mb-0" id="tabelaPastas">
            <colgroup>
                <col style="width:66px">           <!-- NUP -->
                <col style="width:23%">            <!-- Cliente (elástica dominante) -->
                <col style="width:17%">            <!-- Ação (elástica, cede primeiro) -->
                <col style="width:100px">          <!-- Prioridade -->
                <col style="width:140px">          <!-- Responsável -->
                <col style="width:66px">           <!-- Metas -->
                <col style="width:170px">          <!-- Marcadores (chip + badge + botão na mesma linha) -->
                <col style="width:96px">           <!-- Situação -->
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th class="sortable ps-3 {{ ordCol == 'nup' ? ordDir : '' }}" data-ordenar="nup"><i class="bi bi-upc me-1"></i>NUP <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable {{ ordCol == 'cliente' ? ordDir : '' }}" data-ordenar="cliente"><i class="bi bi-person me-1"></i>Cliente <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable col-acao-tabela {{ ordCol == 'acao' ? ordDir : '' }}" data-ordenar="acao"><i class="bi bi-briefcase me-1"></i>Ação <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable {{ ordCol == 'prioridade' ? ordDir : '' }}" data-ordenar="prioridade"><i class="bi bi-flag-fill me-1"></i>Prioridade <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable col-resp-tabela {{ ordCol == 'responsavel' ? ordDir : '' }}" data-ordenar="responsavel"><i class="bi bi-person-badge me-1"></i>Responsável <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="col-tarefas-tabela"><i class="bi bi-check2-square me-1"></i>Metas</th>
                    <th class="sortable col-marc-tabela {{ ordCol == 'marcadores' ? ordDir : '' }}" data-ordenar="marcadores"><i class="bi bi-tags me-1"></i>Marcadores <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="sortable {{ ordCol == 'situacao' ? ordDir : '' }}" data-ordenar="situacao"><i class="bi bi-flag me-1"></i>Situação <i class="bi bi-arrow-down-up sort-icon"></i></th>
                </tr>
            </thead>
            <tbody>
                {% for pasta in pastas %}
                {% set dias = date().diff(pasta.dataAbertura).days %}
                <tr class="pasta-row-link{% if pasta.prioridade.value == 'urgente' %} pasta-row-urgente{% endif %}" style="cursor:pointer;" data-href="{{ path('pasta_show', {id: pasta.id}) }}">
                    <td class="fw-semibold ps-3 align-middle">{{ pasta.nup }}</td>
                    <td class="align-middle">
                        {% if pasta.clientes|length > 0 %}
                            {% if pasta.clientes|length == 1 %}
                                <span class="text-truncate d-block" style="width:100%;">{{ pasta.clientes[0].nomeExibicao }}</span>
                            {% else %}
                                <span class="clientes-resumo text-truncate d-block" style="width:100%;"
                                      data-bs-placement="right"
                                      data-clientes="{{ pasta.clientes|map(c => c.nomeExibicao)|join('||') }}">
                                    {{ pasta.clientes[0].nomeExibicao }}&hellip;
                                    <span class="badge text-bg-secondary ms-1" style="font-size:.65rem;">+{{ pasta.clientes|length - 1 }}</span>
                                </span>
                            {% endif %}
                        {% elseif pasta.nomeCliente %}
                            <span class="text-truncate d-block" style="width:100%;">{{ pasta.nomeCliente }}</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="col-acao-tabela align-middle">
                        <span class="text-truncate d-block" style="width:100%;">
                        {% if pasta.processoPrincipal %}
                            {{ pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso }}
                        {% elseif pasta.nomeAcao %}
                            {{ pasta.nomeAcao }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                        </span>
                    </td>
                    <td class="align-middle" data-sort="{{ pasta.prioridade.value == 'urgente' ? 3 : (pasta.prioridade.value == 'prioridade' ? 2 : 1) }}">
                        <span class="badge {{ pasta.prioridadeBadgeClass }}{% if pasta.prioridade.value == 'urgente' %} badge-urgente-pulso{% endif %}" style="font-size:.72rem;">
                            {{ pasta.prioridadeLabel }}
                        </span>
                    </td>
                    <td class="col-resp-tabela align-middle pasta-responsavel-cel" data-pasta-id="{{ pasta.id }}">
                        <select class="form-select form-select-sm pasta-resp-select"
                                style="max-width:150px;font-size:.8rem;"
                                data-pasta-id="{{ pasta.id }}"
                                data-url="{{ path('pasta_atualizar_responsavel', {id: pasta.id}) }}"
                                data-csrf="{{ csrf_token('pasta_responsavel_' ~ pasta.id) }}">
                            <option value="">—</option>
                            {% for u in usuarios %}
                                <option value="{{ u.id }}" {% if pasta.responsavel and pasta.responsavel.id == u.id %}selected{% endif %}>{{ u.fullName }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td class="col-tarefas-tabela align-middle">
                        {% set tarefasAtivas = pasta.tarefas|filter(t => t.status != 'concluida') %}
                        {% set totalTarefas = pasta.tarefas|length %}
                        {% if totalTarefas > 0 %}
                            {% set temRevisao = pasta.tarefas|filter(t => t.status == 'em_revisao')|length > 0 %}
                            <a href="{{ path('pasta_show', {id: pasta.id}) }}#tarefas"
                               class="badge {{ temRevisao ? 'text-bg-warning' : (tarefasAtivas|length > 0 ? 'text-bg-secondary' : 'text-bg-success') }} text-decoration-none"
                               title="{{ totalTarefas }} meta(s) · {{ tarefasAtivas|length }} ativa(s)">
                                <i class="bi bi-check2-square me-1"></i>{{ totalTarefas }}
                            </a>
                        {% else %}
                            <span class="text-muted" style="font-size:.8rem;">—</span>
                        {% endif %}
                    </td>
                    <td class="col-marc-tabela pasta-marcadores-col align-middle" data-pasta-id="{{ pasta.id }}" data-sort="{{ pasta.marcadores|length > 0 ? (pasta.marcadores|first).nome : '' }}">
                        <div class="d-flex flex-nowrap gap-1 align-items-center">
                            {% if pasta.marcadores|length > 0 %}
                                {% set primeiro = pasta.marcadores|first %}
                                <span class="badge rounded-pill px-2 marcador-principal"
                                      style="{% if primeiro.cor %}background:{{ primeiro.cor }};color:#333;border:1px solid rgba(0,0,0,.1);{% else %}background:var(--bs-tertiary-bg);color:var(--bs-body-color);{% endif %}font-size:.68rem;">
                                    {{ primeiro.nome }}
                                </span>
                                {% if pasta.marcadores|length > 1 %}
                                    <span class="badge rounded-pill px-2 marcadores-extra"
                                          style="background:var(--bs-tertiary-bg);color:var(--bs-body-color);font-size:.68rem;cursor:default;"
                                          data-marcadores-json="{{ pasta.marcadores|slice(1)|map(m => {nome: m.nome, cor: m.cor})|json_encode }}">
                                        +{{ pasta.marcadores|length - 1 }}
                                    </span>
                                {% endif %}
                            {% endif %}
                            <button type="button"
                                    class="btn btn-xs py-0 px-1 btn-outline-secondary js-mover-para"
                                    style="font-size:.7rem;line-height:1.4;"
                                    data-pasta-id="{{ pasta.id }}"
                                    data-pasta-nome="{{ pasta.nup }}"
                                    data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                                    data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}"
                                    title="Mover para…">
                                <i class="bi bi-tags"></i>
                            </button>
                        </div>
                    </td>
                    <td class="align-middle">
                        <span class="badge js-toggle-situacao {{ pasta.situacao == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}"
                              style="cursor:pointer;user-select:none;"
                              data-situacao="{{ pasta.situacao }}"
                              data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}"
                              data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}"
                              title="Dê duplo-clique para alternar entre ativo e arquivado">
                            {{ pasta.situacao == 'ativo' ? 'Ativo' : 'Arquivado' }}
                        </span>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── Cards mobile ───────────────────────────────────────────────── #}
<div class="d-md-none pasta-cards-lista">
    {% for pasta in pastas %}
    {% set dias = date().diff(pasta.dataAbertura).days %}
    <div class="pasta-card">
        <div class="pasta-card-header">
            <div class="pasta-card-nup">
                <i class="bi bi-folder2 me-1 text-primary"></i>
                <span class="fw-bold">{{ pasta.nup }}</span>
            </div>
            <div class="d-flex gap-1 align-items-center">
                <span class="badge {{ pasta.situacao == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}" style="font-size:.7rem;">
                    {{ pasta.situacao == 'ativo' ? 'Ativo' : 'Arquivado' }}
                </span>
                <span class="badge {{ pasta.prioridadeBadgeClass }}" style="font-size:.7rem;">
                    {{ pasta.prioridadeLabel }}
                </span>
            </div>
        </div>

        <div class="pasta-card-body">
            {# Cliente #}
            <div class="pasta-card-row">
                <span class="pasta-card-label"><i class="bi bi-person me-1"></i></span>
                <span class="pasta-card-value">
                    {% if pasta.clientes|length > 0 %}
                        {{ pasta.clientes[0].nomeExibicao }}{% if pasta.clientes|length > 1 %} <span class="text-muted">(+{{ pasta.clientes|length - 1 }})</span>{% endif %}
                    {% elseif pasta.nomeCliente %}
                        {{ pasta.nomeCliente }}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </span>
            </div>

            {# Ação #}
            {% set acaoTexto = pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso) : pasta.nomeAcao %}
            {% if acaoTexto %}
            <div class="pasta-card-row">
                <span class="pasta-card-label"><i class="bi bi-briefcase me-1"></i></span>
                <span class="pasta-card-value text-truncate">{{ acaoTexto }}</span>
            </div>
            {% endif %}

            {# Responsável + Data #}
            <div class="pasta-card-row">
                <span class="pasta-card-label"><i class="bi bi-person-badge me-1"></i></span>
                <select class="form-select form-select-sm pasta-resp-select flex-grow-1"
                        style="font-size:.8rem;"
                        data-pasta-id="{{ pasta.id }}"
                        data-url="{{ path('pasta_atualizar_responsavel', {id: pasta.id}) }}"
                        data-csrf="{{ csrf_token('pasta_responsavel_' ~ pasta.id) }}">
                    <option value="">—</option>
                    {% for u in usuarios %}
                        <option value="{{ u.id }}" {% if pasta.responsavel and pasta.responsavel.id == u.id %}selected{% endif %}>{{ u.fullName }}</option>
                    {% endfor %}
                </select>
                <span class="pasta-card-meta ms-auto text-muted">
                    {% if dias == 0 %}Hoje{% elseif dias == 1 %}1d{% else %}{{ dias }}d{% endif %}
                </span>
            </div>

            {# Marcadores #}
            {% if pasta.marcadores|length > 0 %}
            <div class="pasta-card-row pasta-marcadores-col" data-pasta-id="{{ pasta.id }}">
                <span class="pasta-card-label"><i class="bi bi-tags me-1"></i></span>
                <div class="d-flex flex-wrap gap-1 align-items-center flex-grow-1">
                    {% set primeiroMobile = pasta.marcadores|first %}
                    <span class="badge rounded-pill px-2"
                          style="{% if primeiroMobile.cor %}background:{{ primeiroMobile.cor }};color:#333;border:1px solid rgba(0,0,0,.1);{% else %}background:var(--bs-tertiary-bg);color:var(--bs-body-color);{% endif %}font-size:.68rem;">
                        {{ primeiroMobile.nome }}
                    </span>
                    {% if pasta.marcadores|length > 1 %}
                        <span class="badge rounded-pill px-2 marcadores-extra"
                              style="background:var(--bs-tertiary-bg);color:var(--bs-body-color);font-size:.68rem;cursor:default;"
                              data-marcadores-json="{{ pasta.marcadores|slice(1)|map(m => {nome: m.nome, cor: m.cor})|json_encode }}">
                            +{{ pasta.marcadores|length - 1 }}
                        </span>
                    {% endif %}
                    <button type="button"
                            class="btn btn-xs py-0 px-1 btn-outline-secondary js-mover-para"
                            style="font-size:.7rem;line-height:1.4;"
                            data-pasta-id="{{ pasta.id }}"
                            data-pasta-nome="{{ pasta.nup }}"
                            data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                            data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}"
                            title="Mover para…">
                        <i class="bi bi-tags"></i>
                    </button>
                </div>
            </div>
            {% else %}
            <div class="pasta-card-row pasta-marcadores-col" data-pasta-id="{{ pasta.id }}">
                <span class="pasta-card-label"><i class="bi bi-tags me-1"></i></span>
                <div class="flex-grow-1">
                    <button type="button"
                            class="btn btn-xs py-0 px-1 btn-outline-secondary js-mover-para"
                            style="font-size:.7rem;line-height:1.4;"
                            data-pasta-id="{{ pasta.id }}"
                            data-pasta-nome="{{ pasta.nup }}"
                            data-marcadores-ativos=""
                            data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}"
                            title="Adicionar marcador">
                        <i class="bi bi-tags me-1"></i>Marcar
                    </button>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="pasta-card-footer">
            <a href="{{ path('pasta_show', {id: pasta.id}) }}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-eye me-1"></i>Ver
            </a>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="alert alert-info mb-0">
    <i class="bi bi-info-circle me-1"></i>
    {% if filters.busca or filters.status or filters.responsavel or filters.prioridade or filters.data_de or filters.data_ate %}
        Nenhuma pasta encontrada com os filtros aplicados.
    {% else %}
        Nenhuma pasta cadastrada.
    {% endif %}
</div>
{% endif %}

<style>
/* ── Tabela desktop ──────────────────────────────────────────── */
#tabelaPastas { table-layout: fixed; width: 100%; min-width: 920px; }
#tabelaPastas thead th {
    white-space: nowrap;
    vertical-align: middle;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bs-secondary-color);
    border-bottom: 2px solid var(--bs-border-color);
    padding: 10px 10px;
}
#tabelaPastas tbody td {
    vertical-align: middle;
    font-size: 0.75rem;
    padding: 8px 10px;
    border-bottom: 1px solid var(--bs-border-color);
    text-transform: uppercase;
}
/* Respiro extra à direita da coluna Prioridade (rótulo encosta no vizinho) */
#tabelaPastas thead th[data-col="3"],   /* Prioridade */
#tabelaPastas tbody td:nth-child(4) {
    padding-right: 14px;
}

/* Colunas centralizadas: Metas, Marcadores, Situação */
#tabelaPastas thead th.col-tarefas-tabela,
#tabelaPastas tbody td.col-tarefas-tabela,
#tabelaPastas thead th.col-marc-tabela,
#tabelaPastas tbody td.col-marc-tabela,
#tabelaPastas thead th[data-col="7"],
#tabelaPastas tbody td:last-child {
    text-align: center;
}
#tabelaPastas tbody td.col-marc-tabela .d-flex {
    justify-content: center;
}
/* Marcadores numa só linha: chip principal trunca, badge +N e botão não encolhem */
#tabelaPastas tbody td.col-marc-tabela .marcador-principal {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#tabelaPastas tbody td.col-marc-tabela .marcadores-extra,
#tabelaPastas tbody td.col-marc-tabela .js-mover-para {
    flex-shrink: 0;
}
/* Respiro simétrico na última coluna (Situação) sem desalinhar o centro */
#tabelaPastas thead th:last-child,
#tabelaPastas tbody td:last-child { padding-left: 14px; padding-right: 14px; }
#tabelaPastas tbody tr:last-child td { border-bottom: none; }
#tabelaPastas tbody tr:hover { background: var(--bs-secondary-bg); }
.clientes-resumo { cursor: default; white-space: nowrap; }
.sortable { cursor: pointer; user-select: none; }
.sortable:hover { background-color: rgba(0,0,0,0.04); }
.sort-icon { font-size: 0.68em; opacity: 0.35; flex-shrink: 0; vertical-align: middle; margin-left: 2px; }
.sortable.asc .sort-icon, .sortable.desc .sort-icon { opacity: 1; color: #0d6efd; }
.sortable.asc .sort-icon::before { content: "\F148"; }
.sortable.desc .sort-icon::before { content: "\F128"; }

/* Telas médias: Cliente e Ação cedem mais antes do scroll entrar */
@media (max-width: 1300px) and (min-width: 901px) {
    #tabelaPastas colgroup col:nth-child(2) { width: 20%; }  /* Cliente */
    #tabelaPastas colgroup col:nth-child(3) { width: 14%; }  /* Ação */
}

/* Ocultar colunas secundárias em telas médias */
@media (max-width: 900px) {
    .col-acao-tabela, .col-resp-tabela, .col-tarefas-tabela { display: none; }
}
@media (max-width: 768px) {
    .col-marc-tabela { display: none; }
}

/* ── Cards mobile ────────────────────────────────────────────── */
.pasta-cards-lista {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4px 2px;
}

.pasta-card {
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    transition: box-shadow 0.15s;
}
.pasta-card:hover { box-shadow: 0 3px 10px rgba(0,0,0,0.10); }

.pasta-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 8px;
    background: var(--bs-tertiary-bg);
    border-bottom: 1px solid var(--bs-border-color);
}

.pasta-card-nup {
    font-size: 0.92rem;
    color: var(--bs-body-color);
    display: flex;
    align-items: center;
    gap: 4px;
    text-transform: uppercase;
}

.pasta-card-body {
    padding: 8px 14px 4px;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.pasta-card-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    min-height: 24px;
}

.pasta-card-label {
    color: var(--bs-secondary-color);
    flex-shrink: 0;
    font-size: 0.8rem;
    width: 18px;
    text-align: center;
}

.pasta-card-value {
    color: var(--bs-body-color);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: uppercase;
}

.pasta-card-meta {
    font-size: 0.75rem;
    flex-shrink: 0;
}

.pasta-card-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-top: 1px solid var(--bs-border-color);
    background: var(--bs-tertiary-bg);
}

/* Filtros responsivos */
@media (max-width: 575.98px) {
    #filtrosPasta .row > div { flex: 0 0 100%; max-width: 100%; }
}

/* ── Popover de marcadores extras ── */
.marcadores-popover-box {
    position: absolute;
    z-index: 9999;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    padding: 8px 10px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.13);
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 120px;
    max-width: 240px;
    pointer-events: none;
}
.marcadores-popover-badge {
    display: inline-block;
    border-radius: 20px;
    padding: 2px 10px;
    font-size: .72rem;
    font-weight: 500;
    color: var(--bs-body-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}
</style>
<script>
(function () {
    /* ── Tooltips dos clientes ── */
    function iniciarTooltipsClientes() {
        document.querySelectorAll('.clientes-resumo[data-clientes]').forEach(function (el) {
            if (bootstrap.Tooltip.getInstance(el)) return;
            var nomes = el.dataset.clientes.split('||');
            var html = nomes.map(function (n) { return '<div>' + n + '</div>'; }).join('');
            new bootstrap.Tooltip(el, {
                html: true,
                trigger: 'hover',
                placement: el.dataset.bsPlacement || 'right',
                title: function () { return html; }
            });
        });
    }

    /* ── Popover customizado dos marcadores extras ── */
    function iniciarTooltipsMarcadores() {
        if (!document.getElementById('marcadores-popover')) {
            var div = document.createElement('div');
            div.id = 'marcadores-popover';
            div.className = 'marcadores-popover-box';
            div.style.display = 'none';
            document.body.appendChild(div);
        }

        if (document.__marcadoresPopoverInit) return;
        document.__marcadoresPopoverInit = true;

        document.addEventListener('mouseover', function (e) {
            var badge = e.target.closest('.marcadores-extra[data-marcadores-json]');
            if (!badge) return;

            var marcadores;
            try { marcadores = JSON.parse(badge.dataset.marcadoresJson); } catch (err) { return; }
            if (!marcadores || marcadores.length === 0) return;

            var el = document.getElementById('marcadores-popover');
            if (!el) return;

            el.innerHTML = marcadores.map(function (m) {
                var bg    = m.cor || 'var(--bs-tertiary-bg)';
                var cor   = m.cor ? 'color:#333;' : '';
                var borda = m.cor ? 'border:1px solid rgba(0,0,0,.1);' : '';
                return '<span class="marcadores-popover-badge" style="background:' + bg + ';' + cor + borda + '">' +
                       escHtmlSimples(m.nome) +
                       '</span>';
            }).join('');

            posicionarPopover(badge);
            el.style.display = '';
        });

        document.addEventListener('mouseout', function (e) {
            var badge = e.target.closest('.marcadores-extra[data-marcadores-json]');
            if (!badge) return;
            var el = document.getElementById('marcadores-popover');
            if (el) el.style.display = 'none';
        });

        document.addEventListener('scroll', function () {
            var el = document.getElementById('marcadores-popover');
            if (el && el.style.display !== 'none') el.style.display = 'none';
        }, true);
    }

    function posicionarPopover(anchor) {
        var popoverEl = document.getElementById('marcadores-popover');
        if (!popoverEl) return;
        var rect = anchor.getBoundingClientRect();
        popoverEl.style.visibility = 'hidden';
        popoverEl.style.display = '';
        var popRect = popoverEl.getBoundingClientRect();
        var top  = rect.top + window.scrollY - popRect.height - 8;
        var left = rect.left + window.scrollX + (rect.width / 2) - (popRect.width / 2);
        if (left < 8) left = 8;
        if (left + popRect.width > window.innerWidth - 8) left = window.innerWidth - 8 - popRect.width;
        if (top < window.scrollY + 8) top = rect.bottom + window.scrollY + 8;
        popoverEl.style.top  = top  + 'px';
        popoverEl.style.left = left + 'px';
        popoverEl.style.visibility = '';
    }

    function escHtmlSimples(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            iniciarTooltipsClientes();
            iniciarTooltipsMarcadores();
        });
    } else {
        iniciarTooltipsClientes();
        iniciarTooltipsMarcadores();
    }

    /* A ordenação por coluna é feita no servidor (ordena o acervo inteiro, não só
       esta página). O clique no cabeçalho é tratado por delegação no shell do
       Expediente (#expediente-painel); aqui a seta ativa já vem renderizada. */
})();
</script>

<script>
(function () {
    function salvarResponsavelTabela(select) {
        var pastaId      = select.dataset.pastaId;
        var url          = select.dataset.url;
        var csrf         = select.dataset.csrf;
        var responsavelId = select.value;

        select.disabled = true;

        var body = new URLSearchParams({ _token: csrf, responsavel_id: responsavelId });

        fetch(url, {
            method: 'PATCH',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            select.disabled = false;
            if (!res.ok) {
                select.value = select.dataset.valorOriginal || '';
            } else {
                select.dataset.valorOriginal = responsavelId;
            }
        })
        .catch(function () { select.disabled = false; });
    }

    /* Delegação — funciona para conteúdo carregado via AJAX.
       Ligado uma única vez no document: este bloco re-executa a cada troca de
       resultados (busca ao vivo/paginação), então a guarda evita empilhar handlers. */
    if (!document.__pastaRespChangeBound) {
        document.__pastaRespChangeBound = true;
        document.addEventListener('change', function (e) {
            var sel = e.target.closest('.pasta-resp-select');
            if (!sel) return;
            salvarResponsavelTabela(sel);
        });
    }

    /* Guarda valor original para rollback em caso de erro */
    document.querySelectorAll('.pasta-resp-select').forEach(function (sel) {
        sel.dataset.valorOriginal = sel.value;

        /* Impede que o clique no select propague para o tr.pasta-row-link */
        sel.addEventListener('click', function (e) { e.stopPropagation(); });
    });
}());
</script>
