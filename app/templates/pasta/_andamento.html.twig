{# Andamento da pasta em fases, sob o nome (desenho 1.2.3, dc L.1298-1320, E12b). Cada bolinha: cor do estado,
   data em que a fase foi alcançada, dias entre as fases e a contagem de registros feitos nela. Quem pode editar a
   pasta clica para avançar, voltar, finalizar ou reativar (pasta-andamento.js pergunta com os textos do desenho).
   Contexto: `pasta`, `andamento` (AndamentoDaPastaOutput). #}
{% if andamento %}
{% set podeMudarFase = (podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit')) and not pasta.estaExcluida %}
{% set ultima = andamento.fases|length - 1 %}
<div class="ps-and bjLinhaT" data-screen-label="Andamento da pasta"
     data-url="{{ path('pasta_andamento_mudar', {id: pasta.id}) }}"
     data-csrf="{{ csrf_token('pasta_andamento_' ~ pasta.id) }}"
     data-atual="{{ andamento.atual }}" data-ultima="{{ ultima }}" data-pasta="{{ pasta.id }}"
     data-pode="{{ podeMudarFase ? '1' : '0' }}"
     style="max-width: {{ max(820, andamento.fases|length * 104) }}px;">
    <div class="ps-and-rotulo bjLinhaTit">{{ 'pasta_documentos.anotacoes.linha_do_tempo'|trans }}</div>
    <div class="ps-and-rol bjFasesRol">
        {% for f in andamento.fases %}
            {% set k = f.indice %}
            <div class="ps-and-fase" data-fase-at="{{ k == andamento.atual ? '1' : '0' }}">
                <span class="ps-and-linha ps-and-linha--e{{ k == 0 ? ' is-nada' : (k <= andamento.atual ? ' is-feita' : '') }}"></span>
                {% if f.intervalo %}<span class="ps-and-int"{% if f.intervaloDica %} title="{{ f.intervaloDica }}"{% endif %}>{{ f.intervalo }}</span>{% endif %}
                <span class="ps-and-linha ps-and-linha--d{{ k == ultima ? ' is-nada' : (k < andamento.atual ? ' is-feita' : '') }}"></span>
                <button type="button" class="ps-and-bola js-and-fase" data-estado="{{ f.estado }}" data-fase="{{ k }}" data-nome="{{ f.rotulo }}"
                        title="{{ f.dica }}" aria-label="{{ f.dica }}"{% if not podeMudarFase %} disabled{% endif %}>
                    {% if f.martelo %}<span class="ps-and-martelo" aria-hidden="true"></span>{% else %}<i class="bi {{ f.icone }}" aria-hidden="true"></i>{% endif %}
                    {% if f.registros > 0 %}<span class="ps-and-n">{{ f.registros }}</span>{% endif %}
                </button>
                <span class="ps-and-rot" data-estado="{{ f.estado }}">{{ f.rotulo }}</span>
                <span class="ps-and-dia">{{ f.dia }}</span>
            </div>
        {% endfor %}
        {% if andamento.total %}<div class="ps-and-total" title="{{ andamento.totalDica }}">{{ andamento.total }}</div>{% endif %}
    </div>
</div>
{# Faixa "Avançar para X?" (dc L.1315-1321): a fase à frente que os dados sugerem. Ignorar vale até sair da pasta. #}
{% if podeMudarFase and andamento.sugestoes is not empty %}
    <div class="ps-and-sug" hidden data-sugestoes="{{ andamento.sugestoes|json_encode|e('html_attr') }}">
        <i class="bi js-and-sug-ic" aria-hidden="true"></i>
        <span class="ps-and-sug-txt"><b class="js-and-sug-titulo"></b> <span class="js-and-sug-motivo"></span></span>
        <button type="button" class="ps-and-sug-ok js-and-sug-ok">{{ 'pasta_avisos.andamento.avancar'|trans }}</button>
        <button type="button" class="ps-and-sug-ign js-and-sug-ign">{{ 'pasta_avisos.andamento.ignorar'|trans }}</button>
    </div>
{% endif %}
{% endif %}
