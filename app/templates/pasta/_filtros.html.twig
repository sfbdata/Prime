{# ───────────────────────────────────────────────────────────────────────────
   Barra de filtro da listagem de pastas (Expediente).

   Fica FORA da área trocável (#pastas-resultado): ao filtrar, só os resultados
   recarregam, então o campo de busca mantém o foco enquanto se digita. A lógica
   de aplicar (busca com debounce, dropdowns/datas na hora), montar os chips e
   paginar vive centralizada no shell expediente/index.html.twig, por delegação
   no #expediente-painel (que é persistente).
─────────────────────────────────────────────────────────────────────────── #}
{% set filters = filters ?? {} %}
{% set responsaveis = responsaveis ?? [] %}
{% set formAction = formAction ?? path('expediente_acervo_geral') %}

<div class="pasta-filtros mb-3">
    <form method="GET" action="{{ formAction }}" id="formFiltrosPasta" class="pasta-filtros-form">
        <input type="hidden" name="ordenar" value="{{ ordenar ?? '' }}">
        <input type="hidden" name="direcao" value="{{ direcao ?? '' }}">
        {# E12: filtro do sistema escolhido no trilho e "Pastas por página" viajam com o formulário (página, ordem,
           estado salvo), mas não são zerados pelo "Limpar", como no desenho. #}
        <input type="hidden" name="expediente" value="{{ filters.expediente ?? '' }}">
        <input type="hidden" name="por_pagina" value="{{ pagination.per_page ?? '' }}">
        <div class="pasta-filtros-linha">
            {# dc L.144: a dica da busca diz o que ela procura. #}
            <div class="pasta-filtros-busca" data-tip="{{ 'pasta_lista.filtros.busca_dica'|trans }}">
                <i class="bi bi-search"></i>
                <input type="text" name="busca" class="form-control form-control-sm js-pasta-busca"
                       placeholder="{{ 'pasta_lista.filtros.busca_placeholder'|trans }}"
                       autocomplete="off" value="{{ filters.busca ?? '' }}">
            </div>

            {# A situação ("Status") foi para a barra do acervo, como o desenho (pasta/_filtro_situacao, AUD-08). #}

            {# Responsável e Prioridade com a cara de botão do desenho (dc L.102-108, AUD-09): seta pequena e, na
               prioridade, a bandeira na cor do valor. Seguem <select> nativos (teclado e leitor de tela de graça). #}
            <span class="exp-filtro exp-filtro--resp" role="button" tabindex="0" aria-haspopup="dialog" data-tip="{{ 'pasta_lista.filtros.responsavel_dica'|trans }}">
            <select name="responsavel" class="form-select form-select-sm js-pasta-filtro pasta-filtros-select"
                    data-rotulo="{{ 'pasta_lista.filtros.responsavel'|trans }}" aria-label="{{ 'pasta_lista.filtros.responsavel_rotulo'|trans }}" tabindex="-1">
                <option value="">{{ 'pasta_lista.filtros.responsavel'|trans }}</option>
                <option value="sem" {% if filters.responsavel == 'sem' %}selected{% endif %}>{{ 'pasta_lista.filtros.sem_responsavel'|trans }}</option>
                {# dc L.146-148 e L.652 (`avBg`): com foto, o avatar do menu e do botão é a foto; sem, as iniciais. #}
                {% set fotosDoFiltro = fotosResponsaveis|default({}) %}
                {% for usuario in responsaveis %}
                    {% set fotoF = fotosDoFiltro[usuario.id]|default(null) %}
                    <option value="{{ usuario.id }}" {% if filters.responsavel == usuario.id ~ '' %}selected{% endif %}{% if fotoF %} data-foto="{{ path('app_profile_foto_serve', {nome: fotoF}) }}"{% endif %}>{{ usuario.fullName }}</option>
                {% endfor %}
            </select>
            <i class="bi bi-chevron-down exp-filtro-seta" aria-hidden="true"></i>
            </span>

            <span class="exp-filtro exp-filtro--prio" data-valor="{{ filters.prioridade ?? '' }}" role="button" tabindex="0" aria-haspopup="dialog" data-tip="{{ 'pasta_lista.filtros.prioridade_dica'|trans }}">
            <i class="bi bi-flag-fill exp-filtro-bandeira" aria-hidden="true"></i>
            <select name="prioridade" class="form-select form-select-sm js-pasta-filtro pasta-filtros-select"
                    data-rotulo="{{ 'pasta_lista.prioridade'|trans }}" aria-label="{{ 'pasta_lista.filtros.prioridade_rotulo'|trans }}" tabindex="-1">
                <option value="">{{ 'pasta_lista.prioridade'|trans }}</option>
                <option value="normal" {% if filters.prioridade == 'normal' %}selected{% endif %}>{{ 'pasta_lista.filtros.normal'|trans }}</option>
                <option value="prioridade" {% if filters.prioridade == 'prioridade' %}selected{% endif %}>{{ 'pasta_lista.filtros.alta'|trans }}</option>
                <option value="urgente" {% if filters.prioridade == 'urgente' %}selected{% endif %}>{{ 'pasta_lista.filtros.urgente'|trans }}</option>
            </select>
            <i class="bi bi-chevron-down exp-filtro-seta" aria-hidden="true"></i>
            </span>

            <div class="pasta-filtros-periodo" data-tip="{{ 'pasta_lista.filtros.periodo_dica'|trans }}">
                <span class="pasta-data-campo">
                    <input type="date" name="data_de" class="form-control form-control-sm js-pasta-filtro"
                           data-rotulo="{{ 'pasta_lista.filtros.de'|trans }}" aria-label="{{ 'pasta_lista.filtros.de_rotulo'|trans }}" value="{{ filters.data_de ?? '' }}">
                    <button type="button" class="pasta-data-btn js-abrir-calendario" tabindex="-1"
                            aria-label="{{ 'pasta_lista.filtros.abrir_calendario'|trans }}"><i class="bi bi-calendar3"></i></button>
                </span>
                <span class="pasta-filtros-periodo-sep" aria-hidden="true">{{ 'pasta_lista.filtros.periodo_sep'|trans }}</span>
                <span class="pasta-data-campo">
                    <input type="date" name="data_ate" class="form-control form-control-sm js-pasta-filtro"
                           data-rotulo="{{ 'pasta_lista.filtros.ate'|trans }}" aria-label="{{ 'pasta_lista.filtros.ate_rotulo'|trans }}" value="{{ filters.data_ate ?? '' }}">
                    <button type="button" class="pasta-data-btn js-abrir-calendario" tabindex="-1"
                            aria-label="{{ 'pasta_lista.filtros.abrir_calendario'|trans }}"><i class="bi bi-calendar3"></i></button>
                </span>
            </div>
            {# "Limpar todos os filtros" em ícone (dc L.149): só aparece com algum filtro (expediente-lista.js). #}
            <button type="button" class="exp-limpar js-pasta-limpar" data-tip="{{ 'pasta_lista.filtros.limpar'|trans }}" aria-label="{{ 'pasta_lista.filtros.limpar'|trans }}" hidden>
                <i class="bi bi-x-circle" aria-hidden="true"></i>
            </button>
        </div>

        {# Chips dos filtros ativos — montados por JS a partir do estado do form #}
        <div class="pasta-chips" id="pasta-chips"></div>
    </form>
</div>

<style>
.pasta-filtros-linha {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}
/* Busca na MESMA linha das facetas: item flexível que cresce/encolhe */
.pasta-filtros-busca {
    position: relative;
    flex: 1 1 180px;
    min-width: 150px;
    max-width: 240px;
}
.pasta-filtros-busca .bi-search {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--bs-secondary-color);
    font-size: .85rem;
    pointer-events: none;
}
.pasta-filtros-busca input.js-pasta-busca {
    padding-left: 32px;
    border-radius: 20px;
}
.pasta-filtros-select {
    width: auto;
    min-width: 128px;
    /* Cap para nomes longos (ex.: Responsável) não estourarem a linha; o nome
       completo segue visível no dropdown e no chip do filtro ativo. */
    max-width: 150px;
    border-radius: 20px;
}
.pasta-filtros-periodo {
    display: flex;
    align-items: center;
    gap: 8px;
}
.pasta-filtros-periodo-sep {
    color: var(--bs-secondary-color);
}
/* Cada data é um "pill" próprio, igual aos dropdowns, com o calendário embutido */
.pasta-data-campo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 31px;
    padding: 0 8px 0 12px;
    border: 1px solid var(--bs-border-color);
    border-radius: 20px;
    background: var(--bs-body-bg);
}
.pasta-data-campo:focus-within {
    border-color: var(--bs-primary);
}
.pasta-data-btn {
    border: none;
    background: transparent;
    color: var(--bs-secondary-color);
    cursor: pointer;
    padding: 0;
    font-size: .9rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
}
.pasta-data-btn:hover {
    color: var(--bs-primary);
}
.pasta-filtros-periodo input[type="date"] {
    border: none;
    background: transparent;
    width: 96px;
    padding: 0;
    box-shadow: none;
    height: auto;
    font-size: .8125rem;
    color: var(--bs-body-color);
}
.pasta-filtros-periodo input[type="date"]:focus {
    box-shadow: none;
    outline: none;
}
/* Usa nosso botão de calendário no lugar do ícone nativo (evita ícone duplicado) */
.pasta-filtros-periodo input[type="date"]::-webkit-calendar-picker-indicator {
    display: none;
    -webkit-appearance: none;
    appearance: none;
}

.pasta-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: 10px;
}
.pasta-chips:empty {
    display: none;
}
.pasta-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary-text-emphasis);
    border: 1px solid var(--bs-primary-border-subtle);
    border-radius: 16px;
    padding: 2px 6px 2px 11px;
    font-size: .74rem;
    line-height: 1.6;
    max-width: 260px;
}
.pasta-chip-rotulo {
    opacity: .7;
}
.pasta-chip-valor {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.pasta-chip-remover {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: .72rem;
    padding: 0;
    flex-shrink: 0;
}
.pasta-chip-remover:hover {
    background: rgba(0, 0, 0, .12);
}
.pasta-chips-limpar {
    background: none;
    border: none;
    color: var(--bs-secondary-color);
    font-size: .74rem;
    cursor: pointer;
    text-decoration: underline;
    padding: 2px 4px;
}
.pasta-chips-limpar:hover {
    color: var(--bs-body-color);
}

/* Fade sutil enquanto os resultados recarregam (busca ao vivo) */
#pastas-resultado.pastas-carregando {
    opacity: .55;
    transition: opacity .12s ease;
    pointer-events: none;
}

@media (max-width: 575.98px) {
    .pasta-filtros-busca { flex: 1 1 100%; max-width: none; }
    .pasta-filtros-select { flex: 1 1 calc(50% - 4px); min-width: 0; }
    .pasta-filtros-periodo { flex: 1 1 100%; }
    .pasta-data-campo { flex: 1; }
    .pasta-filtros-periodo input[type="date"] { width: auto; flex: 1; }
}
</style>
