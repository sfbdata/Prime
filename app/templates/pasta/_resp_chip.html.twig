{# Chip editável do responsável (avatar + nome). Clicar abre o menu compartilhado
   #pastaRespMenu (JS no _tabela). Reusa o mesmo endpoint/CSRF do save antigo. #}
{% import '_partials/_avatar_usuario.html.twig' as av %}
{# fotos: mapa userId => fotoUrl (findFotoPorColaboradores), evita lazy-load de profile por linha #}
{% set fotos = fotos ?? {} %}
{% set resp = pasta.responsavel %}
{# 'pasta' (padrao, cabecalho da pasta_show) ou 'expediente' (o _tabela passa).
   Na pasta o chip vazio segue o desenho (PAS-013): `bi-person-dash` e o nome sem
   `.text-muted` — a cor apagada vem do pasta-show.css, que o !important do
   Bootstrap impedia. #}
{% set naPasta = (respContexto|default('pasta')) == 'pasta' %}
{# `data-contexto`: o _resp_script redesenha o chip vazio conforme o contexto (PAS-013b). #}
<button type="button" class="pasta-resp-chip"
        data-contexto="{{ naPasta ? 'pasta' : 'expediente' }}"
        data-pasta-id="{{ pasta.id }}"
        data-url="{{ path('pasta_atualizar_responsavel', {id: pasta.id}) }}"
        data-csrf="{{ csrf_token('pasta_responsavel_' ~ pasta.id) }}"
        data-resp-id="{{ resp ? resp.id : '' }}"
        {# No Expediente a dica é a do desenho 03 (dc `respTip`), pelo sistema de dicas da lista; na pasta, o title. #}
        {% if naPasta %}title="{{ resp ? resp.fullName : 'Definir responsável' }}"{% else %}data-tip="{{ resp ? resp.fullName ~ ' · clique para alterar' : 'Clique para atribuir um responsável' }}"{% endif %}>
    {% if resp %}
        {{ av.avatar(resp.fullName, fotos[resp.id]|default(null), 24) }}
        <span class="pasta-resp-nome">{{ resp.fullName }}</span>
    {% else %}
        <span class="resp-avatar resp-avatar-vazio" style="width:24px;height:24px;"><i class="bi {{ naPasta ? 'bi-person-dash' : 'bi-person' }}"></i></span>
        <span class="pasta-resp-nome{{ naPasta ? '' : ' text-muted' }}">Sem responsável</span>
    {% endif %}
    <i class="bi bi-chevron-down pasta-resp-caret"></i>
</button>
