{% extends 'base.html.twig' %}

{% block title %}{{ 'pasta_lista.demandas.titulo'|trans }}{% endblock %}

{# Desenho 15 (`15 - Demandas - VS 30.10.26.dc.html`): a Lista do Expediente (desenho 03) sem o trilho, só com as
   minhas demandas. O visual é o do Expediente (expediente-lista.css e -12.css, tudo sob `.exp-body`); o que é só
   desta tela (zebra das linhas) mora em demandas-lista.css, sob `.exp-demandas`. #}
{% block body_class %}exp-body exp-demandas{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        {# dc L.79: a pasta que some (bjPastaFecha) e a caixa de entrada que fica, 40px. #}
        <h1 class="exp-titulo"><span class="exp-titulo-icone" aria-hidden="true"><i class="bi bi-folder-fill"></i><i class="bi bi-inbox-fill"></i></span>{{ 'pasta_lista.demandas.titulo'|trans }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# Sem trilho (dc L.82, `display:none`): o acervo ocupa a largura toda. #}
        <div class="exp-demandas-conteudo" id="demandas-painel">
            {{ include('pasta/demandas/_acervo.html.twig') }}
        </div>
    </div>
</section>

{# Nova demanda: o modal Nova Pasta do desenho (título "Nova Pasta"), com quem cria como responsável e sem
   "Importar em lote" (dc L.282). #}
{{ include('_partials/modal_nova_pasta.html.twig', {
    desenho11: true,
    urlSugestoesNova: path('demandas_nova_pasta_sugestoes'),
    criadorResponsavel: true
}) }}

{{ include('expediente/_modais_lista.html.twig') }}

{# O menu MARCADOR da linha lista os marcadores do escritório (expediente-lista.js lê `#expTrilho .exp-tri-marcador`).
   Sem trilho na tela, a lista vai escondida, só com o que o menu lê. #}
<div id="expTrilho" hidden>
    {% for marcador in marcadores ?? [] %}
        <span class="exp-tri-marcador" data-marcador-id="{{ marcador.id }}" data-pai-id="" data-nome="{{ marcador.nome }}" data-cor-tela="{{ marcador.cor|cor_marcador }}"></span>
        {% for sub in marcador.filhos %}
            <span class="exp-tri-marcador" data-marcador-id="{{ sub.id }}" data-pai-id="{{ marcador.id }}" data-nome="{{ sub.nome }}" data-cor-tela="{{ sub.cor|cor_marcador }}"></span>
        {% endfor %}
    {% endfor %}
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/expediente-lista.css') }}">
<link rel="stylesheet" href="{{ asset('css/expediente-lista-12.css') }}">
<link rel="stylesheet" href="{{ asset('css/demandas-lista.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ catalogo_js('expediente.js') }}
{{ catalogo_js('pasta_lista.js') }}
<script src="{{ asset('js/pasta-dialogos.js') }}"></script>
<script src="{{ asset('js/expediente-lista.js') }}"></script>
<script src="{{ asset('js/demandas-lista.js') }}"></script>
{% endblock %}
