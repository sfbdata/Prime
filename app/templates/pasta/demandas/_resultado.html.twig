{# ───────────────────────────────────────────────────────────────────────────
   Fragmento trocável das Minhas Demandas (dentro de [data-filtro-resultado]).
   Reexecutado a cada filtro/página pelo motor public/js/filtro-tabela.js.
   Não usar id= duplicado com a casca; só classes/data-*.
─────────────────────────────────────────────────────────────────────────── #}
{% set temFiltro = filtros.busca or filtros.status or filtros.prioridade or filtros.data_de or filtros.data_ate %}

<div class="demandas-resultado-head">
    <div class="demandas-count">
        <i class="bi bi-list-ul"></i> <strong>{{ total }}</strong>&nbsp;{{ 'pasta_lista.resultado.encontradas'|trans }}
    </div>
    {{ include('_partials/_filtro_paginacao.html.twig', { pagina: pagina, total_paginas: total_paginas }) }}
</div>

{% if pastas|length > 0 %}
    {# ── Tabela desktop ─────────────────────────────────────────── #}
    <div class="card demandas-card d-none d-md-block">
        <div class="table-responsive">
            <table class="table mb-0" id="tabelaDemandas">
                <thead>
                    <tr>
                        <th class="sortable ps-3{{ filtros.ordenar == 'nup' ? ' ' ~ filtros.direcao : '' }}" data-ordenar="nup" style="width:90px"><i class="bi bi-upc me-1"></i>{{ 'pasta_lista.nup'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                        <th class="sortable{{ filtros.ordenar == 'cliente' ? ' ' ~ filtros.direcao : '' }}" data-ordenar="cliente"><i class="bi bi-person me-1"></i>{{ 'pasta_lista.cliente'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                        <th class="sortable col-acao-tabela{{ filtros.ordenar == 'acao' ? ' ' ~ filtros.direcao : '' }}" data-ordenar="acao"><i class="bi bi-briefcase me-1"></i>{{ 'pasta_lista.acao'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                        <th class="sortable{{ filtros.ordenar == 'prioridade' ? ' ' ~ filtros.direcao : '' }}" data-ordenar="prioridade" style="width:95px;"><i class="bi bi-flag-fill me-1"></i>{{ 'pasta_lista.prioridade'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                        <th class="col-tarefas-tabela" style="width:80px;"><i class="bi bi-check2-square me-1"></i>{{ 'pasta_lista.metas'|trans }}</th>
                        <th class="col-data-tabela" style="width:95px"><i class="bi bi-clock-history me-1"></i>{{ 'pasta_lista.resultado.modificada'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for pasta in pastas %}
                    {% set dias = pasta.dataAbertura ? date().diff(pasta.dataAbertura).days : null %}
                    <tr class="pasta-row-link{% if pasta.prioridade.value == 'urgente' %} pasta-row-urgente{% endif %}"
                        style="cursor:pointer;"
                        data-href="{{ path('pasta_show', {id: pasta.id}) }}">
                        <td class="nup-cell ps-3 align-middle">{{ pasta.nup }}</td>
                        <td class="align-middle">
                            {# Mesma precedência da tabela do Expediente (`_tabela.html.twig`): o nome
                               da PASTA vem primeiro, o cliente cadastrado é o fallback. #}
                            {% set identificador = identificador_pasta(pasta) %}
                            {% if identificador %}
                                {{ identificador }}
                            {% elseif pasta.clientes|length > 0 %}
                                {% if pasta.clientes|length == 1 %}
                                    {{ pasta.clientes[0].nomeExibicao }}
                                {% else %}
                                    {% set nomesClientes = pasta.clientes|map(c => c.nomeExibicao)|join('||') %}
                                    <span class="clientes-resumo"
                                          data-bs-placement="right"
                                          data-clientes="{{ nomesClientes }}">
                                        {{ pasta.clientes[0].nomeExibicao }}&hellip;
                                        <span class="badge text-bg-secondary ms-1" style="font-size:.65rem;">+{{ pasta.clientes|length - 1 }}</span>
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">{{ 'pasta_lista.nao_informado'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="col-acao-tabela align-middle">
                            {% if pasta.processoPrincipal %}
                                {{ pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso }}
                            {% elseif pasta.nomeAcao %}
                                {{ pasta.nomeAcao }}
                            {% else %}
                                <span class="text-muted">{{ 'pasta_lista.nao_informado'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="align-middle">
                            <span class="badge {{ pasta.prioridadeBadgeClass }}{% if pasta.prioridade.value == 'urgente' %} badge-urgente-pulso{% endif %}" style="font-size:.72rem;">
                                {{ pasta.prioridadeLabel }}
                            </span>
                        </td>
                        <td class="col-tarefas-tabela align-middle">
                            {% set tarefasAtivas = pasta.tarefas|filter(t => t.status != 'concluida') %}
                            {% set totalTarefas = pasta.tarefas|length %}
                            {% if totalTarefas > 0 %}
                                {% set temRevisao = pasta.tarefas|filter(t => t.status == 'em_revisao')|length > 0 %}
                                <a href="{{ path('pasta_show', {id: pasta.id}) }}#tarefas"
                                   class="badge {{ temRevisao ? 'text-bg-warning' : (0 < tarefasAtivas|length ? 'text-bg-secondary' : 'text-bg-success') }} text-decoration-none"
                                   title="{{ 'pasta_lista.metas_resumo'|trans({total: totalTarefas ~ '', ativas: tarefasAtivas|length ~ ''}) }}">
                                    <i class="bi bi-check2-square me-1"></i>{{ totalTarefas }}
                                </a>
                            {% else %}
                                <span class="text-muted" style="font-size:.8rem;">{{ 'pasta_lista.resultado.nenhuma'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="col-data-tabela align-middle text-muted" style="font-size:.82rem;">
                            {% if dias is null %}{{ 'pasta_lista.resultado.sem_registro'|trans }}
                            {% elseif dias == 0 %}{{ 'pasta_lista.hoje'|trans }}
                            {% elseif dias == 1 %}{{ 'pasta_lista.resultado.um_dia'|trans }}
                            {% else %}{{ 'pasta_lista.resultado.dias'|trans({dias: dias ~ ''}) }}{% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ── Cards mobile ───────────────────────────────────────────── #}
    <div class="d-md-none pasta-cards-lista">
        {% for pasta in pastas %}
        {% set dias = pasta.dataAbertura ? date().diff(pasta.dataAbertura).days : null %}
        <div class="pasta-card{% if pasta.prioridade.value == 'urgente' %} pasta-card-urgente{% endif %}"
             style="cursor:pointer;" onclick="window.location.href='{{ path('pasta_show', {id: pasta.id}) }}'">
            <div class="pasta-card-header">
                <div class="pasta-card-nup">
                    <i class="bi bi-folder2"></i>
                    <span>{{ pasta.nup }}</span>
                </div>
                <div class="d-flex gap-1 align-items-center">
                    <span class="badge {{ pasta.prioridadeBadgeClass }}{% if pasta.prioridade.value == 'urgente' %} badge-urgente-pulso{% endif %}" style="font-size:.7rem;">
                        {{ pasta.prioridadeLabel }}
                    </span>
                </div>
            </div>

            <div class="pasta-card-body">
                <div class="pasta-card-row">
                    <span class="pasta-card-label"><i class="bi bi-person"></i></span>
                    <span class="pasta-card-value">
                        {% set identificadorCartao = identificador_pasta(pasta) %}
                        {% if identificadorCartao %}
                            {{ identificadorCartao }}
                        {% elseif pasta.clientes|length > 0 %}
                            {{ pasta.clientes[0].nomeExibicao }}{% if pasta.clientes|length > 1 %} <span class="text-muted">(+{{ pasta.clientes|length - 1 }})</span>{% endif %}
                        {% elseif pasta.nomeCliente %}
                            {{ pasta.nomeCliente }}
                        {% else %}
                            <span class="text-muted">{{ 'pasta_lista.nao_informado'|trans }}</span>
                        {% endif %}
                    </span>
                </div>

                {% set acaoTexto = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso) : null) %}
                {% if acaoTexto %}
                <div class="pasta-card-row">
                    <span class="pasta-card-label"><i class="bi bi-briefcase"></i></span>
                    <span class="pasta-card-value text-truncate">{{ acaoTexto }}</span>
                </div>
                {% endif %}

                <div class="pasta-card-row">
                    <span class="pasta-card-label"><i class="bi bi-clock-history"></i></span>
                    <span class="pasta-card-value text-muted" style="font-size:.8rem;">
                        {% if dias is null %}{{ 'pasta_lista.resultado.sem_registro'|trans }}{% elseif dias == 0 %}{{ 'pasta_lista.hoje'|trans }}{% elseif dias == 1 %}{{ 'pasta_lista.resultado.um_dia'|trans }}{% else %}{{ 'pasta_lista.resultado.dias'|trans({dias: dias ~ ''}) }}{% endif %}
                    </span>
                </div>
            </div>

            <div class="pasta-card-footer">
                <a href="{{ path('pasta_show', {id: pasta.id}) }}" class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation()">
                    <i class="bi bi-eye me-1"></i>{{ 'pasta_lista.resultado.ver'|trans }}
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
{% else %}
    <div class="card demandas-card">
        <div class="demandas-empty">
            <div class="empty-ico"><i class="bi bi-inbox"></i></div>
            {% if temFiltro %}
                <p class="empty-title">{{ 'pasta_lista.resultado.vazio_filtro_titulo'|trans }}</p>
                <p class="text-muted small mb-0">{{ 'pasta_lista.resultado.vazio_filtro_texto'|trans }}</p>
            {% else %}
                <p class="empty-title">{{ 'pasta_lista.resultado.vazio_titulo'|trans }}</p>
                <p class="text-muted small mb-0">{{ 'pasta_lista.resultado.vazio_texto'|trans }}</p>
            {% endif %}
        </div>
    </div>
{% endif %}

{# Tooltips dos clientes (idempotente) — reexecuta a cada troca de fragmento #}
<script>
(function () {
    if (typeof bootstrap === 'undefined') {
        return;
    }
    function esc(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    document.querySelectorAll('#tabelaDemandas .clientes-resumo[data-clientes]').forEach(function (el) {
        var nomes = el.dataset.clientes.split('||');
        var html = nomes.map(function (n) { return '<div>' + esc(n) + '</div>'; }).join('');
        bootstrap.Tooltip.getOrCreateInstance(el, { html: true, trigger: 'hover', placement: el.dataset.bsPlacement || 'right', title: html });
    });
})();
</script>
