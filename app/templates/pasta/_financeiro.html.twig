{#
   Um registro do Relatório financeiro. `raiz` é o registro respondido quando o cartão é uma
   resposta pendurada nele (null para a raiz e para a resposta solta — a órfã, cuja original foi
   excluída, ou a que responde a algo fora do limite). Mesma estrutura do Registro da aba Dados
   (`_dados_anotacoes`): faixa "Resposta a NOME", recuo em `.ps-respostas`, botão de responder
   que aparece com o cartão sob o mouse. O JS (`_financeiro_obs_script`) monta a MESMA marcação.
   `podeEscrever` (C7-FPN-01): EDIT na pasta e pasta viva. Sem ele, nem lápis/lixeira nem
   Responder — nem para o autor dentro da janela (a rota exige EDIT, a lápide recusa o POST).
   `encaminharPasta`: o id da pasta quando o ↪ "Encaminhar via Chat I.A" entra, ou null.
#}
{% macro registro(obs, raiz, pasta, podeEscrever, encaminharPasta) %}
    {% set autor = obs.autor.fullName ?? obs.autor.email ?? '' %}
    {% set partes = autor|trim|split(' ')|filter(p => p is not empty) %}
    {% set iniciais = partes|length > 0
        ? (partes|first|slice(0, 1) ~ (partes|length > 1 ? partes|last|slice(0, 1) : ''))|upper
        : '?' %}
    {# Autor, dentro da janela de 15 min: as mesmas condições do endpoint (o prazo
       vem do MESMO serviço que o UseCase usa — `JanelaDeEdicaoDeComentario`). #}
    {% set pelaRegraFin = obs.autor and app.user and obs.autor.id == app.user.id and comentario_editavel(obs.criadaEm) %}
    {# Edição sem prazo (spec edicao-sem-prazo §1 e §5): Master e primário (com a opção) também editam e excluem; o
       selo aparece quando é o poder que libera. Mesma resposta do servidor (`PrazoDoComentario`). #}
    {% set poderFin = podeEscrever ? sem_prazo_selo(false) : null %}
    {% set seloFin = podeEscrever ? sem_prazo_selo(pelaRegraFin) : null %}
    {% set podeGerenciar = podeEscrever and sem_prazo_libera(pelaRegraFin) %}
    {# Responder a uma resposta liga à RAIZ dela (um nível só), como no desenho. #}
    {% set alvoId = raiz ? raiz.id : obs.id %}
    {% set alvoNome = raiz ? (raiz.autor.fullName ?? raiz.autor.email ?? '') : autor %}
    {% set respostaANome = obs.respostaA ? (obs.respostaA.autor.fullName ?? obs.respostaA.autor.email ?? null) : null %}
    {# Resposta de outro dia que não o da raiz: a hora leva o dia junto ("06/10 · 09:12"). #}
    {% set horaRotulo = (raiz and obs.criadaEm|date('Y-m-d') != raiz.criadaEm|date('Y-m-d'))
        ? obs.criadaEm|date('d/m') ~ ' · ' ~ obs.criadaEm|hora
        : obs.criadaEm|hora %}

    {# `data-obs-do-autor`: só para o motivo do "· bloqueado" do menu (FPN-006b).
       `data-janela-ate` (C6-FPN-05): o fim da janela de edição em epoch (segundos); o menu
       recalcula os minutos por ele a cada abertura, como em Detalhes. #}
    <article class="ps-anotacao{{ obs.resposta ? ' ps-anotacao--resposta' : '' }}" id="financeiro-obs-{{ obs.id }}"
             data-obs-do-autor="{{ obs.autor and app.user and obs.autor.id == app.user.id ? '1' : '0' }}"
             data-janela-ate="{{ obs.criadaEm|date('U') + comentario_janela_minutos() * 60 }}"
             {%- if poderFin and podeGerenciar %} data-sem-prazo-rotulo="{{ ('edicao_sem_prazo.selo.' ~ poderFin)|trans }}"{% endif %}
             {#- Presença do autor (pasta-presenca-autor.js). #}
             {%- if obs.autor %} data-autor-id="{{ obs.autor.id }}"{% endif %}>
        {% if obs.resposta %}
            {# O desenho grava o rótulo em caixa alta; quem põe em maiúsculas é o CSS. #}
            <div class="ps-anotacao-resposta-rot">
                <i class="bi bi-reply-fill" aria-hidden="true"></i>
                <span>{% if respostaANome is not null %}{{ 'pasta_financeiro.registro.resposta_a'|trans({nome: respostaANome}) }}{% else %}{{ 'pasta_financeiro.registro.resposta_orfa'|trans }}{% endif %}</span>
            </div>
        {% endif %}
        <span class="ps-anotacao-ponto" aria-hidden="true"></span>
        <span class="ps-anotacao-seta" aria-hidden="true"></span>
        <div class="ps-anotacao-topo">
            <span class="ps-avatar ps-avatar--24">{{ iniciais }}</span>
            <span class="ps-anotacao-autor">{{ autor ?: 'pasta_financeiro.registro.autor_desconhecido'|trans }}</span>
            {% if obs.editadaEm %}
                <span class="ps-anotacao-editado" title="{{ 'pasta_financeiro.registro.editado_em'|trans({quando: obs.editadaEm|data_hora}) }}">{{ 'pasta_financeiro.registro.editado'|trans }}</span>
            {% endif %}
            <span class="ps-cab-espaco"></span>
            {% if podeGerenciar %}
                <span class="ps-anotacao-acoes">
                    <button type="button"
                            class="ps-anotacao-acao btn-editar-obs{{ seloFin ? ' com-selo-sem-prazo' }}"
                            title="{{ 'pasta_financeiro.registro.editar'|trans }}" aria-label="{{ 'pasta_financeiro.registro.editar'|trans }}"
                            data-obs-id="{{ obs.id }}"
                            data-conteudo="{{ obs.conteudo|e('html_attr') }}"
                            data-conteudo-html="{{ obs.conteudo|registro_texto|e('html_attr') }}"
                            data-csrf="{{ csrf_token('pasta_financeiro_obs_editar_' ~ obs.id) }}"
                            data-url="{{ path('pasta_financeiro_observacao_editar', {id: pasta.id, obsId: obs.id}) }}">
                        <i class="bi bi-pencil"></i>{% include '_partials/_selo_sem_prazo.html.twig' with {poder: seloFin} only %}
                    </button>
                    <button type="button"
                            class="ps-anotacao-acao ps-anotacao-acao--perigo btn-excluir-obs{{ seloFin ? ' com-selo-sem-prazo' }}"
                            title="{{ 'pasta_financeiro.registro.excluir'|trans }}" aria-label="{{ 'pasta_financeiro.registro.excluir'|trans }}"
                            data-obs-id="{{ obs.id }}"
                            data-csrf="{{ csrf_token('pasta_financeiro_obs_excluir_' ~ obs.id) }}"
                            data-url="{{ path('pasta_financeiro_observacao_excluir', {id: pasta.id, obsId: obs.id}) }}">
                        <i class="bi bi-trash3"></i>{% include '_partials/_selo_sem_prazo.html.twig' with {poder: seloFin} only %}
                    </button>
                    {% set minRest = comentario_minutos_restantes(obs.criadaEm) %}
                    {% if not seloFin %}<span class="ps-anotacao-janela small" style="color: var(--ps-label);" title="{{ 'pasta_financeiro.registro.janela_dica'|trans({minutos: minRest}) }}">{{ 'pasta_financeiro.registro.janela'|trans({minutos: minRest}) }}</span>{% endif %}
                </span>
            {% endif %}
            {% if podeEscrever %}
                {# Responder a uma RESPOSTA já começa com "@Nome " do autor dela (desenho `respTxt`). #}
                <button type="button"
                        class="ps-anotacao-acao ps-anotacao-acao--responder btn-responder-obs"
                        title="{{ 'pasta_financeiro.registro.responder'|trans }}" aria-label="{{ 'pasta_financeiro.registro.responder'|trans }}"
                        data-resposta-a="{{ alvoId }}"
                        data-resposta-nome="{{ alvoNome ?: 'pasta_financeiro.registro.autor_desconhecido'|trans }}"
                        {%- if raiz and obs.autor and autor %} data-resposta-autor-id="{{ obs.autor.id }}" data-resposta-autor-nome="{{ autor }}"{% endif %}>
                    <i class="bi bi-reply-fill"></i>
                </button>
            {% endif %}
            {% if encaminharPasta %}
                {# D:1936: o ↪ espelhado, 28×26, depois do Responder e antes da hora; aparece com o
                   cartão sob o mouse, como o Responder (`data-acao`). Só ids: o servidor relê o registro. #}
                <button type="button"
                        class="ps-anotacao-acao ps-anotacao-acao--responder js-encaminhar"
                        title="{{ 'pasta_financeiro.comum.encaminhar'|trans }}" aria-label="{{ 'pasta_financeiro.comum.encaminhar'|trans }}"
                        data-encaminhar-pasta="{{ encaminharPasta }}"
                        data-encaminhar-tipo="registro_financeiro"
                        data-encaminhar-id="{{ obs.id }}">
                    <i class="bi bi-reply-fill" style="display:inline-block;transform:scaleX(-1)"></i>
                </button>
            {% endif %}
            <span class="ps-anotacao-data ps-num" title="{{ obs.criadaEm|date('d/m/Y H:i') }}">{{ horaRotulo }}</span>
        </div>
        <div class="ps-anotacao-corpo">
            <i class="bi bi-megaphone-fill ps-anotacao-icone" aria-hidden="true"></i>
            <div class="ps-anotacao-texto obs-conteudo">
                {# `registro_texto` é o `texto_rico` (sanitiza, `is_safe: html`) com as @menções
                   (`@[Nome](user:ID)`, EDT-010r) em destaque `.ps-mencao` — ver MencoesDoRegistro. #}
                <span class="editor-rico-conteudo"><span class="ql-editor">{{ obs.conteudo|registro_texto }}</span></span>
            </div>
        </div>
    </article>
{% endmacro %}
