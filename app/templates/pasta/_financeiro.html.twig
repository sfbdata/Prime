{# ============================================================================
   Aba Financeiro — fatia 2 do redesenho.
   Desenho aprovado: docs/design/pasta-show/ ("Pasta 1A.dc.html"), Aba 4, na
   revisão de 28/08/2026. Spec: docs/specs/pasta-show-financeiro-fatia2.md.

   Arranjo: faixa de QUATRO cards iguais no topo (Contrato · Pró-bono · Valor da
   causa · Média), depois grade de duas colunas — Relatório financeiro ao centro,
   Arquivos e Pagamentos no trilho.

   Os `id` desta tela são contrato com o JS do fim deste arquivo. Renomear
   qualquer um quebra o envio em silêncio:
   #financeiro-situacao-btn · #financeiro-probono-btn · #financeiro-valor-causa
   #financeiro-media-cpf · #financeiro-docs-lista · #financeiro-upload-input
   #formFinanceiroObservacao · #financeiroObsLista · #psPagamentosCorpo

   Contexto: `pasta`, `financeiro`, `documentosContrato`, `observacoesFinanceiras`,
   `pagamentos` (PastaPagamentosOutput).
   ============================================================================ #}
{# Editor rico (Quill auto-hospedado, sem CDN externo). #}
<link rel="stylesheet" href="{{ asset('js/quill/quill.snow.css') }}">
<link rel="stylesheet" href="{{ asset('css/editor-rico.css') }}">
<script src="{{ asset('js/quill/quill.js') }}"></script>
<script src="{{ asset('js/editor-rico.js') }}" defer></script>

{% set contratoAssinado = pasta.situacaoContrato == 'REGULAR' %}
{% set arquivosVisiveis = 3 %}

{# ── Faixa de status: quatro cards de MESMO peso ──────────────────────────────
   O desenho pede quatro blocos alinhados entre si — rótulo numa linha de 18px e
   o conteúdo na mesma altura nos quatro. Nenhum ganha destaque sobre o outro.
   Arranjo sob teste (PastaFinanceiroArranjoTelaTest). #}
<div class="ps-fin-faixa">

    {# Contrato — o SELO é o botão. O link "marcar como assinado" saiu na revisão
       de 28/08: dois alvos para a mesma ação ensinam o usuário a procurar o
       texto e ignorar o selo. #}
    <div class="ps-fin-bloco">
        <div class="ps-fin-rotulo-linha">
            <span class="ps-fin-rotulo">Contrato</span>
        </div>
        <div class="ps-fin-corpo">
            <button type="button"
                    id="financeiro-situacao-btn"
                    class="ps-fin-selo ps-fin-selo--{{ contratoAssinado ? 'ok' : 'perigo' }}"
                    title="{{ contratoAssinado
                        ? 'Contrato assinado — clique para reabrir como pendente'
                        : 'Contrato pendente — clique para marcar como assinado' }}"
                    data-pasta-id="{{ pasta.id }}"
                    data-situacao-atual="{{ pasta.situacaoContrato }}"
                    data-csrf="{{ csrf_token('pasta_situacao_contrato_' ~ pasta.id) }}"
                    data-url="{{ path('pasta_alternar_situacao_contrato', {id: pasta.id}) }}">
                <i class="bi {{ contratoAssinado ? 'bi-patch-check-fill' : 'bi-hourglass-split' }}"></i>
                <span class="ps-fin-selo-texto">{{ contratoAssinado ? 'Assinado' : 'Pendente' }}</span>
            </button>
        </div>
    </div>

    {# Pró-bono — selo idêntico ao do contrato, porque é o mesmo gesto. #}
    <div class="ps-fin-bloco">
        <div class="ps-fin-rotulo-linha">
            <span class="ps-fin-rotulo">Pró-bono</span>
        </div>
        <div class="ps-fin-corpo">
            <button type="button"
                    id="financeiro-probono-btn"
                    class="ps-fin-selo ps-fin-selo--{{ pasta.proBono ? 'ok' : 'neutro' }}"
                    title="Alternar caso pró-bono"
                    aria-pressed="{{ pasta.proBono ? 'true' : 'false' }}"
                    data-pasta-id="{{ pasta.id }}"
                    data-ativo="{{ pasta.proBono ? '1' : '0' }}"
                    data-csrf="{{ csrf_token('pasta_pro_bono_' ~ pasta.id) }}"
                    data-url="{{ path('pasta_atualizar_pro_bono', {id: pasta.id}) }}">
                <i class="bi {{ pasta.proBono ? 'bi-check2-circle' : 'bi-dash-circle' }}"></i>
                <span class="ps-fin-selo-texto">{{ pasta.proBono ? 'Pró-bono ativo' : 'Não é pró-bono' }}</span>
            </button>
        </div>
    </div>

    {# Honorários contratuais — editável no lugar: clique no número, digite, Enter grava.
       O dado por trás segue sendo o `valor_causa` da pasta (rota, coluna e ids
       inalterados); o dono renomeou só o que a tela mostra. #}
    <div class="ps-fin-bloco"
         id="financeiro-valor-causa-bloco"
         data-csrf="{{ csrf_token('pasta_valor_causa_' ~ pasta.id) }}"
         data-url="{{ path('pasta_atualizar_valor_causa', {id: pasta.id}) }}">
        <div class="ps-fin-rotulo-linha">
            <span class="ps-fin-rotulo">Honorários contratuais</span>
            <span class="ps-cab-espaco"></span>
            <button type="button" class="ps-fin-lapis" id="financeiro-valor-causa-lapis" title="Editar honorários contratuais">
                <i class="bi bi-pencil"></i>
            </button>
        </div>
        <div class="ps-fin-corpo">
            <div id="financeiro-valor-causa"
                 class="ps-fin-numero ps-num"
                 tabindex="0"
                 role="button"
                 title="Clique para editar"
                 data-valor="{{ financeiro.valorCausa ?? '' }}">{{ financeiro.valorCausaFormatado }}</div>
            <input type="text"
                   id="financeiro-valor-causa-input"
                   class="form-control form-control-sm d-none"
                   inputmode="decimal"
                   maxlength="20"
                   placeholder="0,00"
                   aria-label="Honorários contratuais">
            <div class="ps-fin-sub">valor cadastrado na pasta</div>
            <div id="financeiro-valor-causa-erro" class="ps-fin-sub ps-fin-sub--erro d-none"></div>
        </div>
    </div>

    {# Média por CPF — a média das pastas de UM cliente: o principal. Por isso a
       sublinha nomeia esse cliente em vez de contar os vinculados, como mostrava
       o protótipo: "4 clientes vinculados" ao lado de um número que é de um só
       deles diz uma coisa por outra. Desvio do desenho decidido pelo dono
       em 28/08. #}
    <div class="ps-fin-bloco ps-fin-bloco--media">
        <div class="ps-fin-rotulo-linha">
            <span class="ps-fin-rotulo" id="financeiro-media-rotulo">{{ financeiro.mediaRotulo }}</span>
        </div>
        <div class="ps-fin-corpo">
            <div id="financeiro-media-cpf" class="ps-fin-numero ps-num">{{ financeiro.mediaCpfFormatada }}</div>
            <div class="ps-fin-sub" id="financeiro-media-nota"
                 {% if financeiro.clienteNome %}title="Média das pastas deste cliente"{% endif %}>
                {{- financeiro.clienteNome ?? 'Vincule o cliente para calcular' -}}
            </div>
        </div>
    </div>

</div>

<div class="ps-grade">

    {# ── Coluna central: Relatório financeiro ─────────────────────────────────
       Nome da tela de produção; era "Observações financeiras" no handoff antigo.
       Mesmo compositor das anotações do caso — mexer só aqui desalinharia os
       três compositores da tela. #}
    <div class="ps-coluna">
        <section class="ps-card ps-anotacoes" id="financeiroRelatorio">
            <div class="ps-card-cab">
                <h2>Relatório financeiro</h2>
                <span class="ps-contagem" id="financeiro-obs-count">{{ observacoesFinanceiras|length }}</span>
                <span class="ps-cab-espaco"></span>
                <span class="ps-anotacoes-dica">Ctrl + Enter envia</span>
            </div>

            <div class="ps-compositor">
                <form id="formFinanceiroObservacao">
                    <input type="hidden" name="_token" value="{{ csrf_token('pasta_financeiro_obs_' ~ pasta.id) }}">
                    <div class="ps-compositor-caixa">
                        <textarea name="conteudo"
                                  id="financeiroObsConteudo"
                                  data-editor-rico
                                  class="form-control"
                                  rows="2"
                                  maxlength="5000"
                                  placeholder="Registrar combinado, honorário ou movimento financeiro do caso…"></textarea>
                        <div class="ps-compositor-rodape">
                            <span class="ps-compositor-nota">Visível para a equipe</span>
                            <span class="ps-cab-espaco"></span>
                            <button type="submit" class="ps-btn ps-btn--primario" id="btnEnviarObsFinanceiro">Enviar</button>
                        </div>
                    </div>
                </form>
            </div>
            <div id="financeiroObsErro" class="ps-compositor-erro d-none"></div>

            <div id="financeiroObsLista" class="ps-fin-obs-rolagem">
                {% if observacoesFinanceiras is empty %}
                    <div class="ps-vazio" id="financeiroObsVazio">
                        <i class="bi bi-cash-coin"></i>
                        <div class="ps-vazio-titulo">Nada registrado ainda</div>
                        <div class="ps-vazio-nota">Anote acima o que foi combinado de honorário, custas ou reembolso.</div>
                    </div>
                {% else %}
                    {% for obs in observacoesFinanceiras %}
                        {% set autor = obs.autor.fullName ?? obs.autor.email ?? '' %}
                        {% set partes = autor|trim|split(' ')|filter(p => p is not empty) %}
                        {% set iniciais = partes|length > 0
                            ? (partes|first|slice(0, 1) ~ (partes|length > 1 ? partes|last|slice(0, 1) : ''))|upper
                            : '?' %}
                        {# Autor, dentro de 24h: as mesmas condições do endpoint. #}
                        {% set podeGerenciar = obs.autor and app.user and obs.autor.id == app.user.id and date(obs.criadaEm) > date('-24 hours') %}

                        <article class="ps-anotacao" id="financeiro-obs-{{ obs.id }}">
                            <span class="ps-avatar ps-avatar--30">{{ iniciais }}</span>
                            <div class="ps-anotacao-corpo">
                                <div class="ps-anotacao-topo">
                                    <span class="ps-anotacao-autor">{{ autor ?: 'Autor desconhecido' }}</span>
                                    <span class="ps-anotacao-data">{{ obs.criadaEm|date('d/m/Y, H:i') }}</span>
                                    {% if obs.editadaEm %}
                                        <small class="ps-anotacao-data fst-italic">(editado)</small>
                                    {% endif %}
                                    {% if podeGerenciar %}
                                        <span class="ps-anotacao-acoes">
                                            <button type="button"
                                                    class="ps-anotacao-acao btn-editar-obs"
                                                    title="Editar registro"
                                                    data-obs-id="{{ obs.id }}"
                                                    data-conteudo="{{ obs.conteudo|e('html_attr') }}"
                                                    data-conteudo-html="{{ obs.conteudo|texto_rico|e('html_attr') }}"
                                                    data-csrf="{{ csrf_token('pasta_financeiro_obs_editar_' ~ obs.id) }}"
                                                    data-url="{{ path('pasta_financeiro_observacao_editar', {id: pasta.id, obsId: obs.id}) }}">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="ps-anotacao-acao ps-anotacao-acao--perigo btn-excluir-obs"
                                                    title="Excluir registro"
                                                    data-obs-id="{{ obs.id }}"
                                                    data-csrf="{{ csrf_token('pasta_financeiro_obs_excluir_' ~ obs.id) }}"
                                                    data-url="{{ path('pasta_financeiro_observacao_excluir', {id: pasta.id, obsId: obs.id}) }}">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="ps-anotacao-texto obs-conteudo">
                                    {# `texto_rico` sanitiza e já é `is_safe: html`. #}
                                    <span class="editor-rico-conteudo"><span class="ql-editor">{{ obs.conteudo|texto_rico }}</span></span>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                {% endif %}
            </div>
        </section>
    </div>

    {# ── Trilho: Arquivos e Pagamentos ────────────────────────────────────────
       O gerenciador de arquivos NÃO vive mais nesta aba (revisão de 28/08): sem
       busca, sem filtro por categoria, sem "mostrar mais 5" e sem dropzone. Aqui
       ficam no máximo 3 arquivos; o gerenciador completo é a aba Documentos, que
       lista os documentos da pasta sem filtrar categoria — arquivo financeiro
       aparece lá. #}
    <div class="ps-trilho">

        <section class="ps-card" data-trilho="arquivos">
            <div class="ps-card-cab">
                <h2>Arquivos</h2>
                {% if documentosContrato|length > 0 %}
                    <span class="ps-contagem" id="financeiro-docs-contagem">{{ documentosContrato|length }}</span>
                {% endif %}
                <span class="ps-cab-espaco"></span>
                <label class="ps-btn-mini ps-fin-adicionar"
                       title="Adicionar arquivo (PDF, DOCX, JPEG, PNG — máx. 10 MB)">
                    <i class="bi bi-plus-lg"></i> Adicionar
                    <input type="file"
                           id="financeiro-upload-input"
                           accept=".pdf,.docx,.doc,.jpg,.jpeg,.png"
                           hidden
                           data-pasta-id="{{ pasta.id }}"
                           data-csrf="{{ csrf_token('pasta_financeiro_upload_' ~ pasta.id) }}"
                           data-url="{{ path('pasta_financeiro_upload', {id: pasta.id}) }}"
                           data-base-url-renomear="{{ path('pasta_financeiro_documento_renomear', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-excluir="{{ path('pasta_financeiro_documento_excluir', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-visualizar="{{ path('pasta_financeiro_documento_view', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-download="{{ path('pasta_financeiro_documento_download', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}">
                </label>
            </div>

            <div id="financeiro-docs-lista">
                {% if documentosContrato is empty %}
                    <div class="ps-fin-doc-vazio" id="financeiro-docs-vazio">Nenhum arquivo financeiro anexado.</div>
                {% else %}
                    {% for doc in documentosContrato|slice(0, arquivosVisiveis) %}
                        <div class="ps-fin-doc" id="financeiro-doc-{{ doc.id }}">
                            <span class="ps-doc-ext">{{ doc.titulo|split('.')|last|slice(0, 4)|upper }}</span>
                            <div class="ps-fin-doc-corpo">
                                <div class="ps-doc-nome" title="{{ doc.titulo }}">{{ doc.titulo }}</div>
                                <div class="ps-doc-meta">{{ doc.tamanhoBytes|formatar_bytes }} · {{ doc.carregadoEm|date('d/m/Y') }}</div>
                            </div>
                            <div class="ps-fin-doc-acoes">
                                <button type="button"
                                        class="ps-anotacao-acao"
                                        title="Visualizar"
                                        data-bs-toggle="modal"
                                        data-bs-target="#previewDocModal"
                                        data-url="{{ path('pasta_financeiro_documento_view', {id: pasta.id, docId: doc.id}) }}"
                                        data-download="{{ path('pasta_financeiro_documento_download', {id: pasta.id, docId: doc.id}) }}"
                                        data-nome="{{ doc.titulo }}"
                                        data-mime="{{ doc.mimeType }}">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button"
                                        class="ps-anotacao-acao btn-renomear-doc"
                                        title="Renomear"
                                        data-doc-id="{{ doc.id }}"
                                        data-titulo="{{ doc.titulo }}"
                                        data-csrf="{{ csrf_token('pasta_financeiro_renomear_' ~ doc.id) }}"
                                        data-url="{{ path('pasta_financeiro_documento_renomear', {id: pasta.id, docId: doc.id}) }}">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="ps-anotacao-acao ps-anotacao-acao--perigo btn-excluir-doc"
                                        title="Excluir"
                                        data-doc-id="{{ doc.id }}"
                                        data-csrf="{{ csrf_token('pasta_financeiro_excluir_' ~ doc.id) }}"
                                        data-url="{{ path('pasta_financeiro_documento_excluir', {id: pasta.id, docId: doc.id}) }}">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Passou de 3, o resto não some da vista sem dizer para onde foi. #}
            {% if documentosContrato|length > arquivosVisiveis %}
                <div class="ps-fin-doc-excedente" id="financeiro-docs-excedente">
                    <button type="button" class="ps-fin-link" data-ps-ir-aba="documentos-tab">
                        ver os outros {{ documentosContrato|length - arquivosVisiveis }} no gerenciador
                    </button>
                </div>
            {% endif %}

            <div class="ps-fin-rodape">
                <button type="button"
                        id="financeiro-reduzir-btn"
                        class="ps-fin-switch"
                        role="switch"
                        aria-checked="false">
                    <span class="ps-fin-switch-trilho"><span class="ps-fin-switch-knob"></span></span>
                    <span>Reduzir tamanho ao enviar</span>
                </button>
                <div class="ps-fin-sub" id="financeiro-reduzir-nota">Envios mantêm o arquivo original — recomendado para contratos assinados.</div>
                <div id="financeiro-upload-erro" class="ps-fin-sub ps-fin-sub--erro d-none"></div>
                <div id="financeiro-upload-spinner" class="ps-fin-sub d-none">
                    <span class="spinner-border spinner-border-sm me-1"></span>Enviando…
                </div>
            </div>
        </section>

        {# ── Pagamentos ───────────────────────────────────────────────────────
           O que o CLIENTE combinou pagar por este caso. Nada a ver com a
           Cobrança, onde o dinheiro é a dívida de um devedor numa carteira. #}
        <section class="ps-card" data-trilho="pagamentos"
                 id="psPagamentos"
                 data-url-registrar="{{ path('pasta_pagamento_registrar', {id: pasta.id}) }}"
                 data-csrf-registrar="{{ csrf_token('pasta_pagamento_' ~ pasta.id) }}"
                 data-base-url-quitacao="{{ path('pasta_pagamento_alternar_quitacao', {id: pasta.id, pagamentoId: 0})|replace({'/0/': '/__ID__/'}) }}"
                 data-base-url-excluir="{{ path('pasta_pagamento_excluir', {id: pasta.id, pagamentoId: 0})|replace({'/0/': '/__ID__/'}) }}">
            <div class="ps-card-cab">
                <h2>Pagamentos</h2>
                <span class="ps-contagem" id="psPagamentosTotal">{{ pagamentos.total }}</span>
                <span class="ps-cab-espaco"></span>
                {% if pagamentos.total > 0 %}
                    <button type="button" class="ps-fin-link" id="psPagamentosVerTodos"
                            title="Mostrar também os já pagos">ver todos</button>
                {% endif %}
            </div>

            <div id="psPagamentosCorpo">
                {{ include('pasta/_financeiro_pagamentos.html.twig', {pagamentos: pagamentos}) }}
            </div>

            <div class="ps-fin-rodape">
                <button type="button" class="ps-btn ps-fin-btn-largo"
                        data-bs-toggle="modal" data-bs-target="#modalNovoPagamento">
                    <i class="bi bi-plus-lg"></i> Adicionar pagamento
                </button>
            </div>
        </section>

    </div>
</div>

<script>
(function () {
    'use strict';

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // ── Situação do Contrato ──────────────────────────────────────────────────
    // O SELO é o botão: o clique nele alterna Pendente ⇄ Assinado.
    const btnSituacao = document.getElementById('financeiro-situacao-btn');
    if (btnSituacao) {
        btnSituacao.addEventListener('click', async function () {
            const atual = this.dataset.situacaoAtual;
            const nova  = atual === 'PENDENTE' ? 'REGULAR' : 'PENDENTE';

            const fd = new FormData();
            fd.append('_token', this.dataset.csrf);
            fd.append('situacao', nova);

            try {
                const resp = await fetch(this.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();
                if (!resp.ok) { alert(data.erro ?? 'Erro ao alterar situação.'); return; }

                const assinado = data.situacao === 'REGULAR';
                this.dataset.situacaoAtual = data.situacao;
                this.className = 'ps-fin-selo ps-fin-selo--' + (assinado ? 'ok' : 'perigo');
                this.title = assinado
                    ? 'Contrato assinado — clique para reabrir como pendente'
                    : 'Contrato pendente — clique para marcar como assinado';
                this.querySelector('i').className = 'bi ' + (assinado ? 'bi-patch-check-fill' : 'bi-hourglass-split');
                this.querySelector('.ps-fin-selo-texto').textContent = assinado ? 'Assinado' : 'Pendente';
            } catch (_) {
                alert('Erro de rede. Tente novamente.');
            }
        });
    }

    // ── Pró-Bono ─────────────────────────────────────────────────────────────
    const btnProBono = document.getElementById('financeiro-probono-btn');
    if (btnProBono) {
        btnProBono.addEventListener('click', async function () {
            const ativo = this.dataset.ativo === '1';
            const novo  = !ativo;

            const fd = new FormData();
            fd.append('_token', this.dataset.csrf);
            fd.append('pro_bono', novo ? '1' : '0');

            try {
                const resp = await fetch(this.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                if (!resp.ok) { alert('Erro ao salvar pró-bono.'); return; }

                this.dataset.ativo = novo ? '1' : '0';
                this.setAttribute('aria-pressed', novo ? 'true' : 'false');
                this.className = 'ps-fin-selo ps-fin-selo--' + (novo ? 'ok' : 'neutro');
                this.querySelector('i').className = 'bi ' + (novo ? 'bi-check2-circle' : 'bi-dash-circle');
                this.querySelector('.ps-fin-selo-texto').textContent = novo ? 'Pró-bono ativo' : 'Não é pró-bono';
            } catch (_) {
                alert('Erro de rede. Tente novamente.');
            }
        });
    }

    // ── Honorários contratuais (edição no lugar; campo valor_causa) ──────────
    const vcBloco  = document.getElementById('financeiro-valor-causa-bloco');
    const vcTexto  = document.getElementById('financeiro-valor-causa');
    const vcInput  = document.getElementById('financeiro-valor-causa-input');
    const vcErro   = document.getElementById('financeiro-valor-causa-erro');
    const vcLapis  = document.getElementById('financeiro-valor-causa-lapis');
    const vcMedia  = document.getElementById('financeiro-media-cpf');

    if (vcBloco && vcTexto && vcInput) {
        // O que já está gravado vem em decimal ("12860.00"); o campo de edição
        // fala pt-BR, que é como o humano digita e como o back aceita de volta.
        function paraPtBr(decimal) {
            if (!decimal) return '';
            const [inteiro, centavos] = decimal.split('.');
            return inteiro.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + (centavos ?? '00');
        }

        // Guarda o que estava no campo ao abrir: sair sem mexer não é edição, e
        // não pode virar gravação nem linha de auditoria.
        let vcValorAoAbrir = '';
        let vcGravando     = false;

        function abrirEdicao() {
            vcErro.classList.add('d-none');
            vcInput.value  = paraPtBr(vcTexto.dataset.valor);
            vcValorAoAbrir = vcInput.value;
            vcTexto.classList.add('d-none');
            vcInput.classList.remove('d-none');
            vcInput.focus();
            vcInput.select();
        }

        function fecharEdicao() {
            vcInput.classList.add('d-none');
            vcTexto.classList.remove('d-none');
        }

        async function gravar() {
            if (vcGravando) { return; }
            vcGravando = true;

            const fd = new FormData();
            fd.append('_token', vcBloco.dataset.csrf);
            fd.append('valor_causa', vcInput.value);

            try {
                const resp = await fetch(vcBloco.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();

                if (!resp.ok) {
                    vcErro.textContent = data.erro ?? 'Erro ao salvar.';
                    vcErro.classList.remove('d-none');
                    vcInput.focus();
                    return;
                }

                vcTexto.dataset.valor = data.valor ?? '';
                vcTexto.textContent   = data.valorFormatado;
                vcValorAoAbrir        = vcInput.value;
                // A média é do cliente, não da pasta: mudar o valor aqui muda o
                // número ao lado, que volta recalculado do servidor.
                if (vcMedia && typeof data.mediaFormatada !== 'undefined') {
                    vcMedia.textContent = data.mediaFormatada;
                }
                vcErro.classList.add('d-none');
                fecharEdicao();
            } catch (_) {
                vcErro.textContent = 'Erro de rede. Tente novamente.';
                vcErro.classList.remove('d-none');
            } finally {
                vcGravando = false;
            }
        }

        vcTexto.addEventListener('click', abrirEdicao);
        vcTexto.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrirEdicao(); }
        });
        if (vcLapis) { vcLapis.addEventListener('click', abrirEdicao); }

        vcInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); gravar(); }
            if (e.key === 'Escape') { e.preventDefault(); fecharEdicao(); }
        });
        vcInput.addEventListener('blur', function () {
            if (vcInput.classList.contains('d-none')) { return; }

            // Abrir e sair sem mexer não é edição: fecha e pronto, sem gravar e sem
            // gerar linha de auditoria com o valor que já estava lá.
            if (vcInput.value === vcValorAoAbrir) { fecharEdicao(); return; }

            // Mudou de verdade: grava, como o resto da aba já faz (pró-bono e
            // contrato salvam sozinhos). Com erro na tela o campo fica aberto.
            gravar();
        });
    }

    // ── Switch "reduzir tamanho ao enviar" ───────────────────────────────────
    // A nota de apoio é CONSEQUÊNCIA do estado, não um aviso fixo ao lado: era
    // texto cinza permanente e ninguém lia.
    const reduzirBtn  = document.getElementById('financeiro-reduzir-btn');
    const reduzirNota = document.getElementById('financeiro-reduzir-nota');
    if (reduzirBtn) {
        reduzirBtn.addEventListener('click', function () {
            const ligado = this.getAttribute('aria-checked') !== 'true';
            this.setAttribute('aria-checked', ligado ? 'true' : 'false');
            this.classList.toggle('is-ligado', ligado);
            if (reduzirNota) {
                reduzirNota.textContent = ligado
                    ? 'Atenção: um PDF assinado digitalmente pode perder a assinatura ao ser reduzido.'
                    : 'Envios mantêm o arquivo original — recomendado para contratos assinados.';
                reduzirNota.classList.toggle('ps-fin-sub--aviso', ligado);
            }
        });
    }

    // ── Upload de arquivo ─────────────────────────────────────────────────────
    const uploadInput   = document.getElementById('financeiro-upload-input');
    const docLista      = document.getElementById('financeiro-docs-lista');
    const uploadErro    = document.getElementById('financeiro-upload-erro');
    const uploadSpinner = document.getElementById('financeiro-upload-spinner');

    // Espelha o `arquivosVisiveis` do Twig acima: os dois lados têm de contar o
    // mesmo teto, senão a lista cresce no navegador e encolhe na recarga.
    const MAX_ARQUIVOS = {{ arquivosVisiveis }};

    /** A contagem do cabeçalho segue o total do SERVIDOR, não o que está à vista. */
    function atualizarContagemDocs(delta) {
        const cab = document.querySelector('[data-trilho="arquivos"] .ps-card-cab');
        if (!cab) { return; }

        let badge = document.getElementById('financeiro-docs-contagem');
        if (!badge) {
            badge = document.createElement('span');
            badge.className = 'ps-contagem';
            badge.id = 'financeiro-docs-contagem';
            badge.textContent = '0';
            cab.querySelector('h2').after(badge);
        }
        badge.textContent = String(Math.max(0, (parseInt(badge.textContent, 10) || 0) + delta));
    }

    /** Atalho para o gerenciador quando há mais arquivos do que o card mostra. */
    function mostrarExcedente() {
        if (document.getElementById('financeiro-docs-excedente')) { return; }

        const bloco = document.createElement('div');
        bloco.className = 'ps-fin-doc-excedente';
        bloco.id = 'financeiro-docs-excedente';
        bloco.innerHTML = '<button type="button" class="ps-fin-link" data-ps-ir-aba="documentos-tab">'
            + 'ver os demais no gerenciador</button>';
        bloco.querySelector('button').addEventListener('click', function () {
            const gatilho = document.getElementById('documentos-tab');
            if (gatilho && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(gatilho).show(); }
        });
        docLista.after(bloco);
    }

    function extDoTitulo(titulo) {
        const ponto = String(titulo).lastIndexOf('.');
        return ponto > 0 ? String(titulo).slice(ponto + 1, ponto + 5).toUpperCase() : '?';
    }

    function criarItemDoc(id, titulo, mimeType, urlVisualizar, urlDownload, urlRenomear, csrfRenomear, urlExcluir, csrfExcluir, meta) {
        const div = document.createElement('div');
        div.className = 'ps-fin-doc';
        div.id = 'financeiro-doc-' + id;
        div.innerHTML = `
            <span class="ps-doc-ext">${esc(extDoTitulo(titulo))}</span>
            <div class="ps-fin-doc-corpo">
                <div class="ps-doc-nome" title="${esc(titulo)}">${esc(titulo)}</div>
                <div class="ps-doc-meta">${esc(meta ?? '')}</div>
            </div>
            <div class="ps-fin-doc-acoes">
                <button type="button"
                        class="ps-anotacao-acao"
                        title="Visualizar"
                        data-bs-toggle="modal"
                        data-bs-target="#previewDocModal"
                        data-url="${esc(urlVisualizar)}"
                        data-download="${esc(urlDownload)}"
                        data-nome="${esc(titulo)}"
                        data-mime="${esc(mimeType)}">
                    <i class="bi bi-eye"></i>
                </button>
                <button type="button"
                        class="ps-anotacao-acao btn-renomear-doc"
                        title="Renomear"
                        data-doc-id="${id}"
                        data-titulo="${esc(titulo)}"
                        data-csrf="${esc(csrfRenomear)}"
                        data-url="${esc(urlRenomear)}">
                    <i class="bi bi-pencil"></i>
                </button>
                <button type="button"
                        class="ps-anotacao-acao ps-anotacao-acao--perigo btn-excluir-doc"
                        title="Excluir"
                        data-doc-id="${id}"
                        data-csrf="${esc(csrfExcluir)}"
                        data-url="${esc(urlExcluir)}">
                    <i class="bi bi-trash3"></i>
                </button>
            </div>`;
        return div;
    }

    if (uploadInput) {
        uploadInput.addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;

            const url      = this.dataset.url;
            const csrf     = this.dataset.csrf;
            const baseRen  = this.dataset.baseUrlRenomear;
            const baseExc  = this.dataset.baseUrlExcluir;
            const baseVis  = this.dataset.baseUrlVisualizar;
            const baseDl   = this.dataset.baseUrlDownload;

            uploadErro.classList.add('d-none');
            uploadSpinner.classList.remove('d-none');

            const fd = new FormData();
            fd.append('_token', csrf);
            fd.append('arquivo', file);
            fd.append('reduzir_tamanho', reduzirBtn && reduzirBtn.getAttribute('aria-checked') === 'true' ? '1' : '0');

            try {
                const resp = await fetch(url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();

                if (!resp.ok) {
                    uploadErro.textContent = data.erro ?? 'Erro ao enviar arquivo.';
                    uploadErro.classList.remove('d-none');
                    return;
                }

                const vazioMsg = document.getElementById('financeiro-docs-vazio');
                if (vazioMsg) { vazioMsg.remove(); }

                const urlRen = baseRen.replace('__ID__', data.id);
                const urlExc = baseExc.replace('__ID__', data.id);
                const urlVis = baseVis ? baseVis.replace('__ID__', data.id) : data.urlVisualizar;
                const urlDl  = baseDl  ? baseDl.replace('__ID__', data.id)  : data.urlDownload;

                // O trilho mostra no máximo TRÊS. Passando disso a lista curta não
                // cresce: o arquivo existe no servidor e o atalho para o
                // gerenciador aparece. Sem isto o card inchava até o rodapé sair
                // da vista, contrariando o desenho no caso em que ele mais importa.
                if (docLista.querySelectorAll('.ps-fin-doc').length < MAX_ARQUIVOS) {
                    docLista.appendChild(
                        criarItemDoc(data.id, data.titulo, data.mimeType, urlVis, urlDl, urlRen, data.csrfRenomear, urlExc, data.csrfExcluir, data.meta)
                    );
                } else {
                    mostrarExcedente();
                }
                atualizarContagemDocs(+1);
            } catch (_) {
                uploadErro.textContent = 'Erro de rede. Tente novamente.';
                uploadErro.classList.remove('d-none');
            } finally {
                uploadSpinner.classList.add('d-none');
                this.value = '';
            }
        });
    }

    // ── Renomear / Excluir arquivo ────────────────────────────────────────────
    if (docLista) {
        docLista.addEventListener('click', async function (e) {

            const btnRen = e.target.closest('.btn-renomear-doc');
            if (btnRen) {
                const docId  = btnRen.dataset.docId;
                const item   = document.getElementById('financeiro-doc-' + docId);
                const spanTitulo = item.querySelector('.ps-doc-nome');
                const tituloAtual = btnRen.dataset.titulo;

                // Isola a extensão para protegê-la da edição
                const pontoIdx = tituloAtual.lastIndexOf('.');
                const nomeBase = pontoIdx > 0 ? tituloAtual.slice(0, pontoIdx) : tituloAtual;
                const extensao = pontoIdx > 0 ? tituloAtual.slice(pontoIdx) : '';

                const wrapper = document.createElement('div');
                wrapper.className = 'ps-fin-doc-renomear';

                const input = document.createElement('input');
                input.type = 'text';
                input.className = 'form-control form-control-sm';
                input.value = nomeBase;

                wrapper.appendChild(input);
                if (extensao) {
                    const extSpan = document.createElement('span');
                    extSpan.className = 'ps-doc-meta';
                    extSpan.textContent = extensao;
                    wrapper.appendChild(extSpan);
                }

                spanTitulo.replaceWith(wrapper);
                input.focus();
                input.select();

                function restaurarSpan(titulo) {
                    const span = document.createElement('div');
                    span.className = 'ps-doc-nome';
                    span.title = titulo;
                    span.textContent = titulo;
                    wrapper.replaceWith(span);
                    return span;
                }

                async function confirmarRenomear() {
                    const novoBase   = input.value.trim();
                    const novoTitulo = novoBase !== '' ? novoBase + extensao : tituloAtual;
                    if (novoBase === '' || novoTitulo === tituloAtual) {
                        restaurarSpan(tituloAtual);
                        return;
                    }

                    const fd = new FormData();
                    fd.append('_token', btnRen.dataset.csrf);
                    fd.append('titulo', novoTitulo);

                    try {
                        const resp = await fetch(btnRen.dataset.url, {
                            method: 'POST',
                            body: fd,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        });
                        const data = await resp.json();
                        const titulo = resp.ok ? data.titulo : tituloAtual;
                        if (!resp.ok) { alert(data.erro ?? 'Erro ao renomear.'); }
                        restaurarSpan(titulo);
                        btnRen.dataset.titulo = titulo;
                        // Mantém o pré-visualizador e o selo de extensão coerentes.
                        const btnPrevItem = item.querySelector('[data-bs-target="#previewDocModal"]');
                        if (btnPrevItem) { btnPrevItem.dataset.nome = titulo; }
                        const selo = item.querySelector('.ps-doc-ext');
                        if (selo) { selo.textContent = extDoTitulo(titulo); }
                    } catch (_) {
                        alert('Erro de rede.');
                        restaurarSpan(tituloAtual);
                    }
                }

                input.addEventListener('blur', confirmarRenomear);
                input.addEventListener('keydown', function (ev) {
                    if (ev.key === 'Enter') { ev.preventDefault(); confirmarRenomear(); }
                    if (ev.key === 'Escape') { restaurarSpan(tituloAtual); }
                });

                return;
            }

            const btnExc = e.target.closest('.btn-excluir-doc');
            if (btnExc) {
                if (!confirm('Excluir este arquivo? Esta ação não pode ser desfeita.')) return;

                const docId = btnExc.dataset.docId;
                const fd    = new FormData();
                fd.append('_token', btnExc.dataset.csrf);

                try {
                    const resp = await fetch(btnExc.dataset.url, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    if (resp.ok) {
                        document.getElementById('financeiro-doc-' + docId)?.remove();
                        atualizarContagemDocs(-1);
                        if (docLista.children.length === 0) {
                            const vazio = document.createElement('div');
                            vazio.className = 'ps-fin-doc-vazio';
                            vazio.id = 'financeiro-docs-vazio';
                            vazio.textContent = 'Nenhum arquivo financeiro anexado.';
                            docLista.appendChild(vazio);
                        }
                    } else {
                        const data = await resp.json();
                        alert(data.erro ?? 'Erro ao excluir.');
                    }
                } catch (_) {
                    alert('Erro de rede.');
                }
            }
        });
    }
})();
</script>

