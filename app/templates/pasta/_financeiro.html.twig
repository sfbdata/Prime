{# ============================================================================
   Aba Financeiro — fatia 2 do redesenho.
   Desenho aprovado: docs/design/pasta-show/ ("Pasta 1A.dc.html"), Aba 4, na
   revisão de 28/08/2026. Spec: docs/specs/pasta-show-financeiro-fatia2.md.

   Arranjo (dc 31.10): grade de duas colunas — Relatório financeiro ao centro; no trilho,
   o cartão único de status (Contrato · Pró-bono · Valor da causa · Média), Contratos e Pagamentos.

   Os `id` desta tela são contrato com o JS do fim deste arquivo. Renomear
   qualquer um quebra o envio em silêncio:
   #financeiro-situacao-btn · #financeiro-probono-btn · #financeiro-total-contratado
   #financeiro-media-cpf · #financeiro-docs-lista · #financeiro-upload-input
   #formFinanceiroObservacao · #financeiroObsLista · #psPagamentosCorpo

   Contexto: `pasta`, `financeiro`, `documentosContrato`, `observacoesFinanceiras`,
   `pagamentos` (PastaPagamentosOutput), `podeEditarPasta` (do show; fallback: aqui).
   ============================================================================ #}
{# Editor rico (Quill auto-hospedado, sem CDN externo). #}
<link rel="stylesheet" href="{{ asset('js/quill/quill.snow.css') }}">
<link rel="stylesheet" href="{{ asset('css/editor-rico.css') }}">
<script src="{{ asset('js/quill/quill.js') }}"></script>
<script src="{{ asset('js/editor-rico.js') }}" defer></script>

{% import _self as fin %}

{# C7-FPN-01 (convenção PAS-014/PAS-025c: o que o servidor recusa não aparece): toda escrita
   desta aba — selos de Contrato e Pró-bono, Relatório financeiro (enviar, responder,
   editar, excluir), arquivos (adicionar, renomear, excluir) e Pagamentos (adicionar, corrigir,
   quitar, excluir) — exige EDIT na pasta, e na lápide o `PastaSomenteLeituraListener` recusa
   todo POST. Sem os dois, nada disso é montado; ficam ver, copiar, baixar e imprimir. Os selos
   seguem à vista, como texto: eles também dizem o estado. #}
{% set podeEditarPasta = podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit') %}
{% set finPastaLapide = pasta.estaExcluida %}
{% set podeEscreverFin = podeEditarPasta and not finPastaLapide %}
{# "Encaminhar via Chat I.A" (D:1936, D:6305 e D:6958): a Central conferida UMA vez (cada chamada
   consulta o vínculo). Na lápide o servidor dá 404 ao despacho (spec §2.11): nada a oferecer. É o
   id da pasta ou null. Aba oculta não restringe (spec §2.2). #}
{% set encaminharPasta = central_disponivel() and not finPastaLapide ? pasta.id : null %}

{# Contrato só consta como Assinado com o arquivo do contrato anexado (dc 27.10): a marca sozinha não basta. #}
{% set contratoAssinado = pasta.situacaoContrato == 'REGULAR' and documentosContrato is not empty %}
{% set arquivosVisiveis = 3 %}

{# "Enviar por e-mail ao cliente" do ⋮ do arquivo (desenho 1.2.3, dc 6546): é um
   `mailto:` e nada mais — o sistema não envia e-mail nem anexa o arquivo; abre o
   programa de e-mail de quem clicou com destinatário, assunto e corpo prontos.
   O destinatário é o e-mail do cliente PRINCIPAL, o mesmo que a aba Dados mostra.
   Só entra endereço com cara de endereço: o charset fechado garante que nada do
   cadastro vire `?`, `&` ou `#` dentro do link. Assunto e corpo saem por
   `url_encode` (o JS de upload/renomear espelha com `encodeURIComponent`).
   Sem e-mail cadastrado, o item leva à aba Dados com o aviso do desenho. #}
{% set emailCliente = pasta.clientePrincipal ? pasta.clientePrincipal.email|trim : '' %}
{% set emailCliente = emailCliente matches '/^[A-Za-z0-9._+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$/' ? emailCliente : '' %}
{% set rotuloPastaEmail = pasta.nup ?? ('#' ~ pasta.id) %}

<div class="ps-grade">

    {# ── Coluna central: Relatório financeiro ─────────────────────────────────
       Nome da tela de produção; era "Observações financeiras" no handoff antigo.
       Mesmo compositor das anotações do caso — mexer só aqui desalinharia os
       três compositores da tela. #}
    <div class="ps-coluna">
        <section class="ps-card ps-anotacoes" id="financeiroRelatorio">
            <div class="ps-card-cab ps-card-cab--painel">
                <h2>{{ 'pasta_financeiro.relatorio.titulo'|trans }}</h2>
                <span class="ps-fin-cab-sub">{{ 'pasta_financeiro.relatorio.subtitulo'|trans }}</span>
                {% set idsContagemFin = observacoesFinanceiras|map(o => o.id) %}
                <span class="ps-contagem" id="financeiro-obs-count" title="{{ 'pasta_financeiro.relatorio.contagem_dica'|trans }}">{{ observacoesFinanceiras|filter(o => o.respostaA is null or o.respostaA.id not in idsContagemFin)|length }}</span>
            </div>

            {# C7-FPN-01: sem escrita, o compositor nem é montado. Na lápide entra a nota de só leitura
               (a de Detalhes e do Registro, PAS-025c); para quem só vê a pasta viva, nada. O JS
               (`_financeiro_obs_script`) já tolera a falta do #formFinanceiroObservacao. #}
            {% if finPastaLapide %}
            <div class="ps-compositor ps-compositor--leitura" id="financeiroObsSomenteLeitura">
                <span class="ps-compositor-nota"><i class="bi bi-lock" aria-hidden="true"></i> {{ 'pasta_financeiro.relatorio.somente_leitura'|trans }}</span>
            </div>
            {% elseif podeEscreverFin %}
            <div class="ps-compositor">
                <form id="formFinanceiroObservacao">
                    <input type="hidden" name="_token" value="{{ csrf_token('pasta_financeiro_obs_' ~ pasta.id) }}">
                    {# @menção (EDT-010r): o pasta-mencoes.js (carregado pela pasta_show, em `_dados_anotacoes`)
                       liga o "@" deste compositor e busca a lista nesta URL. A `origem=financeiro`
                       (C6-SEC-02b) deixa na lista só quem também vê o financeiro da pasta; o JS só
                       acrescenta `&q=` (a mesma URL serve à caixa de edição, no _financeiro_obs_script). #}
                    <div class="ps-compositor-caixa" data-mencionaveis-url="{{ path('pasta_mencionaveis', {id: pasta.id, origem: 'financeiro'}) }}">
                        <textarea name="conteudo"
                                  id="financeiroObsConteudo"
                                  data-editor-rico
                                  class="form-control"
                                  rows="2"
                                  maxlength="5000"
                                  placeholder="{{ 'pasta_financeiro.relatorio.placeholder'|trans }}"></textarea>
                        <div class="ps-compositor-rodape">
                            <span class="ps-compositor-nota">{{ 'pasta_financeiro.relatorio.visivel_equipe'|trans }}</span>
                            <span class="ps-cab-espaco"></span>
                            <button type="submit" class="ps-btn ps-btn--primario" id="btnEnviarObsFinanceiro" title="{{ 'pasta_financeiro.relatorio.enviar_dica'|trans }}">{{ 'pasta_financeiro.relatorio.enviar'|trans }}</button>
                        </div>
                    </div>
                </form>
            </div>
            {% endif %}
            <div id="financeiroObsErro" class="ps-compositor-erro d-none"></div>

            <div id="financeiroObsLista" class="ps-registro ps-fin-obs-rolagem{{ observacoesFinanceiras is empty ? ' ps-registro--vazio' : '' }}" data-hoje="{{ 'now'|date('Y-m-d') }}"
                 {%- if encaminharPasta %} data-encaminhar-pasta="{{ encaminharPasta }}"{% endif %}>
                {% if observacoesFinanceiras is empty %}
                    <div class="ps-vazio" id="financeiroObsVazio">
                        <i class="bi bi-cash-coin"></i>
                        <div class="ps-vazio-titulo">{{ 'pasta_financeiro.relatorio.vazio_titulo'|trans }}</div>
                        {# O convite "Anote acima…" só para quem tem o compositor acima (C7-FPN-01). #}
                        {% if podeEscreverFin %}
                        <div class="ps-vazio-nota">{{ 'pasta_financeiro.relatorio.vazio_nota'|trans }}</div>
                        {% endif %}
                    </div>
                {% else %}
                    {% set mesesFin = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'] %}
                    {% set diaAnteriorFin = null %}
                    {# Responder (FPN-005): a resposta não entra na linha do tempo por conta própria —
                       fica recuada sob a raiz, da mais antiga à mais nova, e não data nem conta a
                       raiz. Vira item de primeiro nível a que não tem a raiz à mão: a órfã (original
                       excluída) e a que responde a uma raiz fora do limite da consulta. #}
                    {% set idsFin = observacoesFinanceiras|map(o => o.id) %}
                    {% for obs in observacoesFinanceiras|filter(o => o.respostaA is null or o.respostaA.id not in idsFin) %}
                        {% set diaFin = obs.criadaEm|date('Y-m-d') %}

                        {# Linha do tempo do desenho 1.2.3: pílula do dia, cartão com ponto e seta.
                           A MESMA estrutura é montada em JS (`inserirItemObs`, no script ao lado). #}
                        {% if diaFin != diaAnteriorFin %}
                            <div class="ps-dia" data-dia="{{ diaFin }}">
                                <span class="ps-dia-pilula">{{ obs.criadaEm|date('j') }} {{ mesesFin[obs.criadaEm|date('n') - 1] }} {{ obs.criadaEm|date('Y') }}</span>
                            </div>
                            {% set diaAnteriorFin = diaFin %}
                        {% endif %}

                        {{ fin.registro(obs, null, pasta, podeEscreverFin, encaminharPasta) }}

                        {% set respostasFin = observacoesFinanceiras|filter(o => o.respostaA is not null and o.respostaA.id == obs.id)|reverse %}
                        {% if respostasFin|length > 0 %}
                            <div class="ps-respostas" data-resposta-de="{{ obs.id }}">
                                {% for resposta in respostasFin %}
                                    {{ fin.registro(resposta, obs, pasta, podeEscreverFin, encaminharPasta) }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>

            {# Botão direito no registro (dc L.1795 `onContextMenu`, menu dc L.5958; FPN-006). UM menu
               para a lista, preenchido pelo script do fim deste arquivo com o registro clicado.
               "Editar" e "Excluir" clicam os botões da janela de 15 min que o cartão traz (autor,
               dentro do prazo): o caminho é o de sempre. Sem eles — ou passada a janela com a página
               aberta (C6-FPN-05) —, os dois itens ficam À VISTA, "Editar · bloqueado" /
               "Excluir · bloqueado" com cadeado, e o clique diz o motivo num aviso neutro, como no
               desenho (dc L.5958 `gmAviso(pm.motivo)`; FPN-006b, C7-FPN-02). "Responder" (FPN-005)
               clica o botão de responder do cartão.
               C7-FPN-01: quem não escreve (só vê a pasta, ou lápide) não recebe Responder, nem
               Editar/Excluir, nem bloqueados — o motivo seria de permissão, não de prazo ou de
               autoria (PAS-014/025c; igual a Detalhes). "Encaminhar via Chat I.A" (D:6305, FPN-007)
               vem logo depois de Copiar texto, só com a Central e fora da lápide, e clica o ↪ do
               cartão (D:1936). "Destacar" e "Remover destaque" entram pelo pasta-destaque.js. #}
            <div class="ps-fin-menu" id="financeiroObsMenu" role="menu" aria-label="{{ 'pasta_financeiro.menu_registro.rotulo'|trans }}" hidden>
                <div class="ps-fin-menu-titulo"></div>
                {% if podeEscreverFin %}
                    <button type="button" class="ps-fin-menu-item js-fin-obs-responder" role="menuitem">
                        <i class="bi bi-reply-fill" aria-hidden="true"></i><span>{{ 'pasta_financeiro.menu_registro.responder'|trans }}</span>
                    </button>
                {% endif %}
                <button type="button" class="ps-fin-menu-item js-fin-obs-copiar" role="menuitem">
                    <i class="bi bi-clipboard" aria-hidden="true"></i><span>{{ 'pasta_financeiro.menu_registro.copiar'|trans }}</span>
                </button>
                {% if encaminharPasta %}
                    <button type="button" class="ps-fin-menu-item js-fin-obs-encaminhar" role="menuitem">
                        <i class="bi bi-send" aria-hidden="true"></i><span>{{ 'pasta_financeiro.comum.encaminhar'|trans }}</span>
                    </button>
                {% endif %}
                {% if podeEscreverFin %}
                <div class="ps-fin-menu-sep" role="separator"></div>
                <button type="button" class="ps-fin-menu-item js-fin-obs-editar js-fin-obs-gerenciar" role="menuitem">
                    <i class="bi bi-pencil" aria-hidden="true"></i><span>{{ 'pasta_financeiro.menu_registro.editar'|trans }}</span>
                </button>
                <button type="button" class="ps-fin-menu-item ps-fin-menu-item--perigo js-fin-obs-excluir js-fin-obs-gerenciar" role="menuitem">
                    <i class="bi bi-trash3" aria-hidden="true"></i><span>{{ 'pasta_financeiro.menu_registro.excluir'|trans }}</span>
                </button>
                {% endif %}
                {# Sem "Imprimir": no desenho (dc L.6454-6466, menuObs/extrasObs) ele mora só no ⋮
                   da observação de Detalhes. #}
            </div>
        </section>
    </div>

    {# ── Trilho: Arquivos e Pagamentos ────────────────────────────────────────
       O gerenciador de arquivos NÃO vive mais nesta aba (revisão de 28/08): sem
       busca, sem filtro por categoria, sem "mostrar mais 5" e sem dropzone. Aqui
       ficam no máximo 3 arquivos; o gerenciador completo é a aba Documentos, que
       lista os documentos da pasta sem filtrar categoria — arquivo financeiro
       aparece lá. #}
    <div class="ps-trilho">

    {# ── Cartão único de status, no topo do trilho (dc 31.10, L1942): aviso de vencidas, Contrato,
       Pró-bono, Valor da causa (Total contratado) e Média por CPF, como LINHAS de um só cartão.
       Arranjo sob teste (PastaFinanceiroArranjoTelaTest). ─────────────────────────────── #}
    <div class="ps-fin-faixa">

        {# Aviso de parcelas vencidas: primeira linha do cartão, vermelha, só aparece com atraso (dc 27.10).
           O script de Pagamentos reescreve o texto e o `hidden` a cada resposta. #}
        <div class="ps-fin-vencidas" id="financeiro-vencidas"{% if pagamentos.vencidasQuantidade == 0 %} hidden{% endif %}>
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>{{ (pagamentos.vencidasQuantidade == 1 ? 'pasta_financeiro.vencidas.uma' : 'pasta_financeiro.vencidas.varias')|trans({n: pagamentos.vencidasQuantidade, valor: pagamentos.vencidasFormatado}) }}</span>
        </div>

        {# Contrato — o SELO é o botão. O link "marcar como assinado" saiu na revisão
           de 28/08: dois alvos para a mesma ação ensinam o usuário a procurar o
           texto e ignorar o selo. #}
        <div class="ps-fin-bloco">
            <div class="ps-fin-rotulo-linha">
                <span class="ps-fin-rotulo">{{ 'pasta_financeiro.contrato.rotulo'|trans }}</span>
            </div>
            <div class="ps-fin-corpo ps-fin-corpo--selo">
                {% if not podeEscreverFin %}
                {# Quem não escreve lê o estado: o mesmo selo, sem gesto (C7-FPN-01). #}
                <span class="ps-fin-selo ps-fin-selo--{{ contratoAssinado ? 'ok' : 'perigo' }}"
                      id="financeiro-situacao-selo"
                      style="cursor: default;"
                      title="{{ contratoAssinado ? 'pasta_financeiro.contrato.assinado_titulo'|trans : 'pasta_financeiro.contrato.pendente_titulo'|trans }}">
                    <i class="bi {{ contratoAssinado ? 'bi-patch-check-fill' : 'bi-hourglass-split' }}"></i>
                    <span class="ps-fin-selo-texto">{{ contratoAssinado ? 'pasta_financeiro.contrato.assinado'|trans : 'pasta_financeiro.contrato.pendente'|trans }}</span>
                </span>
                {% else %}
                <button type="button"
                        id="financeiro-situacao-btn"
                        class="ps-fin-selo ps-fin-selo--{{ contratoAssinado ? 'ok' : 'perigo' }}"
                        title="{{ contratoAssinado
                            ? 'pasta_financeiro.contrato.assinado_dica'|trans
                            : 'pasta_financeiro.contrato.pendente_dica'|trans }}"
                        data-pasta-id="{{ pasta.id }}"
                        data-situacao-atual="{{ pasta.situacaoContrato }}"
                        data-csrf="{{ csrf_token('pasta_situacao_contrato_' ~ pasta.id) }}"
                        data-url="{{ path('pasta_alternar_situacao_contrato', {id: pasta.id}) }}">
                    <i class="bi {{ contratoAssinado ? 'bi-patch-check-fill' : 'bi-hourglass-split' }}"></i>
                    <span class="ps-fin-selo-texto">{{ contratoAssinado ? 'pasta_financeiro.contrato.assinado'|trans : 'pasta_financeiro.contrato.pendente'|trans }}</span>
                </button>
                {% endif %}
            </div>
        </div>

        {# Pró-bono — selo idêntico ao do contrato, porque é o mesmo gesto. #}
        <div class="ps-fin-bloco">
            <div class="ps-fin-rotulo-linha">
                <span class="ps-fin-rotulo">{{ 'pasta_financeiro.pro_bono.rotulo'|trans }}</span>
            </div>
            <div class="ps-fin-corpo ps-fin-corpo--selo">
                {% if not podeEscreverFin %}
                <span class="ps-fin-selo ps-fin-selo--{{ pasta.proBono ? 'ok' : 'neutro' }}"
                      id="financeiro-probono-selo"
                      style="cursor: default;">
                    <i class="bi {{ pasta.proBono ? 'bi-check2-circle' : 'bi-dash-circle' }}"></i>
                    <span class="ps-fin-selo-texto">{{ pasta.proBono ? 'pasta_financeiro.pro_bono.ativo'|trans : 'pasta_financeiro.pro_bono.inativo'|trans }}</span>
                </span>
                {% else %}
                <button type="button"
                        id="financeiro-probono-btn"
                        class="ps-fin-selo ps-fin-selo--{{ pasta.proBono ? 'ok' : 'neutro' }}"
                        title="{{ 'pasta_financeiro.pro_bono.alternar'|trans }}"
                        aria-pressed="{{ pasta.proBono ? 'true' : 'false' }}"
                        data-pasta-id="{{ pasta.id }}"
                        data-ativo="{{ pasta.proBono ? '1' : '0' }}"
                        data-csrf="{{ csrf_token('pasta_pro_bono_' ~ pasta.id) }}"
                        data-url="{{ path('pasta_atualizar_pro_bono', {id: pasta.id}) }}">
                    <i class="bi {{ pasta.proBono ? 'bi-check2-circle' : 'bi-dash-circle' }}"></i>
                    <span class="ps-fin-selo-texto">{{ pasta.proBono ? 'pasta_financeiro.pro_bono.ativo'|trans : 'pasta_financeiro.pro_bono.inativo'|trans }}</span>
                </button>
                {% endif %}
            </div>
        </div>

        {# Total contratado (decisão C8 do dono, 23/10/2026): o card "Valor da causa" do desenho 02
           (dc L.1878-1892), com o nome aprovado. É SOMA, só leitura: os lançamentos não previstos do
           card Pagamentos, pagos ou não (`PastaPagamentosOutput::contratadoFormatado`, a mesma base
           do % de êxito e sucumbência). Sem lápis, sem campo, sem rota: o valor da causa da pasta
           continua editável no modal do Processo. O script de Pagamentos atualiza o número a cada
           resposta (`#financeiro-total-contratado`, `data-centavos` lido pelo modal). #}
        <div class="ps-fin-bloco" id="financeiro-total-contratado-bloco">
            <div class="ps-fin-rotulo-linha">
                <span class="ps-fin-rotulo">{{ 'pasta_financeiro.total_contratado.rotulo'|trans }}</span>
            </div>
            <div class="ps-fin-corpo">
                <div id="financeiro-total-contratado"
                     class="ps-fin-numero ps-num"
                     data-centavos="{{ pagamentos.contratadoCentavos }}">{{ pagamentos.contratadoFormatado }}</div>
                <div class="ps-fin-sub" title="{{ 'pasta_financeiro.total_contratado.dica'|trans }}">{{ 'pasta_financeiro.total_contratado.nota'|trans }}</div>
            </div>
        </div>

        {# Média por CPF — a média das pastas de UM cliente: o principal. Por isso a
           sublinha nomeia esse cliente em vez de contar os vinculados, como mostrava
           o protótipo: "4 clientes vinculados" ao lado de um número que é de um só
           deles diz uma coisa por outra. Desvio do desenho decidido pelo dono
           em 28/08. #}
        <div class="ps-fin-bloco ps-fin-bloco--media">
            <div class="ps-fin-rotulo-linha">
                <span class="ps-fin-rotulo" id="financeiro-media-rotulo">{{ financeiro.mediaRotulo }}</span>
            </div>
            <div class="ps-fin-corpo">
                <div id="financeiro-media-cpf" class="ps-fin-numero ps-num">{{ financeiro.mediaCpfFormatada }}</div>
                <div class="ps-fin-sub" id="financeiro-media-nota"
                     {% if financeiro.clienteNome %}title="{{ 'pasta_financeiro.media.dica'|trans }}"{% endif %}>
                    {{- financeiro.clienteNome ?? 'pasta_financeiro.media.sem_cliente'|trans -}}
                </div>
            </div>
        </div>

    </div>


        <section class="ps-card" data-trilho="arquivos">
            <div class="ps-card-cab">
                <h2>{{ 'pasta_financeiro.arquivos.titulo'|trans }}</h2>
                <span class="ps-fin-cab-sub">{{ 'pasta_financeiro.arquivos.subtitulo'|trans }}</span>
                {# Contagem SEMPRE à vista, inclusive 0 (dc 1831). #}
                <span class="ps-contagem" id="financeiro-docs-contagem">{{ documentosContrato|length }}</span>
                {# C7-FPN-01: enviar arquivo exige EDIT; quem não escreve não recebe o Adicionar. #}
                {% if podeEscreverFin %}
                <span class="ps-cab-espaco"></span>
                <label class="ps-btn-mini ps-fin-adicionar"
                       title="{{ 'pasta_financeiro.arquivos.adicionar_dica'|trans }}">
                    <i class="bi bi-plus-lg"></i> {{ 'pasta_financeiro.arquivos.adicionar'|trans }}
                    <input type="file"
                           id="financeiro-upload-input"
                           accept=".pdf,.docx,.doc,.jpg,.jpeg,.png"
                           hidden
                           data-pasta-id="{{ pasta.id }}"
                           data-csrf="{{ csrf_token('pasta_financeiro_upload_' ~ pasta.id) }}"
                           data-url="{{ path('pasta_financeiro_upload', {id: pasta.id}) }}"
                           data-base-url-renomear="{{ path('pasta_financeiro_documento_renomear', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-excluir="{{ path('pasta_financeiro_documento_excluir', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-visualizar="{{ path('pasta_financeiro_documento_view', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-download="{{ path('pasta_financeiro_documento_download', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-marcar-assinado="{{ path('pasta_financeiro_documento_marcar_assinado', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-base-url-desmarcar-assinado="{{ path('pasta_financeiro_documento_desmarcar_assinado', {id: pasta.id, docId: 0})|replace({'/0/': '/__ID__/'}) }}"
                           data-email-cliente="{{ emailCliente }}"
                           data-pasta-rotulo="{{ rotuloPastaEmail }}">
                </label>
                {% endif %}
            </div>

            <div id="financeiro-docs-lista"{% if encaminharPasta %} data-encaminhar-pasta="{{ encaminharPasta }}"{% endif %}>
                {% if documentosContrato is empty %}
                    <div class="ps-fin-doc-vazio" id="financeiro-docs-vazio">{{ 'pasta_financeiro.arquivos.vazio'|trans }}</div>
                {% else %}
                    {% for doc in documentosContrato|slice(0, arquivosVisiveis) %}
                        {# Ícone do TIPO do arquivo, 30px, como o trilho de Dados (dc ~6549 `fi(ext,30)`).
                           Pelo título, que é o que a linha mostra e cuja extensão o renomear
                           protege; o MIME é o desempate. `iconeDoArquivo` (JS, abaixo) espelha. #}
                        {% set icone = arquivo_icone(doc.titulo, doc.mimeType ?? '') %}
                        <div class="ps-fin-doc" id="financeiro-doc-{{ doc.id }}">
                            <span class="ps-doc-icone ps-doc-icone--{{ icone.tipo }}" title="{{ icone.rotulo }}"><i class="bi {{ icone.icone }}"></i></span>
                            <div class="ps-fin-doc-corpo">
                                <div class="ps-doc-nome" title="{{ doc.titulo }}">{{ doc.titulo }}</div>
                                <div class="ps-doc-meta">{{ doc.tamanhoBytes|formatar_bytes }} · {{ doc.carregadoEm|data }}</div>
                            </div>
                            {# Selo "Assinado" (dc 1974-1976): entre o nome e o ⋮. Digital (visto no
                               upload) ou marcado à mão pelo ⋮. `criarItemDoc` (JS) espelha. #}
                            {% if doc.estaAssinado %}
                            <span class="ps-fin-doc-selo"><i class="bi bi-patch-check-fill"></i>{{ 'pasta_financeiro.arquivos.assinado'|trans }}</span>
                            {% endif %}
                            {# Menu ⋮ do arquivo (desenho 1.2.3, "Mais ações do arquivo"). Só entram
                               as ações que têm função de verdade: abrir no visualizador, baixar,
                               copiar o nome, renomear, enviar por e-mail ao cliente (`mailto:`), ver
                               no gerenciador e excluir. "Encaminhar via Chat I.A" (D:6958) vem logo
                               depois de "Copiar nome do arquivo", só com a Central e fora da
                               lápide, e despacha o documento (pasta-encaminhar.js).
                               As classes `btn-renomear-doc`/`btn-excluir-doc` e os `data-*` são os
                               mesmos de antes: o JS deste arquivo escuta por delegação na lista.
                               A MESMA estrutura é montada em JS (`criarItemDoc`, abaixo). #}
                            <div class="ps-fin-doc-acoes">
                                <button type="button"
                                        class="ps-fin-menu-gatilho"
                                        title="{{ 'pasta_financeiro.arquivos.mais_acoes'|trans }}"
                                        aria-label="{{ 'pasta_financeiro.arquivos.mais_acoes'|trans }}"
                                        aria-haspopup="menu"
                                        aria-expanded="false"
                                        aria-controls="financeiro-doc-menu-{{ doc.id }}">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <div class="ps-fin-menu" id="financeiro-doc-menu-{{ doc.id }}" role="menu" hidden>
                                    <div class="ps-fin-menu-titulo" title="{{ doc.titulo }}">{{ doc.titulo }}</div>
                                    <button type="button"
                                            class="ps-fin-menu-item"
                                            role="menuitem"
                                            title="{{ 'pasta_financeiro.arquivos.visualizar'|trans }}"
                                            data-bs-toggle="modal"
                                            data-bs-target="#previewDocModal"
                                            data-url="{{ path('pasta_financeiro_documento_view', {id: pasta.id, docId: doc.id}) }}"
                                            data-download="{{ path('pasta_financeiro_documento_download', {id: pasta.id, docId: doc.id}) }}"
                                            data-nome="{{ doc.titulo }}"
                                            data-mime="{{ doc.mimeType }}">
                                        <i class="bi bi-box-arrow-up-right"></i><span>{{ 'pasta_financeiro.arquivos.abrir'|trans }}</span>
                                    </button>
                                    <a class="ps-fin-menu-item"
                                       role="menuitem"
                                       href="{{ path('pasta_financeiro_documento_download', {id: pasta.id, docId: doc.id}) }}">
                                        <i class="bi bi-download"></i><span>{{ 'pasta_financeiro.arquivos.baixar'|trans }}</span>
                                    </a>
                                    <button type="button"
                                            class="ps-fin-menu-item js-fin-doc-copiar-nome"
                                            role="menuitem">
                                        <i class="bi bi-clipboard"></i><span>{{ 'pasta_financeiro.arquivos.copiar_nome'|trans }}</span>
                                    </button>
                                    {% if encaminharPasta %}
                                    <button type="button"
                                            class="ps-fin-menu-item js-encaminhar"
                                            role="menuitem"
                                            data-encaminhar-pasta="{{ encaminharPasta }}"
                                            data-encaminhar-tipo="documento"
                                            data-encaminhar-id="{{ doc.id }}">
                                        <i class="bi bi-send"></i><span>{{ 'pasta_financeiro.comum.encaminhar'|trans }}</span>
                                    </button>
                                    {% endif %}
                                    {# C7-FPN-01: Renomear e Excluir exigem EDIT; quem não escreve não os recebe. #}
                                    {% if podeEscreverFin %}
                                    <button type="button"
                                            class="ps-fin-menu-item btn-renomear-doc"
                                            role="menuitem"
                                            title="{{ 'pasta_financeiro.arquivos.renomear'|trans }}"
                                            data-doc-id="{{ doc.id }}"
                                            data-titulo="{{ doc.titulo }}"
                                            data-csrf="{{ csrf_token('pasta_financeiro_renomear_' ~ doc.id) }}"
                                            data-url="{{ path('pasta_financeiro_documento_renomear', {id: pasta.id, docId: doc.id}) }}">
                                        <i class="bi bi-pencil"></i><span>{{ 'pasta_financeiro.arquivos.renomear'|trans }}</span>
                                    </button>
                                    {# Selo à mão (assinado à caneta e escaneado). A assinatura digital
                                       é do arquivo: não ganha "Desmarcar". #}
                                    {% if not doc.estaAssinado %}
                                    <button type="button"
                                            class="ps-fin-menu-item btn-assinatura-doc"
                                            role="menuitem"
                                            data-doc-id="{{ doc.id }}"
                                            data-acao="marcar"
                                            data-csrf="{{ csrf_token('pasta_financeiro_assinatura_' ~ doc.id) }}"
                                            data-url-marcar="{{ path('pasta_financeiro_documento_marcar_assinado', {id: pasta.id, docId: doc.id}) }}"
                                            data-url-desmarcar="{{ path('pasta_financeiro_documento_desmarcar_assinado', {id: pasta.id, docId: doc.id}) }}"
                                            data-url="{{ path('pasta_financeiro_documento_marcar_assinado', {id: pasta.id, docId: doc.id}) }}">
                                        <i class="bi bi-patch-check"></i><span>{{ 'pasta_financeiro.arquivos.marcar_assinado'|trans }}</span>
                                    </button>
                                    {% elseif doc.assinaturaOrigem.value == 'manual' %}
                                    <button type="button"
                                            class="ps-fin-menu-item btn-assinatura-doc"
                                            role="menuitem"
                                            data-doc-id="{{ doc.id }}"
                                            data-acao="desmarcar"
                                            data-csrf="{{ csrf_token('pasta_financeiro_assinatura_' ~ doc.id) }}"
                                            data-url-marcar="{{ path('pasta_financeiro_documento_marcar_assinado', {id: pasta.id, docId: doc.id}) }}"
                                            data-url-desmarcar="{{ path('pasta_financeiro_documento_desmarcar_assinado', {id: pasta.id, docId: doc.id}) }}"
                                            data-url="{{ path('pasta_financeiro_documento_desmarcar_assinado', {id: pasta.id, docId: doc.id}) }}">
                                        <i class="bi bi-x-circle"></i><span>{{ 'pasta_financeiro.arquivos.desmarcar_assinado'|trans }}</span>
                                    </button>
                                    {% endif %}
                                    {% endif %}
                                    {% if emailCliente %}
                                        <a class="ps-fin-menu-item js-fin-doc-email"
                                           role="menuitem"
                                           href="mailto:{{ emailCliente }}?subject={{ 'pasta_financeiro.arquivos.email_assunto'|trans({pasta: rotuloPastaEmail, titulo: doc.titulo})|url_encode }}&amp;body={{ 'pasta_financeiro.arquivos.email_corpo'|trans({pasta: rotuloPastaEmail, titulo: doc.titulo})|url_encode }}">
                                            <i class="bi bi-envelope"></i><span>{{ 'pasta_financeiro.arquivos.enviar_email'|trans }}</span>
                                        </a>
                                    {% else %}
                                        <button type="button"
                                                class="ps-fin-menu-item js-fin-doc-email js-fin-doc-email-sem-cadastro"
                                                role="menuitem">
                                            <i class="bi bi-envelope"></i><span>{{ 'pasta_financeiro.arquivos.enviar_email'|trans }}</span>
                                        </button>
                                    {% endif %}
                                    <button type="button"
                                            class="ps-fin-menu-item js-fin-doc-ver-documentos"
                                            role="menuitem">
                                        <i class="bi bi-folder2-open"></i><span>{{ 'pasta_financeiro.arquivos.ver_documentos'|trans }}</span>
                                    </button>
                                    {% if podeEscreverFin %}
                                    <div class="ps-fin-menu-sep" role="separator"></div>
                                    <button type="button"
                                            class="ps-fin-menu-item ps-fin-menu-item--perigo btn-excluir-doc"
                                            role="menuitem"
                                            title="{{ 'pasta_financeiro.arquivos.excluir'|trans }}"
                                            data-doc-id="{{ doc.id }}"
                                            data-csrf="{{ csrf_token('pasta_financeiro_excluir_' ~ doc.id) }}"
                                            data-url="{{ path('pasta_financeiro_documento_excluir', {id: pasta.id, docId: doc.id}) }}">
                                        <i class="bi bi-trash3"></i><span>{{ 'pasta_financeiro.arquivos.excluir'|trans }}</span>
                                    </button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Passou de 3, o resto não some da vista sem dizer para onde foi. #}
            {# Sem o atalho quando a aba Documentos está oculta para quem vê (ocultar aba). #}
            {% if documentosContrato|length > arquivosVisiveis and 'documentos' not in abasOcultas|default([]) %}
                <div class="ps-fin-doc-excedente" id="financeiro-docs-excedente">
                    <button type="button" class="ps-fin-link" data-ps-ir-aba="documentos-tab">
                        {{ 'pasta_financeiro.arquivos.ver_outros'|trans({quantidade: (documentosContrato|length - arquivosVisiveis) ~ ''}) }}
                    </button>
                </div>
            {% endif %}

            {# O rodapé é todo do envio (reduzir ao enviar, erro e "Enviando…"): só com o Adicionar. #}
            {% if podeEscreverFin %}
            <div class="ps-fin-rodape">
                <button type="button"
                        id="financeiro-reduzir-btn"
                        class="ps-fin-switch"
                        role="switch"
                        aria-checked="false">
                    <span class="ps-fin-switch-trilho"><span class="ps-fin-switch-knob"></span></span>
                    <span>{{ 'pasta_financeiro.arquivos.reduzir'|trans }}</span>
                </button>
                <div class="ps-fin-sub" id="financeiro-reduzir-nota">{{ 'pasta_financeiro.arquivos.reduzir_nota'|trans }}</div>
                <div id="financeiro-upload-erro" class="ps-fin-sub ps-fin-sub--erro d-none"></div>
                <div id="financeiro-upload-spinner" class="ps-fin-sub d-none">
                    <span class="spinner-border spinner-border-sm me-1"></span>{{ 'pasta_financeiro.arquivos.enviando'|trans }}
                </div>
            </div>
            {% endif %}
        </section>

        {# ── Pagamentos ───────────────────────────────────────────────────────
           O que o CLIENTE combinou pagar por este caso. Nada a ver com a
           Cobrança, onde o dinheiro é a dívida de um devedor numa carteira. #}
        <section class="ps-card" data-trilho="pagamentos"
                 id="psPagamentos"
                 data-url-registrar="{{ path('pasta_pagamento_registrar', {id: pasta.id}) }}"
                 data-csrf-registrar="{{ csrf_token('pasta_pagamento_' ~ pasta.id) }}"
                 data-base-url-quitacao="{{ path('pasta_pagamento_alternar_quitacao', {id: pasta.id, pagamentoId: 0})|replace({'/0/': '/__ID__/'}) }}"
                 data-base-url-excluir="{{ path('pasta_pagamento_excluir', {id: pasta.id, pagamentoId: 0})|replace({'/0/': '/__ID__/'}) }}"
                 data-base-url-corrigir="{{ path('pasta_pagamento_corrigir_valor', {id: pasta.id, pagamentoId: 0})|replace({'/0/': '/__ID__/'}) }}">
            <div class="ps-card-cab">
                <h2>{{ 'pasta_financeiro.pagamentos.titulo'|trans }}</h2>
                <span class="ps-contagem" id="psPagamentosTotal">{{ pagamentos.total }}</span>
                <span class="ps-cab-espaco"></span>
                {# Só o ⋮ no cabeçalho (dc 1865-1871): o "ver todos" mora no menu, no item
                   "Ver todos os lançamentos", que alterna a classe `is-mostrando-todos`.
                   ⋮ do card (desenho 1.2.3): só o que tem função hoje. "Editar ou corrigir
                   valores" liga o modo de edição — a classe `is-editando` no cartão, que
                   sobrevive à troca do corpo — e vira "Concluir edição" enquanto ele dura
                   (dc 3509). O histórico de cada correção sai do `audit_log`. Os itens de
                   extrato somem quando não há lançamento: o JS confere, na abertura, se a
                   folha `#psExtratoFolha` existe no corpo.
                   "Concluir edição" também aparece como botão ao lado do ⋮ enquanto o modo
                   está ligado (dc 1869).
                   C7-FPN-01: quem não escreve não recebe Adicionar, Editar ou corrigir, nem o
                   "Concluir edição"; ficam Ver todos, Copiar resumo e Imprimir extrato. Sem
                   lançamento nenhum esses três não têm o que mostrar, e o ⋮ não é montado. #}
                {% if podeEscreverFin %}
                <button type="button"
                        class="ps-pag-concluir js-pag-concluir-edicao"
                        id="psPagamentosConcluir"
                        hidden>
                    <i class="bi bi-check2"></i><span>{{ 'pasta_financeiro.pagamentos.concluir_edicao'|trans }}</span>
                </button>
                {% endif %}
                {% if podeEscreverFin or pagamentos.total > 0 %}
                <button type="button"
                        class="ps-fin-menu-gatilho ps-fin-menu-gatilho--cab"
                        id="psPagamentosMenuBtn"
                        title="{{ 'pasta_financeiro.pagamentos.mais_opcoes'|trans }}"
                        aria-label="{{ 'pasta_financeiro.pagamentos.mais_opcoes_rotulo'|trans }}"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        aria-controls="psPagamentosMenu">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="ps-fin-menu" id="psPagamentosMenu" role="menu" hidden>
                    <div class="ps-fin-menu-titulo">{{ 'pasta_financeiro.pagamentos.titulo'|trans }}</div>
                    {% if podeEscreverFin %}
                    <button type="button" class="ps-fin-menu-item" role="menuitem"
                            data-bs-toggle="modal" data-bs-target="#modalNovoPagamento">
                        <i class="bi bi-plus-lg"></i><span>{{ 'pasta_financeiro.pagamentos.adicionar'|trans }}</span>
                    </button>
                    <button type="button" class="ps-fin-menu-item js-pag-editar" role="menuitem">
                        <i class="bi bi-pencil-square"></i><span>{{ 'pasta_financeiro.pagamentos.editar_valores'|trans }}</span>
                    </button>
                    {% endif %}
                    <button type="button" class="ps-fin-menu-item js-pag-ver-todos" role="menuitem">
                        <i class="bi bi-list-ul"></i><span>{{ 'pasta_financeiro.pagamentos.ver_todos'|trans }}</span>
                    </button>
                    <div class="ps-fin-menu-sep js-pag-so-com-extrato" role="separator"></div>
                    <button type="button" class="ps-fin-menu-item js-pag-copiar-resumo js-pag-so-com-extrato" role="menuitem">
                        <i class="bi bi-clipboard"></i><span>{{ 'pasta_financeiro.pagamentos.copiar_resumo'|trans }}</span>
                    </button>
                    <button type="button" class="ps-fin-menu-item js-pag-imprimir-extrato js-pag-so-com-extrato" role="menuitem">
                        <i class="bi bi-printer"></i><span>{{ 'pasta_financeiro.pagamentos.imprimir_extrato'|trans }}</span>
                    </button>
                </div>
                {% endif %}
            </div>

            {# Cabeçalho da folha do extrato. Fica FORA de `#psPagamentosCorpo` porque
               não muda com os lançamentos; a lista vem do corpo, que o servidor
               re-renderiza a cada mudança — por isso o extrato impresso é sempre o
               que está na tela. O JS junta os dois numa folha só na hora de imprimir. #}
            <div class="ps-fin-extrato-cab" id="psExtratoCabecalho" hidden>
                <div class="ps-fin-extrato-titulo">{{ 'pasta_financeiro.pagamentos.extrato_titulo'|trans }}</div>
                <div class="ps-fin-extrato-pasta">
                    {{ 'pasta_financeiro.pagamentos.extrato_pasta'|trans({pasta: pasta.nup ?? ('#' ~ pasta.id)}) }}{% set nomeDaPasta = identificador_pasta(pasta) %}{% if nomeDaPasta %} · {{ nomeDaPasta }}{% endif %}
                </div>
                <div class="ps-fin-extrato-emissao">{{ 'pasta_financeiro.pagamentos.emitido_em'|trans }} <span class="js-extrato-emitido-em"></span></div>
            </div>

            <div id="psPagamentosCorpo">
                {{ include('pasta/_financeiro_pagamentos.html.twig', {pagamentos: pagamentos, podeEscreverFin: podeEscreverFin}) }}
            </div>

            {% if podeEscreverFin %}
            <div class="ps-fin-rodape">
                <button type="button" class="ps-fin-btn-add"
                        data-bs-toggle="modal" data-bs-target="#modalNovoPagamento">
                    <i class="bi bi-plus-lg"></i><span>{{ 'pasta_financeiro.pagamentos.adicionar'|trans }}</span>
                </button>
            </div>
            {% endif %}
        </section>

    </div>
</div>

{# Textos dos scripts desta aba (os três daqui, o _financeiro_obs_script e o
   _financeiro_pagamentos_script) no idioma da página: `BJ_T.t('pasta_financeiro.js.<chave>')`.
   Os scripts rodam antes do bj-traducao.js (o base o carrega no fim do corpo): por isso
   só pedem texto dentro das funções, na hora do uso, nunca ao carregar. #}
{{ catalogo_js('pasta_financeiro.js') }}

<script>
(function () {
    'use strict';

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // ── Situação do Contrato ──────────────────────────────────────────────────
    // O SELO é o botão: o clique nele alterna Pendente ⇄ Assinado.
    const btnSituacao = document.getElementById('financeiro-situacao-btn');
    if (btnSituacao) {
        btnSituacao.addEventListener('click', async function () {
            const atual = this.dataset.situacaoAtual;
            const nova  = atual === 'PENDENTE' ? 'REGULAR' : 'PENDENTE';

            // Assinado só com o arquivo do contrato anexado (dc 27.10). Sem arquivo, só reabre.
            if (nova === 'REGULAR' && !document.querySelector('#financeiro-docs-lista .ps-fin-doc')) {
                (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.contrato_sem_arquivo'));
                return;
            }

            const fd = new FormData();
            fd.append('_token', this.dataset.csrf);
            fd.append('situacao', nova);

            try {
                const resp = await fetch(this.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();
                if (!resp.ok) { (window.avisarErroPs || window.alert)(data.erro ?? BJ_T.t('pasta_financeiro.js.erro_situacao')); return; }

                const assinado = data.situacao === 'REGULAR';
                this.dataset.situacaoAtual = data.situacao;
                this.className = 'ps-fin-selo ps-fin-selo--' + (assinado ? 'ok' : 'perigo');
                this.title = assinado
                    ? BJ_T.t('pasta_financeiro.js.contrato_assinado_dica')
                    : BJ_T.t('pasta_financeiro.js.contrato_pendente_dica');
                this.querySelector('i').className = 'bi ' + (assinado ? 'bi-patch-check-fill' : 'bi-hourglass-split');
                this.querySelector('.ps-fin-selo-texto').textContent = assinado ? BJ_T.t('pasta_financeiro.js.contrato_assinado') : BJ_T.t('pasta_financeiro.js.contrato_pendente');
            } catch (_) {
                (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.erro_rede_tente'));
            }
        });
    }

    // ── Pró-Bono ─────────────────────────────────────────────────────────────
    const btnProBono = document.getElementById('financeiro-probono-btn');
    if (btnProBono) {
        btnProBono.addEventListener('click', async function () {
            const ativo = this.dataset.ativo === '1';
            const novo  = !ativo;

            const fd = new FormData();
            fd.append('_token', this.dataset.csrf);
            fd.append('pro_bono', novo ? '1' : '0');

            try {
                const resp = await fetch(this.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                if (!resp.ok) { (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.erro_pro_bono')); return; }

                this.dataset.ativo = novo ? '1' : '0';
                this.setAttribute('aria-pressed', novo ? 'true' : 'false');
                this.className = 'ps-fin-selo ps-fin-selo--' + (novo ? 'ok' : 'neutro');
                this.querySelector('i').className = 'bi ' + (novo ? 'bi-check2-circle' : 'bi-dash-circle');
                this.querySelector('.ps-fin-selo-texto').textContent = novo ? BJ_T.t('pasta_financeiro.js.pro_bono_ativo') : BJ_T.t('pasta_financeiro.js.pro_bono_inativo');
            } catch (_) {
                (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.erro_rede_tente'));
            }
        });
    }

    // ── Switch "reduzir tamanho ao enviar" ───────────────────────────────────
    // A nota de apoio é CONSEQUÊNCIA do estado, não um aviso fixo ao lado: era
    // texto cinza permanente e ninguém lia.
    const reduzirBtn  = document.getElementById('financeiro-reduzir-btn');
    const reduzirNota = document.getElementById('financeiro-reduzir-nota');
    if (reduzirBtn) {
        reduzirBtn.addEventListener('click', function () {
            const ligado = this.getAttribute('aria-checked') !== 'true';
            this.setAttribute('aria-checked', ligado ? 'true' : 'false');
            this.classList.toggle('is-ligado', ligado);
            if (reduzirNota) {
                reduzirNota.textContent = ligado
                    ? BJ_T.t('pasta_financeiro.js.reduzir_aviso')
                    : BJ_T.t('pasta_financeiro.js.reduzir_nota');
                reduzirNota.classList.toggle('ps-fin-sub--aviso', ligado);
            }
        });
    }

    // ── Upload de arquivo ─────────────────────────────────────────────────────
    const uploadInput   = document.getElementById('financeiro-upload-input');
    const docLista      = document.getElementById('financeiro-docs-lista');
    const uploadErro    = document.getElementById('financeiro-upload-erro');
    const uploadSpinner = document.getElementById('financeiro-upload-spinner');

    // Espelha o `arquivosVisiveis` do Twig acima: os dois lados têm de contar o
    // mesmo teto, senão a lista cresce no navegador e encolhe na recarga.
    const MAX_ARQUIVOS = {{ arquivosVisiveis }};

    /** A contagem do cabeçalho segue o total do SERVIDOR, não o que está à vista. */
    function atualizarContagemDocs(delta) {
        const cab = document.querySelector('[data-trilho="arquivos"] .ps-card-cab');
        if (!cab) { return; }

        let badge = document.getElementById('financeiro-docs-contagem');
        if (!badge) {
            badge = document.createElement('span');
            badge.className = 'ps-contagem';
            badge.id = 'financeiro-docs-contagem';
            badge.textContent = '0';
            cab.querySelector('h2').after(badge);
        }
        badge.textContent = String(Math.max(0, (parseInt(badge.textContent, 10) || 0) + delta));
    }

    /** Atalho para o gerenciador quando há mais arquivos do que o card mostra. */
    function mostrarExcedente() {
        // Sem a aba Documentos (oculta para quem vê), o atalho não existe.
        if (document.getElementById('financeiro-docs-excedente') || !document.getElementById('documentos-tab')) { return; }

        const bloco = document.createElement('div');
        bloco.className = 'ps-fin-doc-excedente';
        bloco.id = 'financeiro-docs-excedente';
        bloco.innerHTML = '<button type="button" class="ps-fin-link" data-ps-ir-aba="documentos-tab">'
            + esc(BJ_T.t('pasta_financeiro.js.ver_demais')) + '</button>';
        bloco.querySelector('button').addEventListener('click', function () {
            const gatilho = document.getElementById('documentos-tab');
            if (gatilho && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(gatilho).show(); }
        });
        docLista.after(bloco);
    }

    /**
     * Espelho de `arquivo_icone()` (App\Twig\ArquivoIconeExtension) para os tipos
     * que este upload aceita (PDF, DOC/DOCX, JPEG, PNG), com o mesmo desempate
     * pelo MIME e o mesmo genérico: [ícone, tipo, rótulo]. A cor sai da classe
     * `ps-doc-icone--<tipo>` (tokens do pasta-show.css, com par escuro), nunca
     * inline. Mudou lá, muda aqui (PastaFinanceiroIconeEspelhoFolhaTest avisa).
     */
    function iconeDoArquivo(titulo, mime) {
        const t     = String(titulo);
        const ponto = t.lastIndexOf('.');
        const ext   = ponto > 0 ? t.slice(ponto + 1).toLowerCase() : '';
        const mapa  = {
            pdf:  ['bi-file-earmark-pdf-fill',   'pdf',  'PDF'],
            doc:  ['bi-file-earmark-word-fill',  'word', 'Word'],
            docx: ['bi-file-earmark-word-fill',  'word', 'Word'],
            png:  ['bi-file-earmark-image-fill', 'img',  'Imagem'],
            jpg:  ['bi-file-earmark-image-fill', 'img',  'Imagem'],
            jpeg: ['bi-file-earmark-image-fill', 'img',  'Imagem'],
        };
        const m = String(mime ?? '');
        const [icone, tipo, rotulo] = mapa[ext]
            ?? (m.startsWith('image/') ? ['bi-file-earmark-image-fill', 'img', 'Imagem']
            : m.includes('pdf') ? ['bi-file-earmark-pdf-fill', 'pdf', 'PDF']
            : (m.includes('word') || m.includes('document')) ? ['bi-file-earmark-word-fill', 'word', 'Word']
            : ['bi-file-earmark-fill', 'outro', 'Arquivo']);
        return { icone: icone, tipo: tipo, rotulo: rotulo };
    }

    function htmlIconeDoArquivo(titulo, mime) {
        const ic = iconeDoArquivo(titulo, mime);
        return '<span class="ps-doc-icone ps-doc-icone--' + esc(ic.tipo) + '" title="' + esc(ic.rotulo) + '">'
            + '<i class="bi ' + esc(ic.icone) + '"></i></span>';
    }

    /* "Enviar por e-mail ao cliente": o MESMO `mailto:` que o Twig monta na
       primeira carga (assunto e corpo do desenho, dc 6546), para o arquivo que
       acabou de subir ou de ser renomeado. O e-mail vem do servidor já filtrado. */
    function mailtoDoArquivo(titulo) {
        const email  = uploadInput ? (uploadInput.dataset.emailCliente || '') : '';
        const rotulo = uploadInput ? (uploadInput.dataset.pastaRotulo || '') : '';
        if (!email) { return ''; }

        return 'mailto:' + email
            + '?subject=' + encodeURIComponent(BJ_T.t('pasta_financeiro.js.email_assunto', { pasta: rotulo, titulo: titulo }))
            + '&body=' + encodeURIComponent(BJ_T.t('pasta_financeiro.js.email_corpo', { pasta: rotulo, titulo: titulo }));
    }

    function htmlItemEmail(titulo) {
        const href  = mailtoDoArquivo(titulo);
        const miolo = '<i class="bi bi-envelope"></i><span>' + esc(BJ_T.t('pasta_financeiro.js.enviar_email')) + '</span>';
        if (!href) {
            return '<button type="button" class="ps-fin-menu-item js-fin-doc-email js-fin-doc-email-sem-cadastro" role="menuitem">' + miolo + '</button>';
        }

        return '<a class="ps-fin-menu-item js-fin-doc-email" role="menuitem" href="' + esc(href) + '">' + miolo + '</a>';
    }

    /* Selo "Assinado" (dc 1974-1976), o mesmo do Twig. */
    function htmlSeloAssinado() {
        return `<span class="ps-fin-doc-selo"><i class="bi bi-patch-check-fill"></i>${esc(BJ_T.t('pasta_financeiro.js.assinado'))}</span>`;
    }

    /* Item "Marcar como assinado" / "Desmarcar assinatura" do ⋮. Assinatura digital não ganha item.
       `assinatura`: { assinado, origem, csrf, urlMarcar, urlDesmarcar }. */
    function htmlItemAssinatura(id, assinatura) {
        if (!assinatura || (assinatura.assinado && assinatura.origem !== 'manual')) { return ''; }
        const marcar = !assinatura.assinado;
        return `<button type="button"
                            class="ps-fin-menu-item btn-assinatura-doc"
                            role="menuitem"
                            data-doc-id="${esc(id)}"
                            data-acao="${marcar ? 'marcar' : 'desmarcar'}"
                            data-csrf="${esc(assinatura.csrf)}"
                            data-url="${esc(marcar ? assinatura.urlMarcar : assinatura.urlDesmarcar)}"
                            data-url-marcar="${esc(assinatura.urlMarcar)}"
                            data-url-desmarcar="${esc(assinatura.urlDesmarcar)}">
                        <i class="bi ${marcar ? 'bi-patch-check' : 'bi-x-circle'}"></i><span>${esc(BJ_T.t(marcar ? 'pasta_financeiro.js.marcar_assinado' : 'pasta_financeiro.js.desmarcar_assinado'))}</span>
                    </button>`;
    }

    function criarItemDoc(id, titulo, mimeType, urlVisualizar, urlDownload, urlRenomear, csrfRenomear, urlExcluir, csrfExcluir, meta, assinatura) {
        /* "Encaminhar via Chat I.A" (D:6958): o id da pasta vem do atributo que o Twig põe na lista
           (só com a Central e fora da lápide); o do documento é o número do servidor. */
        const encaminharPasta = Number(docLista.dataset.encaminharPasta || 0);
        const itemEncaminhar  = encaminharPasta
            ? `<button type="button"
                            class="ps-fin-menu-item js-encaminhar"
                            role="menuitem"
                            data-encaminhar-pasta="${encaminharPasta}"
                            data-encaminhar-tipo="documento"
                            data-encaminhar-id="${Number(id)}">
                        <i class="bi bi-send"></i><span>${esc(BJ_T.t('pasta_financeiro.js.encaminhar'))}</span>
                    </button>`
            : '';
        const div = document.createElement('div');
        div.className = 'ps-fin-doc';
        div.id = 'financeiro-doc-' + id;
        div.innerHTML = `
            ${htmlIconeDoArquivo(titulo, mimeType)}
            <div class="ps-fin-doc-corpo">
                <div class="ps-doc-nome" title="${esc(titulo)}">${esc(titulo)}</div>
                <div class="ps-doc-meta">${esc(meta ?? '')}</div>
            </div>
            ${assinatura && assinatura.assinado ? htmlSeloAssinado() : ''}
            <div class="ps-fin-doc-acoes">
                <button type="button"
                        class="ps-fin-menu-gatilho"
                        title="${esc(BJ_T.t('pasta_financeiro.js.mais_acoes'))}"
                        aria-label="${esc(BJ_T.t('pasta_financeiro.js.mais_acoes'))}"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        aria-controls="financeiro-doc-menu-${esc(id)}">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="ps-fin-menu" id="financeiro-doc-menu-${esc(id)}" role="menu" hidden>
                    <div class="ps-fin-menu-titulo" title="${esc(titulo)}">${esc(titulo)}</div>
                    <button type="button"
                            class="ps-fin-menu-item"
                            role="menuitem"
                            title="${esc(BJ_T.t('pasta_financeiro.js.visualizar'))}"
                            data-bs-toggle="modal"
                            data-bs-target="#previewDocModal"
                            data-url="${esc(urlVisualizar)}"
                            data-download="${esc(urlDownload)}"
                            data-nome="${esc(titulo)}"
                            data-mime="${esc(mimeType)}">
                        <i class="bi bi-box-arrow-up-right"></i><span>${esc(BJ_T.t('pasta_financeiro.js.abrir'))}</span>
                    </button>
                    <a class="ps-fin-menu-item" role="menuitem" href="${esc(urlDownload)}">
                        <i class="bi bi-download"></i><span>${esc(BJ_T.t('pasta_financeiro.js.baixar'))}</span>
                    </a>
                    <button type="button" class="ps-fin-menu-item js-fin-doc-copiar-nome" role="menuitem">
                        <i class="bi bi-clipboard"></i><span>${esc(BJ_T.t('pasta_financeiro.js.copiar_nome'))}</span>
                    </button>
                    ${itemEncaminhar}
                    <button type="button"
                            class="ps-fin-menu-item btn-renomear-doc"
                            role="menuitem"
                            title="${esc(BJ_T.t('pasta_financeiro.js.renomear'))}"
                            data-doc-id="${esc(id)}"
                            data-titulo="${esc(titulo)}"
                            data-csrf="${esc(csrfRenomear)}"
                            data-url="${esc(urlRenomear)}">
                        <i class="bi bi-pencil"></i><span>${esc(BJ_T.t('pasta_financeiro.js.renomear'))}</span>
                    </button>
                    ${htmlItemAssinatura(id, assinatura)}
                    ${htmlItemEmail(titulo)}
                    <button type="button" class="ps-fin-menu-item js-fin-doc-ver-documentos" role="menuitem">
                        <i class="bi bi-folder2-open"></i><span>${esc(BJ_T.t('pasta_financeiro.js.ver_documentos'))}</span>
                    </button>
                    <div class="ps-fin-menu-sep" role="separator"></div>
                    <button type="button"
                            class="ps-fin-menu-item ps-fin-menu-item--perigo btn-excluir-doc"
                            role="menuitem"
                            title="${esc(BJ_T.t('pasta_financeiro.js.excluir'))}"
                            data-doc-id="${esc(id)}"
                            data-csrf="${esc(csrfExcluir)}"
                            data-url="${esc(urlExcluir)}">
                        <i class="bi bi-trash3"></i><span>${esc(BJ_T.t('pasta_financeiro.js.excluir'))}</span>
                    </button>
                </div>
            </div>`;
        return div;
    }

    if (uploadInput) {
        uploadInput.addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;

            const url      = this.dataset.url;
            const csrf     = this.dataset.csrf;
            const baseRen  = this.dataset.baseUrlRenomear;
            const baseExc  = this.dataset.baseUrlExcluir;
            const baseVis  = this.dataset.baseUrlVisualizar;
            const baseDl   = this.dataset.baseUrlDownload;
            const baseMarc = this.dataset.baseUrlMarcarAssinado;
            const baseDesm = this.dataset.baseUrlDesmarcarAssinado;

            uploadErro.classList.add('d-none');
            uploadSpinner.classList.remove('d-none');

            const fd = new FormData();
            fd.append('_token', csrf);
            fd.append('arquivo', file);
            fd.append('reduzir_tamanho', reduzirBtn && reduzirBtn.getAttribute('aria-checked') === 'true' ? '1' : '0');

            try {
                const resp = await fetch(url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();

                if (!resp.ok) {
                    uploadErro.textContent = data.erro ?? BJ_T.t('pasta_financeiro.js.erro_enviar_arquivo');
                    uploadErro.classList.remove('d-none');
                    return;
                }

                const vazioMsg = document.getElementById('financeiro-docs-vazio');
                if (vazioMsg) { vazioMsg.remove(); }

                const urlRen = baseRen.replace('__ID__', data.id);
                const urlExc = baseExc.replace('__ID__', data.id);
                const urlVis = baseVis ? baseVis.replace('__ID__', data.id) : data.urlVisualizar;
                const urlDl  = baseDl  ? baseDl.replace('__ID__', data.id)  : data.urlDownload;

                // O trilho mostra no máximo TRÊS. Passando disso a lista curta não
                // cresce: o arquivo existe no servidor e o atalho para o
                // gerenciador aparece. Sem isto o card inchava até o rodapé sair
                // da vista, contrariando o desenho no caso em que ele mais importa.
                if (docLista.querySelectorAll('.ps-fin-doc').length < MAX_ARQUIVOS) {
                    docLista.appendChild(
                        criarItemDoc(data.id, data.titulo, data.mimeType, urlVis, urlDl, urlRen, data.csrfRenomear, urlExc, data.csrfExcluir, data.meta, {
                            assinado: !!data.assinatura,
                            origem: data.assinatura,
                            csrf: data.csrfAssinatura,
                            urlMarcar: baseMarc.replace('__ID__', data.id),
                            urlDesmarcar: baseDesm.replace('__ID__', data.id),
                        })
                    );
                } else {
                    mostrarExcedente();
                }
                atualizarContagemDocs(+1);
            } catch (_) {
                uploadErro.textContent = BJ_T.t('pasta_financeiro.js.erro_rede_tente');
                uploadErro.classList.remove('d-none');
            } finally {
                uploadSpinner.classList.add('d-none');
                this.value = '';
            }
        });
    }

    // ── Renomear / Excluir arquivo ────────────────────────────────────────────
    if (docLista) {
        docLista.addEventListener('click', async function (e) {

            const btnRen = e.target.closest('.btn-renomear-doc');
            if (btnRen) {
                const docId  = btnRen.dataset.docId;
                const item   = document.getElementById('financeiro-doc-' + docId);
                const spanTitulo = item.querySelector('.ps-doc-nome');
                const tituloAtual = btnRen.dataset.titulo;

                // Isola a extensão para protegê-la da edição
                const pontoIdx = tituloAtual.lastIndexOf('.');
                const nomeBase = pontoIdx > 0 ? tituloAtual.slice(0, pontoIdx) : tituloAtual;
                const extensao = pontoIdx > 0 ? tituloAtual.slice(pontoIdx) : '';

                const wrapper = document.createElement('div');
                wrapper.className = 'ps-fin-doc-renomear';

                const input = document.createElement('input');
                input.type = 'text';
                input.className = 'form-control form-control-sm';
                input.value = nomeBase;

                wrapper.appendChild(input);
                if (extensao) {
                    const extSpan = document.createElement('span');
                    extSpan.className = 'ps-doc-meta';
                    extSpan.textContent = extensao;
                    wrapper.appendChild(extSpan);
                }

                spanTitulo.replaceWith(wrapper);
                input.focus();
                input.select();

                function restaurarSpan(titulo) {
                    const span = document.createElement('div');
                    span.className = 'ps-doc-nome';
                    span.title = titulo;
                    span.textContent = titulo;
                    wrapper.replaceWith(span);
                    return span;
                }

                async function confirmarRenomear() {
                    const novoBase   = input.value.trim();
                    const novoTitulo = novoBase !== '' ? novoBase + extensao : tituloAtual;
                    if (novoBase === '' || novoTitulo === tituloAtual) {
                        restaurarSpan(tituloAtual);
                        return;
                    }

                    const fd = new FormData();
                    fd.append('_token', btnRen.dataset.csrf);
                    fd.append('titulo', novoTitulo);

                    try {
                        const resp = await fetch(btnRen.dataset.url, {
                            method: 'POST',
                            body: fd,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        });
                        const data = await resp.json();
                        const titulo = resp.ok ? data.titulo : tituloAtual;
                        if (!resp.ok) { (window.avisarErroPs || window.alert)(data.erro ?? BJ_T.t('pasta_financeiro.js.erro_renomear')); }
                        restaurarSpan(titulo);
                        btnRen.dataset.titulo = titulo;
                        // Mantém o pré-visualizador e o ícone do tipo coerentes.
                        const btnPrevItem = item.querySelector('[data-bs-target="#previewDocModal"]');
                        if (btnPrevItem) { btnPrevItem.dataset.nome = titulo; }
                        const icone = item.querySelector('.ps-doc-icone');
                        if (icone) { icone.outerHTML = htmlIconeDoArquivo(titulo, btnPrevItem ? btnPrevItem.dataset.mime : ''); }
                        const tituloMenu = item.querySelector('.ps-fin-menu-titulo');
                        if (tituloMenu) { tituloMenu.textContent = titulo; tituloMenu.title = titulo; }
                        // O assunto e o corpo do e-mail citam o nome do arquivo.
                        const itemEmail = item.querySelector('a.js-fin-doc-email');
                        if (itemEmail) { itemEmail.href = mailtoDoArquivo(titulo); }
                    } catch (_) {
                        (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.erro_rede'));
                        restaurarSpan(tituloAtual);
                    }
                }

                input.addEventListener('blur', confirmarRenomear);
                input.addEventListener('keydown', function (ev) {
                    if (ev.key === 'Enter') { ev.preventDefault(); confirmarRenomear(); }
                    if (ev.key === 'Escape') { restaurarSpan(tituloAtual); }
                });

                return;
            }

            // Marcar/desmarcar o selo "Assinado". O botão é atualizado no lugar (não trocado): o
            // script dos menus, que fecha o ⋮ depois deste handler, ainda precisa achá-lo no menu.
            const btnAss = e.target.closest('.btn-assinatura-doc');
            if (btnAss) {
                const item   = document.getElementById('financeiro-doc-' + btnAss.dataset.docId);
                const fd     = new FormData();
                fd.append('_token', btnAss.dataset.csrf);

                try {
                    const resp = await fetch(btnAss.dataset.url, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    const data = await resp.json();
                    if (!resp.ok) {
                        (window.avisarErroPs || window.alert)(data.erro ?? data.mensagem ?? BJ_T.t('pasta_financeiro.js.erro_assinatura'));
                        return;
                    }
                    const selo = item ? item.querySelector(':scope > .ps-fin-doc-selo') : null;
                    if (data.assinado && !selo && item) {
                        item.querySelector(':scope > .ps-fin-doc-acoes').insertAdjacentHTML('beforebegin', htmlSeloAssinado());
                    }
                    if (!data.assinado && selo) { selo.remove(); }
                    const agoraMarcar = !data.assinado;
                    btnAss.dataset.acao = agoraMarcar ? 'marcar' : 'desmarcar';
                    btnAss.dataset.url  = agoraMarcar ? btnAss.dataset.urlMarcar : btnAss.dataset.urlDesmarcar;
                    btnAss.querySelector('i').className = 'bi ' + (agoraMarcar ? 'bi-patch-check' : 'bi-x-circle');
                    btnAss.querySelector('span').textContent = BJ_T.t(agoraMarcar ? 'pasta_financeiro.js.marcar_assinado' : 'pasta_financeiro.js.desmarcar_assinado');
                } catch (_) {
                    (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.erro_rede'));
                }
                return;
            }

            const btnExc = e.target.closest('.btn-excluir-doc');
            if (btnExc) {
                // E7: janela vermelha da tela com o texto do dc (`confirmarUI(…, true)`, L.6839); o nome
                // vem do título do próprio menu (textContent). Sem ele, a frase de antes.
                const tituloArq = btnExc.closest('.ps-fin-menu')?.querySelector('.ps-fin-menu-titulo');
                const nomeArq = tituloArq ? tituloArq.textContent.trim() : '';
                const perguntaArq = nomeArq
                    ? BJ_T.t('pasta_financeiro.js.excluir_arquivo_nome', { nome: nomeArq })
                    : BJ_T.t('pasta_financeiro.js.excluir_arquivo');
                const excluirArq = window.confirmarUIPs ? await window.confirmarUIPs(perguntaArq, true) : confirm(perguntaArq);
                if (!excluirArq) return;

                const docId = btnExc.dataset.docId;
                const fd    = new FormData();
                fd.append('_token', btnExc.dataset.csrf);

                try {
                    const resp = await fetch(btnExc.dataset.url, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    if (resp.ok) {
                        document.getElementById('financeiro-doc-' + docId)?.remove();
                        atualizarContagemDocs(-1);
                        if (docLista.children.length === 0) {
                            const vazio = document.createElement('div');
                            vazio.className = 'ps-fin-doc-vazio';
                            vazio.id = 'financeiro-docs-vazio';
                            vazio.textContent = BJ_T.t('pasta_financeiro.js.arquivos_vazio');
                            docLista.appendChild(vazio);
                        }
                    } else {
                        const data = await resp.json();
                        (window.avisarErroPs || window.alert)(data.erro ?? BJ_T.t('pasta_financeiro.js.erro_excluir'));
                    }
                } catch (_) {
                    (window.avisarErroPs || window.alert)(BJ_T.t('pasta_financeiro.js.erro_rede'));
                }
            }
        });
    }
})();
</script>

<script>
/* ── Menus ⋮ do Financeiro (arquivos e Pagamentos) e "Imprimir extrato" ──────
   Por DELEGAÇÃO no documento: os itens de arquivo também nascem em JS (upload)
   e o corpo de Pagamentos é trocado inteiro pelo servidor. Quem abre um menu é
   `.ps-fin-menu-gatilho[aria-controls]`; o menu é `position: fixed` e ganha a
   posição na abertura (canto direito do botão, ou o ponto do clique direito),
   como o menu de contexto do desenho 1.2.3.
   Renomear e Excluir NÃO são tratados aqui: os botões guardam as classes
   `btn-renomear-doc`/`btn-excluir-doc` e o handler da lista (acima) os atende. */
(function () {
    'use strict';

    let aberto = null; // { menu, gatilho }

    function fechar(devolverFoco) {
        if (!aberto) { return; }
        const { menu, gatilho } = aberto;
        menu.hidden = true;
        if (gatilho) {
            gatilho.setAttribute('aria-expanded', 'false');
            if (devolverFoco) { gatilho.focus(); }
        }
        aberto = null;
    }

    /** x = borda DIREITA desejada do menu; y = topo. Sempre dentro da janela. */
    function posicionar(menu, x, y) {
        menu.style.left = '0px';
        menu.style.top  = '0px';
        const largura = menu.offsetWidth;
        const altura  = menu.offsetHeight;
        menu.style.left = Math.max(8, Math.min(x - largura, window.innerWidth - largura - 8)) + 'px';
        menu.style.top  = Math.max(8, Math.min(y, window.innerHeight - altura - 8)) + 'px';
    }

    function prepararMenuPagamentos(menu) {
        const editar = menu.querySelector('.js-pag-editar');
        if (editar) {
            const editando = !!document.getElementById('psPagamentos')?.classList.contains('is-editando');
            editar.querySelector('span').textContent = editando ? BJ_T.t('pasta_financeiro.js.concluir_edicao') : BJ_T.t('pasta_financeiro.js.editar_valores');
        }

        const temExtrato = !!document.getElementById('psExtratoFolha');
        menu.querySelectorAll('.js-pag-so-com-extrato').forEach(function (el) { el.hidden = !temExtrato; });

        // "Ver todos" só aparece quando há lançamento para listar. Decide na
        // abertura, pelo corpo que o servidor acabou de re-renderizar.
        const item = menu.querySelector('.js-pag-ver-todos');
        if (item) {
            item.hidden = !document.querySelector('#psPagamentosCorpo .ps-pag-linha');
            const cartao    = document.getElementById('psPagamentos');
            const mostrando = !!cartao && cartao.classList.contains('is-mostrando-todos');
            item.querySelector('span').textContent = mostrando ? BJ_T.t('pasta_financeiro.js.mostrar_proximos') : BJ_T.t('pasta_financeiro.js.ver_todos');
            item.querySelector('i').className = 'bi ' + (mostrando ? 'bi-chevron-up' : 'bi-list-ul');
        }
    }

    function abrir(menu, gatilho, x, y) {
        fechar(false);
        // Fecha os popovers do cabeçalho (pasta-show.js): um menu por vez.
        document.dispatchEvent(new CustomEvent('ps:fechar-popovers'));
        if (menu.id === 'psPagamentosMenu') { prepararMenuPagamentos(menu); }
        menu.hidden = false;
        posicionar(menu, x, y);
        gatilho.setAttribute('aria-expanded', 'true');
        aberto = { menu: menu, gatilho: gatilho };
    }

    /* Menu do registro do Relatório financeiro (FPN-006). Título "autor · data e hora",
       como o do desenho (dc 5958). Editar e Excluir funcionam se o cartão traz os
       botões da janela de 15 min — o servidor só os põe para o autor, dentro do prazo —
       e levam os minutos que restam, como no desenho ("Editar · 12 min"). Sem os
       botões, o desenho os mostra bloqueados (FPN-006b): "Editar · bloqueado" e
       "Excluir · bloqueado", cadeado, sem a cor de perigo, com o motivo do desenho
       (`comPerm`) — sem a frase do usuário primário, que neste sistema não tem a exceção.
       C7-FPN-02: o bloqueado é CLICÁVEL e diz o motivo num aviso neutro (dc 5958/5904,
       `gmAviso(pm.motivo)`): `aria-disabled` + `data-aviso`, nunca `disabled`, que engolia
       o clique e deixava o motivo só no `title` (invisível no toque e no teclado).
       C6-FPN-05: os minutos saem do `data-janela-ate` do cartão (epoch do servidor) a CADA
       abertura, como em Detalhes; passada a janela com a página aberta, os dois viram
       "· bloqueado" com o motivo do prazo (o servidor recusaria). */
    function pintarItemObs(item, pode, rotulo, icone, motivo) {
        item.disabled = false;
        if (pode) {
            item.removeAttribute('aria-disabled');
            item.removeAttribute('data-aviso');
            item.removeAttribute('title');
        } else {
            item.setAttribute('aria-disabled', 'true');
            item.setAttribute('data-aviso', motivo);
            item.title = motivo;
        }
        item.querySelector('i').className = 'bi ' + icone;
        item.querySelector('span').textContent = rotulo;
    }
    /* Os minutos que restam da janela, com a regra do servidor (`minutosRestantes`: teto,
       de 1 a 15; 0 = vencida) — a mesma de Detalhes (`minutosRestantesObs`) e do Registro. */
    function minutosRestantesObs(artigo) {
        const ate = Number(artigo ? artigo.dataset.janelaAte : 0) * 1000;
        const ms  = ate - Date.now();
        if (!ate || ms <= 0) { return 0; }
        return Math.min({{ comentario_janela_minutos() }}, Math.max(1, Math.ceil(ms / 60000)));
    }
    let obsAlvo = null;
    function prepararMenuObs(menu, registro) {
        obsAlvo = registro;
        // "Destacar" e "Remover destaque" (dc L6305), só para quem edita: pasta-destaque.js.
        if (window.PastaDestaque) { window.PastaDestaque.pintarMenu(menu, registro, 'financeiro'); }
        const autor = textoLimpo(registro.querySelector('.ps-anotacao-autor'));
        const data  = registro.querySelector('.ps-anotacao-data');
        const quando = data ? (data.getAttribute('title') || textoLimpo(data)) : '';
        menu.querySelector('.ps-fin-menu-titulo').textContent = autor + (quando ? ' · ' + quando : '');

        // Responder (FPN-005): o item só existe para quem escreve; vale se o cartão traz o botão.
        const responder = menu.querySelector('.js-fin-obs-responder');
        if (responder) { responder.disabled = !registro.querySelector('.btn-responder-obs'); }

        // C7-FPN-01: quem não escreve não recebe Editar/Excluir no menu; nada a pintar.
        const editar  = menu.querySelector('.js-fin-obs-editar');
        const excluir = menu.querySelector('.js-fin-obs-excluir');
        if (!editar || !excluir) { return; }

        // Só o item que nasceu liberado (com os botões da janela no cartão) pode seguir liberado;
        // o que nasceu bloqueado não reabre.
        const nasceuLiberado = !!registro.querySelector('.btn-editar-obs') && !!registro.querySelector('.btn-excluir-obs');
        const resto = nasceuLiberado ? minutosRestantesObs(registro) : 0;
        const pelaRegra = resto > 0 && registro.getAttribute('data-obs-do-autor') === '1';
        // Edição sem prazo (spec edicao-sem-prazo §5): Master e primário (com a opção) seguem sem prazo, com o selo.
        const selo = nasceuLiberado && !pelaRegra ? (registro.dataset.semPrazoRotulo || '') : '';
        const podeGerenciar = pelaRegra || selo !== '';
        excluir.classList.toggle('ps-fin-menu-item--perigo', podeGerenciar);
        if (window.SeloSemPrazo) { window.SeloSemPrazo.pintar(editar, selo); window.SeloSemPrazo.pintar(excluir, selo); }
        if (selo) {
            pintarItemObs(editar, true, BJ_T.t('pasta_financeiro.js.editar_sem_prazo'), 'bi-pencil', '');
            pintarItemObs(excluir, true, BJ_T.t('pasta_financeiro.js.excluir_sem_prazo'), 'bi-trash3', '');
            return;
        }

        if (!podeGerenciar) {
            const motivo = registro.getAttribute('data-obs-do-autor') === '1' ? BJ_T.t('pasta_financeiro.js.motivo_prazo') : BJ_T.t('pasta_financeiro.js.motivo_autor');
            pintarItemObs(editar, false, BJ_T.t('pasta_financeiro.js.editar_bloqueado'), 'bi-lock', motivo);
            pintarItemObs(excluir, false, BJ_T.t('pasta_financeiro.js.excluir_bloqueado'), 'bi-lock', motivo);
            return;
        }

        pintarItemObs(editar, true, BJ_T.t('pasta_financeiro.js.editar_min', { minutos: resto }), 'bi-pencil', '');
        pintarItemObs(excluir, true, BJ_T.t('pasta_financeiro.js.excluir_min', { minutos: resto }), 'bi-trash3', '');
    }

    function menuDoGatilho(gatilho) {
        return document.getElementById(gatilho.getAttribute('aria-controls') || '');
    }

    function copiar(texto, rotulo, aviso) {
        const original = rotulo ? rotulo.textContent : '';
        const menuDaVez = aberto ? aberto.menu : null;
        // O menu fica aberto o tempo de mostrar o aviso, como o "Copiar link" do
        // cabeçalho; só fecha se ainda for o MESMO menu aberto.
        function avisar(msg) {
            if (rotulo) { rotulo.textContent = msg; }
            setTimeout(function () {
                if (rotulo) { rotulo.textContent = original; }
                if (aberto && aberto.menu === menuDaVez) { fechar(false); }
            }, 1200);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(texto).then(
                function () { avisar(aviso); },
                function () { avisar(BJ_T.t('pasta_financeiro.js.nao_copiou')); }
            );
        } else {
            avisar(BJ_T.t('pasta_financeiro.js.nao_copiou'));
        }
    }

    function textoLimpo(el) {
        return el ? el.textContent.replace(/\s+/g, ' ').trim() : '';
    }

    function resumoDosPagamentos() {
        const folha = document.getElementById('psExtratoFolha');
        if (!folha) { return ''; }
        const linhas = Array.prototype.map.call(folha.querySelectorAll('.ps-fin-extrato-lista li'), textoLimpo);
        return BJ_T.t('pasta_financeiro.js.resumo_pagamentos', { total: textoLimpo(folha.querySelector('.ps-fin-extrato-total')) }) + '\n' + linhas.join('\n');
    }

    /* "Imprimir extrato" (desenho dc 3515 → `gmImprimir`, EDT-004/FPN-010): a MESMA janela
       do Imprimir resumo (pasta-impressao.js), com a folha do servidor — tarja, cabeçalho
       BLUEJUS, faixa Pasta/Cliente/Processo e rodapé "Documento interno do escritório ·
       BlueJus". Sem a janela na página (script não carregou), a impressão antiga direta. */
    function imprimirExtrato() {
        if (window.PastaImpressao && window.PastaImpressao.extrato()) { return; }

        const cab   = document.getElementById('psExtratoCabecalho');
        const folha = document.getElementById('psExtratoFolha');
        if (!cab || !folha) { return; }

        document.querySelectorAll('body > .ps-fin-impressao').forEach(function (el) { el.remove(); });

        const impressao = document.createElement('div');
        impressao.className = 'ps-fin-impressao';
        [cab, folha].forEach(function (origem) {
            const copia = origem.cloneNode(true);
            copia.hidden = false;
            copia.removeAttribute('id');
            impressao.appendChild(copia);
        });
        const emitido = impressao.querySelector('.js-extrato-emitido-em');
        if (emitido) {
            emitido.textContent = new Date().toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
        }

        document.body.appendChild(impressao);
        document.body.classList.add('ps-fin-imprimindo');

        function limpar() {
            window.removeEventListener('afterprint', limpar);
            document.body.classList.remove('ps-fin-imprimindo');
            impressao.remove();
        }
        window.addEventListener('afterprint', limpar);
        window.print();
    }

    function irParaDocumentos() {
        const gatilho = document.getElementById('documentos-tab');
        if (gatilho && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(gatilho).show(); }
    }

    /* Aviso curto do desenho (`gmAviso`). Reaproveita a caixa `.ps-l7-aviso` que a
       tela já tem, criada sob demanda como em pasta-clientes.js. */
    let avisoTimer = null;
    function avisar(texto) {
        let el = document.querySelector('.ps-l7-aviso');
        if (!el) {
            el = document.createElement('div');
            el.className = 'ps-l7-aviso';
            el.setAttribute('role', 'status');
            el.setAttribute('aria-live', 'polite');
            document.body.appendChild(el);
        }
        el.textContent = texto;
        el.classList.add('is-visivel');
        clearTimeout(avisoTimer);
        avisoTimer = setTimeout(function () { el.classList.remove('is-visivel'); }, 1800);
    }

    /* Sem e-mail do cliente: o desenho leva à aba Dados e avisa (dc 6546). */
    function emailSemCadastro() {
        const gatilho = document.getElementById('dados-tab');
        if (gatilho && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(gatilho).show(); }
        avisar(BJ_T.t('pasta_financeiro.js.email_sem_cadastro'));
    }

    // Clique FORA fecha, em captura: os gatilhos do cabeçalho (pasta-show.js)
    // param a propagação, e o menu ficaria aberto por baixo do outro.
    document.addEventListener('click', function (e) {
        if (!aberto) { return; }
        if (aberto.menu.contains(e.target) || aberto.gatilho.contains(e.target)) { return; }
        fechar(false);
    }, true);

    document.addEventListener('click', function (e) {
        const gatilho = e.target.closest('.ps-fin-menu-gatilho');
        if (gatilho) {
            const menu = menuDoGatilho(gatilho);
            if (!menu) { return; }
            if (aberto && aberto.menu === menu) { fechar(false); return; }
            const r = gatilho.getBoundingClientRect();
            abrir(menu, gatilho, r.right, r.bottom + 4);
            return;
        }

        if (!aberto) { return; }
        const item = e.target.closest('.ps-fin-menu-item');
        if (!item || !aberto.menu.contains(item) || item.disabled) { return; }

        // C7-FPN-02: "Editar · bloqueado" / "Excluir · bloqueado" não agem — dizem POR QUE, num
        // aviso neutro (o `gmAviso` do desenho), e o menu fecha. Vem antes de qualquer ação.
        if (item.getAttribute('aria-disabled') === 'true') {
            const motivo = item.getAttribute('data-aviso') || item.getAttribute('title') || '';
            obsAlvo = null;
            fechar(false);
            if (window.avisarPs) { window.avisarPs(motivo); /* neutro, como o gmAviso do desenho */ } else { avisar(motivo); }
            return;
        }

        if (item.classList.contains('js-fin-doc-copiar-nome')) {
            // Sem Renomear (quem não escreve), o nome vem do título do próprio menu.
            const ren    = aberto.menu.querySelector('.btn-renomear-doc');
            const titulo = aberto.menu.querySelector('.ps-fin-menu-titulo');
            copiar(ren ? ren.dataset.titulo : (titulo ? (titulo.getAttribute('title') || textoLimpo(titulo)) : ''), item.querySelector('span'), BJ_T.t('pasta_financeiro.js.nome_copiado'));
            return;
        }
        if (item.classList.contains('js-pag-copiar-resumo')) {
            copiar(resumoDosPagamentos(), item.querySelector('span'), BJ_T.t('pasta_financeiro.js.resumo_copiado'));
            return;
        }
        if (item.classList.contains('js-fin-obs-copiar')) {
            copiar(textoLimpo(obsAlvo ? obsAlvo.querySelector('.obs-conteudo .ql-editor') : null), item.querySelector('span'), BJ_T.t('pasta_financeiro.js.texto_copiado'));
            return;
        }

        fechar(false);

        // Responder, Encaminhar, Editar e Excluir do registro clicam os botões do próprio cartão: o
        // handler deles (no _financeiro_obs_script e no pasta-encaminhar.js) é o único caminho.
        if (item.classList.contains('js-fin-obs-editar') || item.classList.contains('js-fin-obs-excluir') || item.classList.contains('js-fin-obs-responder') || item.classList.contains('js-fin-obs-encaminhar')) {
            const seletor = item.classList.contains('js-fin-obs-responder') ? '.btn-responder-obs'
                : item.classList.contains('js-fin-obs-encaminhar') ? '.js-encaminhar'
                : (item.classList.contains('js-fin-obs-editar') ? '.btn-editar-obs' : '.btn-excluir-obs');
            // `:scope > .ps-anotacao-topo`: o botão do PRÓPRIO cartão.
            const botao = obsAlvo ? obsAlvo.querySelector(':scope > .ps-anotacao-topo ' + seletor) : null;
            obsAlvo = null;
            if (botao) { botao.click(); }
            return;
        }

        if (item.classList.contains('js-fin-doc-ver-documentos')) { irParaDocumentos(); return; }
        if (item.classList.contains('js-fin-doc-email-sem-cadastro')) { emailSemCadastro(); return; }
        if (item.classList.contains('js-pag-editar')) {
            // O modo de edição é do script de Pagamentos, que ouve este evento.
            document.dispatchEvent(new CustomEvent('ps:pagamentos-alternar-edicao'));
            return;
        }
        if (item.classList.contains('js-pag-ver-todos')) {
            // Só uma classe no cartão: as linhas escondidas já estão no HTML.
            document.getElementById('psPagamentos')?.classList.toggle('is-mostrando-todos');
            return;
        }
        if (item.classList.contains('js-pag-imprimir-extrato')) { imprimirExtrato(); }
        // Abrir (modal), Baixar (link), Enviar por e-mail (link `mailto:`),
        // Adicionar pagamento (modal), Renomear e Excluir seguem o próprio
        // caminho: Bootstrap, o navegador e o handler da lista. Os itens do menu
        // da LINHA de pagamento (Corrigir valor, quitar, excluir) carregam
        // `data-acao` e são atendidos pelo script de Pagamentos.
    });

    // Clique direito: na linha do arquivo abre o menu DELA no ponto do clique;
    // no ⋮ de Pagamentos, o menu dele. Durante a renomeação o campo é do usuário.
    document.addEventListener('contextmenu', function (e) {
        if (e.target.closest('input, textarea, .ps-fin-menu')) { return; }
        // Registro do Relatório financeiro (dc 1795, FPN-006): menu no ponto do clique.
        // Links, botões e o editor aberto seguem com o menu do navegador.
        const registro = e.target.closest('#financeiroObsLista .ps-anotacao');
        if (registro) {
            const menuObs = document.getElementById('financeiroObsMenu');
            if (!menuObs || e.target.closest('a, button, .ps-anotacao-edicao')) { return; }
            e.preventDefault();
            prepararMenuObs(menuObs, registro);
            abrir(menuObs, registro, e.clientX, e.clientY);
            return;
        }
        // Linha de pagamento (dc 3448-3456, `onContextMenu`): não tem ⋮ à vista no
        // desenho; o menu dela abre só pelo clique direito, e a própria linha
        // faz o papel do gatilho.
        const linhaPag = e.target.closest('#psPagamentosCorpo .ps-pag-linha[aria-controls]');
        if (linhaPag) {
            const menuPag = menuDoGatilho(linhaPag);
            if (!menuPag) { return; }
            e.preventDefault();
            abrir(menuPag, linhaPag, e.clientX, e.clientY);
            return;
        }

        const linha   = e.target.closest('#financeiro-docs-lista .ps-fin-doc');
        const gatilho = linha ? linha.querySelector('.ps-fin-menu-gatilho') : e.target.closest('#financeiro .ps-fin-menu-gatilho');
        if (!gatilho) { return; }
        const menu = menuDoGatilho(gatilho);
        if (!menu) { return; }
        e.preventDefault();
        abrir(menu, gatilho, e.clientX, e.clientY);
    });

    // Duplo clique na linha abre o arquivo no visualizador (desenho: `onDblClick`).
    document.addEventListener('dblclick', function (e) {
        if (e.target.closest('input, textarea, .ps-fin-menu, .ps-fin-menu-gatilho')) { return; }
        const linha = e.target.closest('#financeiro-docs-lista .ps-fin-doc');
        const abrirItem = linha ? linha.querySelector('[data-bs-target="#previewDocModal"]') : null;
        if (abrirItem) { abrirItem.click(); }
    });

    document.addEventListener('keydown', function (e) {
        if (aberto && e.key === 'Escape') { fechar(true); }
    });
    // Menu fixo não acompanha a rolagem: rolou a página, fecha.
    window.addEventListener('scroll', function (e) {
        if (aberto && !(e.target instanceof Node && aberto.menu.contains(e.target))) { fechar(false); }
    }, true);
    window.addEventListener('resize', function () { fechar(false); });
})();
</script>

