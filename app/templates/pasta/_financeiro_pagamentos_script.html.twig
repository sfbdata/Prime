{# ============================================================================
   Aba Financeiro — card Pagamentos: quitar, excluir, corrigir valor (modo de
   edição) e o modal de novo lançamento. O "Ver todos os lançamentos" mora no menu ⋮ do card (script dos
   menus, em `_financeiro.html.twig`).

   O corpo do card NÃO é remendado no navegador: toda mudança devolve o bloco
   inteiro já renderizado pelo servidor (`_financeiro_pagamentos.html.twig`), e o
   JS só troca o innerHTML. É o que garante que o total, a barra e as linhas
   contem sempre a mesma história.

   O modal `#modalNovoPagamento` vive FORA de `.ps-page`, no show.html.twig:
   modal dentro do painel animado fica preso abaixo do backdrop (ancestral com
   `transform` vira bloco de contenção de `position: fixed`). Já aconteceu nesta
   tela com três modais do gerenciador de arquivos, e há teste travando isso.
   ============================================================================ #}
<script>
(function () {
    'use strict';

    const cartao = document.getElementById('psPagamentos');
    if (!cartao) { return; }

    const corpo    = document.getElementById('psPagamentosCorpo');
    const contagem = document.getElementById('psPagamentosTotal');

    /** Troca o card inteiro pelo HTML que o servidor acabou de renderizar. */
    function aplicarResumo(resumo) {
        if (!resumo) { return; }
        corpo.innerHTML = resumo.html;
        if (contagem) { contagem.textContent = String(resumo.total); }
    }

    async function postar(url, csrf, extras) {
        const fd = new FormData();
        fd.append('_token', csrf);
        for (const [chave, valor] of Object.entries(extras ?? {})) { fd.append(chave, valor); }

        const resp = await fetch(url, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });

        return { ok: resp.ok, status: resp.status, data: await resp.json() };
    }

    // ── Modo de edição ("Editar ou corrigir valores", dc 3506-3509) ─────────
    // Estado no CARTÃO, não no corpo: o corpo é trocado a cada resposta e o
    // modo tem de continuar ligado depois de uma correção. Entrar mostra todos
    // os lançamentos, como no desenho (`finTodos: true`).
    const botaoConcluir = document.getElementById('psPagamentosConcluir');

    function definirEdicao(ligado) {
        cartao.classList.toggle('is-editando', ligado);
        if (ligado) { cartao.classList.add('is-mostrando-todos'); }
        if (botaoConcluir) { botaoConcluir.hidden = !ligado; }
        if (!ligado) { cancelarCorrecao(); }
    }

    document.addEventListener('ps:pagamentos-alternar-edicao', function () {
        definirEdicao(!cartao.classList.contains('is-editando'));
    });
    if (botaoConcluir) {
        botaoConcluir.addEventListener('click', function () { definirEdicao(false); });
    }

    // ── Corrigir valor no lugar (dc 3443-3447) ──────────────────────────────
    // Enter salva, Esc cancela. O confirm é o texto do desenho. O servidor é
    // quem valida e grava; o navegador só evita a ida quando nada mudou.
    let corrigindo = null; // { linha, caixa }

    const ERRO_FORMATO = 'Informe apenas números, como 12.860,00.';
    const ERRO_CASAS   = 'Use no máximo duas casas decimais, como 12.860,00.';

    /**
     * "1.234,56" / "1234.56" → { numero, erro }, só para comparar, montar o
     * confirm e recusar antes da ida. Mesma leitura do `ValorEmReais` do
     * servidor (com vírgula, o ponto é milhar; sem vírgula, só é milhar em
     * grupos exatos de três, "1.234") e as MESMAS mensagens — inclusive a das
     * mais de duas casas, que sem isto passava pelo confirm com o valor
     * arredondado ("10,505" virava "R$ 10,51") e só então o servidor recusava.
     */
    function lerValor(texto) {
        const t = String(texto).replace(/R\$|r\$|\s/g, '');
        // Vazio não é erro de formato: cai no "maior que zero" de quem chama.
        if (t === '') { return { numero: NaN, erro: null }; }
        if (/[^0-9.,]/.test(t)) { return { numero: NaN, erro: ERRO_FORMATO }; }

        let inteiro;
        let decimal;
        if (t.indexOf(',') >= 0) {
            const partes = t.split(',');
            if (partes.length > 2 || partes[1].indexOf('.') >= 0) { return { numero: NaN, erro: ERRO_FORMATO }; }
            inteiro = partes[0].replace(/\./g, '');
            decimal = partes[1];
        } else if (/^[1-9]\d{0,2}(\.\d{3})+$/.test(t)) {
            inteiro = t.replace(/\./g, '');
            decimal = '';
        } else {
            const partes = t.split('.');
            if (partes.length > 2) { return { numero: NaN, erro: ERRO_FORMATO }; }
            inteiro = partes[0];
            decimal = partes[1] ?? '';
        }

        if (inteiro === '' && decimal === '') { return { numero: NaN, erro: ERRO_FORMATO }; }
        if (decimal.length > 2) { return { numero: NaN, erro: ERRO_CASAS }; }

        return { numero: Number((inteiro || '0') + '.' + (decimal || '0')), erro: null };
    }

    function brl(n) {
        return 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function cancelarCorrecao() {
        if (!corrigindo) { return; }
        corrigindo.caixa.remove();
        corrigindo.linha.classList.remove('is-corrigindo');
        corrigindo = null;
    }

    function abrirCorrecao(linha) {
        cancelarCorrecao();

        const caixa = document.createElement('div');
        caixa.className = 'ps-pag-edicao';

        const moeda = document.createElement('span');
        moeda.className = 'ps-pag-edicao-moeda';
        moeda.textContent = 'R$';

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'ps-pag-edicao-input ps-num';
        input.inputMode = 'decimal';
        input.maxLength = 20;
        input.value = linha.dataset.valor || '';
        input.setAttribute('aria-label', 'Novo valor de ' + (linha.dataset.descricao || ''));

        const salvar = document.createElement('button');
        salvar.type = 'button';
        salvar.className = 'ps-pag-edicao-salvar';
        salvar.title = 'Salvar (Enter)';
        salvar.setAttribute('aria-label', 'Salvar valor');
        salvar.innerHTML = '<i class="bi bi-check-lg"></i>';

        const cancelar = document.createElement('button');
        cancelar.type = 'button';
        cancelar.className = 'ps-pag-edicao-cancelar';
        cancelar.title = 'Cancelar (Esc)';
        cancelar.setAttribute('aria-label', 'Cancelar');
        cancelar.innerHTML = '<i class="bi bi-x-lg"></i>';

        caixa.append(moeda, input, salvar, cancelar);
        linha.querySelector('.ps-pag-direita').prepend(caixa);
        linha.classList.add('is-corrigindo');
        corrigindo = { linha: linha, caixa: caixa };

        input.addEventListener('input', function () { input.classList.remove('is-erro'); });
        input.addEventListener('keydown', function (ev) {
            if (ev.key === 'Enter') { ev.preventDefault(); salvarCorrecao(linha, input, salvar); }
            if (ev.key === 'Escape') { ev.stopPropagation(); cancelarCorrecao(); }
        });
        salvar.addEventListener('click', function () { salvarCorrecao(linha, input, salvar); });
        cancelar.addEventListener('click', cancelarCorrecao);

        input.focus();
        input.select();
    }

    async function salvarCorrecao(linha, input, botao) {
        const lido  = lerValor(input.value);
        const novo  = lido.numero;
        const atual = lerValor(linha.dataset.valor || '').numero;

        if (lido.erro !== null) {
            input.classList.add('is-erro');
            alert(lido.erro);
            input.focus();
            return;
        }
        if (!(novo > 0)) { input.classList.add('is-erro'); input.focus(); return; }
        if (Math.abs(novo - atual) < 0.005) { cancelarCorrecao(); return; }

        const pergunta = 'Corrigir "' + (linha.dataset.descricao || '') + '" de ' + brl(atual) + ' para ' + brl(novo) + '?'
            + '\n\nA alteração fica registrada no histórico com seu nome, data e hora.';
        if (!window.confirm(pergunta)) { return; }

        const url = cartao.dataset.baseUrlCorrigir.replace('__ID__', linha.dataset.pagamentoId);
        botao.disabled = true;
        try {
            // `valorAnterior` é o valor que esta tela MOSTROU: se outra pessoa
            // corrigiu no meio do caminho, o servidor responde 409 sem gravar.
            const { ok, status, data } = await postar(url, linha.dataset.csrfCorrigir, {
                valor: input.value,
                valorAnterior: linha.dataset.valor || '',
            });
            if (status === 409) {
                // Nada foi gravado. O card volta relido do servidor, já com o
                // valor que vale agora; a caixa de correção fecha junto.
                alert(data.erro ?? 'O valor foi alterado por outra pessoa. Recarregue e confira antes de corrigir.');
                corrigindo = null;
                if (data.resumo) { aplicarResumo(data.resumo); } else { window.location.reload(); }
                return;
            }
            if (!ok) {
                input.classList.add('is-erro');
                alert(data.erro ?? data.mensagem ?? 'Erro ao corrigir o valor.');
                return;
            }
            corrigindo = null;
            aplicarResumo(data.resumo);
        } catch (_) {
            alert('Erro de rede. Tente novamente.');
        } finally {
            botao.disabled = false;
        }
    }

    // ── Quitar / desfazer, excluir e corrigir ───────────────────────────────
    corpo.addEventListener('click', async function (e) {
        if (e.target.closest('.js-pag-entrar-edicao')) { definirEdicao(true); return; }

        const alvo = e.target.closest('[data-acao]');
        if (!alvo) { return; }

        const id = alvo.dataset.pagamentoId;

        if (alvo.dataset.acao === 'corrigir') {
            const linha = corpo.querySelector('.ps-pag-linha[data-pagamento-id="' + CSS.escape(id) + '"]');
            if (linha) { abrirCorrecao(linha); }

            return;
        }

        if (alvo.dataset.acao === 'quitacao') {
            const url = cartao.dataset.baseUrlQuitacao.replace('__ID__', id);
            alvo.disabled = true;
            try {
                const { ok, data } = await postar(url, alvo.dataset.csrf);
                if (!ok) { alert(data.erro ?? data.mensagem ?? 'Erro ao alterar o pagamento.'); return; }
                aplicarResumo(data.resumo);
            } catch (_) {
                alert('Erro de rede. Tente novamente.');
            } finally {
                alvo.disabled = false;
            }

            return;
        }

        if (alvo.dataset.acao === 'excluir') {
            if (!confirm('Excluir este lançamento? Esta ação não pode ser desfeita.')) { return; }

            const url = cartao.dataset.baseUrlExcluir.replace('__ID__', id);
            try {
                const { ok, data } = await postar(url, alvo.dataset.csrf);
                if (!ok) { alert(data.erro ?? data.mensagem ?? 'Erro ao excluir.'); return; }
                aplicarResumo(data.resumo);
            } catch (_) {
                alert('Erro de rede. Tente novamente.');
            }
        }
    });

    // ── Modal "Adicionar pagamento" (desenho 1.2.3, dc L.1928-2012) ─────────
    // A prévia é calculada AQUI só para mostrar, com a mesma regra do servidor
    // (`CalculadoraDeParcelamento`): sem juros P/n e a última leva a diferença;
    // com juros Price, pmt = P·i/(1−(1+i)^−n), cada parcela é o pmt ao centavo e
    // a última fecha arred(pmt × n). Tudo em CENTAVOS inteiros. O POST leva só os
    // campos — o servidor refaz a conta e é a conta dele que vale.
    //
    // O modal vem DEPOIS deste script no documento (show.html.twig, fora de
    // `.ps-page`): buscá-lo na hora da execução devolvia null e o script saía
    // calado — prévia sem cálculo, 1º vencimento vazio, botão desabilitado.
    // Por isso a parte do modal só inicializa com o DOM pronto.
    function iniciarModalNovoPagamento() {
        const modalEl = document.getElementById('modalNovoPagamento');
        const form    = document.getElementById('formNovoPagamento');
        if (!modalEl || !form) { return; }

        const MAX_PARCELAS = parseInt(modalEl.dataset.maxParcelas, 10) || 60;
        const btnGerar     = document.getElementById('btnSalvarPagamento');
        const el = {
            causa:     modalEl.querySelector('.js-np-causa'),
            nota:      modalEl.querySelector('.js-np-tipo-nota'),
            campoTot:  modalEl.querySelector('.js-np-campo-total'),
            campoPct:  modalEl.querySelector('.js-np-campo-pct'),
            taxa:      form.querySelector('[name="taxa"]'),
            resumo:    modalEl.querySelector('.js-np-resumo'),
            linhas:    modalEl.querySelector('.js-np-linhas'),
            mais:      modalEl.querySelector('.js-np-mais'),
            erro:      modalEl.querySelector('.js-np-erro'),
            vazio:     modalEl.querySelector('.js-np-vazio'),
        };
        const valorDe = (nome) => String(form.querySelector('[name="' + nome + '"]').value ?? '');
        const definir = (nome, valor) => { form.querySelector('[name="' + nome + '"]').value = valor; };

        const doisDig = (n) => String(n).padStart(2, '0');
        const iso     = (d) => d.getFullYear() + '-' + doisDig(d.getMonth() + 1) + '-' + doisDig(d.getDate());
        const dataBR  = (i) => i.split('-').reverse().join('/');
        const brlCentavos = (c) => (c / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        function hojeIso() { const h = new Date(); h.setHours(0, 0, 0, 0); return iso(h); }

        /** Mês k a partir de `i`, ancorado no dia: 31/01 → 28/02 → 31/03 (dc `addM`). */
        function somarMeses(i, k) {
            const [a, m, d] = i.split('-').map(Number);
            const ultimo = new Date(a, m - 1 + k + 1, 0).getDate();

            return iso(new Date(a, m - 1 + k, Math.min(d, ultimo)));
        }

        /**
         * Reais digitados → centavos, com as regras do `ValorEmReais` do servidor.
         * Em branco → null; texto que não é dinheiro → NaN.
         */
        function centavosDe(texto) {
            const t = String(texto ?? '').replace(/R\$|r\$|\s| | /g, '');
            if (t === '') { return null; }
            if (t.startsWith('-') || /[^0-9.,]/.test(t)) { return NaN; }

            let inteiro, decimal;
            if (t.includes(',')) {
                const partes = t.split(',');
                if (partes.length > 2 || partes[1].includes('.')) { return NaN; }
                inteiro = partes[0].replace(/\./g, '');
                decimal = partes[1];
            } else if (/^[1-9]\d{0,2}(\.\d{3})+$/.test(t)) {
                inteiro = t.replace(/\./g, '');
                decimal = '';
            } else {
                const partes = t.split('.');
                if (partes.length > 2) { return NaN; }
                inteiro = partes[0];
                decimal = partes[1] ?? '';
            }

            if ((inteiro === '' && decimal === '') || decimal.length > 2) { return NaN; }
            inteiro = inteiro.replace(/^0+/, '') || '0';
            if (inteiro.length > 13) { return NaN; }

            return parseInt(inteiro, 10) * 100 + parseInt((decimal + '00').slice(0, 2), 10);
        }

        /** "20", "1,5" → número; o mesmo formato curto que o servidor aceita. */
        function decimalCurto(texto) {
            const m = String(texto ?? '').replace(/[\s% ]/g, '').match(/^(\d{1,3})(?:[.,](\d{1,4}))?$/);

            return m ? Number(m[1] + '.' + (m[2] ?? '0')) : null;
        }

        function calcularParcelas(principal, n, taxaPct) {
            let parcela, total;
            if (taxaPct > 0) {
                const i = taxaPct / 100, f = Math.pow(1 + i, n), pmt = principal * i * f / (f - 1);
                parcela = Math.round(pmt);
                total   = Math.round(pmt * n);
            } else {
                parcela = Math.floor((2 * principal + n) / (2 * n));
                total   = principal;
            }
            const ultima = total - parcela * (n - 1);
            if (parcela <= 0 || ultima <= 0) { return null; }

            return Array.from({ length: n }, (_, k) => (k === n - 1 ? ultima : parcela));
        }

        function causaCentavos() {
            const vc = document.getElementById('financeiro-valor-causa');
            const c  = centavosDe(String(vc?.dataset.valor ?? '').replace('.', ','));

            return Number.isFinite(c) ? c : 0;
        }

        /** O que a prévia mostra e o botão promete. Espelho da regra do dc L.3470-3500. */
        function calcular() {
            const tipo   = valorDe('tipo');
            const rotulo = tipo === 'custas' ? 'custas' : 'honorários';
            const base   = valorDe('base');
            let total;

            if (base === 'pct') {
                const pct = decimalCurto(valorDe('percentual'));
                if (pct === null || !(pct > 0 && pct <= 100)) { return { novos: [], erro: 'Informe um percentual entre 0 e 100.' }; }
                const causa = causaCentavos();
                if (causa <= 0) { return { novos: [], erro: 'Informe o valor da causa antes de calcular por percentual.' }; }
                total = Math.round(causa * pct / 100);
            } else {
                total = centavosDe(valorDe('total'));
                if (total === null) { return { novos: [], erro: '' }; }
                if (Number.isNaN(total)) { return { novos: [], erro: 'Informe apenas números, como 12.860,00.' }; }
            }
            if (!(total > 0)) { return { novos: [], erro: 'Informe o valor total.' }; }

            const venc = valorDe('vencimento');
            if (!/^\d{4}-\d{2}-\d{2}$/.test(venc)) { return { novos: [], erro: 'Informe o 1º vencimento.' }; }

            const entDigitada = centavosDe(valorDe('entrada'));
            if (Number.isNaN(entDigitada)) { return { novos: [], erro: 'Informe apenas números, como 12.860,00.' }; }
            const ent = Math.min(entDigitada ?? 0, total);
            const n   = Math.max(1, Math.min(MAX_PARCELAS, parseInt(valorDe('parcelas'), 10) || 1));

            let taxa = 0;
            if (valorDe('juros') === '1') {
                taxa = decimalCurto(valorDe('taxa'));
                if (taxa === null || !(taxa > 0 && taxa <= 10)) { return { novos: [], erro: 'Informe os juros ao mês entre 0 e 10%.' }; }
            }

            // Descrição livre opcional (fora do desenho): mesma regra do servidor.
            const livre = valorDe('descricao').replace(/\s+/g, ' ').trim();
            const novos = [];
            const hoje  = hojeIso();
            if (ent > 0) { novos.push({ d: livre ? livre + ' · entrada' : 'Entrada · ' + rotulo, q: dataBR(hoje), v: ent }); }

            const principal = total - ent;
            if (principal > 0) {
                const valores = calcularParcelas(principal, n, taxa);
                if (valores === null) { return { novos: [], erro: 'O valor é pequeno demais para ' + n + ' parcelas. Diminua o número de parcelas.' }; }
                valores.forEach((v, k) => novos.push({
                    d: livre
                        ? (n === 1 ? livre : livre + ' · ' + (k + 1) + '/' + n)
                        : (n === 1 ? (tipo === 'custas' ? 'Custas e despesas' : 'Honorários contratuais') : (k + 1) + 'ª parcela · ' + rotulo),
                    q: dataBR(somarMeses(venc, k)),
                    v,
                }));
            }

            return { novos, erro: '', n };
        }

        function marcar(botoes, ativo) {
            botoes.forEach((b) => { const on = b === ativo; b.classList.toggle('is-ativo', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        }

        function renderizar() {
            const pct = valorDe('base') === 'pct';
            el.campoTot.hidden = pct;
            el.campoPct.hidden = !pct;
            el.taxa.hidden     = valorDe('juros') !== '1';

            const { novos, erro } = calcular();
            const soma = novos.reduce((t, x) => t + x.v, 0);

            el.linhas.replaceChildren(...novos.slice(0, 5).map((x) => {
                const linha = document.createElement('div');
                linha.className = 'ps-np-previa-linha';
                [['ps-np-previa-desc', x.d], ['ps-np-previa-quando', x.q], ['ps-np-previa-valor', brlCentavos(x.v)]].forEach(([c, t]) => {
                    const s = document.createElement('span'); s.className = c; s.textContent = t; linha.appendChild(s);
                });

                return linha;
            }));
            el.resumo.textContent = novos.length ? novos.length + (novos.length === 1 ? ' lançamento · ' : ' lançamentos · ') + brlCentavos(soma) : '';
            el.mais.hidden        = novos.length <= 5;
            el.mais.textContent   = '+ ' + (novos.length - 5) + ' parcelas';
            el.erro.hidden        = !erro;
            el.erro.textContent   = erro;
            el.vazio.hidden       = !(novos.length === 0 && !erro);

            btnGerar.textContent = novos.length > 1 ? 'Gerar ' + novos.length + ' lançamentos' : 'Adicionar';
            btnGerar.disabled    = novos.length === 0;
        }

        modalEl.addEventListener('click', function (e) {
            const tipo = e.target.closest('.ps-np-tipo[data-tipo]');
            if (tipo && !tipo.disabled) {
                definir('tipo', tipo.dataset.tipo);
                marcar(modalEl.querySelectorAll('.ps-np-tipo'), tipo);
                el.nota.textContent = tipo.dataset.nota ?? '';
                renderizar();
                return;
            }
            const base = e.target.closest('[data-base]');
            if (base) {
                definir('base', base.dataset.base);
                marcar(modalEl.querySelectorAll('[data-base]'), base);
                renderizar();
                return;
            }
            const juros = e.target.closest('[data-juros]');
            if (juros) {
                definir('juros', juros.dataset.juros);
                marcar(modalEl.querySelectorAll('[data-juros]'), juros);
                renderizar();
            }
        });
        form.addEventListener('input', renderizar);
        form.addEventListener('change', renderizar);

        // Abre sempre no estado inicial do desenho (`base0`): contratuais, valor
        // fixo, 1 parcela, 1º vencimento daqui a um mês, sem juros (taxa 1).
        modalEl.addEventListener('show.bs.modal', function () {
            form.reset();
            ['tipo', 'base', 'juros'].forEach((n, i) => definir(n, ['contrato', 'valor', '0'][i]));
            marcar(modalEl.querySelectorAll('.ps-np-tipo'), modalEl.querySelector('.ps-np-tipo[data-tipo="contrato"]'));
            marcar(modalEl.querySelectorAll('[data-base]'), modalEl.querySelector('[data-base="valor"]'));
            marcar(modalEl.querySelectorAll('[data-juros]'), modalEl.querySelector('[data-juros="0"]'));
            el.nota.textContent = modalEl.querySelector('.ps-np-tipo[data-tipo="contrato"]').dataset.nota ?? '';
            definir('vencimento', somarMeses(hojeIso(), 1));

            // O valor da causa pode ter sido editado nesta tela depois da carga.
            const causa = causaCentavos();
            el.causa.textContent = causa > 0 ? brlCentavos(causa) : '—';
            renderizar();
        });

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const { novos, n } = calcular();
            if (!novos.length) { return; }

            const fd = new FormData(form);
            // A mesma quantidade que a prévia usou (o campo é limitado a 1–MAX).
            if (n) { fd.set('parcelas', String(n)); }
            btnGerar.disabled = true;

            try {
                const resp = await fetch(modalEl.dataset.urlParcelar, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();

                if (!resp.ok) {
                    // `mensagem` é a recusa da pasta excluída (PastaSomenteLeituraListener).
                    el.erro.textContent = data.erro || data.mensagem || 'Erro ao lançar o pagamento.';
                    el.erro.hidden = false;
                    btnGerar.disabled = false;
                    return;
                }

                aplicarResumo(data.resumo);
                // Como no desenho (`finTodos: true`): depois de gerar, a lista mostra tudo.
                cartao.classList.add('is-mostrando-todos');
                bootstrap.Modal.getInstance(modalEl)?.hide();
            } catch (_) {
                el.erro.textContent = 'Erro de rede. Tente novamente.';
                el.erro.hidden = false;
                btnGerar.disabled = false;
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciarModalNovoPagamento);
    } else {
        iniciarModalNovoPagamento();
    }
})();
</script>
