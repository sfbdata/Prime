{% extends 'layout_peticionar.html.twig' %}

{% set pastaInfoNup = pasta.nup %}
{% set pastaInfoCliente = nomeCliente %}

{# Pasta excluída (lápide) abre só para leitura, mesmo para quem pode editar: o servidor já recusa
   a escrita (PastaSomenteLeituraListener), e a tela não oferece o que seria recusado. Fica fora
   dos blocos porque o content e o javascripts usam. #}
{% set podeEditarPasta = not pasta.estaExcluida() and can_access_resource('pasta', pasta.id, 'edit') %}

{% block title %}{{ 'pasta_peticionar.titulo'|trans({nup: pasta.nup}) }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/peticionar-documentos.css') }}">
{% endblock %}

{% block content %}

{# Formatos do "Adicionar peça": o mesmo accept vale para o modal e para soltar arquivos na lista,
   e o ícone de cada um vem do arquivo_icone() (a linha nova, montada no navegador, usa o mesmo). #}
{% set formatosDoEnvio = ['pdf', 'png', 'jpg', 'jpeg', 'doc', 'docx', 'xls', 'xlsx', 'xml', 'kml'] %}
{% set iconesDoEnvio = {} %}
{% for ext in formatosDoEnvio %}
    {% set iconesDoEnvio = iconesDoEnvio|merge({(ext): arquivo_icone('arquivo.' ~ ext)}) %}
{% endfor %}

{% set categoriaCorMap = {
    'PECA':                    'text-bg-primary',
    'PROCURACAO':              'text-bg-success',
    'IDENTIFICACAO':           'text-bg-info',
    'COMPROVANTE_RESIDENCIA':  'text-bg-warning',
    'GRATUIDADE_JUSTICA':      'text-bg-secondary',
    'DEMAIS':                  'text-bg-secondary',
    'CONTRATO':                'text-bg-dark',
} %}

<div class="petic-layout">

    {# ──────────────────────────────────────────────────────────
       PAINEL ESQUERDO — Timeline
       ────────────────────────────────────────────────────────── #}
    <div class="petic-timeline">

        <div class="petic-timeline-header">
            <div class="petic-timeline-header-title">
                <i class="bi bi-clock-history"></i>
                <b class="petic-timeline-titulo">{{ 'pasta_peticionar.lista.documentos'|trans }}</b>
                <span class="petic-contador" id="badgeCount">{{ documentos|length }}</span>
            </div>
            <div class="petic-search">
                <i class="bi bi-search petic-search-icon"></i>
                <input type="text"
                       id="timelinePesquisa"
                       class="petic-search-input"
                       placeholder="{{ 'pasta_peticionar.lista.pesquisar'|trans }}"
                       autocomplete="off">
            </div>
        </div>

        {# Configuração do peticionar-documentos.js (menu da linha, barra do selecionado, soltar
           arquivos): rotas que já existem, com os mesmos tokens que a aba Documentos usa. #}
        <div class="petic-timeline-list"
             id="timelineList"
             data-pode-editar="{{ podeEditarPasta ? '1' : '0' }}"
             data-url-reordenar="{{ path('pasta_documentos_reordenar', {id: pasta.id})|e('html_attr') }}"
             data-csrf-reordenar="{{ csrf_token('reordenar_docs_pasta_' ~ pasta.id)|e('html_attr') }}"
             data-url-excluir="{{ path('pasta_documentos_excluir_lote', {id: pasta.id})|e('html_attr') }}"
             {# Os tokens de escrita só vão para quem pode editar (e nunca na pasta excluída). #}
             {% if podeEditarPasta %}
             data-csrf-lote="{{ csrf_token('pex_lote_' ~ pasta.id)|e('html_attr') }}"
             data-csrf-upload="{{ csrf_token('peticionar_upload_' ~ pasta.id)|e('html_attr') }}"
             {% endif %}
             data-url-upload="{{ path('pasta_peticionar_upload', {id: pasta.id})|e('html_attr') }}"
             data-url-editar-tpl="{{ path('pasta_documento_edit', {id: '__ID__'})|e('html_attr') }}"
             data-categorias="{{ categoriaLabels|json_encode|e('html_attr') }}"
             data-classificaveis="{{ constant('App\\Pasta\\DTO\\ExploradorDeDocumentosOutput::CATEGORIAS')|keys|json_encode|e('html_attr') }}"
             data-cor-categoria="{{ categoriaCorMap|json_encode|e('html_attr') }}"
             data-icones="{{ iconesDoEnvio|json_encode|e('html_attr') }}">
            <div class="petic-tl-inner" id="tlInner">
                                {% for doc in documentos %}
                    {% set catLabel  = categoriaLabels[doc.categoria] ?? doc.categoria %}
                    {% set catCor    = categoriaCorMap[doc.categoria] ?? 'text-bg-secondary' %}
                    {% set ehTexto   = doc.mimeType == 'text/html' %}
                    {# O nome é o mesmo da aba Documentos (nome_original), que é o que o Renomear
                       grava; na peça de texto, sem o ".html" que o editor acrescenta. #}
                    {% set nomeExibido = (ehTexto and doc.nomeOriginal|lower ends with '.html') ? doc.nomeOriginal|slice(0, -5) : doc.nomeOriginal %}
                    {% set icone = ehTexto ? {icone: 'bi-file-earmark-text-fill', cor: '#0a6fa0'} : arquivo_icone(doc.nomeOriginal, doc.mimeType) %}
                    {% set bytes = doc.tamanhoBytes %}
                    {% set tamanhoTexto = bytes > 1048576 ? ((bytes / 1048576)|number_format(1, ',', '.') ~ ' MB') : (max(1, (bytes / 1024)|round) ~ ' KB') %}
                    <div class="petic-tl-row"
                         {% if podeEditarPasta %}draggable="true"{% endif %}
                         data-doc-id="{{ doc.id }}"
                         data-ordem="{{ doc.ordem }}"
                         data-view-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                         data-download-url="{{ path('pasta_documento_download', {id: doc.id}) }}"
                         data-mime-type="{{ doc.mimeType }}"
                         data-titulo="{{ nomeExibido|e('html_attr') }}"
                         data-categoria="{{ doc.categoria }}"
                         data-categoria-label="{{ (categoriaLabels[doc.categoria] ?? doc.categoria)|e('html_attr') }}"
                         data-tamanho="{{ bytes }}"
                         data-tamanho-texto="{{ tamanhoTexto|e('html_attr') }}"
                         data-carregado-em="{{ doc.carregadoEm|data_hora|e('html_attr') }}"
                         data-descricao="{{ (doc.descricao ?? '')|e('html_attr') }}"
                         data-numero="{{ (doc.numero ?? '')|e('html_attr') }}"
                         data-editar-documento-url="{{ path('pasta_documento_edit', {id: doc.id})|e('html_attr') }}"
                         {% if podeEditarPasta %}
                         data-csrf-documento="{{ csrf_token('edit_documento_' ~ doc.id)|e('html_attr') }}"
                         {% endif %}
                         {% if ehTexto %}
                         {% if podeEditarPasta %}
                         data-csrf-editar="{{ csrf_token('peticionar_editar_' ~ doc.id) }}"
                         {% endif %}
                         data-editar-url="{{ path('pasta_documento_editar_texto', {id: doc.id}) }}"
                         {% endif %}>
                        <div class="petic-tl-card">
                            <div class="petic-tl-card-top">
                                <span class="petic-tl-ord">{{ loop.index }}</span>
                                <i class="bi {{ icone.icone }} petic-tl-icon petic-doc-icone" style="color: {{ icone.cor }}" aria-hidden="true"></i>
                                <span class="petic-tl-titulo" title="{{ nomeExibido|e('html_attr') }}">{{ nomeExibido }}</span>
                            </div>
                            <div class="petic-tl-card-bottom">
                                <span class="badge {{ catCor }} petic-item-cat">{{ catLabel }}</span>
                                <span class="petic-doc-tamanho">{{ ehTexto ? 'pasta_peticionar.texto'|trans : tamanhoTexto }}</span>
                                <span class="petic-tl-time">{{ doc.carregadoEm|hora }}</span>
                            </div>
                            <button type="button" class="petic-doc-mais" title="{{ 'pasta_peticionar.lista.mais_opcoes'|trans }}" aria-label="{{ 'pasta_peticionar.lista.mais_opcoes'|trans }}" aria-haspopup="menu">
                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                {% else %}
                    <div class="petic-tl-vazio">
                        <i class="bi bi-folder2-open"></i>
                        {{ 'pasta_peticionar.lista.vazio'|trans }}
                        {% if podeEditarPasta %}
                        <span class="petic-tl-vazio-dica">{{ 'pasta_peticionar.lista.vazio_dica'|trans }}</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {# "Adicionar peça" (anexo ou texto) só para quem pode escrever na pasta: o leitor e a pasta
           excluída não o recebem, nem os tokens de envio do JS abaixo. #}
        {% if podeEditarPasta %}
        <div class="petic-timeline-footer">
            <button type="button"
                    class="petic-add-btn"
                    id="btnAbrirUpload"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="peticAddMenu">
                <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>{{ 'pasta_peticionar.adicionar_peca'|trans }}<i class="bi bi-caret-up-fill petic-add-seta" id="peticAddSeta" aria-hidden="true"></i>
            </button>
            <div class="petic-add-fundo" id="peticAddFundo" hidden></div>
            <div class="petic-add-menu" id="peticAddMenu" role="menu" hidden>
                <button type="button" class="petic-add-item" id="btnOpcaoAnexo" role="menuitem">
                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                    <span class="petic-add-rotulo">{{ 'pasta_peticionar.lista.anexo'|trans }}<span class="petic-add-sub">{{ 'pasta_peticionar.lista.anexo_dica'|trans }}</span></span>
                </button>
                <button type="button" class="petic-add-item" id="btnOpcaoTexto" role="menuitem">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    <span class="petic-add-rotulo">{{ 'pasta_peticionar.texto'|trans }}<span class="petic-add-sub">{{ 'pasta_peticionar.lista.texto_dica'|trans }}</span></span>
                </button>
            </div>
        </div>
        {% endif %}

    </div>

    {# ──────────────────────────────────────────────────────────
       PAINEL DIREITO — Preview
       ────────────────────────────────────────────────────────── #}
    <div class="petic-preview" id="previewPanel">

        {# Barra do documento selecionado (desenho 07, L77-85): ícone, nome (duplo clique renomeia),
           "tamanho · data" ("Texto · data" na peça de texto), Editar (só texto), Baixar e Excluir.
           Preenchida pelo peticionar-documentos.js, que a leva para o topo do editor quando a peça
           selecionada é de texto. #}
        <div class="petic-selbar" id="peticSelbar" hidden>
            <i class="bi petic-selbar-icone" aria-hidden="true"></i>
            <b class="petic-selbar-nome" title="{{ 'pasta_peticionar.barra.renomear_dica'|trans }}"></b>
            <span class="petic-selbar-sub"></span>
            {% if podeEditarPasta %}
            <button type="button" class="petic-selbar-editar" data-acao="editar" title="{{ 'pasta_peticionar.barra.editar_dica'|trans }}" hidden><i class="bi bi-pencil" aria-hidden="true"></i>{{ 'pasta_peticionar.barra.editar'|trans }}</button>
            {% endif %}
            <button type="button" class="petic-selbar-btn" data-acao="baixar" title="{{ 'pasta_peticionar.barra.baixar'|trans }}" aria-label="{{ 'pasta_peticionar.barra.baixar'|trans }}"><i class="bi bi-download" aria-hidden="true"></i></button>
            {% if podeEditarPasta %}
            <button type="button" class="petic-selbar-btn petic-selbar-btn--excluir" data-acao="excluir" title="{{ 'pasta_peticionar.barra.excluir'|trans }}" aria-label="{{ 'pasta_peticionar.barra.excluir'|trans }}"><i class="bi bi-trash3" aria-hidden="true"></i></button>
            {% endif %}
        </div>

        <div class="petic-preview-corpo">
            <div class="petic-preview-placeholder" id="previewPlaceholder">
                <i class="bi bi-file-earmark-text"></i>
                {{ 'pasta_peticionar.preview.selecione'|trans }}
            </div>

            <iframe id="previewIframe"
                    src=""
                    title="{{ 'pasta_peticionar.preview.visualizador'|trans }}"
                    allowfullscreen></iframe>

            <img id="previewImagem" src="" alt="">

            <div class="petic-download-panel" id="downloadPanel">
                <i class="bi bi-file-earmark"></i>
                <div class="petic-download-texto">{{ 'pasta_peticionar.preview.indisponivel'|trans }}</div>
                <a id="downloadLink" href="#" class="petic-download-btn" download>{{ 'pasta_peticionar.preview.baixar_arquivo'|trans }}</a>
            </div>
        </div>

    </div>

    {# ──────────────────────────────────────────────────────────
       PAINEL EDITOR DE TEXTO
       (grid-column: 2 coloca na mesma célula que o previewPanel)
       ────────────────────────────────────────────────────────── #}
    <div id="editorPanel" style="display:none; grid-column:2; grid-row:1; width:100%; height:100%; flex-direction:column; overflow:hidden;">
        <div id="editorToolbar" style="flex-shrink:0; padding:8px 12px; background:var(--bs-tertiary-bg); border-bottom:1px solid var(--bs-border-color); display:flex; align-items:center; position:relative; min-height:48px;">

            <button type="button" id="btnSalvarNaPasta" class="btn btn-primary btn-sm d-flex align-items-center gap-2" style="flex-shrink:0;">
                <span class="petic-spinner" id="editorSpinner"></span>
                <i class="bi bi-floppy2-fill" id="editorSaveIcon"></i>
                <span id="btnSalvarLabel">{{ 'pasta_peticionar.salvar_na_pasta'|trans }}</span>
            </button>

            <div id="editorInfo" style="position:absolute; left:50%; transform:translateX(-50%); text-align:center; max-width:55%; pointer-events:none;">
                <div style="pointer-events:auto; display:inline-flex; align-items:center; gap:4px;">
                    <span id="editorTituloDisplay"
                          style="font-size:0.875rem; font-weight:600; color:var(--bs-body-color); padding:2px 6px; border-radius:3px; border:1px solid transparent; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:380px; display:inline-block; cursor:default;"
                          title="">{{ 'pasta_peticionar.novo_documento'|trans }}</span>
                </div>
                <div style="margin-top:1px;">
                    <span id="editorCategoriaBadge" style="font-size:0.7rem; color:#888; letter-spacing:.02em;"></span>
                </div>
            </div>

        </div>
        <div style="flex:1; overflow:hidden;">
            <textarea id="editorConteudo"></textarea>
        </div>
    </div>

</div>

{# ────────────────────────────────────────────────────────────────
   MODAL SALVAR PEÇA DE TEXTO
   ──────────────────────────────────────────────────────────────── #}
<div class="petic-modal-overlay" id="modalSalvarTextoOverlay" role="dialog" aria-modal="true" aria-labelledby="modalSalvarTextoTitulo">
    <div class="petic-modal">

        <div class="petic-modal-title">
            <span id="modalSalvarTextoTitulo"><i class="bi bi-floppy2 me-2"></i> {{ 'pasta_peticionar.salvar_texto.titulo'|trans }}</span>
            <button type="button" class="btn-close" id="btnFecharModalSalvarTexto" aria-label="{{ 'pasta_peticionar.fechar'|trans }}"></button>
        </div>

        <form id="formSalvarTexto" novalidate>

            <div class="mb-3">
                <label for="textoTitulo" class="form-label fw-semibold">
                    {{ 'pasta_peticionar.salvar_texto.campo_titulo'|trans }} <span class="text-danger">*</span>
                </label>
                <input type="text"
                       class="form-control"
                       id="textoTitulo"
                       name="titulo"
                       maxlength="250"
                       placeholder="{{ 'pasta_peticionar.salvar_texto.exemplo'|trans }}"
                       required>
            </div>

            <div class="mb-3">
                <label for="textoCategoria" class="form-label fw-semibold">{{ 'pasta_peticionar.categoria'|trans }}</label>
                <select class="form-select" id="textoCategoria" name="categoria">
                    {% for valor, rotulo in categoriaLabels %}
                        <option value="{{ valor }}" {{ valor == 'PECA' ? 'selected' : '' }}>{{ rotulo }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-4">
                <label for="textoSecao" class="form-label fw-semibold">{{ 'pasta_peticionar.secao'|trans }}</label>
                <select class="form-select" id="textoSecao" name="secao_id">
                    <option value="">{{ 'pasta_peticionar.area_geral'|trans }}</option>
                    {% for secao in secoes %}
                        <option value="{{ secao.id }}">{{ caminhosSecoes[secao.id]|default(secao.nome) }}</option>
                    {% endfor %}
                </select>
            </div>

            <div id="textoErro" class="alert alert-danger py-2 d-none" role="alert"></div>

            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" id="btnCancelarSalvarTexto">{{ 'pasta_peticionar.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btnConfirmarSalvarTexto">
                    <span class="petic-spinner" id="textoSpinner"></span>
                    <i class="bi bi-floppy2-fill" id="textoSaveIcon"></i>
                    {{ 'pasta_peticionar.salvar'|trans }}
                </button>
            </div>

        </form>
    </div>
</div>

{# ────────────────────────────────────────────────────────────────
   MODAL UPLOAD
   ──────────────────────────────────────────────────────────────── #}
<div class="petic-modal-overlay" id="modalUploadOverlay" role="dialog" aria-modal="true" aria-labelledby="modalUploadTitulo">
    <div class="petic-modal">

        <div class="petic-modal-title">
            <span id="modalUploadTitulo"><i class="bi bi-file-earmark-plus me-2"></i> {{ 'pasta_peticionar.adicionar_peca'|trans }}</span>
            <button type="button" class="btn-close" id="btnFecharModal" aria-label="{{ 'pasta_peticionar.fechar'|trans }}"></button>
        </div>

        <form id="formUpload" novalidate>

            <div class="mb-3">
                <label for="uploadArquivo" class="form-label fw-semibold">
                    {{ 'pasta_peticionar.envio.arquivo'|trans }} <span class="text-danger">*</span>
                </label>
                <input type="file"
                       class="form-control"
                       id="uploadArquivo"
                       name="arquivo"
                       accept="{{ formatosDoEnvio|map(ext => '.' ~ ext)|join(',') }}"
                       required>
                <div class="form-text text-muted">{{ 'pasta_peticionar.envio.limites'|trans }}</div>
            </div>

            <div class="mb-3">
                <label for="uploadCategoria" class="form-label fw-semibold">{{ 'pasta_peticionar.categoria'|trans }}</label>
                <select class="form-select" id="uploadCategoria" name="categoria">
                    {% for valor, rotulo in categoriaLabels %}
                        <option value="{{ valor }}" {{ valor == 'PECA' ? 'selected' : '' }}>{{ rotulo }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label for="uploadDescricao" class="form-label fw-semibold">{{ 'pasta_peticionar.envio.descricao'|trans }} <span class="text-muted fw-normal">{{ 'pasta_peticionar.opcional'|trans }}</span></label>
                <textarea class="form-control" id="uploadDescricao" name="descricao" rows="2"
                          maxlength="500" placeholder="{{ 'pasta_peticionar.envio.descricao_exemplo'|trans }}"></textarea>
            </div>

            <div class="mb-3">
                <label for="uploadNumero" class="form-label fw-semibold">{{ 'pasta_peticionar.envio.numero'|trans }} <span class="text-muted fw-normal">{{ 'pasta_peticionar.opcional'|trans }}</span></label>
                <input type="text" class="form-control" id="uploadNumero" name="numero"
                       maxlength="100" placeholder="{{ 'pasta_peticionar.envio.numero_exemplo'|trans }}">
            </div>

            <div class="mb-4">
                <label for="uploadSecao" class="form-label fw-semibold">{{ 'pasta_peticionar.secao'|trans }}</label>
                <select class="form-select" id="uploadSecao" name="secao_id">
                    <option value="">{{ 'pasta_peticionar.area_geral'|trans }}</option>
                    {% for secao in secoes %}
                        <option value="{{ secao.id }}">{{ caminhosSecoes[secao.id]|default(secao.nome) }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" id="uploadReduzirTamanho" name="reduzir_tamanho" value="1">
                    <label class="form-check-label fw-semibold" for="uploadReduzirTamanho">
                        {{ 'pasta_peticionar.envio.reduzir'|trans }}
                    </label>
                </div>
                <div class="form-text text-muted">
                    {{ 'pasta_peticionar.envio.reduzir_dica'|trans }}
                    <span class="d-block text-warning-emphasis mt-1">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        {{ 'pasta_peticionar.envio.reduzir_assinatura'|trans }}
                    </span>
                </div>
            </div>

            <div id="uploadErro" class="alert alert-danger py-2 d-none" role="alert"></div>

            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" id="btnCancelarUpload">{{ 'pasta_peticionar.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btnEnviar">
                    <span class="petic-spinner" id="uploadSpinner"></span>
                    <i class="bi bi-upload" id="uploadIcon"></i>
                    {{ 'pasta_peticionar.envio.enviar'|trans }}
                </button>
            </div>

        </form>
    </div>
</div>

{# ────────────────────────────────────────────────────────────────
   MODAL CONFIRMAR DESCARTE DE ALTERAÇÕES
   ──────────────────────────────────────────────────────────────── #}
<div class="petic-modal-overlay" id="modalConfirmarDescarteOverlay" role="dialog" aria-modal="true" aria-labelledby="modalConfirmarDescarteTitulo">
    <div class="petic-modal" style="max-width:440px">

        <div class="petic-modal-title">
            <span id="modalConfirmarDescarteTitulo"><i class="bi bi-exclamation-triangle me-2 text-warning"></i> {{ 'pasta_peticionar.descarte.titulo'|trans }}</span>
        </div>

        <p class="mb-4 text-body-secondary">
            {{ 'pasta_peticionar.descarte.texto'|trans }}<br>
            {{ 'pasta_peticionar.descarte.pergunta'|trans }}
        </p>

        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" id="btnDescarteCancelar">{{ 'pasta_peticionar.cancelar'|trans }}</button>
            <button type="button" class="btn btn-outline-danger" id="btnDescarteNaoSalvar">{{ 'pasta_peticionar.descarte.nao_salvar'|trans }}</button>
            <button type="button" class="btn btn-primary" id="btnDescarteSalvar">
                <i class="bi bi-floppy2-fill me-1"></i> {{ 'pasta_peticionar.salvar'|trans }}
            </button>
        </div>

    </div>
</div>

{% endblock %}

{% block javascripts %}
{# Textos do script inline abaixo e do peticionar-documentos.js (o bj-traducao.js vem do layout_peticionar). #}
{{ catalogo_js('pasta_peticionar.js') }}
<script>
(function () {
    'use strict';

    const uploadUrl  = {{ path('pasta_peticionar_upload', {id: pasta.id})|json_encode|raw }};
    // Quem não pode escrever (leitor, pasta excluída) não recebe token nem abre o editor.
    const podeEditar = {{ podeEditarPasta ? 'true' : 'false' }};
    const csrfToken  = {{ (podeEditarPasta ? csrf_token('peticionar_upload_' ~ pasta.id) : '')|json_encode|raw }};

    // ── Elementos ────────────────────────────────────────────────────────────

    const placeholder   = document.getElementById('previewPlaceholder');
    const iframe        = document.getElementById('previewIframe');
    const imgPreview    = document.getElementById('previewImagem');
    const dlPanel       = document.getElementById('downloadPanel');
    const dlLink        = document.getElementById('downloadLink');
    const timelineList  = document.getElementById('timelineList');
    const tlInner       = document.getElementById('tlInner');

    const modalOverlay   = document.getElementById('modalUploadOverlay');
    const btnAbrirUpload = document.getElementById('btnAbrirUpload');
    const btnFechar      = document.getElementById('btnFecharModal');
    const btnCancelar    = document.getElementById('btnCancelarUpload');
    const formUpload     = document.getElementById('formUpload');
    const uploadErro     = document.getElementById('uploadErro');
    const uploadSpinner  = document.getElementById('uploadSpinner');
    const uploadIcon     = document.getElementById('uploadIcon');
    const btnEnviar      = document.getElementById('btnEnviar');

    // ── Timeline — selecionar documento ──────────────────────────────────────

    function ocultarTodosPaineis() {
        placeholder.style.display  = 'none';
        iframe.style.display       = 'none';
        iframe.src                 = '';
        imgPreview.style.display   = 'none';
        imgPreview.src             = '';
        dlPanel.style.display      = 'none';
    }

    const MIME_DOCX = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    const MIME_XLSX = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';

    function selecionarItem(item) {
        document.querySelectorAll('.petic-tl-row').forEach(el => el.classList.remove('ativo'));
        item.classList.add('ativo');

        const mime    = item.dataset.mimeType ?? '';
        const viewUrl = item.dataset.viewUrl;
        const dlUrl   = item.dataset.downloadUrl;
        const titulo  = item.dataset.titulo;

        // Texto HTML: delegar ao módulo do editor (definido abaixo). Quem não pode editar não
        // abre o editor: a peça é mostrada no visualizador, como o PDF (a rota de visualizar a
        // entrega sob a CSP de sandbox).
        if (mime === 'text/html' && podeEditar) {
            if (typeof abrirEditorParaEditar === 'function') abrirEditorParaEditar(item);
            return;
        }

        ocultarTodosPaineis();

        if (mime === 'application/pdf' || mime === 'text/html') {
            iframe.src           = viewUrl;
            iframe.style.display = 'block';
        } else if (mime === MIME_DOCX || mime === MIME_XLSX) {
            // F9: prévia só de leitura, convertida no servidor (a rota entrega sob CSP sem script).
            iframe.src           = viewUrl.replace('/visualizar', '/previa');
            iframe.style.display = 'block';
        } else if (mime === 'image/jpeg' || mime === 'image/png') {
            imgPreview.src           = viewUrl;
            imgPreview.alt           = titulo;
            imgPreview.style.display = 'block';
        } else {
            dlLink.href            = dlUrl;
            dlPanel.style.display  = 'flex';
        }
    }

    timelineList.addEventListener('click', function (e) {
        const item = e.target.closest('.petic-tl-row');
        if (item) selecionarItem(item);
    });

    // Seleciona o primeiro item automaticamente
    const primeiroItem = timelineList.querySelector('.petic-tl-row');
    if (primeiroItem) selecionarItem(primeiroItem);

    // ── Pesquisa na timeline ──────────────────────────────────────────────────

    document.getElementById('timelinePesquisa').addEventListener('input', function () {
        const termo   = this.value.trim().toLowerCase();
        const itens   = tlInner.querySelectorAll('.petic-tl-row');
        let visiveis = 0;
        itens.forEach(item => {
            const match = !termo || (item.dataset.titulo ?? '').toLowerCase().includes(termo);
            item.style.display = match ? '' : 'none';
            if (match) visiveis++;
        });

        const badge = document.getElementById('badgeCount');
        if (badge) badge.textContent = visiveis;
    });

    // ── Modal upload ──────────────────────────────────────────────────────────

    function abrirModal() {
        formUpload.reset();
        uploadErro.classList.add('d-none');
        modalOverlay.classList.add('aberto');
        document.getElementById('uploadArquivo').focus();
    }

    function fecharModal() {
        modalOverlay.classList.remove('aberto');
    }

    // Os botões só existem para quem pode editar (o "Adicionar peça" não vai ao leitor).
    const btnOpcaoAnexo = document.getElementById('btnOpcaoAnexo');
    if (btnOpcaoAnexo) btnOpcaoAnexo.addEventListener('click', abrirModal);

    // ── Botão Texto — delegar para módulo do editor (definido abaixo) ────────
    const btnOpcaoTexto = document.getElementById('btnOpcaoTexto');
    if (btnOpcaoTexto) btnOpcaoTexto.addEventListener('click', function () {
        if (typeof abrirEditor === 'function') abrirEditor();
    });
    btnFechar.addEventListener('click', fecharModal);
    btnCancelar.addEventListener('click', fecharModal);

    modalOverlay.addEventListener('click', function (e) {
        if (e.target === modalOverlay) fecharModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') fecharModal();
    });

    // ── Upload via fetch ──────────────────────────────────────────────────────

    // Rótulos e cores da categoria: no data-* da lista, lidos pelo peticionar-documentos.js.

    function setCarregando(sim) {
        btnEnviar.disabled      = sim;
        uploadSpinner.style.display = sim ? 'block' : 'none';
        uploadIcon.style.display    = sim ? 'none' : '';
    }

    function injetarItemTimeline(doc) {
        // A linha nova sai do peticionar-documentos.js (createElement, com o menu, o tamanho e o
        // ícone por tipo); sem ele, recarregar mostra o documento do jeito que o servidor monta.
        if (!window.PeticionarDocumentos) { window.location.reload(); return; }
        const item = window.PeticionarDocumentos.inserirLinha(doc);
        selecionarItem(item);
    }

    // Para o peticionar-documentos.js: selecionar uma linha e voltar ao "nenhum selecionado"
    // (depois de excluir o documento aberto).
    window.PeticionarTela = {
        selecionarItem: selecionarItem,
        limparSelecao: function () {
            document.querySelectorAll('.petic-tl-row').forEach(el => el.classList.remove('ativo'));
            ocultarTodosPaineis();
            placeholder.style.display = '';
        },
    };

    function escHtml(str) {
        const d = document.createElement('div');
        d.appendChild(document.createTextNode(str));
        return d.innerHTML;
    }

    function formatarBytes(bytes) {
        if (!bytes || bytes <= 0) return '0 B';
        const unidades = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(1024));
        return (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1) + ' ' + unidades[i];
    }

    function mostrarAvisoCompressao(c) {
        if (!c) return; // redução não foi solicitada

        let linhas;
        let cor;
        if (c.comprimido) {
            linhas = [BJ_T.t('pasta_peticionar.js.compressao_reduzido', { de: formatarBytes(c.tamanhoOriginal), para: formatarBytes(c.tamanhoFinal) })];
            if (c.eraAssinado) {
                linhas.push(BJ_T.t('pasta_peticionar.js.compressao_assinado'));
            }
            cor = c.eraAssinado ? 'alert-warning' : 'alert-success';
        } else {
            linhas = [BJ_T.t('pasta_peticionar.js.compressao_nao_reduziu')];
            cor = 'alert-info';
        }

        const aviso = document.createElement('div');
        aviso.className = `alert ${cor} shadow position-fixed bottom-0 end-0 m-3`;
        aviso.style.zIndex = '2000';
        aviso.style.maxWidth = '360px';
        aviso.setAttribute('role', 'alert');
        aviso.innerHTML = linhas.map(escHtml).join('<br>');
        document.body.appendChild(aviso);
        setTimeout(() => aviso.remove(), 6000);
    }

    formUpload.addEventListener('submit', async function (e) {
        e.preventDefault();

        const fileInput = document.getElementById('uploadArquivo');
        if (!fileInput.files.length) {
            uploadErro.textContent = BJ_T.t('pasta_peticionar.js.selecione_arquivo');
            uploadErro.classList.remove('d-none');
            return;
        }

        uploadErro.classList.add('d-none');
        setCarregando(true);

        const fd = new FormData(formUpload);
        fd.set('_token', csrfToken);

        try {
            // Com o X-Requested-With a recusa da pasta excluída vem em JSON ({mensagem}), não em 302.
            const resp = await fetch(uploadUrl, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await resp.json();

            if (!data.success) {
                uploadErro.textContent = data.mensagem || data.error || data.erro || BJ_T.t('pasta_peticionar.js.erro_enviar');
                uploadErro.classList.remove('d-none');
                return;
            }

            fecharModal();
            injetarItemTimeline(data.documento);
            mostrarAvisoCompressao(data.compressao);

        } catch (err) {
            uploadErro.textContent = BJ_T.t('pasta_peticionar.js.erro_comunicacao');
            uploadErro.classList.remove('d-none');
        } finally {
            setCarregando(false);
        }
    });

}());
</script>

<script>
(function () {
    'use strict';

    // ── URLs e tokens ─────────────────────────────────────────────────────────

    const criarTextoUrl      = {{ path('pasta_peticionar_texto', {id: pasta.id})|json_encode|raw }};
    const csrfTexto          = {{ (podeEditarPasta ? csrf_token('peticionar_texto_' ~ pasta.id) : '')|json_encode|raw }};
    const exportarUrlTemplate = '/pasta/documento/__ID__/exportar/__FMT__';

    // ── Estado do editor ──────────────────────────────────────────────────────

    let editorInicializado = false;
    let modoEdicao         = false;  // false = criar novo, true = editar existente
    let currentDocId       = null;
    let currentCsrfEditar  = null;
    let editarTextoUrl     = null;

    // ── Elementos DOM ─────────────────────────────────────────────────────────

    const previewPanel         = document.getElementById('previewPanel');
    const editorPanel          = document.getElementById('editorPanel');
    const editorSpinner        = document.getElementById('editorSpinner');
    const editorSaveIcon       = document.getElementById('editorSaveIcon');
    const btnSalvarNaPasta     = document.getElementById('btnSalvarNaPasta');
    const btnSalvarLabel       = document.getElementById('btnSalvarLabel');
    const editorTituloDisplay  = document.getElementById('editorTituloDisplay');
    const editorCategoriaBadge = document.getElementById('editorCategoriaBadge');

    const modalSalvarTextoOverlay       = document.getElementById('modalSalvarTextoOverlay');
    const formSalvarTexto               = document.getElementById('formSalvarTexto');
    const textoErro                     = document.getElementById('textoErro');
    const textoSpinner                  = document.getElementById('textoSpinner');
    const textoSaveIcon                 = document.getElementById('textoSaveIcon');
    const btnConfirmarSalvar            = document.getElementById('btnConfirmarSalvarTexto');
    const modalConfirmarDescarteOverlay = document.getElementById('modalConfirmarDescarteOverlay');

    // ── TinyMCE — inicialização única ─────────────────────────────────────────

    async function garantirEditorAberto() {
        previewPanel.style.display = 'none';
        editorPanel.style.display  = 'flex';

        if (!editorInicializado) {
            await tinymce.init({
                selector: '#editorConteudo',
                base_url: '/js/tinymce',
                suffix: '.min',
                promotion: false,
                branding: false,
                plugins: 'lists link image table pagebreak searchreplace wordcount anchor autosave insertdatetime charmap',
                toolbar: [
                    'undo redo | styles | fontfamily fontsize',
                    'bold italic underline strikethrough | forecolor backcolor',
                    'alignleft aligncenter alignright alignjustify',
                    'bullist numlist outdent indent | table | link image | pagebreak hr',
                ].join(' | '),
                toolbar_mode: 'wrap',
                menubar: 'file edit insert format',
                menu: {
                    file:   { title: BJ_T.t('pasta_peticionar.js.menu_arquivo'), items: 'novoDocumento | salvarNaPasta | exportarDocx exportarPdf exportarOdt exportarTxt' },
                    edit:   { title: BJ_T.t('pasta_peticionar.js.menu_editar'), items: 'undo redo | cut copy paste pastetext | selectall | searchreplace' },
                    insert: { title: BJ_T.t('pasta_peticionar.js.menu_inserir'), items: 'image link | table | hr pagebreak | charmap insertdatetime | anchor' },
                },
                language: 'pt_BR',
                browser_spellcheck: true,
                contextmenu: false,
                autosave_interval: '30s',
                autosave_restore_when_empty: true,
                autosave_prefix: 'bluejus-pasta-{{ pasta.id }}-',
                height: '100%',
                resize: false,
                statusbar: false,
                object_resizing: 'img',
                image_advtab: true,
                image_dimensions: true,
                images_upload_handler: async (blobInfo) => {
                    const formData = new FormData();
                    formData.append('imagem', blobInfo.blob(), blobInfo.filename());
                    formData.append('_token', {{ (podeEditarPasta ? csrf_token('upload_imagem_editor_' ~ pasta.id) : '')|json_encode|raw }});
                    const resp = await fetch({{ path('pasta_peticionar_upload_imagem', {id: pasta.id})|json_encode|raw }}, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    const data = await resp.json();
                    if (!resp.ok) throw new Error(data.mensagem || data.error || data.erro || BJ_T.t('pasta_peticionar.js.erro_imagem'));
                    return data.url;
                },
                content_style: [
                    'html { background: #c0c0c0; padding: 1.5cm 0; }',
                    'body { width: 21cm; min-height: 29.7cm; margin: 0 auto;',
                    '       padding: 3cm 2cm 2cm 3cm;',
                    '       box-sizing: border-box; background: white;',
                    '       box-shadow: 0 2px 12px rgba(0,0,0,.35);',
                    '       font-family: Arial, sans-serif; font-size: 12pt; line-height: 1.5; }',
                    'img { max-width: 100%; height: auto; }',
                    '.paginacao-sep { display: block !important; height: 2cm !important;',
                    '                margin: 0 -2cm 0 -3cm !important;',
                    '                width: calc(100% + 5cm) !important;',
                    '                background: #c0c0c0 !important;',
                    '                border: none !important;',
                    '                pointer-events: none !important; user-select: none !important;',
                    '                box-shadow: inset 0 6px 8px -4px rgba(0,0,0,0.2),',
                    '                            inset 0 -6px 8px -4px rgba(0,0,0,0.2) !important; }',
                ].join(' '),
                setup: function (editor) {
                    editor.on('GetContent', function (e) {
                        if (e.format !== 'html') return;
                        const tmp = document.createElement('div');
                        tmp.innerHTML = e.content;
                        tmp.querySelectorAll('.paginacao-sep').forEach(function (el) { el.remove(); });
                        e.content = tmp.innerHTML;
                    });

                    editor.ui.registry.addMenuItem('novoDocumento', {
                        text: BJ_T.t('pasta_peticionar.js.novo_documento'),
                        icon: 'new-document',
                        onAction: function () { abrirEditor(); },
                    });

                    editor.ui.registry.addMenuItem('salvarNaPasta', {
                        text: BJ_T.t('pasta_peticionar.js.salvar_na_pasta'),
                        icon: 'save',
                        onAction: function () {
                            if (modoEdicao) { salvarAlteracoes(); } else { abrirModalSalvar(); }
                        },
                    });

                    ['Docx', 'Pdf', 'Odt', 'Txt'].forEach(function (fmt) {
                        editor.ui.registry.addMenuItem('exportar' + fmt, {
                            text: BJ_T.t('pasta_peticionar.js.exportar_como', { formato: fmt.toUpperCase() }),
                            icon: 'export',
                            onAction: function () {
                                if (!currentDocId) {
                                    alert(BJ_T.t('pasta_peticionar.js.salve_antes_exportar'));
                                    return;
                                }
                                window.location.href = exportarUrlTemplate
                                    .replace('__ID__', currentDocId)
                                    .replace('__FMT__', fmt.toLowerCase());
                            },
                        });
                    });
                },
                init_instance_callback: function (editor) {
                    const PAGE_HEIGHT_PX = 29.7 * 96 / 2.54;

                    function repaginar() {
                        const body = editor.getBody();
                        const doc  = editor.getDoc();

                        body.querySelectorAll('.paginacao-sep').forEach(function (el) { el.remove(); });

                        const blocos = Array.from(body.children).filter(function (el) {
                            return !el.classList.contains('paginacao-sep');
                        });

                        // Passagem 1: ler todos os offsetTop ANTES de inserir qualquer separador
                        // (evita drift acumulativo causado pelo separador empurrar blocos seguintes)
                        const precisamSep = [];
                        let limitePx = PAGE_HEIGHT_PX;
                        blocos.forEach(function (bloco) {
                            if (bloco.offsetTop >= limitePx) {
                                precisamSep.push(bloco);
                                limitePx += PAGE_HEIGHT_PX;
                            }
                        });

                        // Passagem 2: inserir separadores após todas as leituras concluídas
                        precisamSep.forEach(function (bloco) {
                            const sep = doc.createElement('div');
                            sep.className = 'paginacao-sep';
                            sep.setAttribute('contenteditable', 'false');
                            bloco.before(sep);
                        });
                    }

                    let paginacaoTimer;
                    editor.on('input Change NodeChange', function () {
                        clearTimeout(paginacaoTimer);
                        paginacaoTimer = setTimeout(repaginar, 250);
                    });
                    setTimeout(repaginar, 100);
                },
            });
            editorInicializado = true;
        }
    }

    // ── Abrir em modo criação (novo documento) ────────────────────────────────

    async function executarAbrirNovoDocumento() {
        // Documento novo: nenhuma linha fica selecionada (a barra do selecionado some).
        document.querySelectorAll('.petic-tl-row.ativo').forEach(el => el.classList.remove('ativo'));
        modoEdicao        = false;
        currentDocId      = null;
        currentCsrfEditar = null;
        editarTextoUrl    = null;
        btnSalvarLabel.textContent = BJ_T.t('pasta_peticionar.js.salvar_na_pasta');

        editorTituloDisplay.textContent      = BJ_T.t('pasta_peticionar.js.novo_documento');
        editorTituloDisplay.contentEditable  = 'false';
        editorTituloDisplay.style.cursor     = 'default';
        editorTituloDisplay.style.borderColor     = 'transparent';
        editorTituloDisplay.style.backgroundColor = '';
        editorTituloDisplay.title = '';
        editorCategoriaBadge.textContent = '';

        await garantirEditorAberto();

        const editor = tinymce.get('editorConteudo');
        if (editor) {
            editor.setContent('');
            editor.setDirty(false);
        }
    }

    async function abrirEditor() {
        const editor = tinymce.get('editorConteudo');
        const dirty  = editor && editor.isDirty();

        if (editorInicializado && editorPanel.style.display !== 'none' && dirty) {
            abrirModalConfirmarDescarte();
            return;
        }

        await executarAbrirNovoDocumento();
    }

    // ── Abrir em modo edição (documento text/html existente) ──────────────────

    async function abrirEditorParaEditar(item) {
        const viewUrl        = item.dataset.viewUrl;
        const docId          = item.dataset.docId;
        const csrfEditar     = item.dataset.csrfEditar;
        const editarUrl      = item.dataset.editarUrl;
        const titulo         = item.dataset.titulo || '';
        const categoriaLabel = item.dataset.categoriaLabel || '';

        setSalvando(true);

        try {
            const resp = await fetch(viewUrl);
            if (!resp.ok) throw new Error('Falha ao carregar o documento');
            const html = await resp.text();

            await garantirEditorAberto();

            modoEdicao        = true;
            currentDocId      = parseInt(docId, 10);
            currentCsrfEditar = csrfEditar;
            editarTextoUrl    = editarUrl;
            btnSalvarLabel.textContent = BJ_T.t('pasta_peticionar.js.salvar_alteracoes');

            // Preencher título e categoria na toolbar
            editorTituloDisplay.textContent = titulo;
            editorTituloDisplay.style.cursor = 'pointer';
            editorTituloDisplay.title = BJ_T.t('pasta_peticionar.js.editar_titulo_dica');
            editorCategoriaBadge.textContent = categoriaLabel;

            const editor = tinymce.get('editorConteudo');
            if (editor) editor.setContent(html);

        } catch (e) {
            console.error(e);
            alert(BJ_T.t('pasta_peticionar.js.erro_abrir'));
            fecharEditor();
        } finally {
            setSalvando(false);
        }
    }

    // ── Fechar editor e resetar estado ────────────────────────────────────────

    function fecharEditor() {
        editorPanel.style.display  = 'none';
        previewPanel.style.display = '';

        modoEdicao        = false;
        currentDocId      = null;
        currentCsrfEditar = null;
        editarTextoUrl    = null;
        btnSalvarLabel.textContent = BJ_T.t('pasta_peticionar.js.salvar_na_pasta');

        // Resetar toolbar de título
        editorTituloDisplay.textContent   = BJ_T.t('pasta_peticionar.js.novo_documento');
        editorTituloDisplay.contentEditable = 'false';
        editorTituloDisplay.style.cursor  = 'default';
        editorTituloDisplay.style.borderColor = 'transparent';
        editorTituloDisplay.style.backgroundColor = '';
        editorTituloDisplay.title = '';
        editorCategoriaBadge.textContent  = '';

        const editor = tinymce.get('editorConteudo');
        if (editor) editor.setContent('');
    }

    // ── Modal salvar novo documento ───────────────────────────────────────────

    function abrirModalSalvar() {
        formSalvarTexto.reset();
        textoErro.classList.add('d-none');
        modalSalvarTextoOverlay.classList.add('aberto');
        document.getElementById('textoTitulo').focus();
    }

    function fecharModalSalvar() {
        modalSalvarTextoOverlay.classList.remove('aberto');
    }

    // ── Estado de carregamento ────────────────────────────────────────────────

    function setSalvando(sim) {
        btnConfirmarSalvar.disabled  = sim;
        btnSalvarNaPasta.disabled    = sim;
        textoSpinner.style.display   = sim ? 'block' : 'none';
        textoSaveIcon.style.display  = sim ? 'none'  : '';
        editorSpinner.style.display  = sim ? 'block' : 'none';
        editorSaveIcon.style.display = sim ? 'none'  : '';
    }

    // ── Salvar alterações (modo edição) ───────────────────────────────────────

    async function salvarAlteracoes(callback) {
        const editor   = tinymce.get('editorConteudo');
        const conteudo = editor ? editor.getContent() : '';
        const titulo   = editorTituloDisplay.textContent.trim();

        setSalvando(true);

        try {
            const resp = await fetch(editarTextoUrl, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ _token: currentCsrfEditar, conteudo, titulo }),
            });
            const data = await resp.json();

            if (!data.success) {
                alert(data.mensagem || data.error || data.erro || BJ_T.t('pasta_peticionar.js.erro_salvar'));
                return;
            }

            const ed = tinymce.get('editorConteudo');
            if (ed) ed.setDirty(false);

            if (typeof callback === 'function') {
                callback();
            } else {
                window.location.reload();
            }

        } catch (e) {
            alert(BJ_T.t('pasta_peticionar.js.erro_comunicacao'));
        } finally {
            setSalvando(false);
        }
    }

    // ── Handlers ──────────────────────────────────────────────────────────────

    btnSalvarNaPasta.addEventListener('click', function () {
        if (modoEdicao) { salvarAlteracoes(); } else { abrirModalSalvar(); }
    });

    // Edição inline do título (somente em modo edição)
    editorTituloDisplay.addEventListener('click', function () {
        if (!modoEdicao) return;
        this.contentEditable = 'true';
        this.style.borderColor = '#86b7fe';
        this.style.backgroundColor = '#fff';
        this.style.outline = 'none';
        this.focus();
        const range = document.createRange();
        range.selectNodeContents(this);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
    });

    editorTituloDisplay.addEventListener('blur', function () {
        this.contentEditable = 'false';
        this.style.borderColor = 'transparent';
        this.style.backgroundColor = '';
        if (this.textContent.trim() === '') this.textContent = BJ_T.t('pasta_peticionar.js.sem_titulo');
    });

    editorTituloDisplay.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); this.blur(); }
        if (e.key === 'Escape') { this.blur(); }
    });

    // ── Modal confirmar descarte ──────────────────────────────────────────────

    function abrirModalConfirmarDescarte() {
        modalConfirmarDescarteOverlay.classList.add('aberto');
    }

    function fecharModalConfirmarDescarte() {
        modalConfirmarDescarteOverlay.classList.remove('aberto');
    }

    document.getElementById('btnDescarteCancelar').addEventListener('click', fecharModalConfirmarDescarte);

    modalConfirmarDescarteOverlay.addEventListener('click', function (e) {
        if (e.target === modalConfirmarDescarteOverlay) fecharModalConfirmarDescarte();
    });

    document.getElementById('btnDescarteNaoSalvar').addEventListener('click', function () {
        fecharModalConfirmarDescarte();
        executarAbrirNovoDocumento();
    });

    document.getElementById('btnDescarteSalvar').addEventListener('click', function () {
        fecharModalConfirmarDescarte();
        if (modoEdicao) {
            salvarAlteracoes(executarAbrirNovoDocumento);
        } else {
            abrirModalSalvar();
        }
    });

    document.getElementById('btnFecharModalSalvarTexto').addEventListener('click', fecharModalSalvar);
    document.getElementById('btnCancelarSalvarTexto').addEventListener('click', fecharModalSalvar);

    modalSalvarTextoOverlay.addEventListener('click', function (e) {
        if (e.target === modalSalvarTextoOverlay) fecharModalSalvar();
    });

    // ── Salvar novo documento (modo criação) ──────────────────────────────────

    formSalvarTexto.addEventListener('submit', async function (e) {
        e.preventDefault();

        const titulo = document.getElementById('textoTitulo').value.trim();
        if (!titulo) {
            textoErro.textContent = BJ_T.t('pasta_peticionar.js.informe_titulo');
            textoErro.classList.remove('d-none');
            return;
        }

        const editor   = tinymce.get('editorConteudo');
        const conteudo = editor ? editor.getContent() : '';
        const categoria = document.getElementById('textoCategoria').value;

        textoErro.classList.add('d-none');
        setSalvando(true);

        const fd = new FormData();
        fd.append('_token',    csrfTexto);
        fd.append('titulo',    titulo);
        fd.append('categoria', categoria);
        fd.append('conteudo',  conteudo);
        const secaoEl = document.getElementById('textoSecao');
        fd.append('secao_id', secaoEl ? secaoEl.value : '');

        try {
            const resp = await fetch(criarTextoUrl, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await resp.json();

            if (!data.success) {
                textoErro.textContent = data.mensagem || data.error || data.erro || BJ_T.t('pasta_peticionar.js.erro_salvar');
                textoErro.classList.remove('d-none');
                return;
            }

            const ed = tinymce.get('editorConteudo');
            if (ed) ed.setDirty(false);
            window.location.reload();

        } catch (err) {
            textoErro.textContent = BJ_T.t('pasta_peticionar.js.erro_comunicacao');
            textoErro.classList.remove('d-none');
        } finally {
            setSalvando(false);
        }
    });

    // ── Exports globais ───────────────────────────────────────────────────────

    window.abrirEditor           = abrirEditor;
    window.abrirEditorParaEditar = abrirEditorParaEditar;
    window.fecharEditorPeticionar = fecharEditor;
}());
</script>

<script src="{{ asset('js/peticionar-documentos.js') }}"></script>
{% endblock %}
