{% extends 'layout_peticionar.html.twig' %}

{% set pastaInfoNup = pasta.nup %}
{% set pastaInfoCliente = nomeCliente %}

{% block title %}Peticionar — {{ pasta.nup }}{% endblock %}

{% block content %}

{% set categoriaCorMap = {
    'PECA':                    'text-bg-primary',
    'PROCURACAO':              'text-bg-success',
    'IDENTIFICACAO':           'text-bg-info',
    'COMPROVANTE_RESIDENCIA':  'text-bg-warning',
    'GRATUIDADE_JUSTICA':      'text-bg-secondary',
    'DEMAIS':                  'text-bg-secondary',
    'CONTRATO':                'text-bg-dark',
} %}

{% set categoriaPointMap = {
    'PECA':                    'petic-tl-dot--primary',
    'PROCURACAO':              'petic-tl-dot--success',
    'IDENTIFICACAO':           'petic-tl-dot--info',
    'COMPROVANTE_RESIDENCIA':  'petic-tl-dot--warning',
    'GRATUIDADE_JUSTICA':      'petic-tl-dot--secondary',
    'DEMAIS':                  'petic-tl-dot--secondary',
    'CONTRATO':                'petic-tl-dot--dark',
} %}

<div class="petic-layout">

    {# ──────────────────────────────────────────────────────────
       PAINEL ESQUERDO — Timeline
       ────────────────────────────────────────────────────────── #}
    <div class="petic-timeline">

        <div class="petic-timeline-header">
            <span class="petic-timeline-header-title">
                <i class="bi bi-clock-history text-primary"></i>
                Documentos
                <span class="badge text-bg-secondary rounded-pill" id="badgeCount">{{ documentos|length }}</span>
            </span>
            <div class="petic-search">
                <i class="bi bi-search petic-search-icon"></i>
                <input type="text"
                       id="timelinePesquisa"
                       class="petic-search-input"
                       placeholder="Pesquisar documentos…"
                       autocomplete="off">
            </div>
        </div>

        <div class="petic-timeline-list" id="timelineList">
            <div class="petic-tl-inner" id="tlInner">
                {% set lastDate = null %}
                {% for doc in documentos %}
                    {% set catLabel  = categoriaLabels[doc.categoria] ?? doc.categoria %}
                    {% set catCor    = categoriaCorMap[doc.categoria] ?? 'text-bg-secondary' %}
                    {% set dotClass  = categoriaPointMap[doc.categoria] ?? 'petic-tl-dot--secondary' %}
                    {% set docDate   = doc.carregadoEm|date('d/m/Y') %}
                    {% if docDate != lastDate %}
                        <div class="petic-tl-datesep" data-date="{{ docDate }}">
                            <span>{{ docDate }}</span>
                        </div>
                        {% set lastDate = docDate %}
                    {% endif %}
                    <div class="petic-tl-row"
                         data-doc-id="{{ doc.id }}"
                         data-view-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                         data-download-url="{{ path('pasta_documento_download', {id: doc.id}) }}"
                         data-mime-type="{{ doc.mimeType }}"
                         data-titulo="{{ doc.titulo|e('html_attr') }}"
                         data-categoria="{{ doc.categoria }}"
                         data-categoria-label="{{ (categoriaLabels[doc.categoria] ?? doc.categoria)|e('html_attr') }}"
                         {% if doc.mimeType == 'text/html' %}
                         data-csrf-editar="{{ csrf_token('peticionar_editar_' ~ doc.id) }}"
                         data-editar-url="{{ path('pasta_documento_editar_texto', {id: doc.id}) }}"
                         {% endif %}>
                        <div class="petic-tl-dot {{ dotClass }}"></div>
                        <div class="petic-tl-card">
                            <div class="petic-tl-card-top">
                                <i class="bi bi-file-earmark-text petic-tl-icon"></i>
                                <span class="petic-tl-titulo">{{ doc.titulo }}</span>
                            </div>
                            <div class="petic-tl-card-bottom">
                                <span class="badge {{ catCor }} petic-item-cat">{{ catLabel }}</span>
                                <span class="petic-tl-time">{{ doc.carregadoEm|date('H:i') }}</span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="petic-tl-vazio">
                        <i class="bi bi-folder2-open"></i>
                        Nenhum documento na pasta.
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="petic-timeline-footer">
            <div class="dropup w-100">
                <button type="button"
                        class="btn btn-primary w-100 dropdown-toggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        id="btnAbrirUpload">
                    <i class="bi bi-file-earmark-plus me-1"></i> Adicionar Peça
                </button>
                <ul class="dropdown-menu w-100">
                    <li>
                        <button type="button" class="dropdown-item" id="btnOpcaoAnexo">
                            <i class="bi bi-paperclip me-2"></i> Anexo
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" id="btnOpcaoTexto">
                            <i class="bi bi-file-text me-2"></i> Texto
                        </button>
                    </li>
                </ul>
            </div>
        </div>

    </div>

    {# ──────────────────────────────────────────────────────────
       PAINEL DIREITO — Preview
       ────────────────────────────────────────────────────────── #}
    <div class="petic-preview" id="previewPanel">

        <div class="petic-preview-placeholder" id="previewPlaceholder">
            <i class="bi bi-file-earmark-text"></i>
            <p>Selecione um documento na lista para visualizar</p>
        </div>

        <iframe id="previewIframe"
                src=""
                title="Visualizador de documento"
                allowfullscreen></iframe>

        <img id="previewImagem" src="" alt="" style="display:none; max-width:100%; max-height:100%; object-fit:contain;">

        <audio id="previewAudio" controls style="display:none; width:80%; max-width:520px;">
            <source id="previewAudioSrc" src="" type="">
        </audio>

        <video id="previewVideo" controls style="display:none; max-width:100%; max-height:100%;">
            <source id="previewVideoSrc" src="" type="">
        </video>

        <div class="petic-download-panel" id="downloadPanel">
            <i class="bi bi-file-earmark-arrow-down"></i>
            <p class="text-muted mb-3 fs-6" id="downloadFileName"></p>
            <a id="downloadLink" href="#" class="btn btn-outline-primary" download>
                <i class="bi bi-download me-1"></i> Baixar arquivo
            </a>
        </div>

    </div>

    {# ──────────────────────────────────────────────────────────
       PAINEL EDITOR DE TEXTO
       (grid-column: 2 coloca na mesma célula que o previewPanel)
       ────────────────────────────────────────────────────────── #}
    <div id="editorPanel" style="display:none; grid-column:2; grid-row:1; width:100%; height:100%; flex-direction:column; overflow:hidden;">
        <div id="editorToolbar" style="flex-shrink:0; padding:8px 12px; background:#f8f8f8; border-bottom:1px solid #ddd; display:flex; align-items:center; position:relative; min-height:48px;">

            <button type="button" id="btnSalvarNaPasta" class="btn btn-primary btn-sm d-flex align-items-center gap-2" style="flex-shrink:0;">
                <span class="petic-spinner" id="editorSpinner"></span>
                <i class="bi bi-floppy2-fill" id="editorSaveIcon"></i>
                <span id="btnSalvarLabel">Salvar na pasta</span>
            </button>

            <div id="editorInfo" style="position:absolute; left:50%; transform:translateX(-50%); text-align:center; max-width:55%; pointer-events:none;">
                <div style="pointer-events:auto; display:inline-flex; align-items:center; gap:4px;">
                    <span id="editorTituloDisplay"
                          style="font-size:0.875rem; font-weight:600; color:#333; padding:2px 6px; border-radius:3px; border:1px solid transparent; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:380px; display:inline-block; cursor:default;"
                          title="">Novo documento</span>
                </div>
                <div style="margin-top:1px;">
                    <span id="editorCategoriaBadge" style="font-size:0.7rem; color:#888; letter-spacing:.02em;"></span>
                </div>
            </div>

        </div>
        <div style="flex:1; overflow:hidden;">
            <textarea id="editorConteudo"></textarea>
        </div>
    </div>

</div>

{# ────────────────────────────────────────────────────────────────
   MODAL SALVAR PEÇA DE TEXTO
   ──────────────────────────────────────────────────────────────── #}
<div class="petic-modal-overlay" id="modalSalvarTextoOverlay" role="dialog" aria-modal="true" aria-labelledby="modalSalvarTextoTitulo">
    <div class="petic-modal">

        <div class="petic-modal-title">
            <span id="modalSalvarTextoTitulo"><i class="bi bi-floppy2 me-2"></i> Salvar peça na pasta</span>
            <button type="button" class="btn-close" id="btnFecharModalSalvarTexto" aria-label="Fechar"></button>
        </div>

        <form id="formSalvarTexto" novalidate>

            <div class="mb-3">
                <label for="textoTitulo" class="form-label fw-semibold">
                    Título <span class="text-danger">*</span>
                </label>
                <input type="text"
                       class="form-control"
                       id="textoTitulo"
                       name="titulo"
                       maxlength="255"
                       placeholder="Ex.: Petição Inicial, Recurso de Apelação…"
                       required>
            </div>

            <div class="mb-3">
                <label for="textoCategoria" class="form-label fw-semibold">Categoria</label>
                <select class="form-select" id="textoCategoria" name="categoria">
                    {% for valor, rotulo in categoriaLabels %}
                        <option value="{{ valor }}" {{ valor == 'PECA' ? 'selected' : '' }}>{{ rotulo }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-4">
                <label for="textoSecao" class="form-label fw-semibold">Seção</label>
                <select class="form-select" id="textoSecao" name="secao_id">
                    <option value="">(área geral)</option>
                    {% for secao in secoes %}
                        <option value="{{ secao.id }}">{{ secao.nome }}</option>
                    {% endfor %}
                </select>
            </div>

            <div id="textoErro" class="alert alert-danger py-2 d-none" role="alert"></div>

            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" id="btnCancelarSalvarTexto">Cancelar</button>
                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btnConfirmarSalvarTexto">
                    <span class="petic-spinner" id="textoSpinner"></span>
                    <i class="bi bi-floppy2-fill" id="textoSaveIcon"></i>
                    Salvar
                </button>
            </div>

        </form>
    </div>
</div>

{# ────────────────────────────────────────────────────────────────
   MODAL UPLOAD
   ──────────────────────────────────────────────────────────────── #}
<div class="petic-modal-overlay" id="modalUploadOverlay" role="dialog" aria-modal="true" aria-labelledby="modalUploadTitulo">
    <div class="petic-modal">

        <div class="petic-modal-title">
            <span id="modalUploadTitulo"><i class="bi bi-file-earmark-plus me-2"></i> Adicionar Peça</span>
            <button type="button" class="btn-close" id="btnFecharModal" aria-label="Fechar"></button>
        </div>

        <form id="formUpload" novalidate>

            <div class="mb-3">
                <label for="uploadArquivo" class="form-label fw-semibold">
                    Arquivo <span class="text-danger">*</span>
                </label>
                <input type="file"
                       class="form-control"
                       id="uploadArquivo"
                       name="arquivo"
                       accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.xml,.kml"
                       required>
                <div class="form-text text-muted">PDF até 10 MB · Imagens até 3 MB · DOC/XLS até 10 MB</div>
            </div>

            <div class="mb-3">
                <label for="uploadCategoria" class="form-label fw-semibold">Categoria</label>
                <select class="form-select" id="uploadCategoria" name="categoria">
                    {% for valor, rotulo in categoriaLabels %}
                        <option value="{{ valor }}" {{ valor == 'PECA' ? 'selected' : '' }}>{{ rotulo }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label for="uploadDescricao" class="form-label fw-semibold">Descrição <span class="text-muted fw-normal">(opcional)</span></label>
                <textarea class="form-control" id="uploadDescricao" name="descricao" rows="2"
                          maxlength="500" placeholder="Descreva brevemente o documento…"></textarea>
            </div>

            <div class="mb-3">
                <label for="uploadNumero" class="form-label fw-semibold">Número <span class="text-muted fw-normal">(opcional)</span></label>
                <input type="text" class="form-control" id="uploadNumero" name="numero"
                       maxlength="100" placeholder="Ex.: 001/2026">
            </div>

            <div class="mb-4">
                <label for="uploadSecao" class="form-label fw-semibold">Seção</label>
                <select class="form-select" id="uploadSecao" name="secao_id">
                    <option value="">(área geral)</option>
                    {% for secao in secoes %}
                        <option value="{{ secao.id }}">{{ secao.nome }}</option>
                    {% endfor %}
                </select>
            </div>

            <div id="uploadErro" class="alert alert-danger py-2 d-none" role="alert"></div>

            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" id="btnCancelarUpload">Cancelar</button>
                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btnEnviar">
                    <span class="petic-spinner" id="uploadSpinner"></span>
                    <i class="bi bi-upload" id="uploadIcon"></i>
                    Enviar
                </button>
            </div>

        </form>
    </div>
</div>

{# ────────────────────────────────────────────────────────────────
   MODAL CONFIRMAR DESCARTE DE ALTERAÇÕES
   ──────────────────────────────────────────────────────────────── #}
<div class="petic-modal-overlay" id="modalConfirmarDescarteOverlay" role="dialog" aria-modal="true" aria-labelledby="modalConfirmarDescarteTitulo">
    <div class="petic-modal" style="max-width:440px">

        <div class="petic-modal-title">
            <span id="modalConfirmarDescarteTitulo"><i class="bi bi-exclamation-triangle me-2 text-warning"></i> Salvar alterações?</span>
        </div>

        <p class="mb-4 text-body-secondary">
            O documento contém alterações não salvas.<br>
            Deseja salvar as alterações antes de continuar?
        </p>

        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" id="btnDescarteCancelar">Cancelar</button>
            <button type="button" class="btn btn-outline-danger" id="btnDescarteNaoSalvar">Não salvar</button>
            <button type="button" class="btn btn-primary" id="btnDescarteSalvar">
                <i class="bi bi-floppy2-fill me-1"></i> Salvar
            </button>
        </div>

    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
(function () {
    'use strict';

    const uploadUrl  = {{ path('pasta_peticionar_upload', {id: pasta.id})|json_encode|raw }};
    const csrfToken  = {{ csrf_token('peticionar_upload_' ~ pasta.id)|json_encode|raw }};

    // ── Elementos ────────────────────────────────────────────────────────────

    const placeholder   = document.getElementById('previewPlaceholder');
    const iframe        = document.getElementById('previewIframe');
    const imgPreview    = document.getElementById('previewImagem');
    const audioEl       = document.getElementById('previewAudio');
    const audioSrc      = document.getElementById('previewAudioSrc');
    const videoEl       = document.getElementById('previewVideo');
    const videoSrc      = document.getElementById('previewVideoSrc');
    const dlPanel       = document.getElementById('downloadPanel');
    const dlLink        = document.getElementById('downloadLink');
    const dlFileName    = document.getElementById('downloadFileName');
    const timelineList  = document.getElementById('timelineList');
    const tlInner       = document.getElementById('tlInner');

    const modalOverlay   = document.getElementById('modalUploadOverlay');
    const btnAbrirUpload = document.getElementById('btnAbrirUpload');
    const btnFechar      = document.getElementById('btnFecharModal');
    const btnCancelar    = document.getElementById('btnCancelarUpload');
    const formUpload     = document.getElementById('formUpload');
    const uploadErro     = document.getElementById('uploadErro');
    const uploadSpinner  = document.getElementById('uploadSpinner');
    const uploadIcon     = document.getElementById('uploadIcon');
    const btnEnviar      = document.getElementById('btnEnviar');

    // ── Timeline — selecionar documento ──────────────────────────────────────

    function ocultarTodosPaineis() {
        placeholder.style.display  = 'none';
        iframe.style.display       = 'none';
        iframe.src                 = '';
        imgPreview.style.display   = 'none';
        imgPreview.src             = '';
        audioEl.style.display      = 'none';
        audioEl.pause();
        audioSrc.src               = '';
        audioSrc.type              = '';
        videoEl.style.display      = 'none';
        videoEl.pause();
        videoSrc.src               = '';
        videoSrc.type              = '';
        dlPanel.style.display      = 'none';
    }

    function selecionarItem(item) {
        document.querySelectorAll('.petic-tl-row').forEach(el => el.classList.remove('ativo'));
        item.classList.add('ativo');

        const mime    = item.dataset.mimeType ?? '';
        const viewUrl = item.dataset.viewUrl;
        const dlUrl   = item.dataset.downloadUrl;
        const titulo  = item.dataset.titulo;

        // Texto HTML: delegar ao módulo do editor (definido abaixo)
        if (mime === 'text/html') {
            if (typeof abrirEditorParaEditar === 'function') abrirEditorParaEditar(item);
            return;
        }

        ocultarTodosPaineis();

        if (mime === 'application/pdf') {
            iframe.src           = viewUrl;
            iframe.style.display = 'block';
        } else if (mime === 'image/jpeg' || mime === 'image/png') {
            imgPreview.src           = viewUrl;
            imgPreview.alt           = titulo;
            imgPreview.style.display = 'block';
        } else if (mime.startsWith('audio/')) {
            audioSrc.src             = viewUrl;
            audioSrc.type            = mime;
            audioEl.load();
            audioEl.style.display    = 'block';
        } else if (mime.startsWith('video/')) {
            videoSrc.src             = viewUrl;
            videoSrc.type            = mime;
            videoEl.load();
            videoEl.style.display    = 'block';
        } else {
            dlFileName.textContent = titulo;
            dlLink.href            = dlUrl;
            dlPanel.style.display  = 'flex';
        }
    }

    timelineList.addEventListener('click', function (e) {
        const item = e.target.closest('.petic-tl-row');
        if (item) selecionarItem(item);
    });

    // Seleciona o primeiro item automaticamente
    const primeiroItem = timelineList.querySelector('.petic-tl-row');
    if (primeiroItem) selecionarItem(primeiroItem);

    // ── Pesquisa na timeline ──────────────────────────────────────────────────

    document.getElementById('timelinePesquisa').addEventListener('input', function () {
        const termo   = this.value.trim().toLowerCase();
        const itens   = tlInner.querySelectorAll('.petic-tl-row');
        const seps    = tlInner.querySelectorAll('.petic-tl-datesep');

        // Esconde todos os seps; reexibe só os que têm ao menos um item visível abaixo
        seps.forEach(s => s.style.display = 'none');

        let visiveis = 0;
        itens.forEach(item => {
            const match = !termo || (item.dataset.titulo ?? '').toLowerCase().includes(termo);
            item.style.display = match ? '' : 'none';
            if (match) visiveis++;
        });

        // Reexibe separador de data se houver pelo menos um item visível no grupo
        seps.forEach(sep => {
            let node = sep.nextElementSibling;
            while (node && !node.classList.contains('petic-tl-datesep')) {
                if (node.classList.contains('petic-tl-row') && node.style.display !== 'none') {
                    sep.style.display = '';
                    break;
                }
                node = node.nextElementSibling;
            }
        });

        const badge = document.getElementById('badgeCount');
        if (badge) badge.textContent = visiveis;
    });

    // ── Modal upload ──────────────────────────────────────────────────────────

    function abrirModal() {
        formUpload.reset();
        uploadErro.classList.add('d-none');
        modalOverlay.classList.add('aberto');
        document.getElementById('uploadArquivo').focus();
    }

    function fecharModal() {
        modalOverlay.classList.remove('aberto');
    }

    document.getElementById('btnOpcaoAnexo').addEventListener('click', abrirModal);

    // ── Botão Texto — delegar para módulo do editor (definido abaixo) ────────
    document.getElementById('btnOpcaoTexto').addEventListener('click', function () {
        if (typeof abrirEditor === 'function') abrirEditor();
    });
    btnFechar.addEventListener('click', fecharModal);
    btnCancelar.addEventListener('click', fecharModal);

    modalOverlay.addEventListener('click', function (e) {
        if (e.target === modalOverlay) fecharModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') fecharModal();
    });

    // ── Upload via fetch ──────────────────────────────────────────────────────

    const categoriaLabels = {{ categoriaLabels|json_encode|raw }};

    const categoriaCorMap = {
        'PECA':                   'text-bg-primary',
        'PROCURACAO':             'text-bg-success',
        'IDENTIFICACAO':          'text-bg-info',
        'COMPROVANTE_RESIDENCIA': 'text-bg-warning',
        'GRATUIDADE_JUSTICA':     'text-bg-secondary',
        'DEMAIS':                 'text-bg-secondary',
        'CONTRATO':               'text-bg-dark',
    };

    const categoriaPointMap = {
        'PECA':                   'petic-tl-dot--primary',
        'PROCURACAO':             'petic-tl-dot--success',
        'IDENTIFICACAO':          'petic-tl-dot--info',
        'COMPROVANTE_RESIDENCIA': 'petic-tl-dot--warning',
        'GRATUIDADE_JUSTICA':     'petic-tl-dot--secondary',
        'DEMAIS':                 'petic-tl-dot--secondary',
        'CONTRATO':               'petic-tl-dot--dark',
    };

    function setCarregando(sim) {
        btnEnviar.disabled      = sim;
        uploadSpinner.style.display = sim ? 'block' : 'none';
        uploadIcon.style.display    = sim ? 'none' : '';
    }

    function injetarItemTimeline(doc) {
        // Remove mensagem "nenhum documento" se existir
        const vazio = tlInner.querySelector('.petic-tl-vazio');
        if (vazio) vazio.remove();

        const catLabel   = categoriaLabels[doc.categoria] ?? doc.categoria;
        const catCor     = categoriaCorMap[doc.categoria] ?? 'text-bg-secondary';
        const dotClass   = categoriaPointMap[doc.categoria] ?? 'petic-tl-dot--secondary';

        // Separa data e hora do uploadedAt ("dd/mm/YYYY HH:ii")
        const partes   = doc.uploadedAt.split(' ');
        const dateKey  = partes[0];
        const timeStr  = partes[1] ?? '';

        // Adiciona separador de data se ainda não existir
        const sepExistente = tlInner.querySelector(`.petic-tl-datesep[data-date="${CSS.escape(dateKey)}"]`);
        if (!sepExistente) {
            const sep = document.createElement('div');
            sep.className    = 'petic-tl-datesep';
            sep.dataset.date = dateKey;
            sep.innerHTML    = `<span>${escHtml(dateKey)}</span>`;
            tlInner.appendChild(sep);
        }

        const item = document.createElement('div');
        item.className           = 'petic-tl-row';
        item.dataset.viewUrl     = doc.viewUrl;
        item.dataset.downloadUrl = doc.downloadUrl;
        item.dataset.mimeType    = doc.mimeType;
        item.dataset.titulo      = doc.titulo;
        item.innerHTML = `
            <div class="petic-tl-dot ${dotClass}"></div>
            <div class="petic-tl-card">
                <div class="petic-tl-card-top">
                    <i class="bi bi-file-earmark-text petic-tl-icon"></i>
                    <span class="petic-tl-titulo">${escHtml(doc.titulo)}</span>
                </div>
                <div class="petic-tl-card-bottom">
                    <span class="badge ${catCor} petic-item-cat">${escHtml(catLabel)}</span>
                    <span class="petic-tl-time">${escHtml(timeStr)}</span>
                </div>
            </div>
        `;
        tlInner.appendChild(item);

        // Atualiza badge de contagem
        const badge = document.getElementById('badgeCount');
        if (badge) badge.textContent = tlInner.querySelectorAll('.petic-tl-row').length;

        selecionarItem(item);
    }

    function escHtml(str) {
        const d = document.createElement('div');
        d.appendChild(document.createTextNode(str));
        return d.innerHTML;
    }

    formUpload.addEventListener('submit', async function (e) {
        e.preventDefault();

        const fileInput = document.getElementById('uploadArquivo');
        if (!fileInput.files.length) {
            uploadErro.textContent = 'Selecione um arquivo antes de enviar.';
            uploadErro.classList.remove('d-none');
            return;
        }

        uploadErro.classList.add('d-none');
        setCarregando(true);

        const fd = new FormData(formUpload);
        fd.set('_token', csrfToken);

        try {
            const resp = await fetch(uploadUrl, { method: 'POST', body: fd });
            const data = await resp.json();

            if (!data.success) {
                uploadErro.textContent = data.error ?? 'Erro ao enviar o arquivo.';
                uploadErro.classList.remove('d-none');
                return;
            }

            fecharModal();
            injetarItemTimeline(data.documento);

        } catch (err) {
            uploadErro.textContent = 'Erro de comunicação. Tente novamente.';
            uploadErro.classList.remove('d-none');
        } finally {
            setCarregando(false);
        }
    });

}());
</script>

<script>
(function () {
    'use strict';

    // ── URLs e tokens ─────────────────────────────────────────────────────────

    const criarTextoUrl      = {{ path('pasta_peticionar_texto', {id: pasta.id})|json_encode|raw }};
    const csrfTexto          = {{ csrf_token('peticionar_texto_' ~ pasta.id)|json_encode|raw }};
    const exportarUrlTemplate = '/pasta/documento/__ID__/exportar/__FMT__';

    // ── Estado do editor ──────────────────────────────────────────────────────

    let editorInicializado = false;
    let modoEdicao         = false;  // false = criar novo, true = editar existente
    let currentDocId       = null;
    let currentCsrfEditar  = null;
    let editarTextoUrl     = null;

    // ── Elementos DOM ─────────────────────────────────────────────────────────

    const previewPanel         = document.getElementById('previewPanel');
    const editorPanel          = document.getElementById('editorPanel');
    const editorSpinner        = document.getElementById('editorSpinner');
    const editorSaveIcon       = document.getElementById('editorSaveIcon');
    const btnSalvarNaPasta     = document.getElementById('btnSalvarNaPasta');
    const btnSalvarLabel       = document.getElementById('btnSalvarLabel');
    const editorTituloDisplay  = document.getElementById('editorTituloDisplay');
    const editorCategoriaBadge = document.getElementById('editorCategoriaBadge');

    const modalSalvarTextoOverlay       = document.getElementById('modalSalvarTextoOverlay');
    const formSalvarTexto               = document.getElementById('formSalvarTexto');
    const textoErro                     = document.getElementById('textoErro');
    const textoSpinner                  = document.getElementById('textoSpinner');
    const textoSaveIcon                 = document.getElementById('textoSaveIcon');
    const btnConfirmarSalvar            = document.getElementById('btnConfirmarSalvarTexto');
    const modalConfirmarDescarteOverlay = document.getElementById('modalConfirmarDescarteOverlay');

    // ── TinyMCE — inicialização única ─────────────────────────────────────────

    async function garantirEditorAberto() {
        previewPanel.style.display = 'none';
        editorPanel.style.display  = 'flex';

        if (!editorInicializado) {
            await tinymce.init({
                selector: '#editorConteudo',
                base_url: '/js/tinymce',
                suffix: '.min',
                promotion: false,
                branding: false,
                plugins: 'lists link image table pagebreak searchreplace wordcount anchor autosave insertdatetime charmap',
                toolbar: [
                    'undo redo | styles | fontfamily fontsize',
                    'bold italic underline strikethrough | forecolor backcolor',
                    'alignleft aligncenter alignright alignjustify',
                    'bullist numlist outdent indent | table | link image | pagebreak hr',
                ].join(' | '),
                toolbar_mode: 'wrap',
                menubar: 'file edit insert format',
                menu: {
                    file:   { title: 'Arquivo', items: 'novoDocumento | salvarNaPasta | exportarDocx exportarPdf exportarOdt exportarTxt' },
                    edit:   { title: 'Editar',  items: 'undo redo | cut copy paste pastetext | selectall | searchreplace' },
                    insert: { title: 'Inserir', items: 'image link | table | hr pagebreak | charmap insertdatetime | anchor' },
                },
                language: 'pt_BR',
                browser_spellcheck: true,
                contextmenu: false,
                autosave_interval: '30s',
                autosave_restore_when_empty: true,
                autosave_prefix: 'bluejus-pasta-{{ pasta.id }}-',
                height: '100%',
                resize: false,
                statusbar: false,
                object_resizing: 'img',
                image_advtab: true,
                image_dimensions: true,
                images_upload_handler: async (blobInfo) => {
                    const formData = new FormData();
                    formData.append('imagem', blobInfo.blob(), blobInfo.filename());
                    formData.append('_token', {{ csrf_token('upload_imagem_editor_' ~ pasta.id)|json_encode|raw }});
                    const resp = await fetch({{ path('pasta_peticionar_upload_imagem', {id: pasta.id})|json_encode|raw }}, {
                        method: 'POST',
                        body: formData,
                    });
                    const data = await resp.json();
                    if (!resp.ok) throw new Error(data.erro ?? 'Erro ao fazer upload da imagem.');
                    return data.url;
                },
                content_style: [
                    'html { background: #c0c0c0; padding: 1.5cm 0; }',
                    'body { width: 21cm; min-height: 29.7cm; margin: 0 auto;',
                    '       padding: 3cm 2cm 2cm 3cm;',
                    '       box-sizing: border-box; background: white;',
                    '       box-shadow: 0 2px 12px rgba(0,0,0,.35);',
                    '       font-family: Arial, sans-serif; font-size: 12pt; line-height: 1.5; }',
                    'img { max-width: 100%; height: auto; }',
                    '.paginacao-sep { display: block !important; height: 2cm !important;',
                    '                margin: 0 -2cm 0 -3cm !important;',
                    '                width: calc(100% + 5cm) !important;',
                    '                background: #c0c0c0 !important;',
                    '                border: none !important;',
                    '                pointer-events: none !important; user-select: none !important;',
                    '                box-shadow: inset 0 6px 8px -4px rgba(0,0,0,0.2),',
                    '                            inset 0 -6px 8px -4px rgba(0,0,0,0.2) !important; }',
                ].join(' '),
                setup: function (editor) {
                    editor.on('GetContent', function (e) {
                        if (e.format !== 'html') return;
                        const tmp = document.createElement('div');
                        tmp.innerHTML = e.content;
                        tmp.querySelectorAll('.paginacao-sep').forEach(function (el) { el.remove(); });
                        e.content = tmp.innerHTML;
                    });

                    editor.ui.registry.addMenuItem('novoDocumento', {
                        text: 'Novo documento',
                        icon: 'new-document',
                        onAction: function () { abrirEditor(); },
                    });

                    editor.ui.registry.addMenuItem('salvarNaPasta', {
                        text: 'Salvar na pasta',
                        icon: 'save',
                        onAction: function () {
                            if (modoEdicao) { salvarAlteracoes(); } else { abrirModalSalvar(); }
                        },
                    });

                    ['Docx', 'Pdf', 'Odt', 'Txt'].forEach(function (fmt) {
                        editor.ui.registry.addMenuItem('exportar' + fmt, {
                            text: 'Exportar como ' + fmt.toUpperCase(),
                            icon: 'export',
                            onAction: function () {
                                if (!currentDocId) {
                                    alert('Salve o documento primeiro para exportar.');
                                    return;
                                }
                                window.location.href = exportarUrlTemplate
                                    .replace('__ID__', currentDocId)
                                    .replace('__FMT__', fmt.toLowerCase());
                            },
                        });
                    });
                },
                init_instance_callback: function (editor) {
                    const PAGE_HEIGHT_PX = 29.7 * 96 / 2.54;

                    function repaginar() {
                        const body = editor.getBody();
                        const doc  = editor.getDoc();

                        body.querySelectorAll('.paginacao-sep').forEach(function (el) { el.remove(); });

                        const blocos = Array.from(body.children).filter(function (el) {
                            return !el.classList.contains('paginacao-sep');
                        });

                        // Passagem 1: ler todos os offsetTop ANTES de inserir qualquer separador
                        // (evita drift acumulativo causado pelo separador empurrar blocos seguintes)
                        const precisamSep = [];
                        let limitePx = PAGE_HEIGHT_PX;
                        blocos.forEach(function (bloco) {
                            if (bloco.offsetTop >= limitePx) {
                                precisamSep.push(bloco);
                                limitePx += PAGE_HEIGHT_PX;
                            }
                        });

                        // Passagem 2: inserir separadores após todas as leituras concluídas
                        precisamSep.forEach(function (bloco) {
                            const sep = doc.createElement('div');
                            sep.className = 'paginacao-sep';
                            sep.setAttribute('contenteditable', 'false');
                            bloco.before(sep);
                        });
                    }

                    let paginacaoTimer;
                    editor.on('input Change NodeChange', function () {
                        clearTimeout(paginacaoTimer);
                        paginacaoTimer = setTimeout(repaginar, 250);
                    });
                    setTimeout(repaginar, 100);
                },
            });
            editorInicializado = true;
        }
    }

    // ── Abrir em modo criação (novo documento) ────────────────────────────────

    async function executarAbrirNovoDocumento() {
        modoEdicao        = false;
        currentDocId      = null;
        currentCsrfEditar = null;
        editarTextoUrl    = null;
        btnSalvarLabel.textContent = 'Salvar na pasta';

        editorTituloDisplay.textContent      = 'Novo documento';
        editorTituloDisplay.contentEditable  = 'false';
        editorTituloDisplay.style.cursor     = 'default';
        editorTituloDisplay.style.borderColor     = 'transparent';
        editorTituloDisplay.style.backgroundColor = '';
        editorTituloDisplay.title = '';
        editorCategoriaBadge.textContent = '';

        await garantirEditorAberto();

        const editor = tinymce.get('editorConteudo');
        if (editor) {
            editor.setContent('');
            editor.setDirty(false);
        }
    }

    async function abrirEditor() {
        const editor = tinymce.get('editorConteudo');
        const dirty  = editor && editor.isDirty();

        if (editorInicializado && editorPanel.style.display !== 'none' && dirty) {
            abrirModalConfirmarDescarte();
            return;
        }

        await executarAbrirNovoDocumento();
    }

    // ── Abrir em modo edição (documento text/html existente) ──────────────────

    async function abrirEditorParaEditar(item) {
        const viewUrl        = item.dataset.viewUrl;
        const docId          = item.dataset.docId;
        const csrfEditar     = item.dataset.csrfEditar;
        const editarUrl      = item.dataset.editarUrl;
        const titulo         = item.dataset.titulo || '';
        const categoriaLabel = item.dataset.categoriaLabel || '';

        setSalvando(true);

        try {
            const resp = await fetch(viewUrl);
            if (!resp.ok) throw new Error('Falha ao carregar o documento');
            const html = await resp.text();

            await garantirEditorAberto();

            modoEdicao        = true;
            currentDocId      = parseInt(docId, 10);
            currentCsrfEditar = csrfEditar;
            editarTextoUrl    = editarUrl;
            btnSalvarLabel.textContent = 'Salvar alterações';

            // Preencher título e categoria na toolbar
            editorTituloDisplay.textContent = titulo;
            editorTituloDisplay.style.cursor = 'pointer';
            editorTituloDisplay.title = 'Clique para editar o título';
            editorCategoriaBadge.textContent = categoriaLabel;

            const editor = tinymce.get('editorConteudo');
            if (editor) editor.setContent(html);

        } catch (e) {
            console.error(e);
            alert('Erro ao abrir o documento para edição.');
            fecharEditor();
        } finally {
            setSalvando(false);
        }
    }

    // ── Fechar editor e resetar estado ────────────────────────────────────────

    function fecharEditor() {
        editorPanel.style.display  = 'none';
        previewPanel.style.display = '';

        modoEdicao        = false;
        currentDocId      = null;
        currentCsrfEditar = null;
        editarTextoUrl    = null;
        btnSalvarLabel.textContent = 'Salvar na pasta';

        // Resetar toolbar de título
        editorTituloDisplay.textContent   = 'Novo documento';
        editorTituloDisplay.contentEditable = 'false';
        editorTituloDisplay.style.cursor  = 'default';
        editorTituloDisplay.style.borderColor = 'transparent';
        editorTituloDisplay.style.backgroundColor = '';
        editorTituloDisplay.title = '';
        editorCategoriaBadge.textContent  = '';

        const editor = tinymce.get('editorConteudo');
        if (editor) editor.setContent('');
    }

    // ── Modal salvar novo documento ───────────────────────────────────────────

    function abrirModalSalvar() {
        formSalvarTexto.reset();
        textoErro.classList.add('d-none');
        modalSalvarTextoOverlay.classList.add('aberto');
        document.getElementById('textoTitulo').focus();
    }

    function fecharModalSalvar() {
        modalSalvarTextoOverlay.classList.remove('aberto');
    }

    // ── Estado de carregamento ────────────────────────────────────────────────

    function setSalvando(sim) {
        btnConfirmarSalvar.disabled  = sim;
        btnSalvarNaPasta.disabled    = sim;
        textoSpinner.style.display   = sim ? 'block' : 'none';
        textoSaveIcon.style.display  = sim ? 'none'  : '';
        editorSpinner.style.display  = sim ? 'block' : 'none';
        editorSaveIcon.style.display = sim ? 'none'  : '';
    }

    // ── Salvar alterações (modo edição) ───────────────────────────────────────

    async function salvarAlteracoes(callback) {
        const editor   = tinymce.get('editorConteudo');
        const conteudo = editor ? editor.getContent() : '';
        const titulo   = editorTituloDisplay.textContent.trim();

        setSalvando(true);

        try {
            const resp = await fetch(editarTextoUrl, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ _token: currentCsrfEditar, conteudo, titulo }),
            });
            const data = await resp.json();

            if (!data.success) {
                alert(data.error ?? 'Erro ao salvar.');
                return;
            }

            const ed = tinymce.get('editorConteudo');
            if (ed) ed.setDirty(false);

            if (typeof callback === 'function') {
                callback();
            } else {
                window.location.reload();
            }

        } catch (e) {
            alert('Erro de comunicação. Tente novamente.');
        } finally {
            setSalvando(false);
        }
    }

    // ── Handlers ──────────────────────────────────────────────────────────────

    btnSalvarNaPasta.addEventListener('click', function () {
        if (modoEdicao) { salvarAlteracoes(); } else { abrirModalSalvar(); }
    });

    // Edição inline do título (somente em modo edição)
    editorTituloDisplay.addEventListener('click', function () {
        if (!modoEdicao) return;
        this.contentEditable = 'true';
        this.style.borderColor = '#86b7fe';
        this.style.backgroundColor = '#fff';
        this.style.outline = 'none';
        this.focus();
        const range = document.createRange();
        range.selectNodeContents(this);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
    });

    editorTituloDisplay.addEventListener('blur', function () {
        this.contentEditable = 'false';
        this.style.borderColor = 'transparent';
        this.style.backgroundColor = '';
        if (this.textContent.trim() === '') this.textContent = 'Sem título';
    });

    editorTituloDisplay.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); this.blur(); }
        if (e.key === 'Escape') { this.blur(); }
    });

    // ── Modal confirmar descarte ──────────────────────────────────────────────

    function abrirModalConfirmarDescarte() {
        modalConfirmarDescarteOverlay.classList.add('aberto');
    }

    function fecharModalConfirmarDescarte() {
        modalConfirmarDescarteOverlay.classList.remove('aberto');
    }

    document.getElementById('btnDescarteCancelar').addEventListener('click', fecharModalConfirmarDescarte);

    modalConfirmarDescarteOverlay.addEventListener('click', function (e) {
        if (e.target === modalConfirmarDescarteOverlay) fecharModalConfirmarDescarte();
    });

    document.getElementById('btnDescarteNaoSalvar').addEventListener('click', function () {
        fecharModalConfirmarDescarte();
        executarAbrirNovoDocumento();
    });

    document.getElementById('btnDescarteSalvar').addEventListener('click', function () {
        fecharModalConfirmarDescarte();
        if (modoEdicao) {
            salvarAlteracoes(executarAbrirNovoDocumento);
        } else {
            abrirModalSalvar();
        }
    });

    document.getElementById('btnFecharModalSalvarTexto').addEventListener('click', fecharModalSalvar);
    document.getElementById('btnCancelarSalvarTexto').addEventListener('click', fecharModalSalvar);

    modalSalvarTextoOverlay.addEventListener('click', function (e) {
        if (e.target === modalSalvarTextoOverlay) fecharModalSalvar();
    });

    // ── Salvar novo documento (modo criação) ──────────────────────────────────

    formSalvarTexto.addEventListener('submit', async function (e) {
        e.preventDefault();

        const titulo = document.getElementById('textoTitulo').value.trim();
        if (!titulo) {
            textoErro.textContent = 'Informe um título para a peça.';
            textoErro.classList.remove('d-none');
            return;
        }

        const editor   = tinymce.get('editorConteudo');
        const conteudo = editor ? editor.getContent() : '';
        const categoria = document.getElementById('textoCategoria').value;

        textoErro.classList.add('d-none');
        setSalvando(true);

        const fd = new FormData();
        fd.append('_token',    csrfTexto);
        fd.append('titulo',    titulo);
        fd.append('categoria', categoria);
        fd.append('conteudo',  conteudo);
        const secaoEl = document.getElementById('textoSecao');
        fd.append('secao_id', secaoEl ? secaoEl.value : '');

        try {
            const resp = await fetch(criarTextoUrl, { method: 'POST', body: fd });
            const data = await resp.json();

            if (!data.success) {
                textoErro.textContent = data.error ?? 'Erro ao salvar.';
                textoErro.classList.remove('d-none');
                return;
            }

            const ed = tinymce.get('editorConteudo');
            if (ed) ed.setDirty(false);
            window.location.reload();

        } catch (err) {
            textoErro.textContent = 'Erro de comunicação. Tente novamente.';
            textoErro.classList.remove('d-none');
        } finally {
            setSalvando(false);
        }
    });

    // ── Exports globais ───────────────────────────────────────────────────────

    window.abrirEditor           = abrirEditor;
    window.abrirEditorParaEditar = abrirEditorParaEditar;
}());
</script>
{% endblock %}
