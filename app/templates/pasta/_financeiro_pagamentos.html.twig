{# ============================================================================
   Corpo do card Pagamentos — total, barra, próximos vencimentos.

   Fica num partial próprio porque é o bloco que o servidor RE-RENDERIZA inteiro
   depois de registrar, quitar ou excluir um pagamento, e o JS troca o innerHTML
   por ele. Remendar a linha que mudou e recalcular o total no navegador é como
   dois números da mesma tela começam a discordar: aqui os totais vêm sempre do
   servidor, do mesmo DTO que desenhou a primeira carga.

   As linhas JÁ PAGAS são renderizadas e escondidas por CSS, não omitidas: o
   "ver todos" do cabeçalho é só uma classe no cartão, sem ida ao servidor.

   Contexto: `pagamentos` (PastaPagamentosOutput).
   ============================================================================ #}
{% if pagamentos.total == 0 %}
    <div class="ps-vazio">
        <i class="bi bi-wallet2"></i>
        <div class="ps-vazio-titulo">Nenhum pagamento lançado</div>
        <div class="ps-vazio-nota">Registre o que o cliente combinou pagar por este caso.</div>
    </div>
{% else %}
    <div class="ps-pag-total">
        <div class="ps-pag-total-linha">
            <span class="ps-pag-recebido ps-num">{{ pagamentos.recebidoFormatado }}</span>
            <span class="ps-pag-previsto">recebidos de {{ pagamentos.previstoFormatado }}</span>
        </div>
        <div class="ps-pag-barra" role="progressbar"
             aria-valuenow="{{ pagamentos.percentual }}" aria-valuemin="0" aria-valuemax="100"
             aria-label="Percentual recebido">
            <div class="ps-pag-barra-cheia" style="width: {{ pagamentos.percentual }}%"></div>
        </div>
    </div>

    <div class="ps-pag-secao">
        <span class="ps-fin-rotulo">Próximos vencimentos</span>
        <span class="ps-cab-espaco"></span>
        {% if pagamentos.quantidadePagos > 0 %}
            <span class="ps-pag-nota">{{ pagamentos.quantidadePagos }} já pago{{ pagamentos.quantidadePagos == 1 ? '' : 's' }}</span>
        {% endif %}
    </div>

    {% if pagamentos.proximos is empty %}
        <div class="ps-pag-quitado">Tudo pago. Nada a vencer.</div>
    {% endif %}

    {% for linha in pagamentos.todos %}
        <div class="ps-pag-linha{{ linha.pago ? ' ps-pag-linha--pago' : '' }}" data-pagamento-id="{{ linha.id }}">
            <div class="ps-pag-corpo">
                <div class="ps-pag-descricao" title="{{ linha.descricao }}">{{ linha.descricao }}</div>
                <div class="ps-pag-quando ps-num">{{ linha.quando }}</div>
            </div>
            <div class="ps-pag-direita">
                <span class="ps-pag-valor ps-num">{{ linha.valorFormatado }}</span>
                {# O selo é o botão de quitar, como o do Contrato na faixa. #}
                <button type="button"
                        class="ps-selo ps-selo--{{ linha.tom }} ps-pag-selo"
                        data-acao="quitacao"
                        data-pagamento-id="{{ linha.id }}"
                        data-csrf="{{ csrf_token('pasta_pagamento_quitacao_' ~ linha.id) }}"
                        title="{{ linha.pago ? 'Pago — clique para desfazer o recebimento' : 'Clique para marcar como recebido' }}">{{ linha.estado }}</button>
            </div>
            {# Sem edição de linha no desenho: corrigir é excluir e lançar de novo. #}
            <button type="button"
                    class="ps-anotacao-acao ps-anotacao-acao--perigo ps-pag-excluir"
                    data-acao="excluir"
                    data-pagamento-id="{{ linha.id }}"
                    data-csrf="{{ csrf_token('pasta_pagamento_excluir_' ~ linha.id) }}"
                    title="Excluir lançamento">
                <i class="bi bi-trash3"></i>
            </button>
        </div>
    {% endfor %}
{% endif %}
