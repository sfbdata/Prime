{% extends 'base.html.twig' %}

{% block title %}{{ 'pasta_lista.index.titulo'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-folder2-open me-2"></i>{{ 'pasta_lista.index.titulo'|trans }}</h1>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNovaPasta">
            <i class="bi bi-plus-lg me-1"></i> {{ 'pasta_lista.index.nova'|trans }}
        </button>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {{ include('pasta/_tabela.html.twig', {
            formAction: path('pasta_index'),
            limparUrl: path('pasta_index')
        }) }}
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ include('_partials/modal_access_request.html.twig') }}
{{ include('_partials/modal_nova_pasta.html.twig') }}
{% endblock %}
