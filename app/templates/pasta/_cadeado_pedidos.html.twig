{# ============================================================================
   Pedidos de acesso pendentes, para quem configura o cadeado (spec pasta-cadeado K5).

   A CONFIRMAR PELO DONO: no desenho a decisão é na conversa com a BlueJus IA (`cadResolver`, bluejus-
   central.js), que não existe no sistema. Esta faixa é PROVISÓRIA e isolada para ser levada ao chat
   depois: parcial próprio, módulo JS próprio (pasta-cadeado-pedidos.js, que só chama
   `pasta_acesso_decidir`), e a decisão inteira no `DecidirPedidoDeAcessoUseCase` e no endpoint JSON
   (XHR). O aviso no sino traz a pessoa até aqui (`#cadeado-pedidos`). Sem JS, cada botão é um
   formulário comum que volta para a pasta.

   Contexto: `pasta`, `cad` (CadeadoNaTelaOutput).
   ============================================================================ #}
{% if cad and cad.podeConfigurar and cad.pedidosPendentes is not empty %}
<div id="cadeado-pedidos" data-cadeado-pedidos style="display:flex;flex-direction:column;gap:6px;margin:-12px 0 14px">
    {% for p in cad.pedidosPendentes %}
        <div class="js-cadeado-pedido" style="display:flex;align-items:center;flex-wrap:wrap;gap:9px;padding:8px 12px;border-radius:4px;background:#eef5fa;color:#0b5f86;font-size:12.5px;font-weight:600" role="status">
            <i class="bi bi-key"></i>
            <span style="flex:1;min-width:0">{{ p.nome }} pediu acesso à pasta para {{ p.nivel }} ({{ p.hora }}).{% if p.motivo %} Motivo: "{{ p.motivo }}"{% endif %}</span>
            {% for d in [
                {v: 'editar', l: 'Liberar para editar', st: 'background:#0a7aad;color:#fff'},
                {v: 'visualizar', l: 'Liberar só visualizar', st: 'background:#e3f0f8;color:#0b5f86'},
                {v: 'recusar', l: 'Recusar', st: 'background:transparent;color:#a3232b'},
            ] %}
                <form method="post" action="{{ path('pasta_acesso_decidir', {id: pasta.id, pedidoId: p.id}) }}" class="js-cadeado-decidir" style="display:contents">
                    <input type="hidden" name="_token" value="{{ csrf_token('pasta_cadeado_' ~ pasta.id) }}">
                    <input type="hidden" name="decisao" value="{{ d.v }}">
                    <button type="submit" style="flex-shrink:0;height:28px;padding:0 12px;border:none;border-radius:4px;{{ d.st }};font-family:inherit;font-size:12px;font-weight:700;cursor:pointer">{{ d.l }}</button>
                </form>
            {% endfor %}
        </div>
    {% endfor %}
</div>
{% endif %}
