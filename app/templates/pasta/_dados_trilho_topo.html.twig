{# ============================================================================
   Aba Dados — alto do trilho: Ação, Processo vinculado e Cobrança.
   Desenho 1.2.3 (L.1420-1445): Ação e Processo vinculado ficam como cartões no alto da coluna da direita, não no
   cabeçalho (regra do dono, 16/10). Cobrança é só do BlueJus (o desenho é omisso) e vem logo abaixo, como já
   vinha na faixa. Marcação e atalhos iguais aos da antiga faixa (abrir e copiar o número, trocar, os outros
   processos vinculados, vincular), para nada se perder na mudança.

   Contexto: `pasta`, `podeEditarPasta`, `unidadeCobrada`.
   ============================================================================ #}
{% set proc = pasta.processoPrincipal %}
{% set podeEditarPasta = podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit') %}
<section class="ps-card ps-trilho-dados" data-trilho="processo">
    <div class="ps-cab-dado" data-campo="acao">
        <p class="ps-rotulo"><i class="bi bi-bank2"></i>Ação</p>
        {%- if pasta.nomeAcao -%}
            <p class="ps-dado ps-dado--forte">{{ pasta.nomeAcao }}</p>
        {%- elseif proc and (proc.classeProcessual or proc.assuntoProcessual) -%}
            <p class="ps-dado ps-dado--forte" title="Extraído do processo vinculado">{{ proc.classeProcessual ?: proc.assuntoProcessual }}</p>
        {%- elseif proc -%}
            <p class="ps-dado ps-dado--vazio">Não informada</p>
        {%- else -%}
            {# Sem processo a ação não tem de onde vir — o desenho convida a vincular. #}
            <p class="ps-dado ps-dado--vazio ps-cab-acao-vazia">Vincule um processo para definir</p>
        {%- endif -%}
    </div>

    <div class="ps-cab-dado" data-campo="processo">
        <p class="ps-rotulo"><i class="bi bi-diagram-3"></i>Processo vinculado</p>
        {% if proc %}
            <p class="ps-dado ps-dado--forte ps-num">
                <a href="{{ path('processo_show', {id: proc.id}) }}" title="Abrir processo">{{ proc.numeroProcesso|numero_cnj }}</a>
                <i class="bi bi-copy copy-btn ps-copiar" role="button" data-copy="{{ proc.numeroProcesso }}" title="Copiar"></i>
            </p>
            {% if proc.classeProcessual or proc.siglaTribunal %}
                <div class="ps-dado-sub">
                    {{- proc.classeProcessual -}}
                    {%- if proc.classeProcessual and proc.siglaTribunal %} · {% endif -%}
                    {{- proc.siglaTribunal -}}
                </div>
            {% endif %}
            {# P4f (desenho N:1431-1455, `ap` N:7000): os apensados (todo vínculo que não é o principal),
               com pílula "N apensado(s)" e chevron; aberta, cada um com "Apensado · Tipo", o número (abre a
               aba Processo), a ação e "classe · tribunal · situação". #}
            {% set apensados = pasta.apensados %}
            <div class="ps-cab-proc-acoes">
                {# Sem o atalho com a aba Processo oculta para quem vê (ocultar aba). #}
                {% if 'processo' not in abasOcultas|default([]) %}
                <button type="button" class="ps-link-btn" data-ps-ir-aba="processo-tab" title="Ir à aba Processo">
                    <i class="bi bi-arrow-left-right"></i>trocar
                </button>
                {% endif %}
                {% if apensados|length > 0 %}
                    <button type="button" class="ps-chip-vinc ps-chip-vinc--apensados" data-ps-toggle="psProcessosVinculados"
                            aria-expanded="false" aria-controls="psProcessosVinculados"
                            title="Ver processos apensados"
                            data-dica-aberto="Recolher processos apensados" data-dica-fechado="Ver processos apensados">
                        <i class="bi bi-paperclip"></i>{{ apensados|length }} apensado{{ apensados|length > 1 ? 's' : '' }}<i class="bi bi-chevron-down"></i>
                    </button>
                {% endif %}
            </div>
            {% if apensados|length > 0 %}
                <div class="ps-cab-vinculados" id="psProcessosVinculados" hidden>
                    {% for pp in apensados %}
                        {% set outro = pp.processo %}
                        {% set subApenso = [outro.classeProcessual, outro.siglaTribunal]|filter(v => v) %}
                        <div class="ps-cab-vinculado ps-cab-apensado">
                            <div class="ps-rotulo ps-rotulo--mini"><i class="bi bi-link-45deg"></i>Apensado · {{ pp.tipoApensoRotulo }}</div>
                            <a class="ps-num ps-dado--forte" href="#processo" data-ps-ir-aba="processo-tab" title="Abrir processo apensado">{{ outro.numeroProcesso|numero_cnj }}</a>
                            {% if outro.assuntoProcessual %}
                                <div class="ps-cab-apensado-acao">{{ outro.assuntoProcessual }}</div>
                            {% endif %}
                            {% if subApenso is not empty or outro.situacaoProcesso %}
                                <div class="ps-dado-sub">
                                    {{- subApenso|join(' · ') -}}
                                    {%- if outro.situacaoProcesso %}{{ subApenso is not empty ? ' · ' : '' }}{{ outro.situacaoProcesso|situacao_processo }}{% endif -%}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            <p class="ps-dado ps-dado--vazio">Nenhum processo.
                {% if podeEditarPasta %}
                <button type="button" class="ps-link-btn ps-link-btn--vincular" data-bs-toggle="modal" data-bs-target="#modalVincularProcesso">vincular</button>
                {% endif %}
            </p>
        {% endif %}
    </div>

    {# Atalho para a UNIDADE cobrada — espelho do link "Pasta judicial" que a tela da unidade já
       oferece. O desenho é omisso sobre ele; o sistema já o tinha, então fica (convenção da casa).

       ⚠️ Some para quem não tem o módulo `cobrancas`: a tela de destino tem gate de módulo, e
       oferecer o link a quem seria recusado é pior que não oferecer. #}
    {% if unidadeCobrada|default(null) and can_access_module('cobrancas') %}
        <div class="ps-cab-dado" data-campo="cobranca">
            <p class="ps-rotulo"><i class="bi bi-cash-coin"></i>Cobrança</p>
            <p class="ps-dado ps-dado--forte ps-num">
                <a href="{{ path('cobranca_objeto_show', {id: unidadeCobrada.objetoId}) }}"
                   title="Abrir a unidade cobrada">{{ unidadeCobrada.identificacao }}</a>
            </p>
            {% if unidadeCobrada.credor %}
                <div class="ps-dado-sub">{{ unidadeCobrada.credor }}</div>
            {% endif %}
        </div>
    {% endif %}
</section>
