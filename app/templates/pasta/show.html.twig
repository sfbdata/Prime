{# ── Upload por arquivo com barra de progresso (compartilhado: drag-drop + seção) ── #}
<script>
    const URL_UPLOAD_PECA  = {{ path('pasta_peticionar_upload', {id: pasta.id})|json_encode|raw }};
    const CSRF_UPLOAD_PECA = {{ csrf_token('peticionar_upload_' ~ pasta.id)|json_encode|raw }};
    const PASTA_ID_UPLOAD  = {{ pasta.id|json_encode|raw }};

    function formatBytesPeca(b) {
        if (!b || b <= 0) return '0 B';
        if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
        return (b / 1024 / 1024).toFixed(2) + ' MB';
    }

    /* ── Aviso de arquivo duplicado (duplicadoDe[] no JSON do upload) ──
       Informativo, nunca bloqueia. O gerenciador recarrega a página ao terminar o lote, então
       o aviso é guardado em sessionStorage e renderizado de novo depois do reload (e apagado
       ao fechar ou ao ser mostrado uma segunda vez). */
    const CHAVE_DUPLICADOS = 'uploadDuplicados_' + PASTA_ID_UPLOAD;

    function lerDuplicadosPendentes() {
        try { return JSON.parse(sessionStorage.getItem(CHAVE_DUPLICADOS) || '[]') || []; } catch (_) { return []; }
    }

    function textoDoDuplicado(nomeEnviado, d, pastaAtualId) {
        return String(d.pastaId) === String(pastaAtualId)
            ? BJ_T.t('pasta_show.js.upload.duplicado_nesta', {nome: nomeEnviado, titulo: d.titulo})
            : BJ_T.t('pasta_show.js.upload.duplicado_na_pasta', {nome: nomeEnviado, titulo: d.titulo, nup: d.pastaNup});
    }

    function renderizarAvisoDeDuplicados() {
        const caixa = document.getElementById('uploadDuplicadosAviso');
        const lista = document.getElementById('uploadDuplicadosLista');
        if (!caixa || !lista) return;

        const itens = lerDuplicadosPendentes();
        if (itens.length === 0) { caixa.classList.add('d-none'); return; }

        const pastaAtual = PASTA_ID_UPLOAD;
        const urlTpl     = caixa.dataset.urlPastaTpl || '';
        lista.textContent = '';
        itens.forEach(function (it) {
            const li = document.createElement('li');
            li.textContent = textoDoDuplicado(it.nome, it, pastaAtual);
            if (String(it.pastaId) !== String(pastaAtual) && urlTpl) {
                const a = document.createElement('a');
                a.href = urlTpl.replace('__ID__', encodeURIComponent(it.pastaId));
                a.className = 'ms-1';
                a.textContent = BJ_T.t('pasta_show.js.upload.abrir_pasta', {nup: it.pastaNup});
                li.appendChild(a);
            }
            lista.appendChild(li);
        });
        caixa.classList.remove('d-none');
    }

    function registrarDuplicados(nomeEnviado, duplicadoDe) {
        if (!Array.isArray(duplicadoDe) || duplicadoDe.length === 0) return;
        const itens = lerDuplicadosPendentes();
        duplicadoDe.forEach(function (d) {
            itens.push({ nome: nomeEnviado, pastaId: d.pastaId, pastaNup: d.pastaNup, titulo: d.titulo });
        });
        try { sessionStorage.setItem(CHAVE_DUPLICADOS, JSON.stringify(itens.slice(-30))); } catch (_) {}
        renderizarAvisoDeDuplicados();
    }

    document.addEventListener('DOMContentLoaded', function () {
        renderizarAvisoDeDuplicados();
        // Mostrado uma vez depois do reload: o que ficou guardado já cumpriu o papel.
        const fechar = document.getElementById('uploadDuplicadosFechar');
        if (fechar) {
            fechar.addEventListener('click', function () {
                try { sessionStorage.removeItem(CHAVE_DUPLICADOS); } catch (_) {}
                const caixa = document.getElementById('uploadDuplicadosAviso');
                if (caixa) caixa.classList.add('d-none');
            });
        }
        if (lerDuplicadosPendentes().length > 0) {
            try { sessionStorage.removeItem(CHAVE_DUPLICADOS); } catch (_) {}
        }
    });

    // Envia 1 arquivo via XHR, reportando progresso de upload e fase de compressão.
    window.enviarArquivoComProgresso = function (file, opts) {
        return new Promise(function (resolve, reject) {
            const fd = new FormData();
            fd.append('arquivo', file);
            fd.append('_token', opts.csrf);
            fd.append('categoria', opts.categoria || '');
            fd.append('descricao', opts.descricao || '');
            fd.append('numero', opts.numero || '');
            if (opts.secaoId) fd.append('secao_id', opts.secaoId);
            fd.append('reduzir_tamanho', opts.reduzir ? '1' : '0');

            const xhr = new XMLHttpRequest();
            xhr.open('POST', opts.url);
            xhr.upload.addEventListener('progress', function (ev) {
                if (ev.lengthComputable && typeof opts.onProgress === 'function') {
                    opts.onProgress(Math.round((ev.loaded / ev.total) * 100));
                }
            });
            xhr.upload.addEventListener('load', function () {
                if (typeof opts.onComprimindo === 'function') opts.onComprimindo();
            });
            xhr.addEventListener('load', function () {
                let data = null;
                try { data = JSON.parse(xhr.responseText); } catch (_) {}
                if (xhr.status >= 200 && xhr.status < 300 && data && data.success) {
                    registrarDuplicados(file.name, data.duplicadoDe);
                    resolve(data);
                } else {
                    reject(new Error((data && data.error) ? data.error : BJ_T.t('pasta_show.js.upload.erro_enviar')));
                }
            });
            xhr.addEventListener('error', function () { reject(new Error(BJ_T.t('pasta_show.js.upload.erro_comunicacao'))); });
            xhr.send(fd);
        });
    };

    // Processa um item .anexo-item: lê os campos, mostra a barra e devolve true/false.
    window.processarItemUploadPeca = function (item, secaoId, reduzir) {
        const file      = item._file;
        const categoria = (item.querySelector('[name^="categorias"]') || {}).value || '';
        const descricao = (item.querySelector('[name^="descricoes"]') || {}).value || '';
        const numero    = (item.querySelector('[name^="numeros"]') || {}).value || '';

        const campos = item.querySelector('.anexo-campos');
        const btnRm  = item.querySelector('.btn-remover-anexo');
        const prog   = item.querySelector('.anexo-progresso');
        const bar    = prog.querySelector('.progress-bar');
        const status = prog.querySelector('.anexo-status');

        if (campos) campos.classList.add('d-none');
        if (btnRm)  btnRm.classList.add('d-none');
        prog.classList.remove('d-none');
        bar.className = 'progress-bar';
        bar.style.width = '0%';

        return window.enviarArquivoComProgresso(file, {
            url: URL_UPLOAD_PECA,
            csrf: CSRF_UPLOAD_PECA,
            categoria: categoria,
            descricao: descricao,
            numero: numero,
            secaoId: secaoId,
            reduzir: reduzir,
            onProgress: function (pct) {
                bar.style.width = pct + '%';
                status.textContent = BJ_T.t('pasta_show.js.upload.enviando', {pct: pct});
            },
            onComprimindo: function () {
                bar.style.width = '100%';
                status.textContent = reduzir ? BJ_T.t('pasta_show.js.upload.comprimindo') : BJ_T.t('pasta_show.js.upload.processando');
            }
        }).then(function (data) {
            const c = data.compressao;
            bar.style.width = '100%';
            if (c && c.comprimido) {
                bar.classList.add('bg-success');
                status.className = 'anexo-status text-success d-block mt-1';
                status.textContent = BJ_T.t('pasta_show.js.upload.reduzido', {de: formatBytesPeca(c.tamanhoOriginal), para: formatBytesPeca(c.tamanhoFinal)})
                    + (c.eraAssinado ? ' ' + BJ_T.t('pasta_show.js.upload.pdf_assinado') : '');
            } else if (reduzir) {
                bar.classList.add('bg-warning');
                status.className = 'anexo-status text-warning-emphasis d-block mt-1';
                status.textContent = BJ_T.t('pasta_show.js.upload.nao_reduziu');
            } else {
                bar.classList.add('bg-success');
                status.className = 'anexo-status text-success d-block mt-1';
                status.textContent = BJ_T.t('pasta_show.js.upload.enviado');
            }
            if (Array.isArray(data.duplicadoDe) && data.duplicadoDe.length > 0) {
                const dup = document.createElement('small');
                dup.className = 'd-block mt-1 text-warning-emphasis';
                dup.textContent = BJ_T.t('pasta_show.js.upload.ja_existe') + ' ' + data.duplicadoDe.map(function (d) {
                    return String(d.pastaId) === String(PASTA_ID_UPLOAD)
                        ? BJ_T.t('pasta_show.js.upload.identico_nesta', {titulo: d.titulo})
                        : BJ_T.t('pasta_show.js.upload.identico_pasta', {titulo: d.titulo, nup: d.pastaNup});
                }).join('; ') + '.';
                status.insertAdjacentElement('afterend', dup);
            }
            item.dataset.enviado = '1';
            return true;
        }).catch(function (err) {
            bar.style.width = '100%';
            bar.classList.add('bg-danger');
            status.className = 'anexo-status text-danger d-block mt-1';
            status.textContent = '✗ ' + err.message;
            return false;
        });
    };
</script>

<script src="{{ asset('js/visualizador-documento.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Preview de documento (public/js/visualizador-documento.js) ── */
    VisualizadorDocumento.ligarModal(document.getElementById('previewDocModal'));

    /* ── Tooltips ── */
    var tooltipEls = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });

    function attachCopyButtons() {
        document.querySelectorAll('.copy-btn').forEach(function (btn) {
            if (btn.dataset.copyAttached) {
                return;
            }

            btn.addEventListener('click', function () {
                const text = this.getAttribute('data-copy');
                navigator.clipboard.writeText(text).then(() => {
                    this.classList.replace('bi-copy', 'bi-check-lg');
                    this.classList.add('copied');
                    setTimeout(() => {
                        this.classList.replace('bi-check-lg', 'bi-copy');
                        this.classList.remove('copied');
                    }, 1500);
                });
            });

            btn.dataset.copyAttached = '1';
        });
    }

    // Exposta no escopo global para reuso por outros blocos <script> (ex.: render in-place do modal de processo).
    window.attachCopyButtons = attachCopyButtons;

    // Troca a lista de processos vinculados in-place (sem recarregar a página nem
    // sair da aba Processo). Usada por vincular/desvincular/tornar principal.
    window.mpSwapProcessos = function (html) {
        var content = document.getElementById('processoTabContent');
        if (content && typeof html === 'string') {
            content.innerHTML = html;
            attachCopyButtons();
        }
    };

    attachCopyButtons();


});

/* ── Timeline: envio AJAX de mensagem ──────────────────── */
(function () {
    const form        = document.getElementById('formTimelineMensagem');
    const textarea    = document.getElementById('timelineConteudo');
    const btnEnviar   = document.getElementById('btnEnviarMensagem');
    const erroDiv     = document.getElementById('timelineMensagemErro');
    const list        = document.getElementById('timelineList');
    const countBadge  = document.getElementById('timeline-count');
    const vazioMsg    = document.getElementById('timelineVazio');
    const urlEnviar   = '{{ path("pasta_enviar_mensagem", {id: pasta.id}) }}';
    const urlEditarTpl  = '{{ path("pasta_editar_mensagem", {id: pasta.id, msgId: 0})|replace({"/0/": "/__ID__/"}) }}';
    const urlExcluirTpl = '{{ path("pasta_excluir_mensagem", {id: pasta.id, msgId: 0})|replace({"/0/": "/__ID__/"}) }}';
    // Pedido na hora do uso: o script roda antes do bj-traducao.js (fim do corpo do base).
    function rotuloOrfa() { return BJ_T.t('pasta_show.js.registro.orfa'); }

    /* PAS-034: a janela e o aviso da tela (pasta-dialogos.js), no lugar do confirm/alert. */
    function avisarErroReg(msg) {
        if (window.avisarPs) { avisarPs(msg, 'erro'); } else { alert(msg); }
    }

    /* "Excluir o comentário de NOME?" com a data e o trecho (dc L.5906 `comExcluir`). */
    function confirmarExclusaoReg(cartao) {
        const autor = (cartao && cartao.querySelector('.ps-anotacao-autor') || {}).textContent || BJ_T.t('pasta_show.js.registro.colaborador');
        const data  = cartao ? cartao.querySelector('.ps-anotacao-data') : null;
        const corpo = cartao ? cartao.querySelector('.pasta-msg-conteudo .ql-editor') : null;
        const txt   = (corpo ? corpo.innerText : '').replace(/\s+/g, ' ').trim();
        const opcoes = {
            titulo: BJ_T.t('pasta_show.js.registro.excluir_titulo', {autor: autor.trim()}),
            texto: (data && data.title ? data.title + ' · ' : '')
                + BJ_T.t('pasta_show.js.registro.excluir_texto', {trecho: txt.slice(0, 140) + (txt.length > 140 ? '…' : '')}),
        };
        return window.confirmarPs ? confirmarPs(opcoes) : Promise.resolve(confirm(opcoes.titulo));
    }

    /* ── Responder (PAS-030; dc L.1316-1322 `respOn`, L.5958) ───────────────
       A caixa abre LOGO ABAIXO do cartão respondido (a raiz: responder a uma resposta
       liga à raiz, um nível só): faixa "Respondendo a NOME", o campo "Escreva a
       resposta…", Cancelar e Responder (apagado sem texto). Ctrl+Enter envia, Esc
       fecha. Uma caixa por vez. O envio é o MESMO `pasta_enviar_mensagem`, com o CSRF
       do compositor e `resposta_a` = id da raiz; a posse é conferida no servidor. O
       texto vira parágrafos escapados aqui — o servidor sanitiza de novo. */
    let caixaResp = null; // { el, raizId, campo }

    function fecharCaixaResposta() {
        if (!caixaResp) { return; }
        caixaResp.el.remove();
        caixaResp = null;
    }

    function paragrafosDe(texto) {
        return String(texto).split(/\r?\n/).map(function (linha) {
            const limpa = linha.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return '<p>' + (limpa.trim() === '' ? '<br>' : limpa) + '</p>';
        }).join('');
    }

    function abrirCaixaResposta(botao) {
        const raizId = String(botao.dataset.respostaA || '');
        const raiz   = document.getElementById('pasta-msg-' + raizId);
        if (!raiz) { return; }
        fecharCaixaResposta();

        const el = document.createElement('div');
        el.className = 'ps-resp-caixa';
        el.setAttribute('data-resp-caixa', raizId);

        const faixa = document.createElement('div');
        faixa.className = 'ps-resp-caixa-faixa';
        const icone = document.createElement('i');
        icone.className = 'bi bi-reply-fill';
        icone.setAttribute('aria-hidden', 'true');
        const para = document.createElement('span');
        para.textContent = BJ_T.t('pasta_show.js.registro.respondendo_a', {nome: botao.dataset.respostaNome || BJ_T.t('pasta_show.js.registro.autor_desconhecido')});
        faixa.appendChild(icone);
        faixa.appendChild(para);

        const campo = document.createElement('textarea');
        campo.className = 'ps-resp-caixa-campo';
        campo.rows = 2;
        campo.maxLength = 5000;
        campo.placeholder = BJ_T.t('pasta_show.js.registro.escreva_resposta');
        campo.setAttribute('aria-label', para.textContent);

        const erro = document.createElement('div');
        erro.className = 'ps-resp-caixa-erro';
        erro.hidden = true;

        const cancelar = document.createElement('button');
        cancelar.type = 'button';
        cancelar.className = 'ps-resp-caixa-cancelar';
        cancelar.textContent = BJ_T.t('pasta_show.js.cancelar');

        const enviar = document.createElement('button');
        enviar.type = 'button';
        enviar.className = 'ps-resp-caixa-enviar';
        enviar.disabled = true;
        const iEnviar = document.createElement('i');
        iEnviar.className = 'bi bi-send';
        iEnviar.setAttribute('aria-hidden', 'true');
        enviar.appendChild(iEnviar);
        enviar.appendChild(document.createTextNode(BJ_T.t('pasta_show.js.registro.responder')));

        const acoes = document.createElement('div');
        acoes.className = 'ps-resp-caixa-acoes';
        acoes.appendChild(cancelar);
        acoes.appendChild(enviar);

        el.appendChild(faixa);
        el.appendChild(campo);
        el.appendChild(erro);
        el.appendChild(acoes);
        raiz.after(el);
        caixaResp = { el: el, raizId: raizId, campo: campo };

        campo.addEventListener('input', function () { enviar.disabled = campo.value.trim() === ''; });
        campo.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); enviar.click(); }
            else if (e.key === 'Escape') { e.preventDefault(); fecharCaixaResposta(); botao.focus(); }
        });
        cancelar.addEventListener('click', function () { fecharCaixaResposta(); });
        enviar.addEventListener('click', async function () {
            const texto = campo.value.trim();
            const token = form ? form.querySelector('input[name="_token"]') : null;
            if (texto === '' || !token) { return; }
            enviar.disabled = true;
            erro.hidden = true;
            let html = paragrafosDe(texto);
            if (window.PastaMencoes) { html = PastaMencoes.paraEnvio(campo, html); }
            const fd = new FormData();
            fd.append('_token', token.value);
            fd.append('resposta_a', raizId);
            fd.append('conteudo', html);
            try {
                const resp = await fetch(urlEnviar, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await resp.json();
                if (!resp.ok) {
                    erro.textContent = data.erro ?? BJ_T.t('pasta_show.js.registro.erro_resposta');
                    erro.hidden = false;
                    enviar.disabled = false;
                    return;
                }
                fecharCaixaResposta();
                const conta = inserirMensagem(data);
                if (vazioMsg) { vazioMsg.remove(); }
                if (countBadge && conta) { countBadge.textContent = parseInt(countBadge.textContent || '0', 10) + 1; }
            } catch (_) {
                erro.textContent = BJ_T.t('pasta_show.js.erro_rede_tente');
                erro.hidden = false;
                enviar.disabled = false;
            }
        });

        /* PAS-031: responder a uma resposta já começa com "@PrimeiroNome " do autor dela, e ela
           vai como menção REAL: o mesmo registro de menções que o `PastaMencoes.ligar` guarda
           na textarea (`_mencoes`), que o `paraEnvio` transforma no token `@[Nome](user:ID)`. */
        const autorId = Number(botao.dataset.respostaAutorId || 0);
        const primeiro = String(botao.dataset.respostaAutorNome || '').trim().split(/\s+/)[0] || '';
        if (autorId > 0 && primeiro !== '') {
            campo.value = '@' + primeiro + ' ';
            campo._mencoes = [{ id: autorId, nome: primeiro }];
            enviar.disabled = false;
        }

        campo.focus();
        campo.setSelectionRange(campo.value.length, campo.value.length);
        el.scrollIntoView({ block: 'nearest' });
    }

    /* ── Menu do registro (PAS-025; dc L.5958 `regsLinha`) ─────────────────
       Botão direito no cartão — no ponto do clique — ou o ⋮ do cartão (teclado e
       toque) abrem o MESMO #psRegMenu, preenchido com o cartão. Cada item clica o
       botão que o cartão já tem: a ação, o CSRF e a URL são os de sempre. Editar e
       Excluir levam os minutos que restam ("· N min"); sem os botões ou com a
       janela vencida, ficam à vista e desabilitados, "· bloqueado" com cadeado e o
       motivo na dica (o `comPerm` do desenho, sem a frase do usuário primário, que
       aqui não tem a exceção — como o Financeiro). */
    const menuReg = document.getElementById('psRegMenu');
    let regAberto = null; // { cartao, gatilho }

    function fecharMenuReg(devolverFoco) {
        if (!regAberto) { return; }
        menuReg.hidden = true;
        if (regAberto.gatilho) {
            regAberto.gatilho.setAttribute('aria-expanded', 'false');
            if (devolverFoco) { regAberto.gatilho.focus(); }
        }
        regAberto = null;
    }

    function pintarItemReg(item, pode, rotulo, icone, motivo) {
        item.disabled = !pode;
        if (pode) { item.removeAttribute('aria-disabled'); item.removeAttribute('title'); } else { item.setAttribute('aria-disabled', 'true'); item.title = motivo; }
        item.querySelector('i').className = 'bi ' + icone;
        item.querySelector('span').textContent = rotulo;
    }

    /* Minutos que restam na janela, com a regra do servidor (`minutosRestantes`: teto,
       de 1 a 15); 0 = vencida. */
    function minutosRestantesReg(cartao) {
        const ate = Number(cartao.dataset.janelaAte || 0) * 1000;
        const ms  = ate - Date.now();
        if (!ate || ms <= 0) { return 0; }
        return Math.min({{ comentario_janela_minutos() }}, Math.max(1, Math.ceil(ms / 60000)));
    }

    function abrirMenuReg(cartao, gatilho, x, y) {
        if (!menuReg || !cartao) { return; }
        const porClique = typeof x === 'number';
        if (!porClique && regAberto && regAberto.cartao === cartao) { fecharMenuReg(false); return; }
        fecharMenuReg(false);
        document.dispatchEvent(new CustomEvent('ps:fechar-popovers'));

        const autorEl = cartao.querySelector('.ps-anotacao-autor');
        const dataEl  = cartao.querySelector('.ps-anotacao-data');
        menuReg.querySelector('.js-reg-menu-titulo').textContent =
            (autorEl ? autorEl.textContent.trim() : '') + (dataEl && dataEl.title ? ' · ' + dataEl.title : '');
        // "Destacar" e "Remover destaque" (dc L6305), só para quem edita: pasta-destaque.js.
        if (window.PastaDestaque) { window.PastaDestaque.pintarMenu(menuReg, cartao, 'dados'); }

        // PAS-025b: na pasta excluída o menu nasce sem Responder, Editar e Excluir.
        const responder = menuReg.querySelector('.js-reg-responder');
        if (responder) { responder.hidden = !cartao.querySelector('.btn-responder-msg-pasta'); }

        const resto = minutosRestantesReg(cartao);
        const temBotao = !!cartao.querySelector('.ps-anotacao-acoes .btn-editar-msg-pasta');
        const pelaRegra = temBotao && cartao.dataset.doAutor === '1' && resto > 0;
        // Edição sem prazo (spec edicao-sem-prazo §5): Master e primário (com a opção) seguem sem prazo, com o selo.
        const seloSemPrazo = temBotao && !pelaRegra ? (cartao.dataset.semPrazoRotulo || '') : '';
        const motivo = cartao.dataset.doAutor === '1' ? BJ_T.t('pasta_show.js.registro.motivo_prazo') : BJ_T.t('pasta_show.js.registro.motivo_autor');
        const editar  = menuReg.querySelector('.js-reg-editar');
        const excluir = menuReg.querySelector('.js-reg-excluir');
        if (window.SeloSemPrazo) { window.SeloSemPrazo.pintar(editar, seloSemPrazo); window.SeloSemPrazo.pintar(excluir, seloSemPrazo); }
        if (!editar || !excluir) {
            // lápide: sem itens de escrita para pintar
        } else if (pelaRegra) {
            pintarItemReg(editar, true, BJ_T.t('pasta_show.js.registro.menu_editar', {min: resto}), 'bi-pencil', '');
            pintarItemReg(excluir, true, BJ_T.t('pasta_show.js.registro.menu_excluir', {min: resto}), 'bi-trash3', '');
        } else if (seloSemPrazo) {
            pintarItemReg(editar, true, BJ_T.t('pasta_show.js.registro.menu_editar_sem_prazo'), 'bi-pencil', '');
            pintarItemReg(excluir, true, BJ_T.t('pasta_show.js.registro.menu_excluir_sem_prazo'), 'bi-trash3', '');
        } else {
            pintarItemReg(editar, false, BJ_T.t('pasta_show.js.registro.menu_editar_bloqueado'), 'bi-lock', motivo);
            pintarItemReg(excluir, false, BJ_T.t('pasta_show.js.registro.menu_excluir_bloqueado'), 'bi-lock', motivo);
        }

        menuReg.hidden = false;
        let left;
        let top;
        if (porClique) {
            left = x;
            top  = y;
            if (top + menuReg.offsetHeight > window.innerHeight - 8) { top = y - menuReg.offsetHeight; }
        } else {
            const r = gatilho.getBoundingClientRect();
            left = r.right - menuReg.offsetWidth;
            top  = r.bottom + 4;
            if (top + menuReg.offsetHeight > window.innerHeight - 8) { top = r.top - menuReg.offsetHeight - 4; }
        }
        menuReg.style.left = Math.max(8, Math.min(left, window.innerWidth - menuReg.offsetWidth - 8)) + 'px';
        menuReg.style.top  = Math.max(8, top) + 'px';

        const seta = gatilho || cartao.querySelector('.js-reg-menu');
        if (seta) { seta.setAttribute('aria-expanded', 'true'); }
        regAberto = { cartao: cartao, gatilho: seta };
        const primeiro = menuReg.querySelector('.ps-processo-menu-item:not([disabled]):not([hidden])');
        if (primeiro) { primeiro.focus(); }
    }

    function copiarTextoReg(item, cartao) {
        const corpo  = cartao.querySelector('.pasta-msg-conteudo .ql-editor');
        const texto  = corpo ? corpo.innerText.trim() : '';
        const rotulo = item.querySelector('span');
        const original = rotulo ? rotulo.textContent : '';
        function avisar(msg) {
            if (rotulo) { rotulo.textContent = msg; }
            setTimeout(function () {
                if (rotulo) { rotulo.textContent = original; }
                if (regAberto && regAberto.cartao === cartao) { fecharMenuReg(false); }
            }, 1200);
        }
        if (texto && navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(texto).then(
                function () { avisar(BJ_T.t('pasta_show.js.registro.copiado')); },
                function () { avisar(BJ_T.t('pasta_show.js.registro.nao_copiou')); }
            );
        } else {
            avisar(BJ_T.t('pasta_show.js.registro.nao_copiou'));
        }
    }

    if (menuReg && list) {
        // Botão direito no cartão. Links, botões, a caixa de edição e texto selecionado
        // seguem com o menu do navegador.
        list.addEventListener('contextmenu', function (e) {
            const alvo   = e.target;
            const cartao = alvo && alvo.closest ? alvo.closest('.ps-anotacao[id^="pasta-msg-"]') : null;
            if (!cartao) { return; }
            if (alvo.closest('a, button, input, textarea, select, [contenteditable="true"], .ps-anotacao-edicao')) { return; }
            const selecao = window.getSelection ? String(window.getSelection()) : '';
            if (selecao.trim() !== '') { return; }
            e.preventDefault();
            abrirMenuReg(cartao, null, e.clientX, e.clientY);
        });

        list.addEventListener('click', function (e) {
            const gatilho = e.target.closest('.js-reg-menu');
            if (!gatilho) { return; }
            abrirMenuReg(gatilho.closest('.ps-anotacao'), gatilho);
        });

        menuReg.addEventListener('click', function (e) {
            const item = e.target.closest('.ps-processo-menu-item');
            if (!item || item.disabled || !regAberto) { return; }
            const cartao = regAberto.cartao;
            if (item.classList.contains('js-reg-copiar')) { copiarTextoReg(item, cartao); return; }
            const seletor = item.classList.contains('js-reg-responder') ? '.btn-responder-msg-pasta'
                : item.classList.contains('js-reg-encaminhar') ? ':scope > .ps-anotacao-topo > .js-encaminhar'
                : item.classList.contains('js-reg-editar') ? '.ps-anotacao-acoes .btn-editar-msg-pasta'
                : item.classList.contains('js-reg-excluir') ? '.ps-anotacao-acoes .btn-excluir-msg-pasta'
                : null;
            fecharMenuReg(false);
            const alvo = seletor ? cartao.querySelector(seletor) : null;
            if (alvo) { alvo.click(); }
        });

        // Fora fecha (em captura); Esc fecha e devolve o foco; rolar/redimensionar fecha.
        document.addEventListener('click', function (e) {
            if (!regAberto) { return; }
            if (menuReg.contains(e.target) || (regAberto.gatilho && regAberto.gatilho.contains(e.target))) { return; }
            fecharMenuReg(false);
        }, true);
        document.addEventListener('keydown', function (e) {
            if (regAberto && e.key === 'Escape') { fecharMenuReg(true); }
        });
        window.addEventListener('resize', function () { fecharMenuReg(false); });
        window.addEventListener('scroll', function (e) {
            if (regAberto && !(e.target instanceof Node && menuReg.contains(e.target))) { fecharMenuReg(false); }
        }, true);
        document.addEventListener('ps:fechar-popovers', function () { fecharMenuReg(false); });
    }

    {# Editar/excluir mensagem (autor, dentro da janela de 15 min — `JanelaDeEdicaoDeComentario`) — delegado na lista #}
    if (list) {
        list.addEventListener('click', async function (e) {
            const btnResponder = e.target.closest('.btn-responder-msg-pasta');
            if (btnResponder) {
                abrirCaixaResposta(btnResponder);
                return;
            }

            const btnEditar = e.target.closest('.btn-editar-msg-pasta');
            if (btnEditar) {
                const msgId = btnEditar.dataset.msgId;
                const item  = document.getElementById('pasta-msg-' + msgId);
                if (!item) { return; }
                const conteudoDiv = item.querySelector('.pasta-msg-conteudo');
                if (!conteudoDiv || item.querySelector('.pasta-msg-edit-area')) { return; }

                /* @menção: o token `@[Nome](user:ID)` volta a "@Nome" no editor e fica lembrado
                   para virar token de novo ao salvar (pasta-mencoes.js). */
                const edicao = window.PastaMencoes
                    ? PastaMencoes.paraEdicao(btnEditar.dataset.conteudo)
                    : { html: btnEditar.dataset.conteudo, mencoes: [] };
                const conteudoAtual = edicao.html;

                /* PAS-032 (dc L.1314; bj-editor.js L.355-358): a edição acontece no próprio editor,
                   com o rodapé DENTRO da caixa — "Visível para a equipe" · espaço · Cancelar ·
                   Salvar —, a mesma moldura que Detalhes usa (`.ps-anotacao-edicao-rodape`). */
                const area = document.createElement('div');
                area.className = 'pasta-msg-edit-area ps-anotacao-texto ps-anotacao-edicao';

                const textareaEd = document.createElement('textarea');
                textareaEd.className = 'form-control form-control-sm';
                textareaEd.rows = 3;
                textareaEd.maxLength = 5000;
                textareaEd.value = conteudoAtual;
                textareaEd.dataset.editorRicoPendente = '1';

                const nota = document.createElement('span');
                nota.className = 'ps-compositor-nota';
                nota.textContent = BJ_T.t('pasta_show.js.registro.visivel_equipe');

                const espaco = document.createElement('span');
                espaco.className = 'ps-cab-espaco';

                const btnCancelar = document.createElement('button');
                btnCancelar.type = 'button';
                btnCancelar.className = 'ps-anotacao-edicao-cancelar';
                btnCancelar.textContent = BJ_T.t('pasta_show.js.cancelar');

                const btnSalvar = document.createElement('button');
                btnSalvar.type = 'button';
                btnSalvar.className = 'ps-btn ps-btn--primario';
                btnSalvar.textContent = BJ_T.t('pasta_show.js.salvar');

                const rodape = document.createElement('div');
                rodape.className = 'ps-anotacao-edicao-rodape';
                rodape.appendChild(nota);
                rodape.appendChild(espaco);
                rodape.appendChild(btnCancelar);
                rodape.appendChild(btnSalvar);

                // A moldura é a do compositor: o editor monta antes da textarea, dentro dela.
                const moldura = document.createElement('div');
                moldura.className = 'ps-compositor-caixa';
                moldura.appendChild(textareaEd);
                moldura.appendChild(rodape);
                area.appendChild(moldura);

                conteudoDiv.classList.add('d-none');
                conteudoDiv.after(area);

                // Transforma a textarea recem-criada em editor (o auto-init so pega o DOM inicial).
                if (window.EditorRico) {
                    const quillEd = EditorRico.montar(textareaEd);
                    // A lista do "@" é a do REGISTRO, dita aqui: sem isso o pasta-mencoes.js cairia no
                    // primeiro `[data-mencionaveis-url]` da página, que pode ser o do Financeiro.
                    textareaEd._mencoesUrl = '{{ path("pasta_mencionaveis", {id: pasta.id}) }}';
                    if (window.PastaMencoes) { PastaMencoes.ligar(textareaEd, edicao.mencoes); }
                    if (quillEd) { quillEd.focus(); } else { textareaEd.focus(); }
                } else {
                    textareaEd.focus();
                }

                btnCancelar.addEventListener('click', function () {
                    area.remove();
                    conteudoDiv.classList.remove('d-none');
                });

                btnSalvar.addEventListener('click', async function () {
                    // O editor esvazia a textarea quando nao ha texto real (`<p><br></p>` nao conta).
                    const vazio = window.EditorRico
                        ? EditorRico.estaVazio(textareaEd)
                        : textareaEd.value.trim() === '';
                    if (vazio) { avisarErroReg(BJ_T.t('pasta_show.js.registro.vazia')); return; }

                    btnSalvar.disabled = true;
                    const fd = new FormData();
                    fd.append('_token', btnEditar.dataset.csrf);
                    fd.append('conteudo', window.PastaMencoes ? PastaMencoes.paraEnvio(textareaEd, textareaEd.value) : textareaEd.value);

                    try {
                        const resp = await fetch(btnEditar.dataset.url, {
                            method: 'POST',
                            body: fd,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        });
                        const data = await resp.json();
                        if (resp.ok) {
                            // `conteudoHtml` vem SANITIZADO do servidor.
                            conteudoDiv.innerHTML = '<span class="editor-rico-conteudo"><span class="ql-editor">'
                                + (data.conteudoHtml ?? '') + '</span></span>';
                            btnEditar.dataset.conteudo = data.conteudo;
                            marcarEditado(item);
                            area.remove();
                            conteudoDiv.classList.remove('d-none');
                        } else {
                            avisarErroReg(data.erro ?? BJ_T.t('pasta_show.js.registro.erro_editar'));
                            btnSalvar.disabled = false;
                        }
                    } catch (_) {
                        avisarErroReg(BJ_T.t('pasta_show.js.erro_rede'));
                        btnSalvar.disabled = false;
                    }
                });

                return;
            }

            const btnExcluir = e.target.closest('.btn-excluir-msg-pasta');
            if (btnExcluir) {
                const msgId = btnExcluir.dataset.msgId;
                if (!(await confirmarExclusaoReg(document.getElementById('pasta-msg-' + msgId)))) { return; }

                const fd    = new FormData();
                fd.append('_token', btnExcluir.dataset.csrf);

                try {
                    const resp = await fetch(btnExcluir.dataset.url, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    if (resp.ok) {
                        const alvo = document.getElementById('pasta-msg-' + msgId);
                        /* A contagem é só das raízes (as respostas não contam, como no desenho).
                           Excluir a raiz: as respostas FICAM (o banco solta o vínculo) e passam a
                           contar e a dizer "Resposta a uma mensagem excluída" — como ao recarregar. */
                        let delta = 0;
                        if (alvo) {
                            const thread = alvo.parentElement && alvo.parentElement.classList.contains('ps-respostas')
                                ? alvo.parentElement : null;
                            const ehRespostaPendurada = thread && !thread.classList.contains('ps-respostas--orfa');
                            delta = ehRespostaPendurada ? 0 : -1;

                            const minhas = !thread ? list.querySelector('.ps-respostas[data-resposta-de="' + msgId + '"]') : null;
                            if (minhas) {
                                minhas.classList.add('ps-respostas--orfa');
                                minhas.removeAttribute('data-resposta-de');
                                minhas.querySelectorAll(':scope > .ps-anotacao--resposta > .ps-anotacao-resposta-rot > span').forEach(function (rot) {
                                    rot.textContent = rotuloOrfa();
                                });
                                /* Sem a raiz, responder a uma órfã liga a ela mesma (o servidor faz igual). */
                                minhas.querySelectorAll(':scope > .ps-anotacao').forEach(function (orfa) {
                                    const btn = orfa.querySelector('.btn-responder-msg-pasta');
                                    if (!btn) { return; }
                                    btn.dataset.respostaA    = orfa.id.replace('pasta-msg-', '');
                                    btn.dataset.respostaNome = (orfa.querySelector('.ps-anotacao-autor') || {}).textContent || '';
                                });
                                delta += minhas.querySelectorAll(':scope > .ps-anotacao').length;
                            }
                            if (caixaResp && caixaResp.raizId === String(msgId)) { fecharCaixaResposta(); }

                            /* A pílula do dia existe para o PRIMEIRO registro do dia: se ele era o
                               único, a pílula sai junto; sem registro nenhum, a lista volta ao
                               estado vazio (sem linha do tempo). */
                            const pilula  = alvo.previousElementSibling;
                            const seguinte = alvo.nextElementSibling;
                            alvo.remove();
                            if (thread && !thread.querySelector('.ps-anotacao')) { thread.remove(); }
                            if (!thread && pilula && pilula.classList.contains('ps-dia') && (!seguinte || seguinte.classList.contains('ps-dia'))) {
                                pilula.remove();
                            }
                            const lista = document.getElementById('timelineList');
                            if (lista && !lista.querySelector('.ps-anotacao')) { lista.classList.add('ps-registro--vazio'); }
                        }
                        if (countBadge && delta !== 0) {
                            countBadge.textContent = Math.max(0, parseInt(countBadge.textContent || '0', 10) + delta);
                        }
                    } else {
                        const data = await resp.json();
                        avisarErroReg(data.erro ?? BJ_T.t('pasta_show.js.registro.erro_excluir'));
                    }
                } catch (_) {
                    avisarErroReg(BJ_T.t('pasta_show.js.erro_rede'));
                }
            }
        });
    }

    function marcarEditado(item) {
        if (item.querySelector('.pasta-msg-editado')) { return; }
        /* Logo depois do autor, como no desenho — e como o Twig monta ao abrir a tela. */
        const autor = item.querySelector('.ps-anotacao-autor');
        const topo  = item.querySelector('.ps-anotacao-topo');
        if (!topo) { return; }
        const marca = document.createElement('span');
        marca.className = 'ps-anotacao-editado pasta-msg-editado';
        marca.textContent = BJ_T.t('pasta_show.js.registro.editado');
        /* PAS-033: a mesma dica do Twig — a hora de publicação sai do title da hora do cartão
           ("dd/mm/aaaa HH:MM"); a edição é agora. */
        const publicado = ((item.querySelector('.ps-anotacao-data') || {}).title || '').slice(-5);
        const agora = new Date();
        marca.title = (publicado ? BJ_T.t('pasta_show.js.registro.publicado_as', {hora: publicado}) + ' · ' : '')
            + BJ_T.t('pasta_show.js.registro.ultima_edicao', {data: BJFormato.data(agora), hora: BJFormato.hora(agora)});
        if (autor && autor.nextSibling) { topo.insertBefore(marca, autor.nextSibling); } else { topo.appendChild(marca); }
    }

    if (!form) { return; }

    textarea.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            form.requestSubmit();
        }
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const conteudo = textarea.value.trim();
        if (conteudo === '') {
            mostrarErro(BJ_T.t('pasta_show.js.registro.vazia'));
            return;
        }

        btnEnviar.disabled = true;
        btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> ' + esc(BJ_T.t('pasta_show.js.registro.enviando'));
        if (window.EditorRico) { EditorRico.marcarEnvio(textarea, true); }
        esconderErro();

        try {
            const fdEnvio = new FormData(form);
            // @menção: cada "@Nome" escolhido na lista vai como token `@[Nome](user:ID)`.
            if (window.PastaMencoes) { fdEnvio.set('conteudo', PastaMencoes.paraEnvio(textarea, conteudo)); }
            const resp = await fetch(urlEnviar, {
                method: 'POST',
                body: fdEnvio,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });

            const data = await resp.json();

            if (!resp.ok) {
                mostrarErro(data.erro ?? BJ_T.t('pasta_show.js.registro.erro_enviar'));
                return;
            }

            const contaComoRegistro = inserirMensagem(data);
            // Limpa o editor (fonte da textarea); sem isso o texto enviado ficaria na tela.
            if (window.EditorRico) { EditorRico.limpar(textarea); } else { textarea.value = ''; }
            if (window.PastaMencoes) { PastaMencoes.esquecer(textarea); }
            if (vazioMsg) { vazioMsg.remove(); }
            // Resposta pendurada numa raiz não conta (desenho: a contagem é dos registros principais).
            if (countBadge && contaComoRegistro) {
                countBadge.textContent = parseInt(countBadge.textContent || '0', 10) + 1;
            }
        } catch (_) {
            mostrarErro(BJ_T.t('pasta_show.js.erro_rede_tente'));
        } finally {
            // O rótulo volta ao do desenho e ao de antes do envio: só o texto "Enviar" (EDT-022).
            btnEnviar.textContent = BJ_T.t('pasta_show.js.registro.enviar');
            // O editor decide: depois de enviar ele está vazio, e vazio o Enviar fica apagado (EDT-021).
            if (window.EditorRico) { EditorRico.marcarEnvio(textarea, false); } else { btnEnviar.disabled = false; }
        }
    });

    function inserirMensagem(data) {
        const dt       = new Date(data.criadaEmTs);
        const dataHora = dt.toLocaleDateString('pt-BR')
            + ' ' + dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const hora     = dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        // `conteudoHtml` vem SANITIZADO do servidor: entra como HTML (e o que mostra a formatacao).
        const corpo = '<span class="editor-rico-conteudo"><span class="ql-editor">'
            + (data.conteudoHtml ?? '') + '</span></span>';

        const urlEditar  = urlEditarTpl.replace('__ID__', data.id);
        const urlExcluir = urlExcluirTpl.replace('__ID__', data.id);

        /* Resposta (`data.respostaA` = id da RAIZ, já normalizado pelo servidor): vai para o
           FIM da conversa recuada sob a raiz, sem pílula de dia e sem contar como registro.
           Se a raiz não está na tela como raiz (ex.: excluída numa outra aba), entra no topo
           como um registro, com a faixa — como ficaria ao recarregar. */
        const ehResposta = data.respostaA !== null && data.respostaA !== undefined;
        const raizEl     = ehResposta ? document.getElementById('pasta-msg-' + data.respostaA) : null;
        const pendurada  = !!(raizEl && raizEl.parentElement === list);

        /* A pílula do dia (desenho: "5 out 2026") só entra se a primeira do topo
           não for a de hoje — o registro novo é sempre o mais recente. A chave do
           dia é a do servidor (`data-hoje`), a mesma que o Twig usa. */
        const MESES   = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
        const hoje    = list.dataset.hoje || '';
        const topoDia = list.querySelector('.ps-dia');
        const pilula  = (!pendurada && (!topoDia || topoDia.dataset.dia !== hoje))
            ? `<div class="ps-dia" data-dia="${esc(hoje)}"><span class="ps-dia-pilula">${dt.getDate()} ${MESES[dt.getMonth()]} ${dt.getFullYear()}</span></div>`
            : '';

        /* Resposta de outro dia que não o da raiz: a hora leva o dia junto (mesma regra do Twig). */
        let horaRotulo = hora;
        if (pendurada) {
            const dataRaiz = ((raizEl.querySelector('.ps-anotacao-data') || {}).title || '').slice(0, 10);
            const diaMes   = String(dt.getDate()).padStart(2, '0') + '/' + String(dt.getMonth() + 1).padStart(2, '0');
            if (dataRaiz && dataRaiz !== diaMes + '/' + dt.getFullYear()) { horaRotulo = diaMes + ' · ' + hora; }
        }

        const faixa = ehResposta
            ? `<div class="ps-anotacao-resposta-rot"><i class="bi bi-reply-fill" aria-hidden="true"></i><span>${esc(data.respostaANome ? BJ_T.t('pasta_show.js.registro.resposta_a', {nome: data.respostaANome}) : rotuloOrfa())}</span></div>`
            : '';
        const alvoId   = ehResposta ? data.respostaA : data.id;
        const alvoNome = ehResposta ? (data.respostaANome ?? '') : (data.autorNome ?? '');

        /* "Encaminhar via Chat I.A" (D:1405): o id da pasta vem do atributo que o Twig põe na
           lista (só com a Central e fora da lápide); o do registro é o número do servidor. */
        const encaminharPasta = Number(list.dataset.encaminharPasta || 0);
        const btnEncaminhar   = encaminharPasta
            ? `<button type="button" class="ps-anotacao-acao ps-anotacao-acao--responder js-encaminhar"
                        title="${esc(BJ_T.t('pasta_show.js.registro.encaminhar'))}" aria-label="${esc(BJ_T.t('pasta_show.js.registro.encaminhar'))}"
                        data-encaminhar-pasta="${encaminharPasta}"
                        data-encaminhar-tipo="registro_dados"
                        data-encaminhar-id="${Number(data.id)}">
                    <i class="bi bi-reply-fill" style="display:inline-block;transform:scaleX(-1)"></i>
                </button>`
            : '';

        /* Tem de sair a MESMA estrutura que o _dados_anotacoes.html.twig gera no
           servidor: se divergirem, o registro recém-enviado aparece com outra
           cara — defeito que só se vê depois de enviar, nunca ao abrir a tela. */
        const cartao = `
        <article class="ps-anotacao${ehResposta ? ' ps-anotacao--resposta' : ''}" id="pasta-msg-${data.id}"
                 data-janela-ate="${Number(data.criadaEmEpoch) + {{ comentario_janela_minutos() }} * 60}"
                 data-do-autor="1" data-autor-id="{{ app.user ? app.user.id : '' }}"{% if sem_prazo_selo(false) %} data-sem-prazo-rotulo="{{ ('edicao_sem_prazo.selo.' ~ sem_prazo_selo(false))|trans|e('html_attr') }}"{% endif %}>
            ${faixa}
            <span class="ps-anotacao-ponto" aria-hidden="true"></span>
            <span class="ps-anotacao-seta" aria-hidden="true"></span>
            <div class="ps-anotacao-topo">
                <span class="ps-avatar ps-avatar--24">${data.autorFotoUrl ? `<img src="${esc(data.autorFotoUrl)}" alt="">` : esc(iniciaisDe(data.autorNome))}</span>
                <span class="ps-anotacao-autor">${esc(data.autorNome ?? BJ_T.t('pasta_show.js.registro.autor_desconhecido'))}</span>
                <span class="ps-cab-espaco"></span>
                <span class="ps-anotacao-acoes">
                    <button type="button" class="ps-anotacao-acao btn-editar-msg-pasta"
                            title="${esc(BJ_T.t('pasta_show.js.registro.editavel', { minutos: {{ comentario_janela_minutos() }} }))}" aria-label="${esc(BJ_T.t('pasta_show.js.registro.editar'))}"
                            data-msg-id="${data.id}"
                            data-conteudo="${esc(data.conteudo)}"
                            data-csrf="${esc(data.csrfEditar ?? '')}"
                            data-url="${esc(urlEditar)}">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" hidden class="ps-anotacao-acao ps-anotacao-acao--perigo btn-excluir-msg-pasta"
                            title="${esc(BJ_T.t('pasta_show.js.registro.excluir'))}" aria-label="${esc(BJ_T.t('pasta_show.js.registro.excluir'))}"
                            data-msg-id="${data.id}"
                            data-csrf="${esc(data.csrfExcluir ?? '')}"
                            data-url="${esc(urlExcluir)}">
                        <i class="bi bi-trash3"></i>
                    </button>
                </span>
                <button type="button" class="ps-anotacao-acao ps-anotacao-acao--responder btn-responder-msg-pasta"
                        title="${esc(BJ_T.t('pasta_show.js.registro.responder'))}" aria-label="${esc(BJ_T.t('pasta_show.js.registro.responder'))}"
                        data-resposta-a="${esc(alvoId)}"
                        data-resposta-nome="${esc(alvoNome || BJ_T.t('pasta_show.js.registro.autor_desconhecido'))}"${ehResposta ? ` data-resposta-autor-id="{{ app.user ? app.user.id : '' }}" data-resposta-autor-nome="${esc(data.autorNome ?? '')}"` : ''}>
                    <i class="bi bi-reply-fill"></i>
                </button>
                ${btnEncaminhar}
                <span class="ps-anotacao-data ps-num" title="${dataHora}">${horaRotulo}</span>
                <button type="button" class="ps-reg-menu-btn js-reg-menu" title="${esc(BJ_T.t('pasta_show.js.registro.mais_acoes'))}"
                        aria-label="${esc(BJ_T.t('pasta_show.js.registro.mais_acoes'))}" aria-haspopup="menu" aria-expanded="false"
                        aria-controls="psRegMenu">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
            </div>
            <div class="ps-anotacao-corpo">
                <i class="bi bi-megaphone-fill ps-anotacao-icone" aria-hidden="true"></i>
                <div class="ps-anotacao-texto pasta-msg-conteudo">${corpo}</div>
            </div>
        </article>`;

        // O primeiro registro tira a lista do estado vazio: a linha do tempo aparece.
        list.classList.remove('ps-registro--vazio');

        if (pendurada) {
            /* A conversa da raiz é o irmão logo depois dela; a primeira resposta a cria.
               Ela herda o "escondido entre os anteriores" da raiz. */
            let conversa = raizEl.nextElementSibling;
            if (!conversa || !conversa.classList.contains('ps-respostas') || conversa.dataset.respostaDe !== String(data.respostaA)) {
                conversa = document.createElement('div');
                conversa.className = 'ps-respostas' + (raizEl.classList.contains('ps-anotacao--extra') ? ' ps-anotacao--extra' : '')
                    + (raizEl.classList.contains('d-none') ? ' d-none' : '');
                conversa.dataset.respostaDe = String(data.respostaA);
                raizEl.after(conversa);
            }
            conversa.insertAdjacentHTML('beforeend', cartao);
            const novo = document.getElementById('pasta-msg-' + data.id);
            if (novo) { novo.scrollIntoView({ block: 'nearest' }); }

            return false;
        }

        list.insertAdjacentHTML('afterbegin', pilula + cartao);
        list.scrollTop = 0;

        return true;
    }

    /* Iniciais do avatar: mesma regra do Twig (primeira letra do primeiro e do
       último nome). */
    function iniciaisDe(nome) {
        const partes = String(nome || '').trim().split(/\s+/).filter(Boolean);
        if (partes.length === 0) { return '?'; }
        const primeira = partes[0][0];
        const ultima   = partes.length > 1 ? partes[partes.length - 1][0] : '';
        return (primeira + ultima).toUpperCase();
    }

    function mostrarErro(msg) {
        erroDiv.textContent = msg;
        erroDiv.classList.remove('d-none');
    }

    function esconderErro() {
        erroDiv.classList.add('d-none');
    }

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
}());
</script>

<script>
/* Janela "Vincular processo" (desenho 02, N:289-354; estados `pvVals` N:3135-3151; `procMask`, `pvBuscarCNJ`,
   `docMask` e `procSalvarVinc` N:4507-4564). O modo apenso (título, "Tipo de apenso" e o aviso do apensado)
   é do pasta-apensado.js. */
(function () {
    var modalEl = document.getElementById('modalVincularProcesso');
    var form    = document.getElementById('formVincularProcesso');
    if (!modalEl || !form) return;

    var URL_BUSCA = '{{ path('pasta_buscar_processos', {id: pasta.id}) }}';
    var URL_CNJ   = '{{ path("pasta_processo_buscar_cnj", {id: pasta.id}) }}';
    var NUM_CNJ   = /^\d{7}-\d{2}\.\d{4}\.\d\.\d{2}\.\d{4}$/;

    var feedbackEl    = document.getElementById('mp-feedbackAlerta');
    var campoProcesso = document.getElementById('mp-processoExistente');
    var numeroEl      = document.getElementById('mp-numeroProcesso');
    var btnCnj        = document.getElementById('mp-btn-datajud');
    var cnjOk         = document.getElementById('mp-cnj-ok');

    /* Índice das linhas novas de parte e movimentação: sempre crescente, para dois `name` nunca colidirem. */
    var mpProxIdx = 1;
    /* Estado do aviso (desenho `pvVals.aviso`): o erro em vermelho vence; sem erro, o amarelo do modo. */
    var mpErro = '';
    var mpCnjNada = '';
    var mpCnjBuscando = false;

    function T(chave, params) { return BJ_T.t('pasta_show.js.processo.' + chave, params); }

    /* O que vem do Datajud é texto de fora: escapado antes de entrar no HTML das linhas (P5d). */
    function mpEsc(valor) {
        return String(valor == null ? '' : valor).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    /* Máscara do número CNJ enquanto digita (desenho `procMask`, N:4510). */
    function mpProcMask(v) {
        var d = String(v || '').replace(/\D/g, '').slice(0, 20);
        var s = d.slice(0, 7);
        if (d.length > 7) s += '-' + d.slice(7, 9);
        if (d.length > 9) s += '.' + d.slice(9, 13);
        if (d.length > 13) s += '.' + d.slice(13, 14);
        if (d.length > 14) s += '.' + d.slice(14, 16);
        if (d.length > 16) s += '.' + d.slice(16, 20);
        return s;
    }

    /* Máscara de CPF/CNPJ do documento da parte (desenho `docMask`, N:4532). */
    function mpDocMask(x) {
        var d = String(x || '').replace(/\D/g, '').slice(0, 14);
        if (d.length <= 11) {
            return d.replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d{1,2})$/, '$1-$2');
        }
        return d.replace(/^(\d{2})(\d)/, '$1.$2').replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3').replace(/\.(\d{3})(\d)/, '.$1/$2').replace(/(\d{4})(\d)/, '$1-$2');
    }

    /* Sigla do tribunal pelo número (desenho `procTrib`, N:4509), pela tabela do TribunalCnjResolver que a página
       entrega: a mesma sigla que o servidor grava. Número incompleto ou par J/TR desconhecido: vazio. */
    var mpTribunais = {};
    try { mpTribunais = JSON.parse(modalEl.dataset.tribunais || '{}') || {}; } catch (_) { mpTribunais = {}; }
    function mpProcTrib(numero) {
        var d = String(numero || '').replace(/\D/g, '');
        if (d.length !== 20) return '';
        var segmento = mpTribunais[d.charAt(13)] || {};
        return segmento[d.slice(14, 16)] || '';
    }

    /* O número gravado tem só os dígitos; na tela, com a máscara quando tem os 20. */
    function mpNumeroVisivel(numero) {
        return /^\d{20}$/.test(String(numero || '')) ? mpProcMask(numero) : String(numero || '');
    }

    var mpModo = 'existente';
    function mpModoNovo() { return mpModo === 'novo'; }

    /* ── Aviso (N:347, `avisoSt` N:3148) ── */
    function mpAtualizarAviso() {
        var texto = mpErro;
        var erro  = !!texto;
        if (!texto) {
            texto = mpModoNovo() ? mpCnjNada : (campoProcesso.value ? '' : T('selecione'));
        }
        feedbackEl.className   = 'mp-aviso' + (erro ? ' mp-aviso--erro' : '');
        feedbackEl.hidden      = !texto;
        feedbackEl.textContent = texto;
    }

    function mpDefinirErro(texto) { mpErro = texto || ''; mpAtualizarAviso(); }

    /* Como o `set()` do desenho: mexer num campo apaga o erro. */
    form.addEventListener('input', function () { if (mpErro) mpDefinirErro(''); });
    form.addEventListener('change', function () { if (mpErro) mpDefinirErro(''); });

    /* ── Abrir e fechar (desenho N:290-291: `fechar` no clique fora, `parar` na caixa, Esc em `tecla`) ── */
    var mpGatilho = null;

    function mpAbrir(gatilho) {
        mpGatilho = gatilho || null;
        // pasta-apensado.js escuta para pôr o modo apenso (o botão "Vincular apensado" tem data-vincular-modo).
        modalEl.dispatchEvent(new CustomEvent('vp:abrir', { detail: { gatilho: mpGatilho } }));
        modalEl.hidden = false;
        mpAtualizarAviso();
        // `autofocus` do desenho no campo de busca (N:299).
        buscaInput.focus();
    }

    function mpFechar() {
        if (modalEl.hidden) return;
        modalEl.hidden = true;
        mpLimpar();
        var destino = mpDestinoDoFoco(mpGatilho);
        if (destino) destino.focus();
        mpGatilho = null;
    }

    /* O foco volta ao botão que abriu. Se ele sumiu (item do menu ⋮, fechado junto), volta ao botão que abre
       aquele menu (`data-ps-pop` ou `aria-controls` com o id do menu). Sem prisão de foco: o desenho não tem. */
    function mpDestinoDoFoco(gatilho) {
        if (!gatilho || !document.contains(gatilho)) return null;
        if (gatilho.getClientRects().length) return gatilho;
        var menu = gatilho.parentElement ? gatilho.parentElement.closest('[id]') : null;
        while (menu) {
            var id = CSS.escape(menu.id);
            var abre = document.querySelector('[data-ps-pop="' + id + '"], [aria-controls="' + id + '"]');
            if (abre && abre.getClientRects().length) return abre;
            menu = menu.parentElement ? menu.parentElement.closest('[id]') : null;
        }
        return null;
    }

    document.addEventListener('click', function (e) {
        var gatilho = e.target.closest('[data-vp-abrir]');
        if (gatilho) { e.preventDefault(); mpAbrir(gatilho); }
    });
    modalEl.addEventListener('click', function (e) {
        if (e.target === modalEl || e.target.closest('[data-vp-fechar]')) mpFechar();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modalEl.hidden) mpFechar();
    });
    window.mpVincularProcesso = { abrir: mpAbrir, fechar: mpFechar };

    /* ── Sub-abas do cadastro novo ── */
    function mpIrSubaba(nome) {
        modalEl.querySelectorAll('.processo-modal-tab').forEach(function (t) {
            var ativa = t.dataset.modalTab === nome;
            t.classList.toggle('active', ativa);
            t.setAttribute('aria-selected', ativa ? 'true' : 'false');
        });
        modalEl.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.toggle('active', c.id === 'tab-' + nome); });
    }
    modalEl.querySelectorAll('.processo-modal-tab').forEach(function (tab) {
        tab.addEventListener('click', function () { mpIrSubaba(tab.dataset.modalTab); });
    });

    /* ── Modo (buscar existente x cadastrar novo) ── */
    function mpAplicarModo(modo) {
        var ehNovo = (modo === 'novo');
        mpModo = ehNovo ? 'novo' : 'existente';
        modalEl.querySelectorAll('.mp-aba').forEach(function (aba) {
            var ativa = aba.dataset.vpModo === mpModo;
            aba.classList.toggle('is-ativa', ativa);
            aba.setAttribute('aria-selected', ativa ? 'true' : 'false');
        });
        document.getElementById('modal-modo-existente').hidden = ehNovo;
        document.getElementById('modal-modo-novo').hidden = !ehNovo;
        campoProcesso.disabled = ehNovo; // não submete processo_id no modo novo
        mpErro = '';
        mpAtualizarAviso();
    }
    modalEl.querySelectorAll('.mp-aba').forEach(function (aba) {
        aba.addEventListener('click', function () { mpAplicarModo(aba.dataset.vpModo); });
    });

    /* ── Busca de processo existente (N:299-302, `pvVals.cat`) ── */
    var buscaInput  = document.getElementById('mp-busca-input');
    var buscaLista  = document.getElementById('mp-busca-lista');
    var buscaSel    = document.getElementById('mp-busca-sel');
    var buscaSelTxt = document.getElementById('mp-busca-sel-txt');
    var buscaItens  = [];
    var buscaAtivo  = -1;
    var buscaSeq    = 0;
    var buscaTimer  = null;
    var buscaQuer   = false; // a lista deve aparecer assim que chegar a resposta

    function mpOrigem(origem) {
        if (!origem || origem.tipo === 'push') return T('origem_push');
        // Sem permissão de ver a pasta de origem, o servidor não manda o número: "Outra pasta".
        if (!origem.pasta) return T(origem.tipo === 'apensado' ? 'origem_apensado_outra' : 'origem_outra_pasta');
        return T(origem.tipo === 'apensado' ? 'origem_apensado' : 'origem_pasta', { pasta: origem.pasta });
    }

    function mpFecharLista() {
        buscaLista.hidden = true;
        buscaAtivo = -1;
        buscaInput.setAttribute('aria-expanded', 'false');
        buscaInput.removeAttribute('aria-activedescendant');
    }

    function mpMostrarLista() {
        // Com um processo escolhido, a lista não abre (desenho: `listaOn && !sel`).
        if (!buscaQuer || campoProcesso.value) { mpFecharLista(); return; }
        buscaLista.textContent = '';
        if (!buscaItens.length) {
            var vazio = document.createElement('div');
            vazio.className = 'mp-busca-vazio';
            vazio.textContent = T('nenhum_encontrado');
            buscaLista.appendChild(vazio);
        }
        buscaItens.forEach(function (p, i) {
            var item = document.createElement('button');
            item.type = 'button';
            item.id = 'mp-busca-item-' + i;
            item.className = 'mp-busca-item' + (i === buscaAtivo ? ' is-ativo' : '');
            item.tabIndex = -1;
            item.setAttribute('role', 'option');
            item.setAttribute('aria-selected', i === buscaAtivo ? 'true' : 'false');
            var num = document.createElement('b');
            num.className = 'mp-busca-num';
            num.textContent = mpNumeroVisivel(p.numero);
            var sub = document.createElement('span');
            sub.className = 'mp-busca-sub';
            sub.textContent = ([p.classe, p.acao, p.tribunal].filter(Boolean).join(' · ') || T('dados_a_completar')) + ' · ' + mpOrigem(p.origem);
            item.appendChild(num);
            item.appendChild(sub);
            // mousedown sem padrão: o foco fica no input e o blur não fecha a lista antes do clique.
            item.addEventListener('mousedown', function (e) { e.preventDefault(); });
            item.addEventListener('click', function () { mpSelecionar(p); });
            buscaLista.appendChild(item);
        });
        buscaLista.hidden = false;
        buscaInput.setAttribute('aria-expanded', 'true');
        if (buscaAtivo >= 0) {
            buscaInput.setAttribute('aria-activedescendant', 'mp-busca-item-' + buscaAtivo);
            var ativo = document.getElementById('mp-busca-item-' + buscaAtivo);
            if (ativo) ativo.scrollIntoView({ block: 'nearest' });
        } else {
            buscaInput.removeAttribute('aria-activedescendant');
        }
    }

    function mpBuscar(imediato) {
        clearTimeout(buscaTimer);
        buscaTimer = setTimeout(async function () {
            var seq = ++buscaSeq;
            var itens = [];
            try {
                var resp = await fetch(URL_BUSCA + '?q=' + encodeURIComponent(buscaInput.value.trim()), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                });
                var dados = await resp.json().catch(function () { return {}; });
                itens = resp.ok ? (dados.results || []).slice(0, 8) : [];
            } catch (_) { itens = []; }
            if (seq !== buscaSeq) return; // chegou depois de uma busca mais nova
            buscaItens = itens;
            buscaAtivo = -1;
            mpMostrarLista();
        }, imediato ? 0 : 250);
    }

    function mpSelecionar(p) {
        campoProcesso.value = String(p.id);
        buscaSelTxt.textContent = [mpNumeroVisivel(p.numero), p.classe, p.tribunal].filter(Boolean).join(' · ');
        buscaSel.hidden = false;
        buscaQuer = false;
        mpFecharLista();
        mpErro = '';
        mpAtualizarAviso();
    }

    function mpLimparSelecao() {
        campoProcesso.value = '';
        buscaSelTxt.textContent = '';
        buscaSel.hidden = true;
        buscaInput.value = '';
        buscaItens = [];
        mpAtualizarAviso();
    }

    buscaInput.addEventListener('focus', function () { buscaQuer = true; mpBuscar(true); });
    buscaInput.addEventListener('click', function () {
        if (buscaLista.hidden) { buscaQuer = true; mpBuscar(true); }
    });
    buscaInput.addEventListener('input', function () { buscaQuer = true; mpBuscar(false); });
    buscaInput.addEventListener('blur', function () { buscaQuer = false; mpFecharLista(); });
    buscaInput.addEventListener('keydown', function (e) {
        var aberta = !buscaLista.hidden;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            if (!aberta) { buscaQuer = true; mpBuscar(true); return; }
            if (!buscaItens.length) return;
            buscaAtivo = e.key === 'ArrowDown'
                ? Math.min(buscaItens.length - 1, buscaAtivo + 1)
                : Math.max(0, buscaAtivo - 1);
            mpMostrarLista();
        } else if (e.key === 'Enter') {
            e.preventDefault(); // Enter escolhe o item; não envia a janela
            if (aberta && buscaAtivo >= 0 && buscaItens[buscaAtivo]) mpSelecionar(buscaItens[buscaAtivo]);
        }
        // Esc não para aqui: como no desenho (`pvVals.tecla`, N:3151), um Esc fecha a janela inteira, mesmo com
        // a lista aberta (o keydown do documento chama mpFechar, que também fecha a lista).
    });
    document.getElementById('mp-busca-trocar').addEventListener('click', function () {
        mpLimparSelecao();
        buscaInput.focus();
    });

    /* ── Linhas de parte e de movimentação (N:331-342) ── */
    function mpParteRowHtml(idx, parte) {
        parte = parte || {};
        var tipo = parte.tipo || '';
        var opcoes = [['PARTE', 'parte_parte'], ['ADVOGADO', 'parte_advogado'], ['TERCEIRO', 'parte_terceiro'], ['MINISTERIO_PUBLICO', 'parte_mp'], ['PERITO', 'parte_perito']]
            .map(function (o) { return '<option value="' + o[0] + '"' + (tipo === o[0] ? ' selected' : '') + '>' + mpEsc(T(o[1])) + '</option>'; })
            .join('');
        return `<div class="mp-parte-row mp-linha mp-linha--parte">
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('tipo'))}</span>
                <select name="partes[${idx}][tipo]" class="mp-ctrl">${opcoes}</select></label>
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('nome'))}</span>
                <input type="text" name="partes[${idx}][nome]" class="mp-ctrl" value="${mpEsc(parte.nome)}" placeholder="${mpEsc(T('nome_da_parte'))}"></label>
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('documento'))}</span>
                <input type="text" name="partes[${idx}][documento]" class="mp-ctrl mp-ctrl--num mp-doc" inputmode="numeric" value="${mpEsc(parte.documento)}" placeholder="${mpEsc(T('documento_placeholder'))}"></label>
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('papel'))}</span>
                <input type="text" name="partes[${idx}][papel]" class="mp-ctrl" value="${mpEsc(parte.papel)}" placeholder="${mpEsc(T('papel_placeholder'))}"></label>
            <button type="button" class="mp-lixeira mp-remove-parte" title="${mpEsc(T('remover_linha'))}" aria-label="${mpEsc(T('remover_linha'))}"><i class="bi bi-trash3"></i></button>
        </div>`;
    }

    function mpMovRowHtml(idx, mov) {
        mov = mov || {};
        return `<div class="mp-movimentacao-row mp-linha mp-linha--mov">
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('data'))}</span>
                <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="mp-ctrl" value="${mpEsc(mov.dataMovimentacao)}"></label>
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('descricao'))}</span>
                <input type="text" name="movimentacoes[${idx}][descricao]" class="mp-ctrl" value="${mpEsc(mov.descricao)}" placeholder="${mpEsc(T('descricao_movimentacao'))}"></label>
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('tipo'))}</span>
                <input type="text" name="movimentacoes[${idx}][tipo]" class="mp-ctrl" value="${mpEsc(mov.tipo)}" placeholder="${mpEsc(T('tipo_movimento'))}"></label>
            <label class="mp-campo"><span class="mp-rotulo">${mpEsc(T('orgao'))}</span>
                <input type="text" name="movimentacoes[${idx}][orgao]" class="mp-ctrl" value="${mpEsc(mov.orgao)}" placeholder="${mpEsc(T('orgao'))}"></label>
            <button type="button" class="mp-lixeira mp-remove-movimentacao" title="${mpEsc(T('remover_linha'))}" aria-label="${mpEsc(T('remover_linha'))}"><i class="bi bi-trash3"></i></button>
        </div>`;
    }

    /* A lixeira fica desabilitada quando há uma linha só (desenho `semRem`). */
    function mpUpdateRemoveButtons() {
        [['#mp-partesContainer', '.mp-parte-row', '.mp-remove-parte'], ['#mp-movimentacoesContainer', '.mp-movimentacao-row', '.mp-remove-movimentacao']].forEach(function (g) {
            var linhas = modalEl.querySelectorAll(g[0] + ' ' + g[1]).length;
            modalEl.querySelectorAll(g[0] + ' ' + g[2]).forEach(function (btn) { btn.disabled = linhas < 2; });
        });
    }

    function mpPreencherLinhas(partes, movs) {
        var partesContainer = document.getElementById('mp-partesContainer');
        var movContainer    = document.getElementById('mp-movimentacoesContainer');
        partesContainer.innerHTML = '';
        movContainer.innerHTML = '';
        (partes && partes.length ? partes : [{}]).forEach(function (parte) {
            partesContainer.insertAdjacentHTML('beforeend', mpParteRowHtml(mpProxIdx++, parte));
        });
        (movs && movs.length ? movs : [{}]).forEach(function (mov) {
            movContainer.insertAdjacentHTML('beforeend', mpMovRowHtml(mpProxIdx++, mov));
        });
        mpUpdateRemoveButtons();
    }

    document.getElementById('mp-btn-add-parte').addEventListener('click', function () {
        document.getElementById('mp-partesContainer').insertAdjacentHTML('beforeend', mpParteRowHtml(mpProxIdx++));
        mpUpdateRemoveButtons();
    });

    /* A movimentação nova entra no TOPO da lista (desenho `addMov`). */
    document.getElementById('mp-btn-add-movimentacao').addEventListener('click', function () {
        document.getElementById('mp-movimentacoesContainer').insertAdjacentHTML('afterbegin', mpMovRowHtml(mpProxIdx++));
        mpUpdateRemoveButtons();
    });

    modalEl.addEventListener('click', function (e) {
        var lixeira = e.target.closest('.mp-lixeira');
        if (!lixeira || lixeira.disabled) return;
        var linha = lixeira.closest('.mp-linha');
        if (linha) linha.remove();
        mpUpdateRemoveButtons();
    });

    /* Documento da parte: máscara de CPF/CNPJ enquanto digita. */
    form.addEventListener('input', function (e) {
        if (e.target.classList && e.target.classList.contains('mp-doc')) e.target.value = mpDocMask(e.target.value);
    });

    /* Valor da causa: máscara "R$ 1.234,56" (desenho `onValor`, N:3145). */
    var mpValor = document.getElementById('mp-valorCausa');
    mpValor.addEventListener('input', function () {
        var d = mpValor.value.replace(/\D/g, '');
        mpValor.value = d ? 'R$ ' + (Number(d) / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : '';
    });

    /* Número: máscara do CNJ; a confirmação da busca anterior já não vale (desenho: `up('numero')` zera o cnj). */
    numeroEl.addEventListener('input', function () {
        numeroEl.value = mpProcMask(numeroEl.value);
        document.getElementById('mp-siglaTribunal').value = mpProcTrib(numeroEl.value);
        cnjOk.hidden = true;
        if (mpCnjNada) { mpCnjNada = ''; mpAtualizarAviso(); }
    });

    /* ── Buscar no CNJ (desenho `pvBuscarCNJ`, N:4521): "Buscando…" com bi-arrow-repeat no próprio botão ── */
    function mpCnjEstado(buscando) {
        mpCnjBuscando = buscando;
        btnCnj.querySelector('i').className = buscando ? 'bi bi-arrow-repeat' : 'bi bi-search';
        document.getElementById('mp-cnj-texto').textContent = T(buscando ? 'buscando' : 'buscar_cnj');
        btnCnj.setAttribute('aria-busy', buscando ? 'true' : 'false');
    }

    btnCnj.addEventListener('click', async function () {
        if (mpCnjBuscando) return;
        var numeroProcesso = mpProcMask(numeroEl.value);
        numeroEl.value = numeroProcesso;
        cnjOk.hidden = true;
        mpCnjNada = '';
        // Número incompleto: erro vermelho (desenho `erro`, N:4523).
        if (!NUM_CNJ.test(numeroProcesso)) {
            mpDefinirErro(T('numero_completo'));
            return;
        }
        mpDefinirErro('');

        mpCnjEstado(true);
        try {
            // a4: a consulta pela pasta vale para quem edita a pasta, mesmo sem o módulo de processos.
            var response = await fetch(URL_CNJ, {
                method: 'POST',
                // X-Requested-With: as barreiras da pasta (cadeado, aba oculta, lápide) respondem 403 em JSON, não redirecionam.
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ numeroProcesso: numeroProcesso })
            });
            var data = await response.json();

            if (!response.ok || !data.success) {
                if (response.status === 404) {
                    // O texto do desenho (amarelo) e o motivo do servidor (dígito verificador, atraso da base,
                    // segredo ou arquivado), que ajuda a achar número mal digitado.
                    mpCnjNada = T('nao_localizado') + (data.error ? ' ' + data.error : '');
                    mpAtualizarAviso();
                } else {
                    mpDefinirErro(data.error || data.erro || data.mensagem || T('erro_buscar_cnj')); // erro/mensagem: barreiras da pasta
                }
                return;
            }

            var pd = data.data;
            document.getElementById('mp-siglaTribunal').value     = pd.siglaTribunal     || '';
            document.getElementById('mp-orgaoJulgador').value     = pd.orgaoJulgador     || '';
            document.getElementById('mp-classeProcessual').value  = pd.classeProcessual  || '';
            document.getElementById('mp-assuntoProcessual').value = pd.assuntoProcessual || '';
            document.getElementById('mp-situacaoProcesso').value  = pd.situacaoProcesso  || 'EM_ANDAMENTO';
            document.getElementById('mp-instancia').value         = pd.instancia         || 'G1';
            document.getElementById('mp-dataDistribuicao').value  = pd.dataDistribuicao  || '';
            mpPreencherLinhas(pd.partes, pd.movimentacoes);

            // Desenho N:315: "Dados localizados · N movimentação(ões)".
            cnjOk.querySelector('[data-mp-cnj-movs]').textContent = String((pd.movimentacoes || []).length);
            cnjOk.hidden = false;
        } catch (e) {
            mpDefinirErro(T('erro_buscar_cnj_tente'));
        } finally {
            mpCnjEstado(false);
        }
    });

    /* "Preencha: ..." no clique, como o desenho (`procSalvarVinc`, N:4538): volta para a aba Informações. */
    function mpFaltando() {
        var falta = [];
        if (!NUM_CNJ.test(mpProcMask(numeroEl.value))) falta.push(T('falta_numero'));
        if (!document.getElementById('mp-orgaoJulgador').value.trim()) falta.push(T('falta_orgao'));
        if (!document.getElementById('mp-classeProcessual').value.trim()) falta.push(T('falta_classe'));
        if (!document.getElementById('mp-assuntoProcessual').value.trim()) falta.push(T('falta_assunto'));
        return falta;
    }

    /* ── Envio via AJAX ── */
    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btnSalvar = form.querySelector('button[type="submit"]');
        var icone     = btnSalvar.querySelector('i');
        var modoNovo  = mpModoNovo();

        if (!modoNovo && !campoProcesso.value) {
            mpDefinirErro(T('selecione')); // o amarelo da aba vira erro no clique (desenho `procSalvarVinc`)
            return;
        }
        if (modoNovo) {
            var falta = mpFaltando();
            if (falta.length) {
                mpIrSubaba('modal-proc-info');
                mpDefinirErro(T('preencha', { campos: falta.join(', ') }));
                return;
            }
        }

        btnSalvar.disabled = true;
        if (icone) icone.className = 'bi bi-hourglass-split';

        try {
            var resp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });
            var dados = await resp.json().catch(function () { return {}; });

            if (resp.ok && dados.sucesso) {
                var principal = document.getElementById('mp-modo').value !== 'apenso';
                window.mpSwapProcessos(dados.html);
                document.dispatchEvent(new CustomEvent('mp:processo-vinculado')); // P4f: aviso do apensado (pasta-apensado.js)
                if (window.avisarPs) {
                    // Número que já era do escritório: vinculou o existente e avisa que o digitado não foi aplicado.
                    if (dados.aviso) { window.avisarPs(dados.aviso); }
                    // Desenho N:4564: o aviso do processo principal (o do apensado é do pasta-apensado.js).
                    else if (principal) { window.avisarPs(T('vinculado_aviso')); }
                }
                mpFechar();
                return;
            }

            mpDefinirErro(dados.erro ?? T('erro_vincular'));
        } catch (_) {
            mpDefinirErro(T('erro_comunicacao'));
        } finally {
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check2';
        }
    });

    /* ── Fechar a janela limpa o formulário ── */
    function mpLimpar() {
        form.reset();
        mpProxIdx = 0;
        mpPreencherLinhas([], []);
        cnjOk.hidden = true; // a confirmação da busca é desta abertura
        mpCnjNada = '';
        mpCnjEstado(false);
        mpIrSubaba('modal-proc-info');
        document.getElementById('mp-siglaTribunal').value = '';
        buscaQuer = false;
        mpFecharLista();
        mpLimparSelecao();
        mpAplicarModo('existente');
    }

    mpAplicarModo('existente');
    mpUpdateRemoveButtons();
}());
</script>

{# ── Modal: editar pasta ──
   Moldura do desenho 1.2.3 (dc 560-592; auditoria 2 C2): cabeçalho em gradiente com
   o círculo da pasta, título "Pasta nnnn" e o cliente como subtítulo; rótulos em
   caixa alta; rodapé Fechar · Salvar. SÓ a moldura: os campos e o POST para
   `pasta_edit` são os de sempre (ids, names, CSRF). Responsável com "Trocar" (PAS-021),
   a pílula de estado, o Salvar travado e "Pendências" (PAS-020): abaixo. A Ação e o
   CPF/CNPJ (decisão do dono, 23/10/2026; PZ-MOD-N05 e PZ-MOD-16) são SÓ LEITURA: a Ação
   vem do menu Processo (edição no ⋮ da aba Processo, `pasta_acao_salvar`) e o documento
   é do Cliente (muda no cadastro dele). O "Tipo de documento" do desenho não entra:
   ele só existe para digitar o documento, e aqui o rótulo (CPF ou CNPJ) já diz o tipo.

   Abas de atalho e "Cadastro do cliente" (lote L2; dc L.570-572, 587, 4299-4301):
   são ATALHOS, não abas do form — ficam FORA do <form>, sem `name`, e nenhum campo
   sai nem se esconde. "Dados da pasta" é a ativa (sem ação); Cliente e "Cadastro do
   cliente" fecham o modal e abrem a janela "Detalhes do cliente" pelo botão
   Cadastro do cabeçalho (sem cliente cadastrado: levam à seção Clientes da aba
   Dados, onde se vincula um); Processo fecha e abre a aba Processo; Histórico
   fecha e abre o drawer do histórico. O desenho descarta o que foi digitado ao
   trocar de aba; aqui, se o form foi alterado, pergunta antes (confirm). #}
<style>
    /* PAS-021: a linha só leitura do desenho (dc L.581: 34px, fundo suave, "Trocar" 26px). */
    .ps-pe-resp {
        display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 6px 0 10px;
        border-radius: 4px; background: var(--ps-soft); box-shadow: inset 0 0 0 1px var(--ps-border);
    }
    .ps-pe-resp-nome { flex: 1; min-width: 0; font-size: 13.5px; color: var(--ps-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ps-pe-resp-trocar {
        height: 26px; padding: 0 9px; border: none; border-radius: 3px; white-space: nowrap; cursor: pointer;
        background: var(--ps-accent-bg); color: var(--ps-accent); font-size: 12px; font-weight: 700;
    }
    .ps-pe-resp-trocar:hover, .ps-pe-resp-trocar:focus-visible { background: var(--ps-hover); outline: none; }
    /* PAS-020: pílula de estado, Salvar travado e "Pendências" (dc L.567, 584, 588; `peVals`). */
    .ps-pe-estado {
        display: inline-flex; align-items: center; gap: 6px; height: 20px; padding: 0 9px;
        border-radius: 999px; font-size: 11px; font-weight: 700; background: var(--ps-ok-bg); color: var(--ps-ok-text);
    }
    .ps-pe-estado-ponto { width: 7px; height: 7px; border-radius: 50%; background: var(--ps-ok-dot); }
    .ps-pe-estado.is-alterado { background: var(--ps-warn-bg); color: var(--ps-warn-text); }
    .ps-pe-estado.is-alterado .ps-pe-estado-ponto { background: var(--ps-warn-dot); }
    .ps-pe-pendencias {
        display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border-radius: 4px;
        background: var(--ps-warn-bg); box-shadow: inset 0 0 0 1px var(--ps-warn-border);
    }
    .ps-pe-pendencias[hidden] { display: none; }
    .ps-pe-pendencias-rot { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ps-warn-text); }
    .ps-pe-pendencias-linha { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ps-warn-text); }
    .ps-pe-pendencias-linha i { font-size: 12px; color: var(--ps-danger-dot); }
    #modalEditarPasta .ps-modal-pasta-btn--salvar:disabled { opacity: 1; background: var(--ps-border-ctl); color: #fff; cursor: not-allowed; }
    /* PZ-MOD-N05/16: a mesma linha só leitura serve à Ação ("Abrir", dc L.659) e ao CPF/CNPJ; o atalho do
       documento é um link (vai ao cadastro do cliente), com a mesma medida do botão. Vazio em cinza. */
    a.ps-pe-resp-trocar { display: inline-flex; align-items: center; text-decoration: none; }
    .ps-pe-resp-nome.is-vazio { color: var(--ps-muted); }
    .ps-pe-resp-nome--num { font-variant-numeric: tabular-nums; }
</style>
{% set editCliente = pasta.clientePrincipal %}
{% set editDocumento = editCliente ? (editCliente.cpf is defined ? editCliente.cpf : (editCliente.cnpj is defined ? editCliente.cnpj : null)) : null %}
{% set editNomeSub = editCliente ? editCliente.nomeExibicao : pasta.nomeCliente %}
{# Janela do desenho 02 (VS 18.10.26, L.634-668), não o modal do Bootstrap: sobreposição própria (L.635,
   `pe.fundo` no mousedown do fundo), caixa de 720px com role=dialog (L.636, `pe.tecla`: Esc fecha) e, dentro
   dela, cabeçalho, atalhos, corpo e rodapé de sempre. Abre pelos `[data-pe-abrir]` (item "Editar dados" do ⋮,
   atalho E); fecha no X, no Fechar, no clique no fundo e no Esc. Mesmo padrão da janela "Vincular processo"
   (`vp-sobre`). Os campos, os names, o CSRF e o POST para `pasta_edit` não mudam. #}
<div class="ps-pe-sobre" id="modalEditarPasta" hidden>
        <div class="ps-modal-pasta" role="dialog" aria-modal="true" aria-labelledby="modalEditarPastaLabel">
            <div class="ps-modal-pasta-cab">
                <span class="ps-modal-pasta-cab-icone" aria-hidden="true"><i class="bi bi-folder2-open"></i></span>
                <div class="ps-modal-pasta-cab-corpo">
                    <h2 class="ps-modal-pasta-titulo" id="modalEditarPastaLabel"><span class="visually-hidden">{{ 'pasta_show.editar.editar_dados_da'|trans }} </span>{{ 'pasta_show.titulo'|trans({nup: pasta.nup}) }}</h2>
                    {# PAS-020 (dc L.567, `pe.stTxt`): a pílula de estado fica na linha do subtítulo —
                       "Dados da pasta" (verde) ou "Alterações não salvas" (âmbar); o script abaixo
                       a alterna comparando o formulário com o que veio do servidor. #}
                    <div class="ps-modal-pasta-sub">
                        {% if editNomeSub or editDocumento %}
                            <span class="ps-modal-pasta-sub-tx">
                                {{- editNomeSub -}}
                                {%- if editNomeSub and editDocumento %} · {% endif -%}
                                {%- if editDocumento -%}{{ editDocumento|documento_br_rotulo }} {{ editDocumento|documento_br }}{%- endif -%}
                            </span>
                        {% endif %}
                        <span class="ps-pe-estado" data-pe-estado><span class="ps-pe-estado-ponto" aria-hidden="true"></span><span data-pe-estado-txt>{{ 'pasta_show.editar.dados_da_pasta'|trans }}</span></span>
                    </div>
                </div>
                <button type="button" class="ps-modal-pasta-fechar" data-pe-fechar title="{{ 'pasta_show.fechar'|trans }}" aria-label="{{ 'pasta_show.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <nav class="ps-modal-pasta-abas" aria-label="{{ 'pasta_show.editar.atalhos'|trans }}">
                <button type="button" class="ps-modal-pasta-aba is-ativa" aria-current="true"><i class="bi bi-folder2" aria-hidden="true"></i>{{ 'pasta_show.editar.dados_da_pasta'|trans }}</button>
                <button type="button" class="ps-modal-pasta-aba js-pe-ir" data-pe-ir="cliente" title="{{ 'pasta_show.editar.ir_cliente_dica'|trans }}"><i class="bi bi-person" aria-hidden="true"></i>{{ 'pasta_show.editar.aba_cliente'|trans }}</button>
                <button type="button" class="ps-modal-pasta-aba js-pe-ir" data-pe-ir="processo" title="{{ 'pasta_show.editar.ir_processo_dica'|trans }}"><i class="bi bi-bank" aria-hidden="true"></i>{{ 'pasta_show.editar.aba_processo'|trans }}</button>
                <button type="button" class="ps-modal-pasta-aba js-pe-ir" data-pe-ir="historico" title="{{ 'pasta_show.editar.ir_historico_dica'|trans }}"><i class="bi bi-clock-history" aria-hidden="true"></i>{{ 'pasta_show.editar.aba_historico'|trans }}</button>
            </nav>
            <form method="post" action="{{ path('pasta_edit', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_pasta_' ~ pasta.id) }}">
                <div class="ps-modal-pasta-corpo">

                    <div class="ps-modal-pasta-linha">
                        <div class="ps-modal-pasta-campo">
                            <label for="edit_nup" class="ps-modal-pasta-rotulo">{{ 'pasta_show.editar.numero'|trans }}<span class="ps-modal-pasta-obrig" aria-hidden="true"> *</span></label>
                            <input type="text" id="edit_nup" name="nup"
                                   class="form-control"
                                   value="{{ pasta.nup }}" required autocomplete="off">
                        </div>

                        {# O campo é renderizado SEMPRE, mesmo com cliente cadastrado. Ele já foi
                           escondido nesse caso, e o resultado era o pior possível: o navegador não
                           mandava a chave, o controller lia vazio e APAGAVA o nome ao salvar — sem
                           ninguém tocar no campo. São coisas diferentes e ambas precisam existir aqui:
                           o TÍTULO da pasta (texto livre, hoje no padrão `CREDOR - DEVEDOR`) e os
                           CLIENTES cadastrados, que viram contexto logo abaixo. #}
                        {% set identificadorDerivado = identificador_pasta_da_cobranca(pasta) %}
                        {% set derivadoDaCobranca = identificadorDerivado is not null and identificadorDerivado != pasta.nomeCliente %}
                        <div class="ps-modal-pasta-campo ps-modal-pasta-campo--2">
                            <label {% if not derivadoDaCobranca %}for="edit_nome_cliente" {% endif %}class="ps-modal-pasta-rotulo">{{ 'pasta_show.editar.nome_cliente'|trans }}</label>
                            {% if derivadoDaCobranca %}
                                {# Pasta judicializada pela cobrança: o identificador é MONTADO do credor da
                                   carteira + a pessoa cobrada, e por isso não se edita aqui. Campo que
                                   some sem explicação vira chamado de suporte — o texto abaixo diz onde
                                   mudar. O `nome_cliente` não é enviado, e o controller trata chave
                                   AUSENTE como "não mexe", então nada é apagado. #}
                                <p class="form-control bg-body-secondary mb-1" style="height:auto;">{{ identificadorDerivado }}</p>
                                <div class="form-text text-muted">
                                    {{ 'pasta_show.editar.montado'|trans }}
                                    {{ 'pasta_show.editar.para_mudar'|trans }} <strong>{{ 'pasta_show.editar.cadastro_do_cliente'|trans }}</strong> {{ 'pasta_show.editar.ou_responsavel'|trans }}
                                </div>
                            {% else %}
                            <input type="text" id="edit_nome_cliente" name="nome_cliente"
                                   class="form-control"
                                   value="{{ pasta.nomeCliente }}" autocomplete="off">
                            {% endif %}
                            {% if pasta.clientes|length > 0 %}
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    {% for cliente in pasta.clientes %}
                                        <span class="badge text-bg-secondary fw-normal">
                                            <i class="bi bi-person me-1"></i>{{ cliente.nomeExibicao }}
                                        </span>
                                    {% endfor %}
                                </div>
                                <div class="form-text text-muted">{{ 'pasta_show.editar.clientes_dica'|trans }}</div>
                            {% endif %}
                        </div>
                    </div>

                    {# PZ-MOD-16 (dc L.652-653; máscara de `peVals`, L.4455): o CPF/CNPJ é do CLIENTE principal,
                       não da pasta, e aqui só se LÊ, formatado (000.000.000-00 ou 00.000.000/0000-00, pela
                       contagem de dígitos do `documento_br`). "Cadastro" abre a janela de Cadastro do
                       cliente (`data-pe-ir="cliente"`, como `cadAbrir` no desenho, dc:4482-4483), com a pergunta
                       das alterações não salvas. Sem cliente cadastrado ou sem documento: o
                       vazio neutro e nenhum atalho. Sem `name`: nada daqui vai no POST. #}
                    <div class="ps-modal-pasta-linha">
                        <div class="ps-modal-pasta-campo ps-modal-pasta-campo--2" data-pe-documento>
                            <span class="ps-modal-pasta-rotulo" id="editDocRotulo">{{ editDocumento ? editDocumento|documento_br_rotulo : 'pasta_show.editar.cpf_cnpj'|trans }}</span>
                            <div class="ps-pe-resp" role="group" aria-labelledby="editDocRotulo">
                                {% if editDocumento %}
                                    <span class="ps-pe-resp-nome ps-pe-resp-nome--num" data-pe-doc>{{ editDocumento|documento_br }}</span>
                                    <button type="button" class="ps-pe-resp-trocar js-pe-ir" data-pe-ir="cliente" title="{{ 'pasta_show.editar.documento_dica'|trans }}">{{ 'pasta_show.editar.documento_cadastro'|trans }}</button>
                                {% else %}
                                    <span class="ps-pe-resp-nome is-vazio" data-pe-doc>{{ editCliente ? 'pasta_show.editar.sem_documento'|trans : 'pasta_show.editar.sem_cliente_cadastrado'|trans }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="ps-modal-pasta-linha ps-modal-pasta-linha--larga">
                        {# PAS-021 (dc L.581, `pe.trocarResp`): Responsável só leitura com "Trocar", que
                           fecha a janela e abre o menu de responsável do cabeçalho (o mesmo do ⋮
                           "Trocar responsável", com o endpoint e o CSRF de sempre). Sem `name`, nada
                           daqui vai no POST do formulário. O nome é relido do chip do cabeçalho ao
                           abrir, porque a troca pode ter acontecido depois da carga. #}
                        <div class="ps-modal-pasta-campo">
                            <span class="ps-modal-pasta-rotulo" id="editRespRotulo">{{ 'pasta_show.editar.responsavel'|trans }}</span>
                            <div class="ps-pe-resp" role="group" aria-labelledby="editRespRotulo">
                                <span class="ps-pe-resp-nome" data-pe-resp-nome>{{ pasta.responsavel ? pasta.responsavel.fullName : 'pasta_show.editar.sem_responsavel'|trans }}</span>
                                {% if podeEditarPasta and not pasta.estaExcluida %}
                                    <button type="button" class="ps-pe-resp-trocar js-pe-ir" data-pe-ir="responsavel">{{ 'pasta_show.editar.trocar'|trans }}</button>
                                {% endif %}
                            </div>
                        </div>

                        {# PZ-MOD-N05 (dc L.659, `pe.irProcesso`): a Ação é SÓ LEITURA, "vem do menu Processo". "Abrir"
                           fecha a janela, vai à aba Processo e, se a edição da Ação existe (EDIT na pasta), abre-a
                           (`.js-proc-editar-acao`, pasta-processo.js). Sem `name`: o `pasta_edit` não grava mais a
                           Ação (o controller também ignora `nome_acao`). Vazia: o texto do desenho sem processo
                           ("Sem processo vinculado") ou, com processo, "Sem ação informada". #}
                        <div class="ps-modal-pasta-campo" data-pe-acao>
                            <span class="ps-modal-pasta-rotulo" id="editAcaoRotulo">{{ 'pasta_show.editar.acao_do_processo'|trans }}</span>
                            <div class="ps-pe-resp" role="group" aria-labelledby="editAcaoRotulo">
                                {% if pasta.nomeAcao %}
                                    <span class="ps-pe-resp-nome" title="{{ pasta.nomeAcao }}">{{ pasta.nomeAcao }}</span>
                                {% else %}
                                    <span class="ps-pe-resp-nome is-vazio">{{ pasta.pastaProcessos|length > 0 ? 'pasta_show.editar.sem_acao'|trans : 'pasta_show.editar.sem_processo'|trans }}</span>
                                {% endif %}
                                {% if 'processo' not in abasOcultas %}
                                    <button type="button" class="ps-pe-resp-trocar js-pe-ir" data-pe-ir="acao" title="{{ 'pasta_show.editar.acao_abrir_dica'|trans }}">{{ 'pasta_show.editar.abrir'|trans }}</button>
                                {% endif %}
                            </div>
                        </div>

                        <div class="ps-modal-pasta-campo">
                            <label for="edit_situacao" class="ps-modal-pasta-rotulo">{{ 'pasta_show.editar.situacao'|trans }}</label>
                            <select id="edit_situacao" name="situacao" class="form-select">
                                {% for valor, rotuloSituacao in constant('App\\Pasta\\Entity\\Pasta::ROTULOS_SITUACAO') %}
                                    <option value="{{ valor }}" {{ pasta.situacao == valor ? 'selected' : '' }}>{{ rotuloSituacao }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    {# PAS-020 (dc L.584, `pe.temErro`): o que impede salvar, no bloco "Pendências".
                       Aqui só o que a tela sabe sozinha (número vazio); número repetido e o resto
                       continuam com o servidor, que responde no flash de sempre. #}
                    <div class="ps-pe-pendencias" role="alert" data-pe-pendencias hidden>
                        <span class="ps-pe-pendencias-rot">{{ 'pasta_show.editar.pendencias'|trans }}</span>
                        <span class="ps-pe-pendencias-linha"><i class="bi bi-x-circle-fill" aria-hidden="true"></i><span data-pe-pendencias-txt></span></span>
                    </div>

                </div>
                <div class="ps-modal-pasta-rodape">
                    <button type="button" class="ps-modal-pasta-btn ps-modal-pasta-btn--fechar" data-pe-fechar>{{ 'pasta_show.fechar'|trans }}</button>
                    <button type="button" class="ps-modal-pasta-btn ps-modal-pasta-btn--cadastro js-pe-ir" data-pe-ir="cliente"><i class="bi bi-person-vcard" aria-hidden="true"></i>{{ 'pasta_show.editar.cadastro_cliente_botao'|trans }}</button>
                    <button type="submit" class="ps-modal-pasta-btn ps-modal-pasta-btn--salvar">
                        <i class="bi bi-check2"></i>{{ 'pasta_show.salvar'|trans }}
                    </button>
                </div>
            </form>
        </div>
</div>

<script>
/* Janela "Editar dados" do desenho 02 (VS 18.10.26, L.634-668 e `peVals` L.4449-4485), sem o modal do
   Bootstrap. Abrir (`peAbrir`, L.4451): mostra a sobreposição e põe o foco no número com o texto
   selecionado (`pe.foco`). Fechar (`pe.fechar`): X, Fechar, mousedown no fundo (`pe.fundo`) e Esc
   (`pe.tecla`); o foco volta para quem abriu (ou para o ⋮, se o item do menu já sumiu). Fechar não
   descarta o que foi digitado: reabrir continua "Alterações não salvas", como antes.

   Atalhos (lote L2): fecham a janela e então abrem o destino, os gatilhos que a tela já tem: o botão
   Cadastro do cabeçalho (#psCadastroAbrir, pasta-clientes.js), a aba #processo-tab e o
   #psHistoricoAbrir (pasta-show.js).

   E7: roda no DOMContentLoaded, para achar o pasta-dialogos.js (janela azul do número, "Descartar
   as alterações?") já carregado no fim do base.html.twig. */
document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('modalEditarPasta');
    if (!modal) { return; }
    var form = modal.querySelector('form');

    function serializar() {
        return form ? new URLSearchParams(new FormData(form)).toString() : '';
    }
    // O retrato é o que veio do SERVIDOR (tirado ao carregar): fechar e reabrir com algo
    // digitado continua "Alterações não salvas".
    var foto = serializar();

    /* PAS-020 (`peVals`: `mud`, `erro`, `naoSalvar`): a pílula diz se há alteração; o Salvar
       só acende com alteração e sem pendência; a pendência aparece no bloco. */
    var estado = modal.querySelector('[data-pe-estado]');
    var estadoTxt = modal.querySelector('[data-pe-estado-txt]');
    var pendencias = modal.querySelector('[data-pe-pendencias]');
    var pendenciasTxt = modal.querySelector('[data-pe-pendencias-txt]');
    var salvar = form ? form.querySelector('button[type="submit"]') : null;
    var nup = document.getElementById('edit_nup');

    function conferir() {
        var mudou = serializar() !== foto;
        var erro = nup && nup.value.trim() === '' ? BJ_T.t('pasta_show.js.editar.informe_numero') : '';
        if (estado) {
            estado.classList.toggle('is-alterado', mudou);
            estadoTxt.textContent = mudou ? BJ_T.t('pasta_show.js.editar.nao_salvas') : BJ_T.t('pasta_show.js.editar.dados_da_pasta');
        }
        if (pendencias) {
            pendencias.hidden = !(mudou && erro);
            pendenciasTxt.textContent = mudou ? erro : '';
        }
        if (salvar) {
            salvar.disabled = !(mudou && !erro);
            salvar.title = !mudou ? BJ_T.t('pasta_show.js.editar.nenhuma_alteracao') : (erro || '');
        }
    }
    if (form) {
        form.addEventListener('input', conferir);
        form.addEventListener('change', conferir);
    }
    conferir();

    /* PAS-019 (dc L.4287/4416): trocar o NÚMERO pede confirmação antes de gravar, com o texto do
       desenho — o número antigo é o que veio do servidor (`defaultValue`). E7: na janela AZUL da tela
       (dc `confirmarUI(…, false)`, título "Alterar número da pasta"), registrada no pasta-dialogos.js
       (já carregado no DOMContentLoaded). Sem a janela, o `confirm` de sempre. */
    if (form && nup) {
        var perguntaDoNumero = function () {
            var antes = nup.defaultValue.trim();
            var depois = nup.value.trim();
            if (depois === '' || depois === antes) { return null; }

            return {
                mensagem: BJ_T.t('pasta_show.js.editar.numero_titulo') + '\n' + BJ_T.t('pasta_show.js.editar.numero_pergunta', {antes: antes, depois: depois}),
                perigo: false
            };
        };
        if (window.psConfirmarEnvio) {
            window.psConfirmarEnvio(form, perguntaDoNumero);
        } else {
            form.addEventListener('submit', function (e) {
                var p = perguntaDoNumero();
                if (p && !window.confirm(p.mensagem.replace('\n', '\n\n'))) { e.preventDefault(); }
            });
        }
    }

    function irParaClientes() {
        var aba = document.getElementById('dados-tab');
        if (aba) { aba.click(); }
        var secao = document.querySelector('[data-trilho="clientes"]');
        if (secao) { secao.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }

    var destinos = {
        cliente: function () {
            var cadastro = document.getElementById('psCadastroAbrir');
            if (cadastro) { cadastro.click(); } else { irParaClientes(); }
        },
        processo: function () {
            var aba = document.getElementById('processo-tab');
            if (aba) { aba.click(); aba.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
        },
        /* PZ-MOD-N05 (`pe.irProcesso`, dc L.4484): "Abrir" da Ação vai à aba Processo e abre a edição da
           Ação pelo item do ⋮ (pasta-processo.js), quando ele existe (EDIT na pasta). Com a aba fechada,
           espera o `shown.bs.tab`, para o foco cair no campo já visível. */
        acao: function () {
            var aba = document.getElementById('processo-tab');
            var editar = document.querySelector('.js-proc-editar-acao[data-edicao]');
            if (!aba) { return; }
            function abrirEdicaoDaAcao() {
                if (editar) { editar.click(); }
            }
            if (aba.classList.contains('active')) {
                destinos.processo();
                abrirEdicaoDaAcao();
                return;
            }
            aba.addEventListener('shown.bs.tab', abrirEdicaoDaAcao, { once: true });
            destinos.processo();
        },
        historico: function () {
            var abrir = document.getElementById('psHistoricoAbrir');
            if (abrir && abrir.getAttribute('aria-expanded') !== 'true') { abrir.click(); }
        },
        // PAS-021: o "Trocar responsável" do ⋮ (pasta-show.js), que abre o menu do chip.
        responsavel: function () {
            var trocar = document.getElementById('psMenuTrocarResponsavel');
            if (trocar) { trocar.click(); }
        }
    };

    /* ── Abrir e fechar (desenho: `peAbrir`, `pe.fechar`, `pe.fundo`, `pe.tecla`, `pe.foco`) ── */
    var peGatilho = null;

    function peAbrir(gatilho) {
        peGatilho = gatilho || null;
        // O nome do responsável é relido do chip do cabeçalho: a troca pode ter vindo depois da carga.
        var nome = modal.querySelector('[data-pe-resp-nome]');
        var doChip = document.querySelector('.ps-cab-resp .pasta-resp-chip .pasta-resp-nome');
        if (nome && doChip) { nome.textContent = doChip.textContent.trim(); }
        modal.hidden = false;
        conferir();
        if (nup) { nup.focus(); nup.select(); }
    }

    /* `devolver` falso: quem chamou leva o foco para outro lugar (atalhos). */
    function peFechar(devolver) {
        if (modal.hidden) { return; }
        modal.hidden = true;
        modal.dispatchEvent(new CustomEvent('pe:fechada'));
        var destino = devolver === false ? null : peDestinoDoFoco(peGatilho);
        if (destino) { destino.focus(); }
        peGatilho = null;
    }

    /* O foco volta ao botão que abriu; se ele sumiu (item do ⋮, fechado junto), ao botão que abre o menu. */
    function peDestinoDoFoco(gatilho) {
        if (!gatilho || !document.contains(gatilho)) { return null; }
        if (gatilho.getClientRects().length) { return gatilho; }
        var menu = gatilho.closest('.ps-pop[id], [role="menu"][id]');
        var abre = menu ? document.querySelector('[data-ps-pop="' + CSS.escape(menu.id) + '"], [aria-controls="' + CSS.escape(menu.id) + '"]') : null;

        return abre && abre.getClientRects().length ? abre : null;
    }

    document.addEventListener('click', function (e) {
        var gatilho = e.target.closest('[data-pe-abrir]');
        if (gatilho) { e.preventDefault(); peAbrir(gatilho); }
    });
    modal.addEventListener('mousedown', function (e) {
        if (e.target === modal) { peFechar(); }
    });
    modal.addEventListener('click', function (e) {
        if (e.target.closest('[data-pe-fechar]')) { peFechar(); }
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) { peFechar(); }
    });
    window.psEditarDados = { abrir: peAbrir, fechar: peFechar };

    modal.addEventListener('click', function (e) {
        var gatilho = e.target.closest('.js-pe-ir');
        if (!gatilho) { return; }
        var destino = destinos[gatilho.getAttribute('data-pe-ir')];
        if (!destino) { return; }

        function seguir() {
            peFechar(false);
            destino();
        }

        if (serializar() === foto) { seguir(); return; }

        /* PAS-034b: com alteração não salva, pergunta na janela da tela (`confirmarPs`,
           pasta-dialogos.js), não no `confirm` do navegador. Sem o "sim", o modal fica como
           está, com as alterações. */
        if (!window.confirmarPs) { return; }
        window.confirmarPs({
            titulo: BJ_T.t('pasta_show.js.editar.descartar_titulo'),
            texto: BJ_T.t('pasta_show.js.editar.descartar_texto'),
            rotulo: BJ_T.t('pasta_show.js.editar.descartar'),
            icone: 'bi-x-circle'
        }).then(function (sim) {
            if (!sim) { return; }
            form.reset();
            conferir();
            seguir();
        });
    });
});
</script>

<script>
(function () {
    var btn = document.getElementById('btn-alternar-status');
    if (!btn) return;

    // A situação é a pílula à direita das abas (desenho 1.2.3): ela abre o menu das 4
    // situações, e escolher outra manda a escolhida. O item "Arquivar/Desarquivar pasta" do
    // menu ⋮ manda a situação que oferece (Arquivado, ou Ativo se a pasta está arquivada). Deu certo, a tela recarrega: o Registro ganha o cartão "Situação da pasta",
    // o carimbo é o da nova situação e, ao arquivar, o andamento chega a Finalizada.
    var emAndamento = false;

    document.querySelectorAll('.js-situacao-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
            if (emAndamento || opt.dataset.situacao === btn.dataset.situacaoAtual) { return; }
            emAndamento  = true;
            btn.disabled = true;

            var corpo = '_token=' + encodeURIComponent(btn.dataset.csrf) + '&situacao=' + encodeURIComponent(opt.dataset.situacao);
            fetch(btn.dataset.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: corpo,
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.sucesso) {
                    (window.avisarErroPs || window.alert)(data.erro || BJ_T.t('pasta_show.js.cabecalho.erro_situacao'));
                    emAndamento  = false;
                    btn.disabled = false;
                    return;
                }
                window.location.reload();
            })
            .catch(function () {
                (window.avisarErroPs || window.alert)(BJ_T.t('pasta_show.js.cabecalho.erro_comunicacao'));
                emAndamento  = false;
                btn.disabled = false;
            });
        });
    });

    /* ── Selo de prioridade (popover do cabeçalho novo) ──
       A classe do selo sai do PRÓPRIO valor escolhido, não do `badgeClass` que
       o endpoint devolve: aquele é `text-bg-*` do Bootstrap e não descreve a
       pílula do desenho (Normal cinza · Prioridade âmbar · Urgente vermelho). */
    document.querySelectorAll('.prioridade-opt').forEach(function (optBtn) {
        optBtn.addEventListener('click', async function () {
            var pop = optBtn.closest('.ps-pop-wrap');
            var tog = pop.querySelector('.pasta-prioridade-btn');
            var fd  = new FormData();
            fd.append('prioridade', optBtn.dataset.valor);
            fd.append('_token', tog.dataset.csrf);

            try {
                var res = await fetch(tog.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                if (!res.ok) { (window.avisarErroPs || window.alert)(BJ_T.t('pasta_show.js.cabecalho.erro_prioridade')); return; }

                var json = await res.json();
                tog.className = 'ps-prio ps-prio--' + optBtn.dataset.valor + ' pasta-prioridade-btn';
                tog.querySelector('.ps-prio-label').textContent = json.label;

                /* O ✓ acompanha a escolha; sem isso o popover continuaria
                   apontando a prioridade antiga na próxima abertura. */
                pop.querySelectorAll('.prioridade-opt .ps-pop-check').forEach(function (check) {
                    check.classList.add('d-none');
                });
                optBtn.querySelector('.ps-pop-check').classList.remove('d-none');

                /* Trocar fecha o popover — comportamento do desenho. */
                var painel = pop.querySelector('.ps-pop--prio');
                if (painel) { painel.classList.remove('is-aberto'); }
                tog.setAttribute('aria-expanded', 'false');
            } catch (e) {
                (window.avisarErroPs || window.alert)(BJ_T.t('pasta_show.js.cabecalho.erro_prioridade'));
            }
        });
    });
}());
</script>

