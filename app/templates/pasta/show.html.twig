   texto dentro de funções, na hora do uso. #}
{{ catalogo_js('pasta_show.js') }}
<script>
(function () {
    'use strict';

    const modal = document.getElementById('modalAdicionarCliente');
    if (!modal) return;

    const passoEscolha       = modal.querySelector('#passoEscolhaTipo');
    const formPF             = modal.querySelector('#formPF');
    const formPJ             = modal.querySelector('#formPJ');
    const campoTipo          = modal.querySelector('#campoTipoCliente');
    const footerForm         = modal.querySelector('#footerFormCliente');
    const footerEscolha      = modal.querySelector('#footerEscolhaTipo');
    const footerVincular     = modal.querySelector('#footerVincularCliente');
    const alertaErro         = modal.querySelector('#alertaErroCliente');
    const form               = modal.querySelector('#formNovoCliente');
    const btnSalvar          = footerForm.querySelector('button[type="submit"]');

    // Busca de cliente existente
    const inputBusca              = modal.querySelector('#buscaClienteExistente');
    const listaResultados         = modal.querySelector('#buscaClienteResultados');
    const spinnerBusca            = modal.querySelector('#buscaClienteSpinner');
    const chipsContainer          = modal.querySelector('#clientesSelecionadosContainer');
    const chipsWrapper            = modal.querySelector('#clientesSelecionadosChips');
    const btnConfirmarVincular    = modal.querySelector('#btnConfirmarVincular');
    const urlBuscar               = document.getElementById('urlBuscarClientes')?.value ?? '';
    const urlVincular             = document.getElementById('urlVincularCliente')?.value ?? '';
    const csrfVincular            = document.getElementById('csrfVincularCliente')?.value ?? '';
    const csrfDesvincularProcesso = '{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}';
    const clientesContainer       = document.getElementById('clientesList');

    /** @type {Array<{id: number, nome: string, documento: string, tipo: string}>} */
    let clientesSelecionados = [];
    let debounceTimer        = null;

    /* A linha nova vem PRONTA do servidor (`html` da resposta de vincular e de
       cadastrar), renderizada pelo MESMO _cliente_linha.html.twig da página —
       com o ícone de cadastro completo/incompleto e o selo "Principal", e com o
       autoescape do Twig. Antes havia aqui um espelho JS da linha, sem o ícone:
       o cliente recém-vinculado ganhava outra cara até o próximo F5. Aqui só se
       decide ONDE a linha entra. */
    function linhaDoHtml(html) {
        if (typeof html !== 'string' || html.trim() === '') {
            return null;
        }
        const molde = document.createElement('template');
        molde.innerHTML = html.trim();
        const linha = molde.content.firstElementChild;

        return linha && linha.classList.contains('cliente-linha') ? linha : null;
    }

    /* O bloco tem DOIS destinos: o principal fica fora da area que rola e os
       demais dentro dela, listados direto (auditoria 2 D2: sem "mostrar
       outros N"). Jogar tudo no #clientesList colocaria o cliente novo ao lado
       do principal, para fora da area que rola. */
    function blocoDosOutros() {
        let bloco = clientesContainer.querySelector('.clientes-outros');
        if (bloco) return bloco;

        bloco = document.createElement('div');
        // `ps-clientes-rolagem` junto: é dela que vem a altura máxima do trilho.
        // Sem a classe, o bloco criado pelo JS cresceria diferente do bloco que
        // o servidor renderiza. O id é o mesmo do Twig.
        bloco.className = 'clientes-outros ps-clientes-rolagem';
        bloco.id = 'clientesOutros';

        clientesContainer.appendChild(bloco);
        return bloco;
    }

    /* A contagem do cabeçalho do cartão (o servidor só a imprime com 1+). */
    function atualizarContagemClientes(total) {
        if (typeof total !== 'number') {
            return;
        }
        const cab = clientesContainer.closest('[data-trilho="clientes"]')?.querySelector('.ps-card-cab');
        if (!cab) {
            return;
        }
        let badge = cab.querySelector('.ps-contagem');
        if (total <= 0) {
            badge?.remove();
            return;
        }
        if (!badge) {
            badge = document.createElement('span');
            badge.className = 'ps-contagem';
            const titulo = cab.querySelector('h2');
            if (titulo) {
                titulo.after(badge);
            } else {
                cab.prepend(badge);
            }
        }
        badge.textContent = String(total);
    }

    /**
     * Insere a linha que o servidor devolveu. Devolve false quando não há linha
     * utilizável — quem chamou mostra a mensagem (ou recarrega), e nada entra.
     *
     * @param {string} html linha de _cliente_linha.html.twig
     * @param {object|undefined} principal estado devolvido pelo servidor após o vínculo
     * @param {number|undefined} total quantos clientes a pasta tem agora
     */
    function appendClienteRow(html, principal, total) {
        if (!clientesContainer) {
            return false;
        }
        const linha = linhaDoHtml(html);
        if (!linha) {
            return false;
        }

        const placeholder = clientesContainer.querySelector('#clientesPlaceholder');
        if (placeholder) {
            placeholder.remove();
        }

        // A mesma linha já na tela (duplo clique, resposta repetida): troca, não duplica.
        const clienteId = String(linha.dataset.clienteId ?? '');
        clientesContainer.querySelectorAll('.cliente-linha').forEach((existente) => {
            if (String(existente.dataset.clienteId ?? '') === clienteId) {
                existente.remove();
            }
        });

        const ehPrincipal = !!principal && String(principal.clienteId ?? '') === clienteId;
        let blocoPrincipal = clientesContainer.querySelector('.cliente-principal');

        if (ehPrincipal) {
            // Primeiro cliente da pasta (Pasta::addCliente) — ou pasta cujo principal não
            // estava gravado: o vínculo grava o novo, e quem estava no topo desce para os outros.
            if (blocoPrincipal) {
                Array.from(blocoPrincipal.querySelectorAll('.cliente-linha')).reverse().forEach((anterior) => {
                    anterior.querySelector('.ps-selo-principal')?.remove();
                    blocoDosOutros().prepend(anterior);
                });
            } else {
                blocoPrincipal = document.createElement('div');
                blocoPrincipal.className = 'cliente-principal';
                clientesContainer.prepend(blocoPrincipal);
            }
            blocoPrincipal.appendChild(linha);
        } else {
            blocoDosOutros().appendChild(linha);
        }

        // Vincular pode MOVER o principal automático: a estrela e a Média por CPF seguem o
        // estado que o servidor devolveu. Sem isto a tela mostraria o número do cliente
        // anterior até alguém dar F5.
        if (principal) {
            trocaClientePrincipal(principal);
        }
        atualizarContagemClientes(total);

        return true;
    }

    /* A busca inline do cartão (public/js/pasta-clientes-busca.js) vincula e
       entrega a resposta aqui, para a linha entrar pelo MESMO caminho do modal.
       preventDefault() é o "recebido": sem ele a busca recarrega a página. */
    document.addEventListener('pasta:cliente-vinculado', (event) => {
        const dados = event.detail || {};
        if (appendClienteRow(dados.html, dados.principal, dados.total)) {
            event.preventDefault();
        }
    });

    function removeClienteRow(clienteId, form = null) {
        if (!clientesContainer) {
            return;
        }

        let row = null;
        if (clienteId) {
            row = clientesContainer.querySelector(`.cliente-linha[data-cliente-id="${clienteId}"]`);
        }
        if (!row && form) {
            row = form.closest('.cliente-linha');
        }

        if (row) {
            row.remove();
        }
        // Bloco que ficou sem linha sai, como o Twig, que só o imprime com cliente dentro.
        clientesContainer.querySelectorAll('.cliente-principal, .clientes-outros').forEach((bloco) => {
            if (!bloco.querySelector('.cliente-linha')) {
                bloco.remove();
            }
        });

        const restantes = clientesContainer.querySelectorAll('.cliente-linha').length;
        atualizarContagemClientes(restantes);
        if (restantes === 0 && !clientesContainer.querySelector('#clientesPlaceholder')) {
            clientesContainer.appendChild(montaPlaceholderClientes());
        }
    }

    /* O vazio do cartão com a MESMA marcação do _dados_trilho.html.twig (os dois estados:
       o identificador em texto solto da pasta, quando existe, ou o "Nenhum cliente
       vinculado"). Montado por nós (textContent), nunca por string com dado do usuário. */
    function montaPlaceholderClientes() {
        const nomeSolto = clientesContainer.dataset.nomeCliente ?? '';
        const div = document.createElement('div');
        div.id = 'clientesPlaceholder';
        const icone = document.createElement('i');
        icone.className = 'bi bi-person-circle';

        if (nomeSolto !== '') {
            div.className = 'ps-cliente';
            icone.style.color = 'var(--ps-faint)';
            const nome = document.createElement('span');
            nome.className = 'ps-cliente-nome flex-grow-1';
            nome.textContent = nomeSolto;
            const selo = document.createElement('span');
            selo.className = 'ps-selo ps-selo--tranquilo';
            selo.textContent = BJ_T.t('pasta_show.js.cliente.nao_vinculado');
            div.append(icone, nome, selo);
            return div;
        }

        div.className = 'ps-vazio';
        const titulo = document.createElement('div');
        titulo.className = 'ps-vazio-titulo';
        titulo.textContent = BJ_T.t('pasta_show.js.cliente.nenhum_vinculado');
        const nota = document.createElement('div');
        nota.className = 'ps-vazio-nota';
        nota.textContent = BJ_T.t('pasta_show.js.cliente.vincule_para_media');
        div.append(icone, titulo, nota);
        return div;
    }


    function mostrarErro(msg) {
        alertaErro.textContent = msg;
        alertaErro.classList.remove('d-none');
        alertaErro.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function ocultarErro() {
        alertaErro.classList.add('d-none');
        alertaErro.textContent = '';
    }

    function mostrar(tipo) {
        ocultarErro();
        passoEscolha.classList.add('d-none');
        footerEscolha.style.setProperty('display', 'none', 'important');
        footerForm.style.removeProperty('display');

        // O `disabled` anda junto com o `d-none`: esconder sem desabilitar deixa os campos
        // repetidos do outro bloco sendo validados pelo navegador e enviados no FormData.
        // Habilitar ANTES do Tab.show() — botão de aba dentro de fieldset desabilitado não ativa.
        const ativo    = tipo === 'pf' ? formPF : formPJ;
        const inativo  = tipo === 'pf' ? formPJ : formPF;
        const primeira = tipo === 'pf' ? '#pf-dados-tab' : '#pj-empresa-tab';

        ativo.disabled = false;
        ativo.classList.remove('d-none');
        inativo.disabled = true;
        inativo.classList.add('d-none');
        campoTipo.value = tipo === 'pf' ? 'pf' : 'pj';

        bootstrap.Tab.getOrCreateInstance(modal.querySelector(primeira)).show();
    }

    function voltar() {
        ocultarErro();
        formPF.disabled = true;
        formPF.classList.add('d-none');
        formPJ.disabled = true;
        formPJ.classList.add('d-none');
        passoEscolha.classList.remove('d-none');
        footerForm.style.setProperty('display', 'none', 'important');
        footerEscolha.style.removeProperty('display');
        campoTipo.value = '';
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        ocultarErro();

        btnSalvar.disabled = true;
        const icone = btnSalvar.querySelector('i');
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        // O bloco inativo já está `disabled` desde mostrar()/voltar() — nada a desabilitar aqui.
        // Fazer isso no submit era tarde demais: a validação nativa do navegador roda ANTES deste
        // handler, e o `finally` devolvia o bloco escondido para o ar depois de cada erro do
        // servidor. A partir da segunda tentativa o navegador barrava o envio por causa do e-mail
        // de um formulário que o usuário não estava preenchendo.

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });

            if (!resp.ok) {
                let msgErro = BJ_T.t('pasta_show.js.cliente.erro_salvar');
                try {
                    const dados = await resp.json();
                    msgErro = dados.erro ?? msgErro;
                } catch (_) { /* resposta não é JSON */ }
                mostrarErro(msgErro);
                return;
            }

            const dados = await resp.json();
            if (dados.sucesso && appendClienteRow(dados.html, dados.principal, dados.total)) {
                bootstrap.Modal.getInstance(modal)?.hide();
                return;
            }

            mostrarErro(BJ_T.t('pasta_show.js.cliente.salvo_sem_lista'));
        } catch (err) {
            mostrarErro(BJ_T.t('pasta_show.js.cliente.erro_comunicacao'));
            console.error('[formNovoCliente]', err);
        } finally {
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check-lg me-1';
        }
    });

    // — Busca de cliente existente —

    function atualizarEstadoFooter() {
        if (clientesSelecionados.length > 0) {
            footerVincular.classList.remove('d-none');
            footerEscolha.classList.add('d-none');
            const label = clientesSelecionados.length === 1
                ? BJ_T.t('pasta_show.js.cliente.vincular_um')
                : BJ_T.t('pasta_show.js.cliente.vincular_varios', {n: clientesSelecionados.length});
            btnConfirmarVincular.querySelector('span.btn-label') && (btnConfirmarVincular.querySelector('span.btn-label').textContent = label);
        } else {
            footerVincular.classList.add('d-none');
            footerEscolha.classList.remove('d-none');
        }
    }

    function criarChip(cliente) {
        const chip = document.createElement('span');
        chip.className = 'badge d-inline-flex align-items-center gap-1 ps-2 pe-1 py-1 rounded-pill border';
        chip.style.cssText = 'background:#e9f5ff; color:#0d6efd; border-color:#9ecbf5 !important; font-size:.78rem; font-weight:500;';
        chip.innerHTML = `
            <i class="bi ${cliente.tipo === 'PF' ? 'bi-person' : 'bi-building'} me-1"></i>
            ${escHtml(cliente.nome)}
            <button type="button" class="btn-close btn-close-sm ms-1" style="font-size:.55rem;" title="${escHtml(BJ_T.t('pasta_show.js.cliente.remover'))}" aria-label="${escHtml(BJ_T.t('pasta_show.js.cliente.remover_nome', {nome: cliente.nome}))}"></button>`;
        chip.querySelector('.btn-close').addEventListener('click', () => removerSelecionado(cliente.id));
        return chip;
    }

    function escHtml(str) {
        return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function selecionarCliente(id, nome, documento, tipo) {
        if (clientesSelecionados.some(c => c.id === id)) {
            listaResultados.classList.add('d-none');
            inputBusca.value = '';
            return;
        }

        clientesSelecionados.push({ id, nome, documento, tipo });
        chipsWrapper.appendChild(criarChip({ id, nome, documento, tipo }));
        chipsContainer.classList.remove('d-none');
        listaResultados.classList.add('d-none');
        inputBusca.value = '';
        atualizarEstadoFooter();
    }

    function removerSelecionado(id) {
        clientesSelecionados = clientesSelecionados.filter(c => c.id !== id);
        chipsWrapper.innerHTML = '';
        clientesSelecionados.forEach(c => chipsWrapper.appendChild(criarChip(c)));
        if (clientesSelecionados.length === 0) {
            chipsContainer.classList.add('d-none');
        }
        atualizarEstadoFooter();
    }

    function limparSelecao() {
        clientesSelecionados = [];
        chipsWrapper.innerHTML = '';
        chipsContainer.classList.add('d-none');
        footerVincular.classList.add('d-none');
        footerEscolha.classList.remove('d-none');
    }

    async function executarBusca(termo) {
        if (termo.length < 2) {
            listaResultados.classList.add('d-none');
            return;
        }

        spinnerBusca.classList.remove('d-none');
        try {
            const resp = await fetch(urlBuscar + '?q=' + encodeURIComponent(termo), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });
            if (!resp.ok) return;

            const dados = await resp.json();
            listaResultados.innerHTML = '';

            if (dados.length === 0) {
                listaResultados.innerHTML = '<li class="list-group-item text-muted small py-2">' + escHtml(BJ_T.t('pasta_show.js.cliente.nenhum_encontrado')) + '</li>';
            } else {
                dados.forEach(c => {
                    const jaSelecionado = clientesSelecionados.some(s => s.id === c.id);
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-2';
                    li.style.cursor = jaSelecionado ? 'default' : 'pointer';
                    if (jaSelecionado) li.classList.add('opacity-50');
                    li.innerHTML = `
                        <i class="bi ${c.tipo === 'PF' ? 'bi-person' : 'bi-building'} text-primary flex-shrink-0"></i>
                        <div class="overflow-hidden flex-fill">
                            <div class="fw-semibold text-truncate small">${escHtml(c.nome)}</div>
                            <div class="text-muted" style="font-size:.72rem;">${escHtml(c.documento)} · ${c.tipo}</div>
                        </div>
                        <i class="bi ${jaSelecionado ? 'bi-check-circle-fill text-success' : 'bi-plus-circle text-success'} flex-shrink-0"></i>`;
                    if (!jaSelecionado) {
                        li.addEventListener('click', () => selecionarCliente(c.id, c.nome, c.documento, c.tipo));
                    }
                    listaResultados.appendChild(li);
                });
            }

            listaResultados.classList.remove('d-none');
        } catch (_) {
            /* silencioso */
        } finally {
            spinnerBusca.classList.add('d-none');
        }
    }

    inputBusca.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => executarBusca(inputBusca.value.trim()), 300);
    });

    inputBusca.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            listaResultados.classList.add('d-none');
        }
    });

    document.addEventListener('click', e => {
        if (!listaResultados.contains(e.target) && e.target !== inputBusca) {
            listaResultados.classList.add('d-none');
        }
    });

    /**
     * Move a estrela para o cliente escolhido e atualiza a Média por CPF na aba Financeiro.
     *
     * A média é atualizada aqui de propósito: a marcação existe PARA mudar esse número, e deixá-lo
     * defasado na tela esconderia o efeito da própria ação que o usuário acabou de fazer.
     */
    /**
     * Monta a estrela de UMA linha, nos dois estados que o Twig também renderiza. Existe para que
     * a linha criada por JS (ao vincular um cliente) nasça idêntica à renderizada pelo servidor —
     * antes ela nascia SEM estrela, e o cliente recém-vinculado só podia ser marcado após um F5.
     *
     * @param {string} clienteId
     * @param {boolean} ehPrincipal
     * @param {string} tokenMarcar token CSRF de marcar ESTE cliente
     */
    function montaEstrelaPrincipal(clienteId, ehPrincipal, tokenMarcar) {
        if (ehPrincipal) {
            const marca = document.createElement('span');
            marca.className = 'btn btn-xs btn-primary disabled js-cliente-principal-estrela';
            marca.dataset.clienteId = clienteId;
            marca.title = BJ_T.t('pasta_show.js.cliente.principal_dica');
            marca.innerHTML = '<i class="bi bi-star-fill"></i>';
            return marca;
        }

        const form = document.createElement('form');
        form.method = 'post';
        form.action = '{{ path('pasta_cliente_principal', {id: pasta.id, cliente: '__CLIENTE__'}) }}'.replace('__CLIENTE__', clienteId);
        form.className = 'js-ajax-cliente-principal m-0';
        form.innerHTML = '<input type="hidden" name="_token" value="' + tokenMarcar + '">'
            + '<button type="submit" class="btn btn-xs btn-outline-secondary"'
            + ' title="' + escHtml(BJ_T.t('pasta_show.js.cliente.tornar_principal')) + '"><i class="bi bi-star"></i></button>';
        return form;
    }

    /**
     * Depois de desvincular o principal: troca a linha do promovido pela que o servidor
     * re-renderizou e deixa o trocaClientePrincipal mover a linha e acertar a média.
     */
    function aplicarNovoPrincipal(dados) {
        const novoId = String(dados.novoPrincipalId);
        const atual  = clientesContainer?.querySelector(`.cliente-linha[data-cliente-id="${novoId}"]`);
        const nova   = dados.html ? linhaDoHtml(dados.html) : null;
        if (atual && nova && String(nova.dataset.clienteId ?? '') === novoId) {
            atual.replaceWith(nova);
        }
        trocaClientePrincipal(dados.principal);
    }

    function trocaClientePrincipal(dados) {
        const novoId = String(dados.clienteId ?? '');

        let linhaNova = null;
        document.querySelectorAll('#clientesList .cliente-linha').forEach((linha) => {
            const clienteId = String(linha.dataset.clienteId ?? '');
            const ehNovo = clienteId === novoId;
            if (ehNovo) {
                linhaNova = linha;
            }

            // O selo "Principal" anda junto com a estrela (o Twig o põe no fim de .cliente-nome).
            const nome = linha.querySelector('.cliente-nome');
            const selo = nome?.querySelector('.ps-selo-principal');
            if (ehNovo && nome && !selo) {
                const novoSelo = document.createElement('span');
                novoSelo.className = 'ps-selo-principal';
                novoSelo.textContent = BJ_T.t('pasta_show.js.cliente.principal');
                nome.appendChild(novoSelo);
            } else if (!ehNovo && selo) {
                selo.remove();
            }

            const acoes = linha.querySelector('.js-cliente-acoes');
            if (!acoes) {
                return;
            }
            const atual = acoes.querySelector('form.js-ajax-cliente-principal, .js-cliente-principal-estrela');
            if (!atual) {
                return;
            }

            atual.replaceWith(montaEstrelaPrincipal(clienteId, ehNovo, linha.dataset.tokenPrincipal ?? ''));
        });

        // E a linha vai para o bloco do principal (fora da rolagem), como no próximo F5;
        // quem estava lá desce para o topo dos outros.
        if (clientesContainer && linhaNova && !linhaNova.closest('.cliente-principal')) {
            let blocoPrincipal = clientesContainer.querySelector('.cliente-principal');
            if (blocoPrincipal) {
                Array.from(blocoPrincipal.querySelectorAll('.cliente-linha')).reverse().forEach((anterior) => {
                    blocoDosOutros().prepend(anterior);
                });
            } else {
                blocoPrincipal = document.createElement('div');
                blocoPrincipal.className = 'cliente-principal';
                clientesContainer.prepend(blocoPrincipal);
            }
            blocoPrincipal.appendChild(linhaNova);
            const outros = clientesContainer.querySelector('.clientes-outros');
            if (outros && !outros.querySelector('.cliente-linha')) {
                outros.remove();
            }
        }

        const media = document.getElementById('financeiro-media-cpf');
        if (media && dados.mediaFormatada) {
            media.textContent = dados.mediaFormatada;
        }
        // O rotulo e a nota tem id proprio desde a fatia 2 do redesenho. Antes
        // eram encontrados subindo ate `.col-md-2`, a coluna do grid Bootstrap
        // que a faixa de quatro cards nao tem mais: a busca devolvia null e os
        // dois textos ficavam defasados em silencio ao trocar o principal.
        const rotulo = document.getElementById('financeiro-media-rotulo');
        if (rotulo && dados.mediaRotulo) {
            rotulo.textContent = dados.mediaRotulo;
        }
        const nota = document.getElementById('financeiro-media-nota');
        if (nota && dados.clienteNome) {
            nota.textContent = dados.clienteNome;
        }
    }

    document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) {
            return;
        }

        if (form.matches('form.js-ajax-desvincular-cliente')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    (window.avisarErroPs || window.alert)(dados.erro ?? BJ_T.t('pasta_show.js.cliente.erro_desvincular'));
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    removeClienteRow(dados.clienteId ?? '', form);
                    // Saiu o PRINCIPAL: o servidor promoveu outro e diz qual. A linha dele
                    // volta re-renderizada (selo e estrela cheia, pelo mesmo partial), e o
                    // trocaClientePrincipal a leva ao bloco do principal e atualiza a Média por CPF.
                    if (dados.novoPrincipalId && dados.principal) {
                        aplicarNovoPrincipal(dados);
                    }
                    return;
                }

                (window.avisarErroPs || window.alert)(dados.erro ?? BJ_T.t('pasta_show.js.cliente.erro_desvincular'));
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }


        if (form.matches('form.js-ajax-cliente-principal')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                const dados = await resp.json().catch(() => ({}));
                if (!resp.ok || !dados.sucesso) {
                    (window.avisarErroPs || window.alert)(dados.erro ?? BJ_T.t('pasta_show.js.cliente.erro_principal'));
                    return;
                }

                trocaClientePrincipal(dados);
                return;
            } catch (err) {
                // Sem este catch, queda de rede reabilitava o botão em silêncio e o usuário
                // achava que tinha marcado. A rejeição não tratada não aparece na tela.
                console.error('[clientePrincipal]', err);
                (window.avisarErroPs || window.alert)(BJ_T.t('pasta_show.js.cliente.erro_comunicacao_marcacao'));
                return;
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-desvincular-processo')) {
            event.preventDefault();
            // Texto do desenho (procMenu, dc L.2932) vem no `data-confirmar` do form, com o
            // número do processo e a pasta; o genérico só se o atributo faltar. E7: na janela da
            // tela, vermelha como no dc (`confirmarUI(…, true)`, L.3031) — o envio já foi segurado acima.
            const perguntaDesv = form.dataset.confirmar || BJ_T.t('pasta_show.js.processo.desvincular_pergunta');
            const desvincular = window.confirmarUIPs ? await window.confirmarUIPs(perguntaDesv, true) : confirm(perguntaDesv);
            if (!desvincular) {
                return;
            }
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    (window.avisarErroPs || window.alert)(dados.erro ?? BJ_T.t('pasta_show.js.processo.erro_desvincular'));
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    window.mpSwapProcessos(dados.html);
                    return;
                }

                (window.avisarErroPs || window.alert)(dados.erro ?? BJ_T.t('pasta_show.js.processo.erro_desvincular'));
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-processo-principal')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                const dados = await resp.json().catch(() => ({}));
                if (resp.ok && dados.sucesso) {
                    window.mpSwapProcessos(dados.html);
                    return;
                }

                (window.avisarErroPs || window.alert)(dados.erro ?? BJ_T.t('pasta_show.js.processo.erro_principal'));
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

    });

    btnConfirmarVincular.addEventListener('click', async () => {
        if (clientesSelecionados.length === 0) return;

        btnConfirmarVincular.disabled = true;
        const icone = btnConfirmarVincular.querySelector('i');
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        const erros = [];
        const vinculados = [];

        for (const cliente of clientesSelecionados) {
            try {
                const body = new FormData();
                body.append('cliente_id', String(cliente.id));
                body.append('_token', csrfVincular);

                const resp = await fetch(urlVincular, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body,
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    erros.push(dados.erro ?? BJ_T.t('pasta_show.js.cliente.erro_vincular', {nome: cliente.nome}));
                    continue;
                }

                const dados = await resp.json();
                if (dados.sucesso && appendClienteRow(dados.html, dados.principal, dados.total)) {
                    vinculados.push(cliente.id);
                } else {
                    erros.push(BJ_T.t('pasta_show.js.cliente.vinculado_sem_lista', {nome: cliente.nome}));
                }
            } catch (_) {
                erros.push(BJ_T.t('pasta_show.js.cliente.erro_comunicacao_vincular', {nome: cliente.nome}));
            }
        }

        btnConfirmarVincular.disabled = false;
        if (icone) icone.className = 'bi bi-link-45deg me-1';

        if (erros.length > 0) {
            mostrarErro(erros.join(' '));
        }

        if (vinculados.length > 0 && erros.length === 0) {
            bootstrap.Modal.getInstance(modal)?.hide();
        } else if (vinculados.length > 0) {
            // Remove os que foram vinculados com sucesso, mantém os que deram erro
            vinculados.forEach(id => removerSelecionado(id));
        }
    });

    // — Fim busca de cliente existente —

    modal.querySelector('#btnEscolherPF').addEventListener('click', () => mostrar('pf'));
    modal.querySelector('#btnEscolherPJ').addEventListener('click', () => mostrar('pj'));
    modal.querySelector('#btnVoltarPF').addEventListener('click', voltar);
    modal.querySelector('#btnVoltarPJ').addEventListener('click', voltar);

    modal.addEventListener('hidden.bs.modal', () => { voltar(); limparSelecao(); });
}());
</script>

{# Janela "Vincular processo": a do desenho 02 de 18/10 (N:289-354, estados `pvVals` N:3135-3151), não o modal
   do Bootstrap. Sobreposição própria (N:290), caixa de min(860px, 100%) (N:291), cabeçalho (N:292), corpo (N:293)
   e rodapé (N:351). Abre pelos botões `[data-vp-abrir]`; fecha no X, no Cancelar, no clique fora e no Esc. #}
<div class="vp-sobre" id="modalVincularProcesso" hidden data-tribunais="{{ (tribunaisCnj ?? {})|json_encode|e('html_attr') }}">
        <div class="vp-caixa" role="dialog" aria-modal="true" aria-labelledby="modalVincularProcessoLabel">
            <div class="vp-cab">
                <i class="bi bi-briefcase" aria-hidden="true"></i>
                <b class="vp-titulo" id="modalVincularProcessoLabel"><span id="mp-titulo-texto">{{ 'pasta_show.processo.vincular'|trans }}</span></b>
                {# Desenho N:292: X branco num quadrado translúcido. #}
                <button type="button" class="mp-fechar" data-vp-fechar aria-label="{{ 'pasta_show.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            {# novalidate: os obrigatórios são conferidos no clique ("Preencha: ...", desenho `procSalvarVinc`), sem o
               balão do navegador; o servidor confere de novo. #}
            <form method="POST" id="formVincularProcesso" class="vp-form" novalidate
                  action="{{ path('pasta_vincular_processo', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('vincular_processo_' ~ pasta.id) }}">
                {# P4f: o mesmo modal vincula APENSADO (`modo=apenso`); pasta-apensado.js troca o modo pelo
                   botão que abriu e mostra o "Tipo de apenso" (desenho N:294, padrão Embargos). #}
                <input type="hidden" name="modo" id="mp-modo" value="principal">
                <div class="vp-corpo">
                    <label class="mp-apenso-tipo" id="mp-apenso-tipo" hidden>
                        <span class="mp-apenso-tipo-rotulo">{{ 'pasta_show.processo.tipo_apenso'|trans }} <span class="mp-apenso-obrig">*</span></span>
                        <select name="tipo_apenso" id="mp-tipoApenso" class="mp-apenso-select" disabled>
                            {% for tipoApenso in enum_cases('App\\Pasta\\Entity\\TipoDeApenso') %}
                                <option value="{{ tipoApenso.value }}"{{ loop.first ? ' selected' : '' }}>{{ tipoApenso.rotulo }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    {# Seletor de modo: buscar processo existente x cadastrar novo via CNJ (N:295, `tabSt` N:3136) #}
                    <div class="mp-abas" role="tablist" aria-label="{{ 'pasta_show.processo.modo_rotulo'|trans }}">
                        <button type="button" class="mp-aba is-ativa" id="mp-modo-existente" data-vp-modo="existente" role="tab" aria-selected="true"><i class="bi bi-search"></i>{{ 'pasta_show.processo.buscar_existente'|trans }}</button>
                        <button type="button" class="mp-aba" id="mp-modo-novo" data-vp-modo="novo" role="tab" aria-selected="false"><i class="bi bi-plus-lg"></i>{{ 'pasta_show.processo.cadastrar_novo'|trans }}</button>
                    </div>

                    {# MODO: buscar processo já cadastrado (N:296-304). A lista abre ao focar, com até 8 processos do
                       escritório, e filtra enquanto se digita; o escolhido vai no `processo_id`. #}
                    <div id="modal-modo-existente" class="mp-campo mp-busca">
                        <label for="mp-busca-input" class="mp-rotulo">{{ 'pasta_show.processo.ja_cadastrado'|trans }} <span class="mp-obrig">*</span></label>
                        <input type="hidden" id="mp-processoExistente" name="processo_id" value="">
                        <div class="mp-busca-sel" id="mp-busca-sel" hidden>
                            <i class="bi bi-check2-circle"></i>
                            <span class="mp-busca-sel-txt" id="mp-busca-sel-txt"></span>
                            <button type="button" class="mp-busca-trocar" id="mp-busca-trocar" title="{{ 'pasta_show.processo.trocar'|trans }}" aria-label="{{ 'pasta_show.processo.trocar'|trans }}"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="mp-busca-caixa">
                            <input type="text" id="mp-busca-input" class="mp-ctrl mp-busca-input" autocomplete="off"
                                   placeholder="{{ 'pasta_show.processo.busca_placeholder'|trans }}"
                                   role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="mp-busca-lista">
                            <i class="bi bi-caret-down-fill mp-busca-seta" aria-hidden="true"></i>
                            <div class="mp-busca-lista" id="mp-busca-lista" role="listbox" hidden></div>
                        </div>
                        <span class="mp-dica-busca">{{ 'pasta_show.processo.busque_dica'|trans }}</span>
                    </div>

                    {# MODO: cadastrar novo processo via CNJ (N:306-345) #}
                    <div id="modal-modo-novo" class="mp-novo" hidden>

                    {# Sub-abas do formulário de processo (N:306, `subSt` N:3137) #}
                    <div class="processo-modal-tabs" role="tablist">
                        <button type="button" class="processo-modal-tab active" data-modal-tab="modal-proc-info" role="tab" aria-selected="true">
                            <i class="bi bi-info-circle"></i> {{ 'pasta_show.processo.aba_informacoes'|trans }}
                        </button>
                        <button type="button" class="processo-modal-tab" data-modal-tab="modal-proc-partes" role="tab" aria-selected="false">
                            <i class="bi bi-people"></i> {{ 'pasta_show.processo.aba_partes'|trans }}
                        </button>
                        <button type="button" class="processo-modal-tab" data-modal-tab="modal-proc-movimentacoes" role="tab" aria-selected="false">
                            <i class="bi bi-clock-history"></i> {{ 'pasta_show.processo.aba_movimentacoes'|trans }}
                        </button>
                    </div>

                    {# ABA: Informações (N:307-327): grade de 6 colunas #}
