<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Preview de documento ── */
    const previewModal     = document.getElementById('previewDocModal');
    const previewConteudo  = document.getElementById('previewDocConteudo');
    const previewNome      = document.getElementById('previewDocNome');
    const previewDownload  = document.getElementById('previewDocDownload');

    previewModal.addEventListener('show.bs.modal', function (e) {
        const btn      = e.relatedTarget;
        const url      = btn.dataset.url;
        const nome     = btn.dataset.nome;
        const mime     = btn.dataset.mime;
        const urlDl    = btn.dataset.download || url.replace('/visualizar', '/download');

        previewNome.textContent = nome;
        previewDownload.href = urlDl;
        previewConteudo.innerHTML = '';

        if (mime === 'application/pdf') {
            previewConteudo.innerHTML =
                `<iframe src="${url}" class="w-100 border-0" style="height:75vh;" title="${nome}"></iframe>`;
        } else if (mime.startsWith('image/')) {
            previewConteudo.innerHTML =
                `<img src="${url}" class="img-fluid d-block mx-auto p-3" style="max-height:75vh;object-fit:contain;" alt="${nome}">`;
        } else if (mime.startsWith('audio/')) {
            previewConteudo.innerHTML =
                `<div class="p-4 text-center w-100">
                    <i class="bi bi-file-earmark-music display-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-3">${nome}</p>
                    <audio controls class="w-100" style="max-width:500px;">
                        <source src="${url}" type="${mime}">
                        Seu navegador não suporta reprodução de áudio.
                    </audio>
                 </div>`;
        } else if (mime.startsWith('video/')) {
            previewConteudo.innerHTML =
                `<video controls class="w-100 d-block" style="max-height:75vh;">
                    <source src="${url}" type="${mime}">
                    Seu navegador não suporta reprodução de vídeo.
                 </video>`;
        } else {
            previewConteudo.innerHTML =
                `<div class="p-5 text-center text-muted w-100">
                    <i class="bi bi-file-earmark display-1 d-block mb-3"></i>
                    <p>Pré-visualização não disponível para este tipo de arquivo.</p>
                    <a href="${url.replace('/visualizar', '/download')}" class="btn btn-primary">
                        <i class="bi bi-download me-1"></i> Baixar arquivo
                    </a>
                 </div>`;
        }
    });

    previewModal.addEventListener('hide.bs.modal', function () {
        previewConteudo.innerHTML = '';
    });

    /* ── Tooltips ── */
    var tooltipEls = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });

    function attachCopyButtons() {
        document.querySelectorAll('.copy-btn').forEach(function (btn) {
            if (btn.dataset.copyAttached) {
                return;
            }

            btn.addEventListener('click', function () {
                const text = this.getAttribute('data-copy');
                navigator.clipboard.writeText(text).then(() => {
                    this.classList.replace('bi-copy', 'bi-check-lg');
                    this.classList.add('copied');
                    setTimeout(() => {
                        this.classList.replace('bi-check-lg', 'bi-copy');
                        this.classList.remove('copied');
                    }, 1500);
                });
            });

            btn.dataset.copyAttached = '1';
        });
    }

    attachCopyButtons();

    /* ── Anexos ── */
    const documentTypeOptions = {{ documentTypeOptions|json_encode|raw }};

    const btnAdicionar   = document.getElementById('btnAdicionarAnexo');
    const inputOculto    = document.getElementById('inputAnexoOculto');
    const listaAnexos    = document.getElementById('listaAnexos');
    const areaEnviar     = document.getElementById('areaEnviar');

    // Contador global para índices únicos
    let indiceGlobal = 0;

    function formatarTamanho(bytes) {
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    function buildSelectOpcoes() {
        let html = '<option value="">Selecione o tipo</option>';
        for (const [valor, texto] of Object.entries(documentTypeOptions)) {
            html += `<option value="${valor}">${texto}</option>`;
        }
        return html;
    }

    function adicionarItem(file) {
        const idx = indiceGlobal++;
        const div = document.createElement('div');
        div.className = 'anexo-item';
        div.dataset.idx = idx;
        div._file = file; // arquivo associado diretamente ao elemento

        div.innerHTML = `
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-file-earmark-text fs-4 text-primary flex-shrink-0 mt-1"></i>

                <div class="flex-grow-1 min-w-0">
                    <div class="anexo-nome text-truncate">${file.name}</div>
                    <div class="anexo-tamanho mb-2">${formatarTamanho(file.size)}</div>

                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-sm-5 col-lg-4">
                            <label class="form-label form-label-sm mb-1">Tipo de documento</label>
                            <select name="categorias[${idx}]" class="form-select form-select-sm" required>
                                ${buildSelectOpcoes()}
                            </select>
                        </div>
                        <div class="col-12 col-sm-7 col-lg-5">
                            <label class="form-label form-label-sm mb-1">Descrição</label>
                            <input type="text" name="descricoes[${idx}]" class="form-control form-control-sm"
                                   placeholder="Descrição (opcional)" maxlength="500">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-3">
                            <label class="form-label form-label-sm mb-1">Número <span class="text-muted fw-normal">(opcional)</span></label>
                            <input type="text" name="numeros[${idx}]" class="form-control form-control-sm"
                                   placeholder="Número" maxlength="255">
                        </div>
                    </div>
                </div>

                <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0 mt-1 btn-remover-anexo"
                        title="Remover">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;

        div.querySelector('.btn-remover-anexo').addEventListener('click', function () {
            div.remove();
            atualizarVisibilidade();
        });

        listaAnexos.appendChild(div);
    }

    const btnLimpar = document.getElementById('btnLimparAnexos');

    function atualizarVisibilidade() {
        const temItens = listaAnexos.children.length > 0;
        areaEnviar.classList.toggle('d-none', !temItens);
        btnLimpar.classList.toggle('d-none', !temItens);
    }

    btnLimpar.addEventListener('click', function () {
        listaAnexos.innerHTML = '';
        inputOculto.value = '';
        atualizarVisibilidade();
    });

    btnAdicionar.addEventListener('click', function () {
        inputOculto.value = '';
        inputOculto.click();
    });

    inputOculto.addEventListener('change', function () {
        Array.from(this.files).forEach(function (file) {
            adicionarItem(file);
        });
        atualizarVisibilidade();
    });

    // No submit: reindexar campos e reconstruir FileList a partir dos elementos
    document.getElementById('formAnexos').addEventListener('submit', function (e) {
        const itens = Array.from(listaAnexos.querySelectorAll('.anexo-item'));

        if (itens.length === 0) {
            e.preventDefault();
            return;
        }

        // Reindexar campos de metadados para 0,1,2... na ordem atual da lista
        itens.forEach(function (item, novoIdx) {
            const oldIdx = parseInt(item.dataset.idx, 10);
            ['categorias', 'descricoes', 'numeros'].forEach(function (campo) {
                const el = item.querySelector(`[name^="${campo}["]`);
                if (el) el.name = `${campo}[${novoIdx}]`;
            });
        });

        // Reconstruir FileList com os arquivos na mesma ordem
        const dt = new DataTransfer();
        itens.forEach(function (item) {
            if (item._file) dt.items.add(item._file);
        });

        inputOculto.name = 'arquivos[]';
        inputOculto.files = dt.files;
    });

    /* ── Upload inline de documentos do cliente ── */
    const docTypesCliente = {{ documentTypeOptionsCliente|json_encode|raw }};

    function buildSelectCliente(idx) {
        let html = '<option value="">Tipo</option>';
        for (const [v, t] of Object.entries(docTypesCliente)) {
            html += `<option value="${v}">${t}</option>`;
        }
        return `<select name="categorias[${idx}]" class="form-select form-select-sm" required>${html}</select>`;
    }

    document.querySelectorAll('.form-upload-cliente-inline').forEach(function (form) {
        const cid      = form.dataset.clienteId;
        const input    = document.getElementById(`fileInputCliente${cid}`);
        const lista    = document.getElementById(`listaUploadCliente${cid}`);
        const btnEsc   = form.querySelector('.btn-escolher-arquivo-cliente');
        const btnEnv   = form.querySelector('.btn-enviar-cliente');
        const btnCan   = form.querySelector('.btn-cancelar-cliente');

        if (!input || !lista || !btnEsc) return;

        let fileIdx = 0;

        function atualizar() {
            const tem = lista.querySelectorAll('.upload-item-cliente').length > 0;
            btnEnv.classList.toggle('d-none', !tem);
            btnCan.classList.toggle('d-none', !tem);
        }

        function adicionarArquivo(file) {
            const i = fileIdx++;
            const div = document.createElement('div');
            div.className = 'upload-item-cliente border rounded p-2 mb-2 small';
            div._file = file;
            div.dataset.idx = i;
            div.innerHTML = `
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-file-earmark-text text-primary flex-shrink-0"></i>
                    <span class="text-truncate flex-grow-1 fw-semibold">${file.name}</span>
                    <span class="text-muted text-nowrap">${formatarTamanho(file.size)}</span>
                    <button type="button" class="btn btn-xs btn-outline-danger btn-rm-upload flex-shrink-0">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <div class="row g-1">
                    <div class="col-12 col-sm-5">${buildSelectCliente(i)}</div>
                    <div class="col-12 col-sm-7">
                        <input type="text" name="descricoes[${i}]" class="form-control form-control-sm"
                               placeholder="Descrição (opcional)" maxlength="500">
                    </div>
                </div>`;
            div.querySelector('.btn-rm-upload').addEventListener('click', function () {
                div.remove();
                atualizar();
            });
            lista.appendChild(div);
        }

        btnEsc.addEventListener('click', function () { input.value = ''; input.click(); });

        input.addEventListener('change', function () {
            Array.from(this.files).forEach(adicionarArquivo);
            atualizar();
        });

        btnCan.addEventListener('click', function () {
            lista.innerHTML = '';
            input.value = '';
            atualizar();
        });

        form.addEventListener('submit', function (e) {
            const itens = Array.from(lista.querySelectorAll('.upload-item-cliente'));
            if (itens.length === 0) { e.preventDefault(); return; }
            itens.forEach(function (item, novoIdx) {
                ['categorias', 'descricoes'].forEach(function (campo) {
                    const el = item.querySelector(`[name^="${campo}["]`);
                    if (el) el.name = `${campo}[${novoIdx}]`;
                });
            });
            const dt = new DataTransfer();
            itens.forEach(function (item) { if (item._file) dt.items.add(item._file); });
            input.name = 'arquivos[]';
            input.files = dt.files;
        });
    });
});

/* ── Timeline: envio AJAX de mensagem ──────────────────── */
(function () {
    const form        = document.getElementById('formTimelineMensagem');
    const textarea    = document.getElementById('timelineConteudo');
    const btnEnviar   = document.getElementById('btnEnviarMensagem');
    const erroDiv     = document.getElementById('timelineMensagemErro');
    const list        = document.getElementById('timelineList');
    const countBadge  = document.getElementById('timeline-count');
    const vazioMsg    = document.getElementById('timelineVazio');
    const urlEnviar   = '{{ path("pasta_enviar_mensagem", {id: pasta.id}) }}';

    if (!form) { return; }

    textarea.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            form.requestSubmit();
        }
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const conteudo = textarea.value.trim();
        if (conteudo === '') {
            mostrarErro('A mensagem não pode ser vazia.');
            return;
        }

        btnEnviar.disabled = true;
        btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Enviando…';
        esconderErro();

        try {
            const resp = await fetch(urlEnviar, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });

            const data = await resp.json();

            if (!resp.ok) {
                mostrarErro(data.erro ?? 'Erro ao enviar mensagem.');
                return;
            }

            inserirMensagem(data);
            textarea.value = '';
            if (vazioMsg) { vazioMsg.remove(); }
            if (countBadge) {
                countBadge.textContent = parseInt(countBadge.textContent || '0', 10) + 1;
            }
        } catch (_) {
            mostrarErro('Erro de rede. Tente novamente.');
        } finally {
            btnEnviar.disabled = false;
            btnEnviar.innerHTML = '<i class="bi bi-send me-1"></i> Enviar';
        }
    });

    function inserirMensagem(data) {
        const dt   = new Date(data.criadaEmTs);
        const hora = dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const corpo = esc(data.conteudo).replace(/\n/g, '<br>');

        const html = `
        <div class="d-flex gap-2 mb-2 timeline-entry timeline-entry--mensagem timeline-entry--new">
            <div class="flex-shrink-0 pt-1">
                <span class="badge rounded-circle timeline-icon text-bg-info">
                    <i class="bi bi-chat-left-text"></i>
                </span>
            </div>
            <div class="flex-grow-1 timeline-item-body timeline-item-body--mensagem" style="min-width:0">
                <div class="d-flex justify-content-between align-items-start gap-1 flex-wrap">
                    <span class="fw-semibold small lh-sm">Mensagem</span>
                    <small class="text-muted flex-shrink-0 lh-sm">
                        <i class="bi bi-clock me-1"></i>${hora}
                    </small>
                </div>
                <div class="lh-sm">
                    <small class="text-muted">
                        <i class="bi bi-person me-1"></i>${esc(data.autorNome ?? '')}
                    </small>
                </div>
                <div class="mt-1 small text-body">${corpo}</div>
            </div>
        </div>`;

        list.insertAdjacentHTML('afterbegin', html);
        list.scrollTop = 0;
    }

    function mostrarErro(msg) {
        erroDiv.textContent = msg;
        erroDiv.classList.remove('d-none');
    }

    function esconderErro() {
        erroDiv.classList.add('d-none');
    }

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
}());
</script>

<style>
.processo-modal-tabs {
    border-bottom: 3px solid #1a6fa3;
    background: #fff;
    margin-bottom: 0;
}
.processo-modal-tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    padding: 8px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #888;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    outline: none;
}
.processo-modal-tab:hover { color: #1a6fa3; }
.processo-modal-tab.active { color: #1a6fa3; border-bottom-color: #1a6fa3; }
.processo-modal-tab-content { display: none; }
.processo-modal-tab-content.active { display: block; }
</style>

<script>
(function () {
    /* ── Abas do modal de processo ── */
    document.querySelectorAll('.processo-modal-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.processo-modal-tab').forEach(function (t) { t.classList.remove('active'); });
            document.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.remove('active'); });
            tab.classList.add('active');
            var painel = document.getElementById('tab-' + tab.dataset.modalTab);
            if (painel) painel.classList.add('active');
        });
    });

    /* ── Select2 para tribunal no modal ── */
    var modalEl = document.getElementById('modalVincularProcesso');
    modalEl.addEventListener('shown.bs.modal', function () {
        if (window.$ && $.fn.select2) {
            $('#mp-siglaTribunal').select2({
                width: '100%',
                placeholder: 'Selecione um tribunal',
                dropdownParent: $('#modalVincularProcesso'),
                language: { noResults: function () { return 'Nenhum tribunal encontrado'; } }
            });
        }
    });

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function renderProcessoTab(processo) {
        var partesHtml = '';
        if (processo.partes && processo.partes.length > 0) {
            partesHtml = '<hr>' +
                '<h6 class="mb-3"><i class="bi bi-people me-1"></i> Partes do Processo</h6>' +
                '<div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Tipo</th><th>Papel</th><th>Documento</th></tr></thead><tbody>';
            processo.partes.forEach(function (parte) {
                partesHtml += '<tr><td>' + escapeHtml(parte.nome) + '</td>' +
                    '<td>' + escapeHtml(parte.tipo || '—') + '</td>' +
                    '<td>' + escapeHtml(parte.papel || '—') + '</td>' +
                    '<td>' + escapeHtml(parte.documento || '—') + '</td></tr>';
            });
            partesHtml += '</tbody></table></div>';
        }

        var dataDistribuicaoHtml = '';
        if (processo.dataDistribuicao) {
            dataDistribuicaoHtml = '<div class="col-12 col-sm-6 col-lg-4">' +
                '<p class="text-muted small mb-1">Data de Distribuição</p>' +
                '<b>' + escapeHtml(processo.dataDistribuicao) + '</b>' +
                '</div>';
        }

        return '<div class="row g-3">' +
            '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Número do Processo</p><b>' + escapeHtml(processo.numeroProcesso) + ' <i class="bi bi-copy text-primary copy-btn ms-1" role="button" data-copy="' + escapeHtml(processo.numeroProcesso) + '" title="Copiar"></i></b></div>' +
            (processo.classeProcessual ? '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Classe Processual</p><b>' + escapeHtml(processo.classeProcessual) + '</b></div>' : '') +
            (processo.assuntoProcessual ? '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Assunto</p><b>' + escapeHtml(processo.assuntoProcessual) + '</b></div>' : '') +
            (processo.orgaoJulgador ? '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Órgão Julgador</p><b>' + escapeHtml(processo.orgaoJulgador) + '</b></div>' : '') +
            (processo.siglaTribunal ? '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Tribunal</p><b>' + escapeHtml(processo.siglaTribunal) + '</b></div>' : '') +
            (processo.instancia ? '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Instância</p><b>' + escapeHtml(processo.instancia) + '</b></div>' : '') +
            (processo.situacaoProcesso ? '<div class="col-12 col-sm-6 col-lg-4"><p class="text-muted small mb-1">Situação</p><b>' + escapeHtml(processo.situacaoProcesso) + '</b></div>' : '') +
            dataDistribuicaoHtml +
            '</div>' + partesHtml +
            '<div class="mt-3 d-flex align-items-center gap-2">' +
            '<a href="/processos/' + escapeHtml(processo.id) + '" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-up-right me-1"></i> Ver processo completo</a>' +
            '<form method="post" action="/pasta/' + escapeHtml(pastaId) + '/processo/desvincular" class="js-ajax-desvincular-processo m-0">' +
            '<input type="hidden" name="_token" value="' + escapeHtml(csrfDesvincularProcesso) + '">' +
            '<button type="submit" class="btn btn-sm btn-outline-danger" title="Desvincular processo da pasta"><i class="bi bi-trash"></i></button>' +
            '</form>' +
            '</div>';
    }

    /* ── Submit via AJAX ── */
    document.getElementById('formVincularProcesso').addEventListener('submit', async function (e) {
        e.preventDefault();
        var feedbackEl = document.getElementById('mp-feedbackAlerta');
        var btnSalvar  = this.querySelector('button[type="submit"]');
        var icone      = btnSalvar.querySelector('i');

        feedbackEl.className = 'd-none mt-3';
        feedbackEl.innerHTML = '';
        btnSalvar.disabled = true;
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        try {
            var resp = await fetch(this.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(this),
            });
            var dados = await resp.json();

            if (!resp.ok) {
                feedbackEl.className = 'alert alert-danger mt-3';
                feedbackEl.textContent = dados.erro ?? 'Erro ao vincular processo.';
                return;
            }

            if (dados.sucesso && dados.processo) {
                var content = document.getElementById('processoTabContent');
                if (content) {
                    content.innerHTML = renderProcessoTab(dados.processo);
                    attachCopyButtons();
                }
                bootstrap.Modal.getInstance(modalEl)?.hide();
                return;
            }

            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Processo vinculado, mas não foi possível atualizar o conteúdo.';
        } catch (_) {
            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Erro de comunicação. Tente novamente.';
        } finally {
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check-lg me-1';
        }
    });

    /* ── Fechar modal limpa o formulário ── */
    modalEl.addEventListener('hidden.bs.modal', function () {
        document.getElementById('formVincularProcesso').reset();
        var partesContainer = document.getElementById('mp-partesContainer');
        partesContainer.innerHTML = mpParteRowHtml(0);
        var movContainer = document.getElementById('mp-movimentacoesContainer');
        movContainer.innerHTML = mpMovRowHtml(0);
        mpUpdateRemoveButtons();
        document.getElementById('mp-feedbackAlerta').className = 'd-none mt-3';
        document.getElementById('mp-feedbackAlerta').innerHTML = '';
        document.querySelectorAll('.processo-modal-tab').forEach(function (t) { t.classList.remove('active'); });
        document.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.remove('active'); });
        document.querySelector('.processo-modal-tab[data-modal-tab="modal-proc-info"]').classList.add('active');
        document.getElementById('tab-modal-proc-info').classList.add('active');
        if (window.$ && $.fn.select2) {
            $('#mp-siglaTribunal').val('tjdft').trigger('change');
        }
    });

    /* ── Templates de linha ── */
    function mpParteRowHtml(idx) {
        return `<div class="mp-parte-row card mb-2 p-3" style="position: relative;">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <select name="partes[${idx}][tipo]" class="form-select">
                        <option value="PARTE">Parte</option>
                        <option value="ADVOGADO">Advogado</option>
                        <option value="JUIZ">Juiz</option>
                        <option value="PROMOTOR">Promotor</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nome</label>
                    <input type="text" name="partes[${idx}][nome]" class="form-control" placeholder="Nome da parte">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Documento</label>
                    <input type="text" name="partes[${idx}][documento]" class="form-control" placeholder="CPF/CNPJ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Papel</label>
                    <input type="text" name="partes[${idx}][papel]" class="form-control" placeholder="Polo ativo/passivo">
                </div>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm mp-remove-parte"
                    style="display: none; position: absolute; top: 8px; right: 12px;"
                    title="Remover"><i class="bi bi-trash"></i></button>
        </div>`;
    }

    function mpMovRowHtml(idx) {
        return `<div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Data</label>
                    <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Descrição</label>
                    <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control" placeholder="Descrição da movimentação">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control" placeholder="Tipo de movimento">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Órgão</label>
                    <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control" placeholder="Órgão">
                </div>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                    style="display: none; position: absolute; top: 8px; right: 12px;"
                    title="Remover"><i class="bi bi-trash"></i></button>
        </div>`;
    }

    /* ── Adicionar / remover partes ── */
    document.getElementById('mp-btn-add-parte').addEventListener('click', function () {
        var container = document.getElementById('mp-partesContainer');
        var idx = container.querySelectorAll('.mp-parte-row').length;
        container.insertAdjacentHTML('beforeend', mpParteRowHtml(idx));
        mpAttachRemovePartes();
    });

    function mpAttachRemovePartes() {
        document.querySelectorAll('#mp-partesContainer .mp-remove-parte').forEach(function (btn) {
            btn.onclick = function () { btn.closest('.mp-parte-row').remove(); mpUpdateRemoveButtons(); };
        });
        mpUpdateRemoveButtons();
    }

    /* ── Adicionar / remover movimentações ── */
    document.getElementById('mp-btn-add-movimentacao').addEventListener('click', function () {
        var container = document.getElementById('mp-movimentacoesContainer');
        var idx = container.querySelectorAll('.mp-movimentacao-row').length;
        container.insertAdjacentHTML('beforeend', mpMovRowHtml(idx));
        mpAttachRemoveMovimentacoes();
    });

    function mpAttachRemoveMovimentacoes() {
        document.querySelectorAll('#mp-movimentacoesContainer .mp-remove-movimentacao').forEach(function (btn) {
            btn.onclick = function () { btn.closest('.mp-movimentacao-row').remove(); mpUpdateRemoveButtons(); };
        });
        mpUpdateRemoveButtons();
    }

    function mpUpdateRemoveButtons() {
        var partes = document.querySelectorAll('#mp-partesContainer .mp-parte-row').length;
        document.querySelectorAll('#mp-partesContainer .mp-remove-parte').forEach(function (btn) {
            btn.style.display = partes > 1 ? 'block' : 'none';
        });
        var movs = document.querySelectorAll('#mp-movimentacoesContainer .mp-movimentacao-row').length;
        document.querySelectorAll('#mp-movimentacoesContainer .mp-remove-movimentacao').forEach(function (btn) {
            btn.style.display = movs > 1 ? 'block' : 'none';
        });
    }

    /* ── Busca DataJud ── */
    document.getElementById('mp-btn-datajud').addEventListener('click', async function () {
        var numeroProcesso = document.getElementById('mp-numeroProcesso').value;
        var siglaTribunal  = document.getElementById('mp-siglaTribunal').value;
        var feedbackEl     = document.getElementById('mp-feedbackAlerta');
        var loadingEl      = document.getElementById('mp-loadingOverlay');

        feedbackEl.className = 'd-none mt-3';
        feedbackEl.innerHTML = '';

        if (!numeroProcesso) {
            feedbackEl.className = 'alert alert-warning mt-3';
            feedbackEl.textContent = 'Informe o número do processo.';
            return;
        }
        if (!siglaTribunal) {
            feedbackEl.className = 'alert alert-warning mt-3';
            feedbackEl.textContent = 'Informe a sigla do tribunal.';
            return;
        }

        loadingEl.classList.remove('d-none');
        try {
            var response = await fetch('{{ path("api_datajud_search") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ numeroProcesso: numeroProcesso, tribunalAlias: siglaTribunal.toLowerCase() })
            });
            var data = await response.json();
            loadingEl.classList.add('d-none');

            if (!response.ok || !data.success) {
                feedbackEl.className = 'alert alert-danger mt-3';
                feedbackEl.textContent = data.error || 'Erro ao buscar processo no CNJ/DataJud.';
                return;
            }

            var pd = data.data;
            document.getElementById('mp-orgaoJulgador').value     = pd.orgaoJulgador     || '';
            document.getElementById('mp-classeProcessual').value  = pd.classeProcessual  || '';
            document.getElementById('mp-assuntoProcessual').value = pd.assuntoProcessual || '';
            document.getElementById('mp-situacaoProcesso').value  = pd.situacaoProcesso  || 'EM_ANDAMENTO';
            document.getElementById('mp-instancia').value         = pd.instancia         || 'G1';
            document.getElementById('mp-dataDistribuicao').value  = pd.dataDistribuicao  || '';

            var partesContainer = document.getElementById('mp-partesContainer');
            partesContainer.innerHTML = '';
            var partesList = (pd.partes && pd.partes.length > 0) ? pd.partes : [{}];
            partesList.forEach(function (parte, idx) {
                partesContainer.insertAdjacentHTML('beforeend', `<div class="mp-parte-row card mb-2 p-3" style="position: relative;">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label">Tipo</label>
                            <select name="partes[${idx}][tipo]" class="form-select">
                                <option value="PARTE" ${(parte.tipo||'')==='PARTE'?'selected':''}>Parte</option>
                                <option value="ADVOGADO" ${(parte.tipo||'')==='ADVOGADO'?'selected':''}>Advogado</option>
                                <option value="JUIZ" ${(parte.tipo||'')==='JUIZ'?'selected':''}>Juiz</option>
                                <option value="PROMOTOR" ${(parte.tipo||'')==='PROMOTOR'?'selected':''}>Promotor</option>
                            </select></div>
                        <div class="col-md-5"><label class="form-label">Nome</label>
                            <input type="text" name="partes[${idx}][nome]" class="form-control" value="${parte.nome||''}" placeholder="Nome da parte"></div>
                        <div class="col-md-2"><label class="form-label">Documento</label>
                            <input type="text" name="partes[${idx}][documento]" class="form-control" value="${parte.documento||''}" placeholder="CPF/CNPJ"></div>
                        <div class="col-md-2"><label class="form-label">Papel</label>
                            <input type="text" name="partes[${idx}][papel]" class="form-control" value="${parte.papel||''}" placeholder="Polo ativo/passivo"></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mp-remove-parte"
                            style="display: ${partesList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                            title="Remover"><i class="bi bi-trash"></i></button>
                </div>`);
            });

            var movContainer = document.getElementById('mp-movimentacoesContainer');
            movContainer.innerHTML = '';
            var movsList = (pd.movimentacoes && pd.movimentacoes.length > 0) ? pd.movimentacoes : [{}];
            movsList.forEach(function (mov, idx) {
                movContainer.insertAdjacentHTML('beforeend', `<div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label">Data</label>
                            <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control" value="${mov.dataMovimentacao||''}"></div>
                        <div class="col-md-4"><label class="form-label">Descrição</label>
                            <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control" value="${mov.descricao||''}" placeholder="Descrição da movimentação"></div>
                        <div class="col-md-3"><label class="form-label">Tipo</label>
                            <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control" value="${mov.tipo||''}" placeholder="Tipo de movimento"></div>
                        <div class="col-md-2"><label class="form-label">Órgão</label>
                            <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control" value="${mov.orgao||''}" placeholder="Órgão"></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                            style="display: ${movsList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                            title="Remover"><i class="bi bi-trash"></i></button>
                </div>`);
            });

            mpAttachRemovePartes();
            mpAttachRemoveMovimentacoes();

            feedbackEl.className = 'alert alert-success mt-3';
            feedbackEl.textContent = 'Processo carregado com sucesso! Verifique os dados antes de salvar.';

        } catch (e) {
            loadingEl.classList.add('d-none');
            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Erro ao buscar processo no CNJ/DataJud. Tente novamente em instantes.';
        }
    });

    mpAttachRemovePartes();
    mpAttachRemoveMovimentacoes();
}());
</script>

