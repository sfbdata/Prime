                        <div class="ps-nm-resp-campo" role="button" tabindex="0"
                             aria-labelledby="tarefaResponsavelRotulo" aria-haspopup="listbox"
                             aria-expanded="false" aria-controls="tarefaResponsavelLista" data-ps-nm-resp-campo>
                            <span class="ps-nm-resp-chips" data-ps-nm-resp-chips></span>
                            <span class="ps-nm-resp-vazio" data-ps-nm-resp-vazio><i class="bi bi-person-plus" aria-hidden="true"></i>Selecionar responsáveis</span>
                            <span class="ps-nm-rotulo-espaco"></span>
                            <i class="bi bi-chevron-down ps-nm-resp-seta" aria-hidden="true"></i>
                        </div>
