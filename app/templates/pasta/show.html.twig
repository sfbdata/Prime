                    <i class="bi bi-person-plus me-1"></i> {{ 'pasta_show.cliente.titulo'|trans }}
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form id="formNovoCliente" method="post" action="{{ path('pasta_cliente_novo', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_novo_' ~ pasta.id) }}">
                <input type="hidden" name="tipo" id="campoTipoCliente" value="">
                <input type="hidden" id="urlBuscarClientes" value="{{ path('pasta_clientes_buscar', {id: pasta.id}) }}">
                <input type="hidden" id="urlVincularCliente" value="{{ path('pasta_cliente_vincular', {id: pasta.id}) }}">
                <input type="hidden" id="csrfVincularCliente" value="{{ csrf_token('pasta_cliente_vincular_' ~ pasta.id) }}">

