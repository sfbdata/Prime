                    <button type="submit" id="btnEnviarTarefa" class="ps-modal-meta-btn ps-modal-meta-btn--criar"
                            title="{{ 'pasta_show.meta.criar_dica'|trans }}">
                        <i class="bi bi-send" aria-hidden="true"></i>{{ 'pasta_show.meta.criar'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('formCriarTarefa');
    if (!form) return;
    // O rótulo do desenho volta depois de um erro (o "Enviando…" o substitui durante o envio).
    // O texto vem do catálogo na hora do uso (o script roda antes do bj-traducao.js) e entra como texto.
    function rotular(btn, html, texto) {
        btn.innerHTML = html;
        btn.appendChild(document.createTextNode(texto));
    }
    var ICONE_CRIAR = '<i class="bi bi-send" aria-hidden="true"></i>';

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        var btn = document.getElementById('btnEnviarTarefa');
        var erroBox = document.getElementById('tarefaErroMsg');
        btn.disabled = true;
        rotular(btn, '<span class="spinner-border spinner-border-sm me-1"></span>', BJ_T.t('pasta_show.js.meta.enviando'));
        erroBox.classList.add('d-none');

        var data = new FormData(form);
        // Análise do prazo: envia a origem, o jurídico e a confirmação (/js/pasta-meta-analise-prazo.js).
        if (window.PastaMetaAnalisePrazo) { window.PastaMetaAnalisePrazo.acrescentar(data); }

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: data,
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, status: r.status, data: d }; }); })
        .then(function (res) {
            if (res.data.sucesso) {
                // PMC-044: fica na pasta, aba Metas, com a meta nova realçada (destino do servidor).
                window.location.href = res.data.destino;
            } else {
                erroBox.textContent = res.data.erro || res.data.mensagem || BJ_T.t('pasta_show.js.meta.erro_criar');
                erroBox.classList.remove('d-none');
                btn.disabled = false;
                rotular(btn, ICONE_CRIAR, BJ_T.t('pasta_show.js.meta.criar'));
                if (res.status === 422 && res.data.codigo === 'analise_do_prazo' && window.PastaMetaAnalisePrazo) { window.PastaMetaAnalisePrazo.abrirParaConferir(); }
            }
        })
        .catch(function () {
            erroBox.textContent = BJ_T.t('pasta_show.js.erro_comunicacao_tente');
            erroBox.classList.remove('d-none');
            btn.disabled = false;
            rotular(btn, ICONE_CRIAR, BJ_T.t('pasta_show.js.meta.criar'));
        });
    });
}());
</script>
