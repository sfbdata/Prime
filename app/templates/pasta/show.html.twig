{# Modais: Editar Documento do Cliente #}
{% for cliente in pasta.clientes %}
    {% for item in clientesComDocumentos %}
        {% if item.cliente.id == cliente.id %}
            {% for tipo, docs in item.documentosPorTipo %}
                {% for doc in docs %}
                    {% set label = documentTypeOptionsCliente[tipo] ?? tipo %}
                    <div class="modal fade" id="editDocClienteModal{{ doc.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="post" action="{{ path('cliente_documento_edit', {id: doc.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('edit_doc_cliente_' ~ doc.id) }}">
                                    <div class="modal-header">
                                        <h5 class="modal-title"><i class="bi bi-pencil me-1"></i> Editar documento</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="text-muted small mb-3"><i class="bi bi-file-earmark me-1"></i>{{ doc.nomeOriginal }}</p>
                                        <div class="mb-3">
                                            <label class="form-label">Tipo de documento</label>
                                            <select name="categoria" class="form-select" required>
                                                {% for valor, texto in documentTypeOptionsCliente %}
                                                    <option value="{{ valor }}" {{ doc.categoria == valor ? 'selected' : '' }}>{{ texto }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Descrição</label>
                                            <input type="text" name="descricao" class="form-control"
                                                   value="{{ doc.descricao ?? '' }}" maxlength="500" placeholder="Descrição (opcional)">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Número (opcional)</label>
                                            <input type="text" name="numero" class="form-control"
                                                   value="{{ doc.numero ?? '' }}" maxlength="255" placeholder="Número">
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-check-lg me-1"></i> Salvar
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        {% endif %}
    {% endfor %}
{% endfor %}

