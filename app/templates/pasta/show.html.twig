{# ── Upload por arquivo com barra de progresso (compartilhado: drag-drop + seção) ── #}
<script>
    const URL_UPLOAD_PECA  = {{ path('pasta_peticionar_upload', {id: pasta.id})|json_encode|raw }};
    const CSRF_UPLOAD_PECA = {{ csrf_token('peticionar_upload_' ~ pasta.id)|json_encode|raw }};

    function formatBytesPeca(b) {
        if (!b || b <= 0) return '0 B';
        if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
        return (b / 1024 / 1024).toFixed(2) + ' MB';
    }

    // Envia 1 arquivo via XHR, reportando progresso de upload e fase de compressão.
    window.enviarArquivoComProgresso = function (file, opts) {
        return new Promise(function (resolve, reject) {
            const fd = new FormData();
            fd.append('arquivo', file);
            fd.append('_token', opts.csrf);
            fd.append('categoria', opts.categoria || '');
            fd.append('descricao', opts.descricao || '');
            fd.append('numero', opts.numero || '');
            if (opts.secaoId) fd.append('secao_id', opts.secaoId);
            fd.append('reduzir_tamanho', opts.reduzir ? '1' : '0');

            const xhr = new XMLHttpRequest();
            xhr.open('POST', opts.url);
            xhr.upload.addEventListener('progress', function (ev) {
                if (ev.lengthComputable && typeof opts.onProgress === 'function') {
                    opts.onProgress(Math.round((ev.loaded / ev.total) * 100));
                }
            });
            xhr.upload.addEventListener('load', function () {
                if (typeof opts.onComprimindo === 'function') opts.onComprimindo();
            });
            xhr.addEventListener('load', function () {
                let data = null;
                try { data = JSON.parse(xhr.responseText); } catch (_) {}
                if (xhr.status >= 200 && xhr.status < 300 && data && data.success) {
                    resolve(data);
                } else {
                    reject(new Error((data && data.error) ? data.error : 'Erro ao enviar o arquivo.'));
                }
            });
            xhr.addEventListener('error', function () { reject(new Error('Erro de comunicação.')); });
            xhr.send(fd);
        });
    };

    // Processa um item .anexo-item: lê os campos, mostra a barra e devolve true/false.
    window.processarItemUploadPeca = function (item, secaoId, reduzir) {
        const file      = item._file;
        const categoria = (item.querySelector('[name^="categorias"]') || {}).value || '';
        const descricao = (item.querySelector('[name^="descricoes"]') || {}).value || '';
        const numero    = (item.querySelector('[name^="numeros"]') || {}).value || '';

        const campos = item.querySelector('.anexo-campos');
        const btnRm  = item.querySelector('.btn-remover-anexo');
        const prog   = item.querySelector('.anexo-progresso');
        const bar    = prog.querySelector('.progress-bar');
        const status = prog.querySelector('.anexo-status');

        if (campos) campos.classList.add('d-none');
        if (btnRm)  btnRm.classList.add('d-none');
        prog.classList.remove('d-none');
        bar.className = 'progress-bar';
        bar.style.width = '0%';

        return window.enviarArquivoComProgresso(file, {
            url: URL_UPLOAD_PECA,
            csrf: CSRF_UPLOAD_PECA,
            categoria: categoria,
            descricao: descricao,
            numero: numero,
            secaoId: secaoId,
            reduzir: reduzir,
            onProgress: function (pct) {
                bar.style.width = pct + '%';
                status.textContent = 'Enviando… ' + pct + '%';
            },
            onComprimindo: function () {
                bar.style.width = '100%';
                status.textContent = reduzir ? 'Comprimindo…' : 'Processando…';
            }
        }).then(function (data) {
            const c = data.compressao;
            bar.style.width = '100%';
            if (c && c.comprimido) {
                bar.classList.add('bg-success');
                status.className = 'anexo-status text-success d-block mt-1';
                status.textContent = 'Reduzido de ' + formatBytesPeca(c.tamanhoOriginal)
                    + ' para ' + formatBytesPeca(c.tamanhoFinal) + '.'
                    + (c.eraAssinado ? ' Atenção: PDF assinado — a assinatura pode ter sido invalidada.' : '');
            } else if (reduzir) {
                bar.classList.add('bg-warning');
                status.className = 'anexo-status text-warning-emphasis d-block mt-1';
                status.textContent = 'Não foi possível reduzir — enviado no tamanho original.';
            } else {
                bar.classList.add('bg-success');
                status.className = 'anexo-status text-success d-block mt-1';
                status.textContent = 'Enviado.';
            }
            item.dataset.enviado = '1';
            return true;
        }).catch(function (err) {
            bar.style.width = '100%';
            bar.classList.add('bg-danger');
            status.className = 'anexo-status text-danger d-block mt-1';
            status.textContent = '✗ ' + err.message;
            return false;
        });
    };
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Preview de documento ── */
    const previewModal     = document.getElementById('previewDocModal');
    const previewConteudo  = document.getElementById('previewDocConteudo');
    const previewNome      = document.getElementById('previewDocNome');
    const previewDownload  = document.getElementById('previewDocDownload');

    previewModal.addEventListener('show.bs.modal', function (e) {
        const btn      = e.relatedTarget;
        const url      = btn.dataset.url;
        const nome     = btn.dataset.nome;
        const mime     = btn.dataset.mime;
        const urlDl    = btn.dataset.download || url.replace('/visualizar', '/download');

        previewNome.textContent = nome;
        previewDownload.href = urlDl;
        previewConteudo.innerHTML = '';

        if (mime === 'application/pdf') {
            previewConteudo.innerHTML =
                `<iframe src="${url}" class="w-100 border-0" style="height:75vh;" title="${nome}"></iframe>`;
        } else if (mime.startsWith('image/')) {
            previewConteudo.innerHTML =
                `<img src="${url}" class="img-fluid d-block mx-auto p-3" style="max-height:75vh;object-fit:contain;" alt="${nome}">`;
        } else if (mime.startsWith('audio/')) {
            previewConteudo.innerHTML =
                `<div class="p-4 text-center w-100">
                    <i class="bi bi-file-earmark-music display-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-3">${nome}</p>
                    <audio controls class="w-100" style="max-width:500px;">
                        <source src="${url}" type="${mime}">
                        Seu navegador não suporta reprodução de áudio.
                    </audio>
                 </div>`;
        } else if (mime.startsWith('video/')) {
            previewConteudo.innerHTML =
                `<video controls class="w-100 d-block" style="max-height:75vh;">
                    <source src="${url}" type="${mime}">
                    Seu navegador não suporta reprodução de vídeo.
                 </video>`;
        } else {
            previewConteudo.innerHTML =
                `<div class="p-5 text-center text-muted w-100">
                    <i class="bi bi-file-earmark display-1 d-block mb-3"></i>
                    <p>Pré-visualização não disponível para este tipo de arquivo.</p>
                    <a href="${url.replace('/visualizar', '/download')}" class="btn btn-primary">
                        <i class="bi bi-download me-1"></i> Baixar arquivo
                    </a>
                 </div>`;
        }
    });

    previewModal.addEventListener('hide.bs.modal', function () {
        previewConteudo.innerHTML = '';
    });

    /* ── Tooltips ── */
    var tooltipEls = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });

    function attachCopyButtons() {
        document.querySelectorAll('.copy-btn').forEach(function (btn) {
            if (btn.dataset.copyAttached) {
                return;
            }

            btn.addEventListener('click', function () {
                const text = this.getAttribute('data-copy');
                navigator.clipboard.writeText(text).then(() => {
                    this.classList.replace('bi-copy', 'bi-check-lg');
                    this.classList.add('copied');
                    setTimeout(() => {
                        this.classList.replace('bi-check-lg', 'bi-copy');
                        this.classList.remove('copied');
                    }, 1500);
                });
            });

            btn.dataset.copyAttached = '1';
        });
    }

    // Exposta no escopo global para reuso por outros blocos <script> (ex.: render in-place do modal de processo).
    window.attachCopyButtons = attachCopyButtons;

    // Troca a lista de processos vinculados in-place (sem recarregar a página nem
    // sair da aba Processo). Usada por vincular/desvincular/tornar principal.
    window.mpSwapProcessos = function (html) {
        var content = document.getElementById('processoTabContent');
        if (content && typeof html === 'string') {
            content.innerHTML = html;
            attachCopyButtons();
        }
    };

    attachCopyButtons();

    /* ── Anexos ── */
    const documentTypeOptions = {{ documentTypeOptions|json_encode|raw }};

    const btnAdicionar   = document.getElementById('btnAdicionarAnexo');
    const inputOculto    = document.getElementById('inputAnexoOculto');
    const listaAnexos    = document.getElementById('listaAnexos');
    const areaEnviar     = document.getElementById('areaEnviar');

    // Contador global para índices únicos
    let indiceGlobal = 0;

    function formatarTamanho(bytes) {
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    // Upload geral migrado para a aba "Documentos"; opera só se o markup antigo existir.
    if (btnAdicionar) {

    function buildSelectOpcoes() {
        let html = '<option value="">Selecione o tipo</option>';
        for (const [valor, texto] of Object.entries(documentTypeOptions)) {
            html += `<option value="${valor}"${valor === 'DEMAIS' ? ' selected' : ''}>${texto}</option>`;
        }
        return html;
    }

    function adicionarItem(file) {
        const idx = indiceGlobal++;
        const div = document.createElement('div');
        div.className = 'anexo-item';
        div.dataset.idx = idx;
        div._file = file; // arquivo associado diretamente ao elemento

        div.innerHTML = `
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-file-earmark-text fs-4 text-primary flex-shrink-0 mt-1"></i>

                <div class="flex-grow-1 min-w-0">
                    <div class="anexo-nome text-truncate">${file.name}</div>
                    <div class="anexo-tamanho mb-2">${formatarTamanho(file.size)}</div>

                    <div class="row g-2 align-items-end anexo-campos">
                        <div class="col-12 col-sm-5 col-lg-4">
                            <label class="form-label form-label-sm mb-1">Tipo de documento</label>
                            <select name="categorias[${idx}]" class="form-select form-select-sm" required>
                                ${buildSelectOpcoes()}
                            </select>
                        </div>
                        <div class="col-12 col-sm-7 col-lg-5">
                            <label class="form-label form-label-sm mb-1">Descrição</label>
                            <input type="text" name="descricoes[${idx}]" class="form-control form-control-sm"
                                   placeholder="Descrição (opcional)" maxlength="500">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-3">
                            <label class="form-label form-label-sm mb-1">Número <span class="text-muted fw-normal">(opcional)</span></label>
                            <input type="text" name="numeros[${idx}]" class="form-control form-control-sm"
                                   placeholder="Número" maxlength="255">
                        </div>
                    </div>

                    <div class="anexo-progresso d-none mt-2">
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar" role="progressbar" style="width:0%"></div>
                        </div>
                        <small class="anexo-status text-muted d-block mt-1"></small>
                    </div>
                </div>

                <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0 mt-1 btn-remover-anexo"
                        title="Remover">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;

        div.querySelector('.btn-remover-anexo').addEventListener('click', function () {
            div.remove();
            atualizarVisibilidade();
        });

        listaAnexos.appendChild(div);
    }

    const btnLimpar = document.getElementById('btnLimparAnexos');

    function atualizarVisibilidade() {
        const temItens = listaAnexos.children.length > 0;
        areaEnviar.classList.toggle('d-none', !temItens);
        btnLimpar.classList.toggle('d-none', !temItens);
    }

    btnLimpar.addEventListener('click', function () {
        listaAnexos.innerHTML = '';
        inputOculto.value = '';
        atualizarVisibilidade();
    });

    btnAdicionar.addEventListener('click', function () {
        inputOculto.value = '';
        inputOculto.click();
    });

    inputOculto.addEventListener('change', function () {
        Array.from(this.files).forEach(function (file) {
            adicionarItem(file);
        });
        atualizarVisibilidade();
    });

    // No submit: envia 1 arquivo por vez via AJAX, com barra de progresso por arquivo.
    document.getElementById('formAnexos').addEventListener('submit', async function (e) {
        e.preventDefault();

        const itens = Array.from(listaAnexos.querySelectorAll('.anexo-item'))
            .filter(function (it) { return it.dataset.enviado !== '1'; });
        if (itens.length === 0) return;

        const reduzir   = (document.getElementById('reduzirTamanhoGeral') || {}).checked || false;
        const btnEnviar = this.querySelector('button[type="submit"]');
        const aviso     = this.querySelector('.upload-lote-aviso');
        if (aviso) aviso.remove();
        if (btnEnviar) btnEnviar.disabled = true;
        btnAdicionar.disabled = true;
        btnLimpar.disabled = true;

        let ok = 0, falhas = 0;
        for (const item of itens) {
            const sucesso = await window.processarItemUploadPeca(item, null, reduzir);
            sucesso ? ok++ : falhas++;
        }

        btnAdicionar.disabled = false;
        btnLimpar.disabled = false;
        if (btnEnviar) btnEnviar.classList.add('d-none');

        const classe = falhas === 0 ? 'alert-success' : 'alert-warning';
        const msg = falhas === 0
            ? `${ok} arquivo(s) enviado(s) com sucesso.`
            : `${ok} enviado(s), ${falhas} com erro.`;
        areaEnviar.insertAdjacentHTML('beforeend',
            `<div class="alert ${classe} mt-2 mb-0 py-2 small upload-lote-aviso d-flex flex-wrap align-items-center justify-content-between gap-2">
               <span>${msg} Confira os detalhes acima.</span>
               <button type="button" class="btn btn-sm btn-primary" onclick="location.reload()">Atualizar lista</button>
             </div>`);
    });

    /* ── Drop zone desktop no card geral ── */
    const geralDropArea = document.getElementById('geralDropArea');
    if (geralDropArea) {
        geralDropArea.addEventListener('dragover', function (e) {
            if (!e.dataTransfer.types.includes('Files')) return;
            e.preventDefault();
            geralDropArea.style.background = '#e8f4fd';
        });
        geralDropArea.addEventListener('dragleave', function () {
            geralDropArea.style.background = '';
        });
        geralDropArea.addEventListener('drop', function (e) {
            e.preventDefault();
            geralDropArea.style.background = '';
            if (e.dataTransfer.files.length === 0) return;
            Array.from(e.dataTransfer.files).forEach(function (f) { adicionarItem(f); });
            atualizarVisibilidade();
        });
    }
    }  // fim do guard "if (btnAdicionar)" — upload geral legado

    /* ── Upload inline de documentos do cliente ── */
    const docTypesCliente = {{ documentTypeOptionsCliente|json_encode|raw }};

    function buildSelectCliente(idx) {
        let html = '<option value="">Tipo</option>';
        for (const [v, t] of Object.entries(docTypesCliente)) {
            html += `<option value="${v}">${t}</option>`;
        }
        return `<select name="categorias[${idx}]" class="form-select form-select-sm" required>${html}</select>`;
    }

    document.querySelectorAll('.form-upload-cliente-inline').forEach(function (form) {
        const cid      = form.dataset.clienteId;
        const input    = document.getElementById(`fileInputCliente${cid}`);
        const lista    = document.getElementById(`listaUploadCliente${cid}`);
        const btnEsc   = form.querySelector('.btn-escolher-arquivo-cliente');
        const btnEnv   = form.querySelector('.btn-enviar-cliente');
        const btnCan   = form.querySelector('.btn-cancelar-cliente');

        if (!input || !lista || !btnEsc) return;

        let fileIdx = 0;

        function atualizar() {
            const tem = lista.querySelectorAll('.upload-item-cliente').length > 0;
            btnEnv.classList.toggle('d-none', !tem);
            btnCan.classList.toggle('d-none', !tem);
        }

        function adicionarArquivo(file) {
            const i = fileIdx++;
            const div = document.createElement('div');
            div.className = 'upload-item-cliente border rounded p-2 mb-2 small';
            div._file = file;
            div.dataset.idx = i;
            div.innerHTML = `
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-file-earmark-text text-primary flex-shrink-0"></i>
                    <span class="text-truncate flex-grow-1 fw-semibold">${file.name}</span>
                    <span class="text-muted text-nowrap">${formatarTamanho(file.size)}</span>
                    <button type="button" class="btn btn-xs btn-outline-danger btn-rm-upload flex-shrink-0">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <div class="row g-1">
                    <div class="col-12 col-sm-5">${buildSelectCliente(i)}</div>
                    <div class="col-12 col-sm-7">
                        <input type="text" name="descricoes[${i}]" class="form-control form-control-sm"
                               placeholder="Descrição (opcional)" maxlength="500">
                    </div>
                </div>`;
            div.querySelector('.btn-rm-upload').addEventListener('click', function () {
                div.remove();
                atualizar();
            });
            lista.appendChild(div);
        }

        btnEsc.addEventListener('click', function () { input.value = ''; input.click(); });

        input.addEventListener('change', function () {
            Array.from(this.files).forEach(adicionarArquivo);
            atualizar();
        });

        btnCan.addEventListener('click', function () {
            lista.innerHTML = '';
            input.value = '';
            atualizar();
        });

        form.addEventListener('submit', function (e) {
            const itens = Array.from(lista.querySelectorAll('.upload-item-cliente'));
            if (itens.length === 0) { e.preventDefault(); return; }
            itens.forEach(function (item, novoIdx) {
                ['categorias', 'descricoes'].forEach(function (campo) {
                    const el = item.querySelector(`[name^="${campo}["]`);
                    if (el) el.name = `${campo}[${novoIdx}]`;
                });
            });
            const dt = new DataTransfer();
            itens.forEach(function (item) { if (item._file) dt.items.add(item._file); });
            input.name = 'arquivos[]';
            input.files = dt.files;
        });
    });
});

/* ── Timeline: envio AJAX de mensagem ──────────────────── */
(function () {
    const form        = document.getElementById('formTimelineMensagem');
    const textarea    = document.getElementById('timelineConteudo');
    const btnEnviar   = document.getElementById('btnEnviarMensagem');
    const erroDiv     = document.getElementById('timelineMensagemErro');
    const list        = document.getElementById('timelineList');
    const countBadge  = document.getElementById('timeline-count');
    const vazioMsg    = document.getElementById('timelineVazio');
    const urlEnviar   = '{{ path("pasta_enviar_mensagem", {id: pasta.id}) }}';
    const urlEditarTpl  = '{{ path("pasta_editar_mensagem", {id: pasta.id, msgId: 0})|replace({"/0/": "/__ID__/"}) }}';
    const urlExcluirTpl = '{{ path("pasta_excluir_mensagem", {id: pasta.id, msgId: 0})|replace({"/0/": "/__ID__/"}) }}';

    {# Editar/excluir mensagem (autor, dentro de 24h) — delegado na lista #}
    if (list) {
        list.addEventListener('click', async function (e) {
            const btnEditar = e.target.closest('.btn-editar-msg-pasta');
            if (btnEditar) {
                const msgId = btnEditar.dataset.msgId;
                const item  = document.getElementById('pasta-msg-' + msgId);
                if (!item) { return; }
                const conteudoDiv = item.querySelector('.pasta-msg-conteudo');
                if (!conteudoDiv || item.querySelector('.pasta-msg-edit-area')) { return; }

                const conteudoAtual = btnEditar.dataset.conteudo;

                const area = document.createElement('div');
                area.className = 'pasta-msg-edit-area mt-1';

                const textareaEd = document.createElement('textarea');
                textareaEd.className = 'form-control form-control-sm mb-1';
                textareaEd.rows = 3;
                textareaEd.maxLength = 5000;
                textareaEd.value = conteudoAtual;
                textareaEd.dataset.editorRicoPendente = '1';

                const btnSalvar = document.createElement('button');
                btnSalvar.type = 'button';
                btnSalvar.className = 'btn btn-sm btn-success me-1';
                btnSalvar.textContent = 'Salvar';

                const btnCancelar = document.createElement('button');
                btnCancelar.type = 'button';
                btnCancelar.className = 'btn btn-sm btn-outline-secondary';
                btnCancelar.textContent = 'Cancelar';

                const acoes = document.createElement('div');
                acoes.appendChild(btnSalvar);
                acoes.appendChild(btnCancelar);
                area.appendChild(textareaEd);
                area.appendChild(acoes);

                conteudoDiv.classList.add('d-none');
                conteudoDiv.after(area);

                // Transforma a textarea recem-criada em editor (o auto-init so pega o DOM inicial).
                if (window.EditorRico) {
                    const quillEd = EditorRico.montar(textareaEd);
                    if (quillEd) { quillEd.focus(); } else { textareaEd.focus(); }
                } else {
                    textareaEd.focus();
                }

                btnCancelar.addEventListener('click', function () {
                    area.remove();
                    conteudoDiv.classList.remove('d-none');
                });

                btnSalvar.addEventListener('click', async function () {
                    // O editor esvazia a textarea quando nao ha texto real (`<p><br></p>` nao conta).
                    const vazio = window.EditorRico
                        ? EditorRico.estaVazio(textareaEd)
                        : textareaEd.value.trim() === '';
                    if (vazio) { alert('A mensagem não pode ser vazia.'); return; }

                    btnSalvar.disabled = true;
                    const fd = new FormData();
                    fd.append('_token', btnEditar.dataset.csrf);
                    fd.append('conteudo', textareaEd.value);

                    try {
                        const resp = await fetch(btnEditar.dataset.url, {
                            method: 'POST',
                            body: fd,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        });
                        const data = await resp.json();
                        if (resp.ok) {
                            // `conteudoHtml` vem SANITIZADO do servidor.
                            conteudoDiv.innerHTML = '<span class="editor-rico-conteudo"><span class="ql-editor">'
                                + (data.conteudoHtml ?? '') + '</span></span>';
                            btnEditar.dataset.conteudo = data.conteudo;
                            marcarEditado(item);
                            area.remove();
                            conteudoDiv.classList.remove('d-none');
                        } else {
                            alert(data.erro ?? 'Erro ao editar.');
                            btnSalvar.disabled = false;
                        }
                    } catch (_) {
                        alert('Erro de rede.');
                        btnSalvar.disabled = false;
                    }
                });

                return;
            }

            const btnExcluir = e.target.closest('.btn-excluir-msg-pasta');
            if (btnExcluir) {
                if (!confirm('Excluir esta mensagem? Esta ação não pode ser desfeita.')) { return; }

                const msgId = btnExcluir.dataset.msgId;
                const fd    = new FormData();
                fd.append('_token', btnExcluir.dataset.csrf);

                try {
                    const resp = await fetch(btnExcluir.dataset.url, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    if (resp.ok) {
                        document.getElementById('pasta-msg-' + msgId)?.remove();
                        if (countBadge) {
                            countBadge.textContent = Math.max(0, parseInt(countBadge.textContent || '0', 10) - 1);
                        }
                    } else {
                        const data = await resp.json();
                        alert(data.erro ?? 'Erro ao excluir.');
                    }
                } catch (_) {
                    alert('Erro de rede.');
                }
            }
        });
    }

    function marcarEditado(item) {
        if (item.querySelector('.pasta-msg-editado')) { return; }
        const btn = item.querySelector('.btn-editar-msg-pasta');
        if (!btn) { return; }
        const marca = document.createElement('small');
        marca.className = 'text-muted fst-italic pasta-msg-editado';
        marca.textContent = '(editado)';
        btn.parentNode.insertBefore(marca, btn);
    }

    if (!form) { return; }

    textarea.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            form.requestSubmit();
        }
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const conteudo = textarea.value.trim();
        if (conteudo === '') {
            mostrarErro('A mensagem não pode ser vazia.');
            return;
        }

        btnEnviar.disabled = true;
        btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Enviando…';
        esconderErro();

        try {
            const resp = await fetch(urlEnviar, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });

            const data = await resp.json();

            if (!resp.ok) {
                mostrarErro(data.erro ?? 'Erro ao enviar mensagem.');
                return;
            }

            inserirMensagem(data);
            // Limpa o editor (fonte da textarea); sem isso o texto enviado ficaria na tela.
            if (window.EditorRico) { EditorRico.limpar(textarea); } else { textarea.value = ''; }
            if (vazioMsg) { vazioMsg.remove(); }
            if (countBadge) {
                countBadge.textContent = parseInt(countBadge.textContent || '0', 10) + 1;
            }
        } catch (_) {
            mostrarErro('Erro de rede. Tente novamente.');
        } finally {
            btnEnviar.disabled = false;
            btnEnviar.innerHTML = '<i class="bi bi-send me-1"></i> Enviar';
        }
    });

    function inserirMensagem(data) {
        const dt   = new Date(data.criadaEmTs);
        const hora = dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        // `conteudoHtml` vem SANITIZADO do servidor: entra como HTML (e o que mostra a formatacao).
        const corpo = '<span class="editor-rico-conteudo"><span class="ql-editor">'
            + (data.conteudoHtml ?? '') + '</span></span>';

        const urlEditar  = urlEditarTpl.replace('__ID__', data.id);
        const urlExcluir = urlExcluirTpl.replace('__ID__', data.id);

        const html = `
        <div class="d-flex gap-2 mb-2 timeline-entry timeline-entry--mensagem timeline-entry--new" id="pasta-msg-${data.id}">
            <div class="flex-shrink-0 pt-1">
                <span class="badge rounded-circle timeline-icon text-bg-info">
                    <i class="bi bi-chat-left-text"></i>
                </span>
            </div>
            <div class="flex-grow-1 timeline-item-body timeline-item-body--mensagem" style="min-width:0">
                <div class="d-flex justify-content-between align-items-start gap-1 flex-wrap">
                    <span class="fw-semibold small lh-sm">Mensagem</span>
                    <span class="d-flex align-items-center gap-1 flex-shrink-0">
                        <small class="text-muted lh-sm">
                            <i class="bi bi-clock me-1"></i>${hora}
                        </small>
                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary btn-editar-msg-pasta"
                                title="Editar mensagem"
                                data-msg-id="${data.id}"
                                data-conteudo="${esc(data.conteudo)}"
                                data-csrf="${esc(data.csrfEditar ?? '')}"
                                data-url="${esc(urlEditar)}">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-link btn-sm p-0 text-danger btn-excluir-msg-pasta"
                                title="Excluir mensagem"
                                data-msg-id="${data.id}"
                                data-csrf="${esc(data.csrfExcluir ?? '')}"
                                data-url="${esc(urlExcluir)}">
                            <i class="bi bi-trash"></i>
                        </button>
                    </span>
                </div>
                <div class="lh-sm">
                    <small class="text-muted">
                        <i class="bi bi-person me-1"></i>${esc(data.autorNome ?? '')}
                    </small>
                </div>
                <div class="mt-1 small text-body pasta-msg-conteudo">${corpo}</div>
            </div>
        </div>`;

        list.insertAdjacentHTML('afterbegin', html);
        list.scrollTop = 0;
    }

    function mostrarErro(msg) {
        erroDiv.textContent = msg;
        erroDiv.classList.remove('d-none');
    }

    function esconderErro() {
        erroDiv.classList.add('d-none');
    }

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
}());
</script>

<style>
.processo-modal-tabs {
    border-bottom: 3px solid #1a6fa3;
    background: var(--bs-body-bg);
    margin-bottom: 0;
}
.processo-modal-tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    padding: 8px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--bs-secondary-color);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    outline: none;
}
.processo-modal-tab:hover { color: #1a6fa3; }
.processo-modal-tab.active { color: #1a6fa3; border-bottom-color: #1a6fa3; }
.processo-modal-tab-content { display: none; }
.processo-modal-tab-content.active { display: block; }
/* Autocomplete de processo em tema escuro: o select2 usa fundo branco, mas os textos
   herdavam a cor clara do tema (sumindo sobre o branco). Fixa esquema claro + textos escuros,
   preservando o contraste da opção destacada (branco sobre azul). */
.mp-proc-dropdown { color-scheme: light; }
.mp-proc-dropdown .select2-search__field {
    background-color: #fff;
    color: #212529;
}
.mp-proc-dropdown .select2-results__option { color: #212529; }
.mp-proc-dropdown .select2-results__option--highlighted { color: #fff; }
/* Caixa de seleção do autocomplete (fica dentro de #modal-modo-existente): texto/placeholder
   escuros sobre o fundo branco do select2. */
#modal-modo-existente .select2-selection__rendered { color: #212529; }
#modal-modo-existente .select2-selection__placeholder { color: #6c757d; }
</style>

<script>
(function () {
    var pastaId                 = '{{ pasta.id }}';
    var csrfDesvincularProcesso = '{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}';

    /* ── Abas do modal de processo ── */
    document.querySelectorAll('.processo-modal-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.processo-modal-tab').forEach(function (t) { t.classList.remove('active'); });
            document.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.remove('active'); });
            tab.classList.add('active');
            var painel = document.getElementById('tab-' + tab.dataset.modalTab);
            if (painel) painel.classList.add('active');
        });
    });

    /* ── Modo (buscar existente x cadastrar novo) e Select2 no modal ── */
    var modalEl = document.getElementById('modalVincularProcesso');

    function mpAplicarModo(modo) {
        var blocoExistente = document.getElementById('modal-modo-existente');
        var blocoNovo      = document.getElementById('modal-modo-novo');
        var selExistente   = document.getElementById('mp-processoExistente');
        var ehNovo         = (modo === 'novo');

        blocoExistente.classList.toggle('d-none', ehNovo);
        blocoNovo.classList.toggle('d-none', !ehNovo);

        // Campos required do CNJ não podem bloquear o submit quando ocultos (o
        // navegador não consegue focar um required escondido). Suspende o required
        // no modo "existente" e o restaura no modo "novo".
        blocoNovo.querySelectorAll('input, select, textarea').forEach(function (el) {
            if (ehNovo) {
                if (el.dataset.reqSuspenso) {
                    el.required = true;
                    delete el.dataset.reqSuspenso;
                }
            } else if (el.required) {
                el.required = false;
                el.dataset.reqSuspenso = '1';
            }
        });

        if (selExistente) selExistente.disabled = ehNovo; // não submete processo_id no modo novo
    }

    document.getElementById('mp-modo-existente').addEventListener('change', function () { mpAplicarModo('existente'); });
    document.getElementById('mp-modo-novo').addEventListener('change', function () { mpAplicarModo('novo'); });
    mpAplicarModo('existente');

    modalEl.addEventListener('shown.bs.modal', function () {
        if (window.$ && $.fn.select2) {
            // Tribunal é campo somente-leitura, derivado do número do processo (padrão CNJ).
            if (!$('#mp-processoExistente').hasClass('select2-hidden-accessible')) {
                $('#mp-processoExistente').select2({
                    width: '100%',
                    placeholder: 'Digite número, classe, assunto ou tribunal…',
                    allowClear: true,
                    dropdownParent: $('#modalVincularProcesso'),
                    dropdownCssClass: 'mp-proc-dropdown',
                    minimumInputLength: 2,
                    ajax: {
                        url: '{{ path('pasta_buscar_processos', {id: pasta.id}) }}',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term }; },
                        processResults: function (data) { return { results: data.results || [] }; }
                    },
                    language: {
                        noResults: function () { return 'Nenhum processo encontrado'; },
                        searching: function () { return 'Buscando…'; },
                        inputTooShort: function () { return 'Digite ao menos 2 caracteres'; }
                    }
                });
            }
        }
        mpAplicarModo(document.getElementById('mp-modo-novo').checked ? 'novo' : 'existente');
    });

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    /* ── Submit via AJAX ── */
    document.getElementById('formVincularProcesso').addEventListener('submit', async function (e) {
        e.preventDefault();
        var feedbackEl = document.getElementById('mp-feedbackAlerta');
        var btnSalvar  = this.querySelector('button[type="submit"]');
        var icone      = btnSalvar.querySelector('i');
        var modoNovo   = document.getElementById('mp-modo-novo').checked;

        feedbackEl.className = 'd-none mt-3';
        feedbackEl.innerHTML = '';

        if (!modoNovo) {
            var selExistente = document.getElementById('mp-processoExistente');
            if (!selExistente.value) {
                feedbackEl.className = 'alert alert-warning mt-3';
                feedbackEl.textContent = 'Selecione um processo para vincular.';
                return;
            }
        }

        btnSalvar.disabled = true;
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        try {
            var resp = await fetch(this.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(this),
            });
            var dados = await resp.json().catch(function () { return {}; });

            if (resp.ok && dados.sucesso) {
                window.mpSwapProcessos(dados.html);
                bootstrap.Modal.getInstance(modalEl)?.hide();
                return;
            }

            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = dados.erro ?? 'Erro ao vincular processo.';
        } catch (_) {
            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Erro de comunicação. Tente novamente.';
        } finally {
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check-lg me-1';
        }
    });

    /* ── Fechar modal limpa o formulário ── */
    modalEl.addEventListener('hidden.bs.modal', function () {
        document.getElementById('formVincularProcesso').reset();
        var partesContainer = document.getElementById('mp-partesContainer');
        partesContainer.innerHTML = mpParteRowHtml(0);
        var movContainer = document.getElementById('mp-movimentacoesContainer');
        movContainer.innerHTML = mpMovRowHtml(0);
        mpUpdateRemoveButtons();
        document.getElementById('mp-feedbackAlerta').className = 'd-none mt-3';
        document.getElementById('mp-feedbackAlerta').innerHTML = '';
        document.querySelectorAll('.processo-modal-tab').forEach(function (t) { t.classList.remove('active'); });
        document.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.remove('active'); });
        document.querySelector('.processo-modal-tab[data-modal-tab="modal-proc-info"]').classList.add('active');
        document.getElementById('tab-modal-proc-info').classList.add('active');
        document.getElementById('mp-siglaTribunal').value = '';
        document.getElementById('mp-modo-existente').checked = true;
        if (window.$ && $.fn.select2 && $('#mp-processoExistente').hasClass('select2-hidden-accessible')) {
            $('#mp-processoExistente').val(null).trigger('change');
        }
        mpAplicarModo('existente');
    });

    /* ── Templates de linha ── */
    function mpParteRowHtml(idx) {
        return `<div class="mp-parte-row card mb-2 p-3" style="position: relative;">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <select name="partes[${idx}][tipo]" class="form-select">
                        <option value="PARTE">Parte</option>
                        <option value="ADVOGADO">Advogado</option>
                        <option value="JUIZ">Juiz</option>
                        <option value="PROMOTOR">Promotor</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nome</label>
                    <input type="text" name="partes[${idx}][nome]" class="form-control" placeholder="Nome da parte">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Documento</label>
                    <input type="text" name="partes[${idx}][documento]" class="form-control" placeholder="CPF/CNPJ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Papel</label>
                    <input type="text" name="partes[${idx}][papel]" class="form-control" placeholder="Polo ativo/passivo">
                </div>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm mp-remove-parte"
                    style="display: none; position: absolute; top: 8px; right: 12px;"
                    title="Remover"><i class="bi bi-trash"></i></button>
        </div>`;
    }

    function mpMovRowHtml(idx) {
        return `<div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Data</label>
                    <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Descrição</label>
                    <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control" placeholder="Descrição da movimentação">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control" placeholder="Tipo de movimento">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Órgão</label>
                    <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control" placeholder="Órgão">
                </div>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                    style="display: none; position: absolute; top: 8px; right: 12px;"
                    title="Remover"><i class="bi bi-trash"></i></button>
        </div>`;
    }

    /* ── Adicionar / remover partes ── */
    document.getElementById('mp-btn-add-parte').addEventListener('click', function () {
        var container = document.getElementById('mp-partesContainer');
        var idx = container.querySelectorAll('.mp-parte-row').length;
        container.insertAdjacentHTML('beforeend', mpParteRowHtml(idx));
        mpAttachRemovePartes();
    });

    function mpAttachRemovePartes() {
        document.querySelectorAll('#mp-partesContainer .mp-remove-parte').forEach(function (btn) {
            btn.onclick = function () { btn.closest('.mp-parte-row').remove(); mpUpdateRemoveButtons(); };
        });
        mpUpdateRemoveButtons();
    }

    /* ── Adicionar / remover movimentações ── */
    document.getElementById('mp-btn-add-movimentacao').addEventListener('click', function () {
        var container = document.getElementById('mp-movimentacoesContainer');
        var idx = container.querySelectorAll('.mp-movimentacao-row').length;
        container.insertAdjacentHTML('beforeend', mpMovRowHtml(idx));
        mpAttachRemoveMovimentacoes();
    });

    function mpAttachRemoveMovimentacoes() {
        document.querySelectorAll('#mp-movimentacoesContainer .mp-remove-movimentacao').forEach(function (btn) {
            btn.onclick = function () { btn.closest('.mp-movimentacao-row').remove(); mpUpdateRemoveButtons(); };
        });
        mpUpdateRemoveButtons();
    }

    function mpUpdateRemoveButtons() {
        var partes = document.querySelectorAll('#mp-partesContainer .mp-parte-row').length;
        document.querySelectorAll('#mp-partesContainer .mp-remove-parte').forEach(function (btn) {
            btn.style.display = partes > 1 ? 'block' : 'none';
        });
        var movs = document.querySelectorAll('#mp-movimentacoesContainer .mp-movimentacao-row').length;
        document.querySelectorAll('#mp-movimentacoesContainer .mp-remove-movimentacao').forEach(function (btn) {
            btn.style.display = movs > 1 ? 'block' : 'none';
        });
    }

    /* ── Busca DataJud ── */
    document.getElementById('mp-btn-datajud').addEventListener('click', async function () {
        var numeroProcesso = document.getElementById('mp-numeroProcesso').value;
        var feedbackEl     = document.getElementById('mp-feedbackAlerta');
        var loadingEl      = document.getElementById('mp-loadingOverlay');

        feedbackEl.className = 'd-none mt-3';
        feedbackEl.innerHTML = '';

        if (!numeroProcesso) {
            feedbackEl.className = 'alert alert-warning mt-3';
            feedbackEl.textContent = 'Informe o número do processo.';
            return;
        }

        loadingEl.classList.remove('d-none');
        try {
            // O tribunal é derivado do número no servidor — não enviamos mais a sigla.
            var response = await fetch('{{ path("api_datajud_search") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ numeroProcesso: numeroProcesso })
            });
            var data = await response.json();
            loadingEl.classList.add('d-none');

            if (!response.ok || !data.success) {
                feedbackEl.className = 'alert alert-danger mt-3';
                feedbackEl.textContent = data.error || 'Erro ao buscar processo no CNJ/DataJud.';
                return;
            }

            var pd = data.data;
            document.getElementById('mp-siglaTribunal').value     = pd.siglaTribunal     || '';
            document.getElementById('mp-orgaoJulgador').value     = pd.orgaoJulgador     || '';
            document.getElementById('mp-classeProcessual').value  = pd.classeProcessual  || '';
            document.getElementById('mp-assuntoProcessual').value = pd.assuntoProcessual || '';
            document.getElementById('mp-situacaoProcesso').value  = pd.situacaoProcesso  || 'EM_ANDAMENTO';
            document.getElementById('mp-instancia').value         = pd.instancia         || 'G1';
            document.getElementById('mp-dataDistribuicao').value  = pd.dataDistribuicao  || '';

            var partesContainer = document.getElementById('mp-partesContainer');
            partesContainer.innerHTML = '';
            var partesList = (pd.partes && pd.partes.length > 0) ? pd.partes : [{}];
            partesList.forEach(function (parte, idx) {
                partesContainer.insertAdjacentHTML('beforeend', `<div class="mp-parte-row card mb-2 p-3" style="position: relative;">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label">Tipo</label>
                            <select name="partes[${idx}][tipo]" class="form-select">
                                <option value="PARTE" ${(parte.tipo||'')==='PARTE'?'selected':''}>Parte</option>
                                <option value="ADVOGADO" ${(parte.tipo||'')==='ADVOGADO'?'selected':''}>Advogado</option>
                                <option value="JUIZ" ${(parte.tipo||'')==='JUIZ'?'selected':''}>Juiz</option>
                                <option value="PROMOTOR" ${(parte.tipo||'')==='PROMOTOR'?'selected':''}>Promotor</option>
                            </select></div>
                        <div class="col-md-5"><label class="form-label">Nome</label>
                            <input type="text" name="partes[${idx}][nome]" class="form-control" value="${parte.nome||''}" placeholder="Nome da parte"></div>
                        <div class="col-md-2"><label class="form-label">Documento</label>
                            <input type="text" name="partes[${idx}][documento]" class="form-control" value="${parte.documento||''}" placeholder="CPF/CNPJ"></div>
                        <div class="col-md-2"><label class="form-label">Papel</label>
                            <input type="text" name="partes[${idx}][papel]" class="form-control" value="${parte.papel||''}" placeholder="Polo ativo/passivo"></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mp-remove-parte"
                            style="display: ${partesList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                            title="Remover"><i class="bi bi-trash"></i></button>
                </div>`);
            });

            var movContainer = document.getElementById('mp-movimentacoesContainer');
            movContainer.innerHTML = '';
            var movsList = (pd.movimentacoes && pd.movimentacoes.length > 0) ? pd.movimentacoes : [{}];
            movsList.forEach(function (mov, idx) {
                movContainer.insertAdjacentHTML('beforeend', `<div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label">Data</label>
                            <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control" value="${mov.dataMovimentacao||''}"></div>
                        <div class="col-md-4"><label class="form-label">Descrição</label>
                            <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control" value="${mov.descricao||''}" placeholder="Descrição da movimentação"></div>
                        <div class="col-md-3"><label class="form-label">Tipo</label>
                            <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control" value="${mov.tipo||''}" placeholder="Tipo de movimento"></div>
                        <div class="col-md-2"><label class="form-label">Órgão</label>
                            <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control" value="${mov.orgao||''}" placeholder="Órgão"></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                            style="display: ${movsList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                            title="Remover"><i class="bi bi-trash"></i></button>
                </div>`);
            });

            mpAttachRemovePartes();
            mpAttachRemoveMovimentacoes();

            feedbackEl.className = 'alert alert-success mt-3';
            feedbackEl.textContent = 'Processo carregado com sucesso! Verifique os dados antes de salvar.';

        } catch (e) {
            loadingEl.classList.add('d-none');
            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Erro ao buscar processo no CNJ/DataJud. Tente novamente em instantes.';
        }
    });

    mpAttachRemovePartes();
    mpAttachRemoveMovimentacoes();
}());
</script>

{# ── Modal: editar pasta ── #}
<div class="modal fade" id="modalEditarPasta" tabindex="-1" aria-labelledby="modalEditarPastaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="modalEditarPastaLabel">
                    <i class="bi bi-pencil me-1"></i> Editar Pasta
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="{{ path('pasta_edit', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_pasta_' ~ pasta.id) }}">
                <div class="modal-body py-3">

                    <div class="mb-3">
                        <label for="edit_nup" class="form-label form-label-sm">Número da Pasta (NUP)</label>
                        <input type="text" id="edit_nup" name="nup"
                               class="form-control form-control-sm"
                               value="{{ pasta.nup }}" required autocomplete="off">
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm">Nome do cliente</label>
                        {% if pasta.clientes|length > 0 %}
                            <div class="d-flex flex-wrap gap-1 form-control form-control-sm h-auto py-1" style="min-height:2.1rem;">
                                {% for cliente in pasta.clientes %}
                                    <span class="badge text-bg-secondary fw-normal">
                                        <i class="bi bi-person me-1"></i>{{ cliente.cpf is defined and cliente.cpf ? cliente.nomeCompleto : cliente.razaoSocial }}
                                    </span>
                                {% endfor %}
                            </div>
                            <div class="form-text text-muted">Para alterar clientes, use a seção de Clientes na aba Dados.</div>
                        {% else %}
                            <input type="text" id="edit_nome_cliente" name="nome_cliente"
                                   class="form-control form-control-sm"
                                   value="{{ pasta.nomeCliente }}" autocomplete="off">
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        <label for="edit_nome_acao" class="form-label form-label-sm">Nome da Ação</label>
                        <input type="text" id="edit_nome_acao" name="nome_acao"
                               class="form-control form-control-sm"
                               value="{{ pasta.nomeAcao }}" autocomplete="off">
                    </div>

                    <div class="mb-3">
                        <label for="edit_situacao" class="form-label form-label-sm">Situação</label>
                        <select id="edit_situacao" name="situacao" class="form-select form-select-sm">
                            <option value="ativo" {{ pasta.situacao == 'ativo' ? 'selected' : '' }}>Ativo</option>
                            <option value="arquivado" {{ pasta.situacao == 'arquivado' ? 'selected' : '' }}>Arquivado</option>
                        </select>
                    </div>

                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var btn = document.getElementById('btn-alternar-status');
    if (!btn) return;

    var badgeEl = document.querySelector('.card-tools .badge');

    btn.addEventListener('click', function () {
        var url  = btn.dataset.url;
        var csrf = btn.dataset.csrf;

        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '_token=' + encodeURIComponent(csrf),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.sucesso) {
                alert(data.erro || 'Erro ao alterar situação.');
                btn.disabled = false;
                return;
            }

            var novaSituacao = data.novaSituacao;
            btn.dataset.situacaoAtual = novaSituacao;

            var eAtivo = novaSituacao === 'ativo';

            /* ícone */
            var icone = btn.querySelector('i');
            icone.className = 'bi ' + (eAtivo ? 'bi-archive' : 'bi-archive-fill');

            /* label */
            var label = btn.querySelector('.pasta-acao-label');
            label.textContent = eAtivo ? 'Arquivar' : 'Ativar';

            /* title */
            btn.title = eAtivo ? 'Arquivar pasta' : 'Reativar pasta';

            /* cor do botão */
            btn.classList.toggle('pasta-acao-btn--arquivado', !eAtivo);

            /* badge de situação no card-tools */
            if (badgeEl) {
                badgeEl.textContent = eAtivo ? 'Ativo' : 'Arquivado';
                badgeEl.className = 'badge ' + (eAtivo ? 'text-bg-success' : 'text-bg-secondary');
            }

            btn.disabled = false;
        })
        .catch(function () {
            alert('Erro de comunicação com o servidor.');
            btn.disabled = false;
        });
    });

    /* ── Dropdown de prioridade ── */
    document.querySelectorAll('.prioridade-opt').forEach(function (optBtn) {
        optBtn.addEventListener('click', async function () {
            var dd  = optBtn.closest('.dropdown');
            var tog = dd.querySelector('.pasta-prioridade-btn');
            var fd  = new FormData();
            fd.append('prioridade', optBtn.dataset.valor);
            fd.append('_token', tog.dataset.csrf);

            try {
                var res = await fetch(tog.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                if (res.ok) {
                    var json = await res.json();
                    tog.className = 'btn btn-sm badge ' + json.badgeClass + ' dropdown-toggle pasta-prioridade-btn';
                    tog.querySelector('i').nextSibling.textContent = json.label;
                }
            } catch (e) {
                alert('Erro ao alterar prioridade.');
            }
        });
    });
}());
</script>

