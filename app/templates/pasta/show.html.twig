                        <div class="ps-nm-resp-lista" id="tarefaResponsavelLista" data-ps-nm-resp-lista hidden>
                            <div class="ps-nm-resp-busca">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="text" placeholder="Filtrar…" aria-label="Filtrar responsáveis"
                                       autocomplete="off" spellcheck="false" data-ps-nm-resp-busca>
                            </div>
                            <div class="ps-nm-resp-opcoes" role="listbox" aria-multiselectable="true" aria-labelledby="tarefaResponsavelRotulo">
                                {% for u in usuarios %}
                                    <button type="button" class="ps-nm-resp-opcao" role="option" aria-selected="false"
                                            data-ps-nm-resp-opcao="{{ u.id }}" data-nome="{{ u.fullName }}">
                                        {{ nmAvatar.avatar(u.fullName, (fotosResponsaveis|default({}))[u.id]|default(null), 30) }}
                                        <span class="ps-nm-resp-opcao-nome">{{ u.fullName|upper }}</span>
                                        <i class="bi bi-check-circle-fill ps-nm-resp-opcao-ok" aria-hidden="true"></i>
                                    </button>
                                {% endfor %}
                                <div class="ps-nm-resp-nada" data-ps-nm-resp-nada hidden>Ninguém encontrado</div>
                            </div>
                            <div class="ps-nm-resp-rodape">
                                <button type="button" class="ps-nm-resp-concluir" data-ps-nm-resp-concluir>Concluir</button>
                            </div>
                        </div>
                        <select id="tarefaResponsavel" name="responsaveis[]" class="visually-hidden" multiple
                                tabindex="-1" aria-hidden="true">
                            {% for u in usuarios %}
                                <option value="{{ u.id }}">{{ u.fullName }}</option>
                            {% endfor %}
                        </select>
                    </div>

                </div>
                <div class="modal-footer ps-modal-meta-rodape">
                    <button type="button" class="ps-modal-meta-btn ps-modal-meta-btn--cancelar" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnEnviarTarefa" class="ps-modal-meta-btn ps-modal-meta-btn--criar"
                            title="Criar meta e notificar os responsáveis">
                        <i class="bi bi-send" aria-hidden="true"></i>Criar meta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('formCriarTarefa');
    if (!form) return;
    // O rótulo do desenho volta depois de um erro (o "Enviando…" o substitui durante o envio).
    var ROTULO_CRIAR = '<i class="bi bi-send" aria-hidden="true"></i>Criar meta';

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        var btn = document.getElementById('btnEnviarTarefa');
        var erroBox = document.getElementById('tarefaErroMsg');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando…';
        erroBox.classList.add('d-none');

        var data = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: data,
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            if (res.data.sucesso) {
                // PMC-044: fica na pasta, aba Metas, com a meta nova realçada (destino do servidor).
                window.location.href = res.data.destino;
            } else {
                erroBox.textContent = res.data.erro || res.data.mensagem || 'Erro ao criar meta.';
                erroBox.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = ROTULO_CRIAR;
            }
        })
        .catch(function () {
            erroBox.textContent = 'Erro de comunicação. Tente novamente.';
            erroBox.classList.remove('d-none');
            btn.disabled = false;
            btn.innerHTML = ROTULO_CRIAR;
        });
    });
}());
</script>
