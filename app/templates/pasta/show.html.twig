<script>
(function () {
    'use strict';

    const modal = document.getElementById('modalAdicionarCliente');
    if (!modal) return;

    const passoEscolha       = modal.querySelector('#passoEscolhaTipo');
    const formPF             = modal.querySelector('#formPF');
    const formPJ             = modal.querySelector('#formPJ');
    const campoTipo          = modal.querySelector('#campoTipoCliente');
    const footerForm         = modal.querySelector('#footerFormCliente');
    const footerEscolha      = modal.querySelector('#footerEscolhaTipo');
    const footerVincular     = modal.querySelector('#footerVincularCliente');
    const alertaErro         = modal.querySelector('#alertaErroCliente');
    const form               = modal.querySelector('#formNovoCliente');
    const btnSalvar          = footerForm.querySelector('button[type="submit"]');

    // Busca de cliente existente
    const inputBusca              = modal.querySelector('#buscaClienteExistente');
    const listaResultados         = modal.querySelector('#buscaClienteResultados');
    const spinnerBusca            = modal.querySelector('#buscaClienteSpinner');
    const chipsContainer          = modal.querySelector('#clientesSelecionadosContainer');
    const chipsWrapper            = modal.querySelector('#clientesSelecionadosChips');
    const btnConfirmarVincular    = modal.querySelector('#btnConfirmarVincular');
    const urlBuscar               = document.getElementById('urlBuscarClientes')?.value ?? '';
    const urlVincular             = document.getElementById('urlVincularCliente')?.value ?? '';
    const csrfVincular            = document.getElementById('csrfVincularCliente')?.value ?? '';
    const pastaId                 = '{{ pasta.id }}';
    const csrfDesvincularProcesso = '{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}';
    const clientesContainer       = document.getElementById('clientesList');
    const partesContainer         = document.getElementById('partesContrariasList');

    /** @type {Array<{id: number, nome: string, documento: string, tipo: string}>} */
    let clientesSelecionados = [];
    let debounceTimer        = null;

    function criarClienteRow(cliente) {
        const row = document.createElement('div');
        row.className = 'cliente-row mb-3 pb-3 border-bottom';
        row.dataset.clienteId = cliente.id;

        // Cabeçalho: nome + botão desvincular
        const header = document.createElement('div');
        header.className = 'd-flex align-items-center justify-content-between gap-2 mb-2';

        const link = document.createElement('a');
        link.href = `/clientes/${cliente.id}`;
        link.className = 'text-decoration-none flex-grow-1 vinculo-link';

        const linkContent = document.createElement('div');
        linkContent.className = 'd-flex align-items-center gap-2';

        const icon = document.createElement('i');
        icon.className = 'bi bi-person-circle text-muted';

        const nameSpan = document.createElement('span');
        nameSpan.className = 'fw-semibold text-primary';
        nameSpan.textContent = cliente.nome;

        linkContent.appendChild(icon);
        linkContent.appendChild(nameSpan);
        link.appendChild(linkContent);

        const formDesvincular = document.createElement('form');
        formDesvincular.method = 'post';
        formDesvincular.action = `/pasta/${pastaId}/cliente/${cliente.id}/desvincular`;
        formDesvincular.className = 'js-ajax-desvincular-cliente m-0';

        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = cliente.csrfToken;

        const btnDesvincular = document.createElement('button');
        btnDesvincular.type = 'submit';
        btnDesvincular.className = 'btn btn-sm btn-outline-danger';
        btnDesvincular.title = 'Desvincular cliente da pasta';
        btnDesvincular.innerHTML = '<i class="bi bi-trash"></i>';

        formDesvincular.appendChild(tokenInput);
        formDesvincular.appendChild(btnDesvincular);

        header.appendChild(link);
        header.appendChild(formDesvincular);

        // Área de arquivos com form de upload
        const arquivosDiv = document.createElement('div');
        arquivosDiv.className = 'cliente-arquivos ps-1';

        const formUpload = document.createElement('form');
        formUpload.method = 'post';
        formUpload.enctype = 'multipart/form-data';
        formUpload.action = `/clientes/${cliente.id}/documento/upload`;
        formUpload.className = 'form-upload-cliente-inline mt-2';
        formUpload.dataset.clienteId = cliente.id;

        const tokenUpload = document.createElement('input');
        tokenUpload.type = 'hidden';
        tokenUpload.name = '_token';
        tokenUpload.value = cliente.csrfTokenUpload;

        const fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.id = `fileInputCliente${cliente.id}`;
        fileInput.multiple = true;
        fileInput.accept = '.pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,audio/*,video/*';
        fileInput.className = 'd-none file-input-cliente';

        const listaUpload = document.createElement('div');
        listaUpload.id = `listaUploadCliente${cliente.id}`;
        listaUpload.className = 'mb-2';

        const botoesDiv = document.createElement('div');
        botoesDiv.className = 'd-flex align-items-center gap-2';

        const btnAnexar = document.createElement('button');
        btnAnexar.type = 'button';
        btnAnexar.className = 'btn btn-xs btn-outline-primary btn-escolher-arquivo-cliente';
        btnAnexar.dataset.clienteId = cliente.id;
        btnAnexar.innerHTML = '<i class="bi bi-paperclip me-1"></i> Anexar arquivo';

        const btnEnviar = document.createElement('button');
        btnEnviar.type = 'submit';
        btnEnviar.className = 'btn btn-xs btn-success btn-enviar-cliente d-none';
        btnEnviar.dataset.clienteId = cliente.id;
        btnEnviar.innerHTML = '<i class="bi bi-cloud-upload me-1"></i> Enviar';

        const btnCancelar = document.createElement('button');
        btnCancelar.type = 'button';
        btnCancelar.className = 'btn btn-xs btn-outline-secondary btn-cancelar-cliente d-none';
        btnCancelar.dataset.clienteId = cliente.id;
        btnCancelar.innerHTML = '<i class="bi bi-x"></i>';

        botoesDiv.appendChild(btnAnexar);
        botoesDiv.appendChild(btnEnviar);
        botoesDiv.appendChild(btnCancelar);

        formUpload.appendChild(tokenUpload);
        formUpload.appendChild(fileInput);
        formUpload.appendChild(listaUpload);
        formUpload.appendChild(botoesDiv);

        arquivosDiv.appendChild(formUpload);

        row.appendChild(header);
        row.appendChild(arquivosDiv);

        return row;
    }

    function appendClienteRow(cliente) {
        if (!clientesContainer) {
            return;
        }
        const placeholder = clientesContainer.querySelector('#clientesPlaceholder');
        if (placeholder) {
            placeholder.remove();
        }
        clientesContainer.appendChild(criarClienteRow(cliente));
    }

    function removeClienteRow(clienteId, form = null) {
        if (!clientesContainer) {
            return;
        }

        let row = null;
        if (clienteId) {
            row = clientesContainer.querySelector(`.cliente-row[data-cliente-id="${clienteId}"]`);
        }
        if (!row && form) {
            row = form.closest('.cliente-row');
        }

        if (row) {
            row.remove();
        }
        if (!clientesContainer.querySelector('.cliente-row')) {
            clientesContainer.insertAdjacentHTML('beforeend', '<div id="clientesPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhum cliente vinculado.</div>');
        }
    }

    function criarParteContrariaRow(parte) {
        const row = document.createElement('div');
        row.className = 'parte-contraria-row d-flex align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom';
        row.dataset.parteContrariaId = parte.id;

        const label = document.createElement('div');
        label.className = 'd-flex align-items-center gap-2';

        const icon = document.createElement('i');
        icon.className = 'bi bi-person-dash text-muted';

        const nomeSpan = document.createElement('span');
        nomeSpan.textContent = parte.nome;

        label.appendChild(icon);
        label.appendChild(nomeSpan);

        const form = document.createElement('form');
        form.method = 'post';
        form.action = `/pasta/${pastaId}/parte-contraria/${parte.id}/desvincular`;
        form.className = 'js-ajax-desvincular-parte-contraria m-0';

        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = parte.csrfToken;

        const button = document.createElement('button');
        button.type = 'submit';
        button.className = 'btn btn-sm btn-outline-danger';
        button.title = 'Desvincular parte contrária da pasta';
        button.innerHTML = '<i class="bi bi-trash"></i>';

        form.appendChild(tokenInput);
        form.appendChild(button);

        row.appendChild(label);
        row.appendChild(form);

        return row;
    }

    function appendParteContrariaRow(parte) {
        if (!partesContainer) {
            return;
        }
        const placeholder = partesContainer.querySelector('#partesContrariasPlaceholder');
        if (placeholder) {
            placeholder.remove();
        }
        partesContainer.appendChild(criarParteContrariaRow(parte));
    }

    function removeParteContrariaRow(parteId, form = null) {
        if (!partesContainer) {
            return;
        }

        let row = null;
        if (parteId) {
            row = partesContainer.querySelector(`.parte-contraria-row[data-parte-contraria-id="${parteId}"]`);
        }
        if (!row && form) {
            row = form.closest('.parte-contraria-row');
        }

        if (row) {
            row.remove();
        }
        if (!partesContainer.querySelector('.parte-contraria-row')) {
            partesContainer.insertAdjacentHTML('beforeend', '<div id="partesContrariasPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhuma parte contrária registrada.</div>');
        }
    }

    function mostrarErro(msg) {
        alertaErro.textContent = msg;
        alertaErro.classList.remove('d-none');
        alertaErro.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function ocultarErro() {
        alertaErro.classList.add('d-none');
        alertaErro.textContent = '';
    }

    function mostrar(tipo) {
        ocultarErro();
        passoEscolha.classList.add('d-none');
        footerEscolha.style.setProperty('display', 'none', 'important');
        footerForm.style.removeProperty('display');

        if (tipo === 'pf') {
            formPF.classList.remove('d-none');
            formPJ.classList.add('d-none');
            campoTipo.value = 'pf';
            // Ativa primeira aba do PF
            bootstrap.Tab.getOrCreateInstance(modal.querySelector('#pf-dados-tab')).show();
        } else {
            formPJ.classList.remove('d-none');
            formPF.classList.add('d-none');
            campoTipo.value = 'pj';
            // Ativa primeira aba do PJ
            bootstrap.Tab.getOrCreateInstance(modal.querySelector('#pj-empresa-tab')).show();
        }
    }

    function voltar() {
        ocultarErro();
        formPF.classList.add('d-none');
        formPJ.classList.add('d-none');
        passoEscolha.classList.remove('d-none');
        footerForm.style.setProperty('display', 'none', 'important');
        footerEscolha.style.removeProperty('display');
        campoTipo.value = '';
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        ocultarErro();

        btnSalvar.disabled = true;
        const icone = btnSalvar.querySelector('i');
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        // Desabilita inputs do form inativo para não serem incluídos no FormData
        const tipoAtivo = campoTipo.value;
        const formInativo = tipoAtivo === 'pf' ? formPJ : formPF;
        const inputsDesabilitados = formInativo.querySelectorAll('input, select, textarea');
        inputsDesabilitados.forEach(el => { el.disabled = true; });

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });

            if (!resp.ok) {
                let msgErro = 'Erro ao salvar cliente.';
                try {
                    const dados = await resp.json();
                    msgErro = dados.erro ?? msgErro;
                } catch (_) { /* resposta não é JSON */ }
                mostrarErro(msgErro);
                return;
            }

            const dados = await resp.json();
            if (dados.sucesso && dados.cliente) {
                appendClienteRow(dados.cliente);
                bootstrap.Modal.getInstance(modal)?.hide();
                return;
            }

            mostrarErro('Cliente salvo, mas não foi possível atualizar a lista.');
        } catch (err) {
            mostrarErro('Erro de comunicação. Tente novamente.');
            console.error('[formNovoCliente]', err);
        } finally {
            inputsDesabilitados.forEach(el => { el.disabled = false; });
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check-lg me-1';
        }
    });

    // — Busca de cliente existente —

    function atualizarEstadoFooter() {
        if (clientesSelecionados.length > 0) {
            footerVincular.classList.remove('d-none');
            footerEscolha.classList.add('d-none');
            const label = clientesSelecionados.length === 1
                ? 'Vincular 1 Cliente'
                : `Vincular ${clientesSelecionados.length} Clientes`;
            btnConfirmarVincular.querySelector('span.btn-label') && (btnConfirmarVincular.querySelector('span.btn-label').textContent = label);
        } else {
            footerVincular.classList.add('d-none');
            footerEscolha.classList.remove('d-none');
        }
    }

    function criarChip(cliente) {
        const chip = document.createElement('span');
        chip.className = 'badge d-inline-flex align-items-center gap-1 ps-2 pe-1 py-1 rounded-pill border';
        chip.style.cssText = 'background:#e9f5ff; color:#0d6efd; border-color:#9ecbf5 !important; font-size:.78rem; font-weight:500;';
        chip.innerHTML = `
            <i class="bi ${cliente.tipo === 'PF' ? 'bi-person' : 'bi-building'} me-1"></i>
            ${escHtml(cliente.nome)}
            <button type="button" class="btn-close btn-close-sm ms-1" style="font-size:.55rem;" title="Remover" aria-label="Remover ${escHtml(cliente.nome)}"></button>`;
        chip.querySelector('.btn-close').addEventListener('click', () => removerSelecionado(cliente.id));
        return chip;
    }

    function escHtml(str) {
        return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function selecionarCliente(id, nome, documento, tipo) {
        if (clientesSelecionados.some(c => c.id === id)) {
            listaResultados.classList.add('d-none');
            inputBusca.value = '';
            return;
        }

        clientesSelecionados.push({ id, nome, documento, tipo });
        chipsWrapper.appendChild(criarChip({ id, nome, documento, tipo }));
        chipsContainer.classList.remove('d-none');
        listaResultados.classList.add('d-none');
        inputBusca.value = '';
        atualizarEstadoFooter();
    }

    function removerSelecionado(id) {
        clientesSelecionados = clientesSelecionados.filter(c => c.id !== id);
        chipsWrapper.innerHTML = '';
        clientesSelecionados.forEach(c => chipsWrapper.appendChild(criarChip(c)));
        if (clientesSelecionados.length === 0) {
            chipsContainer.classList.add('d-none');
        }
        atualizarEstadoFooter();
    }

    function limparSelecao() {
        clientesSelecionados = [];
        chipsWrapper.innerHTML = '';
        chipsContainer.classList.add('d-none');
        footerVincular.classList.add('d-none');
        footerEscolha.classList.remove('d-none');
    }

    async function executarBusca(termo) {
        if (termo.length < 2) {
            listaResultados.classList.add('d-none');
            return;
        }

        spinnerBusca.classList.remove('d-none');
        try {
            const resp = await fetch(urlBuscar + '?q=' + encodeURIComponent(termo), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });
            if (!resp.ok) return;

            const dados = await resp.json();
            listaResultados.innerHTML = '';

            if (dados.length === 0) {
                listaResultados.innerHTML = '<li class="list-group-item text-muted small py-2">Nenhum cliente encontrado.</li>';
            } else {
                dados.forEach(c => {
                    const jaSelecionado = clientesSelecionados.some(s => s.id === c.id);
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-2';
                    li.style.cursor = jaSelecionado ? 'default' : 'pointer';
                    if (jaSelecionado) li.classList.add('opacity-50');
                    li.innerHTML = `
                        <i class="bi ${c.tipo === 'PF' ? 'bi-person' : 'bi-building'} text-primary flex-shrink-0"></i>
                        <div class="overflow-hidden flex-fill">
                            <div class="fw-semibold text-truncate small">${escHtml(c.nome)}</div>
                            <div class="text-muted" style="font-size:.72rem;">${escHtml(c.documento)} · ${c.tipo}</div>
                        </div>
                        <i class="bi ${jaSelecionado ? 'bi-check-circle-fill text-success' : 'bi-plus-circle text-success'} flex-shrink-0"></i>`;
                    if (!jaSelecionado) {
                        li.addEventListener('click', () => selecionarCliente(c.id, c.nome, c.documento, c.tipo));
                    }
                    listaResultados.appendChild(li);
                });
            }

            listaResultados.classList.remove('d-none');
        } catch (_) {
            /* silencioso */
        } finally {
            spinnerBusca.classList.add('d-none');
        }
    }

    inputBusca.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => executarBusca(inputBusca.value.trim()), 300);
    });

    inputBusca.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            listaResultados.classList.add('d-none');
        }
    });

    document.addEventListener('click', e => {
        if (!listaResultados.contains(e.target) && e.target !== inputBusca) {
            listaResultados.classList.add('d-none');
        }
    });

    document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) {
            return;
        }

        if (form.matches('form.js-ajax-desvincular-cliente')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    alert(dados.erro ?? 'Erro ao desvincular cliente.');
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    removeClienteRow(dados.clienteId ?? '', form);
                    return;
                }

                alert(dados.erro ?? 'Erro ao desvincular cliente.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-desvincular-parte-contraria')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    alert(dados.erro ?? 'Erro ao desvincular parte contrária.');
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    removeParteContrariaRow(dados.parteContrariaId ?? '', form);
                    return;
                }

                alert(dados.erro ?? 'Erro ao desvincular parte contrária.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-desvincular-processo')) {
            event.preventDefault();
            if (!confirm('Desvincular o processo desta pasta?')) {
                return;
            }
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    alert(dados.erro ?? 'Erro ao desvincular processo.');
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    const content = document.getElementById('processoTabContent');
                    if (content) {
                        content.innerHTML =
                            '<div class="d-flex flex-column align-items-start gap-3">' +
                            '<p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhum processo judicial vinculado a esta pasta.</p>' +
                            '<button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalVincularProcesso">' +
                            '<i class="bi bi-plus-lg me-1"></i> Vincular Processo</button>' +
                            '</div>';
                    }
                    return;
                }

                alert(dados.erro ?? 'Erro ao desvincular processo.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-parte-contraria-form')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    alert(dados.erro ?? 'Erro ao adicionar parte contrária.');
                    return;
                }

                const dados = await resp.json();
                if (dados.sucesso && dados.parte) {
                    appendParteContrariaRow(dados.parte);
                    bootstrap.Modal.getInstance(document.getElementById('modalAdicionarParteContraria'))?.hide();
                    form.reset();
                    return;
                }

                alert('Parte contrária adicionada, mas não foi possível atualizar a lista.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }
    });

    btnConfirmarVincular.addEventListener('click', async () => {
        if (clientesSelecionados.length === 0) return;

        btnConfirmarVincular.disabled = true;
        const icone = btnConfirmarVincular.querySelector('i');
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        const erros = [];
        const vinculados = [];

        for (const cliente of clientesSelecionados) {
            try {
                const body = new FormData();
                body.append('cliente_id', String(cliente.id));
                body.append('_token', csrfVincular);

                const resp = await fetch(urlVincular, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body,
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    erros.push(dados.erro ?? `Erro ao vincular "${cliente.nome}".`);
                    continue;
                }

                const dados = await resp.json();
                if (dados.sucesso && dados.cliente) {
                    appendClienteRow(dados.cliente);
                    vinculados.push(cliente.id);
                } else {
                    erros.push(`"${cliente.nome}" vinculado, mas não foi possível atualizar a lista.`);
                }
            } catch (_) {
                erros.push(`Erro de comunicação ao vincular "${cliente.nome}".`);
            }
        }

        btnConfirmarVincular.disabled = false;
        if (icone) icone.className = 'bi bi-link-45deg me-1';

        if (erros.length > 0) {
            mostrarErro(erros.join(' '));
        }

        if (vinculados.length > 0 && erros.length === 0) {
            bootstrap.Modal.getInstance(modal)?.hide();
        } else if (vinculados.length > 0) {
            // Remove os que foram vinculados com sucesso, mantém os que deram erro
            vinculados.forEach(id => removerSelecionado(id));
        }
    });

    // — Fim busca de cliente existente —

    modal.querySelector('#btnEscolherPF').addEventListener('click', () => mostrar('pf'));
    modal.querySelector('#btnEscolherPJ').addEventListener('click', () => mostrar('pj'));
    modal.querySelector('#btnVoltarPF').addEventListener('click', voltar);
    modal.querySelector('#btnVoltarPJ').addEventListener('click', voltar);

    modal.addEventListener('hidden.bs.modal', () => { voltar(); limparSelecao(); });
}());
</script>

