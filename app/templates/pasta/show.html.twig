{# Modais: Editar Documento (todos os documentos da pasta — gerais e de seções) #}
{% for doc in pasta.documentos %}
        <div class="modal fade" id="editDocModal{{ doc.id }}" tabindex="-1" aria-labelledby="editDocModalLabel{{ doc.id }}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="{{ path('pasta_documento_edit', {id: doc.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_documento_' ~ doc.id) }}">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editDocModalLabel{{ doc.id }}">
                                <i class="bi bi-pencil me-1"></i> Editar documento
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            {% set ext = doc.nomeOriginal|split('.')|last %}
                            {% set nomeBase = doc.nomeOriginal ends with ('.' ~ ext) and doc.nomeOriginal != ext
                                ? doc.nomeOriginal|slice(0, doc.nomeOriginal|length - ext|length - 1)
                                : doc.nomeOriginal %}
                            <div class="mb-3">
                                <label class="form-label">Nome do arquivo</label>
                                <div class="input-group">
                                    <input type="text" name="nomeBase" class="form-control"
                                           value="{{ nomeBase }}" maxlength="250" required>
                                    <span class="input-group-text text-muted">.{{ ext }}</span>
                                </div>
                                <div class="form-text">A extensão <strong>.{{ ext }}</strong> é preservada automaticamente.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Tipo de documento</label>
                                <select name="categoria" class="form-select" required>
                                    {% for valor, texto in documentTypeOptions %}
                                        <option value="{{ valor }}" {{ doc.categoria == valor ? 'selected' : '' }}>{{ texto }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Descrição</label>
                                <input type="text" name="descricao" class="form-control"
                                       value="{{ doc.descricao ?? '' }}" maxlength="500" placeholder="Descrição (opcional)">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Número (opcional)</label>
                                <input type="text" name="numero" class="form-control"
                                       value="{{ doc.numero ?? '' }}" maxlength="255" placeholder="Número">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Salvar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
{% endfor %}



