                            </div>
                        </div>
                    </div>{# fim tab-modal-proc-partes #}

                    {# ABA: Movimentações #}
                    <div class="processo-modal-tab-content pt-3" id="tab-modal-proc-movimentacoes">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" id="mp-btn-add-movimentacao" class="btn btn-sm btn-info">
                                <i class="bi bi-plus-lg me-1"></i> Adicionar Movimentação
                            </button>
                        </div>
                        <div id="mp-movimentacoesContainer">
                            <div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label class="form-label">Data</label>
                                        <input type="date" name="movimentacoes[0][dataMovimentacao]" class="form-control">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Descrição</label>
                                        <input type="text" name="movimentacoes[0][descricao]" class="form-control" placeholder="Descrição da movimentação">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Tipo</label>
                                        <input type="text" name="movimentacoes[0][tipo]" class="form-control" placeholder="Tipo de movimento">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Órgão</label>
                                        <input type="text" name="movimentacoes[0][orgao]" class="form-control" placeholder="Órgão">
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                                        style="display: none; position: absolute; top: 8px; right: 12px;"
                                        title="Remover"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
