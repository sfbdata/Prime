{% extends 'base.html.twig' %}

{% block title %}Pasta {{ pasta.nup }}{% endblock %}

{% block body %}
{# Content Header #}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-folder2-open me-2"></i>{{ pasta.nup }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('expediente_index') }}">Pastas</a></li>
                    <li class="breadcrumb-item active">Detalhes</li>
                </ol>
            </div>
        </div>
    </div>
</div>

{# Main Content #}
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-folder me-1"></i> Pasta</h3>
                <div class="card-tools">
                    <span class="badge {{ pasta.status == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}">
                        {{ pasta.status == 'ativo' ? 'Ativo' : 'Arquivado' }}
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    {# Left Column - Tabs #}
                    <div class="col-12 col-md-12 col-lg-8 order-2 order-md-1">
                        {# Tabs #}
                        <ul class="nav nav-tabs" id="pastaTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true">
                                    <i class="bi bi-folder me-1"></i> Dados da Pasta
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tarefas-tab" data-bs-toggle="tab" data-bs-target="#tarefas" type="button" role="tab" aria-controls="tarefas" aria-selected="false">
                                    <i class="bi bi-check2-square me-1"></i> Tarefas
                                    {% if pasta.tarefas|length > 0 %}
                                        <span class="badge text-bg-secondary ms-1">{{ pasta.tarefas|length }}</span>
                                    {% endif %}
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="partes-tab" data-bs-toggle="tab" data-bs-target="#partes" type="button" role="tab" aria-controls="partes" aria-selected="false">
                                    <i class="bi bi-people me-1"></i> Partes
                                    {% set totalPartes = pasta.clientes|length + pasta.partesContrarias|length %}
                                    {% if totalPartes > 0 %}
                                        <span class="badge text-bg-secondary ms-1">{{ totalPartes }}</span>
                                    {% endif %}
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="processo-tab" data-bs-toggle="tab" data-bs-target="#processo" type="button" role="tab" aria-controls="processo" aria-selected="false">
                                    <i class="bi bi-briefcase me-1"></i> Processo
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="contrato-tab" data-bs-toggle="tab" data-bs-target="#contrato" type="button" role="tab" aria-controls="contrato" aria-selected="false">
                                    <i class="bi bi-file-earmark-text me-1"></i> Contrato
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="financeiro-tab" data-bs-toggle="tab" data-bs-target="#financeiro" type="button" role="tab" aria-controls="financeiro" aria-selected="false">
                                    <i class="bi bi-cash-coin me-1"></i> Financeiro
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="detalhes-tab" data-bs-toggle="tab" data-bs-target="#detalhes" type="button" role="tab" aria-controls="detalhes" aria-selected="false">
                                    <i class="bi bi-info-circle me-1"></i> Detalhes
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content mt-3" id="pastaTabsContent">
                            {# Tab: Dados da Pasta #}
                            <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
                                <h5 class="mb-3"><i class="bi bi-info-circle me-1"></i> Informações Gerais</h5>
                                <div class="row mb-4 g-3">
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1"><abbr title="Número Único de Pasta">NUP</abbr></p>
                                        <b>{{ pasta.nup }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.nup }}" title="Copiar"></i></b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1">Processo Vinculado</p>
                                        <b>
                                            {% if pasta.processo %}
                                                <a href="{{ path('processo_show', {id: pasta.processo.id}) }}">{{ pasta.processo.numeroProcesso }}</a>
                                                <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.processo.numeroProcesso }}" title="Copiar"></i>
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1">Data de Abertura</p>
                                        <b>{{ pasta.dataAbertura|date('d/m/Y') }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.dataAbertura|date('d/m/Y') }}" title="Copiar"></i></b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1">Responsável</p>
                                        <b>{{ pasta.responsavel ? pasta.responsavel.fullName : '—' }}</b>
                                    </div>
                                </div>

                                {% include 'pasta/_timeline.html.twig' with {timelineItems: timelineItems, pasta: pasta} only %}

                            </div>

                            {# Tab: Partes #}
                            <div class="tab-pane fade" id="partes" role="tabpanel" aria-labelledby="partes-tab">
                                <div class="row g-4">

                                    {# ── Clientes ── #}
                                    <div class="col-12 col-md-6">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0"><i class="bi bi-people me-1"></i> Clientes</h6>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    title="Adicionar cliente"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAdicionarCliente">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div id="clientesList">
                                            {% if pasta.clientes|length > 0 %}
                                                {% for cliente in pasta.clientes %}
                                                    {# Busca dados de documentos deste cliente #}
                                                    {% set clienteDocs = null %}
                                                    {% for item in clientesComDocumentos %}
                                                        {% if item.cliente.id == cliente.id %}
                                                            {% set clienteDocs = item %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    <div class="cliente-row mb-3 pb-3 border-bottom" data-cliente-id="{{ cliente.id }}">
                                                        {# Cabeçalho: nome + desvincular #}
                                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                                            <a href="{{ path('cliente_show', {id: cliente.id}) }}" class="text-decoration-none flex-grow-1 vinculo-link">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <i class="bi bi-person-circle text-muted"></i>
                                                                    <span class="fw-semibold text-primary">
                                                                        {% if cliente.cpf is defined and cliente.cpf %}
                                                                            {{ cliente.nomeCompleto }}
                                                                        {% else %}
                                                                            {{ cliente.razaoSocial }}
                                                                        {% endif %}
                                                                    </span>
                                                                </div>
                                                            </a>
                                                            <form method="post" action="{{ path('pasta_cliente_desvincular', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-desvincular-cliente m-0">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_desvincular_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Desvincular cliente da pasta">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </form>
                                                        </div>

                                                        {# Arquivos do cliente — inline, sem modal #}
                                                        {% if clienteDocs is not null %}
                                                            <div class="cliente-arquivos ps-1">
                                                                {# Documentos existentes #}
                                                                {% set hasDocCliente = false %}
                                                                {% for tipo, docs in clienteDocs.documentosPorTipo %}
                                                                    {% if docs|length > 0 %}{% set hasDocCliente = true %}{% endif %}
                                                                {% endfor %}

                                                                {% if hasDocCliente %}
                                                                    <div class="mb-2">
                                                                        {% for tipo, docs in clienteDocs.documentosPorTipo %}
                                                                            {% if docs|length > 0 %}
                                                                                {% set label = documentTypeOptionsCliente[tipo] ?? tipo %}
                                                                                <div class="text-muted small mb-1 mt-2">
                                                                                    <i class="bi bi-folder me-1"></i>{{ label }}
                                                                                </div>
                                                                                {% for doc in docs %}
                                                                                    <div class="d-flex align-items-center gap-2 rounded px-2 py-1 mb-1 doc-row-cliente">
                                                                                        <i class="bi bi-file-earmark-text text-primary flex-shrink-0"></i>
                                                                                        <span class="text-truncate flex-grow-1 small fw-semibold">{{ doc.nomeOriginal }}</span>
                                                                                        <small class="text-muted text-nowrap d-none d-sm-inline">{{ doc.uploadedAt|date('d/m/Y') }}</small>
                                                                                        <div class="d-flex gap-1 flex-shrink-0">
                                                                                            <button type="button" class="btn btn-xs btn-outline-primary"
                                                                                                    title="Visualizar"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#previewDocModal"
                                                                                                    data-url="{{ path('cliente_documento_view', {id: doc.id}) }}"
                                                                                                    data-nome="{{ doc.nomeOriginal }}"
                                                                                                    data-mime="{{ doc.mimeType }}">
                                                                                                <i class="bi bi-eye"></i>
                                                                                            </button>
                                                                                            <button type="button" class="btn btn-xs btn-outline-secondary"
                                                                                                    title="Editar"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#editDocClienteModal{{ doc.id }}">
                                                                                                <i class="bi bi-pencil"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </div>
                                                                                {% endfor %}
                                                                            {% endif %}
                                                                        {% endfor %}
                                                                    </div>
                                                                {% endif %}

                                                                {# Upload inline #}
                                                                <form method="post" enctype="multipart/form-data"
                                                                      action="{{ path('cliente_documento_upload', {id: cliente.id}) }}"
                                                                      class="form-upload-cliente-inline mt-2"
                                                                      data-cliente-id="{{ cliente.id }}">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_cliente_' ~ cliente.id) }}">
                                                                    <input type="file" id="fileInputCliente{{ cliente.id }}"
                                                                           multiple
                                                                           accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,audio/*,video/*"
                                                                           class="d-none file-input-cliente">

                                                                    <div id="listaUploadCliente{{ cliente.id }}" class="mb-2"></div>

                                                                    <div class="d-flex align-items-center gap-2">
                                                                        <button type="button"
                                                                                class="btn btn-xs btn-outline-primary btn-escolher-arquivo-cliente"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-paperclip me-1"></i> Anexar arquivo
                                                                        </button>
                                                                        <button type="submit"
                                                                                class="btn btn-xs btn-success btn-enviar-cliente d-none"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-cloud-upload me-1"></i> Enviar
                                                                        </button>
                                                                        <button type="button"
                                                                                class="btn btn-xs btn-outline-secondary btn-cancelar-cliente d-none"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-x"></i>
                                                                        </button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            {% elseif pasta.nomeCliente %}
                                                <div id="clientesPlaceholder" class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom">
                                                    <i class="bi bi-person-circle text-muted"></i>
                                                    <span>{{ pasta.nomeCliente }}</span>
                                                    <span class="badge text-bg-secondary ms-auto" style="font-size:.65rem;">não vinculado</span>
                                                </div>
                                            {% else %}
                                                <div id="clientesPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhum cliente vinculado.</div>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# ── Partes Contrárias ── #}
                                    <div class="col-md-6">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0"><i class="bi bi-person-x me-1"></i> Partes Contrárias</h6>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    title="Adicionar parte contrária"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAdicionarParteContraria">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div id="partesContrariasList">
                                            {% if pasta.partesContrarias|length > 0 %}
                                                {% for parte in pasta.partesContrarias %}
                                                    <div class="parte-contraria-row d-flex align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom" data-parte-contraria-id="{{ parte.id }}">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <i class="bi bi-person-dash text-muted"></i>
                                                            <span>{{ parte.nome }}</span>
                                                        </div>
                                                        <form method="post" action="{{ path('pasta_parte_contraria_desvincular', {id: pasta.id, parteContraria: parte.id}) }}" class="js-ajax-desvincular-parte-contraria m-0">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('pasta_parte_contraria_desvincular_' ~ pasta.id ~ '_' ~ parte.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Desvincular parte contrária da pasta">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                {% endfor %}
                                            {% else %}
                                                <div id="partesContrariasPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhuma parte contrária registrada.</div>
                                            {% endif %}
                                        </div>
                                    </div>

                                </div>
                            </div>

                            {# Tab: Processo #}
                            <div class="tab-pane fade" id="processo" role="tabpanel" aria-labelledby="processo-tab">
                                <div id="processoTabContent">
                                {% if pasta.processo %}
                                    <div class="row g-3">
                                        <div class="col-12 col-sm-6 col-lg-4">
                                            <p class="text-muted small mb-1">Número do Processo</p>
                                            <b>
                                                {{ pasta.processo.numeroProcesso }}
                                                <i class="bi bi-copy text-primary copy-btn ms-1" role="button"
                                                   data-copy="{{ pasta.processo.numeroProcesso }}" title="Copiar"></i>
                                            </b>
                                        </div>
                                        {% if pasta.processo.classeProcessual %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Classe Processual</p>
                                                <b>{{ pasta.processo.classeProcessual }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.assuntoProcessual %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Assunto</p>
                                                <b>{{ pasta.processo.assuntoProcessual }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.orgaoJulgador %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Órgão Julgador</p>
                                                <b>{{ pasta.processo.orgaoJulgador }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.siglaTribunal %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Tribunal</p>
                                                <b>{{ pasta.processo.siglaTribunal }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.instancia %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Instância</p>
                                                <b>{{ pasta.processo.instancia }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.situacaoProcesso %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Situação</p>
                                                <b>{{ pasta.processo.situacaoProcesso }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.dataDistribuicao %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Data de Distribuição</p>
                                                <b>{{ pasta.processo.dataDistribuicao|date('d/m/Y') }}</b>
                                            </div>
                                        {% endif %}
                                    </div>

                                    {% if pasta.processo.partes|length > 0 %}
                                        <hr>
                                        <h6 class="mb-3"><i class="bi bi-people me-1"></i> Partes do Processo</h6>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Nome</th>
                                                        <th>Tipo</th>
                                                        <th>Papel</th>
                                                        <th>Documento</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for parte in pasta.processo.partes %}
                                                        <tr>
                                                            <td>{{ parte.nome }}</td>
                                                            <td>{{ parte.tipo }}</td>
                                                            <td>{{ parte.papel ?? '—' }}</td>
                                                            <td>{{ parte.documento ?? '—' }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% endif %}

                                    <div class="mt-3 d-flex align-items-center gap-2">
                                        <a href="{{ path('processo_show', {id: pasta.processo.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Ver processo completo
                                        </a>
                                        <form method="post" action="{{ path('pasta_desvincular_processo', {id: pasta.id}) }}" class="js-ajax-desvincular-processo m-0">
                                            <input type="hidden" name="_token" value="{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Desvincular processo da pasta">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <div class="d-flex flex-column align-items-start gap-3">
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-info-circle me-1"></i>
                                            {% if pasta.nomeAcao %}
                                                Ação registrada: <strong>{{ pasta.nomeAcao }}</strong>. Nenhum processo judicial vinculado.
                                            {% else %}
                                                Nenhum processo judicial vinculado a esta pasta.
                                            {% endif %}
                                        </p>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalVincularProcesso">
                                            <i class="bi bi-plus-lg me-1"></i> Vincular Processo
                                        </button>
                                    </div>
                                {% endif %}
                                </div><!-- /processoTabContent -->
                            </div>

                            {# Tab: Contrato #}
                            <div class="tab-pane fade" id="contrato" role="tabpanel" aria-labelledby="contrato-tab">
                                <div class="d-flex flex-column align-items-start gap-3">
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-info-circle me-1"></i> Nenhum contrato vinculado a esta pasta.
                                    </p>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            disabled
                                            title="Em breve">
                                        <i class="bi bi-plus-lg me-1"></i> Adicionar Contrato
                                    </button>
                                </div>
                            </div>

                            {# Tab: Financeiro #}
                            <div class="tab-pane fade" id="financeiro" role="tabpanel" aria-labelledby="financeiro-tab">
                                <div class="d-flex flex-column align-items-start gap-3">
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-info-circle me-1"></i> Nenhum lançamento financeiro vinculado a esta pasta.
                                    </p>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            disabled
                                            title="Em breve">
                                        <i class="bi bi-plus-lg me-1"></i> Adicionar Lançamento
                                    </button>
                                </div>
                            </div>

                            {# Tab: Tarefas #}
                            <div class="tab-pane fade" id="tarefas" role="tabpanel" aria-labelledby="tarefas-tab">
                                {% if pasta.tarefas|length > 0 %}
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Título</th>
                                                    <th>Status</th>
                                                    <th>Prazo</th>
                                                    <th>Criada em</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for tarefa in pasta.tarefas %}
                                                    {% set prazoInfo = tarefa.prazoInfo %}
                                                    <tr>
                                                        <td>{{ tarefa.titulo }}</td>
                                                        <td>
                                                            {% if tarefa.status == 'pendente' %}
                                                                <span class="badge text-bg-warning">Pendente</span>
                                                            {% elseif tarefa.status == 'em_revisao' %}
                                                                <span class="badge text-bg-info">Em revisão</span>
                                                            {% elseif tarefa.status == 'concluida' %}
                                                                <span class="badge text-bg-success">Concluída</span>
                                                            {% elseif tarefa.status == 'reaberta' %}
                                                                <span class="badge text-bg-danger">Reaberta</span>
                                                            {% else %}
                                                                <span class="badge text-bg-secondary">{{ tarefa.status }}</span>
                                                            {% endif %}
                                                        </td>
                                                        <td>
                                                            {% if prazoInfo.texto != '-' %}
                                                                <span class="badge text-bg-{{ prazoInfo.cor }}">{{ prazoInfo.texto }}</span>
                                                            {% else %}
                                                                <span class="text-muted">—</span>
                                                            {% endif %}
                                                        </td>
                                                        <td>{{ tarefa.dataCriacao|date('d/m/Y') }}</td>
                                                        <td>
                                                            <a href="{{ path('tarefa_show', {id: tarefa.id}) }}"
                                                               class="btn-action btn-action-view"
                                                               title="Visualizar tarefa"
                                                               aria-label="Visualizar tarefa">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <p class="text-muted"><i class="bi bi-info-circle me-1"></i> Nenhuma tarefa vinculada a esta pasta.</p>
                                {% endif %}
                            </div>

                            {# Tab: Detalhes #}
                            <div class="tab-pane fade" id="detalhes" role="tabpanel" aria-labelledby="detalhes-tab">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-plus me-2"></i> Criado em
                                                <b class="d-block">{{ pasta.createdAt|date('d/m/Y H:i') }}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-check me-2"></i> Modificado em
                                                <b class="d-block">{% if pasta.modificadoEm %}{{ pasta.modificadoEm|date('d/m/Y H:i') }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-check me-2"></i> Criado por
                                                <b class="d-block">{% if pasta.criadoPor %}{{ pasta.criadoPor.fullName }}{% else %}-{% endif %}</b>
                                            </p>
                                            <p class="text-sm mb-2"><i class="bi bi-person-badge me-2"></i> Responsável
                                                <b class="d-block">{{ pasta.responsavel ? pasta.responsavel.fullName : '—' }}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    {# Right Column - Sidebar #}
                    <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2">
                        {# Card: Documentação #}
                        <div class="card card-primary card-outline mb-3">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-check2-square me-1"></i> Documentação</h3>
                            </div>
                            <div class="card-body">
                                {# Status #}
                                {% set totalCategorias = documentTypeOptions|length %}
                                {% set categoriasComDoc = 0 %}
                                {% for tipo, label in documentTypeOptions %}
                                    {% if (documentosPorTipo[tipo] ?? [])|length > 0 %}
                                        {% set categoriasComDoc = categoriasComDoc + 1 %}
                                    {% endif %}
                                {% endfor %}

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="text-muted mb-0"><i class="bi bi-check2-square me-1"></i> Checklist de Documentação</h6>
                                    <span class="badge {{ categoriasComDoc == totalCategorias ? 'text-bg-success' : 'text-bg-warning' }}">
                                        {{ categoriasComDoc == totalCategorias ? 'Completo' : 'Pendente de Documentação' }}
                                    </span>
                                </div>

                                <ul class="list-unstyled mb-0">
                                    {% for tipo, label in documentTypeOptions %}
                                        {% set temDoc = (documentosPorTipo[tipo] ?? [])|length > 0 %}
                                        <li class="mb-2">
                                            <i class="bi {{ temDoc ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }} me-2"></i>
                                            {{ label }}
                                        </li>
                                    {% endfor %}
                                </ul>

                                <hr>

                                {# Arquivos por categoria #}
                                <h6 class="text-muted mb-3"><i class="bi bi-folder me-1"></i> Arquivos da Pasta</h6>

                                {# Documentos já enviados #}
                                {% set hasDocuments = false %}
                                {% for tipo, docs in documentosPorTipo %}
                                    {% if docs|length > 0 %}{% set hasDocuments = true %}{% endif %}
                                {% endfor %}

                                {% if hasDocuments %}
                                <div class="mb-3">
                                    {% for tipo, docs in documentosPorTipo %}
                                        {% if docs|length > 0 %}
                                            {% set label = documentTypeOptions[tipo] ?? tipo %}
                                            {% for doc in docs %}
                                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-2 gap-3">
                                                    <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold">
                                                            {{ doc.nomeOriginal }}
                                                        </a>
                                                        <small class="text-muted">
                                                            {{ label }}
                                                            {% if doc.descricao %} · {{ doc.descricao }}{% endif %}
                                                            {% if doc.numero %} · Nº {{ doc.numero }}{% endif %}
                                                            · {{ doc.uploadedAt|date('d/m/Y') }}
                                                            · {{ (doc.tamanhoBytes / 1024 / 1024) < 1 ? (doc.tamanhoBytes / 1024)|round(1) ~ ' KB' : (doc.tamanhoBytes / 1024 / 1024)|round(2) ~ ' MB' }}
                                                        </small>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0">
                                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                                title="Visualizar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#previewDocModal"
                                                                data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                                data-nome="{{ doc.nomeOriginal }}"
                                                                data-mime="{{ doc.mimeType }}">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="Editar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editDocModal{{ doc.id }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <hr>
                                {% else %}
                                <p class="text-muted mb-3"><i class="bi bi-info-circle me-1"></i> Nenhum arquivo enviado.</p>
                                {% endif %}

                                {# Formulário de upload inline #}
                                <form id="formAnexos" method="post" enctype="multipart/form-data"
                                      action="{{ path('pasta_documento_upload', {id: pasta.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_pasta_' ~ pasta.id) }}">

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <button type="button" id="btnAdicionarAnexo" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                        </button>
                                        <button type="button" id="btnLimparAnexos" class="btn btn-sm btn-outline-secondary d-none">
                                            <i class="bi bi-x-circle me-1"></i> Limpar
                                        </button>
                                        <input type="file" id="inputAnexoOculto" multiple
                                               accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                                               class="d-none">
                                    </div>

                                    <div id="listaAnexos"></div>

                                    <div id="areaEnviar" class="d-none mt-3 text-end">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-cloud-upload me-1"></i> Enviar todos
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('expediente_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar às Pastas
                    </a>
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          class="d-flex"
                          onsubmit="return confirm('Tem certeza que deseja excluir esta pasta? Esta ação não pode ser desfeita.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <button type="submit"
                                class="btn btn-outline-danger btn-sm"
                                title="Excluir pasta"
                                aria-label="Excluir pasta">
                            <i class="bi bi-trash me-1"></i> Excluir Pasta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

{# Modal: Adicionar Cliente #}
