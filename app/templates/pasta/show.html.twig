<script>
(function () {
    var wrapper = document.querySelector('.pasta-responsavel-inline');
    if (!wrapper) return;

    var select   = wrapper.querySelector('.pasta-responsavel-select');
    var feedback = wrapper.querySelector('.pasta-responsavel-feedback');
    var url      = wrapper.dataset.url;
    var csrf     = wrapper.dataset.csrf;
    var timer    = null;

    select.addEventListener('change', function () {
        clearTimeout(timer);
        feedback.textContent = '';
        timer = setTimeout(function () {
            salvarResponsavel(select.value);
        }, 300);
    });

    function salvarResponsavel(responsavelId) {
        select.disabled = true;
        feedback.textContent = '…';
        feedback.style.color = '#6c757d';

        var body = new URLSearchParams({ _token: csrf, responsavel_id: responsavelId });

        fetch(url, {
            method: 'PATCH',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            select.disabled = false;
            if (!res.ok) {
                feedback.textContent = res.data.erro || 'Erro ao salvar.';
                feedback.style.color = '#dc3545';
                return;
            }
            feedback.textContent = '✓';
            feedback.style.color = '#198754';
            setTimeout(function () { feedback.textContent = ''; }, 2000);
        })
        .catch(function () {
            select.disabled = false;
            feedback.textContent = 'Erro de comunicação.';
            feedback.style.color = '#dc3545';
        });
    }
}());
</script>

{# ── Modal: Criar Tarefa ── #}
<div class="modal fade" id="modalCriarTarefa" tabindex="-1" aria-labelledby="modalCriarTarefaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="modalCriarTarefaLabel">
                    <i class="bi bi-list-task me-2"></i>Nova Meta
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form id="formCriarTarefa" method="post"
                  action="{{ path('tarefa_criar_para_pasta', {pastaId: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('tarefa_criar_' ~ pasta.id) }}">
                <div class="modal-body">

                    <div id="tarefaErroMsg" class="alert alert-danger d-none py-2 small"></div>

                    <div class="mb-3">
                        <label for="tarefaTitulo" class="form-label form-label-sm fw-semibold">Título <span class="text-danger">*</span></label>
                        <input type="text" id="tarefaTitulo" name="titulo"
                               class="form-control form-control-sm" maxlength="255" required
                               placeholder="Resumo objetivo da meta">
                    </div>

                    <div class="mb-3">
                        <label for="tarefaDescricao" class="form-label form-label-sm fw-semibold">Descrição <span class="text-danger">*</span></label>
                        <textarea id="tarefaDescricao" name="descricao"
                                  class="form-control form-control-sm" rows="3" required maxlength="5000"
                                  placeholder="Descreva o que precisa ser feito…"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="tarefaPrazo" class="form-label form-label-sm fw-semibold">Prazo</label>
                        <input type="date" id="tarefaPrazo" name="prazo" class="form-control form-control-sm">
                    </div>

                    <div>
                        <label for="tarefaResponsavel" class="form-label form-label-sm fw-semibold">Responsáveis</label>
                        <select id="tarefaResponsavel" name="responsaveis[]" class="form-select form-select-sm" multiple>
                            {% for u in usuarios %}
                                <option value="{{ u.id }}">{{ u.fullName }}</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">Selecione um ou mais responsáveis pela meta.</div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnEnviarTarefa" class="btn btn-primary btn-sm">
                        <i class="bi bi-send me-1"></i>Criar Tarefa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('formCriarTarefa');
    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        var btn = document.getElementById('btnEnviarTarefa');
        var erroBox = document.getElementById('tarefaErroMsg');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando…';
        erroBox.classList.add('d-none');

        var data = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: data,
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            if (res.data.sucesso) {
                // Redireciona para a tarefa criada
                window.location.href = '/tarefas/' + res.data.id;
            } else {
                erroBox.textContent = res.data.erro || 'Erro ao criar meta.';
                erroBox.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-1"></i>Criar Meta';
            }
        })
        .catch(function () {
            erroBox.textContent = 'Erro de comunicação. Tente novamente.';
            erroBox.classList.remove('d-none');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send me-1"></i>Criar Tarefa';
        });
    });
}());
</script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js" crossorigin="anonymous"></script>
<script>
(function () {
    'use strict';

    var PASTA_ID      = {{ pasta.id }};
    var CSRF_PASTA    = {{ csrf_token('checklist_pasta_' ~ pasta.id)|json_encode|raw }};
    var URL_ADD       = '/pasta/' + PASTA_ID + '/checklist';
    var URL_REORDER   = '/pasta/' + PASTA_ID + '/checklist/reordenar';
    function URL_TOGGLE(id)  { return '/pasta/' + PASTA_ID + '/checklist/' + id + '/toggle'; }
    function URL_EDIT(id)    { return '/pasta/' + PASTA_ID + '/checklist/' + id + '/editar'; }
    function URL_DELETE(id)  { return '/pasta/' + PASTA_ID + '/checklist/' + id + '/excluir'; }

    var lista           = document.getElementById('checklistLista');
    var badge           = document.getElementById('checklistBadge');
    var btnEditar       = document.getElementById('btnChecklistEditar');
    var btnAdicionar    = document.getElementById('btnChecklistAdicionar');
    var formAdicionar   = document.getElementById('checklistFormAdicionar');
    var inputNovo       = document.getElementById('checklistNovoTitulo');
    var btnSalvarNovo   = document.getElementById('btnChecklistSalvarNovo');
    var btnCancelarNovo = document.getElementById('btnChecklistCancelarNovo');
    var erroNovo        = document.getElementById('checklistErroNovo');

    if (!lista) { return; }

    var modoEdicao = false;
    var sortable   = null;

    function atualizarBadge() {
        var itens      = lista.querySelectorAll('.checklist-item');
        var total      = itens.length;
        var concluidos = [].filter.call(itens, function (li) {
            var icon = li.querySelector('.js-checklist-toggle i');
            return icon && icon.classList.contains('text-success');
        }).length;
        badge.textContent = concluidos + '/' + total + ' itens';
        badge.className   = 'badge ' + (total > 0 && concluidos === total ? 'text-bg-success' : 'text-bg-warning');
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    function escapeAttr(str) {
        return String(str).replace(/"/g, '&quot;');
    }

    // ── Toggle ────────────────────────────────────────────────────────────────

    lista.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-checklist-toggle');
        if (!btn) { return; }

        var li     = btn.closest('.checklist-item');
        var itemId = li.dataset.itemId;
        var csrf   = li.dataset.csrfItem;
        var icon   = btn.querySelector('i');

        btn.disabled = true;

        var fd = new FormData();
        fd.append('_token', csrf);

        fetch(URL_TOGGLE(itemId), {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.ok) { throw new Error(data.erro || 'Erro'); }

            var titulo = li.querySelector('.checklist-item-titulo');
            if (data.concluido) {
                icon.className = 'bi bi-check-circle-fill text-success fs-5';
                btn.title = 'Marcar como pendente';
                titulo.classList.add('text-decoration-line-through', 'text-muted');
            } else {
                icon.className = 'bi bi-x-circle-fill text-danger fs-5';
                btn.title = 'Marcar como concluído';
                titulo.classList.remove('text-decoration-line-through', 'text-muted');
            }
            atualizarBadge();
        })
        .catch(function (err) { console.error('Erro no toggle:', err); })
        .finally(function () { btn.disabled = false; });
    });

    // ── Modo edição ────────────────────────────────────────────────────────────

    btnEditar.addEventListener('click', function () {
        modoEdicao = !modoEdicao;
        btnEditar.classList.toggle('active', modoEdicao);

        lista.querySelectorAll('.checklist-item').forEach(function (li) {
            li.querySelector('.checklist-drag-handle').classList.toggle('d-none', !modoEdicao);
            li.querySelector('.js-checklist-excluir').classList.toggle('d-none', !modoEdicao);
            li.querySelector('.js-checklist-toggle').classList.toggle('d-none', modoEdicao);
        });

        if (modoEdicao) {
            sortable = new Sortable(lista, {
                handle: '.checklist-drag-handle',
                animation: 150,
                onEnd: function () {
                    var ids = [].map.call(lista.querySelectorAll('.checklist-item'), function (li) {
                        return parseInt(li.dataset.itemId, 10);
                    });
                    fetch(URL_REORDER, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify({ ids: ids, _token: CSRF_PASTA }),
                    })
                    .catch(function (err) { console.error('Erro ao reordenar:', err); });
                },
            });
        } else {
            if (sortable) { sortable.destroy(); sortable = null; }
        }
    });

    // ── Edição inline (dblclick no título) ────────────────────────────────────

    lista.addEventListener('dblclick', function (e) {
        if (!modoEdicao) { return; }
        var li = e.target.closest('.checklist-item');
        if (!li) { return; }

        var titulo = li.querySelector('.checklist-item-titulo');
        var input  = li.querySelector('.checklist-item-input');
        titulo.classList.add('d-none');
        input.classList.remove('d-none');
        input.focus();
        input.select();
    });

    lista.addEventListener('keydown', function (e) {
        var input = e.target.closest('.checklist-item-input');
        if (!input) { return; }
        if (e.key === 'Enter')  { salvarEdicaoItem(input); }
        if (e.key === 'Escape') { cancelarEdicaoItem(input); }
    });

    lista.addEventListener('blur', function (e) {
        var input = e.target.closest ? e.target.closest('.checklist-item-input') : null;
        if (input) { salvarEdicaoItem(input); }
    }, true);

    function salvarEdicaoItem(input) {
        var li     = input.closest('.checklist-item');
        var itemId = li.dataset.itemId;
        var csrf   = li.dataset.csrfItem;
        var titulo = input.value.trim();

        if (titulo === '') { cancelarEdicaoItem(input); return; }

        var fd = new FormData();
        fd.append('titulo', titulo);
        fd.append('_token', csrf);

        fetch(URL_EDIT(itemId), {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.ok) { throw new Error(data.erro || 'Erro'); }
            li.querySelector('.checklist-item-titulo').textContent = data.titulo;
            input.value = data.titulo;
            cancelarEdicaoItem(input);
        })
        .catch(function (err) {
            console.error('Erro ao editar item:', err);
            cancelarEdicaoItem(input);
        });
    }

    function cancelarEdicaoItem(input) {
        var li = input.closest('.checklist-item');
        input.classList.add('d-none');
        li.querySelector('.checklist-item-titulo').classList.remove('d-none');
    }

    // ── Excluir ───────────────────────────────────────────────────────────────

    lista.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-checklist-excluir');
        if (!btn) { return; }

        if (!confirm('Excluir este item do checklist?')) { return; }

        var li     = btn.closest('.checklist-item');
        var itemId = li.dataset.itemId;
        var csrf   = li.dataset.csrfItem;

        var fd = new FormData();
        fd.append('_token', csrf);

        fetch(URL_DELETE(itemId), {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.ok) { throw new Error(data.erro || 'Erro'); }
            li.remove();
            atualizarBadge();

            if (!lista.querySelector('.checklist-item')) {
                var vazio = document.createElement('li');
                vazio.id = 'checklistVazio';
                vazio.className = 'text-muted small py-2';
                vazio.innerHTML = 'Nenhum item. Clique em <i class="bi bi-plus-lg"></i> para adicionar.';
                lista.appendChild(vazio);
            }
        })
        .catch(function (err) { console.error('Erro ao excluir item:', err); });
    });

    // ── Adicionar item ────────────────────────────────────────────────────────

    btnAdicionar.addEventListener('click', function () {
        formAdicionar.classList.toggle('d-none');
        if (!formAdicionar.classList.contains('d-none')) {
            inputNovo.focus();
        }
    });

    btnCancelarNovo.addEventListener('click', function () {
        formAdicionar.classList.add('d-none');
        inputNovo.value = '';
        erroNovo.classList.add('d-none');
    });

    btnSalvarNovo.addEventListener('click', salvarNovoItem);

    inputNovo.addEventListener('keydown', function (e) {
        if (e.key === 'Enter')  { salvarNovoItem(); }
        if (e.key === 'Escape') { btnCancelarNovo.click(); }
    });

    function salvarNovoItem() {
        var titulo = inputNovo.value.trim();
        if (titulo === '') {
            erroNovo.textContent = 'O título não pode ser vazio.';
            erroNovo.classList.remove('d-none');
            return;
        }

        btnSalvarNovo.disabled = true;
        erroNovo.classList.add('d-none');

        var fd = new FormData();
        fd.append('titulo', titulo);
        fd.append('_token', CSRF_PASTA);

        fetch(URL_ADD, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.ok) { throw new Error(data.erro || 'Erro'); }

            var vazio = document.getElementById('checklistVazio');
            if (vazio) { vazio.remove(); }

            lista.appendChild(criarItemLi(data));
            inputNovo.value = '';
            formAdicionar.classList.add('d-none');
            atualizarBadge();
        })
        .catch(function (err) {
            erroNovo.textContent = err.message || 'Erro ao adicionar item.';
            erroNovo.classList.remove('d-none');
        })
        .finally(function () { btnSalvarNovo.disabled = false; });
    }

    function criarItemLi(data) {
        var li = document.createElement('li');
        li.className = 'checklist-item d-flex align-items-center gap-2 py-1 border-bottom';
        li.dataset.itemId   = data.id;
        li.dataset.csrfItem = data.csrfItem;

        var toggleDisplay = modoEdicao ? 'd-none' : '';
        var handleDisplay = modoEdicao ? '' : 'd-none';
        var excluirDisplay = modoEdicao ? '' : 'd-none';

        li.innerHTML =
            '<button type="button" class="btn btn-link p-0 border-0 js-checklist-toggle ' + toggleDisplay + '" title="Marcar como concluído">' +
                '<i class="bi bi-x-circle-fill text-danger fs-5"></i>' +
            '</button>' +
            '<span class="checklist-drag-handle ' + handleDisplay + ' text-muted" style="cursor:grab" title="Arrastar para reordenar"><i class="bi bi-grip-vertical"></i></span>' +
            '<span class="checklist-item-titulo flex-grow-1">' + escapeHtml(data.titulo) + '</span>' +
            '<input type="text" class="checklist-item-input form-control form-control-sm flex-grow-1 d-none" value="' + escapeAttr(data.titulo) + '" maxlength="255">' +
            '<button type="button" class="btn btn-sm btn-outline-danger js-checklist-excluir ' + excluirDisplay + '" title="Excluir item"><i class="bi bi-trash"></i></button>';

        return li;
    }

}());
</script>

<script>
(function () {
    'use strict';

    // Markup de seções migrado para a aba "Documentos" (public/js/pasta-arquivos.js).
    // Este bloco legado só opera se o markup antigo existir; senão, no-op silencioso.
    if (!document.getElementById('btnMostrarNovaSecao')) return;

    const PASTA_ID     = {{ pasta.id }};
    const CSRF_CRIAR   = '{{ csrf_token('pasta_secao_criar_' ~ pasta.id) }}';
    const TIPOS_DOC    = {{ documentTypeOptions|json_encode|raw }};
    let   indiceSecao  = 0;
    const URL_CRIAR  = '{{ path('pasta_secao_criar', {id: pasta.id}) }}';

    // ── Criar nova seção ─────────────────────────────────────────────────────

    const btnMostrar   = document.getElementById('btnMostrarNovaSecao');
    const novaSecaoBotao = document.getElementById('novaSecaoBotao');
    const novaSecaoForm  = document.getElementById('novaSecaoForm');
    const novaSecaoNome  = document.getElementById('novaSecaoNome');
    const btnSalvar    = document.getElementById('btnSalvarNovaSecao');
    const btnCancelar  = document.getElementById('btnCancelarNovaSecao');
    const novaSecaoErro = document.getElementById('novaSecaoErro');
    const cardNovaSecao = document.getElementById('cardNovaSecao');

    if (btnMostrar) {
        btnMostrar.addEventListener('click', () => {
            novaSecaoBotao.classList.add('d-none');
            novaSecaoForm.classList.remove('d-none');
            novaSecaoNome.focus();
        });
    }

    if (btnCancelar) {
        btnCancelar.addEventListener('click', () => {
            novaSecaoForm.classList.add('d-none');
            novaSecaoBotao.classList.remove('d-none');
            novaSecaoNome.value = '';
            novaSecaoErro.classList.add('d-none');
        });
    }

    if (novaSecaoNome) {
        novaSecaoNome.addEventListener('keydown', e => {
            if (e.key === 'Enter') btnSalvar.click();
            if (e.key === 'Escape') btnCancelar.click();
        });
    }

    if (btnSalvar) {
        btnSalvar.addEventListener('click', async () => {
            const nome = novaSecaoNome.value.trim();
            if (!nome) {
                novaSecaoErro.textContent = 'Informe o nome da seção.';
                novaSecaoErro.classList.remove('d-none');
                return;
            }
            novaSecaoErro.classList.add('d-none');
            btnSalvar.disabled = true;

            try {
                const resp = await fetch(URL_CRIAR, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ _token: CSRF_CRIAR, nome }),
                });
                const data = await resp.json();
                if (!resp.ok) {
                    novaSecaoErro.textContent = data.erro ?? 'Erro ao criar seção.';
                    novaSecaoErro.classList.remove('d-none');
                    return;
                }
                const novoCard = criarCardSecaoDom(data);
                cardNovaSecao.parentNode.insertBefore(novoCard, cardNovaSecao);
                inicializarSecaoCard(novoCard);
                novaSecaoNome.value = '';
                novaSecaoForm.classList.add('d-none');
                novaSecaoBotao.classList.remove('d-none');
            } catch (e) {
                novaSecaoErro.textContent = 'Erro de comunicação.';
                novaSecaoErro.classList.remove('d-none');
            } finally {
                btnSalvar.disabled = false;
            }
        });
    }

    function criarCardSecaoDom(data) {
        const id = data.id;
        const div = document.createElement('div');
        div.innerHTML = `
<div class="card card-outline card-secondary mb-3 pasta-secao-card"
     id="secaoCard${id}" data-secao-destino="${id}">
  <div class="card-header d-flex align-items-center py-2">
    <span class="pasta-secao-nome fw-semibold me-auto">${escapeHtml(data.nome)} <span class="badge text-bg-secondary ms-1 js-secao-contador">0 arquivos</span></span>
    <div class="d-flex align-items-center gap-1 ms-2">
      <button type="button" class="btn btn-sm btn-outline-secondary js-secao-renomear-btn" title="Renomear seção"
              data-secao-id="${id}" data-nome-atual="${escapeAttr(data.nome)}"
              data-csrf="${escapeAttr(data.csrfRenomear)}"
              data-url="/pasta/secao/${id}/renomear">
        <i class="bi bi-pencil"></i>
      </button>
      <button type="button" class="btn btn-sm btn-outline-danger js-secao-excluir-btn" title="Excluir seção"
              data-secao-id="${id}" data-nome="${escapeAttr(data.nome)}"
              data-csrf="${escapeAttr(data.csrfExcluir)}"
              data-url="/pasta/secao/${id}/excluir">
        <i class="bi bi-trash"></i>
      </button>
      <button type="button" class="btn btn-tool js-secao-toggle" data-bs-toggle="collapse"
              data-bs-target="#secaoBody${id}" aria-expanded="false">
        <i class="bi bi-chevron-down"></i>
      </button>
    </div>
  </div>
  <div class="collapse" id="secaoBody${id}">
    <div class="card-body secao-dropzone p-2" data-secao-destino="${id}">
      <div class="secao-drop-area rounded p-2 mb-2 text-center text-muted small"
           data-secao-destino="${id}"
           style="border:2px dashed #ced4da;min-height:52px;transition:background .15s;">
        <i class="bi bi-cloud-upload me-1"></i> Arraste arquivos do computador aqui
      </div>
      <form class="secao-upload-form" method="post" enctype="multipart/form-data"
            action="/pasta/${PASTA_ID}/documento/upload">
        <input type="hidden" name="_token" value="${escapeAttr(data.csrfUpload)}">
        <input type="hidden" name="secao_id" value="${id}">
        <div class="d-flex align-items-center gap-2 mb-2">
          <button type="button" class="btn btn-sm btn-primary js-secao-add-file" data-secao="${id}">
            <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary js-secao-limpar d-none" data-secao="${id}">
            <i class="bi bi-x-circle me-1"></i> Limpar
          </button>
          <input type="file" class="js-secao-file-input d-none" multiple
                 accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                 data-secao="${id}">
        </div>
        <div class="js-secao-lista-anexos" data-secao="${id}"></div>
        <div class="js-secao-area-enviar d-none mt-2" data-secao="${id}">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="reduzirTamanhoSecao${id}" name="reduzir_tamanho" value="1">
            <label class="form-check-label small" for="reduzirTamanhoSecao${id}">
              Reduzir tamanho dos arquivos (economiza espaço)
            </label>
          </div>
          <div class="form-text text-muted mb-2">
            Mantenha desligado para preservar a qualidade original.
            <span class="d-block text-warning-emphasis">
              <i class="bi bi-exclamation-triangle me-1"></i>
              PDFs assinados podem ter a assinatura invalidada ao reduzir o tamanho.
            </span>
          </div>
          <div class="text-end">
            <button type="submit" class="btn btn-sm btn-success">
              <i class="bi bi-cloud-upload me-1"></i> Enviar todos
            </button>
          </div>
        </div>
      </form>
      <div class="js-secao-docs" data-secao-destino="${id}"></div>
    </div>
  </div>
</div>`;
        return div.firstElementChild;
    }

    // ── Renomear / Excluir seção ─────────────────────────────────────────────

    function inicializarSecaoCard(card) {
        const btnRenomear = card.querySelector('.js-secao-renomear-btn');
        const btnExcluir  = card.querySelector('.js-secao-excluir-btn');
        const toggleBtn   = card.querySelector('.js-secao-toggle');

        if (btnRenomear) {
            btnRenomear.addEventListener('click', () => iniciarRenomear(btnRenomear));
        }
        if (btnExcluir) {
            btnExcluir.addEventListener('click', () => confirmarExcluir(btnExcluir));
        }
        if (toggleBtn) {
            toggleBtn.addEventListener('shown.bs.collapse', () => toggleBtn.querySelector('i').className = 'bi bi-chevron-up');
            toggleBtn.addEventListener('hidden.bs.collapse', () => toggleBtn.querySelector('i').className = 'bi bi-chevron-down');
        }

        const secaoHeader = card.querySelector('.card-header');
        if (secaoHeader && toggleBtn) {
            secaoHeader.addEventListener('click', function(e) {
                if (!e.target.closest('.btn-tool') &&
                    !e.target.closest('.js-secao-renomear-btn') &&
                    !e.target.closest('.js-secao-excluir-btn')) {
                    toggleBtn.click();
                }
            });
        }

        inicializarUploadSecao(card);
        inicializarDropZone(card);
        inicializarSortableDocs(card.querySelector('.js-secao-docs'));
    }

    function iniciarRenomear(btn) {
        const secaoId  = btn.dataset.secaoId;
        const nomeAtual = btn.dataset.nomeAtual;
        const card = document.getElementById('secaoCard' + secaoId);
        const nomeSpan = card.querySelector('.pasta-secao-nome');

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'form-control form-control-sm';
        input.value = nomeAtual;
        input.maxLength = 255;
        input.style.maxWidth = '200px';

        nomeSpan.replaceWith(input);
        input.focus();
        input.select();

        const salvar = async () => {
            const novo = input.value.trim();
            if (!novo) { input.focus(); return; }

            try {
                const resp = await fetch(btn.dataset.url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ _token: btn.dataset.csrf, nome: novo }),
                });
                const data = await resp.json();
                if (!resp.ok) { alert(data.erro ?? 'Erro ao renomear.'); return; }

                const span = document.createElement('span');
                span.className = 'pasta-secao-nome fw-semibold me-auto';
                span.textContent = data.nome;
                input.replaceWith(span);
                btn.dataset.nomeAtual = data.nome;
            } catch (e) {
                alert('Erro de comunicação.');
            }
        };

        const cancelar = () => {
            const span = document.createElement('span');
            span.className = 'pasta-secao-nome fw-semibold me-auto';
            span.textContent = nomeAtual;
            input.replaceWith(span);
        };

        input.addEventListener('keydown', e => {
            if (e.key === 'Enter') salvar();
            if (e.key === 'Escape') cancelar();
        });
        input.addEventListener('blur', salvar);
    }

    async function confirmarExcluir(btn) {
        const nome = btn.dataset.nome;
        if (!confirm(`Excluir a seção "${nome}" e todos os seus documentos? Esta ação não pode ser desfeita.`)) return;

        const secaoId = btn.dataset.secaoId;
        const card = document.getElementById('secaoCard' + secaoId);
        btn.disabled = true;

        try {
            const resp = await fetch(btn.dataset.url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ _token: btn.dataset.csrf }),
            });
            const data = await resp.json();
            if (!resp.ok) { alert(data.erro ?? 'Erro ao excluir.'); btn.disabled = false; return; }
            card.remove();
        } catch (e) {
            alert('Erro de comunicação.');
            btn.disabled = false;
        }
    }

    // ── Upload de arquivos na seção ──────────────────────────────────────────

    function formatarTamanhoSecao(bytes) {
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    function buildOpcoesSecao() {
        let html = '<option value="">Selecione o tipo</option>';
        for (const [v, t] of Object.entries(TIPOS_DOC)) {
            html += `<option value="${v}"${v === 'DEMAIS' ? ' selected' : ''}>${escapeHtml(t)}</option>`;
        }
        return html;
    }

    function adicionarItemSecao(file, listaDiv, atualizarFn) {
        const idx = indiceSecao++;
        const div = document.createElement('div');
        div.className = 'anexo-item';
        div.dataset.idx = idx;
        div._file = file;

        div.innerHTML = `
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-file-earmark-text fs-4 text-primary flex-shrink-0 mt-1"></i>
                <div class="flex-grow-1 min-w-0">
                    <div class="anexo-nome text-truncate">${escapeHtml(file.name)}</div>
                    <div class="anexo-tamanho mb-2">${formatarTamanhoSecao(file.size)}</div>
                    <div class="row g-2 align-items-end anexo-campos">
                        <div class="col-12 col-sm-5 col-lg-4">
                            <label class="form-label form-label-sm mb-1">Tipo de documento</label>
                            <select name="categorias[${idx}]" class="form-select form-select-sm" required>
                                ${buildOpcoesSecao()}
                            </select>
                        </div>
                        <div class="col-12 col-sm-7 col-lg-5">
                            <label class="form-label form-label-sm mb-1">Descrição</label>
                            <input type="text" name="descricoes[${idx}]" class="form-control form-control-sm"
                                   placeholder="Descrição (opcional)" maxlength="500">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-3">
                            <label class="form-label form-label-sm mb-1">Número <span class="text-muted fw-normal">(opcional)</span></label>
                            <input type="text" name="numeros[${idx}]" class="form-control form-control-sm"
                                   placeholder="Número" maxlength="255">
                        </div>
                    </div>
                    <div class="anexo-progresso d-none mt-2">
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar" role="progressbar" style="width:0%"></div>
                        </div>
                        <small class="anexo-status text-muted d-block mt-1"></small>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0 mt-1 btn-remover-anexo" title="Remover">
                    <i class="bi bi-trash"></i>
                </button>
            </div>`;

        div.querySelector('.btn-remover-anexo').addEventListener('click', function () {
            div.remove();
            atualizarFn();
        });

        listaDiv.appendChild(div);
    }

    function inicializarUploadSecao(card) {
        const btnAdd     = card.querySelector('.js-secao-add-file');
        const fileInput  = card.querySelector('.js-secao-file-input');
        const btnLimpar  = card.querySelector('.js-secao-limpar');
        const listaDiv   = card.querySelector('.js-secao-lista-anexos');
        const areaEnviar = card.querySelector('.js-secao-area-enviar');
        const form       = card.querySelector('.secao-upload-form');

        if (!btnAdd || !fileInput || !form) return;

        function atualizar() {
            const tem = listaDiv.querySelectorAll('.anexo-item').length > 0;
            areaEnviar.classList.toggle('d-none', !tem);
            btnLimpar.classList.toggle('d-none', !tem);
        }

        btnAdd.addEventListener('click', () => { fileInput.value = ''; fileInput.click(); });

        fileInput.addEventListener('change', () => {
            Array.from(fileInput.files).forEach(f => adicionarItemSecao(f, listaDiv, atualizar));
            atualizar();
        });

        btnLimpar.addEventListener('click', () => {
            listaDiv.innerHTML = '';
            fileInput.value = '';
            atualizar();
        });

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const itens = Array.from(listaDiv.querySelectorAll('.anexo-item'))
                .filter(function (it) { return it.dataset.enviado !== '1'; });
            if (itens.length === 0) return;

            const secaoId   = (form.querySelector('input[name="secao_id"]') || {}).value || null;
            const reduzir   = (card.querySelector('input[name="reduzir_tamanho"]') || {}).checked || false;
            const btnEnviar = form.querySelector('button[type="submit"]');
            const avisoOld  = areaEnviar.querySelector('.upload-lote-aviso');
            if (avisoOld) avisoOld.remove();
            if (btnEnviar) btnEnviar.disabled = true;
            btnAdd.disabled = true;
            btnLimpar.disabled = true;

            let ok = 0, falhas = 0;
            for (const item of itens) {
                const sucesso = await window.processarItemUploadPeca(item, secaoId, reduzir);
                sucesso ? ok++ : falhas++;
            }

            btnAdd.disabled = false;
            btnLimpar.disabled = false;
            if (btnEnviar) btnEnviar.classList.add('d-none');

            const classe = falhas === 0 ? 'alert-success' : 'alert-warning';
            const msg = falhas === 0
                ? `${ok} arquivo(s) enviado(s) com sucesso.`
                : `${ok} enviado(s), ${falhas} com erro.`;
            areaEnviar.insertAdjacentHTML('beforeend',
                `<div class="alert ${classe} mt-2 mb-0 py-2 small upload-lote-aviso d-flex flex-wrap align-items-center justify-content-between gap-2">
                   <span>${msg} Confira os detalhes acima.</span>
                   <button type="button" class="btn btn-sm btn-primary" onclick="location.reload()">Atualizar lista</button>
                 </div>`);
        });
    }

    // ── Drop zone — upload de arquivos do desktop ─────────────────────────────

    function inicializarDropZone(card) {
        const dropArea   = card.querySelector('.secao-drop-area');
        const fileInput  = card.querySelector('.js-secao-file-input');
        const listaDiv   = card.querySelector('.js-secao-lista-anexos');
        const btnLimpar  = card.querySelector('.js-secao-limpar');
        const areaEnviar = card.querySelector('.js-secao-area-enviar');

        if (!dropArea || !fileInput) return;

        function atualizar() {
            const tem = listaDiv.querySelectorAll('.anexo-item').length > 0;
            areaEnviar.classList.toggle('d-none', !tem);
            btnLimpar.classList.toggle('d-none', !tem);
        }

        dropArea.addEventListener('dragover', e => {
            if (!e.dataTransfer.types.includes('Files')) return;
            e.preventDefault();
            dropArea.style.background = '#e8f4fd';
        });

        dropArea.addEventListener('dragleave', () => { dropArea.style.background = ''; });

        dropArea.addEventListener('drop', e => {
            e.preventDefault();
            dropArea.style.background = '';

            if (e.dataTransfer.files.length > 0) {
                Array.from(e.dataTransfer.files).forEach(f => adicionarItemSecao(f, listaDiv, atualizar));
                atualizar();
            }
        });
    }

    // ── Reordenação e movimento de documentos via SortableJS ─────────────────

    const URL_REORDENAR_DOCS  = '/pasta/' + PASTA_ID + '/documentos/reordenar';
    const CSRF_REORDENAR_DOCS = '{{ csrf_token('reordenar_docs_pasta_' ~ pasta.id) }}';

    async function persistirOrdemDocumentos(container) {
        const ids = Array.from(container.querySelectorAll('.doc-item'))
            .map(el => parseInt(el.dataset.docId, 10));
        try {
            await fetch(URL_REORDENAR_DOCS, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ ids, _token: CSRF_REORDENAR_DOCS }),
            });
        } catch (e) {
            console.error('Erro ao reordenar documentos:', e);
        }
    }

    async function persistirMoverDocumento(docEl, toContainer) {
        const secaoDestinoRaw = toContainer.dataset.secaoDestino ?? '';
        const secaoId   = secaoDestinoRaw === 'geral' ? '' : secaoDestinoRaw;
        const urlMover  = docEl.dataset.urlMover;
        const csrfMover = docEl.dataset.csrfMover;

        try {
            const resp = await fetch(urlMover, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ _token: csrfMover, secao_id: secaoId }),
            });
            const data = await resp.json();
            if (!resp.ok) { alert(data.erro ?? 'Erro ao mover documento.'); return; }
            docEl.dataset.secaoId = secaoId;
        } catch (e) {
            alert('Erro de comunicação.');
        }
    }

    function atualizarContadorSecao(docsContainer) {
        const card = docsContainer.closest('.card');
        if (!card) return;
        const badge = card.querySelector('.js-secao-contador');
        if (!badge) return;
        const n = docsContainer.querySelectorAll('.doc-item').length;
        badge.textContent = n + ' ' + (n === 1 ? 'arquivo' : 'arquivos');
    }

    function inicializarSortableDocs(container) {
        if (!container || container._sortableDoc) return;
        container._sortableDoc = new Sortable(container, {
            group: 'docs-pasta',
            handle: '.doc-grip',
            animation: 150,
            onEnd: async function (evt) {
                if (evt.from === evt.to) {
                    await persistirOrdemDocumentos(evt.to);
                } else {
                    await persistirMoverDocumento(evt.item, evt.to);
                    await persistirOrdemDocumentos(evt.to);
                    atualizarContadorSecao(evt.from);
                    atualizarContadorSecao(evt.to);
                }
            },
        });
    }

    // ── Toggle do card geral "Documentação" ──────────────────────────────────

    const btnDocumentacaoToggle = document.getElementById('btnDocumentacaoToggle');
    if (btnDocumentacaoToggle) {
        const targetId = btnDocumentacaoToggle.dataset.bsTarget;
        const collapseEl = document.querySelector(targetId);
        if (collapseEl) {
            collapseEl.addEventListener('shown.bs.collapse', () => {
                btnDocumentacaoToggle.querySelector('i').className = 'bi bi-chevron-up';
                btnDocumentacaoToggle.setAttribute('aria-expanded', 'true');
            });
            collapseEl.addEventListener('hidden.bs.collapse', () => {
                btnDocumentacaoToggle.querySelector('i').className = 'bi bi-chevron-down';
                btnDocumentacaoToggle.setAttribute('aria-expanded', 'false');
            });
        }
    }

    // Clique em qualquer parte do header expande/recolhe o card de Documentação
    const docFolderHeader = document.querySelector('.doc-folder-header');
    if (docFolderHeader && btnDocumentacaoToggle) {
        docFolderHeader.addEventListener('click', function(e) {
            if (!e.target.closest('.btn-tool')) {
                btnDocumentacaoToggle.click();
            }
        });
    }

    // ── Inicializar cards existentes (seções sempre retraídas ao carregar) ────

    document.querySelectorAll('.pasta-secao-card').forEach(card => inicializarSecaoCard(card));
    inicializarSortableDocs(document.getElementById('documentosGerais'));

    // ── Helpers ───────────────────────────────────────────────────────────────

    function escapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function escapeAttr(s) {
        return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;');
    }

}());
</script>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="/js/pasta-arquivos.js"></script>
<script>
// Select2 múltiplo para os responsáveis no modal "Nova Meta".
// Roda neste bloco (após jQuery/Select2 do base) e usa dropdownParent para
// funcionar dentro do modal Bootstrap.
document.addEventListener('DOMContentLoaded', function () {
    if (typeof $ === 'undefined' || typeof $.fn === 'undefined' || typeof $.fn.select2 === 'undefined') {
        return;
    }
    $('#tarefaResponsavel').select2({
        placeholder: 'Selecione os responsáveis…',
        allowClear: true,
        width: '100%',
        dropdownParent: $('#modalCriarTarefa'),
    });
});
</script>
{% endblock %}
