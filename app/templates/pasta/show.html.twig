{% extends 'base.html.twig' %}

{% block title %}Pasta {{ pasta.nup }}{% endblock %}

{% block body %}
{# Content Header #}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-folder2-open me-2"></i>{{ pasta.nup }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('expediente_index') }}">Pastas</a></li>
                    <li class="breadcrumb-item active">Detalhes</li>
                </ol>
            </div>
        </div>
    </div>
</div>

{# Main Content #}
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header d-flex align-items-center">
                <h3 class="card-title mb-0"><i class="bi bi-folder me-1"></i> Pasta</h3>

                {# ── Barra de ações minimalistas ── #}
                <div class="pasta-acoes-bar d-flex align-items-center" style="margin-left: 3rem;">
                    <button type="button" class="pasta-acao-btn" title="Editar pasta"
                            data-bs-toggle="modal" data-bs-target="#modalEditarPasta">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button"
                            id="btn-alternar-status"
                            class="pasta-acao-btn {{ pasta.status == 'arquivado' ? 'pasta-acao-btn--arquivado' : '' }}"
                            title="{{ pasta.status == 'ativo' ? 'Arquivar pasta' : 'Reativar pasta' }}"
                            data-pasta-id="{{ pasta.id }}"
                            data-status-atual="{{ pasta.status }}"
                            data-csrf="{{ csrf_token('pasta_alternar_status_' ~ pasta.id) }}"
                            data-url="{{ path('pasta_alternar_status', {id: pasta.id}) }}">
                        <i class="bi {{ pasta.status == 'ativo' ? 'bi-archive' : 'bi-archive-fill' }}"></i>
                        <span class="pasta-acao-label">{{ pasta.status == 'ativo' ? 'Arquivar' : 'Ativar' }}</span>
                    </button>
                    <span class="pasta-acao-sep"></span>
                    <button type="button" class="pasta-acao-btn" title="Adiar">
                        <i class="bi bi-clock"></i>
                    </button>
                    <span class="pasta-acao-sep"></span>
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          onsubmit="return confirm('Tem certeza que deseja excluir a pasta {{ pasta.nup|e('js') }}?');"
                          class="d-contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <button type="submit" class="pasta-acao-btn pasta-acao-btn--danger" title="Excluir pasta">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                    <span class="pasta-acao-sep"></span>
                    <button type="button" class="pasta-acao-btn js-mover-para" title="Mover para marcador"
                            data-pasta-id="{{ pasta.id }}"
                            data-pasta-nome="{{ pasta.nup }}"
                            data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                            data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}">
                        <i class="bi bi-tag"></i>
                    </button>
                    <button type="button" class="pasta-acao-btn" title="Mais ações"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size:.85rem;min-width:170px;">
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-printer me-2 text-muted"></i>Imprimir
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-share me-2 text-muted"></i>Compartilhar
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card-tools ms-auto">
                    <span class="badge {{ pasta.status == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}">
                        {{ pasta.status == 'ativo' ? 'Ativo' : 'Arquivado' }}
                    </span>
                </div>
            </div>

            <style>
            .pasta-acoes-bar {
                gap: 2px;
                position: relative;
            }
            .pasta-acao-btn {
                background: none;
                border: none;
                padding: 6px 8px;
                color: #7bafd4;
                font-size: 1rem;
                border-radius: 50%;
                cursor: pointer;
                line-height: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background .15s, color .15s;
            }
            .pasta-acao-btn:hover {
                background: rgba(123,175,212,.15);
                color: #4a90c4;
            }
            .pasta-acao-btn--danger:hover {
                background: rgba(220,53,69,.10);
                color: #dc3545;
            }
            .pasta-acao-btn--arquivado {
                color: #fd7e14;
            }
            .pasta-acao-btn--arquivado:hover {
                background: rgba(253,126,20,.12);
                color: #e06200;
            }
            .pasta-acao-label {
                font-size: .75rem;
                margin-left: 4px;
                font-weight: 500;
                letter-spacing: .01em;
            }
            .pasta-acao-sep {
                width: 1px;
                height: 18px;
                background: #dadce0;
                margin: 0 4px;
                flex-shrink: 0;
            }
            .d-contents { display: contents; }
            </style>
            <div class="card-body">
                <div class="row">
                    {# Left Column - Tabs #}
                    <div class="col-12 col-md-12 col-lg-8 order-2 order-md-1">
                        {# Tabs #}
                        <ul class="nav nav-tabs" id="pastaTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true">
                                    <i class="bi bi-folder me-1"></i> Dados da Pasta
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tarefas-tab" data-bs-toggle="tab" data-bs-target="#tarefas" type="button" role="tab" aria-controls="tarefas" aria-selected="false">
                                    <i class="bi bi-check2-square me-1"></i> Tarefas
                                    {% if pasta.tarefas|length > 0 %}
                                        <span class="badge text-bg-secondary ms-1">{{ pasta.tarefas|length }}</span>
                                    {% endif %}
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="partes-tab" data-bs-toggle="tab" data-bs-target="#partes" type="button" role="tab" aria-controls="partes" aria-selected="false">
                                    <i class="bi bi-people me-1"></i> Partes
                                    {% set totalPartes = pasta.clientes|length + pasta.partesContrarias|length %}
                                    {% if totalPartes > 0 %}
                                        <span class="badge text-bg-secondary ms-1">{{ totalPartes }}</span>
                                    {% endif %}
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="processo-tab" data-bs-toggle="tab" data-bs-target="#processo" type="button" role="tab" aria-controls="processo" aria-selected="false">
                                    <i class="bi bi-briefcase me-1"></i> Processo
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="financeiro-tab" data-bs-toggle="tab" data-bs-target="#financeiro" type="button" role="tab" aria-controls="financeiro" aria-selected="false">
                                    <i class="bi bi-cash-coin me-1"></i> Financeiro
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="detalhes-tab" data-bs-toggle="tab" data-bs-target="#detalhes" type="button" role="tab" aria-controls="detalhes" aria-selected="false">
                                    <i class="bi bi-info-circle me-1"></i> Detalhes
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content mt-3" id="pastaTabsContent">
                            {# Tab: Dados da Pasta #}
                            <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
                                <h5 class="mb-3"><i class="bi bi-info-circle me-1"></i> Informações Gerais</h5>
                                <div class="row mb-4 g-3">
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1"><abbr title="Número Único de Pasta">NUP</abbr></p>
                                        <b>{{ pasta.nup }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.nup }}" title="Copiar"></i></b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1">Processo Vinculado</p>
                                        <b>
                                            {% if pasta.processo %}
                                                <a href="{{ path('processo_show', {id: pasta.processo.id}) }}">{{ pasta.processo.numeroProcesso }}</a>
                                                <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.processo.numeroProcesso }}" title="Copiar"></i>
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1">Data de Abertura</p>
                                        <b>{{ pasta.dataAbertura|date('d/m/Y') }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.dataAbertura|date('d/m/Y') }}" title="Copiar"></i></b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <p class="text-sm text-muted mb-1">Responsável</p>
                                        <div class="pasta-responsavel-inline" data-pasta-id="{{ pasta.id }}"
                                             data-url="{{ path('pasta_atualizar_responsavel', {id: pasta.id}) }}"
                                             data-csrf="{{ csrf_token('pasta_responsavel_' ~ pasta.id) }}">
                                            <select class="form-select form-select-sm pasta-responsavel-select"
                                                    style="max-width:180px;"
                                                    data-valor-atual="{{ pasta.responsavel ? pasta.responsavel.id : '' }}">
                                                <option value="">— Sem responsável —</option>
                                                {% for u in usuarios %}
                                                    <option value="{{ u.id }}"
                                                        {% if pasta.responsavel and pasta.responsavel.id == u.id %}selected{% endif %}>
                                                        {{ u.fullName }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                            <span class="pasta-responsavel-feedback ms-1" style="font-size:.75rem;"></span>
                                        </div>
                                    </div>
                                </div>

                                {% include 'pasta/_timeline.html.twig' with {timelineItems: timelineItems, pasta: pasta} only %}

                            </div>

                            {# Tab: Partes #}
                            <div class="tab-pane fade" id="partes" role="tabpanel" aria-labelledby="partes-tab">
                                <div class="row g-4">

                                    {# ── Clientes ── #}
                                    <div class="col-12 col-md-6">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0"><i class="bi bi-people me-1"></i> Clientes</h6>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    title="Adicionar cliente"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAdicionarCliente">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div id="clientesList">
                                            {% if pasta.clientes|length > 0 %}
                                                {% for cliente in pasta.clientes %}
                                                    {# Busca dados de documentos deste cliente #}
                                                    {% set clienteDocs = null %}
                                                    {% for item in clientesComDocumentos %}
                                                        {% if item.cliente.id == cliente.id %}
                                                            {% set clienteDocs = item %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    {# Conta total de docs deste cliente #}
                                                    {% set totalDocsCliente = 0 %}
                                                    {% if clienteDocs is not null %}
                                                        {% for tipo, docs in clienteDocs.documentosPorTipo %}
                                                            {% set totalDocsCliente = totalDocsCliente + docs|length %}
                                                        {% endfor %}
                                                    {% endif %}

                                                    <div class="cliente-row border-bottom" data-cliente-id="{{ cliente.id }}">
                                                        {# ── Linha compacta: toggle do accordion ── #}
                                                        <div class="d-flex align-items-center gap-2 py-2 px-1">
                                                            {# Toggle accordion #}
                                                            <button class="btn btn-link p-0 text-start text-decoration-none flex-grow-1 cliente-accordion-toggle"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#clienteAcc{{ cliente.id }}"
                                                                    aria-expanded="false"
                                                                    aria-controls="clienteAcc{{ cliente.id }}">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <i class="bi bi-person-circle text-muted fs-6"></i>
                                                                    <span class="fw-semibold text-primary small">
                                                                        {% if cliente.cpf is defined and cliente.cpf %}
                                                                            {{ cliente.nomeCompleto }}
                                                                        {% else %}
                                                                            {{ cliente.razaoSocial }}
                                                                        {% endif %}
                                                                    </span>
                                                                    {% if totalDocsCliente > 0 %}
                                                                        <span class="badge text-bg-secondary rounded-pill" style="font-size:.65rem;">{{ totalDocsCliente }}</span>
                                                                    {% endif %}
                                                                </div>
                                                            </button>

                                                            {# Ações rápidas: ir ao cliente + desvincular #}
                                                            <div class="d-flex gap-1 flex-shrink-0">
                                                                <a href="{{ path('cliente_show', {id: cliente.id}) }}"
                                                                   class="btn btn-xs btn-outline-secondary"
                                                                   title="Abrir ficha do cliente">
                                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                                </a>
                                                                <form method="post" action="{{ path('pasta_cliente_desvincular', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-desvincular-cliente m-0">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_desvincular_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                                                                    <button type="submit" class="btn btn-xs btn-outline-danger" title="Desvincular cliente da pasta">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>

                                                        {# ── Painel colapsável com arquivos + upload ── #}
                                                        <div class="collapse" id="clienteAcc{{ cliente.id }}">
                                                            <div class="cliente-acc-body pb-3 pt-1 px-1">

                                                                {# Documentos existentes #}
                                                                {% if clienteDocs is not null and totalDocsCliente > 0 %}
                                                                    <div class="mb-2">
                                                                        {% for tipo, docs in clienteDocs.documentosPorTipo %}
                                                                            {% if docs|length > 0 %}
                                                                                {% set label = documentTypeOptionsCliente[tipo] ?? tipo %}
                                                                                <div class="text-muted" style="font-size:.7rem;letter-spacing:.03em;text-transform:uppercase;margin-bottom:.25rem;margin-top:.6rem;">
                                                                                    <i class="bi bi-folder me-1"></i>{{ label }}
                                                                                </div>
                                                                                {% for doc in docs %}
                                                                                    <div class="d-flex align-items-center gap-2 rounded px-2 py-1 mb-1 doc-row-cliente">
                                                                                        <i class="bi bi-file-earmark-text text-primary flex-shrink-0" style="font-size:.85rem;"></i>
                                                                                        <span class="text-truncate flex-grow-1" style="font-size:.8rem;">{{ doc.nomeOriginal }}</span>
                                                                                        <small class="text-muted text-nowrap d-none d-sm-inline" style="font-size:.7rem;">{{ doc.uploadedAt|date('d/m/Y') }}</small>
                                                                                        <div class="d-flex gap-1 flex-shrink-0">
                                                                                            <button type="button" class="btn btn-xs btn-outline-primary"
                                                                                                    title="Visualizar"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#previewDocModal"
                                                                                                    data-url="{{ path('cliente_documento_view', {id: doc.id}) }}"
                                                                                                    data-nome="{{ doc.nomeOriginal }}"
                                                                                                    data-mime="{{ doc.mimeType }}">
                                                                                                <i class="bi bi-eye"></i>
                                                                                            </button>
                                                                                            <button type="button" class="btn btn-xs btn-outline-secondary"
                                                                                                    title="Editar"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#editDocClienteModal{{ doc.id }}">
                                                                                                <i class="bi bi-pencil"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </div>
                                                                                {% endfor %}
                                                                            {% endif %}
                                                                        {% endfor %}
                                                                    </div>
                                                                {% else %}
                                                                    <p class="text-muted small mb-2"><i class="bi bi-inbox me-1"></i>Nenhum arquivo anexado.</p>
                                                                {% endif %}

                                                                {# Upload inline — dentro do accordion #}
                                                                <form method="post" enctype="multipart/form-data"
                                                                      action="{{ path('cliente_documento_upload', {id: cliente.id}) }}"
                                                                      class="form-upload-cliente-inline"
                                                                      data-cliente-id="{{ cliente.id }}">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_cliente_' ~ cliente.id) }}">
                                                                    <input type="file" id="fileInputCliente{{ cliente.id }}"
                                                                           multiple
                                                                           accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,audio/*,video/*"
                                                                           class="d-none file-input-cliente">

                                                                    <div id="listaUploadCliente{{ cliente.id }}" class="mb-2"></div>

                                                                    <div class="d-flex align-items-center gap-2 mt-1">
                                                                        <button type="button"
                                                                                class="btn btn-xs btn-outline-primary btn-escolher-arquivo-cliente"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-paperclip me-1"></i> Anexar
                                                                        </button>
                                                                        <button type="submit"
                                                                                class="btn btn-xs btn-success btn-enviar-cliente d-none"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-cloud-upload me-1"></i> Enviar
                                                                        </button>
                                                                        <button type="button"
                                                                                class="btn btn-xs btn-outline-secondary btn-cancelar-cliente d-none"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-x"></i>
                                                                        </button>
                                                                    </div>
                                                                </form>

                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            {% elseif pasta.nomeCliente %}
                                                <div id="clientesPlaceholder" class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom">
                                                    <i class="bi bi-person-circle text-muted"></i>
                                                    <span>{{ pasta.nomeCliente }}</span>
                                                    <span class="badge text-bg-secondary ms-auto" style="font-size:.65rem;">não vinculado</span>
                                                </div>
                                            {% else %}
                                                <div id="clientesPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhum cliente vinculado.</div>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# ── Partes Contrárias ── #}
                                    <div class="col-md-6">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0"><i class="bi bi-person-x me-1"></i> Partes Contrárias</h6>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    title="Adicionar parte contrária"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAdicionarParteContraria">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div id="partesContrariasList">
                                            {% if pasta.partesContrarias|length > 0 %}
                                                {% for parte in pasta.partesContrarias %}
                                                    <div class="parte-contraria-row d-flex align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom" data-parte-contraria-id="{{ parte.id }}">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <i class="bi bi-person-dash text-muted"></i>
                                                            <span>{{ parte.nome }}</span>
                                                        </div>
                                                        <form method="post" action="{{ path('pasta_parte_contraria_desvincular', {id: pasta.id, parteContraria: parte.id}) }}" class="js-ajax-desvincular-parte-contraria m-0">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('pasta_parte_contraria_desvincular_' ~ pasta.id ~ '_' ~ parte.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Desvincular parte contrária da pasta">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                {% endfor %}
                                            {% else %}
                                                <div id="partesContrariasPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhuma parte contrária registrada.</div>
                                            {% endif %}
                                        </div>
                                    </div>

                                </div>
                            </div>

                            {# Tab: Processo #}
                            <div class="tab-pane fade" id="processo" role="tabpanel" aria-labelledby="processo-tab">
                                <div id="processoTabContent">
                                {% if pasta.processo %}
                                    <div class="row g-3">
                                        <div class="col-12 col-sm-6 col-lg-4">
                                            <p class="text-muted small mb-1">Número do Processo</p>
                                            <b>
                                                {{ pasta.processo.numeroProcesso }}
                                                <i class="bi bi-copy text-primary copy-btn ms-1" role="button"
                                                   data-copy="{{ pasta.processo.numeroProcesso }}" title="Copiar"></i>
                                            </b>
                                        </div>
                                        {% if pasta.processo.classeProcessual %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Classe Processual</p>
                                                <b>{{ pasta.processo.classeProcessual }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.assuntoProcessual %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Assunto</p>
                                                <b>{{ pasta.processo.assuntoProcessual }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.orgaoJulgador %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Órgão Julgador</p>
                                                <b>{{ pasta.processo.orgaoJulgador }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.siglaTribunal %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Tribunal</p>
                                                <b>{{ pasta.processo.siglaTribunal }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.instancia %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Instância</p>
                                                <b>{{ pasta.processo.instancia }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.situacaoProcesso %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Situação</p>
                                                <b>{{ pasta.processo.situacaoProcesso }}</b>
                                            </div>
                                        {% endif %}
                                        {% if pasta.processo.dataDistribuicao %}
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <p class="text-muted small mb-1">Data de Distribuição</p>
                                                <b>{{ pasta.processo.dataDistribuicao|date('d/m/Y') }}</b>
                                            </div>
                                        {% endif %}
                                    </div>

                                    {% if pasta.processo.partes|length > 0 %}
                                        <hr>
                                        <h6 class="mb-3"><i class="bi bi-people me-1"></i> Partes do Processo</h6>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Nome</th>
                                                        <th>Tipo</th>
                                                        <th>Papel</th>
                                                        <th>Documento</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for parte in pasta.processo.partes %}
                                                        <tr>
                                                            <td>{{ parte.nome }}</td>
                                                            <td>{{ parte.tipo }}</td>
                                                            <td>{{ parte.papel ?? '—' }}</td>
                                                            <td>{{ parte.documento ?? '—' }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% endif %}

                                    <div class="mt-3 d-flex align-items-center gap-2">
                                        <a href="{{ path('processo_show', {id: pasta.processo.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Ver processo completo
                                        </a>
                                        <form method="post" action="{{ path('pasta_desvincular_processo', {id: pasta.id}) }}" class="js-ajax-desvincular-processo m-0">
                                            <input type="hidden" name="_token" value="{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Desvincular processo da pasta">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <div class="d-flex flex-column align-items-start gap-3">
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-info-circle me-1"></i>
                                            {% if pasta.nomeAcao %}
                                                Ação registrada: <strong>{{ pasta.nomeAcao }}</strong>. Nenhum processo judicial vinculado.
                                            {% else %}
                                                Nenhum processo judicial vinculado a esta pasta.
                                            {% endif %}
                                        </p>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalVincularProcesso">
                                            <i class="bi bi-plus-lg me-1"></i> Vincular Processo
                                        </button>
                                    </div>
                                {% endif %}
                                </div><!-- /processoTabContent -->
                            </div>

                            {# Tab: Financeiro #}
                            <div class="tab-pane fade" id="financeiro" role="tabpanel" aria-labelledby="financeiro-tab">
                                {% include 'pasta/_financeiro.html.twig' with {
                                    pasta: pasta,
                                    documentosContrato: documentosContrato,
                                    observacoesFinanceiras: observacoesFinanceiras,
                                } only %}
                            </div>

                            {# Tab: Tarefas #}
                            <div class="tab-pane fade" id="tarefas" role="tabpanel" aria-labelledby="tarefas-tab">
                                {% set statusBadgeTarefa = {
                                    'pendente':   'text-bg-secondary',
                                    'em_revisao': 'text-bg-warning',
                                    'concluida':  'text-bg-success',
                                } %}
                                {% set statusLabelTarefa = {
                                    'pendente':   'Pendente',
                                    'em_revisao': 'Para Revisão',
                                    'concluida':  'Concluída',
                                } %}

                                <div class="d-flex justify-content-end mb-3">
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-bs-toggle="modal" data-bs-target="#modalCriarTarefa">
                                        <i class="bi bi-plus-lg me-1"></i>Criar Tarefa
                                    </button>
                                </div>

                                {% if pasta.tarefas|length > 0 %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for tarefa in pasta.tarefas %}
                                            {% set prazoInfo = tarefa.prazoInfo %}
                                            <a href="{{ path('tarefa_show', {id: tarefa.id}) }}"
                                               class="tarefa-card text-decoration-none status-{{ tarefa.status }}">
                                                <div class="tarefa-card-header">
                                                    <span class="tarefa-card-titulo">{{ tarefa.titulo }}</span>
                                                    <span class="badge {{ statusBadgeTarefa[tarefa.status] ?? 'text-bg-secondary' }} flex-shrink-0">
                                                        {{ statusLabelTarefa[tarefa.status] ?? tarefa.status }}
                                                    </span>
                                                </div>
                                                <div class="tarefa-card-meta">
                                                    <span title="Autor">
                                                        <i class="bi bi-person me-1"></i>
                                                        {{ tarefa.criadoPor ? tarefa.criadoPor.fullName : '—' }}
                                                    </span>
                                                    <span title="Responsável">
                                                        <i class="bi bi-person-check me-1"></i>
                                                        {{ tarefa.responsavel ? tarefa.responsavel.fullName : '—' }}
                                                    </span>
                                                    {% if prazoInfo.texto != '-' %}
                                                    <span class="text-{{ prazoInfo.cor }}" title="Prazo">
                                                        <i class="bi bi-calendar-event me-1"></i>{{ prazoInfo.texto }}
                                                    </span>
                                                    {% endif %}
                                                    <span class="ms-auto text-muted" title="Criada em">
                                                        <i class="bi bi-clock me-1"></i>{{ tarefa.dataCriacao|date('d/m/Y') }}
                                                    </span>
                                                    {% if tarefa.dataAlteracao %}
                                                    <span class="text-muted" title="Última alteração">
                                                        · mod. {{ tarefa.dataAlteracao|date('d/m/Y') }}
                                                    </span>
                                                    {% endif %}
                                                </div>
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-check2-square fs-1 d-block mb-2 opacity-25"></i>
                                        <span class="small">Nenhuma tarefa criada para esta pasta.</span>
                                    </div>
                                {% endif %}

                                {# Estilos dos cards de tarefa #}
                                <style>
                                .tarefa-card {
                                    display: block;
                                    border: 1px solid #e9ecef;
                                    border-radius: 8px;
                                    padding: 12px 14px;
                                    background: #fff;
                                    transition: box-shadow .15s, border-color .15s;
                                    color: inherit;
                                }
                                .tarefa-card:hover {
                                    box-shadow: 0 2px 10px rgba(0,0,0,.08);
                                    border-color: #c8cfe0;
                                    color: inherit;
                                }
                                .tarefa-card.status-em_revisao { border-left: 3px solid #ffc107; }
                                .tarefa-card.status-concluida  { border-left: 3px solid #198754; opacity: .75; }
                                .tarefa-card.status-pendente   { border-left: 3px solid #adb5bd; }
                                .tarefa-card-header {
                                    display: flex;
                                    align-items: flex-start;
                                    justify-content: space-between;
                                    gap: 8px;
                                    margin-bottom: 6px;
                                }
                                .tarefa-card-titulo {
                                    font-weight: 600;
                                    font-size: .88rem;
                                    color: #212529;
                                    flex: 1;
                                    min-width: 0;
                                }
                                .tarefa-card-meta {
                                    display: flex;
                                    flex-wrap: wrap;
                                    gap: 10px;
                                    font-size: .77rem;
                                    color: #6c757d;
                                    align-items: center;
                                }
                                </style>
                            </div>

                            {# Tab: Detalhes #}
                            <div class="tab-pane fade" id="detalhes" role="tabpanel" aria-labelledby="detalhes-tab">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-plus me-2"></i> Criado em
                                                <b class="d-block">{{ pasta.createdAt|date('d/m/Y H:i') }}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-check me-2"></i> Modificado em
                                                <b class="d-block">{% if pasta.modificadoEm %}{{ pasta.modificadoEm|date('d/m/Y H:i') }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-check me-2"></i> Criado por
                                                <b class="d-block">{% if pasta.criadoPor %}{{ pasta.criadoPor.fullName }}{% else %}-{% endif %}</b>
                                            </p>
                                            <p class="text-sm mb-2"><i class="bi bi-person-badge me-2"></i> Responsável
                                                <b class="d-block">{{ pasta.responsavel ? pasta.responsavel.fullName : '—' }}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                {% include 'pasta/_detalhes_obs.html.twig' with {
                                    pasta: pasta,
                                    observacoesDetalhes: observacoesDetalhes,
                                } only %}
                            </div>

                        </div>
                    </div>

                    {# Right Column - Sidebar #}
                    <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2">
                        {# Card: Documentação #}
                        <div class="card card-primary card-outline mb-3">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-check2-square me-1"></i> Documentação</h3>
                            </div>
                            <div class="card-body">
                                {# Checklist dinâmico #}
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="text-muted mb-0"><i class="bi bi-check2-square me-1"></i> Checklist de Documentação</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span id="checklistBadge" class="badge {{ concluidosChecklist == totalChecklist and totalChecklist > 0 ? 'text-bg-success' : 'text-bg-warning' }}">
                                            {{ concluidosChecklist }}/{{ totalChecklist }} itens
                                        </span>
                                        <button type="button" id="btnChecklistEditar" class="btn btn-sm btn-outline-secondary" title="Editar checklist">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" id="btnChecklistAdicionar" class="btn btn-sm btn-outline-primary" title="Adicionar item">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>

                                <ul id="checklistLista" class="list-unstyled mb-2">
                                    {% for item in checklistItens %}
                                    <li class="checklist-item d-flex align-items-center gap-2 py-1 border-bottom"
                                        data-item-id="{{ item.id }}"
                                        data-csrf-item="{{ csrf_token('checklist_item_' ~ item.id) }}">
                                        <button type="button" class="btn btn-link p-0 border-0 js-checklist-toggle" title="{{ item.concluido ? 'Marcar como pendente' : 'Marcar como concluído' }}">
                                            <i class="bi {{ item.concluido ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }} fs-5"></i>
                                        </button>
                                        <span class="checklist-drag-handle d-none text-muted" style="cursor:grab" title="Arrastar para reordenar">
                                            <i class="bi bi-grip-vertical"></i>
                                        </span>
                                        <span class="checklist-item-titulo flex-grow-1 {{ item.concluido ? 'text-decoration-line-through text-muted' : '' }}">
                                            {{ item.titulo|e }}
                                        </span>
                                        <input type="text" class="checklist-item-input form-control form-control-sm flex-grow-1 d-none"
                                               value="{{ item.titulo|e('html_attr') }}" maxlength="255">
                                        <button type="button" class="btn btn-sm btn-outline-danger js-checklist-excluir d-none" title="Excluir item">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </li>
                                    {% else %}
                                    <li id="checklistVazio" class="text-muted small py-2">
                                        Nenhum item. Clique em <i class="bi bi-plus-lg"></i> para adicionar.
                                    </li>
                                    {% endfor %}
                                </ul>

                                <div id="checklistFormAdicionar" class="d-none mb-2">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="checklistNovoTitulo" class="form-control" placeholder="Descrição do item..." maxlength="255">
                                        <button type="button" id="btnChecklistSalvarNovo" class="btn btn-primary"><i class="bi bi-check-lg"></i></button>
                                        <button type="button" id="btnChecklistCancelarNovo" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <div id="checklistErroNovo" class="text-danger small mt-1 d-none"></div>
                                </div>

                                <hr>

                                {# Arquivos por categoria #}
                                <h6 class="text-muted mb-3"><i class="bi bi-folder me-1"></i> Arquivos da Pasta</h6>

                                {# Formulário de upload inline #}
                                <form id="formAnexos" method="post" enctype="multipart/form-data"
                                      action="{{ path('pasta_documento_upload', {id: pasta.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_pasta_' ~ pasta.id) }}">

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <button type="button" id="btnAdicionarAnexo" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                        </button>
                                        <button type="button" id="btnLimparAnexos" class="btn btn-sm btn-outline-secondary d-none">
                                            <i class="bi bi-x-circle me-1"></i> Limpar
                                        </button>
                                        <input type="file" id="inputAnexoOculto" multiple
                                               accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                                               class="d-none">
                                    </div>

                                    <div id="listaAnexos"></div>

                                    <div id="areaEnviar" class="d-none mt-3 text-end">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-cloud-upload me-1"></i> Enviar todos
                                        </button>
                                    </div>
                                </form>

                                {# Documentos já enviados #}
                                {% set hasDocuments = false %}
                                {% for tipo, docs in documentosPorTipo %}
                                    {% if docs|length > 0 %}{% set hasDocuments = true %}{% endif %}
                                {% endfor %}

                                {% if hasDocuments %}
                                <hr>
                                <div class="mb-3">
                                    {% for tipo, docs in documentosPorTipo %}
                                        {% if docs|length > 0 %}
                                            {% set label = documentTypeOptions[tipo] ?? tipo %}
                                            {% for doc in docs %}
                                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-2 gap-3">
                                                    <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold">
                                                            {{ doc.nomeOriginal }}
                                                        </a>
                                                        <small class="text-muted">
                                                            {{ label }}
                                                            {% if doc.descricao %} · {{ doc.descricao }}{% endif %}
                                                            {% if doc.numero %} · Nº {{ doc.numero }}{% endif %}
                                                            · {{ doc.uploadedAt|date('d/m/Y') }}
                                                            · {{ (doc.tamanhoBytes / 1024 / 1024) < 1 ? (doc.tamanhoBytes / 1024)|round(1) ~ ' KB' : (doc.tamanhoBytes / 1024 / 1024)|round(2) ~ ' MB' }}
                                                        </small>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0">
                                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                                title="Visualizar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#previewDocModal"
                                                                data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                                data-nome="{{ doc.nomeOriginal }}"
                                                                data-mime="{{ doc.mimeType }}">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="Editar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editDocModal{{ doc.id }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('expediente_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar às Pastas
                    </a>
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          class="d-flex"
                          onsubmit="return confirm('Tem certeza que deseja excluir esta pasta? Esta ação não pode ser desfeita.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <button type="submit"
                                class="btn btn-outline-danger btn-sm"
                                title="Excluir pasta"
                                aria-label="Excluir pasta">
                            <i class="bi bi-trash me-1"></i> Excluir Pasta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

{# Modal: Adicionar Cliente #}
<div class="modal fade" id="modalAdicionarCliente" tabindex="-1" aria-labelledby="modalAdicionarClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width:560px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="modalAdicionarClienteLabel">
                    <i class="bi bi-person-plus me-1"></i> Adicionar Cliente
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form id="formNovoCliente" method="post" action="{{ path('pasta_cliente_novo', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_novo_' ~ pasta.id) }}">
                <input type="hidden" name="tipo" id="campoTipoCliente" value="">
                <input type="hidden" id="urlBuscarClientes" value="{{ path('pasta_clientes_buscar', {id: pasta.id}) }}">
                <input type="hidden" id="urlVincularCliente" value="{{ path('pasta_cliente_vincular', {id: pasta.id}) }}">
                <input type="hidden" id="csrfVincularCliente" value="{{ csrf_token('pasta_cliente_vincular_' ~ pasta.id) }}">

                <div class="modal-body">

                    <div id="alertaErroCliente" class="alert alert-danger alert-sm py-2 d-none" role="alert"></div>

                    {# — Passo 1: escolha do tipo — #}
                    <div id="passoEscolhaTipo">
                        <p class="text-muted small mb-3">Selecione o tipo de cliente para continuar:</p>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-outline-primary flex-fill py-3" id="btnEscolherPF">
                                <i class="bi bi-person fs-4 d-block mb-1"></i>
                                Pessoa Física
                            </button>
                            <button type="button" class="btn btn-outline-primary flex-fill py-3" id="btnEscolherPJ">
                                <i class="bi bi-building fs-4 d-block mb-1"></i>
                                Pessoa Jurídica
                            </button>
                        </div>

                        {# — Divisor — #}
                        <div class="d-flex align-items-center gap-2 my-4">
                            <hr class="flex-fill m-0">
                            <span class="text-muted small px-1 text-nowrap">ou selecione um cliente já cadastrado</span>
                            <hr class="flex-fill m-0">
                        </div>

                        {# — Busca de cliente existente — #}
                        <div class="position-relative">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text"
                                       id="buscaClienteExistente"
                                       class="form-control border-start-0 ps-0"
                                       placeholder="Buscar por nome, CPF ou CNPJ…"
                                       autocomplete="off">
                                <span class="input-group-text bg-white border-start-0 d-none" id="buscaClienteSpinner">
                                    <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                                </span>
                            </div>
                            <ul id="buscaClienteResultados"
                                class="list-group shadow-sm w-100 d-none mt-2"
                                style="z-index:1060; max-height:220px; overflow-y:auto;">
                            </ul>
                        </div>
                        <div id="clientesSelecionadosContainer" class="d-none mt-3">
                            <div id="clientesSelecionadosChips" class="d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>

                    {# — Formulário PF — #}
                    <div id="formPF" class="d-none">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <button type="button" class="btn btn-sm btn-link p-0 text-secondary" id="btnVoltarPF">
                                <i class="bi bi-arrow-left"></i>
                            </button>
                            <span class="fw-semibold"><i class="bi bi-person me-1"></i> Pessoa Física</span>
                        </div>

                        {# Abas PF #}
                        <ul class="nav nav-tabs nav-tabs-sm mb-3" id="tabsPF" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active py-1 px-3" id="pf-dados-tab"
                                        data-bs-toggle="tab" data-bs-target="#pf-dados"
                                        type="button" role="tab">
                                    Dados Pessoais
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1 px-3" id="pf-contato-tab"
                                        data-bs-toggle="tab" data-bs-target="#pf-contato"
                                        type="button" role="tab">
                                    Contato
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1 px-3" id="pf-endereco-tab"
                                        data-bs-toggle="tab" data-bs-target="#pf-endereco"
                                        type="button" role="tab">
                                    Endereço
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content" id="tabsPFContent">

                            {# PF — Dados Pessoais #}
                            <div class="tab-pane fade show active" id="pf-dados" role="tabpanel">
