{% extends 'base.html.twig' %}

{% block title %}Pasta {{ pasta.nup }}{% endblock %}

{% block body_class %}ps-body{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="/css/pasta-arquivos.css">
{# Redesenho da tela de pasta — desenho aprovado em docs/design/pasta-show/. #}
<link rel="stylesheet" href="/css/pasta-show.css">

{# O estilo do chip de responsável sobe para o <head>. Ele ficava no fim do
   <body>, a ~4.800 linhas de HTML do chip — e o chip agora abre a página, no
   cabeçalho. Nesse intervalo o navegador pintava a FOTO NO TAMANHO NATURAL:
   quem recorta a imagem no círculo de 24px é `.resp-avatar{overflow:hidden}` e
   `.resp-avatar-img img{width:100%}`, as duas aqui dentro. Estilo tem de chegar
   antes da marcação que ele dimensiona. #}
{{ include('pasta/_resp_estilo.html.twig') }}
{% endblock %}

{% block body %}
{# ============================================================================
   Redesenho aprovado: docs/design/pasta-show/ ("Pasta 1A.dc.html").

   O que mudou de ESTRUTURA nesta tela:
     · o cabeçalho virou cartão próprio (`pasta/_cabecalho.html.twig`), com as
       ações rotuladas, prioridade, etiquetas e a faixa de dados do caso;
     · as abas viraram controle segmentado, e cada painel é um cartão solto —
       não mais o miolo de um `.card-body` único;
     · o histórico automático do sistema saiu da página e virou drawer;
     · o rodapé sumiu: "Voltar às Pastas" virou o botão "Pastas" da linha 1 e
       "Excluir Pasta" foi para o menu ⋮.

   O chrome do topo (barra teal + EXPEDIENTE/DEMANDAS/PROCESSOS) NÃO foi tocado:
   pedido explícito do dono.
   ============================================================================ #}
<div class="ps-page">

    {{ include('pasta/_cabecalho.html.twig', {
        pasta: pasta,
        fotosResponsaveis: fotosResponsaveis|default({}),
        push: push,
        vizinhas: vizinhas,
        unidadeCobrada: unidadeCobrada|default(null),
    }) }}


            <style>
            .docs-list-scroll {
                max-height: 320px;
                overflow-y: auto;
            }
            .docs-list-scroll::-webkit-scrollbar { width: 5px; }
            .docs-list-scroll::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 3px; }
            .doc-item .doc-acoes { opacity: 0; transition: opacity .15s; }
            .doc-item:hover .doc-acoes { opacity: 1; }

            /* ── Card Documentação: visual de pasta ── */
            .doc-folder-wrapper {
                margin-top: 22px;
                position: relative;
            }
            .doc-folder-wrapper::before {
                content: '';
                position: absolute;
                top: -22px;
                left: 0;
                width: 52%;
                max-width: 175px;
                height: 22px;
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%);
                border-radius: 6px 10px 0 0;
                clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
            }
            .doc-folder-card.card.card-primary.card-outline {
                border-top-left-radius: 0 !important;
                border-color: #3f7bbf !important;
                box-shadow: 2px 3px 10px rgba(0,0,0,0.13);
            }
            .doc-folder-header {
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%) !important;
                border-bottom: none !important;
                border-top-right-radius: 4px !important;
                border-top-left-radius: 0 !important;
                padding: 0.6rem 1rem !important;
                cursor: pointer;
                user-select: none;
            }
            .doc-folder-header .card-title {
                color: #fff !important;
                font-size: 0.9rem;
            }
            .doc-folder-header .btn-tool {
                color: rgba(255,255,255,0.75) !important;
            }
            .doc-folder-header .btn-tool:hover {
                color: #fff !important;
            }
            .doc-folder-header .badge {
                background-color: rgba(255,255,255,0.22) !important;
                color: #fff !important;
                font-weight: 500;
            }
            @media (max-width: 575.98px) {
                .doc-folder-wrapper::before {
                    width: 48%;
                    max-width: 150px;
                    height: 20px;
                    top: -20px;
                }
                .doc-folder-wrapper { margin-top: 20px; }
            }

            /* ── Cards de seção: visual de pasta ── */
            .pasta-secao-card {
                margin-top: 22px;
                position: relative;
                overflow: visible !important;
                border-top-left-radius: 0 !important;
                border-color: #3f7bbf !important;
                box-shadow: 2px 3px 10px rgba(0,0,0,0.13);
            }
            .pasta-secao-card::before {
                content: '';
                position: absolute;
                top: -22px;
                left: 0;
                width: 52%;
                max-width: 175px;
                height: 22px;
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%);
                border-radius: 6px 10px 0 0;
                clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
            }
            .pasta-secao-card .card-header {
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%) !important;
                border-bottom: none !important;
                border-top-left-radius: 0 !important;
                cursor: pointer;
                user-select: none;
            }
            .pasta-secao-card .card-header .pasta-secao-nome {
                color: #fff;
            }
            .pasta-secao-card .card-header .badge {
                background-color: rgba(255,255,255,0.22) !important;
                color: #fff !important;
                font-weight: 500;
            }
            .pasta-secao-card .card-header .btn-tool {
                color: rgba(255,255,255,0.75) !important;
            }
            .pasta-secao-card .card-header .btn-tool:hover {
                color: #fff !important;
            }
            .pasta-secao-card .card-header .js-secao-renomear-btn,
            .pasta-secao-card .card-header .js-secao-excluir-btn {
                opacity: 0;
                transition: opacity .15s;
            }
            .pasta-secao-card .card-header:hover .js-secao-renomear-btn,
            .pasta-secao-card .card-header:hover .js-secao-excluir-btn {
                opacity: 1;
            }
            .pasta-secao-card .card-header .btn-outline-secondary,
            .pasta-secao-card .card-header .btn-outline-danger {
                color: rgba(255,255,255,0.8) !important;
                border-color: rgba(255,255,255,0.35) !important;
                background: transparent !important;
            }
            .pasta-secao-card .card-header .btn-outline-secondary:hover {
                color: #fff !important;
                background: rgba(255,255,255,0.15) !important;
                border-color: rgba(255,255,255,0.6) !important;
            }
            .pasta-secao-card .card-header .btn-outline-danger:hover {
                color: #fff !important;
                background: rgba(220,53,69,0.4) !important;
                border-color: rgba(255,255,255,0.6) !important;
            }
            @media (max-width: 575.98px) {
                .pasta-secao-card { margin-top: 20px; }
                .pasta-secao-card::before {
                    width: 48%;
                    max-width: 150px;
                    height: 20px;
                    top: -20px;
                }
            }
            </style>
    {# Os painéis das abas. O <ul class="nav-tabs"> saiu daqui: virou o controle
       segmentado da linha 3 do cabeçalho. Os `id` dos painéis não mudaram —
       são o alvo dos `data-bs-target` e do bootstrap.Tab do pasta-arquivos.js. #}
    <div class="tab-content ps-paineis" id="pastaTabsContent">
        {# ── Aba 1: Dados da Pasta ──────────────────────────────────────────
           Duas colunas: as anotações do caso no centro (a zona quente) e o
           trilho à direita com Próximos prazos, Clientes, Financeiro e
           Documentos — o que responde "em que pé está o caso" sem clicar aba
           por aba.

           O que saiu daqui: o histórico automático do sistema (foi para o
           drawer) e a faixa de processo/ação/responsável (subiu para o
           cabeçalho, que é comum a todas as abas). #}
        <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
            <div class="ps-grade">
                {{ include('pasta/_dados_anotacoes.html.twig', {
                    pasta: pasta,
                    anotacoes: anotacoes,
                }) }}

                <div class="ps-trilho">
                    {{ include('pasta/_dados_trilho.html.twig', {
                        pasta: pasta,
                        proximosPrazos: proximosPrazos,
                    }) }}
                </div>
            </div>
        </div>


                            {# Tab: Processo #}
                            <div class="tab-pane fade" id="processo" role="tabpanel" aria-labelledby="processo-tab">
                                <div id="processoTabContent">
                                {{ include('pasta/_processos_vinculados.html.twig') }}
                                </div><!-- /processoTabContent -->
                            </div>

                            {# Tab: Financeiro #}
                            <div class="tab-pane fade" id="financeiro" role="tabpanel" aria-labelledby="financeiro-tab">
                                {% include 'pasta/_financeiro.html.twig' with {
                                    pasta: pasta,
                                    documentosContrato: documentosContrato,
                                    observacoesFinanceiras: observacoesFinanceiras,
                                    financeiro: financeiro,
                                    pagamentos: pagamentos,
                                } only %}
                            </div>

                            {# Tab: Push Processual #}
                            <div class="tab-pane fade" id="push" role="tabpanel" aria-labelledby="push-tab">
                                {% include 'pasta/_push_processual.html.twig' with {
                                    pasta: pasta,
                                    push: push,
                                } only %}
                            </div>

                            {# Tab: Tarefas #}
                            <div class="tab-pane fade" id="tarefas" role="tabpanel" aria-labelledby="tarefas-tab">
                                {% set statusBadgeTarefa = {
                                    'pendente':   'text-bg-secondary',
                                    'em_revisao': 'text-bg-warning',
                                    'concluida':  'text-bg-success',
                                } %}
                                {% set statusLabelTarefa = {
                                    'pendente':   'Pendente',
                                    'em_revisao': 'Para Revisão',
                                    'concluida':  'Concluída',
                                } %}

                                <div class="d-flex justify-content-end mb-3">
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-bs-toggle="modal" data-bs-target="#modalCriarTarefa">
                                        <i class="bi bi-plus-lg me-1"></i>Criar Meta
                                    </button>
                                </div>

                                {% if pasta.tarefas|length > 0 %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for tarefa in pasta.tarefas %}
                                            {% set prazoInfo = tarefa.prazoInfo %}
                                            <a href="{{ path('tarefa_show', {id: tarefa.id}) }}"
                                               class="tarefa-card text-decoration-none status-{{ tarefa.status }}">
                                                <div class="tarefa-card-header">
                                                    <span class="tarefa-card-titulo">{{ tarefa.titulo }}</span>
                                                    <span class="badge {{ statusBadgeTarefa[tarefa.status] ?? 'text-bg-secondary' }} flex-shrink-0">
                                                        {{ statusLabelTarefa[tarefa.status] ?? tarefa.status }}
                                                    </span>
                                                </div>
                                                <div class="tarefa-card-meta">
                                                    <span title="Autor">
                                                        <i class="bi bi-person me-1"></i>
                                                        {{ tarefa.criadoPor ? tarefa.criadoPor.fullName : '—' }}
                                                    </span>
                                                    <span title="{% if tarefa.responsaveis|length > 0 %}Responsáveis: {{ tarefa.responsaveis|map(r => r.fullName)|join(', ') }}{% else %}Responsável{% endif %}">
                                                        <i class="bi bi-person-check me-1"></i>
                                                        {% if tarefa.responsaveis|length > 0 %}{{ (tarefa.responsaveis|first).fullName }}{% if tarefa.responsaveis|length > 1 %} +{{ tarefa.responsaveis|length - 1 }}{% endif %}{% else %}—{% endif %}
                                                    </span>
                                                    {% if prazoInfo.texto != '-' %}
                                                    <span class="text-{{ prazoInfo.cor }}" title="Prazo">
                                                        <i class="bi bi-calendar-event me-1"></i>{{ prazoInfo.texto }}
                                                    </span>
                                                    {% endif %}
                                                    <span class="ms-auto text-muted" title="Criada em">
                                                        <i class="bi bi-clock me-1"></i>{{ tarefa.dataCriacao|date('d/m/Y') }}
                                                    </span>
                                                    {% if tarefa.dataAlteracao %}
                                                    <span class="text-muted" title="Última alteração">
                                                        · mod. {{ tarefa.dataAlteracao|date('d/m/Y') }}
                                                    </span>
                                                    {% endif %}
                                                </div>
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-check2-square fs-1 d-block mb-2 opacity-25"></i>
                                        <span class="small">Nenhuma meta criada para esta pasta.</span>
                                    </div>
                                {% endif %}

                                {# Estilos dos cards de tarefa #}
                                <style>
                                .tarefa-card {
                                    display: block;
                                    border: 1px solid var(--bs-border-color);
                                    border-radius: 8px;
                                    padding: 12px 14px;
                                    background: var(--bs-body-bg);
                                    transition: box-shadow .15s, border-color .15s;
                                    color: inherit;
                                }
                                .tarefa-card:hover {
                                    box-shadow: 0 2px 10px rgba(0,0,0,.08);
                                    border-color: var(--bs-border-color);
                                    color: inherit;
                                }
                                .tarefa-card.status-em_revisao { border-left: 3px solid #ffc107; }
                                .tarefa-card.status-concluida  { border-left: 3px solid #198754; opacity: .75; }
                                .tarefa-card.status-pendente   { border-left: 3px solid var(--bs-secondary-color); }
                                .tarefa-card-header {
                                    display: flex;
                                    align-items: flex-start;
                                    justify-content: space-between;
                                    gap: 8px;
                                    margin-bottom: 6px;
                                }
                                .tarefa-card-titulo {
                                    font-weight: 600;
                                    font-size: .88rem;
                                    color: var(--bs-body-color);
                                    flex: 1;
                                    min-width: 0;
                                }
                                .tarefa-card-meta {
                                    display: flex;
                                    flex-wrap: wrap;
                                    gap: 10px;
                                    font-size: .77rem;
                                    color: var(--bs-secondary-color);
                                    align-items: center;
                                }
                                </style>
                            </div>

                            {# Tab: Detalhes #}
                            <div class="tab-pane fade" id="detalhes" role="tabpanel" aria-labelledby="detalhes-tab">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-plus me-2"></i> Criado em
                                                <b class="d-block">{{ pasta.criadoEm|date('d/m/Y H:i') }}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-check me-2"></i> Modificado em
                                                <b class="d-block">{% if pasta.modificadoEm %}{{ pasta.modificadoEm|date('d/m/Y H:i') }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-check me-2"></i> Criado por
                                                <b class="d-block">{% if pasta.criadoPor %}{{ pasta.criadoPor.fullName }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                {% include 'pasta/_detalhes_obs.html.twig' with {
                                    pasta: pasta,
                                    observacoesDetalhes: observacoesDetalhes,
                                } only %}
                            </div>

                            {# ==================== ABA: DOCUMENTOS (gerenciador de arquivos) ==================== #}
                            <div class="tab-pane fade" id="documentos" role="tabpanel" aria-labelledby="documentos-tab" tabindex="0">
                                {# Todos os documentos da pasta (gerais + de seções), taggeados por seção; JS filtra por pasta atual. #}
                                {% set arquivosFm = [] %}
                                {% for doc in pasta.documentos %}{% set arquivosFm = arquivosFm|merge([{'doc': doc, 'secao': doc.secao ? doc.secao.id : 'geral'}]) %}{% endfor %}

                                <div class="fm" id="fileManager"
                                     data-pasta-id="{{ pasta.id }}"
                                     data-url-upload="{{ path('pasta_peticionar_upload', {id: pasta.id}) }}"
                                     data-csrf-upload="{{ csrf_token('peticionar_upload_' ~ pasta.id) }}"
                                     data-url-criar-secao="{{ path('pasta_secao_criar', {id: pasta.id}) }}"
                                     data-csrf-criar-secao="{{ csrf_token('pasta_secao_criar_' ~ pasta.id) }}"
                                     data-url-reordenar-secoes="{{ path('pasta_secoes_reordenar', {id: pasta.id}) }}"
                                     data-csrf-reordenar-secoes="{{ csrf_token('reordenar_secoes_pasta_' ~ pasta.id) }}"
                                     data-url-reordenar-docs="{{ path('pasta_documentos_reordenar', {id: pasta.id}) }}"
                                     data-csrf-reordenar-docs="{{ csrf_token('reordenar_docs_pasta_' ~ pasta.id) }}"
                                     data-url-renomear-tpl="{{ path('pasta_secao_renomear', {secaoId: '__ID__'}) }}"
                                     data-url-excluir-tpl="{{ path('pasta_secao_excluir', {secaoId: '__ID__'}) }}"
                                     data-url-mover-tpl="{{ path('pasta_secao_mover', {secaoId: '__ID__'}) }}"
                                     data-arvore="1">

                                    {# Toolbar #}
                                    <div class="fm-toolbar">
                                        <nav class="fm-breadcrumb" aria-label="Navegação de pastas">
                                            <button type="button" class="fm-crumb" data-nav="root"><i class="bi bi-folder2-open"></i> Documentos</button>
                                            <span class="fm-crumb-sep fm-oculto" id="fmCrumbSep"><i class="bi bi-chevron-right"></i></span>
                                            <span class="fm-crumb-atual fm-oculto" id="fmCrumbAtual"></span>
                                        </nav>
                                        <div class="fm-busca">
                                            <i class="bi bi-search"></i>
                                            <input type="search" id="fmBusca" placeholder="Buscar arquivos..." autocomplete="off" aria-label="Buscar arquivos">
                                        </div>
                                        <div class="fm-acoes">
                                            <button type="button" class="btn btn-sm btn-primary" id="fmNovaPasta"><i class="bi bi-folder-plus me-1"></i> Nova pasta</button>
                                            <button type="button" class="btn btn-sm btn-outline-primary" id="fmUpload"><i class="bi bi-upload me-1"></i> Enviar</button>
                                            <input type="file" id="fmFileInput" multiple class="d-none" accept=".png,.jpg,.jpeg,.pdf,.kml,.xml,.xls,.xlsx,.doc,.docx,.txt,.zip,.mp3,.ogg,.opus,.m4a,.mp4,.mov">
                                            <div class="fm-view-toggle" role="group" aria-label="Modo de exibição">
                                                <button type="button" class="fm-view-btn ativo" data-view="lista" title="Lista" aria-label="Lista"><i class="bi bi-list-ul"></i></button>
                                                <button type="button" class="fm-view-btn" data-view="grade" title="Grade" aria-label="Grade"><i class="bi bi-grid-3x3-gap-fill"></i></button>
                                            </div>
                                            <select class="fm-select" id="fmOrdenar" aria-label="Ordenar arquivos por">
                                                <option value="manual">Manual (arrastar)</option>
                                                <option value="nome">Nome (A–Z)</option>
                                                <option value="nome_desc">Nome (Z–A)</option>
                                                <option value="data_desc">Mais recentes</option>
                                                <option value="data">Mais antigos</option>
                                                <option value="tamanho_desc">Maiores</option>
                                                <option value="tamanho">Menores</option>
                                                <option value="categoria">Categoria (A–Z)</option>
                                                <option value="categoria_desc">Categoria (Z–A)</option>
                                            </select>
                                        </div>
                                    </div>

                                    {# Barra de progresso de upload #}
                                    <div class="fm-upload-bar" id="fmUploadBar">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                        <span class="fm-upload-nome" id="fmUploadNome"></span>
                                        <div class="progress" role="progressbar" aria-label="Progresso do upload"><div class="progress-bar" id="fmUploadProgresso" style="width:0%"></div></div>
                                        <span class="text-muted small text-nowrap" id="fmUploadContador"></span>
                                    </div>

                                    <div class="fm-body" id="fmBody">

                                        {# Coluna principal: pastas e arquivos. O checklist é a
                                           coluna da direita, logo abaixo. #}
                                        <div class="fm-col-principal">
                                        {# Pastas (só na raiz) #}
                                        <div class="fm-grupo" id="fmGrupoPastas">
                                            <div class="fm-grupo-titulo"><i class="bi bi-folder2"></i> Pastas</div>
                                            <div class="fm-pastas" id="fmPastas">
                                                {% for secao in secoes %}
                                                    <div class="fm-pasta" data-secao-id="{{ secao.id }}" data-nome="{{ secao.nome|e('html_attr') }}"
                                                         data-url-renomear="{{ path('pasta_secao_renomear', {secaoId: secao.id}) }}"
                                                         data-csrf-renomear="{{ csrf_token('pasta_secao_renomear_' ~ secao.id) }}"
                                                         data-url-excluir="{{ path('pasta_secao_excluir', {secaoId: secao.id}) }}"
                                                         data-csrf-excluir="{{ csrf_token('pasta_secao_excluir_' ~ secao.id) }}"
                                                         data-pai-id="{{ secao.pai ? secao.pai.id : '' }}"
                                                         data-url-mover="{{ path('pasta_secao_mover', {secaoId: secao.id}) }}"
                                                         data-csrf-mover="{{ csrf_token('pasta_secao_mover_' ~ secao.id) }}"
                                                         data-subpastas="{{ contagemSecoes[secao.id].subpastas|default(0) }}"
                                                         data-arquivos="{{ contagemSecoes[secao.id].arquivos|default(0) }}"
                                                         tabindex="0" role="button" aria-label="Abrir pasta {{ secao.nome|e('html_attr') }}">
                                                        <span class="fm-pasta-grip" title="Arrastar para reordenar"><i class="bi bi-grip-vertical"></i></span>
                                                        <span class="fm-pasta-icone"><i class="bi bi-folder-fill"></i></span>
                                                        <span class="fm-pasta-info">
                                                            <span class="fm-pasta-nome" title="{{ secao.nome|e('html_attr') }}">{{ secao.nome }}</span>
                                                            <span class="fm-pasta-contagem" data-secao-contagem="{{ secao.id }}">{{ secao.documentos|length }} {{ secao.documentos|length == 1 ? 'arquivo' : 'arquivos' }}</span>
                                                        </span>
                                                        <div class="dropdown">
                                                            <button class="fm-pasta-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ações da pasta" onclick="event.stopPropagation()"><i class="bi bi-three-dots-vertical"></i></button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><button class="dropdown-item fm-pasta-abrir" type="button"><i class="bi bi-folder2-open me-2"></i>Abrir</button></li>
                                                                <li><button class="dropdown-item fm-pasta-renomear" type="button"><i class="bi bi-pencil me-2"></i>Renomear</button></li>
                                                                <li><button class="dropdown-item fm-pasta-mover" type="button"><i class="bi bi-folder-symlink me-2"></i>Mover para...</button></li>
                                                                <li><hr class="dropdown-divider"></li>
                                                                <li><button class="dropdown-item text-danger fm-pasta-excluir" type="button"><i class="bi bi-trash me-2"></i>Excluir</button></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>

                                        {# Arquivos #}
                                        <div class="fm-grupo" id="fmGrupoArquivos">
                                            <div class="fm-grupo-titulo"><i class="bi bi-files"></i> <span id="fmArquivosTitulo">Arquivos</span></div>
                                            <div class="fm-arquivos fm-lista" id="fmArquivos">
                                                {# Clicar no titulo da coluna ordena por ela; clicar de novo inverte.
                                                   E o mesmo estado do seletor "Ordenar" ao lado — os dois sao duas caras
                                                   do mesmo `fmOrdem`, e mudar num atualiza o outro. Sem isso a tela
                                                   mostraria duas ordens diferentes ao mesmo tempo. #}
                                                <div class="fm-lista-head">
                                                    <span class="fmh-grip"></span>
                                                    <span class="fmh-nome" aria-sort="none">
                                                        <button type="button" class="fmh-btn" data-ordenar="nome" title="Ordenar por nome">Nome<i class="bi fmh-caret" aria-hidden="true"></i></button>
                                                    </span>
                                                    <span class="fmh-tipo" aria-sort="none">
                                                        <button type="button" class="fmh-btn" data-ordenar="categoria" title="Ordenar por categoria">Categoria<i class="bi fmh-caret" aria-hidden="true"></i></button>
                                                    </span>
                                                    <span class="fmh-tam" aria-sort="none">
                                                        <button type="button" class="fmh-btn" data-ordenar="tamanho" title="Ordenar por tamanho">Tamanho<i class="bi fmh-caret" aria-hidden="true"></i></button>
                                                    </span>
                                                    <span class="fmh-data" aria-sort="none">
                                                        <button type="button" class="fmh-btn" data-ordenar="data" title="Ordenar por modificado">Modificado<i class="bi fmh-caret" aria-hidden="true"></i></button>
                                                    </span>
                                                    <span class="fmh-acoes"></span>
                                                </div>
                                                {% for item in arquivosFm %}
                                                    {% set doc = item.doc %}
                                                    {% set secaoKey = item.secao %}
                                                    {% set ic = arquivo_icone(doc.nomeOriginal, doc.mimeType) %}
                                                    <div class="fm-arquivo" data-secao="{{ secaoKey }}" data-doc-id="{{ doc.id }}" data-ordem="{{ doc.ordem }}"
                                                         data-nome="{{ doc.nomeOriginal|e('html_attr') }}" data-tamanho="{{ doc.tamanhoBytes }}"
                                                         data-data="{{ doc.carregadoEm|date('Y-m-d H:i:s') }}" data-tipo="{{ ic.rotulo|e('html_attr') }}"
                                                         data-mime="{{ doc.mimeType|e('html_attr') }}"
                                                         {# Ordena pelo RÓTULO que a coluna mostra. Ordenar pela chave do
                                                            enum agruparia certo e listaria numa ordem que a tela não
                                                            exibe — o usuário veria o alfabeto errado. #}
                                                         data-categoria="{{ (documentTypeOptions[doc.categoria] ?? doc.categoria)|e('html_attr') }}"
                                                         data-url-mover="{{ path('pasta_documento_mover_secao', {docId: doc.id}) }}"
                                                         data-csrf-mover="{{ csrf_token('pasta_doc_mover_' ~ doc.id) }}">
                                                        <span class="fm-arq-grip" title="Arrastar para reordenar"><i class="bi bi-grip-vertical"></i></span>
                                                        <div class="fm-arq-principal">
                                                            <span class="fm-arq-icone"><i class="bi {{ ic.icone }}" style="color: {{ ic.cor }}"></i></span>
                                                            <span class="text-truncate">
                                                                {# Clicar no nome ABRE O PRE-VISUALIZADOR (que ja tem o botao Baixar no
                                                                   rodape), nao baixa. Baixar sem olhar obriga a abrir o arquivo fora do
                                                                   sistema so para saber se era o certo.

                                                                   Continua sendo <a> de verdade, apontando para a URL de visualizacao:
                                                                   ctrl/cmd+clique e o botao do meio seguem abrindo em outra aba, e sem
                                                                   JS o link ainda leva ao arquivo. Quem intercepta o clique simples e
                                                                   o pasta-arquivos.js, pela classe .fm-arq-preview. #}
                                                                <a href="{{ path('pasta_documento_view', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer"
                                                                   class="fm-arq-nome fm-arq-preview"
                                                                   data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                                   data-nome="{{ doc.nomeOriginal|e('html_attr') }}"
                                                                   data-mime="{{ doc.mimeType|e('html_attr') }}"
                                                                   title="{{ doc.nomeOriginal|e('html_attr') }}">{{ doc.nomeOriginal }}</a>
                                                                <span class="fm-arq-sub">{% if doc.numero %}Nº {{ doc.numero }}{% if doc.descricao %} · {% endif %}{% endif %}{{ doc.descricao ?? '' }}</span>
                                                                <span class="fm-arq-local fm-oculto text-muted small"></span>
                                                            </span>
                                                        </div>
                                                        <div class="fm-arq-tipo"><span class="fm-badge-cat">{{ documentTypeOptions[doc.categoria] ?? doc.categoria }}</span></div>
                                                        <div class="fm-arq-tam">{{ doc.tamanhoBytes|formatar_bytes }}</div>
                                                        <div class="fm-arq-data">{{ doc.carregadoEm|date('d/m/Y') }}</div>
                                                        <div class="fm-arq-acoes">
                                                            <div class="dropdown">
                                                                <button class="fm-arq-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ações do arquivo"><i class="bi bi-three-dots-vertical"></i></button>
                                                                <ul class="dropdown-menu dropdown-menu-end">
                                                                    <li><a class="dropdown-item" href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener"><i class="bi bi-download me-2"></i>Baixar</a></li>
                                                                    <li><button type="button" class="dropdown-item fm-arq-preview" data-url="{{ path('pasta_documento_view', {id: doc.id}) }}" data-nome="{{ doc.nomeOriginal|e('html_attr') }}" data-mime="{{ doc.mimeType|e('html_attr') }}"><i class="bi bi-eye me-2"></i>Visualizar</button></li>
                                                                    <li><button type="button" class="dropdown-item fm-arq-editar" data-target="#editDocModal{{ doc.id }}"><i class="bi bi-pencil me-2"></i>Editar</button></li>
                                                                    <li><button type="button" class="dropdown-item fm-arq-mover"><i class="bi bi-folder-symlink me-2"></i>Mover para…</button></li>
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li>
                                                                        <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Excluir este arquivo? Esta ação não pode ser desfeita.');">
                                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Excluir</button>
                                                                        </form>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <div class="fm-vazio fm-oculto" id="fmArquivosVazio">
                                                <div class="fm-vazio-icone"><i class="bi bi-cloud-arrow-up"></i></div>
                                                <div class="fm-vazio-titulo">Nenhum arquivo aqui</div>
                                                <div class="fm-vazio-dica">Arraste arquivos do computador para esta área ou clique em <strong>Enviar</strong>.</div>
                                            </div>
                                        </div>
                                        </div>{# /fm-col-principal #}

                                        {# ── Checklist de documentação — coluna da DIREITA ──
                                           Estava numa faixa de largura total no topo do gerenciador,
                                           empurrando pastas e arquivos para baixo. Aqui ele acompanha
                                           a conferência de lado, sem disputar a vertical com o que a
                                           aba existe para mostrar.

                                           Os `id` são contrato com o JS de marcar/editar/reordenar
                                           mais abaixo nesta página: mudaram de LUGAR, não de nome. #}
                                        {% set pctChecklist = totalChecklist > 0 ? (concluidosChecklist / totalChecklist * 100)|round : 0 %}
                                        {% set checklistCompleto = totalChecklist > 0 and concluidosChecklist == totalChecklist %}
                                        <div class="fm-grupo" id="fmChecklist">
                                            <div class="fm-checklist">
                                                <div class="fm-checklist-corpo">
                                                    <div class="fm-checklist-cab">
                                                        <i class="bi bi-check2-square"></i>
                                                        <h6>Checklist de documentação</h6>
                                                        <span id="checklistBadge" class="fm-checklist-selo {{ checklistCompleto ? 'completo' : 'incompleto' }}">{{ concluidosChecklist }}/{{ totalChecklist }} itens</span>
                                                    </div>
                                                    {# A barra diz de relance o que a contagem só diz depois de lida. #}
                                                    <div class="fm-checklist-progresso">
                                                        <div class="fm-checklist-barra" role="progressbar"
                                                             aria-label="Itens concluídos do checklist"
                                                             aria-valuenow="{{ concluidosChecklist }}" aria-valuemin="0" aria-valuemax="{{ totalChecklist }}">
                                                            <div id="checklistBarra" class="fm-checklist-barra-fill {{ checklistCompleto ? 'completo' : 'incompleto' }}" style="width: {{ pctChecklist }}%"></div>
                                                        </div>
                                                        <button type="button" id="btnChecklistModelos" class="fm-checklist-acao" title="Modelos de checklist"
                                                                aria-expanded="false" aria-controls="checklistModelosPainel">
                                                            <i class="bi bi-bookmarks"></i>
                                                        </button>
                                                        <button type="button" id="btnChecklistEditar" class="fm-checklist-acao" title="Editar checklist">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" id="btnChecklistAdicionar" class="fm-checklist-acao" title="Adicionar item">
                                                            <i class="bi bi-plus-lg"></i>
                                                        </button>
                                                    </div>
                                                    <ul id="checklistLista" class="list-unstyled mb-2">
                                                        {% for item in checklistItens %}
                                                        <li class="checklist-item d-flex align-items-center gap-2 py-1 border-bottom"
                                                            data-item-id="{{ item.id }}"
                                                            data-csrf-item="{{ csrf_token('checklist_item_' ~ item.id) }}">
                                                            <button type="button" class="btn btn-link p-0 border-0 js-checklist-toggle" title="{{ item.concluido ? 'Marcar como pendente' : 'Marcar como concluído' }}">
                                                                <i class="bi {{ item.concluido ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }} fs-5"></i>
                                                            </button>
                                                            <span class="checklist-drag-handle d-none text-muted" style="cursor:grab" title="Arrastar para reordenar">
                                                                <i class="bi bi-grip-vertical"></i>
                                                            </span>
                                                            <span class="checklist-item-titulo flex-grow-1 {{ item.concluido ? 'text-decoration-line-through text-muted' : '' }}">
                                                                {{ item.titulo|e }}
                                                            </span>
                                                            <input type="text" class="checklist-item-input form-control form-control-sm flex-grow-1 d-none"
                                                                   value="{{ item.titulo|e('html_attr') }}" maxlength="255">
                                                            <button type="button" class="btn btn-sm btn-outline-danger js-checklist-excluir d-none" title="Excluir item">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </li>
                                                        {% else %}
                                                        <li id="checklistVazio" class="text-muted small py-2">
                                                            Nenhum item. Clique em <i class="bi bi-plus-lg"></i> para adicionar.
                                                        </li>
                                                        {% endfor %}
                                                    </ul>
                                                    <div id="checklistFormAdicionar" class="d-none mb-1">
                                                        <div class="input-group input-group-sm">
                                                            <input type="text" id="checklistNovoTitulo" class="form-control" placeholder="Descrição do item..." maxlength="255">
                                                            <button type="button" id="btnChecklistSalvarNovo" class="btn btn-primary"><i class="bi bi-check-lg"></i></button>
                                                            <button type="button" id="btnChecklistCancelarNovo" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
                                                        </div>
                                                        <div id="checklistErroNovo" class="text-danger small mt-1 d-none"></div>
                                                    </div>

                                                    {# ── Modelos de checklist ──────────────────────────
                                                       Painel INLINE, não modal: o gerenciador de arquivos
                                                       é animado, e ancestral com `transform` prende modal
                                                       abaixo do backdrop (foi o defeito de 28/08 nesta
                                                       mesma tela). Inline também deixa a lista da pasta
                                                       visível enquanto se escolhe o modelo.
                                                       A lista é carregada por AJAX na primeira abertura. #}
                                                    <div id="checklistModelosPainel" class="fm-checklist-modelos d-none"
                                                         data-url-listar="{{ path('pasta_checklist_modelo_listar', {id: pasta.id}) }}"
                                                         data-url-salvar="{{ path('pasta_checklist_modelo_salvar', {id: pasta.id}) }}"
                                                         data-csrf-pasta="{{ csrf_token('checklist_modelo_pasta_' ~ pasta.id) }}">
                                                        <div class="fm-checklist-modelos-cab">
                                                            <i class="bi bi-bookmarks"></i>
                                                            <span>Modelos do escritório</span>
                                                            <button type="button" id="btnChecklistModelosFechar" class="fm-checklist-modelos-fechar" title="Fechar">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </div>

                                                        <div id="checklistModelosCarregando" class="fm-checklist-modelos-nota d-none">Carregando…</div>
                                                        <div id="checklistModelosVazio" class="fm-checklist-modelos-nota d-none">
                                                            Nenhum modelo salvo ainda. Monte o checklist desta pasta e salve abaixo para reaproveitá-lo nas próximas.
                                                        </div>
                                                        <ul id="checklistModelosLista" class="list-unstyled mb-0"></ul>

                                                        <div class="fm-checklist-modelos-salvar">
                                                            <label class="fm-checklist-modelos-rotulo" for="checklistModeloNome">Salvar o checklist desta pasta como modelo</label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" id="checklistModeloNome" class="form-control" placeholder="Nome do modelo..." maxlength="120">
                                                                <button type="button" id="btnChecklistModeloSalvar" class="btn btn-primary" title="Salvar como modelo">
                                                                    <i class="bi bi-bookmark-plus"></i>
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <div id="checklistModelosErro" class="text-danger small mt-2 d-none"></div>
                                                        <div id="checklistModelosAviso" class="text-success small mt-2 d-none"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>{# /fm-body #}
                                </div>{# /fm #}

                            </div>{# /tab-pane #documentos #}

                        </div>

                    {# Coluna antiga de documentos — movida para a aba "Documentos". Desativada (mantida para referência; remover no cleanup). #}
                    {% if false %}
                    <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2">
                        {# Card: Documentação #}
                        {% set totalDocsGeral = 0 %}
                        {% for tipo, docs in documentosPorTipo %}{% set totalDocsGeral = totalDocsGeral + docs|length %}{% endfor %}
                        <div class="doc-folder-wrapper">
                        <div class="card card-primary card-outline mb-3 doc-folder-card" data-secao-destino="geral">
                            <div class="card-header d-flex align-items-center doc-folder-header">
                                <h3 class="card-title me-auto"><i class="bi bi-folder-fill me-1"></i> Documentação <span class="badge text-bg-secondary ms-1 js-secao-contador" id="contadorSecaoGeral">{{ totalDocsGeral }} {{ totalDocsGeral == 1 ? 'arquivo' : 'arquivos' }}</span></h3>
                                <button type="button" class="btn btn-tool" data-bs-toggle="collapse"
                                        data-bs-target="#documentacaoBody" aria-expanded="false"
                                        id="btnDocumentacaoToggle">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                            <div class="collapse" id="documentacaoBody">
                            <div class="card-body">
                                {# Checklist dinâmico #}
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="text-muted mb-0"><i class="bi bi-check2-square me-1"></i> Checklist de Documentação</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span id="checklistBadge" class="badge {{ concluidosChecklist == totalChecklist and totalChecklist > 0 ? 'text-bg-success' : 'text-bg-warning' }}">
                                            {{ concluidosChecklist }}/{{ totalChecklist }} itens
                                        </span>
                                        <button type="button" id="btnChecklistEditar" class="btn btn-sm btn-outline-secondary" title="Editar checklist">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" id="btnChecklistAdicionar" class="btn btn-sm btn-outline-primary" title="Adicionar item">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>

                                <ul id="checklistLista" class="list-unstyled mb-2">
                                    {% for item in checklistItens %}
                                    <li class="checklist-item d-flex align-items-center gap-2 py-1 border-bottom"
                                        data-item-id="{{ item.id }}"
                                        data-csrf-item="{{ csrf_token('checklist_item_' ~ item.id) }}">
                                        <button type="button" class="btn btn-link p-0 border-0 js-checklist-toggle" title="{{ item.concluido ? 'Marcar como pendente' : 'Marcar como concluído' }}">
                                            <i class="bi {{ item.concluido ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }} fs-5"></i>
                                        </button>
                                        <span class="checklist-drag-handle d-none text-muted" style="cursor:grab" title="Arrastar para reordenar">
                                            <i class="bi bi-grip-vertical"></i>
                                        </span>
                                        <span class="checklist-item-titulo flex-grow-1 {{ item.concluido ? 'text-decoration-line-through text-muted' : '' }}">
                                            {{ item.titulo|e }}
                                        </span>
                                        <input type="text" class="checklist-item-input form-control form-control-sm flex-grow-1 d-none"
                                               value="{{ item.titulo|e('html_attr') }}" maxlength="255">
                                        <button type="button" class="btn btn-sm btn-outline-danger js-checklist-excluir d-none" title="Excluir item">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </li>
                                    {% else %}
                                    <li id="checklistVazio" class="text-muted small py-2">
                                        Nenhum item. Clique em <i class="bi bi-plus-lg"></i> para adicionar.
                                    </li>
                                    {% endfor %}
                                </ul>

                                <div id="checklistFormAdicionar" class="d-none mb-2">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="checklistNovoTitulo" class="form-control" placeholder="Descrição do item..." maxlength="255">
                                        <button type="button" id="btnChecklistSalvarNovo" class="btn btn-primary"><i class="bi bi-check-lg"></i></button>
                                        <button type="button" id="btnChecklistCancelarNovo" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <div id="checklistErroNovo" class="text-danger small mt-1 d-none"></div>
                                </div>

                                <hr>

                                {# Arquivos por categoria #}
                                <h6 class="text-muted mb-3"><i class="bi bi-folder me-1"></i> Arquivos da Pasta</h6>

                                {# Formulário de upload inline #}
                                <form id="formAnexos" method="post" enctype="multipart/form-data"
                                      action="{{ path('pasta_documento_upload', {id: pasta.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_pasta_' ~ pasta.id) }}">

                                    <div id="geralDropArea" class="rounded p-2 mb-2 text-center text-muted small"
                                         style="border:2px dashed #ced4da;min-height:52px;transition:background .15s;">
                                        <i class="bi bi-cloud-upload me-1"></i> Arraste arquivos do computador aqui
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <button type="button" id="btnAdicionarAnexo" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                        </button>
                                        <button type="button" id="btnLimparAnexos" class="btn btn-sm btn-outline-secondary d-none">
                                            <i class="bi bi-x-circle me-1"></i> Limpar
                                        </button>
                                        <input type="file" id="inputAnexoOculto" multiple
                                               accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                                               class="d-none">
                                    </div>

                                    <div id="listaAnexos"></div>

                                    <div id="areaEnviar" class="d-none mt-3">
                                        <div class="form-check form-switch">
                                            <input type="checkbox" class="form-check-input" id="reduzirTamanhoGeral" name="reduzir_tamanho" value="1">
                                            <label class="form-check-label" for="reduzirTamanhoGeral">
                                                Reduzir tamanho dos arquivos (economiza espaço)
                                            </label>
                                        </div>
                                        <div class="form-text text-muted mb-2">
                                            Mantenha desligado para preservar a qualidade original.
                                            <span class="d-block text-warning-emphasis">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                PDFs assinados digitalmente podem ter a assinatura invalidada ao reduzir o tamanho.
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-cloud-upload me-1"></i> Enviar todos
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                {# Documentos já enviados #}
                                {% set hasDocuments = false %}
                                {% for tipo, docs in documentosPorTipo %}
                                    {% if docs|length > 0 %}{% set hasDocuments = true %}{% endif %}
                                {% endfor %}

                                {% if hasDocuments %}<hr>{% endif %}
                                <div class="mb-3 docs-list-scroll" id="documentosGerais" data-secao-destino="geral">
                                    {% for tipo, docs in documentosPorTipo %}
                                        {% if docs|length > 0 %}
                                            {% set label = documentTypeOptions[tipo] ?? tipo %}
                                            {% for doc in docs %}
                                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-2 gap-3 doc-item"
                                                     data-doc-id="{{ doc.id }}"
                                                     data-secao-id=""
                                                     data-csrf-mover="{{ csrf_token('pasta_doc_mover_' ~ doc.id) }}"
                                                     data-url-mover="{{ path('pasta_documento_mover_secao', {docId: doc.id}) }}">
                                                    <i class="bi bi-grip-vertical text-muted flex-shrink-0 doc-grip" style="cursor:grab;"></i>
                                                    <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold">
                                                            {{ doc.nomeOriginal }}
                                                        </a>
                                                        <small class="text-muted">
                                                            {{ label }}
                                                            {% if doc.descricao %} · {{ doc.descricao }}{% endif %}
                                                            {% if doc.numero %} · Nº {{ doc.numero }}{% endif %}
                                                            · {{ doc.carregadoEm|date('d/m/Y') }}
                                                            · {{ (doc.tamanhoBytes / 1024 / 1024) < 1 ? (doc.tamanhoBytes / 1024)|round(1) ~ ' KB' : (doc.tamanhoBytes / 1024 / 1024)|round(2) ~ ' MB' }}
                                                        </small>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0 doc-acoes">
                                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                                title="Visualizar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#previewDocModal"
                                                                data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                                data-nome="{{ doc.nomeOriginal }}"
                                                                data-mime="{{ doc.mimeType }}">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="Editar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editDocModal{{ doc.id }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            </div>{# /collapse show #}
                        </div>{# /doc-folder-card #}
                        </div>{# /doc-folder-wrapper #}

                        {# Cards de seções de documentos #}
                        {% for secao in secoes %}
                        <div class="card card-outline card-secondary mb-3 pasta-secao-card"
                             id="secaoCard{{ secao.id }}"
                             data-secao-destino="{{ secao.id }}">
                            <div class="card-header d-flex align-items-center py-2">
                                <span class="pasta-secao-nome fw-semibold me-auto">{{ secao.nome|e }} <span class="badge text-bg-secondary ms-1 js-secao-contador">{{ secao.documentos|length }} {{ secao.documentos|length == 1 ? 'arquivo' : 'arquivos' }}</span></span>
                                <div class="d-flex align-items-center gap-1 ms-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-secao-renomear-btn" title="Renomear seção"
