</div>

<script>
(function () {
    'use strict';

    const modal = document.getElementById('modalAdicionarCliente');
    if (!modal) return;

    const passoEscolha       = modal.querySelector('#passoEscolhaTipo');
    const formPF             = modal.querySelector('#formPF');
    const formPJ             = modal.querySelector('#formPJ');
    const campoTipo          = modal.querySelector('#campoTipoCliente');
    const footerForm         = modal.querySelector('#footerFormCliente');
    const footerEscolha      = modal.querySelector('#footerEscolhaTipo');
    const footerVincular     = modal.querySelector('#footerVincularCliente');
    const alertaErro         = modal.querySelector('#alertaErroCliente');
    const form               = modal.querySelector('#formNovoCliente');
    const btnSalvar          = footerForm.querySelector('button[type="submit"]');

    // Busca de cliente existente
    const inputBusca              = modal.querySelector('#buscaClienteExistente');
    const listaResultados         = modal.querySelector('#buscaClienteResultados');
    const spinnerBusca            = modal.querySelector('#buscaClienteSpinner');
    const chipsContainer          = modal.querySelector('#clientesSelecionadosContainer');
    const chipsWrapper            = modal.querySelector('#clientesSelecionadosChips');
    const btnConfirmarVincular    = modal.querySelector('#btnConfirmarVincular');
    const urlBuscar               = document.getElementById('urlBuscarClientes')?.value ?? '';
    const urlVincular             = document.getElementById('urlVincularCliente')?.value ?? '';
    const csrfVincular            = document.getElementById('csrfVincularCliente')?.value ?? '';
    const pastaId                 = '{{ pasta.id }}';
    const csrfDesvincularProcesso = '{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}';
    const clientesContainer       = document.getElementById('clientesList');

    /** @type {Array<{id: number, nome: string, documento: string, tipo: string}>} */
    let clientesSelecionados = [];
    let debounceTimer        = null;

    /* Monta a MESMA estrutura que _cliente_linha.html.twig gera no servidor.
       Se as duas divergirem, adicionar um cliente injeta uma linha com outra
       cara — defeito que so aparece depois de vincular alguem, nunca ao abrir
       a pagina. Ao mexer numa, conferir a outra. */
    function mascararDocumento(valor) {
        const d = String(valor || '').replace(/\D/g, '');
        if (d.length === 11) return `${d.slice(0,3)}.${d.slice(3,6)}.${d.slice(6,9)}-${d.slice(9)}`;
        if (d.length === 14) return `${d.slice(0,2)}.${d.slice(2,5)}.${d.slice(5,8)}/${d.slice(8,12)}-${d.slice(12)}`;
        return String(valor || '');
    }

    function rotuloDocumento(valor) {
        const n = String(valor || '').replace(/\D/g, '').length;
        return n === 11 ? 'CPF' : (n === 14 ? 'CNPJ' : 'Documento');
    }

    function criarClienteRow(cliente) {
        const row = document.createElement('div');
        row.className = 'cliente-linha d-flex align-items-center gap-2 py-2';
        row.dataset.clienteId = cliente.id;

        const icone = document.createElement('i');
        icone.className = 'bi bi-person-circle text-muted flex-shrink-0';

        const identidade = document.createElement('div');
        identidade.className = 'cliente-identidade flex-grow-1';

        const nome = document.createElement('div');
        nome.className = 'cliente-nome';
        // Mesmo <span> interno do Twig: é ele que trunca. Texto solto dentro do
        // flex vira item anônimo e não encolhe — a linha vazava do cartão.
        const nomeTexto = document.createElement('span');
        nomeTexto.className = 'cliente-nome-texto';
        nomeTexto.textContent = cliente.nome;
        nome.appendChild(nomeTexto);
        identidade.appendChild(nome);

        if (cliente.documento) {
            const doc = document.createElement('div');
            doc.className = 'cliente-doc';

            const rot = document.createElement('span');
            rot.className = 'cliente-doc-rotulo';
            rot.textContent = rotuloDocumento(cliente.documento);

            const val = document.createElement('span');
            val.className = 'cliente-doc-valor';
            val.textContent = mascararDocumento(cliente.documento);

            doc.appendChild(rot);
            doc.appendChild(val);
            identidade.appendChild(doc);
        }

        const acoes = document.createElement('div');
        acoes.className = 'd-flex gap-1 flex-shrink-0 js-cliente-acoes';

        const ficha = document.createElement('a');
        ficha.href = `/clientes/${cliente.id}`;
        ficha.className = 'btn btn-xs btn-outline-secondary';
        ficha.title = 'Abrir ficha do cliente (documentos e anexos ficam lá)';
        ficha.innerHTML = '<i class="bi bi-box-arrow-up-right"></i>';

        const formDesv = document.createElement('form');
        formDesv.method = 'post';
        formDesv.action = `/pasta/${pastaId}/cliente/${cliente.id}/desvincular`;
        formDesv.className = 'js-ajax-desvincular-cliente m-0';

        const btnDesv = document.createElement('button');
        btnDesv.type = 'submit';
        btnDesv.className = 'btn btn-xs btn-outline-danger';
        btnDesv.title = 'Desvincular cliente da pasta';
        btnDesv.innerHTML = '<i class="bi bi-trash"></i>';
        formDesv.appendChild(btnDesv);

        acoes.appendChild(ficha);
        acoes.appendChild(formDesv);

        row.appendChild(icone);
        row.appendChild(identidade);
        row.appendChild(acoes);

        return row;
    }

    /**
     * @param {object} cliente
     * @param {object|undefined} principal estado devolvido pelo servidor após o vínculo
     */
    /* O bloco tem DOIS destinos agora: o principal fica fora do colapso e os
       demais dentro dele. Jogar tudo no #clientesList, como antes, colocaria o
       cliente novo ao lado do principal, para fora da area que rola. */
    function blocoDosOutros() {
        let bloco = clientesContainer.querySelector('.clientes-outros');
        if (bloco) return bloco;

        const botao = document.createElement('button');
        botao.type = 'button';
        botao.className = 'btn btn-link btn-sm p-0 clientes-outros-toggle';
        botao.setAttribute('data-bs-toggle', 'collapse');
        botao.setAttribute('data-bs-target', '#clientesOutros');
        botao.setAttribute('aria-expanded', 'false');
        botao.setAttribute('aria-controls', 'clientesOutros');
        botao.innerHTML = '<i class="bi bi-chevron-right clientes-outros-caret me-1"></i>' +
                          '<span class="clientes-outros-label"></span>';

        const colapso = document.createElement('div');
        colapso.className = 'collapse';
        colapso.id = 'clientesOutros';

        bloco = document.createElement('div');
        // `ps-clientes-rolagem` junto: é dela que vem a altura máxima do trilho.
        // Sem a classe, o bloco criado pelo JS cresceria diferente do bloco que
        // o servidor renderiza.
        bloco.className = 'clientes-outros ps-clientes-rolagem';
        colapso.appendChild(bloco);

        clientesContainer.appendChild(botao);
        clientesContainer.appendChild(colapso);
        return bloco;
    }

    function atualizarRotuloOutros() {
        const bloco = clientesContainer.querySelector('.clientes-outros');
        const label = clientesContainer.querySelector('.clientes-outros-label');
        if (!bloco || !label) return;
        const n = bloco.querySelectorAll('.cliente-linha').length;
        const aberto = clientesContainer.querySelector('#clientesOutros')?.classList.contains('show');
        label.textContent = `${aberto ? 'ocultar' : 'mostrar'} outros ${n}`;
    }

    function appendClienteRow(cliente, principal) {
        if (!clientesContainer) {
            return;
        }
        const placeholder = clientesContainer.querySelector('#clientesPlaceholder');
        if (placeholder) {
            placeholder.remove();
        }

        const linha = criarClienteRow(cliente);
        let blocoPrincipal = clientesContainer.querySelector('.cliente-principal');

        if (!blocoPrincipal) {
            // Primeiro cliente da pasta: ele E o principal (Pasta::addCliente).
            blocoPrincipal = document.createElement('div');
            blocoPrincipal.className = 'cliente-principal';
            blocoPrincipal.appendChild(linha);
            clientesContainer.prepend(blocoPrincipal);
        } else {
            blocoDosOutros().appendChild(linha);
            atualizarRotuloOutros();
        }

        // Vincular pode MOVER o principal automático: se o cliente novo for o de cadastro mais
        // antigo e ninguém tiver marcado nada, a Média por CPF passa a ser dele. Sem isto a tela
        // seguiria mostrando o número do cliente anterior até alguém dar F5.
        if (principal) {
            trocaClientePrincipal(principal);
        }
    }

    function removeClienteRow(clienteId, form = null) {
        if (!clientesContainer) {
            return;
        }

        let row = null;
        if (clienteId) {
            row = clientesContainer.querySelector(`.cliente-linha[data-cliente-id="${clienteId}"]`);
        }
        if (!row && form) {
            row = form.closest('.cliente-linha');
        }

        if (row) {
            row.remove();
        }
        if (!clientesContainer.querySelector('.cliente-linha')) {
            clientesContainer.insertAdjacentHTML('beforeend', '<div id="clientesPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhum cliente vinculado.</div>');
        }
    }


    function mostrarErro(msg) {
        alertaErro.textContent = msg;
        alertaErro.classList.remove('d-none');
        alertaErro.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function ocultarErro() {
        alertaErro.classList.add('d-none');
        alertaErro.textContent = '';
    }

    function mostrar(tipo) {
        ocultarErro();
        passoEscolha.classList.add('d-none');
        footerEscolha.style.setProperty('display', 'none', 'important');
        footerForm.style.removeProperty('display');

        // O `disabled` anda junto com o `d-none`: esconder sem desabilitar deixa os campos
        // repetidos do outro bloco sendo validados pelo navegador e enviados no FormData.
        // Habilitar ANTES do Tab.show() — botão de aba dentro de fieldset desabilitado não ativa.
        const ativo    = tipo === 'pf' ? formPF : formPJ;
        const inativo  = tipo === 'pf' ? formPJ : formPF;
        const primeira = tipo === 'pf' ? '#pf-dados-tab' : '#pj-empresa-tab';

        ativo.disabled = false;
        ativo.classList.remove('d-none');
        inativo.disabled = true;
        inativo.classList.add('d-none');
        campoTipo.value = tipo === 'pf' ? 'pf' : 'pj';

        bootstrap.Tab.getOrCreateInstance(modal.querySelector(primeira)).show();
    }

    function voltar() {
        ocultarErro();
        formPF.disabled = true;
        formPF.classList.add('d-none');
        formPJ.disabled = true;
        formPJ.classList.add('d-none');
        passoEscolha.classList.remove('d-none');
        footerForm.style.setProperty('display', 'none', 'important');
        footerEscolha.style.removeProperty('display');
        campoTipo.value = '';
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        ocultarErro();

        btnSalvar.disabled = true;
        const icone = btnSalvar.querySelector('i');
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        // O bloco inativo já está `disabled` desde mostrar()/voltar() — nada a desabilitar aqui.
        // Fazer isso no submit era tarde demais: a validação nativa do navegador roda ANTES deste
        // handler, e o `finally` devolvia o bloco escondido para o ar depois de cada erro do
        // servidor. A partir da segunda tentativa o navegador barrava o envio por causa do e-mail
        // de um formulário que o usuário não estava preenchendo.

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });

            if (!resp.ok) {
                let msgErro = 'Erro ao salvar cliente.';
                try {
                    const dados = await resp.json();
                    msgErro = dados.erro ?? msgErro;
                } catch (_) { /* resposta não é JSON */ }
                mostrarErro(msgErro);
                return;
            }

            const dados = await resp.json();
            if (dados.sucesso && dados.cliente) {
                appendClienteRow(dados.cliente, dados.principal);
                bootstrap.Modal.getInstance(modal)?.hide();
                return;
            }

            mostrarErro('Cliente salvo, mas não foi possível atualizar a lista.');
        } catch (err) {
            mostrarErro('Erro de comunicação. Tente novamente.');
            console.error('[formNovoCliente]', err);
        } finally {
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check-lg me-1';
        }
    });

    // — Busca de cliente existente —

    function atualizarEstadoFooter() {
        if (clientesSelecionados.length > 0) {
            footerVincular.classList.remove('d-none');
            footerEscolha.classList.add('d-none');
            const label = clientesSelecionados.length === 1
                ? 'Vincular 1 Cliente'
                : `Vincular ${clientesSelecionados.length} Clientes`;
            btnConfirmarVincular.querySelector('span.btn-label') && (btnConfirmarVincular.querySelector('span.btn-label').textContent = label);
        } else {
            footerVincular.classList.add('d-none');
            footerEscolha.classList.remove('d-none');
        }
    }

    function criarChip(cliente) {
        const chip = document.createElement('span');
        chip.className = 'badge d-inline-flex align-items-center gap-1 ps-2 pe-1 py-1 rounded-pill border';
        chip.style.cssText = 'background:#e9f5ff; color:#0d6efd; border-color:#9ecbf5 !important; font-size:.78rem; font-weight:500;';
        chip.innerHTML = `
            <i class="bi ${cliente.tipo === 'PF' ? 'bi-person' : 'bi-building'} me-1"></i>
            ${escHtml(cliente.nome)}
            <button type="button" class="btn-close btn-close-sm ms-1" style="font-size:.55rem;" title="Remover" aria-label="Remover ${escHtml(cliente.nome)}"></button>`;
        chip.querySelector('.btn-close').addEventListener('click', () => removerSelecionado(cliente.id));
        return chip;
    }

    function escHtml(str) {
        return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function selecionarCliente(id, nome, documento, tipo) {
        if (clientesSelecionados.some(c => c.id === id)) {
            listaResultados.classList.add('d-none');
            inputBusca.value = '';
            return;
        }

        clientesSelecionados.push({ id, nome, documento, tipo });
        chipsWrapper.appendChild(criarChip({ id, nome, documento, tipo }));
        chipsContainer.classList.remove('d-none');
        listaResultados.classList.add('d-none');
        inputBusca.value = '';
        atualizarEstadoFooter();
    }

    function removerSelecionado(id) {
        clientesSelecionados = clientesSelecionados.filter(c => c.id !== id);
        chipsWrapper.innerHTML = '';
        clientesSelecionados.forEach(c => chipsWrapper.appendChild(criarChip(c)));
        if (clientesSelecionados.length === 0) {
            chipsContainer.classList.add('d-none');
        }
        atualizarEstadoFooter();
    }

    function limparSelecao() {
        clientesSelecionados = [];
        chipsWrapper.innerHTML = '';
        chipsContainer.classList.add('d-none');
        footerVincular.classList.add('d-none');
        footerEscolha.classList.remove('d-none');
    }

    async function executarBusca(termo) {
        if (termo.length < 2) {
            listaResultados.classList.add('d-none');
            return;
        }

        spinnerBusca.classList.remove('d-none');
        try {
            const resp = await fetch(urlBuscar + '?q=' + encodeURIComponent(termo), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });
            if (!resp.ok) return;

            const dados = await resp.json();
            listaResultados.innerHTML = '';

            if (dados.length === 0) {
                listaResultados.innerHTML = '<li class="list-group-item text-muted small py-2">Nenhum cliente encontrado.</li>';
            } else {
                dados.forEach(c => {
                    const jaSelecionado = clientesSelecionados.some(s => s.id === c.id);
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-2';
                    li.style.cursor = jaSelecionado ? 'default' : 'pointer';
                    if (jaSelecionado) li.classList.add('opacity-50');
                    li.innerHTML = `
                        <i class="bi ${c.tipo === 'PF' ? 'bi-person' : 'bi-building'} text-primary flex-shrink-0"></i>
                        <div class="overflow-hidden flex-fill">
                            <div class="fw-semibold text-truncate small">${escHtml(c.nome)}</div>
                            <div class="text-muted" style="font-size:.72rem;">${escHtml(c.documento)} · ${c.tipo}</div>
                        </div>
                        <i class="bi ${jaSelecionado ? 'bi-check-circle-fill text-success' : 'bi-plus-circle text-success'} flex-shrink-0"></i>`;
                    if (!jaSelecionado) {
                        li.addEventListener('click', () => selecionarCliente(c.id, c.nome, c.documento, c.tipo));
                    }
                    listaResultados.appendChild(li);
                });
            }

            listaResultados.classList.remove('d-none');
        } catch (_) {
            /* silencioso */
        } finally {
            spinnerBusca.classList.add('d-none');
        }
    }

    inputBusca.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => executarBusca(inputBusca.value.trim()), 300);
    });

    inputBusca.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            listaResultados.classList.add('d-none');
        }
    });

    document.addEventListener('click', e => {
        if (!listaResultados.contains(e.target) && e.target !== inputBusca) {
            listaResultados.classList.add('d-none');
        }
    });

    /**
     * Move a estrela para o cliente escolhido e atualiza a Média por CPF na aba Financeiro.
     *
     * A média é atualizada aqui de propósito: a marcação existe PARA mudar esse número, e deixá-lo
     * defasado na tela esconderia o efeito da própria ação que o usuário acabou de fazer.
     */
    /**
     * Monta a estrela de UMA linha, nos dois estados que o Twig também renderiza. Existe para que
     * a linha criada por JS (ao vincular um cliente) nasça idêntica à renderizada pelo servidor —
     * antes ela nascia SEM estrela, e o cliente recém-vinculado só podia ser marcado após um F5.
     *
     * @param {string} clienteId
     * @param {boolean} ehPrincipal
     * @param {string} tokenMarcar token CSRF de marcar ESTE cliente
     */
    function montaEstrelaPrincipal(clienteId, ehPrincipal, tokenMarcar) {
        if (ehPrincipal) {
            const marca = document.createElement('span');
            marca.className = 'btn btn-xs btn-primary disabled js-cliente-principal-estrela';
            marca.dataset.clienteId = clienteId;
            marca.title = 'Cliente principal desta pasta — a Média por CPF é dele. Clique na estrela de outro para trocar';
            marca.innerHTML = '<i class="bi bi-star-fill"></i>';
            return marca;
        }

        const form = document.createElement('form');
        form.method = 'post';
        form.action = '{{ path('pasta_cliente_principal', {id: pasta.id, cliente: '__CLIENTE__'}) }}'.replace('__CLIENTE__', clienteId);
        form.className = 'js-ajax-cliente-principal m-0';
        form.innerHTML = '<input type="hidden" name="_token" value="' + tokenMarcar + '">'
            + '<button type="submit" class="btn btn-xs btn-outline-secondary"'
            + ' title="Tornar cliente principal (a Média por CPF passa a ser dele)"><i class="bi bi-star"></i></button>';
        return form;
    }

    function trocaClientePrincipal(dados) {
        const novoId = String(dados.clienteId ?? '');

        document.querySelectorAll('#clientesList .cliente-linha').forEach((linha) => {
            const acoes = linha.querySelector('.js-cliente-acoes');
            if (!acoes) {
                return;
            }
            const clienteId = String(linha.dataset.clienteId ?? '');
            const atual = acoes.querySelector('form.js-ajax-cliente-principal, .js-cliente-principal-estrela');
            if (!atual) {
                return;
            }

            atual.replaceWith(montaEstrelaPrincipal(clienteId, clienteId === novoId, linha.dataset.tokenPrincipal ?? ''));
        });

        const media = document.getElementById('financeiro-media-cpf');
        if (media && dados.mediaFormatada) {
            media.textContent = dados.mediaFormatada;
        }
        // O rotulo e a nota tem id proprio desde a fatia 2 do redesenho. Antes
        // eram encontrados subindo ate `.col-md-2`, a coluna do grid Bootstrap
        // que a faixa de quatro cards nao tem mais: a busca devolvia null e os
        // dois textos ficavam defasados em silencio ao trocar o principal.
        const rotulo = document.getElementById('financeiro-media-rotulo');
        if (rotulo && dados.mediaRotulo) {
            rotulo.textContent = dados.mediaRotulo;
        }
        const nota = document.getElementById('financeiro-media-nota');
        if (nota && dados.clienteNome) {
            nota.textContent = dados.clienteNome;
        }
    }

    document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) {
            return;
        }

        if (form.matches('form.js-ajax-desvincular-cliente')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    alert(dados.erro ?? 'Erro ao desvincular cliente.');
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    removeClienteRow(dados.clienteId ?? '', form);
                    return;
                }

                alert(dados.erro ?? 'Erro ao desvincular cliente.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }


        if (form.matches('form.js-ajax-cliente-principal')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                const dados = await resp.json().catch(() => ({}));
                if (!resp.ok || !dados.sucesso) {
                    alert(dados.erro ?? 'Erro ao definir o cliente principal.');
                    return;
                }

                trocaClientePrincipal(dados);
                return;
            } catch (err) {
                // Sem este catch, queda de rede reabilitava o botão em silêncio e o usuário
                // achava que tinha marcado. A rejeição não tratada não aparece na tela.
                console.error('[clientePrincipal]', err);
                alert('Erro de comunicação. A marcação pode não ter sido salva — recarregue a página.');
                return;
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-desvincular-processo')) {
            event.preventDefault();
            if (!confirm('Desvincular o processo desta pasta?')) {
                return;
            }
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    alert(dados.erro ?? 'Erro ao desvincular processo.');
                    return;
                }

                const dados = await resp.json().catch(() => ({}));
                if (dados.sucesso) {
                    window.mpSwapProcessos(dados.html);
                    return;
                }

                alert(dados.erro ?? 'Erro ao desvincular processo.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        if (form.matches('form.js-ajax-processo-principal')) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
            }

            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });

                const dados = await resp.json().catch(() => ({}));
                if (resp.ok && dados.sucesso) {
                    window.mpSwapProcessos(dados.html);
                    return;
                }

                alert(dados.erro ?? 'Erro ao definir o processo principal.');
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

    });

    btnConfirmarVincular.addEventListener('click', async () => {
        if (clientesSelecionados.length === 0) return;

        btnConfirmarVincular.disabled = true;
        const icone = btnConfirmarVincular.querySelector('i');
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        const erros = [];
        const vinculados = [];

        for (const cliente of clientesSelecionados) {
            try {
                const body = new FormData();
                body.append('cliente_id', String(cliente.id));
                body.append('_token', csrfVincular);

                const resp = await fetch(urlVincular, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body,
                });

                if (!resp.ok) {
                    const dados = await resp.json().catch(() => ({}));
                    erros.push(dados.erro ?? `Erro ao vincular "${cliente.nome}".`);
                    continue;
                }

                const dados = await resp.json();
                if (dados.sucesso && dados.cliente) {
                    appendClienteRow(dados.cliente, dados.principal);
                    vinculados.push(cliente.id);
                } else {
                    erros.push(`"${cliente.nome}" vinculado, mas não foi possível atualizar a lista.`);
                }
            } catch (_) {
                erros.push(`Erro de comunicação ao vincular "${cliente.nome}".`);
            }
        }

        btnConfirmarVincular.disabled = false;
        if (icone) icone.className = 'bi bi-link-45deg me-1';

        if (erros.length > 0) {
            mostrarErro(erros.join(' '));
        }

        if (vinculados.length > 0 && erros.length === 0) {
            bootstrap.Modal.getInstance(modal)?.hide();
        } else if (vinculados.length > 0) {
            // Remove os que foram vinculados com sucesso, mantém os que deram erro
            vinculados.forEach(id => removerSelecionado(id));
        }
    });

    // — Fim busca de cliente existente —

    modal.querySelector('#btnEscolherPF').addEventListener('click', () => mostrar('pf'));
    modal.querySelector('#btnEscolherPJ').addEventListener('click', () => mostrar('pj'));
    modal.querySelector('#btnVoltarPF').addEventListener('click', voltar);
    modal.querySelector('#btnVoltarPJ').addEventListener('click', voltar);

    modal.addEventListener('hidden.bs.modal', () => { voltar(); limparSelecao(); });
}());
</script>

{# Modal: Vincular Processo #}
<div class="modal fade" id="modalVincularProcesso" tabindex="-1" aria-labelledby="modalVincularProcessoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="modalVincularProcessoLabel">
                    <i class="bi bi-briefcase me-1"></i> Vincular Processo
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" id="formVincularProcesso"
                  action="{{ path('pasta_vincular_processo', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('vincular_processo_' ~ pasta.id) }}">
                <div class="modal-body py-3">

                    {# Seletor de modo: buscar processo existente x cadastrar novo via CNJ #}
                    <div class="btn-group w-100 mb-3" role="group" aria-label="Modo de vínculo de processo">
                        <input type="radio" class="btn-check" name="mp-modo" id="mp-modo-existente" autocomplete="off" checked>
                        <label class="btn btn-outline-primary btn-sm" for="mp-modo-existente"><i class="bi bi-search me-1"></i> Buscar processo existente</label>
                        <input type="radio" class="btn-check" name="mp-modo" id="mp-modo-novo" autocomplete="off">
                        <label class="btn btn-outline-primary btn-sm" for="mp-modo-novo"><i class="bi bi-plus-lg me-1"></i> Cadastrar novo (CNJ)</label>
                    </div>

                    {# MODO: buscar processo já cadastrado #}
                    <div id="modal-modo-existente">
                        <label for="mp-processoExistente" class="form-label">
                            Processo já cadastrado <span class="text-danger">*</span>
                        </label>
                        <select id="mp-processoExistente" name="processo_id" class="form-select" style="width:100%"></select>
                        <div class="form-text">Busque por número, classe, assunto ou tribunal e selecione um processo do escritório.</div>
                    </div>

                    {# MODO: cadastrar novo processo via CNJ #}
                    <div id="modal-modo-novo" class="d-none">

                    {# Abas do formulário de processo #}
                    <div class="processo-modal-tabs d-flex border-bottom mb-0">
                        <button type="button" class="processo-modal-tab active" data-modal-tab="modal-proc-info">
                            <i class="bi bi-info-circle me-1"></i> Informações
                        </button>
                        <button type="button" class="processo-modal-tab" data-modal-tab="modal-proc-partes">
                            <i class="bi bi-people me-1"></i> Partes
                        </button>
                        <button type="button" class="processo-modal-tab" data-modal-tab="modal-proc-movimentacoes">
                            <i class="bi bi-clock-history me-1"></i> Movimentações
                        </button>
                    </div>

                    {# ABA: Informações #}
                    <div class="processo-modal-tab-content active pt-3" id="tab-modal-proc-info">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label for="mp-numeroProcesso" class="form-label">
                                    Número do Processo <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="mp-numeroProcesso" name="numeroProcesso" class="form-control"
                                       placeholder="Ex: 1234567-89.2024.1.23.4567" required>
                                <div class="form-text">Formato: NNNNNNN-DD.AAAA.J.TT.OOOO</div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button id="mp-btn-datajud" type="button" class="btn btn-info w-100"
                                        data-bs-toggle="tooltip" title="Busca o processo na base de dados do CNJ">
                                    <i class="bi bi-search me-1"></i> Buscar no CNJ
                                </button>
                            </div>
                            <div class="col-md-6">
                                <label for="mp-siglaTribunal" class="form-label">
                                    Tribunal
                                </label>
                                <input type="text" id="mp-siglaTribunal" name="siglaTribunal" class="form-control"
                                       readonly placeholder="Detectado pelo número do processo">
                                <div class="form-text">Preenchido automaticamente pelo número do processo.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="mp-orgaoJulgador" class="form-label">
                                    Órgão Julgador <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="mp-orgaoJulgador" name="orgaoJulgador" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label for="mp-classeProcessual" class="form-label">
                                    Classe Processual <span class="text-danger">*</span>
