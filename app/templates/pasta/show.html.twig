{% extends 'base.html.twig' %}

{% block title %}Pasta {{ pasta.nup }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="/css/pasta-arquivos.css">
{% endblock %}

{% block body %}
{# Content Header #}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-folder2-open me-2"></i>{{ pasta.nup }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('expediente_index') }}">Pastas</a></li>
                    <li class="breadcrumb-item active">Detalhes</li>
                </ol>
            </div>
        </div>
    </div>
</div>

{# Main Content #}
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header d-flex align-items-center">
                <h3 class="card-title mb-0"><i class="bi bi-folder me-1"></i> Pasta</h3>

                {# ── Barra de ações minimalistas ── #}
                <div class="pasta-acoes-bar d-flex align-items-center" style="margin-left: 3rem;">
                    <button type="button" class="pasta-acao-btn" title="Editar pasta"
                            data-bs-toggle="modal" data-bs-target="#modalEditarPasta">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button"
                            id="btn-alternar-status"
                            class="pasta-acao-btn {{ pasta.situacao == 'arquivado' ? 'pasta-acao-btn--arquivado' : '' }}"
                            title="{{ pasta.situacao == 'ativo' ? 'Arquivar pasta' : 'Reativar pasta' }}"
                            data-pasta-id="{{ pasta.id }}"
                            data-situacao-atual="{{ pasta.situacao }}"
                            data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}"
                            data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}">
                        <i class="bi {{ pasta.situacao == 'ativo' ? 'bi-archive' : 'bi-archive-fill' }}"></i>
                        <span class="pasta-acao-label">{{ pasta.situacao == 'ativo' ? 'Arquivar' : 'Ativar' }}</span>
                    </button>
                    <span class="pasta-acao-sep"></span>
                    <button type="button" class="pasta-acao-btn" title="Adiar">
                        <i class="bi bi-clock"></i>
                    </button>
                    <span class="pasta-acao-sep"></span>
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          onsubmit="return confirm('Tem certeza que deseja excluir a pasta {{ pasta.nup|e('js') }}?');"
                          class="d-contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <button type="submit" class="pasta-acao-btn pasta-acao-btn--danger" title="Excluir pasta">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                    <span class="pasta-acao-sep"></span>
                    <button type="button" class="pasta-acao-btn js-mover-para" title="Mover para marcador"
                            data-pasta-id="{{ pasta.id }}"
                            data-pasta-nome="{{ pasta.nup }}"
                            data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                            data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}">
                        <i class="bi bi-tag"></i>
                    </button>
                    <div class="dropdown" style="margin-right:4px;">
                        <button type="button"
                                class="btn btn-sm badge {{ pasta.prioridadeBadgeClass }} dropdown-toggle pasta-prioridade-btn"
                                style="font-size:.78rem;font-weight:500;"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                data-pasta-id="{{ pasta.id }}"
                                data-csrf="{{ csrf_token('pasta_prioridade_' ~ pasta.id) }}"
                                data-url="{{ path('pasta_alterar_prioridade', {id: pasta.id}) }}">
                            <i class="bi bi-flag-fill me-1"></i>{{ pasta.prioridadeLabel }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size:.85rem;min-width:150px;">
                            <li><button class="dropdown-item prioridade-opt" data-valor="normal" type="button">
                                <span class="badge text-bg-secondary me-2" style="font-size:.6rem;">●</span>Normal
                            </button></li>
                            <li><button class="dropdown-item prioridade-opt" data-valor="prioridade" type="button">
                                <span class="badge text-bg-warning me-2" style="font-size:.6rem;">●</span>Prioridade
                            </button></li>
                            <li><button class="dropdown-item prioridade-opt" data-valor="urgente" type="button">
                                <span class="badge text-bg-danger me-2" style="font-size:.6rem;">●</span>Urgente
                            </button></li>
                        </ul>
                    </div>
                    <button type="button" class="pasta-acao-btn" title="Mais ações"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size:.85rem;min-width:170px;">
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-printer me-2 text-muted"></i>Imprimir
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-share me-2 text-muted"></i>Compartilhar
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card-tools ms-auto">
                    <span class="badge {{ pasta.situacao == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}">
                        {{ pasta.situacao == 'ativo' ? 'Ativo' : 'Arquivado' }}
                    </span>
                </div>
            </div>

            <style>
            .pasta-acoes-bar {
                gap: 2px;
                position: relative;
            }
            .pasta-acao-btn {
                background: none;
                border: none;
                padding: 6px 8px;
                color: #7bafd4;
                font-size: 1rem;
                border-radius: 50%;
                cursor: pointer;
                line-height: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background .15s, color .15s;
            }
            .pasta-acao-btn:hover {
                background: rgba(123,175,212,.15);
                color: #4a90c4;
            }
            .pasta-acao-btn--danger:hover {
                background: rgba(220,53,69,.10);
                color: #dc3545;
            }
            .pasta-acao-btn--arquivado {
                color: #fd7e14;
            }
            .pasta-acao-btn--arquivado:hover {
                background: rgba(253,126,20,.12);
                color: #e06200;
            }
            .pasta-acao-label {
                font-size: .75rem;
                margin-left: 4px;
                font-weight: 500;
                letter-spacing: .01em;
            }
            .pasta-acao-sep {
                width: 1px;
                height: 18px;
                background: var(--bs-border-color);
                margin: 0 4px;
                flex-shrink: 0;
            }
            .d-contents { display: contents; }
            .docs-list-scroll {
                max-height: 320px;
                overflow-y: auto;
            }
            .docs-list-scroll::-webkit-scrollbar { width: 5px; }
            .docs-list-scroll::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 3px; }
            .doc-item .doc-acoes { opacity: 0; transition: opacity .15s; }
            .doc-item:hover .doc-acoes { opacity: 1; }

            /* ── Card Documentação: visual de pasta ── */
            .doc-folder-wrapper {
                margin-top: 22px;
                position: relative;
            }
            .doc-folder-wrapper::before {
                content: '';
                position: absolute;
                top: -22px;
                left: 0;
                width: 52%;
                max-width: 175px;
                height: 22px;
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%);
                border-radius: 6px 10px 0 0;
                clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
            }
            .doc-folder-card.card.card-primary.card-outline {
                border-top-left-radius: 0 !important;
                border-color: #3f7bbf !important;
                box-shadow: 2px 3px 10px rgba(0,0,0,0.13);
            }
            .doc-folder-header {
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%) !important;
                border-bottom: none !important;
                border-top-right-radius: 4px !important;
                border-top-left-radius: 0 !important;
                padding: 0.6rem 1rem !important;
                cursor: pointer;
                user-select: none;
            }
            .doc-folder-header .card-title {
                color: #fff !important;
                font-size: 0.9rem;
            }
            .doc-folder-header .btn-tool {
                color: rgba(255,255,255,0.75) !important;
            }
            .doc-folder-header .btn-tool:hover {
                color: #fff !important;
            }
            .doc-folder-header .badge {
                background-color: rgba(255,255,255,0.22) !important;
                color: #fff !important;
                font-weight: 500;
            }
            @media (max-width: 575.98px) {
                .doc-folder-wrapper::before {
                    width: 48%;
                    max-width: 150px;
                    height: 20px;
                    top: -20px;
                }
                .doc-folder-wrapper { margin-top: 20px; }
            }

            /* ── Cards de seção: visual de pasta ── */
            .pasta-secao-card {
                margin-top: 22px;
                position: relative;
                overflow: visible !important;
                border-top-left-radius: 0 !important;
                border-color: #3f7bbf !important;
                box-shadow: 2px 3px 10px rgba(0,0,0,0.13);
            }
            .pasta-secao-card::before {
                content: '';
                position: absolute;
                top: -22px;
                left: 0;
                width: 52%;
                max-width: 175px;
                height: 22px;
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%);
                border-radius: 6px 10px 0 0;
                clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
            }
            .pasta-secao-card .card-header {
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%) !important;
                border-bottom: none !important;
                border-top-left-radius: 0 !important;
                cursor: pointer;
                user-select: none;
            }
            .pasta-secao-card .card-header .pasta-secao-nome {
                color: #fff;
            }
            .pasta-secao-card .card-header .badge {
                background-color: rgba(255,255,255,0.22) !important;
                color: #fff !important;
                font-weight: 500;
            }
            .pasta-secao-card .card-header .btn-tool {
                color: rgba(255,255,255,0.75) !important;
            }
            .pasta-secao-card .card-header .btn-tool:hover {
                color: #fff !important;
            }
            .pasta-secao-card .card-header .js-secao-renomear-btn,
            .pasta-secao-card .card-header .js-secao-excluir-btn {
                opacity: 0;
                transition: opacity .15s;
            }
            .pasta-secao-card .card-header:hover .js-secao-renomear-btn,
            .pasta-secao-card .card-header:hover .js-secao-excluir-btn {
                opacity: 1;
            }
            .pasta-secao-card .card-header .btn-outline-secondary,
            .pasta-secao-card .card-header .btn-outline-danger {
                color: rgba(255,255,255,0.8) !important;
                border-color: rgba(255,255,255,0.35) !important;
                background: transparent !important;
            }
            .pasta-secao-card .card-header .btn-outline-secondary:hover {
                color: #fff !important;
                background: rgba(255,255,255,0.15) !important;
                border-color: rgba(255,255,255,0.6) !important;
            }
            .pasta-secao-card .card-header .btn-outline-danger:hover {
                color: #fff !important;
                background: rgba(220,53,69,0.4) !important;
                border-color: rgba(255,255,255,0.6) !important;
            }
            @media (max-width: 575.98px) {
                .pasta-secao-card { margin-top: 20px; }
                .pasta-secao-card::before {
                    width: 48%;
                    max-width: 150px;
                    height: 20px;
                    top: -20px;
                }
            }
            </style>
            <div class="card-body">
                <div class="row">
                    {# Coluna única — documentos viraram a aba "Documentos" (largura total) #}
                    <div class="col-12">
                        {% set totalArquivos = pasta.documentos|length %}
                        {# Tabs #}
                        <ul class="nav nav-tabs" id="pastaTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true">
                                    <i class="bi bi-folder me-1"></i> Dados da Pasta
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tarefas-tab" data-bs-toggle="tab" data-bs-target="#tarefas" type="button" role="tab" aria-controls="tarefas" aria-selected="false">
                                    <i class="bi bi-check2-square me-1"></i> Metas
                                    {% if pasta.tarefas|length > 0 %}
                                        <span class="badge text-bg-secondary ms-1">{{ pasta.tarefas|length }}</span>
                                    {% endif %}
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="processo-tab" data-bs-toggle="tab" data-bs-target="#processo" type="button" role="tab" aria-controls="processo" aria-selected="false">
                                    <i class="bi bi-briefcase me-1"></i> Processo
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="financeiro-tab" data-bs-toggle="tab" data-bs-target="#financeiro" type="button" role="tab" aria-controls="financeiro" aria-selected="false">
                                    <i class="bi bi-cash-coin me-1"></i> Financeiro
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="detalhes-tab" data-bs-toggle="tab" data-bs-target="#detalhes" type="button" role="tab" aria-controls="detalhes" aria-selected="false">
                                    <i class="bi bi-info-circle me-1"></i> Detalhes
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="documentos-tab" data-bs-toggle="tab" data-bs-target="#documentos" type="button" role="tab" aria-controls="documentos" aria-selected="false">
                                    <i class="bi bi-folder2-open me-1"></i> Documentos
                                    {% if totalArquivos > 0 %}<span class="badge text-bg-secondary ms-1">{{ totalArquivos }}</span>{% endif %}
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content mt-3" id="pastaTabsContent">
                            {# Tab: Dados da Pasta #}
                            <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
                                <h5 class="mb-3"><i class="bi bi-info-circle me-1"></i> Informações Gerais</h5>
                                <div class="row mb-4 g-3">
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <p class="text-sm text-muted mb-1"><abbr title="Número Único de Pasta">NUP</abbr></p>
                                        <b>{{ pasta.nup }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.nup }}" title="Copiar"></i></b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <p class="text-sm text-muted mb-1">Processo Vinculado</p>
                                        <b>
                                            {% if pasta.processoPrincipal %}
                                                <a href="{{ path('processo_show', {id: pasta.processoPrincipal.id}) }}">{{ pasta.processoPrincipal.numeroProcesso }}</a>
                                                <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.processoPrincipal.numeroProcesso }}" title="Copiar"></i>
                                                {% if pasta.pastaProcessos|length > 1 %}
                                                    <span class="badge bg-secondary ms-1" title="Outros processos vinculados">+{{ pasta.pastaProcessos|length - 1 }}</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <p class="text-sm text-muted mb-1">Data de Abertura</p>
                                        <b>{{ pasta.dataAbertura|date('d/m/Y') }} <i class="bi bi-copy text-primary copy-btn" role="button" data-copy="{{ pasta.dataAbertura|date('d/m/Y') }}" title="Copiar"></i></b>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <p class="text-sm text-muted mb-1">Responsável</p>
                                        <div class="pasta-responsavel-inline" data-pasta-id="{{ pasta.id }}"
                                             data-url="{{ path('pasta_atualizar_responsavel', {id: pasta.id}) }}"
                                             data-csrf="{{ csrf_token('pasta_responsavel_' ~ pasta.id) }}">
                                            <select class="form-select form-select-sm pasta-responsavel-select"
                                                    style="max-width:180px;"
                                                    data-valor-atual="{{ pasta.responsavel ? pasta.responsavel.id : '' }}">
                                                <option value="">— Sem responsável —</option>
                                                {% for u in usuarios %}
                                                    <option value="{{ u.id }}"
                                                        {% if pasta.responsavel and pasta.responsavel.id == u.id %}selected{% endif %}>
                                                        {{ u.fullName }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                            <span class="pasta-responsavel-feedback ms-1" style="font-size:.75rem;"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <p class="text-sm text-muted mb-1">Ação</p>
                                        <b>
                                            {% if pasta.nomeAcao %}
                                                {{ pasta.nomeAcao }}
                                            {% elseif pasta.processoPrincipal %}
                                                {{ pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso }}
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </b>
                                    </div>
                                </div>

                                <div class="row mb-3 g-3">
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <p class="text-sm text-muted mb-0"><i class="bi bi-people me-1"></i> Clientes</p>
                                            <button type="button"
                                                    class="btn btn-xs btn-outline-primary"
                                                    title="Adicionar cliente"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAdicionarCliente">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div id="clientesList">
                                            {# Quem manda na "Média por CPF" da aba Financeiro. Pasta com cliente SEMPRE
                                               tem principal — o primeiro vinculado, ou quem o dono marcou depois —, então
                                               aqui não há caso "ninguém escolheu" para tratar. #}
                                            {% set clientePrincipal = pasta.clientePrincipal %}
                                            {% if pasta.clientes|length > 0 %}
                                                {% for cliente in pasta.clientes %}
                                                    {# Busca dados de documentos deste cliente #}
                                                    {% set clienteDocs = null %}
                                                    {% for item in clientesComDocumentos %}
                                                        {% if item.cliente.id == cliente.id %}
                                                            {% set clienteDocs = item %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    {# Conta total de docs deste cliente #}
                                                    {% set totalDocsCliente = 0 %}
                                                    {% if clienteDocs is not null %}
                                                        {% for tipo, docs in clienteDocs.documentosPorTipo %}
                                                            {% set totalDocsCliente = totalDocsCliente + docs|length %}
                                                        {% endfor %}
                                                    {% endif %}

                                                    <div class="cliente-row border-bottom" data-cliente-id="{{ cliente.id }}"
                                                         {# O token vai na LINHA, não só no form: quando a estrela cheia
                                                            (que não tem form) precisa voltar a ser botão, o JS não teria de
                                                            onde tirá-lo. Mesma exposição dos hidden inputs já na página. #}
                                                         data-token-principal="{{ csrf_token('pasta_cliente_principal_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                                                        {# ── Linha compacta: toggle do accordion ── #}
                                                        <div class="d-flex align-items-center gap-2 py-2 px-1">
                                                            {# Toggle accordion #}
                                                            <button class="btn btn-link p-0 text-start text-decoration-none flex-grow-1 cliente-accordion-toggle"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#clienteAcc{{ cliente.id }}"
                                                                    aria-expanded="false"
                                                                    aria-controls="clienteAcc{{ cliente.id }}">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <i class="bi bi-person-circle text-muted fs-6"></i>
                                                                    <span class="fw-semibold text-primary small">
                                                                        {% if cliente.cpf is defined and cliente.cpf %}
                                                                            {{ cliente.nomeCompleto }}
                                                                        {% else %}
                                                                            {{ cliente.razaoSocial }}
                                                                        {% endif %}
                                                                    </span>
                                                                    {% if totalDocsCliente > 0 %}
                                                                        <span class="badge text-bg-secondary rounded-pill" style="font-size:.65rem;">{{ totalDocsCliente }}</span>
                                                                    {% endif %}
                                                                </div>
                                                            </button>

                                                            {# Ações rápidas: principal + ir ao cliente + desvincular.
                                                               A classe `js-cliente-acoes` é o gancho do JS: amarrá-lo às classes
                                                               de layout fazia a linha criada por AJAX (que tem outro layout) ficar
                                                               invisível para a troca de estrela. #}
                                                            <div class="d-flex gap-1 flex-shrink-0 js-cliente-acoes">
                                                                {# Dois estados: cheia = é o principal desta pasta, vazia = clique para
                                                                   trocar. Não existe "desmarcar": pasta com cliente SEMPRE tem principal
                                                                   (o primeiro vinculado, ou quem o dono marcou), então não há para onde
                                                                   voltar — o que existe é trocar. #}
                                                                {% if clientePrincipal and cliente.id == clientePrincipal.id %}
                                                                    <span class="btn btn-xs btn-primary disabled js-cliente-principal-estrela"
                                                                          data-cliente-id="{{ cliente.id }}"
                                                                          title="Cliente principal desta pasta — a Média por CPF é dele. Clique na estrela de outro para trocar">
                                                                        <i class="bi bi-star-fill"></i>
                                                                    </span>
                                                                {% else %}
                                                                    <form method="post" action="{{ path('pasta_cliente_principal', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-cliente-principal m-0">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_principal_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                                                                        <button type="submit" class="btn btn-xs btn-outline-secondary" title="Tornar cliente principal (a Média por CPF passa a ser dele)">
                                                                            <i class="bi bi-star"></i>
                                                                        </button>
                                                                    </form>
                                                                {% endif %}
                                                                <a href="{{ path('cliente_show', {id: cliente.id}) }}"
                                                                   class="btn btn-xs btn-outline-secondary"
                                                                   title="Abrir ficha do cliente">
                                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                                </a>
                                                                <form method="post" action="{{ path('pasta_cliente_desvincular', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-desvincular-cliente m-0">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_desvincular_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                                                                    <button type="submit" class="btn btn-xs btn-outline-danger" title="Desvincular cliente da pasta">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>

                                                        {# ── Painel colapsável com arquivos + upload ── #}
                                                        <div class="collapse" id="clienteAcc{{ cliente.id }}">
                                                            <div class="cliente-acc-body pb-3 pt-1 px-1">

                                                                {# Documentos existentes #}
                                                                {% if clienteDocs is not null and totalDocsCliente > 0 %}
                                                                    <div class="mb-2">
                                                                        {% for tipo, docs in clienteDocs.documentosPorTipo %}
                                                                            {% if docs|length > 0 %}
                                                                                {% set label = documentTypeOptionsCliente[tipo] ?? tipo %}
                                                                                <div class="text-muted" style="font-size:.7rem;letter-spacing:.03em;text-transform:uppercase;margin-bottom:.25rem;margin-top:.6rem;">
                                                                                    <i class="bi bi-folder me-1"></i>{{ label }}
                                                                                </div>
                                                                                {% for doc in docs %}
                                                                                    <div class="d-flex align-items-center gap-2 rounded px-2 py-1 mb-1 doc-row-cliente">
                                                                                        <i class="bi bi-file-earmark-text text-primary flex-shrink-0" style="font-size:.85rem;"></i>
                                                                                        <span class="text-truncate flex-grow-1" style="font-size:.8rem;">{{ doc.nomeOriginal }}</span>
                                                                                        <small class="text-muted text-nowrap d-none d-sm-inline" style="font-size:.7rem;">{{ doc.carregadoEm|date('d/m/Y') }}</small>
                                                                                        <div class="d-flex gap-1 flex-shrink-0">
                                                                                            <button type="button" class="btn btn-xs btn-outline-primary"
                                                                                                    title="Visualizar"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#previewDocModal"
                                                                                                    data-url="{{ path('cliente_documento_view', {id: doc.id}) }}"
                                                                                                    data-nome="{{ doc.nomeOriginal }}"
                                                                                                    data-mime="{{ doc.mimeType }}">
                                                                                                <i class="bi bi-eye"></i>
                                                                                            </button>
                                                                                            <button type="button" class="btn btn-xs btn-outline-secondary"
                                                                                                    title="Editar"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#editDocClienteModal{{ doc.id }}">
                                                                                                <i class="bi bi-pencil"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </div>
                                                                                {% endfor %}
                                                                            {% endif %}
                                                                        {% endfor %}
                                                                    </div>
                                                                {% else %}
                                                                    <p class="text-muted small mb-2"><i class="bi bi-inbox me-1"></i>Nenhum arquivo anexado.</p>
                                                                {% endif %}

                                                                {# Upload inline — dentro do accordion #}
                                                                <form method="post" enctype="multipart/form-data"
                                                                      action="{{ path('cliente_documento_upload', {id: cliente.id}) }}"
                                                                      class="form-upload-cliente-inline"
                                                                      data-cliente-id="{{ cliente.id }}">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_cliente_' ~ cliente.id) }}">
                                                                    <input type="file" id="fileInputCliente{{ cliente.id }}"
                                                                           multiple
                                                                           accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,audio/*,video/*"
                                                                           class="d-none file-input-cliente">

                                                                    <div id="listaUploadCliente{{ cliente.id }}" class="mb-2"></div>

                                                                    <div class="form-check form-switch small mb-1">
                                                                        <input type="checkbox" class="form-check-input" id="reduzirTamanhoClienteInline{{ cliente.id }}" name="reduzir_tamanho" value="1">
                                                                        <label class="form-check-label text-muted" for="reduzirTamanhoClienteInline{{ cliente.id }}">
                                                                            Reduzir tamanho (PDF assinado pode perder a assinatura)
                                                                        </label>
                                                                    </div>

                                                                    <div class="d-flex align-items-center gap-2 mt-1">
                                                                        <button type="button"
                                                                                class="btn btn-xs btn-outline-primary btn-escolher-arquivo-cliente"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-paperclip me-1"></i> Anexar
                                                                        </button>
                                                                        <button type="submit"
                                                                                class="btn btn-xs btn-success btn-enviar-cliente d-none"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-cloud-upload me-1"></i> Enviar
                                                                        </button>
                                                                        <button type="button"
                                                                                class="btn btn-xs btn-outline-secondary btn-cancelar-cliente d-none"
                                                                                data-cliente-id="{{ cliente.id }}">
                                                                            <i class="bi bi-x"></i>
                                                                        </button>
                                                                    </div>
                                                                </form>

                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            {% elseif pasta.nomeCliente %}
                                                <div id="clientesPlaceholder" class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom">
                                                    <i class="bi bi-person-circle text-muted"></i>
                                                    <span>{{ pasta.nomeCliente }}</span>
                                                    <span class="badge text-bg-secondary ms-auto" style="font-size:.65rem;">não vinculado</span>
                                                </div>
                                            {% else %}
                                                <div id="clientesPlaceholder" class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Nenhum cliente vinculado.</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {% include 'pasta/_timeline.html.twig' with {timelineItems: timelineItems, pasta: pasta} only %}

                            </div>

                            {# Tab: Processo #}
                            <div class="tab-pane fade" id="processo" role="tabpanel" aria-labelledby="processo-tab">
                                <div id="processoTabContent">
                                {{ include('pasta/_processos_vinculados.html.twig') }}
                                </div><!-- /processoTabContent -->
                            </div>

                            {# Tab: Financeiro #}
                            <div class="tab-pane fade" id="financeiro" role="tabpanel" aria-labelledby="financeiro-tab">
                                {% include 'pasta/_financeiro.html.twig' with {
                                    pasta: pasta,
                                    documentosContrato: documentosContrato,
                                    observacoesFinanceiras: observacoesFinanceiras,
                                    financeiro: financeiro,
                                } only %}
                            </div>

                            {# Tab: Tarefas #}
                            <div class="tab-pane fade" id="tarefas" role="tabpanel" aria-labelledby="tarefas-tab">
                                {% set statusBadgeTarefa = {
                                    'pendente':   'text-bg-secondary',
                                    'em_revisao': 'text-bg-warning',
                                    'concluida':  'text-bg-success',
                                } %}
                                {% set statusLabelTarefa = {
                                    'pendente':   'Pendente',
                                    'em_revisao': 'Para Revisão',
                                    'concluida':  'Concluída',
                                } %}

                                <div class="d-flex justify-content-end mb-3">
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-bs-toggle="modal" data-bs-target="#modalCriarTarefa">
                                        <i class="bi bi-plus-lg me-1"></i>Criar Meta
                                    </button>
                                </div>

                                {% if pasta.tarefas|length > 0 %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for tarefa in pasta.tarefas %}
                                            {% set prazoInfo = tarefa.prazoInfo %}
                                            <a href="{{ path('tarefa_show', {id: tarefa.id}) }}"
                                               class="tarefa-card text-decoration-none status-{{ tarefa.status }}">
                                                <div class="tarefa-card-header">
                                                    <span class="tarefa-card-titulo">{{ tarefa.titulo }}</span>
                                                    <span class="badge {{ statusBadgeTarefa[tarefa.status] ?? 'text-bg-secondary' }} flex-shrink-0">
                                                        {{ statusLabelTarefa[tarefa.status] ?? tarefa.status }}
                                                    </span>
                                                </div>
                                                <div class="tarefa-card-meta">
                                                    <span title="Autor">
                                                        <i class="bi bi-person me-1"></i>
                                                        {{ tarefa.criadoPor ? tarefa.criadoPor.fullName : '—' }}
                                                    </span>
                                                    <span title="{% if tarefa.responsaveis|length > 0 %}Responsáveis: {{ tarefa.responsaveis|map(r => r.fullName)|join(', ') }}{% else %}Responsável{% endif %}">
                                                        <i class="bi bi-person-check me-1"></i>
                                                        {% if tarefa.responsaveis|length > 0 %}{{ (tarefa.responsaveis|first).fullName }}{% if tarefa.responsaveis|length > 1 %} +{{ tarefa.responsaveis|length - 1 }}{% endif %}{% else %}—{% endif %}
                                                    </span>
                                                    {% if prazoInfo.texto != '-' %}
                                                    <span class="text-{{ prazoInfo.cor }}" title="Prazo">
                                                        <i class="bi bi-calendar-event me-1"></i>{{ prazoInfo.texto }}
                                                    </span>
                                                    {% endif %}
                                                    <span class="ms-auto text-muted" title="Criada em">
                                                        <i class="bi bi-clock me-1"></i>{{ tarefa.dataCriacao|date('d/m/Y') }}
                                                    </span>
                                                    {% if tarefa.dataAlteracao %}
                                                    <span class="text-muted" title="Última alteração">
                                                        · mod. {{ tarefa.dataAlteracao|date('d/m/Y') }}
                                                    </span>
                                                    {% endif %}
                                                </div>
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-check2-square fs-1 d-block mb-2 opacity-25"></i>
                                        <span class="small">Nenhuma meta criada para esta pasta.</span>
                                    </div>
                                {% endif %}

                                {# Estilos dos cards de tarefa #}
                                <style>
                                .tarefa-card {
                                    display: block;
                                    border: 1px solid var(--bs-border-color);
                                    border-radius: 8px;
                                    padding: 12px 14px;
                                    background: var(--bs-body-bg);
                                    transition: box-shadow .15s, border-color .15s;
                                    color: inherit;
                                }
                                .tarefa-card:hover {
                                    box-shadow: 0 2px 10px rgba(0,0,0,.08);
                                    border-color: var(--bs-border-color);
                                    color: inherit;
                                }
                                .tarefa-card.status-em_revisao { border-left: 3px solid #ffc107; }
                                .tarefa-card.status-concluida  { border-left: 3px solid #198754; opacity: .75; }
                                .tarefa-card.status-pendente   { border-left: 3px solid var(--bs-secondary-color); }
                                .tarefa-card-header {
                                    display: flex;
                                    align-items: flex-start;
                                    justify-content: space-between;
                                    gap: 8px;
                                    margin-bottom: 6px;
                                }
                                .tarefa-card-titulo {
                                    font-weight: 600;
                                    font-size: .88rem;
                                    color: var(--bs-body-color);
                                    flex: 1;
                                    min-width: 0;
                                }
                                .tarefa-card-meta {
                                    display: flex;
                                    flex-wrap: wrap;
                                    gap: 10px;
                                    font-size: .77rem;
                                    color: var(--bs-secondary-color);
                                    align-items: center;
                                }
                                </style>
                            </div>

                            {# Tab: Detalhes #}
                            <div class="tab-pane fade" id="detalhes" role="tabpanel" aria-labelledby="detalhes-tab">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-plus me-2"></i> Criado em
                                                <b class="d-block">{{ pasta.criadoEm|date('d/m/Y H:i') }}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-calendar-check me-2"></i> Modificado em
                                                <b class="d-block">{% if pasta.modificadoEm %}{{ pasta.modificadoEm|date('d/m/Y H:i') }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-check me-2"></i> Criado por
                                                <b class="d-block">{% if pasta.criadoPor %}{{ pasta.criadoPor.fullName }}{% else %}-{% endif %}</b>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-muted">
                                            <p class="text-sm mb-2"><i class="bi bi-person-badge me-2"></i> Responsável
                                                <b class="d-block">{{ pasta.responsavel ? pasta.responsavel.fullName : '—' }}</b>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                {% include 'pasta/_detalhes_obs.html.twig' with {
                                    pasta: pasta,
                                    observacoesDetalhes: observacoesDetalhes,
                                } only %}
                            </div>

                            {# ==================== ABA: DOCUMENTOS (gerenciador de arquivos) ==================== #}
                            <div class="tab-pane fade" id="documentos" role="tabpanel" aria-labelledby="documentos-tab" tabindex="0">
                                {# Todos os documentos da pasta (gerais + de seções), taggeados por seção; JS filtra por pasta atual. #}
                                {% set arquivosFm = [] %}
                                {% for doc in pasta.documentos %}{% set arquivosFm = arquivosFm|merge([{'doc': doc, 'secao': doc.secao ? doc.secao.id : 'geral'}]) %}{% endfor %}

                                <div class="fm" id="fileManager"
                                     data-pasta-id="{{ pasta.id }}"
                                     data-url-upload="{{ path('pasta_peticionar_upload', {id: pasta.id}) }}"
                                     data-csrf-upload="{{ csrf_token('peticionar_upload_' ~ pasta.id) }}"
                                     data-url-criar-secao="{{ path('pasta_secao_criar', {id: pasta.id}) }}"
                                     data-csrf-criar-secao="{{ csrf_token('pasta_secao_criar_' ~ pasta.id) }}"
                                     data-url-reordenar-secoes="{{ path('pasta_secoes_reordenar', {id: pasta.id}) }}"
                                     data-csrf-reordenar-secoes="{{ csrf_token('reordenar_secoes_pasta_' ~ pasta.id) }}"
                                     data-url-reordenar-docs="{{ path('pasta_documentos_reordenar', {id: pasta.id}) }}"
                                     data-csrf-reordenar-docs="{{ csrf_token('reordenar_docs_pasta_' ~ pasta.id) }}"
                                     data-url-renomear-tpl="{{ path('pasta_secao_renomear', {secaoId: '__ID__'}) }}"
                                     data-url-excluir-tpl="{{ path('pasta_secao_excluir', {secaoId: '__ID__'}) }}"
                                     data-url-mover-tpl="{{ path('pasta_secao_mover', {secaoId: '__ID__'}) }}"
                                     data-arvore="1">

                                    {# Toolbar #}
                                    <div class="fm-toolbar">
                                        <nav class="fm-breadcrumb" aria-label="Navegação de pastas">
                                            <button type="button" class="fm-crumb" data-nav="root"><i class="bi bi-folder2-open"></i> Documentos</button>
                                            <span class="fm-crumb-sep fm-oculto" id="fmCrumbSep"><i class="bi bi-chevron-right"></i></span>
                                            <span class="fm-crumb-atual fm-oculto" id="fmCrumbAtual"></span>
                                        </nav>
                                        <div class="fm-busca">
                                            <i class="bi bi-search"></i>
                                            <input type="search" id="fmBusca" placeholder="Buscar arquivos..." autocomplete="off" aria-label="Buscar arquivos">
                                        </div>
                                        <div class="fm-acoes">
                                            <button type="button" class="btn btn-sm btn-primary" id="fmNovaPasta"><i class="bi bi-folder-plus me-1"></i> Nova pasta</button>
                                            <button type="button" class="btn btn-sm btn-outline-primary" id="fmUpload"><i class="bi bi-upload me-1"></i> Enviar</button>
                                            <input type="file" id="fmFileInput" multiple class="d-none" accept=".png,.jpg,.jpeg,.pdf,.kml,.xml,.xls,.xlsx,.doc,.docx,.txt,.zip,.mp3,.ogg,.opus,.m4a,.mp4,.mov">
                                            <div class="fm-view-toggle" role="group" aria-label="Modo de exibição">
                                                <button type="button" class="fm-view-btn ativo" data-view="lista" title="Lista" aria-label="Lista"><i class="bi bi-list-ul"></i></button>
                                                <button type="button" class="fm-view-btn" data-view="grade" title="Grade" aria-label="Grade"><i class="bi bi-grid-3x3-gap-fill"></i></button>
                                            </div>
                                            <select class="fm-select" id="fmOrdenar" aria-label="Ordenar arquivos por">
                                                <option value="manual">Manual (arrastar)</option>
                                                <option value="nome">Nome (A–Z)</option>
                                                <option value="nome_desc">Nome (Z–A)</option>
                                                <option value="data_desc">Mais recentes</option>
                                                <option value="data">Mais antigos</option>
                                                <option value="tamanho_desc">Maiores</option>
                                                <option value="tamanho">Menores</option>
                                            </select>
                                        </div>
                                    </div>

                                    {# Barra de progresso de upload #}
                                    <div class="fm-upload-bar" id="fmUploadBar">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                        <span class="fm-upload-nome" id="fmUploadNome"></span>
                                        <div class="progress" role="progressbar" aria-label="Progresso do upload"><div class="progress-bar" id="fmUploadProgresso" style="width:0%"></div></div>
                                        <span class="text-muted small text-nowrap" id="fmUploadContador"></span>
                                    </div>

                                    <div class="fm-body" id="fmBody">

                                        {# Checklist (relocado da coluna antiga; JS de checklist existente permanece intacto) #}
                                        <div class="fm-grupo" id="fmChecklist">
                                            <div class="card card-outline card-secondary mb-0">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <h6 class="text-muted mb-0"><i class="bi bi-check2-square me-1"></i> Checklist de Documentação</h6>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span id="checklistBadge" class="badge {{ concluidosChecklist == totalChecklist and totalChecklist > 0 ? 'text-bg-success' : 'text-bg-warning' }}">
                                                                {{ concluidosChecklist }}/{{ totalChecklist }} itens
                                                            </span>
                                                            <button type="button" id="btnChecklistEditar" class="btn btn-sm btn-outline-secondary" title="Editar checklist">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            <button type="button" id="btnChecklistAdicionar" class="btn btn-sm btn-outline-primary" title="Adicionar item">
                                                                <i class="bi bi-plus-lg"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <ul id="checklistLista" class="list-unstyled mb-2">
                                                        {% for item in checklistItens %}
                                                        <li class="checklist-item d-flex align-items-center gap-2 py-1 border-bottom"
                                                            data-item-id="{{ item.id }}"
                                                            data-csrf-item="{{ csrf_token('checklist_item_' ~ item.id) }}">
                                                            <button type="button" class="btn btn-link p-0 border-0 js-checklist-toggle" title="{{ item.concluido ? 'Marcar como pendente' : 'Marcar como concluído' }}">
                                                                <i class="bi {{ item.concluido ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }} fs-5"></i>
                                                            </button>
                                                            <span class="checklist-drag-handle d-none text-muted" style="cursor:grab" title="Arrastar para reordenar">
                                                                <i class="bi bi-grip-vertical"></i>
                                                            </span>
                                                            <span class="checklist-item-titulo flex-grow-1 {{ item.concluido ? 'text-decoration-line-through text-muted' : '' }}">
                                                                {{ item.titulo|e }}
                                                            </span>
                                                            <input type="text" class="checklist-item-input form-control form-control-sm flex-grow-1 d-none"
                                                                   value="{{ item.titulo|e('html_attr') }}" maxlength="255">
                                                            <button type="button" class="btn btn-sm btn-outline-danger js-checklist-excluir d-none" title="Excluir item">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </li>
                                                        {% else %}
                                                        <li id="checklistVazio" class="text-muted small py-2">
                                                            Nenhum item. Clique em <i class="bi bi-plus-lg"></i> para adicionar.
                                                        </li>
                                                        {% endfor %}
                                                    </ul>
                                                    <div id="checklistFormAdicionar" class="d-none mb-1">
                                                        <div class="input-group input-group-sm">
                                                            <input type="text" id="checklistNovoTitulo" class="form-control" placeholder="Descrição do item..." maxlength="255">
                                                            <button type="button" id="btnChecklistSalvarNovo" class="btn btn-primary"><i class="bi bi-check-lg"></i></button>
                                                            <button type="button" id="btnChecklistCancelarNovo" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
                                                        </div>
                                                        <div id="checklistErroNovo" class="text-danger small mt-1 d-none"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        {# Pastas (só na raiz) #}
                                        <div class="fm-grupo" id="fmGrupoPastas">
                                            <div class="fm-grupo-titulo"><i class="bi bi-folder2"></i> Pastas</div>
                                            <div class="fm-pastas" id="fmPastas">
                                                {% for secao in secoes %}
                                                    <div class="fm-pasta" data-secao-id="{{ secao.id }}" data-nome="{{ secao.nome|e('html_attr') }}"
                                                         data-url-renomear="{{ path('pasta_secao_renomear', {secaoId: secao.id}) }}"
                                                         data-csrf-renomear="{{ csrf_token('pasta_secao_renomear_' ~ secao.id) }}"
                                                         data-url-excluir="{{ path('pasta_secao_excluir', {secaoId: secao.id}) }}"
                                                         data-csrf-excluir="{{ csrf_token('pasta_secao_excluir_' ~ secao.id) }}"
                                                         data-pai-id="{{ secao.pai ? secao.pai.id : '' }}"
                                                         data-url-mover="{{ path('pasta_secao_mover', {secaoId: secao.id}) }}"
                                                         data-csrf-mover="{{ csrf_token('pasta_secao_mover_' ~ secao.id) }}"
                                                         tabindex="0" role="button" aria-label="Abrir pasta {{ secao.nome|e('html_attr') }}">
                                                        <span class="fm-pasta-grip" title="Arrastar para reordenar"><i class="bi bi-grip-vertical"></i></span>
                                                        <span class="fm-pasta-icone"><i class="bi bi-folder-fill"></i></span>
                                                        <span class="fm-pasta-info">
                                                            <span class="fm-pasta-nome" title="{{ secao.nome|e('html_attr') }}">{{ secao.nome }}</span>
                                                            <span class="fm-pasta-contagem" data-secao-contagem="{{ secao.id }}">{{ secao.documentos|length }} {{ secao.documentos|length == 1 ? 'arquivo' : 'arquivos' }}</span>
                                                        </span>
                                                        <div class="dropdown">
                                                            <button class="fm-pasta-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ações da pasta" onclick="event.stopPropagation()"><i class="bi bi-three-dots-vertical"></i></button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><button class="dropdown-item fm-pasta-abrir" type="button"><i class="bi bi-folder2-open me-2"></i>Abrir</button></li>
                                                                <li><button class="dropdown-item fm-pasta-renomear" type="button"><i class="bi bi-pencil me-2"></i>Renomear</button></li>
                                                                <li><button class="dropdown-item fm-pasta-mover" type="button"><i class="bi bi-folder-symlink me-2"></i>Mover para...</button></li>
                                                                <li><hr class="dropdown-divider"></li>
                                                                <li><button class="dropdown-item text-danger fm-pasta-excluir" type="button"><i class="bi bi-trash me-2"></i>Excluir</button></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>

                                        {# Arquivos #}
                                        <div class="fm-grupo" id="fmGrupoArquivos">
                                            <div class="fm-grupo-titulo"><i class="bi bi-files"></i> <span id="fmArquivosTitulo">Arquivos</span></div>
                                            <div class="fm-arquivos fm-lista" id="fmArquivos">
                                                <div class="fm-lista-head">
                                                    <span class="fmh-grip"></span><span>Nome</span><span class="fmh-tipo">Categoria</span>
                                                    <span class="fmh-tam">Tamanho</span><span class="fmh-data">Modificado</span><span class="fmh-acoes"></span>
                                                </div>
                                                {% for item in arquivosFm %}
                                                    {% set doc = item.doc %}
                                                    {% set secaoKey = item.secao %}
                                                    {% set ic = arquivo_icone(doc.nomeOriginal, doc.mimeType) %}
                                                    <div class="fm-arquivo" data-secao="{{ secaoKey }}" data-doc-id="{{ doc.id }}" data-ordem="{{ doc.ordem }}"
                                                         data-nome="{{ doc.nomeOriginal|e('html_attr') }}" data-tamanho="{{ doc.tamanhoBytes }}"
                                                         data-data="{{ doc.carregadoEm|date('Y-m-d H:i:s') }}" data-tipo="{{ ic.rotulo|e('html_attr') }}"
                                                         data-mime="{{ doc.mimeType|e('html_attr') }}"
                                                         data-url-mover="{{ path('pasta_documento_mover_secao', {docId: doc.id}) }}"
                                                         data-csrf-mover="{{ csrf_token('pasta_doc_mover_' ~ doc.id) }}">
                                                        <span class="fm-arq-grip" title="Arrastar para reordenar"><i class="bi bi-grip-vertical"></i></span>
                                                        <div class="fm-arq-principal">
                                                            <span class="fm-arq-icone"><i class="bi {{ ic.icone }}" style="color: {{ ic.cor }}"></i></span>
                                                            <span class="text-truncate">
                                                                <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="fm-arq-nome" title="{{ doc.nomeOriginal|e('html_attr') }}">{{ doc.nomeOriginal }}</a>
                                                                <span class="fm-arq-sub">{% if doc.numero %}Nº {{ doc.numero }}{% if doc.descricao %} · {% endif %}{% endif %}{{ doc.descricao ?? '' }}</span>
                                                                <span class="fm-arq-local fm-oculto text-muted small"></span>
                                                            </span>
                                                        </div>
                                                        <div class="fm-arq-tipo"><span class="fm-badge-cat">{{ documentTypeOptions[doc.categoria] ?? doc.categoria }}</span></div>
                                                        <div class="fm-arq-tam">{{ doc.tamanhoBytes|formatar_bytes }}</div>
                                                        <div class="fm-arq-data">{{ doc.carregadoEm|date('d/m/Y') }}</div>
                                                        <div class="fm-arq-acoes">
                                                            <div class="dropdown">
                                                                <button class="fm-arq-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ações do arquivo"><i class="bi bi-three-dots-vertical"></i></button>
                                                                <ul class="dropdown-menu dropdown-menu-end">
                                                                    <li><a class="dropdown-item" href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener"><i class="bi bi-download me-2"></i>Baixar</a></li>
                                                                    <li><button type="button" class="dropdown-item fm-arq-preview" data-url="{{ path('pasta_documento_view', {id: doc.id}) }}" data-nome="{{ doc.nomeOriginal|e('html_attr') }}" data-mime="{{ doc.mimeType|e('html_attr') }}"><i class="bi bi-eye me-2"></i>Visualizar</button></li>
                                                                    <li><button type="button" class="dropdown-item fm-arq-editar" data-target="#editDocModal{{ doc.id }}"><i class="bi bi-pencil me-2"></i>Editar</button></li>
                                                                    <li><button type="button" class="dropdown-item fm-arq-mover"><i class="bi bi-folder-symlink me-2"></i>Mover para…</button></li>
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li>
                                                                        <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Excluir este arquivo? Esta ação não pode ser desfeita.');">
                                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Excluir</button>
                                                                        </form>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <div class="fm-vazio fm-oculto" id="fmArquivosVazio">
                                                <div class="fm-vazio-icone"><i class="bi bi-cloud-arrow-up"></i></div>
                                                <div class="fm-vazio-titulo">Nenhum arquivo aqui</div>
                                                <div class="fm-vazio-dica">Arraste arquivos do computador para esta área ou clique em <strong>Enviar</strong>.</div>
                                            </div>
                                        </div>

                                    </div>{# /fm-body #}
                                </div>{# /fm #}

                                {# Realce do cartão de pasta como alvo ao arrastar outra pasta por cima (mover para dentro). #}
                                <style>
                                .fm-pasta-alvo { outline: 2px dashed var(--bs-primary); outline-offset: 2px; }
                                </style>

                                {# Modal reutilizável de texto (nova pasta / renomear) #}
                                <div class="modal fade" id="fmInputModal" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content">
                                            <div class="modal-header"><h5 class="modal-title" id="fmInputTitulo">Nova pasta</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
                                            <div class="modal-body">
                                                <input type="text" class="form-control" id="fmInputCampo" maxlength="255" placeholder="Nome da pasta...">
                                                <div class="text-danger small mt-1 d-none" id="fmInputErro"></div>
                                            </div>
                                            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-primary" id="fmInputConfirmar">Salvar</button></div>
                                        </div>
                                    </div>
                                </div>

                                {# Modal mover arquivo para pasta #}
                                <div class="modal fade" id="fmMoverModal" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-folder-symlink me-1"></i> Mover para…</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
                                            <div class="modal-body"><div class="list-group" id="fmMoverLista"></div></div>
                                        </div>
                                    </div>
                                </div>

                                {# Modal escolher pasta de destino (mover pasta pelo menu "Mover para...") #}
                                <div class="modal fade" id="fmDestinoModal" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content">
                                            <div class="modal-header"><h5 class="modal-title" id="fmDestinoTitulo">Mover para</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
                                            <div class="modal-body">
                                                <select class="form-select" id="fmDestinoCampo" aria-label="Pasta de destino"></select>
                                            </div>
                                            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-primary" id="fmDestinoConfirmar">Mover</button></div>
                                        </div>
                                    </div>
                                </div>
                            </div>{# /tab-pane #documentos #}

                        </div>
                    </div>

                    {# Coluna antiga de documentos — movida para a aba "Documentos". Desativada (mantida para referência; remover no cleanup). #}
                    {% if false %}
                    <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2">
                        {# Card: Documentação #}
                        {% set totalDocsGeral = 0 %}
                        {% for tipo, docs in documentosPorTipo %}{% set totalDocsGeral = totalDocsGeral + docs|length %}{% endfor %}
                        <div class="doc-folder-wrapper">
                        <div class="card card-primary card-outline mb-3 doc-folder-card" data-secao-destino="geral">
                            <div class="card-header d-flex align-items-center doc-folder-header">
                                <h3 class="card-title me-auto"><i class="bi bi-folder-fill me-1"></i> Documentação <span class="badge text-bg-secondary ms-1 js-secao-contador" id="contadorSecaoGeral">{{ totalDocsGeral }} {{ totalDocsGeral == 1 ? 'arquivo' : 'arquivos' }}</span></h3>
                                <button type="button" class="btn btn-tool" data-bs-toggle="collapse"
                                        data-bs-target="#documentacaoBody" aria-expanded="false"
                                        id="btnDocumentacaoToggle">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                            <div class="collapse" id="documentacaoBody">
                            <div class="card-body">
                                {# Checklist dinâmico #}
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="text-muted mb-0"><i class="bi bi-check2-square me-1"></i> Checklist de Documentação</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span id="checklistBadge" class="badge {{ concluidosChecklist == totalChecklist and totalChecklist > 0 ? 'text-bg-success' : 'text-bg-warning' }}">
                                            {{ concluidosChecklist }}/{{ totalChecklist }} itens
                                        </span>
                                        <button type="button" id="btnChecklistEditar" class="btn btn-sm btn-outline-secondary" title="Editar checklist">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" id="btnChecklistAdicionar" class="btn btn-sm btn-outline-primary" title="Adicionar item">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>

                                <ul id="checklistLista" class="list-unstyled mb-2">
                                    {% for item in checklistItens %}
                                    <li class="checklist-item d-flex align-items-center gap-2 py-1 border-bottom"
                                        data-item-id="{{ item.id }}"
                                        data-csrf-item="{{ csrf_token('checklist_item_' ~ item.id) }}">
                                        <button type="button" class="btn btn-link p-0 border-0 js-checklist-toggle" title="{{ item.concluido ? 'Marcar como pendente' : 'Marcar como concluído' }}">
                                            <i class="bi {{ item.concluido ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' }} fs-5"></i>
                                        </button>
                                        <span class="checklist-drag-handle d-none text-muted" style="cursor:grab" title="Arrastar para reordenar">
                                            <i class="bi bi-grip-vertical"></i>
                                        </span>
                                        <span class="checklist-item-titulo flex-grow-1 {{ item.concluido ? 'text-decoration-line-through text-muted' : '' }}">
                                            {{ item.titulo|e }}
                                        </span>
                                        <input type="text" class="checklist-item-input form-control form-control-sm flex-grow-1 d-none"
                                               value="{{ item.titulo|e('html_attr') }}" maxlength="255">
                                        <button type="button" class="btn btn-sm btn-outline-danger js-checklist-excluir d-none" title="Excluir item">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </li>
                                    {% else %}
                                    <li id="checklistVazio" class="text-muted small py-2">
                                        Nenhum item. Clique em <i class="bi bi-plus-lg"></i> para adicionar.
                                    </li>
                                    {% endfor %}
                                </ul>

                                <div id="checklistFormAdicionar" class="d-none mb-2">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="checklistNovoTitulo" class="form-control" placeholder="Descrição do item..." maxlength="255">
                                        <button type="button" id="btnChecklistSalvarNovo" class="btn btn-primary"><i class="bi bi-check-lg"></i></button>
                                        <button type="button" id="btnChecklistCancelarNovo" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <div id="checklistErroNovo" class="text-danger small mt-1 d-none"></div>
                                </div>

                                <hr>

                                {# Arquivos por categoria #}
                                <h6 class="text-muted mb-3"><i class="bi bi-folder me-1"></i> Arquivos da Pasta</h6>

                                {# Formulário de upload inline #}
                                <form id="formAnexos" method="post" enctype="multipart/form-data"
                                      action="{{ path('pasta_documento_upload', {id: pasta.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_pasta_' ~ pasta.id) }}">

                                    <div id="geralDropArea" class="rounded p-2 mb-2 text-center text-muted small"
                                         style="border:2px dashed #ced4da;min-height:52px;transition:background .15s;">
                                        <i class="bi bi-cloud-upload me-1"></i> Arraste arquivos do computador aqui
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <button type="button" id="btnAdicionarAnexo" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                        </button>
                                        <button type="button" id="btnLimparAnexos" class="btn btn-sm btn-outline-secondary d-none">
                                            <i class="bi bi-x-circle me-1"></i> Limpar
                                        </button>
                                        <input type="file" id="inputAnexoOculto" multiple
                                               accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                                               class="d-none">
                                    </div>

                                    <div id="listaAnexos"></div>

                                    <div id="areaEnviar" class="d-none mt-3">
                                        <div class="form-check form-switch">
                                            <input type="checkbox" class="form-check-input" id="reduzirTamanhoGeral" name="reduzir_tamanho" value="1">
                                            <label class="form-check-label" for="reduzirTamanhoGeral">
                                                Reduzir tamanho dos arquivos (economiza espaço)
                                            </label>
                                        </div>
                                        <div class="form-text text-muted mb-2">
                                            Mantenha desligado para preservar a qualidade original.
                                            <span class="d-block text-warning-emphasis">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                PDFs assinados digitalmente podem ter a assinatura invalidada ao reduzir o tamanho.
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-cloud-upload me-1"></i> Enviar todos
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                {# Documentos já enviados #}
                                {% set hasDocuments = false %}
                                {% for tipo, docs in documentosPorTipo %}
                                    {% if docs|length > 0 %}{% set hasDocuments = true %}{% endif %}
                                {% endfor %}

                                {% if hasDocuments %}<hr>{% endif %}
                                <div class="mb-3 docs-list-scroll" id="documentosGerais" data-secao-destino="geral">
                                    {% for tipo, docs in documentosPorTipo %}
                                        {% if docs|length > 0 %}
                                            {% set label = documentTypeOptions[tipo] ?? tipo %}
                                            {% for doc in docs %}
                                                <div class="d-flex align-items-center border rounded px-3 py-2 mb-2 gap-3 doc-item"
                                                     data-doc-id="{{ doc.id }}"
                                                     data-secao-id=""
                                                     data-csrf-mover="{{ csrf_token('pasta_doc_mover_' ~ doc.id) }}"
                                                     data-url-mover="{{ path('pasta_documento_mover_secao', {docId: doc.id}) }}">
                                                    <i class="bi bi-grip-vertical text-muted flex-shrink-0 doc-grip" style="cursor:grab;"></i>
                                                    <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold">
                                                            {{ doc.nomeOriginal }}
                                                        </a>
                                                        <small class="text-muted">
                                                            {{ label }}
                                                            {% if doc.descricao %} · {{ doc.descricao }}{% endif %}
                                                            {% if doc.numero %} · Nº {{ doc.numero }}{% endif %}
                                                            · {{ doc.carregadoEm|date('d/m/Y') }}
                                                            · {{ (doc.tamanhoBytes / 1024 / 1024) < 1 ? (doc.tamanhoBytes / 1024)|round(1) ~ ' KB' : (doc.tamanhoBytes / 1024 / 1024)|round(2) ~ ' MB' }}
                                                        </small>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0 doc-acoes">
                                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                                title="Visualizar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#previewDocModal"
                                                                data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                                data-nome="{{ doc.nomeOriginal }}"
                                                                data-mime="{{ doc.mimeType }}">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="Editar"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editDocModal{{ doc.id }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            </div>{# /collapse show #}
                        </div>{# /doc-folder-card #}
                        </div>{# /doc-folder-wrapper #}

                        {# Cards de seções de documentos #}
                        {% for secao in secoes %}
                        <div class="card card-outline card-secondary mb-3 pasta-secao-card"
                             id="secaoCard{{ secao.id }}"
                             data-secao-destino="{{ secao.id }}">
                            <div class="card-header d-flex align-items-center py-2">
                                <span class="pasta-secao-nome fw-semibold me-auto">{{ secao.nome|e }} <span class="badge text-bg-secondary ms-1 js-secao-contador">{{ secao.documentos|length }} {{ secao.documentos|length == 1 ? 'arquivo' : 'arquivos' }}</span></span>
                                <div class="d-flex align-items-center gap-1 ms-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-secao-renomear-btn" title="Renomear seção"
                                            data-secao-id="{{ secao.id }}"
                                            data-nome-atual="{{ secao.nome|e('html_attr') }}"
                                            data-csrf="{{ csrf_token('pasta_secao_renomear_' ~ secao.id) }}"
                                            data-url="{{ path('pasta_secao_renomear', {secaoId: secao.id}) }}">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-secao-excluir-btn" title="Excluir seção"
                                            data-secao-id="{{ secao.id }}"
                                            data-csrf="{{ csrf_token('pasta_secao_excluir_' ~ secao.id) }}"
                                            data-url="{{ path('pasta_secao_excluir', {secaoId: secao.id}) }}"
                                            data-nome="{{ secao.nome|e('html_attr') }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <button type="button" class="btn btn-tool js-secao-toggle" data-bs-toggle="collapse"
                                            data-bs-target="#secaoBody{{ secao.id }}" aria-expanded="false">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="collapse" id="secaoBody{{ secao.id }}">
                                <div class="card-body secao-dropzone p-2" data-secao-destino="{{ secao.id }}">
                                    <div class="secao-drop-area rounded p-2 mb-2 text-center text-muted small"
                                         data-secao-destino="{{ secao.id }}"
                                         style="border: 2px dashed #ced4da; min-height: 52px; transition: background .15s;">
                                        <i class="bi bi-cloud-upload me-1"></i> Arraste arquivos do computador aqui
                                    </div>
                                    <form class="secao-upload-form" method="post" enctype="multipart/form-data"
                                          action="{{ path('pasta_documento_upload', {id: pasta.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_pasta_' ~ pasta.id) }}">
                                        <input type="hidden" name="secao_id" value="{{ secao.id }}">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <button type="button" class="btn btn-sm btn-primary js-secao-add-file" data-secao="{{ secao.id }}">
                                                <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-secao-limpar d-none" data-secao="{{ secao.id }}">
                                                <i class="bi bi-x-circle me-1"></i> Limpar
                                            </button>
                                            <input type="file" class="js-secao-file-input d-none" multiple
                                                   accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                                                   data-secao="{{ secao.id }}">
                                        </div>
                                        <div class="js-secao-lista-anexos" data-secao="{{ secao.id }}"></div>
                                        <div class="js-secao-area-enviar d-none mt-2" data-secao="{{ secao.id }}">
                                            <div class="form-check form-switch">
                                                <input type="checkbox" class="form-check-input" id="reduzirTamanhoSecao{{ secao.id }}" name="reduzir_tamanho" value="1">
                                                <label class="form-check-label small" for="reduzirTamanhoSecao{{ secao.id }}">
                                                    Reduzir tamanho dos arquivos (economiza espaço)
                                                </label>
                                            </div>
                                            <div class="form-text text-muted mb-2">
                                                Mantenha desligado para preservar a qualidade original.
                                                <span class="d-block text-warning-emphasis">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                                    PDFs assinados podem ter a assinatura invalidada ao reduzir o tamanho.
                                                </span>
                                            </div>
                                            <div class="text-end">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-cloud-upload me-1"></i> Enviar todos
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                    <div class="js-secao-docs docs-list-scroll" data-secao-destino="{{ secao.id }}">
                                        {% for doc in secao.documentos %}
                                            {% set label = documentTypeOptions[doc.categoria] ?? doc.categoria %}
                                            <div class="d-flex align-items-center border rounded px-2 py-2 mb-2 gap-2 doc-item"
                                                 data-doc-id="{{ doc.id }}"
                                                 data-secao-id="{{ secao.id }}"
                                                 data-csrf-mover="{{ csrf_token('pasta_doc_mover_' ~ doc.id) }}"
                                                 data-url-mover="{{ path('pasta_documento_mover_secao', {docId: doc.id}) }}">
                                                <i class="bi bi-grip-vertical text-muted flex-shrink-0 doc-grip" style="cursor:grab;"></i>
                                                <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold small">
                                                        {{ doc.nomeOriginal }}
                                                    </a>
                                                    <small class="text-muted">
                                                        {{ label }}{% if doc.descricao %} · {{ doc.descricao }}{% endif %}{% if doc.numero %} · Nº {{ doc.numero }}{% endif %} · {{ doc.carregadoEm|date('d/m/Y') }}
                                                    </small>
                                                </div>
                                                <div class="d-flex gap-1 flex-shrink-0 doc-acoes">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Visualizar"
                                                            data-bs-toggle="modal" data-bs-target="#previewDocModal"
                                                            data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                            data-nome="{{ doc.nomeOriginal }}"
                                                            data-mime="{{ doc.mimeType }}">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}

                        {# Card "vazado" para criar nova seção #}
                        <div class="card mb-3" id="cardNovaSecao"
                             style="border: 2px dashed #ced4da; background: transparent;">
                            <div class="card-body py-2">
                                <div id="novaSecaoBotao" class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnMostrarNovaSecao">
                                        <i class="bi bi-folder-plus me-1"></i> Nova seção de documentos
                                    </button>
                                </div>
                                <div id="novaSecaoForm" class="d-none">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="novaSecaoNome" class="form-control" placeholder="Nome da seção..." maxlength="255">
                                        <button type="button" id="btnSalvarNovaSecao" class="btn btn-primary">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" id="btnCancelarNovaSecao" class="btn btn-outline-secondary">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <div id="novaSecaoErro" class="text-danger small mt-1 d-none"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('expediente_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar às Pastas
                    </a>
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          class="d-flex"
                          onsubmit="return confirm('Tem certeza que deseja excluir esta pasta? Esta ação não pode ser desfeita.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <button type="submit"
                                class="btn btn-outline-danger btn-sm"
                                title="Excluir pasta"
                                aria-label="Excluir pasta">
                            <i class="bi bi-trash me-1"></i> Excluir Pasta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

