                                <input type="text" id="mp-classeProcessual" name="classeProcessual" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label for="mp-assuntoProcessual" class="form-label">
                                    Assunto Processual <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="mp-assuntoProcessual" name="assuntoProcessual" class="form-control" required>
                            </div>
                            <div class="col-md-4">
                                <label for="mp-situacaoProcesso" class="form-label">Situação <span class="text-danger">*</span></label>
                                <select id="mp-situacaoProcesso" name="situacaoProcesso" class="form-select" required>
                                    <option value="EM_ANDAMENTO" selected>Em Andamento</option>
