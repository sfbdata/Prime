/* ── Timeline: envio AJAX de mensagem ──────────────────── */
(function () {
    const form        = document.getElementById('formTimelineMensagem');
    const textarea    = document.getElementById('timelineConteudo');
    const btnEnviar   = document.getElementById('btnEnviarMensagem');
    const erroDiv     = document.getElementById('timelineMensagemErro');
    const list        = document.getElementById('timelineList');
    const countBadge  = document.getElementById('timeline-count');
    const vazioMsg    = document.getElementById('timelineVazio');
    const urlEnviar   = '{{ path("pasta_enviar_mensagem", {id: pasta.id}) }}';
    const urlEditarTpl  = '{{ path("pasta_editar_mensagem", {id: pasta.id, msgId: 0})|replace({"/0/": "/__ID__/"}) }}';
    const urlExcluirTpl = '{{ path("pasta_excluir_mensagem", {id: pasta.id, msgId: 0})|replace({"/0/": "/__ID__/"}) }}';
    const ROTULO_ORFA      = 'Resposta a uma mensagem excluída';

    /* PAS-034: a janela e o aviso da tela (pasta-dialogos.js), no lugar do confirm/alert. */
    function avisarErroReg(msg) {
        if (window.avisarPs) { avisarPs(msg, 'erro'); } else { alert(msg); }
    }

    /* "Excluir o comentário de NOME?" com a data e o trecho (dc L.5906 `comExcluir`). */
    function confirmarExclusaoReg(cartao) {
        const autor = (cartao && cartao.querySelector('.ps-anotacao-autor') || {}).textContent || 'colaborador';
        const data  = cartao ? cartao.querySelector('.ps-anotacao-data') : null;
        const corpo = cartao ? cartao.querySelector('.pasta-msg-conteudo .ql-editor') : null;
        const txt   = (corpo ? corpo.innerText : '').replace(/\s+/g, ' ').trim();
        const opcoes = {
            titulo: 'Excluir o comentário de ' + autor.trim() + '?',
            texto: (data && data.title ? data.title + ' · ' : '') + '"' + txt.slice(0, 140) + (txt.length > 140 ? '…' : '')
                + '". Ele some para toda a equipe e a exclusão fica registrada no histórico.',
        };
        return window.confirmarPs ? confirmarPs(opcoes) : Promise.resolve(confirm(opcoes.titulo));
    }

    /* ── Responder (PAS-030; dc L.1316-1322 `respOn`, L.5958) ───────────────
       A caixa abre LOGO ABAIXO do cartão respondido (a raiz: responder a uma resposta
       liga à raiz, um nível só): faixa "Respondendo a NOME", o campo "Escreva a
       resposta…", Cancelar e Responder (apagado sem texto). Ctrl+Enter envia, Esc
       fecha. Uma caixa por vez. O envio é o MESMO `pasta_enviar_mensagem`, com o CSRF
       do compositor e `resposta_a` = id da raiz; a posse é conferida no servidor. O
       texto vira parágrafos escapados aqui — o servidor sanitiza de novo. */
    let caixaResp = null; // { el, raizId, campo }

    function fecharCaixaResposta() {
        if (!caixaResp) { return; }
        caixaResp.el.remove();
        caixaResp = null;
    }

    function paragrafosDe(texto) {
        return String(texto).split(/\r?\n/).map(function (linha) {
            const limpa = linha.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return '<p>' + (limpa.trim() === '' ? '<br>' : limpa) + '</p>';
        }).join('');
    }

    function abrirCaixaResposta(botao) {
        const raizId = String(botao.dataset.respostaA || '');
        const raiz   = document.getElementById('pasta-msg-' + raizId);
        if (!raiz) { return; }
        fecharCaixaResposta();

        const el = document.createElement('div');
        el.className = 'ps-resp-caixa';
        el.setAttribute('data-resp-caixa', raizId);

        const faixa = document.createElement('div');
        faixa.className = 'ps-resp-caixa-faixa';
        const icone = document.createElement('i');
        icone.className = 'bi bi-reply-fill';
        icone.setAttribute('aria-hidden', 'true');
        const para = document.createElement('span');
        para.textContent = 'Respondendo a ' + (botao.dataset.respostaNome || 'Autor desconhecido');
        faixa.appendChild(icone);
        faixa.appendChild(para);

        const campo = document.createElement('textarea');
        campo.className = 'ps-resp-caixa-campo';
        campo.rows = 2;
        campo.maxLength = 5000;
        campo.placeholder = 'Escreva a resposta…';
        campo.setAttribute('aria-label', para.textContent);

        const erro = document.createElement('div');
        erro.className = 'ps-resp-caixa-erro';
        erro.hidden = true;

        const cancelar = document.createElement('button');
        cancelar.type = 'button';
        cancelar.className = 'ps-resp-caixa-cancelar';
        cancelar.textContent = 'Cancelar';

        const enviar = document.createElement('button');
        enviar.type = 'button';
        enviar.className = 'ps-resp-caixa-enviar';
        enviar.disabled = true;
        const iEnviar = document.createElement('i');
        iEnviar.className = 'bi bi-send';
        iEnviar.setAttribute('aria-hidden', 'true');
        enviar.appendChild(iEnviar);
        enviar.appendChild(document.createTextNode('Responder'));

        const acoes = document.createElement('div');
        acoes.className = 'ps-resp-caixa-acoes';
        acoes.appendChild(cancelar);
        acoes.appendChild(enviar);

        el.appendChild(faixa);
        el.appendChild(campo);
        el.appendChild(erro);
        el.appendChild(acoes);
        raiz.after(el);
        caixaResp = { el: el, raizId: raizId, campo: campo };

        campo.addEventListener('input', function () { enviar.disabled = campo.value.trim() === ''; });
        campo.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); enviar.click(); }
            else if (e.key === 'Escape') { e.preventDefault(); fecharCaixaResposta(); botao.focus(); }
        });
        cancelar.addEventListener('click', function () { fecharCaixaResposta(); });
        enviar.addEventListener('click', async function () {
            const texto = campo.value.trim();
            const token = form ? form.querySelector('input[name="_token"]') : null;
            if (texto === '' || !token) { return; }
            enviar.disabled = true;
            erro.hidden = true;
            let html = paragrafosDe(texto);
            if (window.PastaMencoes) { html = PastaMencoes.paraEnvio(campo, html); }
            const fd = new FormData();
            fd.append('_token', token.value);
            fd.append('resposta_a', raizId);
            fd.append('conteudo', html);
            try {
                const resp = await fetch(urlEnviar, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await resp.json();
                if (!resp.ok) {
                    erro.textContent = data.erro ?? 'Erro ao enviar a resposta.';
                    erro.hidden = false;
                    enviar.disabled = false;
                    return;
                }
                fecharCaixaResposta();
                const conta = inserirMensagem(data);
                if (vazioMsg) { vazioMsg.remove(); }
                if (countBadge && conta) { countBadge.textContent = parseInt(countBadge.textContent || '0', 10) + 1; }
            } catch (_) {
                erro.textContent = 'Erro de rede. Tente novamente.';
                erro.hidden = false;
                enviar.disabled = false;
            }
        });

        /* PAS-031: responder a uma resposta já começa com "@PrimeiroNome " do autor dela, e ela
           vai como menção REAL: o mesmo registro de menções que o `PastaMencoes.ligar` guarda
           na textarea (`_mencoes`), que o `paraEnvio` transforma no token `@[Nome](user:ID)`. */
        const autorId = Number(botao.dataset.respostaAutorId || 0);
        const primeiro = String(botao.dataset.respostaAutorNome || '').trim().split(/\s+/)[0] || '';
        if (autorId > 0 && primeiro !== '') {
            campo.value = '@' + primeiro + ' ';
            campo._mencoes = [{ id: autorId, nome: primeiro }];
            enviar.disabled = false;
        }

        campo.focus();
        campo.setSelectionRange(campo.value.length, campo.value.length);
        el.scrollIntoView({ block: 'nearest' });
    }

    /* ── Menu do registro (PAS-025; dc L.5958 `regsLinha`) ─────────────────
       Botão direito no cartão — no ponto do clique — ou o ⋮ do cartão (teclado e
       toque) abrem o MESMO #psRegMenu, preenchido com o cartão. Cada item clica o
       botão que o cartão já tem: a ação, o CSRF e a URL são os de sempre. Editar e
       Excluir levam os minutos que restam ("· N min"); sem os botões ou com a
       janela vencida, ficam à vista e desabilitados, "· bloqueado" com cadeado e o
       motivo na dica (o `comPerm` do desenho, sem a frase do usuário primário, que
       aqui não tem a exceção — como o Financeiro). */
    const menuReg = document.getElementById('psRegMenu');
    const REG_MOTIVO_PRAZO = 'O prazo de 15 minutos para editar ou excluir terminou.';
    const REG_MOTIVO_AUTOR = 'Só o autor pode editar ou excluir, nos 15 minutos após publicar.';
    let regAberto = null; // { cartao, gatilho }

    function fecharMenuReg(devolverFoco) {
        if (!regAberto) { return; }
        menuReg.hidden = true;
        if (regAberto.gatilho) {
            regAberto.gatilho.setAttribute('aria-expanded', 'false');
            if (devolverFoco) { regAberto.gatilho.focus(); }
        }
        regAberto = null;
    }

    function pintarItemReg(item, pode, rotulo, icone, motivo) {
        item.disabled = !pode;
        if (pode) { item.removeAttribute('aria-disabled'); item.removeAttribute('title'); } else { item.setAttribute('aria-disabled', 'true'); item.title = motivo; }
        item.querySelector('i').className = 'bi ' + icone;
        item.querySelector('span').textContent = rotulo;
    }

    /* Minutos que restam na janela, com a regra do servidor (`minutosRestantes`: teto,
       de 1 a 15); 0 = vencida. */
    function minutosRestantesReg(cartao) {
        const ate = Number(cartao.dataset.janelaAte || 0) * 1000;
        const ms  = ate - Date.now();
        if (!ate || ms <= 0) { return 0; }
        return Math.min({{ comentario_janela_minutos() }}, Math.max(1, Math.ceil(ms / 60000)));
    }

    function abrirMenuReg(cartao, gatilho, x, y) {
        if (!menuReg || !cartao) { return; }
        const porClique = typeof x === 'number';
        if (!porClique && regAberto && regAberto.cartao === cartao) { fecharMenuReg(false); return; }
        fecharMenuReg(false);
        document.dispatchEvent(new CustomEvent('ps:fechar-popovers'));

        const autorEl = cartao.querySelector('.ps-anotacao-autor');
        const dataEl  = cartao.querySelector('.ps-anotacao-data');
        menuReg.querySelector('.js-reg-menu-titulo').textContent =
            (autorEl ? autorEl.textContent.trim() : '') + (dataEl && dataEl.title ? ' · ' + dataEl.title : '');

        // PAS-025b: na pasta excluída o menu nasce sem Responder, Editar e Excluir.
        const responder = menuReg.querySelector('.js-reg-responder');
        if (responder) { responder.hidden = !cartao.querySelector('.btn-responder-msg-pasta'); }

        const resto = minutosRestantesReg(cartao);
        const pode  = !!cartao.querySelector('.ps-anotacao-acoes .btn-editar-msg-pasta') && resto > 0;
        const motivo = cartao.dataset.doAutor === '1' ? REG_MOTIVO_PRAZO : REG_MOTIVO_AUTOR;
        const editar  = menuReg.querySelector('.js-reg-editar');
        const excluir = menuReg.querySelector('.js-reg-excluir');
        if (!editar || !excluir) {
            // lápide: sem itens de escrita para pintar
        } else if (pode) {
            pintarItemReg(editar, true, 'Editar · ' + resto + ' min', 'bi-pencil', '');
            pintarItemReg(excluir, true, 'Excluir comentário · ' + resto + ' min', 'bi-trash3', '');
        } else {
            pintarItemReg(editar, false, 'Editar · bloqueado', 'bi-lock', motivo);
            pintarItemReg(excluir, false, 'Excluir · bloqueado', 'bi-lock', motivo);
        }

        menuReg.hidden = false;
        let left;
        let top;
        if (porClique) {
            left = x;
            top  = y;
            if (top + menuReg.offsetHeight > window.innerHeight - 8) { top = y - menuReg.offsetHeight; }
        } else {
            const r = gatilho.getBoundingClientRect();
            left = r.right - menuReg.offsetWidth;
            top  = r.bottom + 4;
            if (top + menuReg.offsetHeight > window.innerHeight - 8) { top = r.top - menuReg.offsetHeight - 4; }
        }
        menuReg.style.left = Math.max(8, Math.min(left, window.innerWidth - menuReg.offsetWidth - 8)) + 'px';
        menuReg.style.top  = Math.max(8, top) + 'px';

        const seta = gatilho || cartao.querySelector('.js-reg-menu');
        if (seta) { seta.setAttribute('aria-expanded', 'true'); }
        regAberto = { cartao: cartao, gatilho: seta };
        const primeiro = menuReg.querySelector('.ps-processo-menu-item:not([disabled]):not([hidden])');
        if (primeiro) { primeiro.focus(); }
    }

    function copiarTextoReg(item, cartao) {
        const corpo  = cartao.querySelector('.pasta-msg-conteudo .ql-editor');
        const texto  = corpo ? corpo.innerText.trim() : '';
        const rotulo = item.querySelector('span');
        const original = rotulo ? rotulo.textContent : '';
        function avisar(msg) {
            if (rotulo) { rotulo.textContent = msg; }
            setTimeout(function () {
                if (rotulo) { rotulo.textContent = original; }
                if (regAberto && regAberto.cartao === cartao) { fecharMenuReg(false); }
            }, 1200);
        }
        if (texto && navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(texto).then(
                function () { avisar('Texto copiado'); },
                function () { avisar('Não foi possível copiar'); }
            );
        } else {
            avisar('Não foi possível copiar');
        }
    }

    if (menuReg && list) {
        // Botão direito no cartão. Links, botões, a caixa de edição e texto selecionado
        // seguem com o menu do navegador.
        list.addEventListener('contextmenu', function (e) {
            const alvo   = e.target;
            const cartao = alvo && alvo.closest ? alvo.closest('.ps-anotacao[id^="pasta-msg-"]') : null;
            if (!cartao) { return; }
            if (alvo.closest('a, button, input, textarea, select, [contenteditable="true"], .ps-anotacao-edicao')) { return; }
            const selecao = window.getSelection ? String(window.getSelection()) : '';
            if (selecao.trim() !== '') { return; }
            e.preventDefault();
            abrirMenuReg(cartao, null, e.clientX, e.clientY);
        });

        list.addEventListener('click', function (e) {
            const gatilho = e.target.closest('.js-reg-menu');
            if (!gatilho) { return; }
            abrirMenuReg(gatilho.closest('.ps-anotacao'), gatilho);
        });

        menuReg.addEventListener('click', function (e) {
            const item = e.target.closest('.ps-processo-menu-item');
            if (!item || item.disabled || !regAberto) { return; }
            const cartao = regAberto.cartao;
            if (item.classList.contains('js-reg-copiar')) { copiarTextoReg(item, cartao); return; }
            const seletor = item.classList.contains('js-reg-responder') ? '.btn-responder-msg-pasta'
                : item.classList.contains('js-reg-editar') ? '.ps-anotacao-acoes .btn-editar-msg-pasta'
                : item.classList.contains('js-reg-excluir') ? '.ps-anotacao-acoes .btn-excluir-msg-pasta'
                : null;
            fecharMenuReg(false);
            const alvo = seletor ? cartao.querySelector(seletor) : null;
            if (alvo) { alvo.click(); }
        });

        // Fora fecha (em captura); Esc fecha e devolve o foco; rolar/redimensionar fecha.
        document.addEventListener('click', function (e) {
            if (!regAberto) { return; }
            if (menuReg.contains(e.target) || (regAberto.gatilho && regAberto.gatilho.contains(e.target))) { return; }
            fecharMenuReg(false);
        }, true);
        document.addEventListener('keydown', function (e) {
            if (regAberto && e.key === 'Escape') { fecharMenuReg(true); }
        });
        window.addEventListener('resize', function () { fecharMenuReg(false); });
        window.addEventListener('scroll', function (e) {
            if (regAberto && !(e.target instanceof Node && menuReg.contains(e.target))) { fecharMenuReg(false); }
        }, true);
        document.addEventListener('ps:fechar-popovers', function () { fecharMenuReg(false); });
    }

    {# Editar/excluir mensagem (autor, dentro da janela de 15 min — `JanelaDeEdicaoDeComentario`) — delegado na lista #}
    if (list) {
        list.addEventListener('click', async function (e) {
            const btnResponder = e.target.closest('.btn-responder-msg-pasta');
            if (btnResponder) {
                abrirCaixaResposta(btnResponder);
                return;
            }

            const btnEditar = e.target.closest('.btn-editar-msg-pasta');
            if (btnEditar) {
                const msgId = btnEditar.dataset.msgId;
                const item  = document.getElementById('pasta-msg-' + msgId);
                if (!item) { return; }
                const conteudoDiv = item.querySelector('.pasta-msg-conteudo');
                if (!conteudoDiv || item.querySelector('.pasta-msg-edit-area')) { return; }

                /* @menção: o token `@[Nome](user:ID)` volta a "@Nome" no editor e fica lembrado
                   para virar token de novo ao salvar (pasta-mencoes.js). */
                const edicao = window.PastaMencoes
                    ? PastaMencoes.paraEdicao(btnEditar.dataset.conteudo)
                    : { html: btnEditar.dataset.conteudo, mencoes: [] };
                const conteudoAtual = edicao.html;

                /* PAS-032 (dc L.1314; bj-editor.js L.355-358): a edição acontece no próprio editor,
                   com o rodapé DENTRO da caixa — "Visível para a equipe" · espaço · Cancelar ·
                   Salvar —, a mesma moldura que Detalhes usa (`.ps-anotacao-edicao-rodape`). */
                const area = document.createElement('div');
                area.className = 'pasta-msg-edit-area ps-anotacao-texto ps-anotacao-edicao';

                const textareaEd = document.createElement('textarea');
                textareaEd.className = 'form-control form-control-sm';
                textareaEd.rows = 3;
                textareaEd.maxLength = 5000;
                textareaEd.value = conteudoAtual;
                textareaEd.dataset.editorRicoPendente = '1';

                const nota = document.createElement('span');
                nota.className = 'ps-compositor-nota';
                nota.textContent = 'Visível para a equipe';

                const espaco = document.createElement('span');
                espaco.className = 'ps-cab-espaco';

                const btnCancelar = document.createElement('button');
                btnCancelar.type = 'button';
                btnCancelar.className = 'ps-anotacao-edicao-cancelar';
                btnCancelar.textContent = 'Cancelar';

                const btnSalvar = document.createElement('button');
                btnSalvar.type = 'button';
                btnSalvar.className = 'ps-btn ps-btn--primario';
                btnSalvar.textContent = 'Salvar';

                const rodape = document.createElement('div');
                rodape.className = 'ps-anotacao-edicao-rodape';
                rodape.appendChild(nota);
                rodape.appendChild(espaco);
                rodape.appendChild(btnCancelar);
                rodape.appendChild(btnSalvar);

                // A moldura é a do compositor: o editor monta antes da textarea, dentro dela.
                const moldura = document.createElement('div');
                moldura.className = 'ps-compositor-caixa';
                moldura.appendChild(textareaEd);
                moldura.appendChild(rodape);
                area.appendChild(moldura);

                conteudoDiv.classList.add('d-none');
                conteudoDiv.after(area);

                // Transforma a textarea recem-criada em editor (o auto-init so pega o DOM inicial).
                if (window.EditorRico) {
                    const quillEd = EditorRico.montar(textareaEd);
                    // A lista do "@" é a do REGISTRO, dita aqui: sem isso o pasta-mencoes.js cairia no
                    // primeiro `[data-mencionaveis-url]` da página, que pode ser o do Financeiro.
                    textareaEd._mencoesUrl = '{{ path("pasta_mencionaveis", {id: pasta.id}) }}';
                    if (window.PastaMencoes) { PastaMencoes.ligar(textareaEd, edicao.mencoes); }
                    if (quillEd) { quillEd.focus(); } else { textareaEd.focus(); }
                } else {
                    textareaEd.focus();
                }

                btnCancelar.addEventListener('click', function () {
                    area.remove();
                    conteudoDiv.classList.remove('d-none');
                });

                btnSalvar.addEventListener('click', async function () {
                    // O editor esvazia a textarea quando nao ha texto real (`<p><br></p>` nao conta).
                    const vazio = window.EditorRico
                        ? EditorRico.estaVazio(textareaEd)
                        : textareaEd.value.trim() === '';
                    if (vazio) { avisarErroReg('A mensagem não pode ser vazia.'); return; }

                    btnSalvar.disabled = true;
                    const fd = new FormData();
                    fd.append('_token', btnEditar.dataset.csrf);
                    fd.append('conteudo', window.PastaMencoes ? PastaMencoes.paraEnvio(textareaEd, textareaEd.value) : textareaEd.value);

                    try {
                        const resp = await fetch(btnEditar.dataset.url, {
                            method: 'POST',
                            body: fd,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        });
                        const data = await resp.json();
                        if (resp.ok) {
                            // `conteudoHtml` vem SANITIZADO do servidor.
                            conteudoDiv.innerHTML = '<span class="editor-rico-conteudo"><span class="ql-editor">'
                                + (data.conteudoHtml ?? '') + '</span></span>';
                            btnEditar.dataset.conteudo = data.conteudo;
                            marcarEditado(item);
                            area.remove();
                            conteudoDiv.classList.remove('d-none');
                        } else {
                            avisarErroReg(data.erro ?? 'Erro ao editar.');
                            btnSalvar.disabled = false;
                        }
                    } catch (_) {
                        avisarErroReg('Erro de rede.');
                        btnSalvar.disabled = false;
                    }
                });

                return;
            }

            const btnExcluir = e.target.closest('.btn-excluir-msg-pasta');
            if (btnExcluir) {
                const msgId = btnExcluir.dataset.msgId;
                if (!(await confirmarExclusaoReg(document.getElementById('pasta-msg-' + msgId)))) { return; }

                const fd    = new FormData();
                fd.append('_token', btnExcluir.dataset.csrf);

                try {
                    const resp = await fetch(btnExcluir.dataset.url, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    if (resp.ok) {
                        const alvo = document.getElementById('pasta-msg-' + msgId);
                        /* A contagem é só das raízes (as respostas não contam, como no desenho).
                           Excluir a raiz: as respostas FICAM (o banco solta o vínculo) e passam a
                           contar e a dizer "Resposta a uma mensagem excluída" — como ao recarregar. */
                        let delta = 0;
                        if (alvo) {
                            const thread = alvo.parentElement && alvo.parentElement.classList.contains('ps-respostas')
                                ? alvo.parentElement : null;
                            const ehRespostaPendurada = thread && !thread.classList.contains('ps-respostas--orfa');
                            delta = ehRespostaPendurada ? 0 : -1;

                            const minhas = !thread ? list.querySelector('.ps-respostas[data-resposta-de="' + msgId + '"]') : null;
                            if (minhas) {
                                minhas.classList.add('ps-respostas--orfa');
                                minhas.removeAttribute('data-resposta-de');
                                minhas.querySelectorAll(':scope > .ps-anotacao--resposta > .ps-anotacao-resposta-rot > span').forEach(function (rot) {
                                    rot.textContent = ROTULO_ORFA;
                                });
                                /* Sem a raiz, responder a uma órfã liga a ela mesma (o servidor faz igual). */
                                minhas.querySelectorAll(':scope > .ps-anotacao').forEach(function (orfa) {
                                    const btn = orfa.querySelector('.btn-responder-msg-pasta');
                                    if (!btn) { return; }
                                    btn.dataset.respostaA    = orfa.id.replace('pasta-msg-', '');
                                    btn.dataset.respostaNome = (orfa.querySelector('.ps-anotacao-autor') || {}).textContent || '';
                                });
                                delta += minhas.querySelectorAll(':scope > .ps-anotacao').length;
                            }
                            if (caixaResp && caixaResp.raizId === String(msgId)) { fecharCaixaResposta(); }

                            /* A pílula do dia existe para o PRIMEIRO registro do dia: se ele era o
                               único, a pílula sai junto; sem registro nenhum, a lista volta ao
                               estado vazio (sem linha do tempo). */
                            const pilula  = alvo.previousElementSibling;
                            const seguinte = alvo.nextElementSibling;
                            alvo.remove();
                            if (thread && !thread.querySelector('.ps-anotacao')) { thread.remove(); }
                            if (!thread && pilula && pilula.classList.contains('ps-dia') && (!seguinte || seguinte.classList.contains('ps-dia'))) {
                                pilula.remove();
                            }
                            const lista = document.getElementById('timelineList');
                            if (lista && !lista.querySelector('.ps-anotacao')) { lista.classList.add('ps-registro--vazio'); }
                        }
                        if (countBadge && delta !== 0) {
                            countBadge.textContent = Math.max(0, parseInt(countBadge.textContent || '0', 10) + delta);
                        }
                    } else {
                        const data = await resp.json();
                        avisarErroReg(data.erro ?? 'Erro ao excluir.');
                    }
                } catch (_) {
                    avisarErroReg('Erro de rede.');
                }
            }
        });
    }

    function marcarEditado(item) {
        if (item.querySelector('.pasta-msg-editado')) { return; }
        /* Logo depois do autor, como no desenho — e como o Twig monta ao abrir a tela. */
        const autor = item.querySelector('.ps-anotacao-autor');
        const topo  = item.querySelector('.ps-anotacao-topo');
        if (!topo) { return; }
        const marca = document.createElement('span');
        marca.className = 'ps-anotacao-editado pasta-msg-editado';
        marca.textContent = 'editado';
        /* PAS-033: a mesma dica do Twig — a hora de publicação sai do title da hora do cartão
           ("dd/mm/aaaa HH:MM"); a edição é agora. */
        const publicado = ((item.querySelector('.ps-anotacao-data') || {}).title || '').slice(-5);
        const agora = new Date();
        marca.title = (publicado ? 'Publicado às ' + publicado + ' · ' : '') + 'última edição '
            + agora.toLocaleDateString('pt-BR') + ' às ' + agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        if (autor && autor.nextSibling) { topo.insertBefore(marca, autor.nextSibling); } else { topo.appendChild(marca); }
    }

    if (!form) { return; }

    textarea.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            form.requestSubmit();
        }
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const conteudo = textarea.value.trim();
        if (conteudo === '') {
            mostrarErro('A mensagem não pode ser vazia.');
            return;
        }

        btnEnviar.disabled = true;
        btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Enviando…';
        if (window.EditorRico) { EditorRico.marcarEnvio(textarea, true); }
        esconderErro();

        try {
            const fdEnvio = new FormData(form);
            // @menção: cada "@Nome" escolhido na lista vai como token `@[Nome](user:ID)`.
            if (window.PastaMencoes) { fdEnvio.set('conteudo', PastaMencoes.paraEnvio(textarea, conteudo)); }
            const resp = await fetch(urlEnviar, {
                method: 'POST',
                body: fdEnvio,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });

            const data = await resp.json();

            if (!resp.ok) {
                mostrarErro(data.erro ?? 'Erro ao enviar mensagem.');
                return;
            }

            const contaComoRegistro = inserirMensagem(data);
            // Limpa o editor (fonte da textarea); sem isso o texto enviado ficaria na tela.
            if (window.EditorRico) { EditorRico.limpar(textarea); } else { textarea.value = ''; }
            if (window.PastaMencoes) { PastaMencoes.esquecer(textarea); }
            if (vazioMsg) { vazioMsg.remove(); }
            // Resposta pendurada numa raiz não conta (desenho: a contagem é dos registros principais).
            if (countBadge && contaComoRegistro) {
                countBadge.textContent = parseInt(countBadge.textContent || '0', 10) + 1;
            }
        } catch (_) {
            mostrarErro('Erro de rede. Tente novamente.');
        } finally {
            // O rótulo volta ao do desenho e ao de antes do envio: só o texto "Enviar" (EDT-022).
            btnEnviar.textContent = 'Enviar';
            // O editor decide: depois de enviar ele está vazio, e vazio o Enviar fica apagado (EDT-021).
            if (window.EditorRico) { EditorRico.marcarEnvio(textarea, false); } else { btnEnviar.disabled = false; }
        }
    });

    function inserirMensagem(data) {
        const dt       = new Date(data.criadaEmTs);
        const dataHora = dt.toLocaleDateString('pt-BR')
            + ' ' + dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const hora     = dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        // `conteudoHtml` vem SANITIZADO do servidor: entra como HTML (e o que mostra a formatacao).
        const corpo = '<span class="editor-rico-conteudo"><span class="ql-editor">'
            + (data.conteudoHtml ?? '') + '</span></span>';

        const urlEditar  = urlEditarTpl.replace('__ID__', data.id);
        const urlExcluir = urlExcluirTpl.replace('__ID__', data.id);

        /* Resposta (`data.respostaA` = id da RAIZ, já normalizado pelo servidor): vai para o
           FIM da conversa recuada sob a raiz, sem pílula de dia e sem contar como registro.
           Se a raiz não está na tela como raiz (ex.: excluída numa outra aba), entra no topo
           como um registro, com a faixa — como ficaria ao recarregar. */
        const ehResposta = data.respostaA !== null && data.respostaA !== undefined;
        const raizEl     = ehResposta ? document.getElementById('pasta-msg-' + data.respostaA) : null;
        const pendurada  = !!(raizEl && raizEl.parentElement === list);

        /* A pílula do dia (desenho: "5 out 2026") só entra se a primeira do topo
           não for a de hoje — o registro novo é sempre o mais recente. A chave do
           dia é a do servidor (`data-hoje`), a mesma que o Twig usa. */
        const MESES   = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
        const hoje    = list.dataset.hoje || '';
        const topoDia = list.querySelector('.ps-dia');
        const pilula  = (!pendurada && (!topoDia || topoDia.dataset.dia !== hoje))
            ? `<div class="ps-dia" data-dia="${esc(hoje)}"><span class="ps-dia-pilula">${dt.getDate()} ${MESES[dt.getMonth()]} ${dt.getFullYear()}</span></div>`
            : '';

        /* Resposta de outro dia que não o da raiz: a hora leva o dia junto (mesma regra do Twig). */
        let horaRotulo = hora;
        if (pendurada) {
            const dataRaiz = ((raizEl.querySelector('.ps-anotacao-data') || {}).title || '').slice(0, 10);
            const diaMes   = String(dt.getDate()).padStart(2, '0') + '/' + String(dt.getMonth() + 1).padStart(2, '0');
            if (dataRaiz && dataRaiz !== diaMes + '/' + dt.getFullYear()) { horaRotulo = diaMes + ' · ' + hora; }
        }

        const faixa = ehResposta
            ? `<div class="ps-anotacao-resposta-rot"><i class="bi bi-reply-fill" aria-hidden="true"></i><span>${esc(data.respostaANome ? 'Resposta a ' + data.respostaANome : ROTULO_ORFA)}</span></div>`
            : '';
        const alvoId   = ehResposta ? data.respostaA : data.id;
        const alvoNome = ehResposta ? (data.respostaANome ?? '') : (data.autorNome ?? '');

        /* Tem de sair a MESMA estrutura que o _dados_anotacoes.html.twig gera no
           servidor: se divergirem, o registro recém-enviado aparece com outra
           cara — defeito que só se vê depois de enviar, nunca ao abrir a tela. */
        const cartao = `
        <article class="ps-anotacao${ehResposta ? ' ps-anotacao--resposta' : ''}" id="pasta-msg-${data.id}"
                 data-janela-ate="${Number(data.criadaEmEpoch) + {{ comentario_janela_minutos() }} * 60}"
                 data-do-autor="1" data-autor-id="{{ app.user ? app.user.id : '' }}">
            ${faixa}
            <span class="ps-anotacao-ponto" aria-hidden="true"></span>
            <span class="ps-anotacao-seta" aria-hidden="true"></span>
            <div class="ps-anotacao-topo">
                <span class="ps-avatar ps-avatar--24">${data.autorFotoUrl ? `<img src="${esc(data.autorFotoUrl)}" alt="">` : esc(iniciaisDe(data.autorNome))}</span>
                <span class="ps-anotacao-autor">${esc(data.autorNome ?? 'Autor desconhecido')}</span>
                <span class="ps-cab-espaco"></span>
                <span class="ps-anotacao-acoes">
                    <button type="button" class="ps-anotacao-acao btn-editar-msg-pasta"
                            title="Editável por mais {{ comentario_janela_minutos() }} minutos" aria-label="Editar registro"
                            data-msg-id="${data.id}"
                            data-conteudo="${esc(data.conteudo)}"
                            data-csrf="${esc(data.csrfEditar ?? '')}"
                            data-url="${esc(urlEditar)}">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" hidden class="ps-anotacao-acao ps-anotacao-acao--perigo btn-excluir-msg-pasta"
                            title="Excluir registro" aria-label="Excluir registro"
                            data-msg-id="${data.id}"
                            data-csrf="${esc(data.csrfExcluir ?? '')}"
                            data-url="${esc(urlExcluir)}">
                        <i class="bi bi-trash3"></i>
                    </button>
                </span>
                <button type="button" class="ps-anotacao-acao ps-anotacao-acao--responder btn-responder-msg-pasta"
                        title="Responder" aria-label="Responder"
                        data-resposta-a="${esc(alvoId)}"
                        data-resposta-nome="${esc(alvoNome || 'Autor desconhecido')}"${ehResposta ? ` data-resposta-autor-id="{{ app.user ? app.user.id : '' }}" data-resposta-autor-nome="${esc(data.autorNome ?? '')}"` : ''}>
                    <i class="bi bi-reply-fill"></i>
                </button>
                <span class="ps-anotacao-data ps-num" title="${dataHora}">${horaRotulo}</span>
                <button type="button" class="ps-reg-menu-btn js-reg-menu" title="Mais ações do registro"
                        aria-label="Mais ações do registro" aria-haspopup="menu" aria-expanded="false"
                        aria-controls="psRegMenu">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
            </div>
            <div class="ps-anotacao-corpo">
                <i class="bi bi-megaphone-fill ps-anotacao-icone" aria-hidden="true"></i>
                <div class="ps-anotacao-texto pasta-msg-conteudo">${corpo}</div>
            </div>
        </article>`;

        // O primeiro registro tira a lista do estado vazio: a linha do tempo aparece.
        list.classList.remove('ps-registro--vazio');

        if (pendurada) {
            /* A conversa da raiz é o irmão logo depois dela; a primeira resposta a cria.
               Ela herda o "escondido entre os anteriores" da raiz. */
            let conversa = raizEl.nextElementSibling;
            if (!conversa || !conversa.classList.contains('ps-respostas') || conversa.dataset.respostaDe !== String(data.respostaA)) {
                conversa = document.createElement('div');
                conversa.className = 'ps-respostas' + (raizEl.classList.contains('ps-anotacao--extra') ? ' ps-anotacao--extra' : '')
                    + (raizEl.classList.contains('d-none') ? ' d-none' : '');
                conversa.dataset.respostaDe = String(data.respostaA);
                raizEl.after(conversa);
            }
            conversa.insertAdjacentHTML('beforeend', cartao);
            const novo = document.getElementById('pasta-msg-' + data.id);
            if (novo) { novo.scrollIntoView({ block: 'nearest' }); }

            return false;
        }

        list.insertAdjacentHTML('afterbegin', pilula + cartao);
        list.scrollTop = 0;

        return true;
    }

    /* Iniciais do avatar: mesma regra do Twig (primeira letra do primeiro e do
       último nome). */
    function iniciaisDe(nome) {
        const partes = String(nome || '').trim().split(/\s+/).filter(Boolean);
        if (partes.length === 0) { return '?'; }
        const primeira = partes[0][0];
        const ultima   = partes.length > 1 ? partes[partes.length - 1][0] : '';
        return (primeira + ultima).toUpperCase();
    }

    function mostrarErro(msg) {
        erroDiv.textContent = msg;
        erroDiv.classList.remove('d-none');
    }

    function esconderErro() {
        erroDiv.classList.add('d-none');
    }

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
}());
</script>

<style>
.processo-modal-tabs {
    border-bottom: 3px solid #1a6fa3;
    background: var(--bs-body-bg);
    margin-bottom: 0;
}
.processo-modal-tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    padding: 8px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--bs-secondary-color);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    outline: none;
}
.processo-modal-tab:hover { color: #1a6fa3; }
.processo-modal-tab.active { color: #1a6fa3; border-bottom-color: #1a6fa3; }
.processo-modal-tab-content { display: none; }
.processo-modal-tab-content.active { display: block; }
/* Autocomplete de processo em tema escuro: o select2 usa fundo branco, mas os textos
   herdavam a cor clara do tema (sumindo sobre o branco). Fixa esquema claro + textos escuros,
   preservando o contraste da opção destacada (branco sobre azul). */
.mp-proc-dropdown { color-scheme: light; }
.mp-proc-dropdown .select2-search__field {
    background-color: #fff;
    color: #212529;
}
.mp-proc-dropdown .select2-results__option { color: #212529; }
.mp-proc-dropdown .select2-results__option--highlighted { color: #fff; }
/* Caixa de seleção do autocomplete (fica dentro de #modal-modo-existente): texto/placeholder
   escuros sobre o fundo branco do select2. */
#modal-modo-existente .select2-selection__rendered { color: #212529; }
#modal-modo-existente .select2-selection__placeholder { color: #6c757d; }
</style>

<script>
(function () {
    var pastaId                 = '{{ pasta.id }}';
    var csrfDesvincularProcesso = '{{ csrf_token('pasta_desvincular_processo_' ~ pasta.id) }}';

    /* ── Abas do modal de processo ── */
    document.querySelectorAll('.processo-modal-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.processo-modal-tab').forEach(function (t) { t.classList.remove('active'); });
            document.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.remove('active'); });
            tab.classList.add('active');
            var painel = document.getElementById('tab-' + tab.dataset.modalTab);
            if (painel) painel.classList.add('active');
        });
    });

    /* ── Modo (buscar existente x cadastrar novo) e Select2 no modal ── */
    var modalEl = document.getElementById('modalVincularProcesso');

    function mpAplicarModo(modo) {
        var blocoExistente = document.getElementById('modal-modo-existente');
        var blocoNovo      = document.getElementById('modal-modo-novo');
        var selExistente   = document.getElementById('mp-processoExistente');
        var ehNovo         = (modo === 'novo');

        blocoExistente.classList.toggle('d-none', ehNovo);
        blocoNovo.classList.toggle('d-none', !ehNovo);

        // Campos required do CNJ não podem bloquear o submit quando ocultos (o
        // navegador não consegue focar um required escondido). Suspende o required
        // no modo "existente" e o restaura no modo "novo".
        blocoNovo.querySelectorAll('input, select, textarea').forEach(function (el) {
            if (ehNovo) {
                if (el.dataset.reqSuspenso) {
                    el.required = true;
                    delete el.dataset.reqSuspenso;
                }
            } else if (el.required) {
                el.required = false;
                el.dataset.reqSuspenso = '1';
            }
        });

        if (selExistente) selExistente.disabled = ehNovo; // não submete processo_id no modo novo
    }

    document.getElementById('mp-modo-existente').addEventListener('change', function () { mpAplicarModo('existente'); });
    document.getElementById('mp-modo-novo').addEventListener('change', function () { mpAplicarModo('novo'); });
    mpAplicarModo('existente');

    modalEl.addEventListener('shown.bs.modal', function () {
        if (window.$ && $.fn.select2) {
            // Tribunal é campo somente-leitura, derivado do número do processo (padrão CNJ).
            if (!$('#mp-processoExistente').hasClass('select2-hidden-accessible')) {
                $('#mp-processoExistente').select2({
                    width: '100%',
                    placeholder: 'Digite número, classe, assunto ou tribunal…',
                    allowClear: true,
                    dropdownParent: $('#modalVincularProcesso'),
                    dropdownCssClass: 'mp-proc-dropdown',
                    minimumInputLength: 2,
                    ajax: {
                        url: '{{ path('pasta_buscar_processos', {id: pasta.id}) }}',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term }; },
                        processResults: function (data) { return { results: data.results || [] }; }
                    },
                    language: {
                        noResults: function () { return 'Nenhum processo encontrado'; },
                        searching: function () { return 'Buscando…'; },
                        inputTooShort: function () { return 'Digite ao menos 2 caracteres'; }
                    }
                });
            }
        }
        mpAplicarModo(document.getElementById('mp-modo-novo').checked ? 'novo' : 'existente');
    });

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    /* ── Submit via AJAX ── */
    document.getElementById('formVincularProcesso').addEventListener('submit', async function (e) {
        e.preventDefault();
        var feedbackEl = document.getElementById('mp-feedbackAlerta');
        var btnSalvar  = this.querySelector('button[type="submit"]');
        var icone      = btnSalvar.querySelector('i');
        var modoNovo   = document.getElementById('mp-modo-novo').checked;

        feedbackEl.className = 'd-none mt-3';
        feedbackEl.innerHTML = '';

        if (!modoNovo) {
            var selExistente = document.getElementById('mp-processoExistente');
            if (!selExistente.value) {
                feedbackEl.className = 'alert alert-warning mt-3';
                feedbackEl.textContent = 'Selecione um processo para vincular.';
                return;
            }
        }

        btnSalvar.disabled = true;
        if (icone) icone.className = 'bi bi-hourglass-split me-1';

        try {
            var resp = await fetch(this.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(this),
            });
            var dados = await resp.json().catch(function () { return {}; });

            if (resp.ok && dados.sucesso) {
                window.mpSwapProcessos(dados.html);
                bootstrap.Modal.getInstance(modalEl)?.hide();
                return;
            }

            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = dados.erro ?? 'Erro ao vincular processo.';
        } catch (_) {
            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Erro de comunicação. Tente novamente.';
        } finally {
            btnSalvar.disabled = false;
            if (icone) icone.className = 'bi bi-check-lg me-1';
        }
    });

    /* ── Fechar modal limpa o formulário ── */
    modalEl.addEventListener('hidden.bs.modal', function () {
        document.getElementById('formVincularProcesso').reset();
        var partesContainer = document.getElementById('mp-partesContainer');
        partesContainer.innerHTML = mpParteRowHtml(0);
        var movContainer = document.getElementById('mp-movimentacoesContainer');
        movContainer.innerHTML = mpMovRowHtml(0);
        mpUpdateRemoveButtons();
        document.getElementById('mp-feedbackAlerta').className = 'd-none mt-3';
        document.getElementById('mp-feedbackAlerta').innerHTML = '';
        document.querySelectorAll('.processo-modal-tab').forEach(function (t) { t.classList.remove('active'); });
        document.querySelectorAll('.processo-modal-tab-content').forEach(function (c) { c.classList.remove('active'); });
        document.querySelector('.processo-modal-tab[data-modal-tab="modal-proc-info"]').classList.add('active');
        document.getElementById('tab-modal-proc-info').classList.add('active');
        document.getElementById('mp-siglaTribunal').value = '';
        document.getElementById('mp-modo-existente').checked = true;
        if (window.$ && $.fn.select2 && $('#mp-processoExistente').hasClass('select2-hidden-accessible')) {
            $('#mp-processoExistente').val(null).trigger('change');
        }
        mpAplicarModo('existente');
    });

    /* ── Templates de linha ── */
    function mpParteRowHtml(idx) {
        return `<div class="mp-parte-row card mb-2 p-3" style="position: relative;">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <select name="partes[${idx}][tipo]" class="form-select">
                        <option value="PARTE">Parte</option>
                        <option value="ADVOGADO">Advogado</option>
                        <option value="JUIZ">Juiz</option>
                        <option value="PROMOTOR">Promotor</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nome</label>
                    <input type="text" name="partes[${idx}][nome]" class="form-control" placeholder="Nome da parte">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Documento</label>
                    <input type="text" name="partes[${idx}][documento]" class="form-control" placeholder="CPF/CNPJ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Papel</label>
                    <input type="text" name="partes[${idx}][papel]" class="form-control" placeholder="Polo ativo/passivo">
                </div>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm mp-remove-parte"
                    style="display: none; position: absolute; top: 8px; right: 12px;"
                    title="Remover"><i class="bi bi-trash"></i></button>
        </div>`;
    }

    function mpMovRowHtml(idx) {
        return `<div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Data</label>
                    <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Descrição</label>
                    <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control" placeholder="Descrição da movimentação">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control" placeholder="Tipo de movimento">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Órgão</label>
                    <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control" placeholder="Órgão">
                </div>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                    style="display: none; position: absolute; top: 8px; right: 12px;"
                    title="Remover"><i class="bi bi-trash"></i></button>
        </div>`;
    }

    /* ── Adicionar / remover partes ── */
    document.getElementById('mp-btn-add-parte').addEventListener('click', function () {
        var container = document.getElementById('mp-partesContainer');
        var idx = container.querySelectorAll('.mp-parte-row').length;
        container.insertAdjacentHTML('beforeend', mpParteRowHtml(idx));
        mpAttachRemovePartes();
    });

    function mpAttachRemovePartes() {
        document.querySelectorAll('#mp-partesContainer .mp-remove-parte').forEach(function (btn) {
            btn.onclick = function () { btn.closest('.mp-parte-row').remove(); mpUpdateRemoveButtons(); };
        });
        mpUpdateRemoveButtons();
    }

    /* ── Adicionar / remover movimentações ── */
    document.getElementById('mp-btn-add-movimentacao').addEventListener('click', function () {
        var container = document.getElementById('mp-movimentacoesContainer');
        var idx = container.querySelectorAll('.mp-movimentacao-row').length;
        container.insertAdjacentHTML('beforeend', mpMovRowHtml(idx));
        mpAttachRemoveMovimentacoes();
    });

    function mpAttachRemoveMovimentacoes() {
        document.querySelectorAll('#mp-movimentacoesContainer .mp-remove-movimentacao').forEach(function (btn) {
            btn.onclick = function () { btn.closest('.mp-movimentacao-row').remove(); mpUpdateRemoveButtons(); };
        });
        mpUpdateRemoveButtons();
    }

    function mpUpdateRemoveButtons() {
        var partes = document.querySelectorAll('#mp-partesContainer .mp-parte-row').length;
        document.querySelectorAll('#mp-partesContainer .mp-remove-parte').forEach(function (btn) {
            btn.style.display = partes > 1 ? 'block' : 'none';
        });
        var movs = document.querySelectorAll('#mp-movimentacoesContainer .mp-movimentacao-row').length;
        document.querySelectorAll('#mp-movimentacoesContainer .mp-remove-movimentacao').forEach(function (btn) {
            btn.style.display = movs > 1 ? 'block' : 'none';
        });
    }

    /* O que vem do Datajud é texto de fora: escapado antes de entrar no HTML das linhas (P5d). */
    function mpEsc(valor) {
        return String(valor == null ? '' : valor).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    /* ── Busca DataJud ── */
    document.getElementById('mp-btn-datajud').addEventListener('click', async function () {
        var numeroProcesso = document.getElementById('mp-numeroProcesso').value;
        var feedbackEl     = document.getElementById('mp-feedbackAlerta');
        var loadingEl      = document.getElementById('mp-loadingOverlay');

        feedbackEl.className = 'd-none mt-3';
        feedbackEl.innerHTML = '';

        if (!numeroProcesso) {
            feedbackEl.className = 'alert alert-warning mt-3';
            feedbackEl.textContent = 'Informe o número do processo.';
            return;
        }

        loadingEl.classList.remove('d-none');
        try {
            // O tribunal é derivado do número no servidor — não enviamos mais a sigla.
            var response = await fetch('{{ path("api_datajud_search") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ numeroProcesso: numeroProcesso })
            });
            var data = await response.json();
            loadingEl.classList.add('d-none');

            if (!response.ok || !data.success) {
                feedbackEl.className = 'alert alert-danger mt-3';
                feedbackEl.textContent = data.error || 'Erro ao buscar processo no CNJ/DataJud.';
                return;
            }

            var pd = data.data;
            document.getElementById('mp-siglaTribunal').value     = pd.siglaTribunal     || '';
            document.getElementById('mp-orgaoJulgador').value     = pd.orgaoJulgador     || '';
            document.getElementById('mp-classeProcessual').value  = pd.classeProcessual  || '';
            document.getElementById('mp-assuntoProcessual').value = pd.assuntoProcessual || '';
            document.getElementById('mp-situacaoProcesso').value  = pd.situacaoProcesso  || 'EM_ANDAMENTO';
            document.getElementById('mp-instancia').value         = pd.instancia         || 'G1';
            document.getElementById('mp-dataDistribuicao').value  = pd.dataDistribuicao  || '';

            var partesContainer = document.getElementById('mp-partesContainer');
            partesContainer.innerHTML = '';
            var partesList = (pd.partes && pd.partes.length > 0) ? pd.partes : [{}];
            partesList.forEach(function (parte, idx) {
                partesContainer.insertAdjacentHTML('beforeend', `<div class="mp-parte-row card mb-2 p-3" style="position: relative;">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label">Tipo</label>
                            <select name="partes[${idx}][tipo]" class="form-select">
                                <option value="PARTE" ${(parte.tipo||'')==='PARTE'?'selected':''}>Parte</option>
                                <option value="ADVOGADO" ${(parte.tipo||'')==='ADVOGADO'?'selected':''}>Advogado</option>
                                <option value="JUIZ" ${(parte.tipo||'')==='JUIZ'?'selected':''}>Juiz</option>
                                <option value="PROMOTOR" ${(parte.tipo||'')==='PROMOTOR'?'selected':''}>Promotor</option>
                            </select></div>
                        <div class="col-md-5"><label class="form-label">Nome</label>
                            <input type="text" name="partes[${idx}][nome]" class="form-control" value="${mpEsc(parte.nome)}" placeholder="Nome da parte"></div>
                        <div class="col-md-2"><label class="form-label">Documento</label>
                            <input type="text" name="partes[${idx}][documento]" class="form-control" value="${mpEsc(parte.documento)}" placeholder="CPF/CNPJ"></div>
                        <div class="col-md-2"><label class="form-label">Papel</label>
                            <input type="text" name="partes[${idx}][papel]" class="form-control" value="${mpEsc(parte.papel)}" placeholder="Polo ativo/passivo"></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mp-remove-parte"
                            style="display: ${partesList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                            title="Remover"><i class="bi bi-trash"></i></button>
                </div>`);
            });

            var movContainer = document.getElementById('mp-movimentacoesContainer');
            movContainer.innerHTML = '';
            var movsList = (pd.movimentacoes && pd.movimentacoes.length > 0) ? pd.movimentacoes : [{}];
            movsList.forEach(function (mov, idx) {
                movContainer.insertAdjacentHTML('beforeend', `<div class="mp-movimentacao-row card mb-2 p-3" style="position: relative;">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label">Data</label>
                            <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control" value="${mpEsc(mov.dataMovimentacao)}"></div>
                        <div class="col-md-4"><label class="form-label">Descrição</label>
                            <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control" value="${mpEsc(mov.descricao)}" placeholder="Descrição da movimentação"></div>
                        <div class="col-md-3"><label class="form-label">Tipo</label>
                            <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control" value="${mpEsc(mov.tipo)}" placeholder="Tipo de movimento"></div>
                        <div class="col-md-2"><label class="form-label">Órgão</label>
                            <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control" value="${mpEsc(mov.orgao)}" placeholder="Órgão"></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mp-remove-movimentacao"
                            style="display: ${movsList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                            title="Remover"><i class="bi bi-trash"></i></button>
                </div>`);
            });

            mpAttachRemovePartes();
            mpAttachRemoveMovimentacoes();

            feedbackEl.className = 'alert alert-success mt-3';
            feedbackEl.textContent = 'Processo carregado com sucesso! Verifique os dados antes de salvar.';

        } catch (e) {
            loadingEl.classList.add('d-none');
            feedbackEl.className = 'alert alert-danger mt-3';
            feedbackEl.textContent = 'Erro ao buscar processo no CNJ/DataJud. Tente novamente em instantes.';
        }
    });

    mpAttachRemovePartes();
    mpAttachRemoveMovimentacoes();
}());
</script>

{# ── Modal: editar pasta ──
   Moldura do desenho 1.2.3 (dc 560-592; auditoria 2 C2): cabeçalho em gradiente com
   o círculo da pasta, título "Pasta nnnn" e o cliente como subtítulo; rótulos em
   caixa alta; rodapé Fechar · Salvar. SÓ a moldura: os campos e o POST para
   `pasta_edit` são os de sempre (ids, names, CSRF). O que o desenho põe e aqui
   não entra, por ser decisão do dono ou função nova (D-META): "Ação" só leitura,
   Tipo de documento/CPF. Responsável com "Trocar" (PAS-021), a pílula de estado,
   o Salvar travado e "Pendências" (PAS-020): abaixo.

   Abas de atalho e "Cadastro do cliente" (lote L2; dc L.570-572, 587, 4299-4301):
   são ATALHOS, não abas do form — ficam FORA do <form>, sem `name`, e nenhum campo
   sai nem se esconde. "Dados da pasta" é a ativa (sem ação); Cliente e "Cadastro do
   cliente" fecham o modal e abrem a janela "Detalhes do cliente" pelo botão
   Cadastro do cabeçalho (sem cliente cadastrado: levam à seção Clientes da aba
   Dados, onde se vincula um); Processo fecha e abre a aba Processo; Histórico
   fecha e abre o drawer do histórico. O desenho descarta o que foi digitado ao
   trocar de aba; aqui, se o form foi alterado, pergunta antes (confirm). #}
<style>
    /* PAS-021: a linha só leitura do desenho (dc L.581: 34px, fundo suave, "Trocar" 26px). */
    .ps-pe-resp {
        display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 6px 0 10px;
        border-radius: 4px; background: var(--ps-soft); box-shadow: inset 0 0 0 1px var(--ps-border);
    }
    .ps-pe-resp-nome { flex: 1; min-width: 0; font-size: 13.5px; color: var(--ps-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ps-pe-resp-trocar {
        height: 26px; padding: 0 9px; border: none; border-radius: 3px; white-space: nowrap; cursor: pointer;
        background: var(--ps-accent-bg); color: var(--ps-accent); font-size: 12px; font-weight: 700;
    }
    .ps-pe-resp-trocar:hover, .ps-pe-resp-trocar:focus-visible { background: var(--ps-hover); outline: none; }
    /* PAS-020: pílula de estado, Salvar travado e "Pendências" (dc L.567, 584, 588; `peVals`). */
    .ps-pe-estado {
        display: inline-flex; align-items: center; gap: 6px; height: 20px; padding: 0 9px;
        border-radius: 999px; font-size: 11px; font-weight: 700; background: var(--ps-ok-bg); color: var(--ps-ok-text);
    }
    .ps-pe-estado-ponto { width: 7px; height: 7px; border-radius: 50%; background: var(--ps-ok-dot); }
    .ps-pe-estado.is-alterado { background: var(--ps-warn-bg); color: var(--ps-warn-text); }
    .ps-pe-estado.is-alterado .ps-pe-estado-ponto { background: var(--ps-warn-dot); }
    .ps-pe-pendencias {
        display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border-radius: 4px;
        background: var(--ps-warn-bg); box-shadow: inset 0 0 0 1px var(--ps-warn-border);
    }
    .ps-pe-pendencias[hidden] { display: none; }
    .ps-pe-pendencias-rot { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ps-warn-text); }
    .ps-pe-pendencias-linha { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ps-warn-text); }
    .ps-pe-pendencias-linha i { font-size: 12px; color: var(--ps-danger-dot); }
    #modalEditarPasta .ps-modal-pasta-btn--salvar:disabled { opacity: 1; background: var(--ps-border-ctl); color: #fff; cursor: not-allowed; }
</style>
{% set editCliente = pasta.clientePrincipal %}
{% set editDocumento = editCliente ? (editCliente.cpf is defined ? editCliente.cpf : (editCliente.cnpj is defined ? editCliente.cnpj : null)) : null %}
{% set editNomeSub = editCliente ? editCliente.nomeExibicao : pasta.nomeCliente %}
<div class="modal fade" id="modalEditarPasta" tabindex="-1" aria-labelledby="modalEditarPastaLabel" aria-hidden="true">
    <div class="modal-dialog ps-modal-pasta">
        <div class="modal-content">
            <div class="ps-modal-pasta-cab">
                <span class="ps-modal-pasta-cab-icone" aria-hidden="true"><i class="bi bi-folder2-open"></i></span>
                <div class="ps-modal-pasta-cab-corpo">
                    <h2 class="ps-modal-pasta-titulo" id="modalEditarPastaLabel"><span class="visually-hidden">Editar dados da </span>Pasta {{ pasta.nup }}</h2>
                    {# PAS-020 (dc L.567, `pe.stTxt`): a pílula de estado fica na linha do subtítulo —
                       "Dados da pasta" (verde) ou "Alterações não salvas" (âmbar); o script abaixo
                       a alterna comparando o formulário com o que veio do servidor. #}
                    <div class="ps-modal-pasta-sub">
                        {% if editNomeSub or editDocumento %}
                            <span class="ps-modal-pasta-sub-tx">
                                {{- editNomeSub -}}
                                {%- if editNomeSub and editDocumento %} · {% endif -%}
                                {%- if editDocumento -%}{{ editDocumento|documento_br_rotulo }} {{ editDocumento|documento_br }}{%- endif -%}
                            </span>
                        {% endif %}
                        <span class="ps-pe-estado" data-pe-estado><span class="ps-pe-estado-ponto" aria-hidden="true"></span><span data-pe-estado-txt>Dados da pasta</span></span>
                    </div>
                </div>
                <button type="button" class="ps-modal-pasta-fechar" data-bs-dismiss="modal" title="Fechar" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
            </div>
            <nav class="ps-modal-pasta-abas" aria-label="Atalhos da pasta">
                <button type="button" class="ps-modal-pasta-aba is-ativa" aria-current="true"><i class="bi bi-folder2" aria-hidden="true"></i>Dados da pasta</button>
                <button type="button" class="ps-modal-pasta-aba js-pe-ir" data-pe-ir="cliente" title="Fechar e abrir o cadastro do cliente"><i class="bi bi-person" aria-hidden="true"></i>Cliente</button>
                <button type="button" class="ps-modal-pasta-aba js-pe-ir" data-pe-ir="processo" title="Fechar e ir à aba Processo"><i class="bi bi-bank" aria-hidden="true"></i>Processo</button>
                <button type="button" class="ps-modal-pasta-aba js-pe-ir" data-pe-ir="historico" title="Fechar e abrir o histórico"><i class="bi bi-clock-history" aria-hidden="true"></i>Histórico</button>
            </nav>
            <form method="post" action="{{ path('pasta_edit', {id: pasta.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_pasta_' ~ pasta.id) }}">
                <div class="ps-modal-pasta-corpo">

                    <div class="ps-modal-pasta-linha">
                        <div class="ps-modal-pasta-campo">
                            <label for="edit_nup" class="ps-modal-pasta-rotulo">Número da pasta<span class="ps-modal-pasta-obrig" aria-hidden="true"> *</span></label>
                            <input type="text" id="edit_nup" name="nup"
                                   class="form-control"
                                   value="{{ pasta.nup }}" required autocomplete="off">
                        </div>

                        {# O campo é renderizado SEMPRE, mesmo com cliente cadastrado. Ele já foi
                           escondido nesse caso, e o resultado era o pior possível: o navegador não
                           mandava a chave, o controller lia vazio e APAGAVA o nome ao salvar — sem
                           ninguém tocar no campo. São coisas diferentes e ambas precisam existir aqui:
                           o TÍTULO da pasta (texto livre, hoje no padrão `CREDOR - DEVEDOR`) e os
                           CLIENTES cadastrados, que viram contexto logo abaixo. #}
                        {% set identificadorDerivado = identificador_pasta(pasta) %}
                        {% set derivadoDaCobranca = identificadorDerivado is not null and identificadorDerivado != pasta.nomeCliente %}
                        <div class="ps-modal-pasta-campo ps-modal-pasta-campo--2">
                            <label {% if not derivadoDaCobranca %}for="edit_nome_cliente" {% endif %}class="ps-modal-pasta-rotulo">Nome do cliente</label>
                            {% if derivadoDaCobranca %}
                                {# Pasta judicializada pela cobrança: o identificador é MONTADO do credor da
                                   carteira + a pessoa cobrada, e por isso não se edita aqui. Campo que
                                   some sem explicação vira chamado de suporte — o texto abaixo diz onde
                                   mudar. O `nome_cliente` não é enviado, e o controller trata chave
                                   AUSENTE como "não mexe", então nada é apagado. #}
                                <p class="form-control bg-body-secondary mb-1" style="height:auto;">{{ identificadorDerivado }}</p>
                                <div class="form-text text-muted">
                                    Montado a partir do credor da carteira e do responsável cobrado.
                                    Para mudar, altere o <strong>cadastro do cliente</strong> ou o responsável do caso.
                                </div>
                            {% else %}
                            <input type="text" id="edit_nome_cliente" name="nome_cliente"
                                   class="form-control"
                                   value="{{ pasta.nomeCliente }}" autocomplete="off">
                            {% endif %}
                            {% if pasta.clientes|length > 0 %}
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    {% for cliente in pasta.clientes %}
                                        <span class="badge text-bg-secondary fw-normal">
                                            <i class="bi bi-person me-1"></i>{{ cliente.cpf is defined and cliente.cpf ? cliente.nomeCompleto : cliente.razaoSocial }}
                                        </span>
                                    {% endfor %}
                                </div>
                                <div class="form-text text-muted">Clientes cadastrados da pasta. Para alterá-los, use a seção de Clientes na aba Dados.</div>
                            {% endif %}
                        </div>
                    </div>

                    {# "Ação" continua EDITÁVEL: o desenho a põe só leitura ("vem do menu
                       Processo"), mas isso é decisão do dono (D-META). #}
                    <div class="ps-modal-pasta-linha ps-modal-pasta-linha--larga">
                        {# PAS-021 (dc L.581, `pe.trocarResp`): Responsável só leitura com "Trocar", que
                           fecha a janela e abre o menu de responsável do cabeçalho (o mesmo do ⋮
                           "Trocar responsável", com o endpoint e o CSRF de sempre). Sem `name`, nada
                           daqui vai no POST do formulário. O nome é relido do chip do cabeçalho ao
                           abrir, porque a troca pode ter acontecido depois da carga. #}
                        <div class="ps-modal-pasta-campo">
                            <span class="ps-modal-pasta-rotulo" id="editRespRotulo">Responsável</span>
                            <div class="ps-pe-resp" role="group" aria-labelledby="editRespRotulo">
                                <span class="ps-pe-resp-nome" data-pe-resp-nome>{{ pasta.responsavel ? pasta.responsavel.fullName : 'Sem responsável' }}</span>
                                {% if podeEditarPasta and not pasta.estaExcluida %}
                                    <button type="button" class="ps-pe-resp-trocar js-pe-ir" data-pe-ir="responsavel">Trocar</button>
                                {% endif %}
                            </div>
                        </div>

                        <div class="ps-modal-pasta-campo">
                            <label for="edit_nome_acao" class="ps-modal-pasta-rotulo">Ação</label>
                            <input type="text" id="edit_nome_acao" name="nome_acao"
                                   class="form-control"
                                   value="{{ pasta.nomeAcao }}" autocomplete="off">
                        </div>

                        <div class="ps-modal-pasta-campo">
                            <label for="edit_situacao" class="ps-modal-pasta-rotulo">Situação</label>
                            <select id="edit_situacao" name="situacao" class="form-select">
                                {% for valor, rotuloSituacao in constant('App\\Pasta\\Entity\\Pasta::ROTULOS_SITUACAO') %}
                                    <option value="{{ valor }}" {{ pasta.situacao == valor ? 'selected' : '' }}>{{ rotuloSituacao }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    {# PAS-020 (dc L.584, `pe.temErro`): o que impede salvar, no bloco "Pendências".
                       Aqui só o que a tela sabe sozinha (número vazio); número repetido e o resto
                       continuam com o servidor, que responde no flash de sempre. #}
                    <div class="ps-pe-pendencias" role="alert" data-pe-pendencias hidden>
                        <span class="ps-pe-pendencias-rot">Pendências</span>
                        <span class="ps-pe-pendencias-linha"><i class="bi bi-x-circle-fill" aria-hidden="true"></i><span data-pe-pendencias-txt></span></span>
                    </div>

                </div>
                <div class="ps-modal-pasta-rodape">
                    <button type="button" class="ps-modal-pasta-btn ps-modal-pasta-btn--fechar" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="ps-modal-pasta-btn ps-modal-pasta-btn--cadastro js-pe-ir" data-pe-ir="cliente"><i class="bi bi-person-vcard" aria-hidden="true"></i>Cadastro do cliente</button>
                    <button type="submit" class="ps-modal-pasta-btn ps-modal-pasta-btn--salvar">
                        <i class="bi bi-check2"></i>Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
/* Atalhos do "Editar dados" (lote L2): fecham o modal e SÓ DEPOIS de fechado abrem o
   destino — abrir a janela ou o drawer com o modal ainda na tela deixaria o foco
   preso no modal (focus trap do Bootstrap) e o fundo escuro por cima. Os destinos
   são os gatilhos que a tela já tem: o botão Cadastro do cabeçalho (#psCadastroAbrir,
   pasta-clientes.js), a aba #processo-tab e o #psHistoricoAbrir (pasta-show.js).

   E7: roda no DOMContentLoaded. Este script fica no corpo da página e o Bootstrap só carrega no
   fim do base.html.twig: rodando na hora, o `typeof bootstrap === 'undefined'` saía cedo e o
   bloco inteiro ficava morto — sem pergunta ao trocar o número (o POST saía direto), sem o
   estado do Salvar e sem o "Descartar as alterações?". Medido no navegador (master e frente). */
document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('modalEditarPasta');
    if (!modal || typeof bootstrap === 'undefined') { return; }
    var form = modal.querySelector('form');

    function serializar() {
        return form ? new URLSearchParams(new FormData(form)).toString() : '';
    }
    // O retrato é o que veio do SERVIDOR (tirado ao carregar): fechar e reabrir com algo
    // digitado continua "Alterações não salvas".
    var foto = serializar();

    /* PAS-020 (`peVals`: `mud`, `erro`, `naoSalvar`): a pílula diz se há alteração; o Salvar
       só acende com alteração e sem pendência; a pendência aparece no bloco. */
    var estado = modal.querySelector('[data-pe-estado]');
    var estadoTxt = modal.querySelector('[data-pe-estado-txt]');
    var pendencias = modal.querySelector('[data-pe-pendencias]');
    var pendenciasTxt = modal.querySelector('[data-pe-pendencias-txt]');
    var salvar = form ? form.querySelector('button[type="submit"]') : null;
    var nup = document.getElementById('edit_nup');

    function conferir() {
        var mudou = serializar() !== foto;
        var erro = nup && nup.value.trim() === '' ? 'Informe o número da pasta.' : '';
        if (estado) {
            estado.classList.toggle('is-alterado', mudou);
            estadoTxt.textContent = mudou ? 'Alterações não salvas' : 'Dados da pasta';
        }
        if (pendencias) {
            pendencias.hidden = !(mudou && erro);
            pendenciasTxt.textContent = mudou ? erro : '';
        }
        if (salvar) {
            salvar.disabled = !(mudou && !erro);
            salvar.title = !mudou ? 'Nenhuma alteração para salvar' : (erro || '');
        }
    }
    if (form) {
        form.addEventListener('input', conferir);
        form.addEventListener('change', conferir);
    }
    modal.addEventListener('show.bs.modal', conferir);
    conferir();

    /* PAS-019 (dc L.4287/4416): trocar o NÚMERO pede confirmação antes de gravar, com o texto do
       desenho — o número antigo é o que veio do servidor (`defaultValue`). E7: na janela AZUL da tela
       (dc `confirmarUI(…, false)`, título "Alterar número da pasta"), registrada no pasta-dialogos.js
       (já carregado no DOMContentLoaded). Sem a janela, o `confirm` de sempre. */
    if (form && nup) {
        var perguntaDoNumero = function () {
            var antes = nup.defaultValue.trim();
            var depois = nup.value.trim();
            if (depois === '' || depois === antes) { return null; }

            return {
                mensagem: 'Alterar número da pasta\nAlterar o número da pasta de ' + antes + ' para ' + depois + '? Links e referências antigas passam a apontar para o novo número.',
                perigo: false
            };
        };
        if (window.psConfirmarEnvio) {
            window.psConfirmarEnvio(form, perguntaDoNumero);
        } else {
            form.addEventListener('submit', function (e) {
                var p = perguntaDoNumero();
                if (p && !window.confirm(p.mensagem.replace('\n', '\n\n'))) { e.preventDefault(); }
            });
        }
    }

    function irParaClientes() {
        var aba = document.getElementById('dados-tab');
        if (aba) { aba.click(); }
        var secao = document.querySelector('[data-trilho="clientes"]');
        if (secao) { secao.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }

    var destinos = {
        cliente: function () {
            var cadastro = document.getElementById('psCadastroAbrir');
            if (cadastro) { cadastro.click(); } else { irParaClientes(); }
        },
        processo: function () {
            var aba = document.getElementById('processo-tab');
            if (aba) { aba.click(); aba.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
        },
        historico: function () {
            var abrir = document.getElementById('psHistoricoAbrir');
            if (abrir && abrir.getAttribute('aria-expanded') !== 'true') { abrir.click(); }
        },
        // PAS-021: o "Trocar responsável" do ⋮ (pasta-show.js), que abre o menu do chip.
        responsavel: function () {
            var trocar = document.getElementById('psMenuTrocarResponsavel');
            if (trocar) { trocar.click(); }
        }
    };

    modal.addEventListener('show.bs.modal', function () {
        var nome = modal.querySelector('[data-pe-resp-nome]');
        var doChip = document.querySelector('.ps-cab-resp .pasta-resp-chip .pasta-resp-nome');
        if (nome && doChip) { nome.textContent = doChip.textContent.trim(); }
    });

    modal.addEventListener('click', function (e) {
        var gatilho = e.target.closest('.js-pe-ir');
        if (!gatilho) { return; }
        var destino = destinos[gatilho.getAttribute('data-pe-ir')];
        if (!destino) { return; }

        function seguir() {
            modal.addEventListener('hidden.bs.modal', function aoFechar() {
                modal.removeEventListener('hidden.bs.modal', aoFechar);
                destino();
            });
            bootstrap.Modal.getOrCreateInstance(modal).hide();
        }

        if (serializar() === foto) { seguir(); return; }

        /* PAS-034b: com alteração não salva, pergunta na janela da tela (`confirmarPs`,
           pasta-dialogos.js), não no `confirm` do navegador. Sem o "sim", o modal fica como
           está, com as alterações. */
        if (!window.confirmarPs) { return; }
        window.confirmarPs({
            titulo: 'Descartar as alterações?',
            texto: 'As alterações não salvas dos dados da pasta serão perdidas.',
            rotulo: 'Descartar',
            icone: 'bi-x-circle'
        }).then(function (sim) {
            if (!sim) { return; }
            form.reset();
            conferir();
            seguir();
        });
    });
});
</script>

<script>
(function () {
    var btn = document.getElementById('btn-alternar-status');
    if (!btn) return;

    // A situação é a pílula à direita das abas (desenho 1.2.3): ela abre o menu das 4
    // situações, e escolher outra manda a escolhida. O item "Arquivar/Desarquivar pasta" do
    // menu ⋮ manda a situação que oferece (Arquivado, ou Ativo se a pasta está arquivada). Deu certo, a tela recarrega: o Registro ganha o cartão "Situação da pasta",
    // o carimbo é o da nova situação e, ao arquivar, o andamento chega a Finalizada.
    var emAndamento = false;

    document.querySelectorAll('.js-situacao-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
            if (emAndamento || opt.dataset.situacao === btn.dataset.situacaoAtual) { return; }
            emAndamento  = true;
            btn.disabled = true;

            var corpo = '_token=' + encodeURIComponent(btn.dataset.csrf) + '&situacao=' + encodeURIComponent(opt.dataset.situacao);
            fetch(btn.dataset.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: corpo,
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.sucesso) {
                    alert(data.erro || 'Erro ao alterar situação.');
                    emAndamento  = false;
                    btn.disabled = false;
                    return;
                }
                window.location.reload();
            })
            .catch(function () {
                alert('Erro de comunicação com o servidor.');
                emAndamento  = false;
                btn.disabled = false;
            });
        });
    });

    /* ── Selo de prioridade (popover do cabeçalho novo) ──
       A classe do selo sai do PRÓPRIO valor escolhido, não do `badgeClass` que
       o endpoint devolve: aquele é `text-bg-*` do Bootstrap e não descreve a
       pílula do desenho (Normal cinza · Prioridade âmbar · Urgente vermelho). */
    document.querySelectorAll('.prioridade-opt').forEach(function (optBtn) {
        optBtn.addEventListener('click', async function () {
            var pop = optBtn.closest('.ps-pop-wrap');
            var tog = pop.querySelector('.pasta-prioridade-btn');
            var fd  = new FormData();
            fd.append('prioridade', optBtn.dataset.valor);
            fd.append('_token', tog.dataset.csrf);

            try {
                var res = await fetch(tog.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                if (!res.ok) { alert('Erro ao alterar prioridade.'); return; }

                var json = await res.json();
                tog.className = 'ps-prio ps-prio--' + optBtn.dataset.valor + ' pasta-prioridade-btn';
                tog.querySelector('.ps-prio-label').textContent = json.label;

                /* O ✓ acompanha a escolha; sem isso o popover continuaria
                   apontando a prioridade antiga na próxima abertura. */
                pop.querySelectorAll('.prioridade-opt .ps-pop-check').forEach(function (check) {
                    check.classList.add('d-none');
                });
                optBtn.querySelector('.ps-pop-check').classList.remove('d-none');

                /* Trocar fecha o popover — comportamento do desenho. */
                var painel = pop.querySelector('.ps-pop--prio');
                if (painel) { painel.classList.remove('is-aberto'); }
                tog.setAttribute('aria-expanded', 'false');
            } catch (e) {
                alert('Erro ao alterar prioridade.');
            }
        });
    });
}());
</script>

