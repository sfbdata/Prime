{# ── Upload por arquivo com barra de progresso (compartilhado: drag-drop + seção) ── #}
<script>
    const URL_UPLOAD_PECA  = {{ path('pasta_peticionar_upload', {id: pasta.id})|json_encode|raw }};
    const CSRF_UPLOAD_PECA = {{ csrf_token('peticionar_upload_' ~ pasta.id)|json_encode|raw }};
    const PASTA_ID_UPLOAD  = {{ pasta.id|json_encode|raw }};

    function formatBytesPeca(b) {
        if (!b || b <= 0) return '0 B';
        if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
        return (b / 1024 / 1024).toFixed(2) + ' MB';
    }

    /* ── Aviso de arquivo duplicado (duplicadoDe[] no JSON do upload) ──
       Informativo, nunca bloqueia. O gerenciador recarrega a página ao terminar o lote, então
       o aviso é guardado em sessionStorage e renderizado de novo depois do reload (e apagado
       ao fechar ou ao ser mostrado uma segunda vez). */
    const CHAVE_DUPLICADOS = 'uploadDuplicados_' + PASTA_ID_UPLOAD;

    function lerDuplicadosPendentes() {
        try { return JSON.parse(sessionStorage.getItem(CHAVE_DUPLICADOS) || '[]') || []; } catch (_) { return []; }
    }

    function textoDoDuplicado(nomeEnviado, d, pastaAtualId) {
        const onde = String(d.pastaId) === String(pastaAtualId) ? 'nesta pasta' : 'na pasta ' + d.pastaNup;
        return '«' + nomeEnviado + '» tem o mesmo conteúdo de «' + d.titulo + '» ' + onde + '.';
    }

    function renderizarAvisoDeDuplicados() {
        const caixa = document.getElementById('uploadDuplicadosAviso');
        const lista = document.getElementById('uploadDuplicadosLista');
        if (!caixa || !lista) return;

        const itens = lerDuplicadosPendentes();
        if (itens.length === 0) { caixa.classList.add('d-none'); return; }

        const pastaAtual = PASTA_ID_UPLOAD;
        const urlTpl     = caixa.dataset.urlPastaTpl || '';
        lista.textContent = '';
        itens.forEach(function (it) {
            const li = document.createElement('li');
            li.textContent = textoDoDuplicado(it.nome, it, pastaAtual);
            if (String(it.pastaId) !== String(pastaAtual) && urlTpl) {
                const a = document.createElement('a');
                a.href = urlTpl.replace('__ID__', encodeURIComponent(it.pastaId));
                a.className = 'ms-1';
                a.textContent = 'Abrir pasta ' + it.pastaNup;
                li.appendChild(a);
            }
            lista.appendChild(li);
        });
        caixa.classList.remove('d-none');
    }

    function registrarDuplicados(nomeEnviado, duplicadoDe) {
        if (!Array.isArray(duplicadoDe) || duplicadoDe.length === 0) return;
        const itens = lerDuplicadosPendentes();
        duplicadoDe.forEach(function (d) {
            itens.push({ nome: nomeEnviado, pastaId: d.pastaId, pastaNup: d.pastaNup, titulo: d.titulo });
        });
        try { sessionStorage.setItem(CHAVE_DUPLICADOS, JSON.stringify(itens.slice(-30))); } catch (_) {}
        renderizarAvisoDeDuplicados();
    }

    document.addEventListener('DOMContentLoaded', function () {
        renderizarAvisoDeDuplicados();
        // Mostrado uma vez depois do reload: o que ficou guardado já cumpriu o papel.
        const fechar = document.getElementById('uploadDuplicadosFechar');
        if (fechar) {
            fechar.addEventListener('click', function () {
                try { sessionStorage.removeItem(CHAVE_DUPLICADOS); } catch (_) {}
                const caixa = document.getElementById('uploadDuplicadosAviso');
                if (caixa) caixa.classList.add('d-none');
            });
        }
        if (lerDuplicadosPendentes().length > 0) {
            try { sessionStorage.removeItem(CHAVE_DUPLICADOS); } catch (_) {}
        }
    });

    // Envia 1 arquivo via XHR, reportando progresso de upload e fase de compressão.
    window.enviarArquivoComProgresso = function (file, opts) {
        return new Promise(function (resolve, reject) {
            const fd = new FormData();
            fd.append('arquivo', file);
            fd.append('_token', opts.csrf);
            fd.append('categoria', opts.categoria || '');
            fd.append('descricao', opts.descricao || '');
            fd.append('numero', opts.numero || '');
            if (opts.secaoId) fd.append('secao_id', opts.secaoId);
            fd.append('reduzir_tamanho', opts.reduzir ? '1' : '0');

            const xhr = new XMLHttpRequest();
            xhr.open('POST', opts.url);
            xhr.upload.addEventListener('progress', function (ev) {
                if (ev.lengthComputable && typeof opts.onProgress === 'function') {
                    opts.onProgress(Math.round((ev.loaded / ev.total) * 100));
                }
            });
            xhr.upload.addEventListener('load', function () {
                if (typeof opts.onComprimindo === 'function') opts.onComprimindo();
            });
            xhr.addEventListener('load', function () {
                let data = null;
                try { data = JSON.parse(xhr.responseText); } catch (_) {}
                if (xhr.status >= 200 && xhr.status < 300 && data && data.success) {
                    registrarDuplicados(file.name, data.duplicadoDe);
                    resolve(data);
                } else {
                    reject(new Error((data && data.error) ? data.error : 'Erro ao enviar o arquivo.'));
                }
            });
            xhr.addEventListener('error', function () { reject(new Error('Erro de comunicação.')); });
            xhr.send(fd);
        });
    };

    // Processa um item .anexo-item: lê os campos, mostra a barra e devolve true/false.
    window.processarItemUploadPeca = function (item, secaoId, reduzir) {
        const file      = item._file;
        const categoria = (item.querySelector('[name^="categorias"]') || {}).value || '';
        const descricao = (item.querySelector('[name^="descricoes"]') || {}).value || '';
        const numero    = (item.querySelector('[name^="numeros"]') || {}).value || '';

        const campos = item.querySelector('.anexo-campos');
        const btnRm  = item.querySelector('.btn-remover-anexo');
        const prog   = item.querySelector('.anexo-progresso');
        const bar    = prog.querySelector('.progress-bar');
        const status = prog.querySelector('.anexo-status');

        if (campos) campos.classList.add('d-none');
        if (btnRm)  btnRm.classList.add('d-none');
        prog.classList.remove('d-none');
        bar.className = 'progress-bar';
        bar.style.width = '0%';

        return window.enviarArquivoComProgresso(file, {
            url: URL_UPLOAD_PECA,
            csrf: CSRF_UPLOAD_PECA,
            categoria: categoria,
            descricao: descricao,
            numero: numero,
            secaoId: secaoId,
            reduzir: reduzir,
            onProgress: function (pct) {
                bar.style.width = pct + '%';
                status.textContent = 'Enviando… ' + pct + '%';
            },
            onComprimindo: function () {
                bar.style.width = '100%';
                status.textContent = reduzir ? 'Comprimindo…' : 'Processando…';
            }
        }).then(function (data) {
            const c = data.compressao;
            bar.style.width = '100%';
            if (c && c.comprimido) {
                bar.classList.add('bg-success');
                status.className = 'anexo-status text-success d-block mt-1';
                status.textContent = 'Reduzido de ' + formatBytesPeca(c.tamanhoOriginal)
                    + ' para ' + formatBytesPeca(c.tamanhoFinal) + '.'
                    + (c.eraAssinado ? ' Atenção: PDF assinado. A assinatura pode ter sido invalidada.' : '');
            } else if (reduzir) {
                bar.classList.add('bg-warning');
                status.className = 'anexo-status text-warning-emphasis d-block mt-1';
                status.textContent = 'Não foi possível reduzir. Enviado no tamanho original.';
            } else {
                bar.classList.add('bg-success');
                status.className = 'anexo-status text-success d-block mt-1';
                status.textContent = 'Enviado.';
            }
            if (Array.isArray(data.duplicadoDe) && data.duplicadoDe.length > 0) {
                const dup = document.createElement('small');
                dup.className = 'd-block mt-1 text-warning-emphasis';
                dup.textContent = 'Já existe arquivo idêntico: ' + data.duplicadoDe.map(function (d) {
                    return '«' + d.titulo + '» (' + (String(d.pastaId) === String(PASTA_ID_UPLOAD) ? 'nesta pasta' : 'pasta ' + d.pastaNup) + ')';
                }).join('; ') + '.';
                status.insertAdjacentElement('afterend', dup);
            }
            item.dataset.enviado = '1';
            return true;
        }).catch(function (err) {
            bar.style.width = '100%';
            bar.classList.add('bg-danger');
            status.className = 'anexo-status text-danger d-block mt-1';
            status.textContent = '✗ ' + err.message;
            return false;
        });
    };
</script>

