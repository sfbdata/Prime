{# ── Modais do explorador de documentos ─────────────────────────────────────
   Vivem AQUI, fora de .ps-page, e não dentro do painel da aba Documentos. Modal é
   `position: fixed`, e um ancestral com `transform` (mesmo vindo de uma animação)
   vira o bloco de contenção dele: o modal deixa de se posicionar pela janela e cai
   ABAIXO do backdrop, que o Bootstrap prega no <body>. O sintoma é o modal aparecer
   e não aceitar clique nem digitação. `PastaExploradorArranjoTelaTest` trava esse
   invariante para não voltar.

   São DOIS modais para a pasta inteira (nova pasta e renomear são inline desde o L5) — não um por documento. O modal de edição é
   ÚNICO e o explorador o preenche com os dados da linha (DOC-90): com 1.128
   documentos em produção, 1.128 formulários no HTML era o que deixava a aba lenta. #}
{# Modal "Mover para…" (arquivo OU pasta): a árvore de pastas, com a origem e os
   descendentes da pasta movida desabilitados — ciclo barrado na tela e no servidor. #}
<div class="modal fade pex-modal" id="pexDestinoModal" tabindex="-1" aria-labelledby="pexDestinoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="pexDestinoTitulo"><i class="bi bi-folder-symlink me-1"></i> {{ 'pasta_show.documento.mover_para'|trans }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'pasta_show.fechar'|trans }}"></button></div>
            <div class="modal-body">
                <div class="pex-dest-arvore" id="pexDestinoArvore" role="listbox" aria-label="{{ 'pasta_show.documento.pasta_de_destino'|trans }}"></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'pasta_show.cancelar'|trans }}</button><button type="button" class="btn btn-primary" id="pexDestinoConfirmar" disabled>{{ 'pasta_show.documento.mover'|trans }}</button></div>
        </div>
    </div>
</div>

{# Modal ÚNICO de edição do documento (nome-base, categoria, descrição, número).
   O explorador preenche `action`, `_token` e os campos a partir do JSON da linha;
   o POST é o mesmo de sempre (`pasta_documento_edit`, token `edit_documento_<id>`),
   e a extensão continua preservada pelo servidor. #}
<div class="modal fade pex-modal" id="pexEditarModal" tabindex="-1" aria-labelledby="pexEditarTitulo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="" id="pexEditarForm">
                <input type="hidden" name="_token" value="" id="pexEditarToken">
                <div class="modal-header">
                    <h5 class="modal-title" id="pexEditarTitulo"><i class="bi bi-pencil me-1"></i> {{ 'pasta_show.documento.editar'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'pasta_show.fechar'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="pexEditarNomeBase">{{ 'pasta_show.documento.nome_do_arquivo'|trans }}</label>
                        <div class="input-group">
                            <input type="text" name="nomeBase" id="pexEditarNomeBase" class="form-control" value="" maxlength="250" required>
                            <span class="input-group-text text-muted" id="pexEditarExt"></span>
                        </div>
                        <div class="form-text">{{ 'pasta_show.documento.extensao_a'|trans }} <strong id="pexEditarExtTexto"></strong> {{ 'pasta_show.documento.extensao_preservada'|trans }}</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="pexEditarCategoria">{{ 'pasta_show.documento.tipo'|trans }}</label>
                        <select name="categoria" id="pexEditarCategoria" class="form-select" required>
                            {% for valor, texto in documentTypeOptions %}
                                <option value="{{ valor }}">{{ texto }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="pexEditarDescricao">{{ 'pasta_show.documento.descricao'|trans }}</label>
                        <input type="text" name="descricao" id="pexEditarDescricao" class="form-control" value="" maxlength="500" placeholder="{{ 'pasta_show.documento.descricao_opcional'|trans }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="pexEditarNumero">{{ 'pasta_show.documento.numero_opcional'|trans }}</label>
                        <input type="text" name="numero" id="pexEditarNumero" class="form-control" value="" maxlength="255" placeholder="{{ 'pasta_show.documento.numero'|trans }}">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'pasta_show.cancelar'|trans }}</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> {{ 'pasta_show.salvar'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# Modal: Adicionar Cliente #}
<div class="modal fade" id="modalAdicionarCliente" tabindex="-1" aria-labelledby="modalAdicionarClienteLabel" aria-hidden="true">
