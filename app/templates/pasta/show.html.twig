                                <input type="date" id="mp-dataDistribuicao" name="dataDistribuicao" class="form-control">
                            </div>
                        </div>
                    </div>{# fim tab-modal-proc-info #}

                    {# ABA: Partes #}
                    <div class="processo-modal-tab-content pt-3" id="tab-modal-proc-partes">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" id="mp-btn-add-parte" class="btn btn-sm btn-warning">
                                <i class="bi bi-plus-lg me-1"></i> Adicionar Parte
                            </button>
                        </div>
                        <div id="mp-partesContainer">
                            <div class="mp-parte-row card mb-2 p-3" style="position: relative;">
                                <div class="row g-2">
                                    <div class="col-md-3">
