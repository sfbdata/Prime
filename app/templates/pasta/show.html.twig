                            <span class="text-muted small px-1 text-nowrap">{{ 'pasta_show.cliente.ou_selecione'|trans }}</span>
                            <hr class="flex-fill m-0">
                        </div>

                        {# — Busca de cliente existente — #}
                        <div class="position-relative">
                            <div class="input-group input-group-sm">
