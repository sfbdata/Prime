                <button type="button" class="ps-modal-meta-cab-btn" data-ps-nm-recolher
                        aria-label="Recolher (continue vendo a lista)" title="Recolher (continue vendo a lista)">
                    <i class="bi bi-dash-lg" aria-hidden="true"></i>
                </button>
                <button type="button" class="ps-modal-meta-cab-btn" data-bs-dismiss="modal" aria-label="Fechar" title="Fechar (Esc)">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
