                                            data-nome-atual="{{ secao.nome|e('html_attr') }}"
                                            data-csrf="{{ csrf_token('pasta_secao_renomear_' ~ secao.id) }}"
                                            data-url="{{ path('pasta_secao_renomear', {secaoId: secao.id}) }}">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-secao-excluir-btn" title="Excluir seção"
                                            data-secao-id="{{ secao.id }}"
                                            data-csrf="{{ csrf_token('pasta_secao_excluir_' ~ secao.id) }}"
                                            data-url="{{ path('pasta_secao_excluir', {secaoId: secao.id}) }}"
                                            data-nome="{{ secao.nome|e('html_attr') }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <button type="button" class="btn btn-tool js-secao-toggle" data-bs-toggle="collapse"
                                            data-bs-target="#secaoBody{{ secao.id }}" aria-expanded="false">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="collapse" id="secaoBody{{ secao.id }}">
                                <div class="card-body secao-dropzone p-2" data-secao-destino="{{ secao.id }}">
