                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                    <div class="js-secao-docs docs-list-scroll" data-secao-destino="{{ secao.id }}">
                                        {% for doc in secao.documentos %}
                                            {% set label = documentTypeOptions[doc.categoria] ?? doc.categoria %}
                                            <div class="d-flex align-items-center border rounded px-2 py-2 mb-2 gap-2 doc-item"
                                                 data-doc-id="{{ doc.id }}"
                                                 data-secao-id="{{ secao.id }}"
                                                 data-csrf-mover="{{ csrf_token('pasta_doc_mover_' ~ doc.id) }}"
                                                 data-url-mover="{{ path('pasta_documento_mover_secao', {docId: doc.id}) }}">
                                                <i class="bi bi-grip-vertical text-muted flex-shrink-0 doc-grip" style="cursor:grab;"></i>
                                                <i class="bi bi-file-earmark-text fs-5 text-primary flex-shrink-0"></i>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <a href="{{ path('pasta_documento_download', {id: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold small">
                                                        {{ doc.nomeOriginal }}
                                                    </a>
                                                    <small class="text-muted">
                                                        {{ label }}{% if doc.descricao %} · {{ doc.descricao }}{% endif %}{% if doc.numero %} · Nº {{ doc.numero }}{% endif %} · {{ doc.carregadoEm|date('d/m/Y') }}
                                                    </small>
                                                </div>
                                                <div class="d-flex gap-1 flex-shrink-0 doc-acoes">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Visualizar"
                                                            data-bs-toggle="modal" data-bs-target="#previewDocModal"
                                                            data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
                                                            data-nome="{{ doc.nomeOriginal }}"
                                                            data-mime="{{ doc.mimeType }}">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <form method="post" action="{{ path('pasta_documento_delete', {id: doc.id}) }}" onsubmit="return confirm('Deseja excluir este documento?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_' ~ doc.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}

                        {# Card "vazado" para criar nova seção #}
                        <div class="card mb-3" id="cardNovaSecao"
                             style="border: 2px dashed #ced4da; background: transparent;">
                            <div class="card-body py-2">
                                <div id="novaSecaoBotao" class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnMostrarNovaSecao">
                                        <i class="bi bi-folder-plus me-1"></i> Nova seção de documentos
                                    </button>
                                </div>
                                <div id="novaSecaoForm" class="d-none">
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="novaSecaoNome" class="form-control" placeholder="Nome da seção..." maxlength="255">
                                        <button type="button" id="btnSalvarNovaSecao" class="btn btn-primary">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" id="btnCancelarNovaSecao" class="btn btn-outline-secondary">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <div id="novaSecaoErro" class="text-danger small mt-1 d-none"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                    {% endif %}
</div>{# /.ps-page #}

{# ── Modal: novo pagamento da pasta ─────────────────────────────────────────
   FORA de .ps-page pelo mesmo motivo dos modais do gerenciador logo abaixo: um
   ancestral com `transform` (a animação de entrada dos painéis) vira bloco de
   contenção de `position: fixed` e prende o modal abaixo do backdrop. #}
<div class="modal fade" id="modalNovoPagamento" tabindex="-1" aria-labelledby="modalNovoPagamentoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="formNovoPagamento">
                <div class="modal-header py-2">
                    <h6 class="modal-title" id="modalNovoPagamentoLabel">
                        <i class="bi bi-wallet2 me-1"></i> Novo pagamento
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="novoPagamentoDescricao">Descrição</label>
                        <input type="text" class="form-control form-control-sm" id="novoPagamentoDescricao"
                               name="descricao" maxlength="120" required
                               placeholder="Ex.: 2ª parcela — honorários">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="novoPagamentoValor">Valor</label>
                        <input type="text" class="form-control form-control-sm" id="novoPagamentoValor"
                               name="valor" inputmode="decimal" maxlength="20" required
                               placeholder="1.300,00">
                    </div>
                    <div class="mb-1">
                        <label class="form-label small fw-semibold" for="novoPagamentoVencimento">Vencimento</label>
                        <input type="date" class="form-control form-control-sm" id="novoPagamentoVencimento"
                               name="vencimento" required>
                    </div>
                    <div id="novoPagamentoErro" class="text-danger small mt-2 d-none"></div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm" id="btnSalvarPagamento">Lançar</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# O histórico do sistema virou painel lateral: fora do fluxo da página, aberto
   pelo botão "Histórico" do cabeçalho. Fica FORA de .ps-page porque é fixo e
   cobre a tela inteira, overlay incluído. #}
{{ include('pasta/_historico_drawer.html.twig', {
    eventosHistorico: eventosHistorico,
}) }}

{# ── Modais do gerenciador de arquivos ──────────────────────────────────────
   Vivem AQUI, fora de .ps-page, e não dentro do painel da aba Documentos, que é
   onde estavam. Modal é `position: fixed`, e um ancestral com `transform` (mesmo
   vindo de uma animação) vira o bloco de contenção dele: o modal deixa de se
   posicionar pela janela e cai ABAIXO do backdrop, que o Bootstrap prega no
   <body>. O sintoma é o modal aparecer e não aceitar clique nem digitação.

   Eram os três ÚNICOS modais desta tela dentro de um painel animado — os outros
   sete sempre estiveram aqui fora e nunca tiveram o problema. `PastaShowDocumentos
   ControllerTest` trava esse invariante para não voltar. #}
{# Modal reutilizável de texto (nova pasta / renomear) #}
<div class="modal fade" id="fmInputModal" tabindex="-1" aria-hidden="true">
