                                         style="border: 2px dashed #ced4da; min-height: 52px; transition: background .15s;">
                                        <i class="bi bi-cloud-upload me-1"></i> Arraste arquivos do computador aqui
                                    </div>
                                    <form class="secao-upload-form" method="post" enctype="multipart/form-data"
                                          action="{{ path('pasta_documento_upload', {id: pasta.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('upload_documento_pasta_' ~ pasta.id) }}">
                                        <input type="hidden" name="secao_id" value="{{ secao.id }}">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <button type="button" class="btn btn-sm btn-primary js-secao-add-file" data-secao="{{ secao.id }}">
                                                <i class="bi bi-plus-lg me-1"></i> Adicionar arquivo
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-secao-limpar d-none" data-secao="{{ secao.id }}">
                                                <i class="bi bi-x-circle me-1"></i> Limpar
                                            </button>
                                            <input type="file" class="js-secao-file-input d-none" multiple
                                                   accept=".pdf,.jpg,.jpeg,.png,.mp4,.mpeg,.mp3,.ogg,.opus,.wav,.wma,.mov,.kml,audio/*,video/*"
                                                   data-secao="{{ secao.id }}">
                                        </div>
                                        <div class="js-secao-lista-anexos" data-secao="{{ secao.id }}"></div>
                                        <div class="js-secao-area-enviar d-none mt-2" data-secao="{{ secao.id }}">
