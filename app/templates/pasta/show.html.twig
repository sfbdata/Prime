{% extends 'base.html.twig' %}

{% block title %}Pasta {{ pasta.nup }}{% endblock %}

{% block body_class %}ps-body{% endblock %}

{% block stylesheets %}
{{ parent() }}
{# Explorador de documentos da aba Documentos (próprio da Pasta; o pasta-arquivos.css fica com a Cobrança). #}
<link rel="stylesheet" href="/css/pasta-explorador.css">
{# Redesenho da tela de pasta — desenho aprovado em docs/design/pasta-show/. #}
<link rel="stylesheet" href="/css/pasta-show.css">
<link rel="stylesheet" href="{{ asset('css/pasta-prazos.css') }}">
<link rel="stylesheet" href="{{ asset('css/cliente-cadastro.css') }}">
<link rel="stylesheet" href="{{ asset('css/pasta-andamento.css') }}">
{# Link externo do Push: menu da aba, modal e painel de acessos (pasta/_push_link_externo.html.twig). #}
<link rel="stylesheet" href="{{ asset('css/pasta-push-link.css') }}">
{# Ocultar aba: ícone da regra na aba, modal "Ocultar aba" e o aviso sem aba (pasta/_abas_ocultas.html.twig). #}
<link rel="stylesheet" href="{{ asset('css/pasta-abas-ocultas.css') }}">
<link rel="stylesheet" href="{{ asset('css/pasta-presenca-autor.css') }}">

{# O estilo do chip de responsável sobe para o <head>. Ele ficava no fim do
   <body>, a ~4.800 linhas de HTML do chip — e o chip agora abre a página, no
   cabeçalho. Nesse intervalo o navegador pintava a FOTO NO TAMANHO NATURAL:
   quem recorta a imagem no círculo de 24px é `.resp-avatar{overflow:hidden}` e
   `.resp-avatar-img img{width:100%}`, as duas aqui dentro. Estilo tem de chegar
   antes da marcação que ele dimensiona. #}
{{ include('pasta/_resp_estilo.html.twig') }}
{% endblock %}

{% block body %}
{# ============================================================================
   Redesenho aprovado: docs/design/pasta-show/ ("Pasta 1A.dc.html").

   O que mudou de ESTRUTURA nesta tela:
     · o cabeçalho virou cartão próprio (`pasta/_cabecalho.html.twig`), com as
       ações rotuladas, prioridade, etiquetas e a faixa de dados do caso;
     · as abas viraram controle segmentado, e cada painel é um cartão solto —
       não mais o miolo de um `.card-body` único;
     · o histórico automático do sistema saiu da página e virou drawer;
     · o rodapé sumiu: "Voltar às Pastas" virou o botão "Pastas" da linha 1 e
       "Excluir Pasta" foi para o menu ⋮.

   O chrome do topo (barra teal + EXPEDIENTE/DEMANDAS/PROCESSOS) NÃO foi tocado:
   pedido explícito do dono.
   ============================================================================ #}
<div class="ps-page">

    {# PAS-047: a decisão "pode editar a pasta" é tomada UMA vez por página (cada chamada
       consulta o banco) e repassada aos parciais que oferecem ação de escrita — hoje o
       "Alertar" do ⋮ do prazo e o sino das Metas, que o servidor só aceita com edit. #}
    {% set podeEditarPasta = can_access_resource('pasta', pasta.id, 'edit') %}

    {# Abas ocultas (spec pasta-ocultar-aba §5): a aba que está oculta para quem vê não tem painel
       renderizado, e a primeira visível nasce ativa. `#push` na URL com o Push oculto não acha gatilho
       (`abaDoFragmento` do pasta-show.js) e a tela fica na primeira visível. #}
    {% set abasDaPasta = abasDaPasta|default(null) %}
    {% set abasOcultas = abasDaPasta ? abasDaPasta.ocultas : [] %}
    {% set primeiraAba = abasDaPasta ? abasDaPasta.primeiraVisivel() : 'dados' %}

    {{ include('pasta/_cabecalho.html.twig', {
        pasta: pasta,
        fotosResponsaveis: fotosResponsaveis|default({}),
        push: push,
        vizinhas: vizinhas,
        unidadeCobrada: unidadeCobrada|default(null),
        podeEditarPasta: podeEditarPasta,
    }) }}


            <style>
            .docs-list-scroll {
                max-height: 320px;
                overflow-y: auto;
            }
            .docs-list-scroll::-webkit-scrollbar { width: 5px; }
            .docs-list-scroll::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 3px; }
            .doc-item .doc-acoes { opacity: 0; transition: opacity .15s; }
            .doc-item:hover .doc-acoes { opacity: 1; }

            /* ── Card Documentação: visual de pasta ── */
            .doc-folder-wrapper {
                margin-top: 22px;
                position: relative;
            }
            .doc-folder-wrapper::before {
                content: '';
                position: absolute;
                top: -22px;
                left: 0;
                width: 52%;
                max-width: 175px;
                height: 22px;
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%);
                border-radius: 6px 10px 0 0;
                clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
            }
            .doc-folder-card.card.card-primary.card-outline {
                border-top-left-radius: 0 !important;
                border-color: #3f7bbf !important;
                box-shadow: 2px 3px 10px rgba(0,0,0,0.13);
            }
            .doc-folder-header {
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%) !important;
                border-bottom: none !important;
                border-top-right-radius: 4px !important;
                border-top-left-radius: 0 !important;
                padding: 0.6rem 1rem !important;
                cursor: pointer;
                user-select: none;
            }
            .doc-folder-header .card-title {
                color: #fff !important;
                font-size: 0.9rem;
            }
            .doc-folder-header .btn-tool {
                color: rgba(255,255,255,0.75) !important;
            }
            .doc-folder-header .btn-tool:hover {
                color: #fff !important;
            }
            .doc-folder-header .badge {
                background-color: rgba(255,255,255,0.22) !important;
                color: #fff !important;
                font-weight: 500;
            }
            @media (max-width: 575.98px) {
                .doc-folder-wrapper::before {
                    width: 48%;
                    max-width: 150px;
                    height: 20px;
                    top: -20px;
                }
                .doc-folder-wrapper { margin-top: 20px; }
            }

            /* ── Cards de seção: visual de pasta ── */
            .pasta-secao-card {
                margin-top: 22px;
                position: relative;
                overflow: visible !important;
                border-top-left-radius: 0 !important;
                border-color: #3f7bbf !important;
                box-shadow: 2px 3px 10px rgba(0,0,0,0.13);
            }
            .pasta-secao-card::before {
                content: '';
                position: absolute;
                top: -22px;
                left: 0;
                width: 52%;
                max-width: 175px;
                height: 22px;
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%);
                border-radius: 6px 10px 0 0;
                clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
            }
            .pasta-secao-card .card-header {
                background: linear-gradient(180deg, #5b9bd5 0%, #3f7bbf 100%) !important;
                border-bottom: none !important;
                border-top-left-radius: 0 !important;
                cursor: pointer;
                user-select: none;
            }
            .pasta-secao-card .card-header .pasta-secao-nome {
                color: #fff;
            }
            .pasta-secao-card .card-header .badge {
                background-color: rgba(255,255,255,0.22) !important;
                color: #fff !important;
                font-weight: 500;
            }
            .pasta-secao-card .card-header .btn-tool {
                color: rgba(255,255,255,0.75) !important;
            }
            .pasta-secao-card .card-header .btn-tool:hover {
                color: #fff !important;
            }
            .pasta-secao-card .card-header .js-secao-renomear-btn,
            .pasta-secao-card .card-header .js-secao-excluir-btn {
                opacity: 0;
                transition: opacity .15s;
            }
            .pasta-secao-card .card-header:hover .js-secao-renomear-btn,
            .pasta-secao-card .card-header:hover .js-secao-excluir-btn {
                opacity: 1;
            }
            .pasta-secao-card .card-header .btn-outline-secondary,
            .pasta-secao-card .card-header .btn-outline-danger {
                color: rgba(255,255,255,0.8) !important;
                border-color: rgba(255,255,255,0.35) !important;
                background: transparent !important;
            }
            .pasta-secao-card .card-header .btn-outline-secondary:hover {
                color: #fff !important;
                background: rgba(255,255,255,0.15) !important;
                border-color: rgba(255,255,255,0.6) !important;
            }
            .pasta-secao-card .card-header .btn-outline-danger:hover {
                color: #fff !important;
                background: rgba(220,53,69,0.4) !important;
                border-color: rgba(255,255,255,0.6) !important;
            }
            @media (max-width: 575.98px) {
                .pasta-secao-card { margin-top: 20px; }
                .pasta-secao-card::before {
                    width: 48%;
                    max-width: 150px;
                    height: 20px;
                    top: -20px;
                }
            }
            </style>
    {# Os painéis das abas. O <ul class="nav-tabs"> saiu daqui: virou o controle
       segmentado da linha 3 do cabeçalho. Os `id` dos painéis não mudaram —
       são o alvo dos `data-bs-target` e do `abaDoFragmento` do pasta-show.js. #}
    <div class="tab-content ps-paineis" id="pastaTabsContent">
        {# ── Aba 1: Dados da Pasta ──────────────────────────────────────────
           Duas colunas: as anotações do caso no centro (a zona quente) e o
           trilho à direita com Próximos prazos, Clientes, Financeiro e
           Documentos — o que responde "em que pé está o caso" sem clicar aba
           por aba.

           O que saiu daqui: o histórico automático do sistema (foi para o
           drawer) e a faixa de processo/ação/responsável (subiu para o
           cabeçalho, que é comum a todas as abas). #}
        {% if primeiraAba is null %}
            <div class="ps-abas-nenhuma" role="status"><i class="bi bi-eye-slash" aria-hidden="true"></i><span>Nenhuma aba disponível para você nesta pasta.</span></div>
        {% endif %}
        {% if 'dados' not in abasOcultas %}
        <div class="tab-pane fade{{ primeiraAba == 'dados' ? ' show active' }}" id="dados" role="tabpanel" aria-labelledby="dados-tab">
            <div class="ps-grade">
                {{ include('pasta/_dados_anotacoes.html.twig', {
                    pasta: pasta,
                    anotacoes: anotacoes,
                }) }}

                <div class="ps-trilho">
                    {{ include('pasta/_dados_trilho.html.twig', {
                        pasta: pasta,
                        proximosPrazos: proximosPrazos,
                        podeEditarPasta: podeEditarPasta,
                        unidadeCobrada: unidadeCobrada|default(null),
                        abasOcultas: abasOcultas,
                    }) }}
                </div>
            </div>
        </div>
        {% endif %}


                            {# Tab: Processo #}
                            {% if 'processo' not in abasOcultas %}
                            <div class="tab-pane fade{{ primeiraAba == 'processo' ? ' show active' }}" id="processo" role="tabpanel" aria-labelledby="processo-tab">
                                <div id="processoTabContent">
                                {{ include('pasta/_processos_vinculados.html.twig') }}
                                </div><!-- /processoTabContent -->
                            </div>
                            {% endif %}

                            {# Tab: Financeiro #}
                            {% if 'financeiro' not in abasOcultas %}
                            <div class="tab-pane fade{{ primeiraAba == 'financeiro' ? ' show active' }}" id="financeiro" role="tabpanel" aria-labelledby="financeiro-tab">
                                {% include 'pasta/_financeiro.html.twig' with {
                                    pasta: pasta,
                                    documentosContrato: documentosContrato,
                                    observacoesFinanceiras: observacoesFinanceiras,
                                    financeiro: financeiro,
                                    pagamentos: pagamentos,
                                    podeEditarPasta: podeEditarPasta,
                                    abasOcultas: abasOcultas,
                                } only %}
                            </div>
                            {% endif %}

                            {# Tab: Push Processual #}
                            {% if 'push' not in abasOcultas %}
                            <div class="tab-pane fade{{ primeiraAba == 'push' ? ' show active' }}" id="push" role="tabpanel" aria-labelledby="push-tab">
                                {% include 'pasta/_push_processual.html.twig' with {
                                    pasta: pasta,
                                    push: push,
                                    pushPainel: pushPainel,
                                    analisesIa: analisesIa,
                                    podeEditarPasta: podeEditarPasta,
                                    abasOcultas: abasOcultas,
                                } only %}
                            </div>
                            {% endif %}

                            {# Tab: Metas — o markup mora em pasta/_metas.html.twig (desenho 1.2.3). #}
                            {% if 'tarefas' not in abasOcultas %}
                            <div class="tab-pane fade{{ primeiraAba == 'tarefas' ? ' show active' }}" id="tarefas" role="tabpanel" aria-labelledby="tarefas-tab">
                                {% include 'pasta/_metas.html.twig' with {
                                    pasta: pasta,
                                    metasResumo: metasResumo,
                                    podeEditarPasta: podeEditarPasta,
                                } only %}
                            </div>
                            {% endif %}

                            {# Tab: Detalhes — desenho 1.2.3: o relatorio inicial em linha do tempo
                               ao centro e, no trilho, "Registro da pasta" (criada/modificada/por) com o
                               atalho para o historico do sistema e "Como usar esta aba". #}
                            {% if 'detalhes' not in abasOcultas %}
                            <div class="tab-pane fade{{ primeiraAba == 'detalhes' ? ' show active' }}" id="detalhes" role="tabpanel" aria-labelledby="detalhes-tab">
                                <div class="ps-grade">
                                {% include 'pasta/_detalhes_obs.html.twig' with {
                                    pasta: pasta,
                                    observacoesDetalhes: observacoesDetalhes,
                                    fotosResponsaveis: fotosResponsaveis|default({}),
                                    podeEditarPasta: podeEditarPasta,
                                } only %}

                                <div class="ps-trilho">
                                    <section class="ps-card ps-registro-pasta" data-trilho="registro-pasta">
                                        <h2>Registro da pasta</h2>
                                        <div class="ps-registro-pasta-campos">
                                            <div>
                                                <div class="ps-rotulo">Criada em</div>
                                                <div class="ps-registro-pasta-valor ps-num">{{ pasta.criadoEm|date('d/m/Y H:i') }}</div>
                                            </div>
                                            <div>
                                                <div class="ps-rotulo">Modificada em</div>
                                                <div class="ps-registro-pasta-valor ps-num">{% if pasta.modificadoEm %}{# N9 (dc L.6431): "hoje, 26/08/2026 14:58" no dia. #}{% if pasta.modificadoEm|date('Y-m-d') == 'now'|date('Y-m-d') %}hoje, {% endif %}{{ pasta.modificadoEm|date('d/m/Y H:i') }}{% else %}<span class="ps-dado--vazio">Sem registro</span>{% endif %}</div>
                                            </div>
                                            <div>
                                                <div class="ps-rotulo">Criada por</div>
                                                {% if pasta.criadoPor %}
                                                    {% set partesCriador = (pasta.criadoPor.fullName ?? '')|trim|split(' ')|filter(p => p is not empty) %}
                                                    <div class="ps-registro-pasta-pessoa">
                                                        <span class="ps-avatar ps-avatar--24 ps-avatar--neutro" aria-hidden="true">{{ partesCriador|slice(0, 2)|map(p => p|slice(0, 1))|join('')|upper }}</span>
                                                        <span class="ps-registro-pasta-valor">{{ pasta.criadoPor.fullName }}</span>
                                                    </div>
                                                {% else %}
                                                    <div class="ps-registro-pasta-valor ps-dado--vazio">Não informado</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="ps-registro-pasta-div"></div>
                                        {# Abre o MESMO drawer do historico do menu ⋮ (pasta-show.js escuta `data-ps-historico`). #}
                                        <button type="button" class="ps-btn ps-btn--suave ps-btn--largo" data-ps-historico
                                                title="Histórico do sistema">
                                            <i class="bi bi-clock-history"></i><span>Ver histórico do sistema</span>
                                        </button>
                                    </section>

                                    <section class="ps-card ps-como-usar" data-trilho="como-usar">
                                        <h2>Como usar esta aba</h2>
                                        <p>Aqui fica o <strong>relatório inicial de atendimento</strong>: o relato do cliente, o resumo da demanda, a tese e os resultados esperados. Os combinados de honorários ficam em <strong>Financeiro</strong>.</p>
                                    </section>
                                </div>
                                </div>
                            </div>
                            {% endif %}

                            {# ==================== ABA: DOCUMENTOS (explorador próprio da Pasta) ==================== #}
                            {% if 'documentos' not in abasOcultas %}
                            <div class="tab-pane fade{{ primeiraAba == 'documentos' ? ' show active' }}" id="documentos" role="tabpanel" aria-labelledby="documentos-tab" tabindex="0">
                                {{ include('pasta/_documentos_explorador.html.twig') }}

                            </div>{# /tab-pane #documentos #}
                            {% endif %}

                        </div>

</div>{# /.ps-page #}

{# Só existe com a aba Financeiro visível: quem o usa é o script do _financeiro (spec pasta-ocultar-aba §5). #}
{% if 'financeiro' not in abasOcultas %}
{# ── Modal: Adicionar pagamento (desenho 1.2.3, dc L.1928-2012) ──────────────
   FORA de .ps-page pelo mesmo motivo dos modais do gerenciador logo abaixo: um
   ancestral com `transform` (a animação de entrada dos painéis) vira bloco de
   contenção de `position: fixed` e prende o modal abaixo do backdrop.

   Tipo → base (valor fixo | % da causa) → total, entrada, parcelas, 1º
   vencimento, juros → PRÉVIA das parcelas → "Gerar N lançamentos". A prévia é
   calculada no navegador só para mostrar; o POST leva os CAMPOS e o servidor
   refaz a conta (`RegistrarParcelamentoDaPastaUseCase`) — o que grava é a
   conta dele. Êxito e sucumbência aparecem como no desenho, mas desabilitados:
   gravá-los depende de migration (fatia 11b).

   DESVIO CONSCIENTE do desenho (decisão do orquestrador, P16a): o campo
   opcional "Descrição", abaixo dos campos do dc. O desenho não o tem, mas o
   modal antigo tinha descrição livre e a função não pode se perder. Em branco,
   valem as descrições do desenho; preenchido, vai em todas as linhas geradas
   (" · k/N" com mais de uma parcela, " · entrada" na entrada).

   DESVIO CONSCIENTE do desenho (decisão do dono, 07/10/2026): o dc (L.3471,
   `entradaPaga: true`) traz o controle "Entrada já recebida hoje", ligado por
   padrão, que lançava a entrada QUITADA. Removido: "nenhuma operação pode
   registrar recebimento financeiro que não ocorreu". Entrada e parcelas nascem
   PENDENTES; o recebimento é o gesto "Marcar como recebido" do ⋮ da linha. O
   servidor recusa (422) um `entradaPaga=1` que ainda chegue. #}
<div class="modal fade ps-np-modal" id="modalNovoPagamento" tabindex="-1" aria-labelledby="modalNovoPagamentoLabel" aria-hidden="true"
     data-url-parcelar="{{ path('pasta_pagamento_parcelar', {id: pasta.id}) }}"
     data-max-parcelas="60">
    <div class="modal-dialog ps-np-dialogo">
        <div class="modal-content ps-np">
            <form id="formNovoPagamento" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('pasta_pagamento_' ~ pasta.id) }}">
                <input type="hidden" name="tipo" value="contrato">
                <input type="hidden" name="base" value="valor">
                <input type="hidden" name="juros" value="0">

                <div class="ps-np-cab">
                    <i class="bi bi-cash-coin ps-np-cab-icone" aria-hidden="true"></i>
                    <div class="ps-np-cab-textos">
                        <div class="ps-np-titulo" id="modalNovoPagamentoLabel">Adicionar pagamento</div>
                        <div class="ps-np-sub">Valor da causa <span class="js-np-causa">{{ financeiro.valorCausaFormatado }}</span> · cálculo automático</div>
                    </div>
                    <button type="button" class="ps-np-fechar" data-bs-dismiss="modal" title="Fechar" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="ps-np-corpo">
                    <div class="ps-np-bloco">
                        <span class="ps-np-rotulo">Tipo</span>
                        <div class="ps-np-tipos" role="group" aria-label="Tipo do pagamento">
                            <button type="button" class="ps-np-tipo is-ativo" data-tipo="contrato" aria-pressed="true"
                                    data-nota="Honorários combinados com o cliente. Pode ser valor fixo ou % do valor da causa, com entrada, parcelas e juros."
                                    title="Honorários combinados com o cliente. Pode ser valor fixo ou % do valor da causa, com entrada, parcelas e juros."><i class="bi bi-file-earmark-text"></i>Contratuais</button>
                            <button type="button" class="ps-np-tipo" data-tipo="exito" aria-pressed="false" disabled
                                    title="Participação no proveito econômico: % sobre o valor da causa, recebido só se houver resultado. Ainda não disponível."><i class="bi bi-trophy"></i>Êxito</button>
                            <button type="button" class="ps-np-tipo" data-tipo="sucumbencia" aria-pressed="false" disabled
                                    title="Fixada pelo juízo, em regra entre 10% e 20% (art. 85 CPC). Ainda não disponível."><i class="bi bi-bank"></i>Sucumbência</button>
                            <button type="button" class="ps-np-tipo" data-tipo="custas" aria-pressed="false"
                                    data-nota="Custas e despesas adiantadas a reembolsar pelo cliente."
                                    title="Custas e despesas adiantadas a reembolsar pelo cliente."><i class="bi bi-receipt"></i>Custas</button>
                        </div>
                        <span class="ps-np-nota js-np-tipo-nota">Honorários combinados com o cliente. Pode ser valor fixo ou % do valor da causa, com entrada, parcelas e juros.</span>
                    </div>

                    <div class="ps-np-grade">
                        <div class="ps-np-campo">
                            <span class="ps-np-rotulo">Base do valor</span>
                            <div class="ps-np-seg" role="group" aria-label="Base do valor">
                                <button type="button" class="ps-np-seg-op is-ativo" data-base="valor" aria-pressed="true">Valor fixo</button>
                                <button type="button" class="ps-np-seg-op" data-base="pct" aria-pressed="false">% da causa</button>
                            </div>
                        </div>
                        <label class="ps-np-campo js-np-campo-total">
                            <span class="ps-np-rotulo">Valor total (R$)</span>
                            <input type="text" class="ps-np-input" name="total" inputmode="decimal" maxlength="20" placeholder="0,00" autocomplete="off">
                        </label>
                        <label class="ps-np-campo js-np-campo-pct" hidden>
                            <span class="ps-np-rotulo">% do valor da causa</span>
                            <input type="text" class="ps-np-input" name="percentual" inputmode="decimal" maxlength="8" value="20" autocomplete="off">
                        </label>
                        <label class="ps-np-campo">
                            <span class="ps-np-rotulo">Entrada (R$)</span>
                            <input type="text" class="ps-np-input" name="entrada" inputmode="decimal" maxlength="20" placeholder="opcional" autocomplete="off">
                        </label>
                        <label class="ps-np-campo">
                            <span class="ps-np-rotulo">Parcelas</span>
