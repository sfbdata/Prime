                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var btn = document.getElementById('btn-alternar-status');
    if (!btn) return;

    var badgeEl = document.querySelector('.card-tools .badge');

    btn.addEventListener('click', function () {
        var url  = btn.dataset.url;
        var csrf = btn.dataset.csrf;

        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '_token=' + encodeURIComponent(csrf),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.sucesso) {
                alert(data.erro || 'Erro ao alterar status.');
                btn.disabled = false;
                return;
            }

            var novoStatus = data.novoStatus;
            btn.dataset.statusAtual = novoStatus;

            var eAtivo = novoStatus === 'ativo';

            /* ícone */
            var icone = btn.querySelector('i');
            icone.className = 'bi ' + (eAtivo ? 'bi-archive' : 'bi-archive-fill');

            /* label */
            var label = btn.querySelector('.pasta-acao-label');
            label.textContent = eAtivo ? 'Arquivar' : 'Ativar';

            /* title */
            btn.title = eAtivo ? 'Arquivar pasta' : 'Reativar pasta';

            /* cor do botão */
            btn.classList.toggle('pasta-acao-btn--arquivado', !eAtivo);

            /* badge de status no card-tools */
            if (badgeEl) {
                badgeEl.textContent = eAtivo ? 'Ativo' : 'Arquivado';
                badgeEl.className = 'badge ' + (eAtivo ? 'text-bg-success' : 'text-bg-secondary');
            }

            btn.disabled = false;
        })
        .catch(function () {
            alert('Erro de comunicação com o servidor.');
            btn.disabled = false;
        });
    });
}());
</script>

