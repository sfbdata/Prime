{# ============================================================================
   Aba Push Processual — as publicações captadas do DJEN para os processos DESTA
   pasta.

   O casamento é pelo NÚMERO CNJ do processo, não pela FK da publicação: a FK só
   é gravada durante a sincronização, então publicação que chegou antes de o
   processo entrar no cadastro nunca a recebe. Por isso não há selo
   "avulsa/vinculada" aqui — dentro da pasta toda publicação listada é do caso,
   e a distinção é assunto do módulo.

   Os dois vazios têm textos diferentes de propósito: sem processo vinculado a
   pasta nunca receberá nada (e o caminho é a aba Processo); com processo e sem
   publicação, o que falta é o processo estar sob uma OAB monitorada. A FORMA é a
   do desenho (linha simples, dc L.2424, auditoria 2 U4); o texto continua o daqui
   até o dono decidir trocá-lo pelo `vazioTxt` do desenho.

   Contexto: `pasta`, `push` (App\Pasta\DTO\PastaPushOutput), `analisesIa`
   (App\Inteligencia\DTO\AnalisesDaPastaOutput, ou null sem `modules.inteligencia.view`).
   ============================================================================ #}
{# FPN-014c: o menu do cartão só oferece a escrita que o servidor vai aceitar. Nota técnica e
   Criar tarefa exigem EDIT da pasta e pasta viva (a lápide é recusada pelo
   PastaSomenteLeituraListener); a nota ainda exige o processo da pasta (sem ele o teor não traz
   o bloco de notas). "Marcar como (não) lida" é escrita que o `pasta_push_lida` aceita com VIEW,
   mas é POST com a pasta: na lápide o mesmo listener a recusa, então ela some só ali. Leituras
   (Abrir documento, Copiar texto) ficam sempre. `podeEditarPasta` vem do show (fallback: aqui). #}
{% set podeEditarPasta = podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit') %}
{% set pushPastaViva = not pasta.estaExcluida %}
{% set pushPodeEscrever = pushPastaViva and podeEditarPasta %}
{# Grade de duas colunas do desenho (dc L.6595 `pushAnim`: `minmax(0,1fr) minmax(0,300px)`, gap 16):
   a lista à esquerda e, à direita, o cartão de Monitoramento e Situação atual (spec
   push-painel-monitoramento §4, e o "Avisar quando chegar", push-avisar-quando-chegar §2; o
   "Avisar cliente" chega no P4c). Em tela estreita a coluna desce para baixo da lista (pasta-push-painel.css). #}
<div class="ps-push-grade">
<section class="ps-card ps-push" data-aba="push">
    <div class="ps-card-cab ps-card-cab--faixa">
        <h2>{{ 'pasta_push.processual.titulo'|trans }}</h2>
        {# Contagem sempre, inclusive o 0 (dc L.2414 `{{ push.total }}`, auditoria 2 U8). #}
        <span class="ps-contagem">{{ push.total }}</span>
        <span class="ps-cab-espaco"></span>
        {# O atalho para o módulo só para quem pode entrar nele: a aba NÃO exige
           `modules.djen.view` (o push é conteúdo da pasta), mas a tela do módulo exige. Sem esta
           guarda o link levaria metade dos usuários a um acesso negado. #}
        {% if push.numeroUnico and can_access_module('djen') %}
            <a class="ps-card-cab-link ps-card-cab-link--texto"
               href="{{ path('push_processual_index', {busca: push.numeroUnico}) }}">{{ 'pasta_push.processual.ver_no_modulo'|trans }}</a>
        {% endif %}
        {# BlueJus IA (spec inteligencia-resumo-do-push §3.6): entre o atalho do módulo e os filtros,
           onde o desenho o põe (dc L.2416). Como no desenho (`podeIA`), só existe quando há o que
           ler. Fora do estado "disponível" o botão não finge funcionar: sai desabilitado com o
           motivo REAL (`ia_disponibilidade().mensagem`). Sem `modules.inteligencia.view` o
           controller passa `analisesIa = null` e nada de IA aparece na aba. #}
        {% if analisesIa is not null and (analisesIa.totalMovimentacoes > 0 or analisesIa.temAnalise) %}
            {% set ia = ia_disponibilidade() %}
            {% if analisesIa.temEmAndamento %}
                {% set iaRotulo = 'pasta_push.processual.ia.analisando'|trans %}
            {% elseif analisesIa.ultimaConcluida is not null %}
                {% set iaRotulo = 'pasta_push.processual.ia.gerar_nova'|trans %}
            {% else %}
                {% set iaRotulo = 'pasta_push.processual.ia.resumir'|trans %}
            {% endif %}
            {% if analisesIa.ultimaConcluida is null %}
                {% set iaTitulo = 'pasta_push.processual.ia.dica_primeira'|trans %}
            {% elseif analisesIa.naoAnalisadas > 0 %}
                {% set iaTitulo = 'pasta_push.processual.ia.dica_nao_analisadas'|trans({n: analisesIa.naoAnalisadas ~ ''}) %}
            {% else %}
                {% set iaTitulo = 'pasta_push.processual.ia.dica_nova'|trans %}
            {% endif %}
            {% if ia.estaDisponivel %}
                <button type="button" class="ps-ia-gerar{{ analisesIa.temEmAndamento ? ' is-carregando' : '' }}"
                        title="{{ iaTitulo }}"
                        data-ia-gerar
                        data-ia-disponivel="1"
                        data-ia-solicitar-url="{{ path('inteligencia_push_solicitar', {id: pasta.id}) }}"
                        data-ia-token="{{ csrf_token('inteligencia_push_' ~ pasta.id) }}"
                        {{ analisesIa.temEmAndamento ? 'disabled' : '' }}>
                    <span class="ps-ia-gerar-ico" aria-hidden="true">✦</span><span class="ps-ia-gerar-rotulo">{{ iaRotulo }}</span>
                </button>
            {% else %}
                <button type="button" class="ps-ia-gerar ps-ia-gerar--indisponivel"
                        title="{{ ia.mensagem }}"
                        data-ia-gerar
                        data-ia-disponivel="0"
                        data-ia-motivo="{{ ia.value }}"
                        disabled aria-disabled="true">
                    <span class="ps-ia-gerar-ico" aria-hidden="true">✦</span><span class="ps-ia-gerar-rotulo">{{ ia.mensagem }}</span>
                </button>
            {% endif %}
        {% endif %}
        {# Filtros do desenho (dc L.2420, `pushFiltro`): Todas · Novas · Geram prazo. "Novas" = não
           lidas, que é o mesmo dado do selo da aba. "Geram prazo" é a regra FIXA do desenho sobre o
           tipo da comunicação (dc L.5414, `/Intima|Decis/`; PastaPushOutput::tipoGeraPrazo) — não
           calcula prazo nenhum (D-PRAZOS segue fora). O filtro roda no navegador (pasta-push.js) —
           a lista inteira já está na página.
           FPN-032: os filtros ficam à vista também com a lista vazia (dc L.2419-2421: o cabeçalho
           não depende de `push.vazio`). Sem lista, o clique só troca o botão ativo — o
           pasta-push.js não acha `.ps-push-lista` e o vazio da aba continua o que está na tela. #}
        {# P4f (desenho `procFiltros`, N:2546-2548 e N:5683): um chip por processo da pasta, antes de
           Todas/Novas/Geram prazo, e só com principal e ao menos um apensado. Filtra no navegador
           (pasta-push.js), antes do Todas/Novas/Geram prazo; o total do cabeçalho não muda. #}
        {% set filtrosProcessoPush = push.filtrosPorProcesso(pasta) %}
        {% if filtrosProcessoPush is not empty %}
            <div class="ps-push-procs" role="group" aria-label="{{ 'pasta_push.processual.filtros.por_processo'|trans }}">
                {% for filtroProc in filtrosProcessoPush %}
                    <button type="button" class="ps-push-proc{{ loop.first ? ' is-ativo' : '' }}"
                            data-push-proc-filtro="{{ filtroProc.chave }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                            title="{{ filtroProc.numero is null ? 'pasta_push.processual.filtros.todos_dica'|trans : 'pasta_push.processual.filtros.somente'|trans({numero: filtroProc.numero|numero_cnj}) }}">
                        {{- filtroProc.rotulo }} · {{ filtroProc.n -}}
                    </button>
                {% endfor %}
            </div>
        {% endif %}
        <div class="ps-push-filtros" role="group" aria-label="{{ 'pasta_push.processual.filtros.rotulo'|trans }}">
            <button type="button" class="ps-push-filtro is-ativo" data-push-filtro="todas" aria-pressed="true">{{ 'pasta_push.processual.filtros.todas'|trans }}</button>
            <button type="button" class="ps-push-filtro" data-push-filtro="novas" aria-pressed="false">{{ 'pasta_push.processual.filtros.novas'|trans }}</button>
            <button type="button" class="ps-push-filtro" data-push-filtro="prazo" aria-pressed="false">{{ 'pasta_push.processual.filtros.prazo'|trans }}</button>
        </div>
    </div>

    {# Análises da BlueJus IA logo abaixo do cabeçalho, acima da linha do tempo (dc L.2427). O
       fragmento é o mesmo que o `inteligencia_push_listar` devolve: o pasta-ia-push.js o troca
       inteiro depois do polling, sem F5. A faixa de aviso recebe o retorno do pedido. #}
    {% if analisesIa is not null %}
        <p class="ps-ia-msg" data-ia-msg role="status" hidden></p>
        {% include 'inteligencia/_analises_push.html.twig' with {analisesIa: analisesIa, pastaId: pasta.id} only %}
    {% endif %}

    {% if not push.temProcesso %}
        <div class="ps-push-vazio-linha" id="push-vazio-sem-processo">
            {{ 'pasta_push.processual.vazio.sem_processo'|trans }}
            {{ 'pasta_push.processual.vazio.sem_processo_como'|trans }}
            {# Atalho para aba oculta não é renderizado (ocultar aba): fica o texto, sem botão. #}
            {% if 'processo' not in abasOcultas|default([]) %}<button type="button" class="ps-push-link" data-ps-ir-aba="processo-tab">{{ 'pasta_push.processual.vazio.vincule'|trans }}</button>{% else %}{{ 'pasta_push.processual.vazio.vincule'|trans }}{% endif %}
            {{ 'pasta_push.processual.vazio.vincule_resto'|trans }}
        </div>
    {% elseif push.total == 0 %}
        <div class="ps-push-vazio-linha" id="push-vazio-sem-publicacao">
            {{ 'pasta_push.processual.vazio.sem_publicacao'|trans }}
            {{ 'pasta_push.processual.vazio.sem_publicacao_como'|trans }}
            {{ 'pasta_push.processual.vazio.sem_publicacao_oab'|trans }}
        </div>
    {% else %}
        {# Linha do tempo do desenho 1.2.3: pílula do dia quando a data muda, ponto na
           linha e um cartão por publicação. O cartão É o botão de sempre (`.ps-push-cab`,
           `aria-controls` + `data-push-url`): o pasta-show.js abre o teor no lugar.
           Documento do PJe, copiar ID, criar tarefa e marcar (não) lida moram no
           teor (`_push_teor`). A análise por IA mora acima da lista (BlueJus IA).
           Ficam de fora: encaminhar, monitoramento e avisos.

           A pílula do dia é "5 out 2026" (dc L.5372, `dataTxt`, N1), montada aqui a partir do
           "dd/mm/aaaa" que o DTO entrega; `data-push-dia` segue em dd/mm/aaaa porque é só a chave
           que o JS compara. O canto direito do cartão no desenho é a HORA (dc L.2531); o DJEN não
           dá hora e repetir a data da pílula era duplicata (N2), então o canto fica vazio.

           Toda linha leva a pílula do dia; a repetida (mesmo dia da anterior) sai
           escondida por `ps-push-dia--repetido`. Assim o filtro "Novas" pode
           esconder a primeira do dia sem levar a data junto: o pasta-push.js
           recalcula qual é a primeira VISÍVEL.

           O ponto e o cartão moram juntos em `.ps-push-cartao` (dc L.2511-2512,
           auditoria 2 U1): o ponto se mede pelo cartão, não pelo <li> que inclui a
           pílula do dia. O teor fica fora, irmão do wrapper, como sempre.

           O título do cartão é o trecho curto do teor, em caixa alta (dc L.2514/5378,
           `titulo: m.texto`; FPN-012): `textoResumo`, texto puro já cortado no DTO e
           escapado aqui. Sem teor, cai no órgão e depois no tipo, como era. O desenho
           não mostra o órgão no cartão; para não sumir com ele, o órgão fica na dica
           (`title`) da linha da fonte.

           A cor da pílula do tipo vem de `tipoComunicacao` (dc L.5365 `TT`, U3):
           Intimação vermelho, Decisão/Despacho/Sentença azul, Citação verde, o
           resto cinza. Comparação sem acento e sem caixa, pelo começo da palavra
           ("cita" solto pegaria "solicitação"). #}
        <ul class="ps-push-lista">
            {% set diaAnteriorPush = null %}
            {% set mesesPush = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez']|map(m => ('pasta_push.processual.meses.' ~ m)|trans) %}
            {% for item in push.itens %}
                {% set diaPush = item.dataDisponibilizacao ?? '' %}
                {% set partesDiaPush = diaPush|split('/') %}
                {% if partesDiaPush|length == 3 and partesDiaPush[1] matches '/^(0[1-9]|1[0-2])$/' %}
                    {% set diaPushTxt = (partesDiaPush[0] + 0) ~ ' ' ~ mesesPush[partesDiaPush[1] - 1] ~ ' ' ~ partesDiaPush[2] %}
                {% else %}
                    {% set diaPushTxt = diaPush ?: 'pasta_push.processual.cartao.sem_data'|trans %}
                {% endif %}
                {% set notasPush = push.notasDe(item) %}
                {% set processoDoPush = push.processoIdDaPublicacao(item, pasta) %}
                {# C6-FPN-04: o bloco de notas pende sob o cartão quando há nota (FPN-020) OU quando
                   quem está aqui pode criar uma (aí nasce vazio e escondido) — o "Adicionar nota
                   técnica" do botão direito abre o compositor ali, sem abrir o teor. #}
                {% set penduraNotasPush = notasPush is not empty or (pushPodeEscrever and processoDoPush is not null) %}
                <li class="ps-push-item{{ item.lida ? '' : ' ps-push-item--nova' }}"
                    data-push-id="{{ item.id }}" data-push-dia="{{ diaPush }}"
                    data-push-lida-url="{{ path('pasta_push_lida', {id: pasta.id, publicacaoId: item.id}) }}"
                    {#- C6-FPN-03: o texto inteiro do teor para o "Copiar texto" do menu, por uma rota
                        que NÃO marca como lida (o cartão fica como está). #}
                    data-push-texto-url="{{ path('pasta_push_texto', {id: pasta.id, publicacaoId: item.id}) }}"
                    data-push-gera-prazo="{{ push.geraPrazo(item) ? '1' : '0' }}"
                    data-push-proc="{{ push.chaveDoProcesso(item) }}"
                    data-push-aceita-nota="{{ pushPodeEscrever and push.aceitaNotaTecnica(item) ? '1' : '0' }}">
                    <div class="ps-push-dia{{ loop.first or diaPush != diaAnteriorPush ? '' : ' ps-push-dia--repetido' }}"><span class="ps-push-dia-pilula">{{ diaPushTxt }}</span></div>
                    {% set diaAnteriorPush = diaPush %}
                    {% set tipoPush = (item.tipoComunicacao ?? '')|lower|replace({'ç': 'c', 'ã': 'a', 'á': 'a', 'â': 'a', 'é': 'e', 'ê': 'e', 'í': 'i', 'ó': 'o', 'õ': 'o', 'ú': 'u'})|trim %}
                    {% if tipoPush starts with 'intima' %}
                        {% set tipoPushMod = 'intimacao' %}
                    {% elseif tipoPush starts with 'decis' or tipoPush starts with 'despacho' or tipoPush starts with 'senten' %}
                        {% set tipoPushMod = 'decisao' %}
                    {% elseif tipoPush starts with 'citac' %}
                        {% set tipoPushMod = 'citacao' %}
                    {% else %}
                        {% set tipoPushMod = 'outro' %}
                    {% endif %}
                    {# Cor do ponto por quem praticou o ato (dc L.5365 `COR`, L.5375; FPN-019). Juízo
                       (decisão, despacho, sentença, mandado, acórdão) em azul; o resto é ato de
                       cartório/servidor, em vermelho — no desenho, o que tem documento e não é do
                       juízo cai em "cartório", e toda publicação do DJEN é um documento. Polo ativo
                       (verde) e passivo (laranja) não se deduzem do tipo e ficam sem uso; o cinza
                       ("movimentação sem documento") não existe no DJEN. #}
                    {% if tipoPush starts with 'decis' or tipoPush starts with 'despacho' or tipoPush starts with 'senten' or tipoPush starts with 'mandado' or tipoPush starts with 'acordao' %}
                        {% set pontoPushMod = 'juizo' %}
                        {% set pontoPushDica = 'pasta_push.processual.cartao.ponto_juizo'|trans %}
                    {% else %}
                        {% set pontoPushMod = 'cartorio' %}
                        {% set pontoPushDica = 'pasta_push.processual.cartao.ponto_cartorio'|trans %}
                    {% endif %}
                    <div class="ps-push-cartao">
                        <span class="ps-push-ponto ps-push-ponto--{{ pontoPushMod }}" title="{{ pontoPushDica }}" aria-hidden="true"></span>
                        {# A dica só onde o item existe (FPN-014c): prometer a nota e recusar depois de
                           abrir o cartão (e marcá-lo como lido) era o defeito. #}
                        <button type="button" class="ps-push-cab"
                                {% if pushPodeEscrever and push.aceitaNotaTecnica(item) %}title="{{ 'pasta_push.processual.cartao.dica_nota'|trans }}"{% endif %}
                                aria-expanded="false"
                                aria-controls="push-teor-{{ item.id }}"
                                data-push-url="{{ path('pasta_push_teor', penduraNotasPush ? {id: pasta.id, publicacaoId: item.id, penduradas: 1} : {id: pasta.id, publicacaoId: item.id}) }}">
                            <span class="ps-push-assunto">
                                <i class="bi bi-megaphone-fill" aria-hidden="true"></i>
                                <span class="ps-push-assunto-txt">{{ item.textoResumo ?: (item.nomeOrgao ?: (item.tipoComunicacao ?? 'pasta_push.processual.cartao.publicacao'|trans)) }}</span>
                                {% if not item.lida %}<span class="ps-push-novo" title="{{ 'pasta_push.processual.cartao.nao_lida'|trans }}">{{ 'pasta_push.processual.cartao.novo'|trans }}</span>{% endif %}
                            </span>
                            <span class="ps-push-corpo">
                                <span class="ps-push-titulo ps-push-titulo--{{ tipoPushMod }}">{{ item.tipoComunicacao ?? 'pasta_push.processual.cartao.publicacao'|trans }}</span>
                                {# P4f (N:5483): movimentação de apensado ganha " · Apensado · {Tipo} {número}"
                                   na fonte; o número sai do meio para não aparecer duas vezes. #}
                                {% set apensadoPush = push.apensadoDaPublicacao(item, pasta) %}
                                <span class="ps-push-meta"{% if item.nomeOrgao and item.textoResumo %} title="{{ item.nomeOrgao }}"{% endif %}>
                                    {{- item.siglaTribunal -}}
                                    {%- if push.numeroUnico is null and item.numeroProcessoExibicao and apensadoPush is null %} · {{ item.numeroProcessoExibicao }}{% endif %} · {{ 'pasta_push.processual.cartao.djen'|trans }}
                                    {%- if apensadoPush %} · {{ 'pasta_push.processual.cartao.apensado'|trans({tipo: apensadoPush.tipo, numero: apensadoPush.numero|numero_cnj}) }}{% endif %}
                                </span>
                                <i class="bi bi-chevron-down ps-push-seta" aria-hidden="true"></i>
                            </span>
                        </button>
                    </div>
                    <div class="ps-push-teor" id="push-teor-{{ item.id }}" hidden></div>
                    {# FPN-020 (dc L.2534-2551, `m.temNotas`): as notas técnicas desta movimentação
                       penduradas sob o cartão, à vista com o teor FECHADO — ler a nota não abre o
                       teor (que marcaria a publicação como lida). Fica depois do teor: aberto, ele é
                       o corpo do cartão, e a nota segue pendurada no conjunto. É o mesmo bloco do teor
                       e da aba Processo (`#notas-publicacao-<id>`, com o compositor para quem
                       escreve), então o teor, avisado por `penduradas=1`, não o repete. Fora do
                       `.ps-push-cartao` de propósito: o botão direito ali é o menu da movimentação,
                       e aqui é o ⋮ da nota (nota-tecnica.js). O processo do compositor é o da
                       PUBLICAÇÃO (FPN-020b), não o da primeira nota: a movimentação pode ter
                       notas antigas de outro processo da pasta, e a nota nova iria para ele. Sem
                       processo da pasta que case com o número, o bloco só mostra (sem compositor).
                       A mesma nota também está na aba Processo: aqui os ids levam `-push` (o
                       canônico fica lá, que é o destino da âncora da @menção).
                       C6-FPN-04: sem nota, para quem escreve, o bloco vem vazio e escondido
                       (`ocultoSeVazio`); o pasta-push.js o mostra com o teor aberto (onde o bloco do
                       teor morava) ou com o compositor aberto, e o esconde de novo quando nada disso
                       vale. O link do teor leva `penduradas=1` também nesse caso: o id é único. #}
                    {% if penduraNotasPush %}
                        {{ include('processo/_notas_tecnicas.html.twig', {
                            notas: notasPush,
                            processoId: processoDoPush ?? (notasPush|first).processoId,
                            publicacaoId: item.id,
                            pastaId: pasta.id,
                            mostrarMovimentacao: false,
                            podeEscreverNota: pushPodeEscrever and processoDoPush is not null,
                            idSufixoNota: '-push',
                            ocultoSeVazio: true,
                        }) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {# Botão direito no cartão (dc L.5394 `ctx`, README L.125-127; FPN-014). UM menu para a
           lista inteira, preenchido pelo pasta-push.js com o cartão clicado. Cada item aciona o
           que JÁ existe no teor: o "Adicionar nota técnica" do bloco de notas, o "Criar tarefa"
           (modal de nova meta), o "Marcar como (não) lida" (POST `pasta_push_lida`, mesma URL e
           mesmo CSRF do botão do teor; a URL vem no <li>, o token aqui) e o "Abrir documento"
           (o link do PJe da linha do documento do teor), e a cópia do texto. Ordem do desenho
           (dc L.5385): tarefa, encaminhar, lida, documento. "Encaminhar via Chat I.A" (FPN-016, dc
           L5641) só com a Central na página: o pasta-push.js dispara `bj-central:despachar` com o id
           do cartão clicado (tipo `push`). Fica de fora o link externo (FPN-015). Teclado e toque
           seguem pelos botões do teor, como antes. #}
        <div class="ps-push-menu" id="pushMenuContexto" role="menu" aria-label="{{ 'pasta_push.processual.menu.rotulo'|trans }}"
             data-lida-token="{{ csrf_token('pasta_push_lida_' ~ pasta.id) }}" hidden>
            <div class="ps-push-menu-titulo"></div>
            {% if pushPodeEscrever %}
                {# Some por cartão (data-push-aceita-nota="0"), junto com o separador dele. #}
                <button type="button" class="ps-push-menu-item js-push-menu-nota" role="menuitem">
                    <i class="bi bi-journal-plus" aria-hidden="true"></i><span>{{ 'pasta_push.processual.menu.nota'|trans }}</span>
                </button>
                <div class="ps-push-menu-sep js-push-menu-sep-nota" role="separator"></div>
                <button type="button" class="ps-push-menu-item js-push-menu-tarefa" role="menuitem">
                    <i class="bi bi-check2-square" aria-hidden="true"></i><span>{{ 'pasta_push.processual.menu.tarefa'|trans }}</span>
                </button>
            {% endif %}
            {% if pushPastaViva and central_disponivel() %}
                <button type="button" class="ps-push-menu-item js-push-menu-encaminhar" role="menuitem" data-encaminhar-pasta="{{ pasta.id }}">
                    <i class="bi bi-send" aria-hidden="true"></i><span>{{ 'pasta_push.processual.menu.encaminhar'|trans }}</span>
                </button>
            {% endif %}
            {% if pushPastaViva %}
                {# Rótulo e ícone trocados pelo JS conforme a linha esteja nova ou lida. #}
                <button type="button" class="ps-push-menu-item js-push-menu-lida" role="menuitem">
                    <i class="bi bi-envelope-open" aria-hidden="true"></i><span class="js-push-menu-lida-rotulo">{{ 'pasta_push.processual.menu.marcar_lida'|trans }}</span>
                </button>
            {% endif %}
            <button type="button" class="ps-push-menu-item js-push-menu-documento" role="menuitem">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>{{ 'pasta_push.processual.menu.documento'|trans }}</span>
            </button>
            <div class="ps-push-menu-sep" role="separator"></div>
            <button type="button" class="ps-push-menu-item js-push-menu-copiar" role="menuitem">
                <i class="bi bi-clipboard" aria-hidden="true"></i><span>{{ 'pasta_push.processual.menu.copiar'|trans }}</span>
            </button>
        </div>
        {# Texto do desenho para o filtro que não sobra nada (`vazioTxt`, dc L.5426). #}
        <div class="ps-push-vazio-linha ps-push-vazio-filtro" id="push-vazio-filtro" hidden>{{ 'pasta_push.processual.vazio.filtro'|trans }}</div>
        {% if push.limiteAtingido %}
            <p class="ps-push-teto">
                {{ 'pasta_push.processual.teto.exibindo'|trans({total: push.total ~ ''}) }}
                {% if push.numeroUnico and can_access_module('djen') %}
                    <a href="{{ path('push_processual_index', {busca: push.numeroUnico}) }}">{{ 'pasta_push.processual.teto.ver_todas'|trans }}</a>.
                {% endif %}
            </p>
        {% endif %}
    {% endif %}
</section>
{% if pushPainel is defined and pushPainel is not null %}
    {% include 'pasta/_push_painel.html.twig' with {pasta: pasta, painel: pushPainel, avisos: pushAvisos ?? null, podeEditarPasta: podeEditarPasta} only %}
{% endif %}
</div>
{# Modal "Enviar ao cliente" da Análise IA (P4c, spec push-avisar-cliente §3): fora da grade de duas
   colunas (é `position: fixed`); o cartão "Avisar cliente" da coluna fornece os e-mails. #}
{% if pushPainel is defined and pushPainel is not null %}
    {% set avisarClienteModal = avisar_cliente(pasta.id) %}
    {% if avisarClienteModal is not null %}
        {% include 'pasta/_push_cliente_modal.html.twig' with {pasta: pasta, cliente: avisarClienteModal} only %}
    {% endif %}
{% endif %}
{# Filtro, selo da aba, copiar ID, marcar (não) lida, criar tarefa a partir da publicação e o
   menu do botão direito no cartão. Os textos dele, do pasta-push-painel.js e do pasta-push-cliente.js
   vêm do catálogo (`pasta_push.js`, spec idioma-do-sistema, "A Pasta, aba Push"). #}
{{ catalogo_js('pasta_push.js') -}}
<script src="{{ asset('js/pasta-push.js') }}" defer></script>
{% if analisesIa is not null %}
    {# BlueJus IA: pedir, acompanhar (polling 2 s), recarregar a lista e as ações de cada análise. #}
    <link rel="stylesheet" href="{{ asset('css/pasta-ia.css') }}">
    <script src="{{ asset('js/pasta-ia-push.js') }}" defer></script>
{% endif %}
