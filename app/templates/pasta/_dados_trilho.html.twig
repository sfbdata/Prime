{# ============================================================================
   Aba Dados — trilho da direita.
   Desenho aprovado: docs/design/claude-design-2026-10-05 (1)/
   ("02 - EXPEDIENTES 1.2.3.dc.html", padrão PJe). Spec: docs/specs/trilha-a-visual-pje.md (A4).

   Ordem aprovada: Próximos prazos · Clientes · Documentos.
   O cartão "Financeiro do caso" saiu na revisão de 28/08 do desenho: o
   financeiro vive na aba dele, e repetir valor da causa e média aqui criava
   dois lugares para o mesmo número.
   O trilho existe para responder "em que pé está o caso" SEM clicar aba por
   aba — era a queixa nº 3 do handoff.

   Cabeçalho dos cartões no padrão PJe: faixa cinza, título 13.5/700, contagem
   em pílula azul e o chevron › que leva à aba (botão, não link morto).

   Contexto: `pasta`, `proximosPrazos`, `unidadeCobrada`, `abasOcultas` (ids das abas ocultas para quem vê).
   ============================================================================ #}

{# Alto do trilho: Ação, Processo vinculado e Cobrança (saíram do cabeçalho, como o desenho). #}
{{ include('pasta/_dados_trilho_topo.html.twig') }}

{# ── Próximos prazos ──────────────────────────────────────────────────────
   Prazos e audiências registrados à mão e metas abertas com prazo, do mais próximo ao mais distante
   (PastaPrazoOutput::daPasta, E12b). Meta sem prazo não entra: não tem lugar numa lista ordenada por data. #}
{% set podeEditarPasta = podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit') %}
{% set podeRegistrarPrazo = podeEditarPasta and not pasta.estaExcluida %}
{# Os prazos são da aba Metas: com ela oculta, o cartão e a janela somem (spec pasta-ocultar-aba §5;
   as rotas `pasta_prazo_*` também recusam). Idem o cartão Documentos com a aba Documentos oculta. #}
{% set abasOcultas = abasOcultas|default([]) %}
{% if 'tarefas' not in abasOcultas %}
<section class="ps-card" data-trilho="prazos"
         data-url-prazos="{{ path('pasta_prazo_salvar', {id: pasta.id}) }}"
         data-csrf-prazos="{{ csrf_token('pasta_prazos_' ~ pasta.id) }}">
    <div class="ps-card-cab">
        <h2>Próximos prazos</h2>
        {# Contagem = todos os itens (dc `prazosN`), a lista mostra os 8 primeiros. #}
        <span class="ps-contagem">{{ proximosPrazos|length }}</span>
        <span class="ps-cab-espaco"></span>
        {% if podeRegistrarPrazo %}
            <button type="button" class="ps-card-cab-link ps-card-cab-mais js-prazo-novo"
                    title="Adicionar prazo ou audiência" aria-label="Adicionar prazo ou audiência"><i class="bi bi-plus-lg"></i></button>
        {% endif %}
        <button type="button" class="ps-card-cab-link" data-ps-ir-aba="tarefas-tab"
                title="Abrir metas em aberto" aria-label="Abrir metas em aberto"><i class="bi bi-chevron-right"></i></button>
    </div>
    {% if proximosPrazos|length == 0 %}
        <div class="ps-prazos-vazio">Nenhum prazo ou audiência. Use + para registrar ou aguarde a leitura do Push processual.</div>
    {% else %}
        {# ⋮ por prazo (dc L.6557-6559): nos prazos registrados à mão, "Marcar como cumprido", "Editar" e "Excluir"
           primeiro; depois "Ver nas metas", "Alertar <primeiro nome>" (só metas: o responsável do prazo manual é texto
           livre, sem colaborador para alertar), "Adicionar à agenda (.ics)" e "Copiar". O botão direito na linha
           abre o mesmo menu. "Alertar" é o MESMO POST do sino das Metas (`tarefa_alertar`), com a mesma guarda.
           "Encaminhar via Chat I.A" (D:6561) vem logo depois de "Ver nas metas": só ids em `data-*` (meta = Tarefa.id,
           prazo registrado = PastaPrazo.id), disparo no pasta-prazos.js; só com a Central e fora da lápide. #}
        {% set podeAlertarPrazo = can_access_module('tarefas') and podeEditarPasta and not pasta.estaExcluida %}
        {% set encaminharPrazo = not pasta.estaExcluida and central_disponivel() ? pasta.id : null %}
        {% for prazo in proximosPrazos|slice(0, 8) %}
            {% set tarefaDoPrazo = prazo.tarefaId ? pasta.tarefas|filter(t => t.id == prazo.tarefaId)|first : null %}
            {% set alertaveisDoPrazo = podeAlertarPrazo and tarefaDoPrazo
                ? tarefaDoPrazo.responsaveis.toArray|filter(r => app.user is null or r.id != app.user.id)
                : [] %}
            {% set chave = prazo.prazoId ? 'm' ~ prazo.prazoId : prazo.tarefaId %}
            {# Calculado do Push (docs/specs/prazo-do-push.md): a origem e o selo "confira" vêm do catálogo. #}
            {% set metaDoPrazo = prazo.push ? prazo.meta ~ ' · ' ~ 'pasta_dados.prazos.origem_push'|trans : prazo.meta %}
            <div class="ps-linha ps-prazo" data-prazo-id="{{ prazo.tarefaId }}"{% if prazo.prazoId and prazo.manual %} data-prazo-manual="{{ prazo.prazoId }}"{% endif %}>
                <span class="ps-pip ps-pip--{{ prazo.tom }}"></span>
                <div class="ps-linha-corpo">
                    <div class="ps-linha-titulo">
                        {% if prazo.tarefaId %}<a href="{{ path('tarefa_show', {id: prazo.tarefaId}) }}">{{ prazo.titulo }}</a>{% else %}{{ prazo.titulo }}{% endif %}
                    </div>
                    <div class="ps-linha-meta">{{ metaDoPrazo }}{% if prazo.push %} <span class="ps-prazo-calculado{{ prazo.podeSerEmDobro ? ' ps-prazo-calculado--dobro' }}" title="{{ (prazo.podeSerEmDobro ? 'pasta_dados.prazos.selo_push_dobro_dica' : 'pasta_dados.prazos.selo_push_dica')|trans }}">{{ (prazo.podeSerEmDobro ? 'pasta_dados.prazos.selo_push_dobro' : 'pasta_dados.prazos.selo_push')|trans }}</span>{% endif %}</div>
                </div>
                <span class="ps-selo ps-selo--{{ prazo.tom }}">{{ prazo.selo }}</span>
                <div class="ps-pop-wrap ps-prazo-mais-wrap">
                    <button type="button" class="ps-prazo-mais" data-ps-pop="psPrazoMenu{{ chave }}"
                            aria-haspopup="menu" aria-expanded="false" aria-controls="psPrazoMenu{{ chave }}"
                            title="Mais opções" aria-label="Mais opções do prazo"><i class="bi bi-three-dots-vertical"></i></button>
                    <div class="ps-pop ps-pop--menu ps-pop--prazo" id="psPrazoMenu{{ chave }}" role="menu">
                        <div class="ps-pop-secao ps-prazo-menu-titulo" title="{{ prazo.titulo }}">{{ prazo.titulo }}</div>
                        {% if prazo.prazoId and (prazo.manual or prazo.push) and podeRegistrarPrazo %}
                            <button type="button" class="ps-pop-item js-prazo-cumprir" role="menuitem"
                                    data-url="{{ path('pasta_prazo_cumprir', {id: pasta.id, prazoId: prazo.prazoId}) }}">
                                <i class="bi bi-check2-circle"></i><span>Marcar como cumprido</span>
                            </button>
                            {# O calculado do Push só se cumpre: editar e excluir são do manual. #}
                            {% if prazo.manual %}
                            <button type="button" class="ps-pop-item js-prazo-editar" role="menuitem"
                                    data-prazo-id="{{ prazo.prazoId }}" data-tipo="{{ prazo.tipo }}"
                                    data-titulo="{{ prazo.descricao }}" data-data="{{ prazo.dataIso }}"
                                    data-hora="{{ prazo.hora }}" data-responsavel="{{ prazo.responsavel }}">
                                <i class="bi bi-pencil"></i><span>Editar</span>
                            </button>
                            <button type="button" class="ps-pop-item js-prazo-excluir" role="menuitem"
                                    data-url="{{ path('pasta_prazo_excluir', {id: pasta.id, prazoId: prazo.prazoId}) }}">
                                <i class="bi bi-trash3"></i><span>Excluir</span>
                            </button>
                            {% endif %}
                            <div class="ps-pop-sep"></div>
                        {% endif %}
                        <button type="button" class="ps-pop-item" role="menuitem" data-ps-ir-aba="tarefas-tab">
                            <i class="bi bi-check2-square"></i><span>Ver nas metas</span>
                        </button>
                        {% if encaminharPrazo and (prazo.tarefaId or prazo.prazoId) %}
                            <button type="button" class="ps-pop-item js-prazo-encaminhar" role="menuitem"
                                    data-encaminhar-pasta="{{ encaminharPrazo }}"
                                    data-encaminhar-tipo="{{ prazo.tarefaId ? 'meta' : 'prazo' }}"
                                    data-encaminhar-id="{{ prazo.tarefaId ?: prazo.prazoId }}">
                                <i class="bi bi-send"></i><span>Encaminhar via Chat I.A</span>
                            </button>
                        {% endif %}
                        {% for r in alertaveisDoPrazo %}
                            <form method="post" action="{{ path('tarefa_alertar', {id: prazo.tarefaId}) }}" class="ps-prazo-alertar">
                                <input type="hidden" name="_token" value="{{ csrf_token('alertar_tarefa_' ~ prazo.tarefaId) }}">
                                <input type="hidden" name="usuario" value="{{ r.id }}">
                                <button type="submit" class="ps-pop-item" role="menuitem" title="Alertar {{ r.fullName }} para verificar a meta">
                                    <i class="bi bi-bell"></i><span>Alertar {{ r.fullName|split(' ')|first }}</span>
                                </button>
                            </form>
                        {% endfor %}
                        <div class="ps-pop-sep"></div>
                        {% if prazo.dataIso %}
                            <button type="button" class="ps-pop-item js-prazo-ics" role="menuitem"
                                    data-ics-uid="{{ prazo.prazoId ? 'prazo-' ~ prazo.prazoId : 'meta-' ~ prazo.tarefaId }}"
                                    data-ics-dia="{{ prazo.dataIso|replace({'-': ''}) }}"
                                    data-ics-titulo="{{ prazo.titulo|e('html_attr') }}"
                                    data-ics-responsavel="{{ (prazo.responsavel ?? '')|e('html_attr') }}"
                                    data-ics-pasta="{{ pasta.nup|e('html_attr') }}">
                                <i class="bi bi-calendar-plus"></i><span>Adicionar à agenda (.ics)</span>
                            </button>
                        {% endif %}
                        <button type="button" class="ps-pop-item js-ps-copiar" role="menuitem"
                                data-ps-copiar="{{ (prazo.titulo ~ ' · ' ~ prazo.selo ~ ' · ' ~ metaDoPrazo ~ ' · Pasta ' ~ pasta.nup)|e('html_attr') }}"
                                data-ps-copiado="Prazo copiado">
                            <i class="bi bi-clipboard"></i><span>Copiar</span>
                        </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</section>

{# Janela "Novo prazo ou audiência" / "Editar prazo" (dc L.2908-2926): 420px, cabeçalho azul, Prazo ou Audiência,
   descrição, data, hora, responsável. pasta-prazos.js abre, preenche e envia. #}
{% if podeRegistrarPrazo %}
<div class="ps-pz-fundo" id="psPrazoJanela" hidden>
    <div class="ps-pz" role="dialog" aria-modal="true" aria-labelledby="psPrazoTitulo">
        <div class="ps-pz-cab"><i class="bi bi-calendar-event" aria-hidden="true"></i><b id="psPrazoTitulo">Novo prazo ou audiência</b>
            <button type="button" class="ps-pz-x js-pz-fechar" aria-label="Fechar"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <div class="ps-pz-corpo">
            <div class="ps-pz-tipos" role="radiogroup" aria-label="Tipo">
                <button type="button" class="ps-pz-tipo js-pz-tipo" data-tipo="prazo" role="radio"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Prazo</button>
                <button type="button" class="ps-pz-tipo js-pz-tipo" data-tipo="audiencia" role="radio"><i class="bi bi-people" aria-hidden="true"></i>Audiência</button>
            </div>
            <label class="ps-pz-campo">DESCRIÇÃO<input type="text" id="psPzTitulo" maxlength="255" placeholder="Ex.: Protocolar contestação" autocomplete="off"></label>
            <div class="ps-pz-linha">
                <label class="ps-pz-campo ps-pz-campo--data">DATA<input type="date" id="psPzData"></label>
                <label class="ps-pz-campo ps-pz-campo--hora">HORA<span class="js-pz-hora-opc"> (opcional)</span><input type="time" id="psPzHora"></label>
            </div>
            <label class="ps-pz-campo">RESPONSÁVEL<input type="text" id="psPzResp" maxlength="120" placeholder="Nome do responsável" autocomplete="off"></label>
            <div class="ps-pz-nota"><i class="bi bi-info-circle" aria-hidden="true"></i> Prazos do Push processual e das Metas entram sozinhos nesta lista.</div>
            <div class="ps-pz-erro" id="psPzErro" role="alert"></div>
            <div class="ps-pz-rodape">
                <button type="button" class="ps-pz-btn ps-pz-btn--cinza js-pz-fechar">Cancelar</button>
                <button type="button" class="ps-pz-btn ps-pz-btn--azul js-pz-salvar">Salvar</button>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endif %}

{# ── Clientes ─────────────────────────────────────────────────────────────
   O miolo (#clientesList, .cliente-linha, o bloco #clientesOutros dos "outros") é o mesmo
   entregue em 26/08 e é contrato com o JS de vincular/desvincular/principal do
   show.html.twig. Aqui ele só mudou de lugar e de estilo.

   As três ações da linha (tornar principal, abrir ficha, desvincular) NÃO estão
   no desenho, que mostra apenas "abrir". Ficaram: tirá-las apagaria o único
   caminho de desvincular cliente e de trocar o principal — e é o principal que
   define a Média por CPF. Divergência deliberada, reportada.

   L7: o ícone de cadastro (completo/incompleto) e a janela "Detalhes do
   cliente" — clique no ícone ou botão direito na linha. A janela é um fragmento
   (`cliente_resumo`); a URL vai aqui com id 0 e o pasta-clientes.js troca pelo
   data-cliente-id da linha, para valer também na linha que o JS do show cria
   ao vincular sem recarregar. #}
{# Busca inline (desenho L.1357-1372, regra em L.3304): o + abre o campo "Nome ou
   CPF do cliente" no PRÓPRIO cartão, como no desenho — antes abria o modal.
   O modal #modalAdicionarCliente segue no show (é contrato) e é para onde leva
   "Cadastrar cliente": é ele que cadastra E vincula numa tacada só.
   A busca é a mesma `pasta_clientes_buscar` (com `incluirVinculados=1`, para o
   selo "Já vinculado") e o vínculo é o mesmo `pasta_cliente_vincular`, com o
   MESMO id de token CSRF do modal. O documento chega MASCARADO do servidor; só
   vem inteiro quando o que se digitou é o documento inteiro.
   C6-PMC-03: o "+", a busca e as ações da linha (estrela, lixeira) só para quem o
   servidor deixaria usá-las — vincular, tornar principal e desvincular pedem EDIT
   na pasta (PastaController) e a lápide recusa todo POST. Mesma regra do PAS-049. #}
{% set podeEditarPasta = podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit') %}
{% set podeMexerNoCliente = podeEditarPasta and not pasta.estaExcluida %}
<section class="ps-card ps-clientes" data-trilho="clientes"
         data-resumo-url="{{ path('cliente_resumo', {id: 0}) }}"
         data-pasta-id="{{ pasta.id }}">
    <div class="ps-card-cab">
        <h2>Clientes</h2>
        {% if pasta.clientes|length > 0 %}
            <span class="ps-contagem">{{ pasta.clientes|length }}</span>
        {% endif %}
        <span class="ps-cab-espaco"></span>
        {% if podeMexerNoCliente %}
            <button type="button" class="ps-card-cab-add js-ps-vinc-abrir" title="Vincular cliente" aria-label="Vincular cliente"
                    aria-expanded="false" aria-controls="psVincCliente"><i class="bi bi-plus-lg"></i></button>
        {% endif %}
    </div>

    {% if podeMexerNoCliente %}
        <div class="ps-vinc" id="psVincCliente" hidden
             data-busca-url="{{ path('pasta_clientes_buscar', {id: pasta.id}) }}"
             data-vincular-url="{{ path('pasta_cliente_vincular', {id: pasta.id}) }}"
             data-vincular-token="{{ csrf_token('pasta_cliente_vincular_' ~ pasta.id) }}">
            <div class="ps-vinc-campo">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="ps-vinc-input" autocomplete="off"
                       placeholder="Nome ou CPF do cliente" aria-label="Buscar cliente por nome ou CPF">
            </div>
            <div class="ps-vinc-resultados" role="listbox" aria-label="Clientes encontrados"></div>
            <div class="ps-vinc-vazio" hidden>
                <i class="bi bi-person-x" aria-hidden="true"></i>
                <span class="ps-vinc-vazio-texto">Cliente ainda não cadastrado.</span>
                <button type="button" class="ps-vinc-cadastrar js-ps-vinc-cadastrar"
                        data-bs-toggle="modal" data-bs-target="#modalAdicionarCliente"><i class="bi bi-person-plus"></i>Cadastrar cliente</button>
            </div>
            <div class="ps-vinc-erro" role="alert" hidden></div>
        </div>
    {% endif %}

    {# `data-nome-cliente`: o JS do show remonta o vazio deste bloco (abaixo) ao desvincular o último cliente. #}
    <div id="clientesList" data-nome-cliente="{{ pasta.nomeCliente }}">
        {% set clientePrincipal = pasta.clientePrincipal %}
        {% set idsDuplicados = pasta_clientes_duplicados(pasta) %}
        {% if pasta.clientes|length > 0 %}
            {% set outros = pasta.clientes|filter(c => not clientePrincipal or c.id != clientePrincipal.id) %}

            {# Todos listados direto, principal primeiro (desenho 1.2.3, dc L.1376-1389;
               auditoria 2 D2) — nao ha mais "mostrar outros N". O principal fica FORA
               da area que rola, para nunca sumir; os demais rolam em 232px.
               `#clientesOutros` segue como id do bloco dos demais: e contrato do JS
               de vincular e dos testes. #}
            {% if clientePrincipal %}
                <div class="cliente-principal">
                    {{ include('pasta/_cliente_linha.html.twig', {
                        pasta: pasta, cliente: clientePrincipal, ehPrincipal: true, podeMexerNoCliente: podeMexerNoCliente, cpfDuplicado: clientePrincipal.id in idsDuplicados,
                    }) }}
                </div>
            {% endif %}

            {% if outros|length > 0 %}
                <div class="clientes-outros ps-clientes-rolagem" id="clientesOutros">
                    {% for cliente in outros %}
                        {{ include('pasta/_cliente_linha.html.twig', {
                            pasta: pasta, cliente: cliente, ehPrincipal: false, podeMexerNoCliente: podeMexerNoCliente, cpfDuplicado: cliente.id in idsDuplicados,
                        }) }}
                    {% endfor %}
                </div>
            {% endif %}
        {% elseif pasta.nomeCliente %}
            {# Texto solto, sem cadastro: NÃO há documento para mostrar. Imprimir um
               rótulo "CPF" vazio aqui seria inventar dado. Em produção este é o
               estado de 1.152 das 1.201 pastas — não é caso de borda. #}
            <div id="clientesPlaceholder" class="ps-cliente">
                <i class="bi bi-person-circle" style="color: var(--ps-faint)"></i>
                <span class="ps-cliente-nome flex-grow-1">{{ pasta.nomeCliente }}</span>
                <span class="ps-selo ps-selo--tranquilo">não vinculado</span>
            </div>
        {% else %}
            <div id="clientesPlaceholder" class="ps-vazio">
                <i class="bi bi-person-circle"></i>
                <div class="ps-vazio-titulo">Nenhum cliente vinculado</div>
                <div class="ps-vazio-nota">Vincule o cliente para calcular a média por CPF.</div>
            </div>
        {% endif %}
    </div>
</section>

{# ── Documentos ───────────────────────────────────────────────────────────
   Três itens e o atalho para a aba, como o desenho pede. A lista completa mora
   na aba Documentos; repeti-la aqui só empurraria o trilho para fora da vista.
   O ícone é o do TIPO do arquivo (PDF vermelho, Word azul…), via `arquivo_icone`:
   família e cores do Guia visual, as mesmas da aba Documentos; a cor sai pela classe
   `ps-doc-icone--<tipo>` (tokens com par escuro no pasta-show.css), nunca inline. #}
{# O contrato de honorários some com o Financeiro oculto (regra `documentoVisivel`, ocultar aba). #}
{% set docsDoCartao = abasDaPasta is defined and abasDaPasta ? pasta.documentos|filter(d => abasDaPasta.documentoVisivel(d.categoria)) : pasta.documentos %}
{% set docsRecentes = docsDoCartao|sort((a, b) => b.carregadoEm <=> a.carregadoEm)|slice(0, 3) %}
{% if 'documentos' not in abasOcultas %}
<section class="ps-card" data-trilho="documentos">
    <div class="ps-card-cab">
        <h2>Documentos</h2>
        {% if docsDoCartao|length > 0 %}
            <span class="ps-contagem">{{ docsDoCartao|length }}</span>
        {% endif %}
        <span class="ps-cab-espaco"></span>
        <button type="button" class="ps-card-cab-link" data-ps-ir-aba="documentos-tab"
                title="Abrir todos os documentos" aria-label="Abrir todos os documentos"><i class="bi bi-chevron-right"></i></button>
    </div>
    {% if docsRecentes|length == 0 %}
        <div class="ps-vazio">
            <i class="bi bi-paperclip"></i>
            <div class="ps-vazio-titulo">Nenhum documento</div>
            <div class="ps-vazio-nota">Envie arquivos pela aba Documentos.</div>
        </div>
    {% else %}
        {# Clicar abre o pré-visualizador — o MESMO gesto da aba Documentos, e o
           mesmo modal (#previewDocModal), que já traz o botão Baixar no rodapé.
           O `data-bs-toggle` do Bootstrap basta aqui: o handler delegado do
           gerenciador de arquivos escuta só dentro dele. #}
        {% for doc in docsRecentes %}
            {% set icone = arquivo_icone(doc.nomeOriginal, doc.mimeType ?? '') %}
            <a class="ps-doc"
               href="{{ path('pasta_documento_view', {id: doc.id}) }}"
               target="_blank" rel="noopener noreferrer"
               data-bs-toggle="modal" data-bs-target="#previewDocModal"
               data-url="{{ path('pasta_documento_view', {id: doc.id}) }}"
               data-nome="{{ doc.nomeOriginal|e('html_attr') }}"
               data-mime="{{ doc.mimeType|e('html_attr') }}">
                <span class="ps-doc-icone ps-doc-icone--{{ icone.tipo }}" title="{{ icone.rotulo }}"><i class="bi {{ icone.icone }}"></i></span>
                <span class="ps-linha-corpo">
                    <span class="ps-doc-nome" title="{{ doc.titulo }}">{{ doc.titulo }}</span>
                    <span class="ps-doc-meta">{{ doc.tamanhoBytes|formatar_bytes }} · {{ doc.carregadoEm|date('d/m/Y') }}</span>
                </span>
            </a>
        {% endfor %}
    {% endif %}
</section>
{% endif %}

{# Comportamento do L7 (janela do cliente, copiar, .ics). Fica no parcial do
   trilho, e não no show, porque é só o trilho que precisa dele; `defer` o faz
