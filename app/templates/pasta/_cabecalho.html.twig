{# ============================================================================
   Cabeçalho da pasta — comum a todas as abas.
   Desenho aprovado: docs/design/claude-design-2026-10-05 (1)/
   ("02 - EXPEDIENTES 1.2.3.dc.html", padrão PJe — substitui a "Pasta 1A").
   Spec da entrega: docs/specs/trilha-a-visual-pje.md (A2, A3).

   Três linhas:
     1. Voltar · PASTA nnnn · prioridade · etiquetas · (espaço) · setas ‹ › · ⋮;
     2. o CLIENTE como título (ícone de pessoa, nome, "Movimentado…", documento)
        e a faixa de dados (Processo vinculado · Ação · Responsável [· Cobrança]);
     3. abas no padrão PJe, com a Situação (Ativo / Arquivado) à direita.

   As ações (Editar dados, Histórico, Vincular processo, Trocar responsável,
   Copiar link, Arquivar/Desarquivar, Excluir) vivem no menu ⋮, com a tarja azul
   do desenho. O que o desenho mostra e o sistema ainda não tem (Duplicar, Mover
   carteira, Timeline inteligente, Link do Push, Imprimir, Acompanhar, Favoritos,
   Cadeado, Cadastro, Intelligence, foto do cliente, "N de M") NÃO é renderizado:
   item inerte ensina o usuário a desconfiar do menu inteiro.

   Contexto: `pasta`, `fotosResponsaveis`, `vizinhas`, `push`, `unidadeCobrada`.
   ============================================================================ #}
{% set proc = pasta.processoPrincipal %}
{% set cliente = pasta.clientePrincipal %}
{# O documento sai do CADASTRO, nunca do texto legado: pasta sem cliente vinculado
   não tem CPF/CNPJ para mostrar — é o estado de 1.152 das 1.201 pastas em produção. #}
{% set documento = cliente ? (cliente.cpf is defined ? cliente.cpf : (cliente.cnpj is defined ? cliente.cnpj : null)) : null %}
{% set eAtiva = pasta.situacao == 'ativo' %}

<header class="ps-card ps-cabecalho">

    {# ── Linha 1 ─────────────────────────────────────────────────────────── #}
    <div class="ps-cab-linha1">
        <div class="ps-cab-identidade">
            <a href="{{ path('expediente_index') }}" class="ps-btn ps-btn--voltar ps-cab-voltar" title="Voltar à lista de pastas">
                <i class="bi bi-arrow-left"></i><span>Voltar</span>
            </a>

            <span class="ps-cab-nup">PASTA <span class="ps-num">{{ pasta.nup }}</span></span>

            <div class="ps-cab-sep"></div>

            <div class="ps-pop-wrap">
                <button type="button"
                        class="ps-prio ps-prio--{{ pasta.prioridade.value }} pasta-prioridade-btn"
                        title="Alterar prioridade"
                        data-ps-pop="psPrioridade"
                        aria-haspopup="true" aria-expanded="false"
                        data-pasta-id="{{ pasta.id }}"
                        data-csrf="{{ csrf_token('pasta_prioridade_' ~ pasta.id) }}"
                        data-url="{{ path('pasta_alterar_prioridade', {id: pasta.id}) }}">
                    <i class="bi bi-flag-fill"></i>
                    <span class="ps-prio-label">{{ pasta.prioridadeLabel }}</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="ps-pop ps-pop--prio" id="psPrioridade" role="menu">
                    {% for opcao in ['normal', 'prioridade', 'urgente'] %}
                        <button type="button" class="ps-pop-item prioridade-opt" role="menuitem" data-valor="{{ opcao }}">
                            <i class="bi bi-flag-fill"></i>
                            <span>{{ opcao == 'normal' ? 'Normal' : (opcao == 'prioridade' ? 'Prioridade' : 'Urgente') }}</span>
                            <span class="ps-pop-check{{ pasta.prioridade.value == opcao ? '' : ' d-none' }}">&check;</span>
                        </button>
                    {% endfor %}
                </div>
            </div>

            <div class="ps-cab-sep"></div>

            {% for marcador in pasta.marcadores %}
                <button type="button" class="ps-etiqueta js-etiqueta-abrir" title="Editar marcadores da pasta">
                    <i class="bi bi-tag-fill"></i>{{ marcador.nome }}
                </button>
            {% endfor %}

            {# O "+" das etiquetas: só ícone, quadrado tracejado (desenho). O contrato
               com o JS das etiquetas (`.js-mover-para` + data-*) é o mesmo da lista. #}
            <button type="button" class="ps-etiqueta-add js-mover-para"
                    title="Marcadores da pasta" aria-label="Marcadores da pasta"
                    data-pasta-id="{{ pasta.id }}"
                    data-pasta-nome="{{ pasta.nup }}"
                    data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                    data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}">
                <i class="bi bi-plus"></i>
            </button>
        </div>

        {# ── Navegar entre pastas ─────────────────────────────────────────────
           Percorrem o acervo do escritório na ordem da lista do Expediente
           (número decrescente): ‹ é a linha de cima e › a de baixo. Na ponta do
           acervo a seta vira `<span>` inerte em vez de sumir: botão que aparece
           e some conforme a pasta faz o olho procurar. O rótulo diz o nome e o
           número de destino porque "anterior" num acervo ordenado do maior para
           o menor é ambíguo sem ele. #}
        <nav class="ps-cab-nav" aria-label="Navegar entre pastas do acervo">
            {% if vizinhas.anteriorId %}
                <a href="{{ path('pasta_show', {id: vizinhas.anteriorId}) }}"
                   class="ps-btn ps-btn--seta" data-nav="anterior"
                   title="{{ vizinhas.rotuloAnterior }}" aria-label="{{ vizinhas.rotuloAnterior }}">
                    <i class="bi bi-chevron-left"></i>
                </a>
            {% else %}
                <span class="ps-btn ps-btn--seta ps-btn--inerte" data-nav="anterior" aria-disabled="true"
                      title="{{ vizinhas.rotuloAnterior }}" aria-label="{{ vizinhas.rotuloAnterior }}">
                    <i class="bi bi-chevron-left"></i>
                </span>
            {% endif %}
            {% if vizinhas.proximaId %}
                <a href="{{ path('pasta_show', {id: vizinhas.proximaId}) }}"
                   class="ps-btn ps-btn--seta" data-nav="proxima"
                   title="{{ vizinhas.rotuloProxima }}" aria-label="{{ vizinhas.rotuloProxima }}">
                    <i class="bi bi-chevron-right"></i>
                </a>
            {% else %}
                <span class="ps-btn ps-btn--seta ps-btn--inerte" data-nav="proxima" aria-disabled="true"
                      title="{{ vizinhas.rotuloProxima }}" aria-label="{{ vizinhas.rotuloProxima }}">
                    <i class="bi bi-chevron-right"></i>
                </span>
            {% endif %}
        </nav>

        <div class="ps-cab-acoes">
            {% if pasta.estaExcluida %}
            {# Pasta riscada é somente-leitura: arquivar e editar sairiam do ar no servidor de
               qualquer jeito (PastaSomenteLeituraListener), mas botão que existe e não funciona
               é pior que botão ausente. Ficam o caminho de volta e o histórico — é lá que está
               o registro de quem excluiu e quando. #}
            <form method="post" action="{{ path('pasta_restaurar', {id: pasta.id}) }}"
                  onsubmit="return confirm('Restaurar a pasta {{ pasta.nup|e('js') }}?');">
                <input type="hidden" name="_token" value="{{ csrf_token('restaurar_pasta_' ~ pasta.id) }}">
                <button type="submit" class="ps-btn" title="Restaurar pasta excluída">
                    <i class="bi bi-arrow-counterclockwise"></i><span>Restaurar</span>
                </button>
            </form>
            <button type="button" class="ps-btn" id="psHistoricoAbrir"
                    title="Histórico do sistema"
                    aria-controls="psHistorico" aria-expanded="false">
                <i class="bi bi-clock-history"></i><span>Histórico</span>
            </button>
            {% else %}
            <div class="ps-pop-wrap">
                <button type="button" class="ps-btn ps-btn--icone ps-cab-mais" title="Mais ações"
                        data-ps-pop="psMenuAcoes" aria-haspopup="true" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="ps-pop ps-pop--menu" id="psMenuAcoes" role="menu">
                    <div class="ps-pop-tarja"><i class="bi bi-folder2-open"></i>Pasta {{ pasta.nup }}</div>

                    {# Os atalhos E e H são do desenho; quem os escuta é o pasta-show.js
                       (`data-ps-atalho`), com o menu aberto. #}
                    <button type="button" class="ps-pop-item" role="menuitem" data-ps-atalho="e"
                            title="Editar dados (E)"
                            data-bs-toggle="modal" data-bs-target="#modalEditarPasta">
                        <i class="bi bi-pencil"></i><span>Editar dados</span><kbd class="ps-pop-atalho">E</kbd>
                    </button>
                    {# O histórico automático do sistema vive no drawer; o botão mantém o id
                       que o pasta-show.js procura. #}
                    <button type="button" class="ps-pop-item" role="menuitem" data-ps-atalho="h"
                            id="psHistoricoAbrir" title="Histórico (H)"
                            aria-controls="psHistorico" aria-expanded="false">
                        <i class="bi bi-clock-history"></i><span>Histórico</span><kbd class="ps-pop-atalho">H</kbd>
                    </button>
                    <button type="button" class="ps-pop-item" role="menuitem"
                            data-bs-toggle="modal" data-bs-target="#modalVincularProcesso">
                        <i class="bi bi-link-45deg"></i><span>Vincular processo</span>
                    </button>
                    <button type="button" class="ps-pop-item" role="menuitem" id="psMenuTrocarResponsavel">
                        <i class="bi bi-person-gear"></i><span>Trocar responsável</span>
                    </button>

                    <div class="ps-pop-sep"></div>
                    <div class="ps-pop-secao">Compartilhar</div>
                    {# Copiar link é real: a URL desta pasta vai para a área de transferência. #}
                    <button type="button" class="ps-pop-item js-copiar-link" role="menuitem"
                            data-link="{{ url('pasta_show', {id: pasta.id}) }}">
                        <i class="bi bi-link"></i><span class="js-copiar-link-rotulo">Copiar link da pasta</span>
                    </button>

                    <div class="ps-pop-sep"></div>
                    {# Mesma troca de situação da pílula ao lado das abas, por outro caminho. #}
                    <button type="button" class="ps-pop-item js-situacao-opt js-situacao-alternar" role="menuitem"
                            data-situacao="{{ eAtiva ? 'arquivado' : 'ativo' }}">
                        <i class="bi {{ eAtiva ? 'bi-archive' : 'bi-box-arrow-up' }}"></i>
                        <span class="js-situacao-alternar-rotulo">{{ eAtiva ? 'Arquivar' : 'Desarquivar' }} pasta</span>
                    </button>
                    {# O confirm() nativo fica: trocá-lo por modal é frente própria
                       (63 deles no projeto), registrada no README do redesenho. #}
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          onsubmit="return confirm('Tem certeza que deseja excluir a pasta {{ pasta.nup|e('js') }}?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <button type="submit" class="ps-pop-item ps-pop-item--perigo" role="menuitem">
                            <i class="bi bi-trash3"></i><span>Excluir pasta</span>
                        </button>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {% if pasta.estaExcluida %}
    {# A faixa existe porque a pasta riscada continua abrindo normalmente: sem ela, quem chega
       pelo link não tem como saber por que os botões sumiram. #}
    <div class="ps-cab-excluida" role="status">
        <i class="bi bi-trash3"></i>
        <span>
            <strong>Pasta excluída</strong>
            em {{ pasta.excluidaEm|date('d/m/Y') }} às {{ pasta.excluidaEm|date('H:i') }}
            {%- if pasta.excluidaPor %} por {{ pasta.excluidaPor.fullName }}{% endif %}.
            Ela continua aqui porque o número {{ pasta.nup }} não pode ser reaproveitado —
            já existem pastas posteriores. Somente leitura até ser restaurada.
        </span>
    </div>
    {% endif %}

    {# ── Linha 2: o cliente é o título ───────────────────────────────────── #}
    {# `nomeCliente` é o IDENTIFICADOR da pasta (decisão do dono, 01/09/2026): é ele
       que vira o título quando não há cliente cadastrado — o estado real de quase
       todas as pastas. O ícone de pessoa não é clicável: a foto do cliente é função
       nova e botão sem função é mentira na tela. #}
    <div class="ps-cab-cliente">
        <span class="ps-cab-cliente-icone" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
        <div class="ps-cab-cliente-corpo">
            <div class="ps-cab-cliente-linha">
                <h1 class="ps-cab-titulo">
                    {%- if cliente -%}
                        {{ cliente.nomeExibicao }}
                    {%- elseif pasta.nomeCliente -%}
                        {{ pasta.nomeCliente }}
                    {%- else -%}
                        <span class="ps-dado--vazio">Cliente não informado</span>
                    {%- endif -%}
                </h1>
                {# É o mesmo dado que a faixa chamava de "Última movimentação" (a última
                   alteração da pasta); só mudou de lugar e de formato, como no desenho. #}
                {% if pasta.modificadoEm %}
                    <span class="ps-cab-mov" data-campo="movimentacao"
                          title="Última movimentação: {{ pasta.modificadoEm|date('d/m/Y H:i') }}">
                        <span class="ps-cab-mov-ponto" aria-hidden="true"></span>
                        {%- if pasta.modificadoEm|date('Y-m-d') == 'now'|date('Y-m-d') -%}
                            Movimentado hoje, {{ pasta.modificadoEm|date('H:i') }}
                        {%- else -%}
                            Movimentado em {{ pasta.modificadoEm|date('d/m/Y') }}
                        {%- endif -%}
                    </span>
                {% endif %}
            </div>
            {% if documento %}
                <span class="ps-cab-doc ps-num">{{ documento|documento_br_rotulo }} {{ documento|documento_br }}</span>
            {% elseif cliente is null and pasta.nomeCliente %}
                <span class="ps-cab-doc ps-cab-doc--aviso">não vinculado ao cadastro de clientes</span>
            {% endif %}
        </div>
    </div>

    {# ── Faixa de dados: Processo vinculado · Ação · Responsável [· Cobrança] ── #}
    <div class="ps-cab-dados">
        <div class="ps-cab-dado" data-campo="processo">
            <p class="ps-rotulo"><i class="bi bi-diagram-3"></i>Processo vinculado</p>
            {% if proc %}
                <p class="ps-dado ps-dado--forte ps-num">
                    <a href="{{ path('processo_show', {id: proc.id}) }}" title="Abrir processo">{{ proc.numeroProcesso|numero_cnj }}</a>
                    <i class="bi bi-copy copy-btn ps-copiar" role="button" data-copy="{{ proc.numeroProcesso }}" title="Copiar"></i>
                </p>
                {% if proc.classeProcessual or proc.siglaTribunal %}
                    <div class="ps-dado-sub">
                        {{- proc.classeProcessual -}}
                        {%- if proc.classeProcessual and proc.siglaTribunal %} · {% endif -%}
                        {{- proc.siglaTribunal -}}
                    </div>
                {% endif %}
                {% set outros = pasta.pastaProcessos|filter(pp => pp.processo.id != proc.id) %}
                <div class="ps-cab-proc-acoes">
                    <button type="button" class="ps-link-btn" data-ps-ir-aba="processo-tab" title="Ir à aba Processo">
                        <i class="bi bi-arrow-left-right"></i>trocar
                    </button>
                    {# O sistema não tem "tipo de apenso": o chip conta os OUTROS processos
                       vinculados à pasta e abre a lista deles. #}
                    {% if outros|length > 0 %}
                        <button type="button" class="ps-chip-vinc" data-ps-toggle="psProcessosVinculados"
                                aria-expanded="false" aria-controls="psProcessosVinculados"
                                title="Outros processos vinculados a esta pasta">
                            <i class="bi bi-paperclip"></i>{{ outros|length }} vinculado{{ outros|length > 1 ? 's' : '' }}<i class="bi bi-chevron-down"></i>
                        </button>
                    {% endif %}
                </div>
                {% if outros|length > 0 %}
                    <div class="ps-cab-vinculados" id="psProcessosVinculados" hidden>
                        {% for pp in outros %}
                            {% set outro = pp.processo %}
                            <div class="ps-cab-vinculado">
                                <div class="ps-rotulo ps-rotulo--mini"><i class="bi bi-link-45deg"></i>Vinculado</div>
                                <a class="ps-num ps-dado--forte" href="{{ path('processo_show', {id: outro.id}) }}" title="Abrir processo vinculado">{{ outro.numeroProcesso|numero_cnj }}</a>
                                {% if outro.classeProcessual or outro.siglaTribunal %}
                                    <div class="ps-dado-sub">
                                        {{- outro.classeProcessual -}}
                                        {%- if outro.classeProcessual and outro.siglaTribunal %} · {% endif -%}
                                        {{- outro.siglaTribunal -}}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                <p class="ps-dado ps-dado--vazio">Nenhum processo.
                    <button type="button" class="ps-link-btn" data-bs-toggle="modal" data-bs-target="#modalVincularProcesso">vincular</button>
                </p>
            {% endif %}
        </div>

        <div class="ps-cab-dado" data-campo="acao">
            <p class="ps-rotulo"><i class="bi bi-bank2"></i>Ação</p>
            {%- if pasta.nomeAcao -%}
                <p class="ps-dado ps-dado--forte">{{ pasta.nomeAcao }}</p>
            {%- elseif proc and (proc.classeProcessual or proc.assuntoProcessual) -%}
                <p class="ps-dado ps-dado--medio" title="Extraído do processo vinculado">{{ proc.classeProcessual ?: proc.assuntoProcessual }}</p>
            {%- elseif proc -%}
                <p class="ps-dado ps-dado--vazio">Não informada</p>
            {%- else -%}
                {# Sem processo a ação não tem de onde vir — o desenho convida a vincular. #}
                <p class="ps-dado ps-dado--vazio ps-cab-acao-vazia">Vincule um processo para definir</p>
            {%- endif -%}
        </div>

        <div class="ps-cab-dado" data-campo="responsavel">
            <p class="ps-rotulo"><i class="bi bi-person-badge"></i>Responsável</p>
            {# O chip é o mesmo do Expediente: mostrar avatar + nome como o desenho
               pede E continuar trocando o responsável sem sair da tela. #}
            {{ include('pasta/_resp_chip.html.twig', {
                pasta: pasta,
                fotos: fotosResponsaveis|default({}),
            }) }}
        </div>

        {# Atalho para a UNIDADE cobrada — espelho do link "Pasta judicial" que a tela da unidade já
           oferece. O desenho é omisso sobre ele; o sistema já o tinha, então fica (convenção da casa).

           ⚠️ Some para quem não tem o módulo `cobrancas`: a tela de destino tem gate de módulo, e
           oferecer o link a quem seria recusado é pior que não oferecer. #}
        {% if unidadeCobrada|default(null) and can_access_module('cobrancas') %}
            <div class="ps-cab-dado" data-campo="cobranca">
                <p class="ps-rotulo"><i class="bi bi-cash-coin"></i>Cobrança</p>
                <p class="ps-dado ps-dado--forte ps-num">
                    <a href="{{ path('cobranca_objeto_show', {id: unidadeCobrada.objetoId}) }}"
                       title="Abrir a unidade cobrada">{{ unidadeCobrada.identificacao }}</a>
                </p>
                {% if unidadeCobrada.credor %}
                    <div class="ps-dado-sub">{{ unidadeCobrada.credor }}</div>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {# ── Linha 3: abas (padrão PJe, desenho 1.2.3) ──────────────────────── #}
    {# Contagens SEMPRE do dado, nunca literais — foi bug corrigido duas vezes na
       revisão do desenho. Metas e Documentos exibem o total; Push exibe só as NÃO
       LIDAS (é o que o desenho mostra: lida a publicação, o selo cai). Os `id`
       seguem os antigos porque o pasta-arquivos.js chama bootstrap.Tab em
       `#documentos-tab` depois do upload; renomear aqui quebraria aquele retorno
       em silêncio.

       Pendência (a linha vermelha sob a aba) só existe com dado REAL por trás —
       ver `PastaPendenciasOutput`. #}
    {# As pendências vêm PRONTAS do servidor (`PastaPendenciasOutput`): a tela não decide
       nada, só mostra. Metas = meta não concluída; Processo = nenhum processo vinculado;
       Financeiro = contrato pendente sem pró-bono (+ pagamentos vencidos); Push = não lidas. #}
    {% set pushNaoLidas = push.naoLidas|default(0) %}
    {% set abas = [
        {id: 'dados',      painel: 'dados',      rotulo: 'Dados da pasta', icone: 'bi-folder2-open',  contagem: null},
        {id: 'tarefas',    painel: 'tarefas',    rotulo: 'Metas',          icone: 'bi-check2-square', contagem: pasta.tarefas|length},
        {id: 'processo',   painel: 'processo',   rotulo: 'Processo',       icone: 'bi-bank',          contagem: null},
        {id: 'financeiro', painel: 'financeiro', rotulo: 'Financeiro',     icone: 'bi-cash-coin',     contagem: null},
        {id: 'detalhes',   painel: 'detalhes',   rotulo: 'Detalhes',       icone: 'bi-info-circle',   contagem: null},
        {id: 'documentos', painel: 'documentos', rotulo: 'Documentos',     icone: 'bi-paperclip',     contagem: pasta.documentos|length},
        {id: 'push',       painel: 'push',       rotulo: 'Push Processual', icone: 'bi-broadcast',     contagem: pushNaoLidas},
    ] %}
    <div class="ps-abas-faixa">
        {# `ps-abas--sem-js` sai no boot do pasta-show.js. Sem JS o sublinhado nunca
           é medido, e sem esta classe a aba ativa ficaria sem marca nenhuma. #}
        <div class="ps-abas ps-abas--sem-js" id="pastaTabs" role="tablist">
            <div class="ps-abas-ind" aria-hidden="true"></div>
            {% for aba in abas %}
                {% set pend = pendencias.porAba[aba.id]|default(null) %}
                <button class="ps-aba{{ loop.first ? ' active' : '' }}{{ pend ? ' ps-aba--pend' : '' }}"
                        id="{{ aba.id }}-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#{{ aba.painel }}"
                        type="button" role="tab"
                        aria-controls="{{ aba.painel }}"
                        aria-selected="{{ loop.first ? 'true' : 'false' }}"
                        title="{{ aba.rotulo }}{% if pend %} · {{ pend.txt }}{% endif %}">
                    {# A barra some na aba ativa (CSS, pela classe `.active` que o
                       Bootstrap alterna): quem está olhando a aba já vê a pendência. #}
                    {% if pend %}<span class="ps-aba-pend" aria-hidden="true"></span>{% endif %}
                    <i class="bi {{ aba.icone }}"></i>
                    <span>{{ aba.rotulo }}</span>
                    {% if aba.contagem %}<span class="ps-aba-badge ps-num">{{ aba.contagem }}</span>{% endif %}
                </button>
            {% endfor %}
        </div>

        {# ── Situação: pílula à direita das abas ──
           Menu com as duas situações que o sistema tem (Ativo, Arquivado); Suspenso e
           Cancelado são função nova e não aparecem. A pílula é o `#btn-alternar-status`
           de sempre (url, csrf, situação atual): o script da tela escuta as opções e
           dispara a mesma troca que o botão "Arquivar" fazia. Pasta excluída é
           somente-leitura: a pílula vira só um selo, sem menu. #}
        {% if not pasta.estaExcluida %}
            <div class="ps-situacao-wrap ps-pop-wrap">
                <button type="button"
                        id="btn-alternar-status"
                        class="ps-situacao-pill ps-situacao-pill--{{ eAtiva ? 'ativo' : 'arquivado' }}"
                        title="Situação da pasta: {{ eAtiva ? 'Ativo' : 'Arquivado' }}"
                        data-ps-pop="psSituacao"
                        aria-haspopup="menu" aria-expanded="false"
                        data-pasta-id="{{ pasta.id }}"
                        data-situacao-atual="{{ pasta.situacao }}"
                        data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}"
                        data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}">
                    <span class="ps-situacao-ponto" aria-hidden="true"></span>
                    <span class="ps-situacao-label">{{ eAtiva ? 'Ativo' : 'Arquivado' }}</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="ps-pop ps-pop--situacao" id="psSituacao" role="menu">
                    <div class="ps-pop-tarja"><i class="bi bi-toggles"></i>Situação da pasta</div>
                    {% for opcao in [
                        {v: 'ativo',     rotulo: 'Ativo',     desc: 'Pasta em andamento'},
                        {v: 'arquivado', rotulo: 'Arquivado', desc: 'Sai das listas de trabalho'},
                    ] %}
                        <button type="button" class="ps-pop-item ps-pop-item--situacao js-situacao-opt"
                                role="menuitemradio" aria-checked="{{ pasta.situacao == opcao.v ? 'true' : 'false' }}"
                                data-situacao="{{ opcao.v }}">
                            <span class="ps-situacao-ponto ps-situacao-ponto--{{ opcao.v }}" aria-hidden="true"></span>
                            <span class="ps-pop-item-corpo">
                                <span class="ps-pop-item-titulo">{{ opcao.rotulo }}</span>
                                <span class="ps-pop-item-desc">{{ opcao.desc }}</span>
                            </span>
                            <i class="bi bi-check2 ps-pop-check{{ pasta.situacao == opcao.v ? '' : ' d-none' }}"></i>
                        </button>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="ps-situacao-wrap">
                <span class="ps-situacao-pill ps-situacao-pill--{{ eAtiva ? 'ativo' : 'arquivado' }}" title="Situação da pasta">
                    <span class="ps-situacao-ponto" aria-hidden="true"></span>
                    <span class="ps-situacao-label">{{ eAtiva ? 'Ativo' : 'Arquivado' }}</span>
                </span>
            </div>
        {% endif %}
    </div>
</header>
