{# ============================================================================
   Cabeçalho da pasta — comum a todas as abas.
   Desenho aprovado: docs/design/claude-design-2026-10-05 (1)/
   ("02 - EXPEDIENTES 1.2.3.dc.html", padrão PJe — substitui a "Pasta 1A").
   Spec da entrega: docs/specs/trilha-a-visual-pje.md (A2, A3).

   Três linhas:
     1. Voltar · PASTA nnnn · prioridade · etiquetas · (espaço) · setas ‹ › · ⋮;
     2. o CLIENTE como título (ícone de pessoa, nome, "Movimentado…", documento)
        o andamento com o carimbo da situação (a antiga faixa de dados saiu: Responsável no topo, o resto no trilho);
     3. abas no padrão PJe, com o botão Cadastro (ponto de pendências) e a
        Situação (Ativo / Arquivado) à direita.

   As ações (Editar dados, Histórico, Timeline inteligente, Duplicar, Vincular
   processo, Trocar responsável, Copiar link, Imprimir resumo, Fixar nos
   favoritos, Arquivar/Desarquivar, Excluir) vivem no menu ⋮, com a tarja azul
   do desenho. O que o desenho mostra e o sistema ainda não tem (Mover carteira,
   Acompanhar, Cadeado, Intelligence, foto do cliente) NÃO é
   renderizado: item inerte ensina o usuário a desconfiar do menu inteiro.
   "Fixar nos favoritos" (seção Preferências) é real: POST
   `pasta_favorito_alternar`.

   Pasta arquivada, suspensa ou cancelada ganha o selo carimbado da situação sobre a
   faixa de dados (desenho, `seloEl`); o ATIVO bate e some ao abrir a pasta ativa.

   Contexto: `pasta`, `fotosResponsaveis`, `vizinhas`, `push`, `unidadeCobrada`.
   ============================================================================ #}
{% set proc = pasta.processoPrincipal %}
{% set cliente = pasta.clientePrincipal %}
{# O documento sai do CADASTRO, nunca do texto legado: pasta sem cliente vinculado
   não tem CPF/CNPJ para mostrar — é o estado de 1.152 das 1.201 pastas em produção. #}
{% set documento = cliente ? (cliente.cpf is defined ? cliente.cpf : (cliente.cnpj is defined ? cliente.cnpj : null)) : null %}
{% set eAtiva = pasta.situacao == 'ativo' %}
{% set eArquivada = pasta.situacao == 'arquivado' %}
{# PAS-014: controle de escrita só para quem o servidor deixaria usar — a MESMA decisão do
   `denyResourceAccessUnlessGranted` de cada rota (editar, prioridade, situação, responsável e
   vincular processo pedem EDIT; excluir e restaurar pedem DELETE). O servidor continua
   recusando: isto é só a tela não oferecer o que vai dar "sem permissão". Calculado uma vez:
   o show já decide `podeEditarPasta` (PAS-047) e repassa; a função só roda se o parcial vier
   sozinho. #}
{% set podeEditarPasta  = podeEditarPasta is defined ? podeEditarPasta : can_access_resource('pasta', pasta.id, 'edit') %}
{% set podeExcluirPasta = can_access_resource('pasta', pasta.id, 'delete') %}

<header class="ps-card ps-cabecalho">

    {# ── Linha 1 ─────────────────────────────────────────────────────────── #}
    <div class="ps-cab-linha1">
        <div class="ps-cab-identidade">
            <a href="{{ path('expediente_index') }}" class="ps-btn ps-btn--voltar ps-cab-voltar" title="Voltar à lista de pastas">
                <i class="bi bi-arrow-left"></i><span>Voltar</span>
            </a>

            {# dc 1052 (auditoria 2 C5): "PASTA" e o número são itens do inline-flex
               (6px no CSS); o espaço entre eles só existe para o texto copiado. #}
            <span class="ps-cab-nup"><span>PASTA</span> <span class="ps-num">{{ pasta.nup }}</span></span>

            {# Divisoria · prioridade · divisoria · etiquetas · "+": o grupo do desenho. #}
            <div class="ps-cab-etiquetas">
            <div class="ps-cab-sep"></div>

            {% if podeEditarPasta %}
            <div class="ps-pop-wrap">
                <button type="button"
                        class="ps-prio ps-prio--{{ pasta.prioridade.value }} pasta-prioridade-btn"
                        title="Alterar prioridade"
                        data-ps-pop="psPrioridade"
                        aria-haspopup="true" aria-expanded="false"
                        data-pasta-id="{{ pasta.id }}"
                        data-csrf="{{ csrf_token('pasta_prioridade_' ~ pasta.id) }}"
                        data-url="{{ path('pasta_alterar_prioridade', {id: pasta.id}) }}">
                    <i class="bi bi-flag-fill"></i>
                    <span class="ps-prio-label">{{ pasta.prioridadeLabel }}</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="ps-pop ps-pop--prio" id="psPrioridade" role="menu">
                    {% for opcao in ['normal', 'prioridade', 'urgente'] %}
                        <button type="button" class="ps-pop-item prioridade-opt" role="menuitem" data-valor="{{ opcao }}">
                            <i class="bi bi-flag-fill"></i>
                            <span>{{ opcao == 'normal' ? 'Normal' : (opcao == 'prioridade' ? 'Prioridade' : 'Urgente') }}</span>
                            <span class="ps-pop-check{{ pasta.prioridade.value == opcao ? '' : ' d-none' }}">&check;</span>
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% else %}
            {# Sem EDIT: o selo mostra a prioridade, sem menu para trocá-la. #}
            <span class="ps-prio ps-prio--{{ pasta.prioridade.value }}" title="Prioridade">
                <i class="bi bi-flag-fill"></i>
                <span class="ps-prio-label">{{ pasta.prioridadeLabel }}</span>
            </span>
            {% endif %}

            <div class="ps-cab-sep"></div>

            {% for marcador in pasta.marcadores %}
                {# A cor cadastrada do marcador tinge o chip (desenho); sem cor, cinza neutro. #}
                <button type="button" class="ps-etiqueta js-etiqueta-abrir{{ marcador.cor ? ' ps-etiqueta--cor' : '' }}"
                        title="Editar marcadores da pasta"{% if marcador.cor %} style="--etq: {{ marcador.cor|e('html_attr') }}"{% endif %}>
                    <i class="bi bi-tag-fill"></i>{{ marcador.nome }}
                </button>
            {% endfor %}

            {# O "+" das etiquetas: só ícone, quadrado tracejado (desenho). O contrato
               com o JS das etiquetas (`.js-mover-para` + data-*) é o mesmo da lista. #}
            <button type="button" class="ps-etiqueta-add js-mover-para"
                    title="Marcadores da pasta" aria-label="Marcadores da pasta"
                    data-pasta-id="{{ pasta.id }}"
                    data-pasta-nome="{{ pasta.nup }}"
                    data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                    data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}">
                <i class="bi bi-plus"></i>
            </button>
            </div>
        </div>

        {# ── Navegar entre pastas ─────────────────────────────────────────────
           Percorrem o acervo do escritório na ordem da lista do Expediente
           (número decrescente): ‹ é a linha de cima e › a de baixo. Na ponta do
           acervo a seta vira `<span>` inerte em vez de sumir: botão que aparece
           e some conforme a pasta faz o olho procurar. O rótulo diz o nome e o
           número de destino porque "anterior" num acervo ordenado do maior para
           o menor é ambíguo sem ele. #}
        {# Responsável na linha de cima (desenho 1.2.3, `toggleResp`): o mesmo chip de sempre, que troca o
           responsável sem sair da tela. #}
        <div class="ps-cab-resp" data-campo="responsavel">
            {# O chip é o mesmo do Expediente: mostrar avatar + nome como o desenho
               pede E continuar trocando o responsável sem sair da tela. #}
            {{ include('pasta/_resp_chip.html.twig', {
                pasta: pasta,
                fotos: fotosResponsaveis|default({}),
            }) }}
        </div>

        <nav class="ps-cab-nav" aria-label="Navegar entre pastas do acervo">
            {% if vizinhas.anteriorId %}
                <a href="{{ path('pasta_show', {id: vizinhas.anteriorId}) }}"
                   class="ps-btn ps-btn--seta" data-nav="anterior"
                   title="{{ vizinhas.rotuloAnterior }}" aria-label="{{ vizinhas.rotuloAnterior }}">
                    <i class="bi bi-chevron-left"></i>
                </a>
            {% else %}
                <span class="ps-btn ps-btn--seta ps-btn--inerte" data-nav="anterior" aria-disabled="true"
                      title="{{ vizinhas.rotuloAnterior }}" aria-label="{{ vizinhas.rotuloAnterior }}">
                    <i class="bi bi-chevron-left"></i>
                </span>
            {% endif %}
            {# "N de M" (desenho 1.2.3): a linha da pasta na lista do Expediente, mesma ordem
               e mesmo conjunto das setas. Aparece sempre que a posição é conhecida — inclusive
               "1 de 1": as setas não somem na ponta, o contador também não. #}
            {% if vizinhas.total %}
                <span class="ps-cab-pos">{{ vizinhas.posicao }} de {{ vizinhas.total }}</span>
            {% endif %}
            {% if vizinhas.proximaId %}
                <a href="{{ path('pasta_show', {id: vizinhas.proximaId}) }}"
                   class="ps-btn ps-btn--seta" data-nav="proxima"
                   title="{{ vizinhas.rotuloProxima }}" aria-label="{{ vizinhas.rotuloProxima }}">
                    <i class="bi bi-chevron-right"></i>
                </a>
            {% else %}
                <span class="ps-btn ps-btn--seta ps-btn--inerte" data-nav="proxima" aria-disabled="true"
                      title="{{ vizinhas.rotuloProxima }}" aria-label="{{ vizinhas.rotuloProxima }}">
                    <i class="bi bi-chevron-right"></i>
                </span>
            {% endif %}
        </nav>

        <div class="ps-cab-acoes">
            {% if pasta.estaExcluida %}
            {# Pasta riscada é somente-leitura: arquivar e editar sairiam do ar no servidor de
               qualquer jeito (PastaSomenteLeituraListener), mas botão que existe e não funciona
               é pior que botão ausente. Ficam o caminho de volta e o histórico — é lá que está
               o registro de quem excluiu e quando. #}
            {% if podeExcluirPasta %}
            {# PAS-034b: a pergunta é a janela da tela (`confirmarPs`, pasta-dialogos.js), não o
               `confirm` do navegador; o script no fim deste parcial segura o envio até a resposta. #}
            <form method="post" action="{{ path('pasta_restaurar', {id: pasta.id}) }}"
                  class="js-restaurar-pasta" data-nup="{{ pasta.nup }}">
                <input type="hidden" name="_token" value="{{ csrf_token('restaurar_pasta_' ~ pasta.id) }}">
                <button type="submit" class="ps-btn" title="Restaurar pasta excluída">
                    <i class="bi bi-arrow-counterclockwise"></i><span>Restaurar</span>
                </button>
            </form>
            {% endif %}
            <button type="button" class="ps-btn" id="psHistoricoAbrir"
                    title="Histórico do sistema"
                    aria-controls="psHistorico" aria-expanded="false">
                <i class="bi bi-clock-history"></i><span>Histórico</span>
            </button>
            {% else %}
            <div class="ps-pop-wrap">
                <button type="button" class="ps-btn ps-btn--icone ps-cab-mais" title="Mais ações"
                        data-ps-pop="psMenuAcoes" aria-haspopup="true" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="ps-pop ps-pop--menu" id="psMenuAcoes" role="menu">
                    <div class="ps-pop-tarja"><i class="bi bi-folder2-open"></i>Pasta {{ pasta.nup }}</div>

                    {# Os atalhos E e H são do desenho; quem os escuta é o pasta-show.js
                       (`data-ps-atalho`), com o menu aberto. #}
                    {% if podeEditarPasta %}
                    <button type="button" class="ps-pop-item" role="menuitem" data-ps-atalho="e"
                            title="Editar dados (E)"
                            data-bs-toggle="modal" data-bs-target="#modalEditarPasta">
                        <i class="bi bi-pencil"></i><span>Editar dados</span><kbd class="ps-pop-atalho">E</kbd>
                    </button>
                    {% endif %}
                    {# O histórico automático do sistema vive no drawer; o botão mantém o id
                       que o pasta-show.js procura. #}
                    <button type="button" class="ps-pop-item" role="menuitem" data-ps-atalho="h"
                            id="psHistoricoAbrir" title="Histórico (H)"
                            aria-controls="psHistorico" aria-expanded="false">
                        <i class="bi bi-clock-history"></i><span>Histórico</span><kbd class="ps-pop-atalho">H</kbd>
                    </button>
                    {# Timeline inteligente (desenho dc L.1096, `mTimeline`): painel por REGRAS,
                       sem IA. O atalho T é escutado pelo pasta-timeline.js com o menu aberto. #}
                    <button type="button" class="ps-pop-item" role="menuitem" data-ps-atalho="t"
                            id="psTimelineAbrir" title="Timeline inteligente (T)"
                            aria-controls="psTimeline" aria-expanded="false">
                        <i class="bi bi-activity"></i><span>Timeline inteligente</span><kbd class="ps-pop-atalho">T</kbd>
                    </button>
                    {# Duplicar (desenho, `menuPasta('duplicar')`): abre uma pasta nova pelo mesmo
                       caminho da criação normal, com número novo — o "aguardando número" do
                       protótipo não existe aqui. Só aparece para quem pode criar pasta (a mesma
                       permissão do `pasta_new`); o servidor confere de novo. #}
                    {% if can_access_module('pastas') %}
                    {# E7: janela azul do desenho (dc `confirmarUI(…, ok)` sem perigo, L.4511); o `onsubmit`
                       só pergunta pelo navegador se a janela não carregou. #}
                    <form method="post" action="{{ path('pasta_duplicar', {id: pasta.id}) }}"
                          class="js-duplicar-pasta" data-nup="{{ pasta.nup }}"
                          data-ps-cf="{{ 'Duplicar a pasta ' ~ pasta.nup ~ '? A cópia leva cliente, ação, responsável e checklist; documentos, metas e financeiro não são copiados.' }}"
                          onsubmit="return !!window.confirmarUIPs || window.confirm(this.dataset.psCf);">
                        <input type="hidden" name="_token" value="{{ csrf_token('pasta_duplicar_' ~ pasta.id) }}">
                        <button type="submit" class="ps-pop-item" role="menuitem">
                            <i class="bi bi-files"></i><span>Duplicar pasta</span>
                        </button>
                    </form>
                    {% endif %}
                    {% if podeEditarPasta %}
                    <button type="button" class="ps-pop-item" role="menuitem"
                            data-bs-toggle="modal" data-bs-target="#modalVincularProcesso">
                        <i class="bi bi-link-45deg"></i><span>Vincular processo</span>
                    </button>
                    <button type="button" class="ps-pop-item" role="menuitem" id="psMenuTrocarResponsavel">
                        <i class="bi bi-person-gear"></i><span>Trocar responsável</span>
                    </button>
                    {% endif %}

                    <div class="ps-pop-sep"></div>
                    <div class="ps-pop-secao">Compartilhar</div>
                    {# Copiar link é real: a URL desta pasta vai para a área de transferência. #}
                    <button type="button" class="ps-pop-item js-copiar-link" role="menuitem"
                            data-link="{{ url('pasta_show', {id: pasta.id}) }}">
                        <i class="bi bi-link"></i><span class="js-copiar-link-rotulo">Copiar link da pasta</span>
                    </button>
                    {# Link externo do Push ([EXP] L.1104, `mPushLink`): abre o #modalLinkExternoPush
                       (pasta/_push_link_externo.html.twig). O selo conta os links ATIVOS; quem o
                       preenche é o pasta-push-link.js, com o GET da lista, ao abrir este menu. #}
                    <button type="button" class="ps-pop-item js-ppl-abrir" role="menuitem"
                            aria-haspopup="dialog" aria-controls="modalLinkExternoPush">
                        <i class="bi bi-broadcast"></i><span>Link externo do Push</span>
                        <span class="ppl-badge js-ppl-badge-ativos ps-num" hidden></span>
                    </button>
                    {# O clique abre a janela Imprimir (pasta-impressao.js, EDT-001): prévia, opções,
                       Imprimir e Copiar texto, e "Baixar PDF" gerado no servidor (Dompdf, rota
                       `pasta_resumo_pdf`). O href fica como caminho sem JS e para o Ctrl+clique: a
                       folha A4 em aba nova. #}
                    <a class="ps-pop-item" role="menuitem" target="_blank" rel="noopener"
                       href="{{ path('pasta_resumo_imprimir', {id: pasta.id}) }}">
                        <i class="bi bi-printer"></i><span>Imprimir resumo</span>
                    </a>

                    <div class="ps-pop-sep"></div>
                    <div class="ps-pop-secao">Preferências</div>
                    {# Desenho: `prefPasta('fav')` — estrela fixa, rótulo fixo e o interruptor
                       mostrando o estado. É do USUÁRIO: a pasta sobe para o topo da listagem do
                       Expediente só para quem fixou. O script no fim deste parcial faz o POST. #}
                    {% set eFavorita = pasta_favorita(pasta) %}
                    <button type="button" class="ps-pop-item js-pasta-favorito" role="menuitemcheckbox"
                            aria-checked="{{ eFavorita ? 'true' : 'false' }}"
                            data-url="{{ path('pasta_favorito_alternar', {id: pasta.id}) }}"
                            data-csrf="{{ csrf_token('pasta_favorito_' ~ pasta.id) }}">
                        <i class="bi bi-star"></i><span>Fixar nos favoritos</span>
                        <span class="ps-pop-sw{{ eFavorita ? ' is-ligado' : '' }}" aria-hidden="true"><span class="ps-pop-sw-bola"></span></span>
                    </button>

                    {% if podeEditarPasta or podeExcluirPasta %}
                    <div class="ps-pop-sep"></div>
                    {% endif %}
                    {% if podeEditarPasta %}
                    {# Atalho do desenho (`menuPasta`): arquivada volta a Ativo; qualquer outra vai a Arquivado. #}
                    <button type="button" class="ps-pop-item js-situacao-opt js-situacao-alternar" role="menuitem"
                            data-situacao="{{ eArquivada ? 'ativo' : 'arquivado' }}">
                        <i class="bi {{ eArquivada ? 'bi-box-arrow-up' : 'bi-archive' }}"></i>
                        <span class="js-situacao-alternar-rotulo">{{ eArquivada ? 'Desarquivar' : 'Arquivar' }} pasta</span>
                    </button>
                    {% endif %}
                    {# Excluir pede o NÚMERO da pasta digitado (desenho, `menuPasta('excluir')`).
                       O prompt é só o primeiro filtro: o servidor confere `confirmar_nup` com o
                       número gravado e recusa se não bater. O texto não promete "lixeira por
                       30 dias" como o desenho: aqui a pasta vira lápide (ou some, se for a
                       última da sequência). Trocar o prompt() nativo por modal é frente própria.
                       Número errado: o aviso da tela (`avisarPs`, PAS-034b), neutro como o `gmAviso` do
                       desenho (dc L.4337), e não o `alert` do navegador. O prompt leva o cliente entre
                       parênteses, como o desenho (dc L.4336), o mesmo nome do título do cabeçalho. #}
                    {% if podeExcluirPasta %}
                    <form method="post" action="{{ path('pasta_delete', {id: pasta.id}) }}"
                          class="js-excluir-pasta" data-nup="{{ pasta.nup }}" data-cliente="{{ cliente ? cliente.nomeExibicao : pasta.nomeCliente }}"
                          onsubmit="var n = this.dataset.nup, c = this.dataset.cliente, txt = window.prompt('Excluir a pasta ' + n + (c ? ' (' + c + ')' : '') + '?\nA exclusão fica registrada no histórico.\n\nPara confirmar, digite o número da pasta:'); if (txt === null) { return false; } if (String(txt).trim().toUpperCase() !== n) { if (window.avisarPs) { window.avisarPs('Número não confere. A pasta não foi excluída.'); } return false; } this.elements.confirmar_nup.value = String(txt).trim(); return true;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_pasta_' ~ pasta.id) }}">
                        <input type="hidden" name="confirmar_nup" value="">
                        <button type="submit" class="ps-pop-item ps-pop-item--perigo" role="menuitem">
                            <i class="bi bi-trash3"></i><span>Excluir pasta</span>
                        </button>
                    </form>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {% if pasta.estaExcluida %}
    {# A faixa existe porque a pasta riscada continua abrindo normalmente: sem ela, quem chega
       pelo link não tem como saber por que os botões sumiram. #}
    <div class="ps-cab-excluida" role="status">
        <i class="bi bi-trash3"></i>
        <span>
            <strong>Pasta excluída</strong>
            em {{ pasta.excluidaEm|date('d/m/Y') }} às {{ pasta.excluidaEm|date('H:i') }}
            {%- if pasta.excluidaPor %} por {{ pasta.excluidaPor.fullName }}{% endif %}.
            Ela continua aqui porque o número {{ pasta.nup }} não pode ser reaproveitado:
            já existem pastas posteriores. Somente leitura até ser restaurada.
        </span>
    </div>
    {% endif %}

    {# ── Linha 2: o cliente é o título ───────────────────────────────────── #}
    {# `nomeCliente` é o IDENTIFICADOR da pasta (decisão do dono, 01/09/2026): é ele
       que vira o título quando não há cliente cadastrado — o estado real de quase
       todas as pastas. O ícone de pessoa não é clicável: a foto do cliente é função
       nova e botão sem função é mentira na tela. #}
    <div class="ps-cab-cliente">
        <span class="ps-cab-cliente-icone" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
        <div class="ps-cab-cliente-corpo">
            <div class="ps-cab-cliente-linha">
                {# Com cliente cadastrado, o botão direito no nome abre a janela "Detalhes do
                   cliente" (PAS-001; desenho dc L.1129, `abrirCli`) — a mesma do botão Cadastro e do
                   trilho, pelo pasta-clientes.js (`data-cliente-id`). O clique comum não muda. #}
                <h1 class="ps-cab-titulo"
                    {%- if cliente %} data-cliente-id="{{ cliente.id }}" aria-describedby="psCabDicaCliente"{% endif %}>
                    {%- if cliente -%}
                        {{ cliente.nomeExibicao }}
                    {%- elseif pasta.nomeCliente -%}
                        {{ pasta.nomeCliente }}
                    {%- else -%}
                        <span class="ps-dado--vazio">Cliente não informado</span>
                    {%- endif -%}
                </h1>
                {# É o mesmo dado que a faixa chamava de "Última movimentação" (a última
                   alteração da pasta); só mudou de lugar e de formato, como no desenho. #}
                {% if pasta.modificadoEm %}
                    <span class="ps-cab-mov" data-campo="movimentacao"
                          title="Última movimentação: {{ pasta.modificadoEm|date('d/m/Y H:i') }}">
                        <span class="ps-cab-mov-ponto" aria-hidden="true"></span>
                        {%- if pasta.modificadoEm|date('Y-m-d') == 'now'|date('Y-m-d') -%}
                            Movimentado hoje, {{ pasta.modificadoEm|date('H:i') }}
                        {%- else -%}
                            Movimentado em {{ pasta.modificadoEm|date('d/m/Y') }}
                        {%- endif -%}
                    </span>
                {% endif %}
            </div>
            {% if documento %}
                <span class="ps-cab-doc ps-num">{{ documento|documento_br_rotulo }} {{ documento|documento_br }}</span>
            {% elseif cliente is null and pasta.nomeCliente %}
                <span class="ps-cab-doc ps-cab-doc--aviso">não vinculado ao cadastro de clientes</span>
            {% endif %}
        </div>
        {# Dica do desenho (dc L.1135-1137, `tipVis`): aparece ao parar o mouse no nome. Só CSS. #}
        {% if cliente %}
            <span class="ps-cab-dica" id="psCabDicaCliente" role="tooltip"><i class="bi bi-mouse2" aria-hidden="true"></i>Detalhes: clique com o botão direito</span>
        {% endif %}

        {# ── BlueJus Intelligence (desenho 1.2.3, dc L.1139): à direita da linha do cliente ──
           Abre o drawer dos agentes da BlueJus IA (spec inteligencia-agentes-da-pasta). Só para
           quem tem `modules.inteligencia.view`; o botão sempre abre o drawer — é lá que cada
           agente mostra "Gerar análise" ou o motivo REAL de a IA não estar disponível. O title
           do desenho ("Ler documentos…") não é usado: o sistema não lê documentos. #}
        {% if can_access_module('inteligencia') and recurso_visivel('assistente') %}
            {% set iaDisp = ia_disponibilidade() %}
            <button type="button" class="ps-cab-ia {{ recurso_marca('assistente') }}" id="psIaAbrir"
                    title="{{ iaDisp.estaDisponivel ? 'BlueJus IA: análises desta pasta por agente' : iaDisp.mensagem }}"
                    aria-controls="psIaDrawer" aria-expanded="false"
                    data-ia-abrir
                    data-ia-disponivel="{{ iaDisp.estaDisponivel ? '1' : '0' }}"
                    data-ia-motivo="{{ iaDisp.value }}">
                <span class="ps-cab-ia-estrela" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" style="overflow:visible"><defs><linearGradient id="bjIaG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1fa6cc"></stop><stop offset="1" stop-color="#0b5f86"></stop></linearGradient></defs><path class="ps-cab-ia-estrela-g" d="M11 2.5c.5 3.9 2.6 6 6.5 6.5-3.9.5-6 2.6-6.5 6.5-.5-3.9-2.6-6-6.5-6.5 3.9-.5 6-2.6 6.5-6.5z" fill="url(#bjIaG)"></path><path class="ps-cab-ia-estrela-p" d="M18.5 13.5c.25 1.9 1.1 2.75 3 3-1.9.25-2.75 1.1-3 3-.25-1.9-1.1-2.75-3-3 1.9-.25 2.75-1.1 3-3z" fill="#1fa6cc"></path><circle class="ps-cab-ia-estrela-c" cx="5" cy="18.5" r="1.3" fill="#0b5f86"></circle></svg>
                </span>
                <span class="ps-cab-ia-rotulo"><span class="ps-cab-ia-marca">BLUEJUS</span><span class="ps-cab-ia-nome">Intelligence</span></span>
            </button>
            {{ include('inteligencia/_agentes_drawer.html.twig', {pasta: pasta, ia: iaDisp}) }}
        {% endif %}
    </div>


    {# ── Palco da linha do tempo (desenho 1.2.3: o carimbo da situação fica no MESMO bloco do andamento,
       à direita, e a linha do tempo reserva 150px para ele). A faixa "Processo vinculado · Ação ·
       Responsável · Cobrança" saiu do cabeçalho (regra do dono, 16/10, como o desenho): Responsável foi
       para a linha de cima e os outros viraram cartões no alto do trilho da aba Dados
       (pasta/_dados_trilho_topo.html.twig). ── #}
    {# Selo carimbado (desenho, `seloEl`): permanente para Arquivado (inclusive a lápide, que o
       sistema arquiva ao excluir), Suspenso e Cancelado. Fica por cima do bloco sem roubar
       clique. Trocar a situação recarrega a tela (o Registro ganha o cartão e, ao arquivar, o
       andamento vai a Finalizada), então o selo sai sempre do servidor. #}
    {% set selosPermanentes = {
        arquivado: {texto: 'ARQUIVADO', icone: 'bi-archive-fill',      aria: 'Pasta arquivada', titulo: 'Arquivado'},
        suspenso:  {texto: 'SUSPENSO',  icone: 'bi-pause-circle-fill', aria: 'Pasta suspensa',  titulo: 'Suspenso'},
        cancelado: {texto: 'CANCELADO', icone: 'bi-x-octagon-fill',    aria: 'Pasta cancelada', titulo: 'Cancelado'},
    } %}
    {% set seloArquivado %}
        <div class="ps-cab-selo ps-cab-selo--arquivado" role="img" aria-label="Pasta arquivada" title="Situação da pasta: Arquivado">
            <span class="ps-cab-selo-onda" aria-hidden="true"></span>
            <span class="ps-cab-selo-onda" aria-hidden="true"></span>
            <span class="ps-cab-selo-onda" aria-hidden="true"></span>
            <span class="ps-cab-selo-aro" aria-hidden="true"></span>
            <span class="ps-cab-selo-faixa"><i class="bi bi-archive-fill" aria-hidden="true"></i>ARQUIVADO</span>
        </div>
    {% endset %}
    {# PAS-002: ao REATIVAR (arquivado → ativo pela pílula), o desenho carimba "ATIVO" por
       3,3 s (`ativoSeloMostrar`) e o selo some sozinho. Nunca vem do servidor: só existe
       como modelo, e o script do fim do parcial o põe e o tira. #}
    {% set seloAtivo %}
        <div class="ps-cab-selo ps-cab-selo--ativo" role="img" aria-label="Pasta ativa" title="Situação da pasta: Ativo">
            <span class="ps-cab-selo-onda" aria-hidden="true"></span>
            <span class="ps-cab-selo-onda" aria-hidden="true"></span>
            <span class="ps-cab-selo-onda" aria-hidden="true"></span>
            <span class="ps-cab-selo-aro" aria-hidden="true"></span>
            <span class="ps-cab-selo-faixa"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>ATIVO</span>
        </div>
    {% endset %}
    <div class="ps-cab-palco" data-ps-selo-modelo="{{ seloArquivado|e('html_attr') }}"
         data-ps-selo-ativo-modelo="{{ seloAtivo|e('html_attr') }}">
        {% if eArquivada %}{{ seloArquivado }}{% elseif selosPermanentes[pasta.situacao] is defined %}
            {% set sp = selosPermanentes[pasta.situacao] %}
            <div class="ps-cab-selo ps-cab-selo--{{ pasta.situacao }}" role="img" aria-label="{{ sp.aria }}" title="Situação da pasta: {{ sp.titulo }}">
                <span class="ps-cab-selo-onda" aria-hidden="true"></span>
                <span class="ps-cab-selo-onda" aria-hidden="true"></span>
                <span class="ps-cab-selo-onda" aria-hidden="true"></span>
                <span class="ps-cab-selo-aro" aria-hidden="true"></span>
                <span class="ps-cab-selo-faixa"><i class="bi {{ sp.icone }}" aria-hidden="true"></i>{{ sp.texto }}</span>
            </div>
        {% endif %}
        {{ include('pasta/_andamento.html.twig') }}
    </div>

    {# ── Linha 3: abas (padrão PJe, desenho 1.2.3) ──────────────────────── #}
    {# Contagens SEMPRE do dado, nunca literais — foi bug corrigido duas vezes na
       revisão do desenho. Metas e Documentos exibem o total e Push só as NÃO LIDAS;
       em todas o selo só aparece com contagem > 0 (o "0" some — ver o `if` do selo
       abaixo e o PastaDadosArranjoTelaTest). Os `id`
       seguem os antigos porque o pasta-arquivos.js chama bootstrap.Tab em
       `#documentos-tab` depois do upload; renomear aqui quebraria aquele retorno
       em silêncio.

       Pendência (a linha vermelha sob a aba) só existe com dado REAL por trás —
       ver `PastaPendenciasOutput`. #}
    {# As pendências vêm PRONTAS do servidor (`PastaPendenciasOutput`): a tela não decide
       nada, só mostra. Metas = meta não concluída; Processo = nenhum processo vinculado;
       Financeiro = contrato pendente sem pró-bono (+ pagamentos vencidos); Push = não lidas. #}
    {% set pushNaoLidas = push.naoLidas|default(0) %}
    {% set abas = [
        {id: 'dados',      painel: 'dados',      rotulo: 'Dados da pasta', icone: 'bi-folder2-open',  contagem: null},
        {id: 'tarefas',    painel: 'tarefas',    rotulo: 'Metas',          icone: 'bi-check2-square', contagem: pasta.tarefas|length},
        {id: 'processo',   painel: 'processo',   rotulo: 'Processo',       icone: 'bi-bank',          contagem: null},
        {id: 'financeiro', painel: 'financeiro', rotulo: 'Financeiro',     icone: 'bi-cash-coin',     contagem: null},
        {id: 'detalhes',   painel: 'detalhes',   rotulo: 'Detalhes',       icone: 'bi-info-circle',   contagem: null},
        {id: 'documentos', painel: 'documentos', rotulo: 'Documentos',     icone: 'bi-paperclip',     contagem: pasta.documentos|length},
        {id: 'push',       painel: 'push',       rotulo: 'Push Processual', icone: 'bi-broadcast',     contagem: pushNaoLidas},
    ] %}
    <div class="ps-abas-faixa">
        {# `ps-abas--sem-js` sai no boot do pasta-show.js. Sem JS o sublinhado nunca
           é medido, e sem esta classe a aba ativa ficaria sem marca nenhuma. #}
        <div class="ps-abas ps-abas--sem-js" id="pastaTabs" role="tablist">
            <div class="ps-abas-ind" aria-hidden="true"></div>
            {% for aba in abas %}
                {% set pend = pendencias.porAba[aba.id]|default(null) %}
                <button class="ps-aba{{ loop.first ? ' active' : '' }}{{ pend ? ' ps-aba--pend' : '' }}"
                        id="{{ aba.id }}-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#{{ aba.painel }}"
                        type="button" role="tab"
                        aria-controls="{{ aba.painel }}"
                        aria-selected="{{ loop.first ? 'true' : 'false' }}"
                        title="{{ aba.rotulo }}{% if pend %} · {{ pend.txt }}{% endif %}"
                        {#- Botão direito (ou Shift+F10 / tecla de menu) na aba Push abre o menu
                            "PUSH PROCESSUAL" do link externo ([EXP] L.1241 `onContextMenu`,
                            `abaMenu` L.4409). Quem escuta é o pasta-push-link.js. #}
                        {%- if aba.id == 'push' %} data-ppl-menu="pushLinkMenu" aria-keyshortcuts="Shift+F10"{% endif %}>
                    {# A barra some na aba ativa (CSS, pela classe `.active` que o
                       Bootstrap alterna): quem está olhando a aba já vê a pendência. #}
                    {% if pend %}<span class="ps-aba-pend" aria-hidden="true"></span>{% endif %}
                    <i class="bi {{ aba.icone }}"></i>
                    <span>{{ aba.rotulo }}</span>
                    {# Selo só com contagem > 0: o "0" já foi bug corrigido duas vezes na revisão do desenho (PastaDadosArranjoTelaTest). #}
                    {% if aba.contagem %}<span class="ps-aba-badge ps-num">{{ aba.contagem }}</span>{% endif %}
                </button>
            {% endfor %}
        </div>

        {# ── Cadastro: botão à direita das abas, antes da Situação (lote L2) ──
           Desenho 1.2.3 dc L.1251-1255 (estilos `cadBtnSt`/`cadDot`, dc L.3284-3290):
           ícone com o ponto VERDE (cadastro completo) ou ÂMBAR (falta algo). A regra é
           a do `PendenciasDoCadastro` (`cliente_pendencias`), a mesma do ícone do
           trilho — a tela não decide o que é completo.
           Destino (E12f): a janela "Cadastro e qualificação do cliente" do desenho
           (`cliente_cadastro`, cliente-cadastro.js pela classe `js-cad-abrir`). O botão
           direito no nome segue abrindo "Detalhes do cliente". Pasta sem cliente
           cadastrado abre o "Novo cliente" (E12i). #}
        {% if cliente %}
            {% set cadPendencias = cliente_pendencias(cliente) %}
            {% set cadCompleto = cadPendencias is empty %}
            {% set cadDica = cadCompleto
                ? 'Cadastro completo · abrir qualificação do cliente'
                : 'Cadastro incompleto: ' ~ cadPendencias|length ~ (cadPendencias|length == 1 ? ' pendência' : ' pendências') ~ ' · clique para completar' %}
            <button type="button" id="psCadastroAbrir"
                    class="ps-cad-btn js-cad-abrir"
                    data-cliente-id="{{ cliente.id }}"
                    data-url="{{ path('cliente_cadastro', {id: cliente.id, pasta: pasta.id}) }}"
                    data-pendencias="{{ cadPendencias|length }}"
                    title="{{ cadDica }}" aria-label="{{ cadDica }}">
                <span class="ps-cad-btn-icone" aria-hidden="true"><i class="bi bi-person-vcard"></i><span class="ps-cad-ponto ps-cad-ponto--{{ cadCompleto ? 'completo' : 'pendente' }}"></span></span>
                <span>Cadastro</span>
            </button>
        {% elseif podeEditarPasta and not pasta.estaExcluida %}
            {# E12i (regra do dono, como o desenho): o Cadastro existe em toda pasta. Sem cliente vinculado, abre o
               "Novo cliente" com o nome da pasta já escrito; ao salvar, o cliente é criado e ligado à pasta. #}
            <button type="button" id="psCadastroAbrir"
                    class="ps-cad-btn js-cad-abrir"
                    data-url="{{ path('pasta_cadastro_novo', {id: pasta.id}) }}"
                    data-pendencias="1"
                    title="Sem cliente cadastrado · clique para cadastrar" aria-label="Sem cliente cadastrado · clique para cadastrar">
                <span class="ps-cad-btn-icone" aria-hidden="true"><i class="bi bi-person-vcard"></i><span class="ps-cad-ponto ps-cad-ponto--pendente"></span></span>
                <span>Cadastro</span>
            </button>
        {% endif %}

        {# ── Situação: pílula à direita das abas ──
           As 4 situações do desenho (`situacaoVals`), sem confirmação nem motivo. A pílula é o
           `#btn-alternar-status` de sempre (url, csrf, situação atual): o script da tela manda a
           opção escolhida. Pasta excluída é somente-leitura: a pílula vira só um selo, sem menu. #}
        {# Sem EDIT a pílula vira só o selo, como na lápide: a troca seria recusada. #}
        {% if not pasta.estaExcluida and podeEditarPasta %}
            <div class="ps-situacao-wrap ps-pop-wrap">
                <button type="button"
                        id="btn-alternar-status"
                        class="ps-situacao-pill ps-situacao-pill--{{ pasta.situacao }}"
                        title="Situação da pasta: {{ pasta.situacaoRotulo }}"
                        data-ps-pop="psSituacao"
                        aria-haspopup="menu" aria-expanded="false"
                        data-pasta-id="{{ pasta.id }}"
                        data-situacao-atual="{{ pasta.situacao }}"
                        data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}"
                        data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}">
                    <span class="ps-situacao-ponto" aria-hidden="true"></span>
                    <span class="ps-situacao-label">{{ pasta.situacaoRotulo }}</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="ps-pop ps-pop--situacao" id="psSituacao" role="menu">
                    <div class="ps-pop-tarja"><i class="bi bi-toggles"></i>Situação da pasta</div>
                    {% for opcao in [
                        {v: 'ativo',     rotulo: 'Ativo',     desc: 'Pasta em andamento'},
                        {v: 'suspenso',  rotulo: 'Suspenso',  desc: 'Pausada temporariamente'},
                        {v: 'cancelado', rotulo: 'Cancelado', desc: 'Encerrada sem conclusão'},
                        {v: 'arquivado', rotulo: 'Arquivado', desc: 'Sai das listas de trabalho'},
                    ] %}
                        <button type="button" class="ps-pop-item ps-pop-item--situacao js-situacao-opt"
                                role="menuitemradio" aria-checked="{{ pasta.situacao == opcao.v ? 'true' : 'false' }}"
                                data-situacao="{{ opcao.v }}">
                            <span class="ps-situacao-ponto ps-situacao-ponto--{{ opcao.v }}" aria-hidden="true"></span>
                            <span class="ps-pop-item-corpo">
                                <span class="ps-pop-item-titulo">{{ opcao.rotulo }}</span>
                                <span class="ps-pop-item-desc">{{ opcao.desc }}</span>
                            </span>
                            <i class="bi bi-check2 ps-pop-check{{ pasta.situacao == opcao.v ? '' : ' d-none' }}"></i>
                        </button>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="ps-situacao-wrap">
                <span class="ps-situacao-pill ps-situacao-pill--{{ pasta.situacao }}" title="Situação da pasta">
                    <span class="ps-situacao-ponto" aria-hidden="true"></span>
                    <span class="ps-situacao-label">{{ pasta.situacaoRotulo }}</span>
                </span>
            </div>
        {% endif %}
    </div>
</header>

<style>
/* Interruptor do item "Fixar nos favoritos" — medidas do desenho (`swS`/`swB`).
   O trilho é token com par escuro (auditoria 2 C7: `--ps-switch-off`); o valor
   literal é só o recuo para quando o token não existir. */
.ps-pop-sw { position: relative; width: 30px; height: 17px; border-radius: 999px; flex-shrink: 0; margin-left: auto; background: var(--ps-switch-off, #cfd9e0); transition: background .2s; }
.ps-pop-sw.is-ligado { background: var(--ps-accent, #0a7aad); }
.ps-pop-sw-bola { position: absolute; top: 2px; left: 2px; width: 13px; height: 13px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(10,40,60,.3); transition: left .2s cubic-bezier(.22,.8,.3,1); }
.ps-pop-sw.is-ligado .ps-pop-sw-bola { left: 15px; }

/* PAS-001: o nome do cliente aceita o botão direito, e a dica do desenho (`tipVis`) aparece
   350ms depois de o mouse parar nele. Medidas e cores do desenho (dc L.1136); fundo e texto
   pelos tokens que já têm o par escuro. */
.ps-cab-titulo[data-cliente-id] { cursor: context-menu; }
.ps-cab-dica {
    position: absolute; left: 50px; top: calc(100% + 6px); z-index: 20;
    display: inline-flex; align-items: center; gap: 7px; white-space: nowrap;
    padding: 7px 11px; border-radius: 4px;
    background: var(--ps-resp-ativa-bg, #e3f0f8); color: var(--ps-chip-text, #0b5f86);
    font-size: 12.5px; font-weight: 700;
    box-shadow: 0 8px 18px -10px rgba(12,90,130,.45);
    pointer-events: none;
    opacity: 0; visibility: hidden; transform: translateY(-3px);
    transition: opacity .16s cubic-bezier(.22,.8,.3,1), transform .16s cubic-bezier(.22,.8,.3,1), visibility 0s linear .16s;
}
.ps-cab-dica i { font-size: 13px; }
.ps-cab-cliente:has(.ps-cab-titulo[data-cliente-id]:hover) > .ps-cab-dica {
    opacity: 1; visibility: visible; transform: none;
    transition-delay: .35s, .35s, .35s;
}
@media (hover: none) { .ps-cab-dica { display: none; } }
</style>
<script>
(function () {
    /* PAS-034b: "Restaurar" pergunta na janela da tela (`confirmarPs`, pasta-dialogos.js), não
       no `confirm` do navegador. O envio fica segurado até a resposta; com o "sim", o form segue
       pelo caminho de sempre (o CSRF e o POST do próprio form). */
    var form = document.querySelector('form.js-restaurar-pasta');
    if (!form) { return; }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!window.confirmarPs) { return; }
        // E7: restaurar não tem perigo → variante azul (regra do dc `confirmarUI`/`cfVals`; o
        // desenho não tem esta pergunta — a convenção dele decide a cor).
        window.confirmarPs({
            titulo: 'Restaurar a pasta ' + form.dataset.nup + '?',
            rotulo: 'Restaurar',
            icone: 'bi-arrow-counterclockwise',
            variante: 'azul'
        }).then(function (sim) {
            // `form.submit()` não dispara outro `submit`: não volta a perguntar.
            if (sim) { form.submit(); }
        });
    });
})();

(function () {
    /* "Fixar nos favoritos": alterna no servidor e o interruptor espelha a RESPOSTA, não o
       clique — se o POST falhar, o estado mostrado continua o gravado. */
    var item = document.querySelector('.js-pasta-favorito');
    if (!item) { return; }

    /* PAS-034b: a falha sai no aviso da tela (`avisarPs`), não no `alert` do navegador. */
    function avisarErro(mensagem) {
        if (window.avisarPs) { window.avisarPs(mensagem, 'erro'); }
    }

    item.addEventListener('click', function () {
        if (item.dataset.enviando === '1') { return; }
        item.dataset.enviando = '1';

        var corpo = new FormData();
        corpo.append('_token', item.dataset.csrf);

        fetch(item.dataset.url, {
            method: 'POST',
            body: corpo,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        })
            .then(function (resposta) {
                return resposta.json().then(function (dados) { return { ok: resposta.ok, dados: dados }; });
            })
            .then(function (r) {
                if (!r.ok || typeof r.dados.favorita !== 'boolean') {
                    avisarErro((r.dados && (r.dados.erro || r.dados.mensagem)) || 'Não foi possível alterar os favoritos.');
                    return;
                }
                item.setAttribute('aria-checked', r.dados.favorita ? 'true' : 'false');
                var sw = item.querySelector('.ps-pop-sw');
                if (sw) { sw.classList.toggle('is-ligado', r.dados.favorita); }
            })
            .catch(function () { avisarErro('Erro de comunicação. Tente novamente.'); })
            .then(function () { item.dataset.enviando = ''; });
    });
})();

(function () {
    /* Carimbo ATIVO passageiro (desenho `ativoSeloMostrar`): pasta ativa ganha o carimbo 1,4 s
       depois de abrir, ele bate e some em 3,3 s (o CSS faz o esmaecer, o timer tira o nó). Trocar
       para Ativo recarrega a tela, então este é o único caminho do carimbo. Os permanentes
       (Arquivado, Suspenso, Cancelado) vêm do servidor. */
    var faixa = document.querySelector('.ps-cabecalho .ps-cab-palco');
    var pilula = document.querySelector('.ps-cabecalho .ps-situacao-pill');
    if (!faixa || !pilula || !faixa.dataset.psSeloAtivoModelo || !pilula.classList.contains('ps-situacao-pill--ativo')) { return; }
    setTimeout(function () {
        faixa.insertAdjacentHTML('afterbegin', faixa.dataset.psSeloAtivoModelo);
        setTimeout(function () {
            var ativo = faixa.querySelector(':scope > .ps-cab-selo--ativo');
            if (ativo) { ativo.remove(); }
        }, 3300);
    }, 1400);
})();
</script>
