{# Visual do chip de responsavel (avatar + nome) e do menu #pastaRespMenu.
   Morava dentro do <style> do _tabela.html.twig; saiu de la quando a pasta_show
   passou a usar o mesmo chip. Dono do proprio <style>, entao o include NAO pode
   ficar dentro de outro bloco <style> — <style> aninhado e HTML invalido. #}
<style>
/* ── Responsável: chip (avatar + nome) + menu ──────────────────── */
.resp-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; overflow: hidden; flex-shrink: 0;
    font-weight: 700; color: #fff; line-height: 1;
}
.resp-avatar-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.resp-avatar-ini { background: linear-gradient(135deg, #1a3a5c, #2563a8); font-size: .62rem; }
.resp-avatar-vazio { background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); }

.pasta-resp-chip {
    display: inline-flex; align-items: center; gap: 6px; max-width: 100%;
    border: 1px solid var(--bs-border-color); background: var(--bs-body-bg);
    border-radius: 20px; padding: 2px 8px 2px 3px;
    font-size: .8rem; line-height: 1.4; color: var(--bs-body-color);
    text-transform: none; cursor: pointer; transition: background .12s, border-color .12s;
}
.pasta-resp-chip:hover { background: var(--bs-secondary-bg); border-color: var(--bs-secondary-color); }
.pasta-resp-chip.salvando { opacity: .55; pointer-events: none; }
.pasta-resp-nome { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pasta-resp-caret { font-size: .6rem; opacity: .45; flex-shrink: 0; }

.pasta-resp-menu {
    position: fixed; z-index: 10000;
    background: var(--bs-body-bg); border: 1px solid var(--bs-border-color);
    border-radius: 12px; box-shadow: 0 8px 28px rgba(0,0,0,.18);
    padding: 5px; min-width: 210px; max-width: 300px;
    max-height: 320px; overflow-y: auto;
}
.pasta-resp-menu[hidden] { display: none; }
.pasta-resp-opcao {
    display: flex; align-items: center; gap: 9px; width: 100%;
    border: none; background: transparent; text-align: left;
    padding: 6px 9px; border-radius: 9px; cursor: pointer;
    font-size: .84rem; color: var(--bs-body-color);
}
.pasta-resp-opcao:hover { background: var(--bs-secondary-bg); }
.pasta-resp-opcao.ativa { background: var(--bs-primary-bg-subtle); font-weight: 600; }
.pasta-resp-opcao .pasta-resp-nome { flex: 1; }

/* No cartão o chip pode respirar mais; na tabela ele cabe na coluna estreita */
.pasta-card-acoes .pasta-resp-chip { max-width: 230px; }
</style>
