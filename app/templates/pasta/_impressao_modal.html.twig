{# ============================================================================
   Janela "Imprimir" da pasta — desenho aprovado: docs/design/claude-design-2026-10-05 (1)/
   "02 - EXPEDIENTES 1.2.3.dc.html", `imp` (marcação ~L.195) e `impVals`/`impMontar`
   (L.4611-4631); impressão por iframe oculto como o `BJImprimir` (bj-visualizar.js).

   Uma janela para todas as folhas da pasta: Imprimir resumo (⋮ do cabeçalho),
   Imprimir extrato (Financeiro), Imprimir do ⋮ da observação e Imprimir resumo do
   ⋮ do processo. A folha da pré-visualização vem do SERVIDOR
   (`pasta_resumo_imprimir?fragmento=1`, mesmos guardas de escritório e permissão
   da tela); para o registro e o processo o servidor dá só a moldura e a tela põe
   o corpo, por DOM. Tudo o mais é do pasta-impressao.js.

   Contexto: `pasta`.
   ============================================================================ #}
<link rel="stylesheet" href="{{ asset('css/pasta-impressao.css') }}">
{# Textos do pasta-impressao.js: este parcial é quem carrega o script. #}
{{ catalogo_js('pasta_resp.js.impressao') }}
<div class="psi-fundo" id="psImpressao" hidden
     data-url-folha="{{ path('pasta_resumo_imprimir', {id: pasta.id}) }}"
     data-url-pdf="{{ path('pasta_resumo_pdf', {id: pasta.id}) }}">
    <div class="psi-janela" role="dialog" aria-modal="true" aria-labelledby="psImpressaoTitulo">
        <div class="psi-cab">
            <i class="bi bi-printer" aria-hidden="true"></i>
            <div class="psi-cab-titulo" id="psImpressaoTitulo">{{ 'pasta_resp.imprimir'|trans }}</div>
            <button type="button" class="psi-fechar js-psi-fechar" aria-label="{{ 'pasta_resp.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="psi-corpo">
            {# A folha ao vivo: o JS troca o conteúdo deste palco pela folha do servidor. #}
            <div class="psi-palco" id="psImpressaoPalco" aria-live="polite"></div>
            <div class="psi-lado">
                <span class="psi-rotulo">{{ 'pasta_resp.impressao.incluir'|trans }}</span>
                <button type="button" class="psi-opcao js-psi-opcao" data-opcao="cabecalho" aria-pressed="true">
                    <i class="bi bi-check-square-fill" aria-hidden="true"></i>{{ 'pasta_resp.impressao.opcao_cabecalho'|trans }}
                </button>
                <button type="button" class="psi-opcao js-psi-opcao" data-opcao="dados" aria-pressed="true">
                    <i class="bi bi-check-square-fill" aria-hidden="true"></i>{{ 'pasta_resp.impressao.opcao_dados'|trans }}
                </button>
                <button type="button" class="psi-opcao js-psi-opcao" data-opcao="autor" aria-pressed="true">
                    <i class="bi bi-check-square-fill" aria-hidden="true"></i>{{ 'pasta_resp.impressao.opcao_autor'|trans }}
                </button>
                {# Só aparece quando a folha do servidor trouxe o Financeiro (quem o vê). #}
                <button type="button" class="psi-opcao js-psi-opcao" data-opcao="financeiro" aria-pressed="false" hidden>
                    <i class="bi bi-square" aria-hidden="true"></i>{{ 'pasta_resp.impressao.opcao_financeiro'|trans }}
                </button>
                <span class="psi-rotulo psi-rotulo--tamanho">{{ 'pasta_resp.impressao.tamanho'|trans }}</span>
                <div class="psi-tamanho">
                    <button type="button" class="psi-tamanho-btn js-psi-menor" aria-label="{{ 'pasta_resp.impressao.diminuir'|trans }}"><i class="bi bi-dash-lg"></i></button>
                    <span class="psi-tamanho-valor" id="psImpressaoFonte">{{ 'pasta_resp.impressao.fonte'|trans({tamanho: 11.5|numero(1)}) }}</span>
                    <button type="button" class="psi-tamanho-btn js-psi-maior" aria-label="{{ 'pasta_resp.impressao.aumentar'|trans }}"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="psi-espaco"></div>
                <span class="psi-nota">{{ 'pasta_resp.impressao.nota'|trans }}</span>
                <button type="button" class="psi-imprimir js-psi-imprimir"><i class="bi bi-printer"></i>{{ 'pasta_resp.imprimir'|trans }}</button>
                <button type="button" class="psi-baixar js-psi-baixar"><i class="bi bi-file-earmark-pdf"></i>{{ 'pasta_resp.impressao.baixar_pdf'|trans }}</button>
                <button type="button" class="psi-copiar js-psi-copiar"><i class="bi bi-copy"></i>{{ 'pasta_resp.impressao.copiar'|trans }}</button>
            </div>
        </div>
    </div>
</div>
<script src="{{ asset('js/pasta-impressao.js') }}" defer></script>
