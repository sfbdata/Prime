{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Editar Pasta' : 'Nova Pasta' }}{% endblock %}

{% block body %}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-folder{{ isEdit ? '-symlink' : '-plus' }} me-2"></i>
                    {{ isEdit ? 'Editar Pasta' : 'Nova Pasta' }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('expediente_index') }}">Expediente</a></li>
                    {% if isEdit %}
                        <li class="breadcrumb-item">
                            <a href="{{ path('pasta_show', {id: pasta.id}) }}">{{ pasta.nup }}</a>
                        </li>
                    {% endif %}
                    <li class="breadcrumb-item active">{{ isEdit ? 'Editar' : 'Nova' }}</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form method="post" enctype="multipart/form-data"
              action="{{ isEdit ? path('pasta_edit', {id: pasta.id}) : path('pasta_new') }}"
              id="form-pasta">

            {# ── Barra de abas ── #}
            <div class="pasta-wizard-tabs">
                <button type="button" class="pasta-tab active" data-tab="cadastro">CADASTRO</button>
                <button type="button" class="pasta-tab" data-tab="contrato">CONTRATO</button>
                <button type="button" class="pasta-tab" data-tab="cliente">CLIENTE</button>
                <button type="button" class="pasta-tab" data-tab="processo">PROCESSO</button>
            </div>

            {# ══════════════════════════════════════════════ #}
            {# ABA 1 — CADASTRO                               #}
            {# ══════════════════════════════════════════════ #}
            <div class="pasta-tab-content active" id="tab-cadastro">
                <h2 class="pasta-section-title">Cadastro inicial</h2>

                <div class="pasta-field-group">
                    <label for="nup" class="pasta-label">Número da Pasta (NUP)</label>
                    <input type="text" id="nup" name="nup" class="pasta-input pasta-input--short"
                           value="{{ pasta.getNup() ?? '' }}"
                           placeholder="Ex.: 001">
                </div>

                <div class="pasta-field-group">
                    <label for="nomeCliente" class="pasta-label">Nome do cliente</label>
                    <input type="text" id="nomeCliente" name="nome_cliente" class="pasta-input"
                           value="{{ pasta.nomeCliente ?? '' }}"
                           placeholder="">
                </div>

                <div class="pasta-field-group">
                    <label for="nomeAcao" class="pasta-label">Nome da Ação</label>
                    <input type="text" id="nomeAcao" name="nome_acao" class="pasta-input"
                           value="{{ pasta.nomeAcao ?? '' }}"
                           placeholder="">
                </div>

            </div>

            {# ══════════════════════════════════════════════ #}
            {# ABA 2 — CONTRATO                              #}
            {# ══════════════════════════════════════════════ #}
            <div class="pasta-tab-content" id="tab-contrato">
                <h2 class="pasta-section-title">Contrato</h2>

                {# Área de drop #}
                <div class="pasta-dropzone" id="contrato-dropzone">
                    <i class="bi bi-download pasta-dropzone-icon"></i>
                    <p class="pasta-dropzone-label">Arraste e solte o contrato</p>
                    <input type="file" id="contrato-input" name="contrato" accept=".pdf,.doc,.docx"
                           class="pasta-dropzone-input">
                </div>

                {# Lista de arquivos selecionados #}
                <ul class="pasta-file-list" id="contrato-file-list"></ul>
            </div>

            {# ══════════════════════════════════════════════ #}
            {# ABA 3 — CLIENTE                               #}
            {# ══════════════════════════════════════════════ #}
            <div class="pasta-tab-content" id="tab-cliente">
                <h2 class="pasta-section-title">Cliente</h2>
                <p class="text-muted">Esta seção será definida em breve.</p>
            </div>

            {# ══════════════════════════════════════════════ #}
            {# ABA 4 — PROCESSO                              #}
            {# ══════════════════════════════════════════════ #}
            <div class="pasta-tab-content" id="tab-processo">

                {# Campo oculto para armazenar processo_id após busca #}
                <input type="hidden" name="processo_id"
                       value="{{ pasta.processo is not null ? pasta.processo.id : '' }}">

                {# ── Sub-abas do processo ── #}
                <div class="subprocesso-tabs">
                    <button type="button" class="subprocesso-tab active" data-subtab="sproc-info">
                        <i class="bi bi-info-circle me-1"></i> Informações
                    </button>
                    <button type="button" class="subprocesso-tab" data-subtab="sproc-partes">
                        <i class="bi bi-people me-1"></i> Partes
                    </button>
                    <button type="button" class="subprocesso-tab" data-subtab="sproc-movimentacoes">
                        <i class="bi bi-clock-history me-1"></i> Movimentações
                    </button>
                </div>

                {# ── SUB-ABA: Informações do Processo ── #}
                <div class="subprocesso-tab-content active" id="tab-sproc-info">
                <div class="card card-primary card-outline mb-0 border-top-0 rounded-top-0">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label for="numeroProcesso" class="form-label">
                                    Número do Processo <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="numeroProcesso" name="numeroProcesso" class="form-control"
                                       placeholder="Ex: 1234567-89.2024.1.23.4567"
                                       value="{{ pasta.processo is not null ? pasta.processo.numeroProcesso : '' }}">
                                <div class="form-text">Formato: NNNNNNN-DD.AAAA.J.TT.OOOO</div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button id="btn-datajud" type="button" class="btn btn-info w-100"
                                        data-bs-toggle="tooltip" title="Busca o processo na base de dados do CNJ">
                                    <i class="bi bi-search me-1"></i> Buscar no CNJ
                                </button>
                            </div>
                            <div class="col-md-6">
                                <label for="siglaTribunal" class="form-label">
                                    Sigla do Tribunal <span class="text-danger">*</span>
                                </label>
                                <select id="siglaTribunal" name="siglaTribunal" class="form-select select2-tribunal">
                                    <optgroup label="Tribunais Superiores">
                                        <option value="tst">TST - Tribunal Superior do Trabalho</option>
                                        <option value="tse">TSE - Tribunal Superior Eleitoral</option>
                                        <option value="stj">STJ - Superior Tribunal de Justiça</option>
                                        <option value="stm">STM - Superior Tribunal Militar</option>
                                    </optgroup>
                                    <optgroup label="Justiça Federal">
                                        <option value="trf1">TRF1 - Tribunal Regional Federal 1ª Região</option>
                                        <option value="trf2">TRF2 - Tribunal Regional Federal 2ª Região</option>
                                        <option value="trf3">TRF3 - Tribunal Regional Federal 3ª Região</option>
                                        <option value="trf4">TRF4 - Tribunal Regional Federal 4ª Região</option>
                                        <option value="trf5">TRF5 - Tribunal Regional Federal 5ª Região</option>
                                        <option value="trf6">TRF6 - Tribunal Regional Federal 6ª Região</option>
                                    </optgroup>
                                    <optgroup label="Justiça Estadual">
                                        <option value="tjac">TJAC - Tribunal de Justiça do Acre</option>
                                        <option value="tjal">TJAL - Tribunal de Justiça de Alagoas</option>
                                        <option value="tjam">TJAM - Tribunal de Justiça do Amazonas</option>
                                        <option value="tjap">TJAP - Tribunal de Justiça de Amapá</option>
                                        <option value="tjba">TJBA - Tribunal de Justiça da Bahia</option>
                                        <option value="tjce">TJCE - Tribunal de Justiça do Ceará</option>
                                        <option value="tjdft" {% if (pasta.processo is not null ? pasta.processo.siglaTribunal : 'tjdft') == 'tjdft' %}selected{% endif %}>TJDFT - Tribunal de Justiça do Distrito Federal e Territórios</option>
                                        <option value="tjes">TJES - Tribunal de Justiça do Espírito Santo</option>
                                        <option value="tjgo">TJGO - Tribunal de Justiça de Goiás</option>
                                        <option value="tjma">TJMA - Tribunal de Justiça do Maranhão</option>
                                        <option value="tjmg">TJMG - Tribunal de Justiça de Minas Gerais</option>
                                        <option value="tjms">TJMS - Tribunal de Justiça do Mato Grosso do Sul</option>
                                        <option value="tjmt">TJMT - Tribunal de Justiça do Mato Grosso</option>
                                        <option value="tjpa">TJPA - Tribunal de Justiça do Pará</option>
                                        <option value="tjpb">TJPB - Tribunal de Justiça da Paraíba</option>
                                        <option value="tjpe">TJPE - Tribunal de Justiça de Pernambuco</option>
                                        <option value="tjpi">TJPI - Tribunal de Justiça do Piauí</option>
                                        <option value="tjpr">TJPR - Tribunal de Justiça do Paraná</option>
                                        <option value="tjrj">TJRJ - Tribunal de Justiça do Rio de Janeiro</option>
                                        <option value="tjrn">TJRN - Tribunal de Justiça do Rio Grande do Norte</option>
                                        <option value="tjro">TJRO - Tribunal de Justiça de Rondônia</option>
                                        <option value="tjrr">TJRR - Tribunal de Justiça de Roraima</option>
                                        <option value="tjrs">TJRS - Tribunal de Justiça do Rio Grande do Sul</option>
                                        <option value="tjsc">TJSC - Tribunal de Justiça de Santa Catarina</option>
                                        <option value="tjse">TJSE - Tribunal de Justiça de Sergipe</option>
                                        <option value="tjsp">TJSP - Tribunal de Justiça de São Paulo</option>
                                        <option value="tjto">TJTO - Tribunal de Justiça do Tocantins</option>
                                    </optgroup>
                                    <optgroup label="Justiça do Trabalho">
                                        <option value="trt1">TRT1 - Tribunal Regional do Trabalho 1ª Região</option>
                                        <option value="trt2">TRT2 - Tribunal Regional do Trabalho 2ª Região</option>
                                        <option value="trt3">TRT3 - Tribunal Regional do Trabalho 3ª Região</option>
                                        <option value="trt4">TRT4 - Tribunal Regional do Trabalho 4ª Região</option>
                                        <option value="trt5">TRT5 - Tribunal Regional do Trabalho 5ª Região</option>
                                        <option value="trt6">TRT6 - Tribunal Regional do Trabalho 6ª Região</option>
                                        <option value="trt7">TRT7 - Tribunal Regional do Trabalho 7ª Região</option>
                                        <option value="trt8">TRT8 - Tribunal Regional do Trabalho 8ª Região</option>
                                        <option value="trt9">TRT9 - Tribunal Regional do Trabalho 9ª Região</option>
                                        <option value="trt10">TRT10 - Tribunal Regional do Trabalho 10ª Região</option>
                                        <option value="trt11">TRT11 - Tribunal Regional do Trabalho 11ª Região</option>
                                        <option value="trt12">TRT12 - Tribunal Regional do Trabalho 12ª Região</option>
                                        <option value="trt13">TRT13 - Tribunal Regional do Trabalho 13ª Região</option>
                                        <option value="trt14">TRT14 - Tribunal Regional do Trabalho 14ª Região</option>
                                        <option value="trt15">TRT15 - Tribunal Regional do Trabalho 15ª Região</option>
                                        <option value="trt16">TRT16 - Tribunal Regional do Trabalho 16ª Região</option>
                                        <option value="trt17">TRT17 - Tribunal Regional do Trabalho 17ª Região</option>
                                        <option value="trt18">TRT18 - Tribunal Regional do Trabalho 18ª Região</option>
                                        <option value="trt19">TRT19 - Tribunal Regional do Trabalho 19ª Região</option>
                                        <option value="trt20">TRT20 - Tribunal Regional do Trabalho 20ª Região</option>
                                        <option value="trt21">TRT21 - Tribunal Regional do Trabalho 21ª Região</option>
                                        <option value="trt22">TRT22 - Tribunal Regional do Trabalho 22ª Região</option>
                                        <option value="trt23">TRT23 - Tribunal Regional do Trabalho 23ª Região</option>
                                        <option value="trt24">TRT24 - Tribunal Regional do Trabalho 24ª Região</option>
                                    </optgroup>
                                    <optgroup label="Justiça Eleitoral">
                                        <option value="tre-ac">TRE-AC - Tribunal Regional Eleitoral do Acre</option>
                                        <option value="tre-al">TRE-AL - Tribunal Regional Eleitoral de Alagoas</option>
                                        <option value="tre-am">TRE-AM - Tribunal Regional Eleitoral do Amazonas</option>
                                        <option value="tre-ap">TRE-AP - Tribunal Regional Eleitoral de Amapá</option>
                                        <option value="tre-ba">TRE-BA - Tribunal Regional Eleitoral da Bahia</option>
                                        <option value="tre-ce">TRE-CE - Tribunal Regional Eleitoral do Ceará</option>
                                        <option value="tre-dft">TRE-DFT - Tribunal Regional Eleitoral do DF</option>
                                        <option value="tre-es">TRE-ES - Tribunal Regional Eleitoral do Espírito Santo</option>
                                        <option value="tre-go">TRE-GO - Tribunal Regional Eleitoral de Goiás</option>
                                        <option value="tre-ma">TRE-MA - Tribunal Regional Eleitoral do Maranhão</option>
                                        <option value="tre-mg">TRE-MG - Tribunal Regional Eleitoral de Minas Gerais</option>
                                        <option value="tre-ms">TRE-MS - Tribunal Regional Eleitoral do Mato Grosso do Sul</option>
                                        <option value="tre-mt">TRE-MT - Tribunal Regional Eleitoral do Mato Grosso</option>
                                        <option value="tre-pa">TRE-PA - Tribunal Regional Eleitoral do Pará</option>
                                        <option value="tre-pb">TRE-PB - Tribunal Regional Eleitoral da Paraíba</option>
                                        <option value="tre-pe">TRE-PE - Tribunal Regional Eleitoral de Pernambuco</option>
                                        <option value="tre-pi">TRE-PI - Tribunal Regional Eleitoral do Piauí</option>
                                        <option value="tre-pr">TRE-PR - Tribunal Regional Eleitoral do Paraná</option>
                                        <option value="tre-rj">TRE-RJ - Tribunal Regional Eleitoral do Rio de Janeiro</option>
                                        <option value="tre-rn">TRE-RN - Tribunal Regional Eleitoral do Rio Grande do Norte</option>
                                        <option value="tre-ro">TRE-RO - Tribunal Regional Eleitoral de Rondônia</option>
                                        <option value="tre-rr">TRE-RR - Tribunal Regional Eleitoral de Roraima</option>
                                        <option value="tre-rs">TRE-RS - Tribunal Regional Eleitoral do Rio Grande do Sul</option>
                                        <option value="tre-sc">TRE-SC - Tribunal Regional Eleitoral de Santa Catarina</option>
                                        <option value="tre-se">TRE-SE - Tribunal Regional Eleitoral de Sergipe</option>
                                        <option value="tre-sp">TRE-SP - Tribunal Regional Eleitoral de São Paulo</option>
                                        <option value="tre-to">TRE-TO - Tribunal Regional Eleitoral do Tocantins</option>
                                    </optgroup>
                                    <optgroup label="Justiça Militar">
                                        <option value="tjmmg">TJMMG - Tribunal de Justiça Militar de Minas Gerais</option>
                                        <option value="tjmrs">TJMRS - Tribunal de Justiça Militar do Rio Grande do Sul</option>
                                        <option value="tjmsp">TJMSP - Tribunal de Justiça Militar de São Paulo</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="orgaoJulgador" class="form-label">
                                    Órgão Julgador <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="orgaoJulgador" name="orgaoJulgador" class="form-control"
                                       value="{{ pasta.processo is not null ? pasta.processo.orgaoJulgador : '' }}">
                            </div>
                            <div class="col-md-6">
                                <label for="classeProcessual" class="form-label">
                                    Classe Processual <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="classeProcessual" name="classeProcessual" class="form-control"
                                       value="{{ pasta.processo is not null ? pasta.processo.classeProcessual : '' }}">
                            </div>
                            <div class="col-md-6">
                                <label for="assuntoProcessual" class="form-label">
                                    Assunto Processual <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="assuntoProcessual" name="assuntoProcessual" class="form-control"
                                       value="{{ pasta.processo is not null ? pasta.processo.assuntoProcessual : '' }}">
                            </div>
                            <div class="col-md-4">
                                <label for="situacaoProcesso" class="form-label">
                                    Situação <span class="text-danger">*</span>
                                </label>
                                <select id="situacaoProcesso" name="situacaoProcesso" class="form-select">
                                    <option value="EM_ANDAMENTO" {% if (pasta.processo is not null ? pasta.processo.situacaoProcesso : 'EM_ANDAMENTO') == 'EM_ANDAMENTO' %}selected{% endif %}>Em Andamento</option>
                                    <option value="ENCERRADO" {% if pasta.processo is not null and pasta.processo.situacaoProcesso == 'ENCERRADO' %}selected{% endif %}>Encerrado</option>
                                    <option value="SUSPENSO" {% if pasta.processo is not null and pasta.processo.situacaoProcesso == 'SUSPENSO' %}selected{% endif %}>Suspenso</option>
                                    <option value="PARALISADO" {% if pasta.processo is not null and pasta.processo.situacaoProcesso == 'PARALISADO' %}selected{% endif %}>Paralisado</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="instancia" class="form-label">
                                    Instância <span class="text-danger">*</span>
                                </label>
                                <select id="instancia" name="instancia" class="form-select">
                                    <option value="G1" {% if (pasta.processo is not null ? pasta.processo.instancia : 'G1') == 'G1' %}selected{% endif %}>G1 - Primeira Instância</option>
                                    <option value="G2" {% if pasta.processo is not null and pasta.processo.instancia == 'G2' %}selected{% endif %}>G2 - Segunda Instância</option>
                                    <option value="ST" {% if pasta.processo is not null and pasta.processo.instancia == 'ST' %}selected{% endif %}>ST - Superior Tribunal</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="dataDistribuicao" class="form-label">Data de Distribuição</label>
                                <input type="date" id="dataDistribuicao" name="dataDistribuicao" class="form-control"
                                       value="{{ pasta.processo is not null and pasta.processo.dataDistribuicao is not null ? pasta.processo.dataDistribuicao|date('Y-m-d') : '' }}">
                            </div>
                            <div class="col-md-4">
                                <label for="dataBaixa" class="form-label">Data de Baixa</label>
                                <input type="date" id="dataBaixa" name="dataBaixa" class="form-control"
                                       value="{{ pasta.processo is not null and pasta.processo.dataBaixa is not null ? pasta.processo.dataBaixa|date('Y-m-d') : '' }}">
                            </div>
                        </div>
                    </div>
                </div>
                </div>{# fim tab-sproc-info #}

                {# ── SUB-ABA: Partes do Processo ── #}
                <div class="subprocesso-tab-content" id="tab-sproc-partes">
                <div class="card card-outline card-warning mb-0 border-top-0 rounded-top-0">
                    <div class="card-header d-flex justify-content-between align-items-center border-top-0">
                        <button type="button" id="btn-add-parte" class="btn btn-sm btn-warning ms-auto">
                            <i class="bi bi-plus-lg me-1"></i> Adicionar Parte
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="partesContainer">
                            {% if pasta.processo is not null and pasta.processo.partes|length > 0 %}
                                {% for parte in pasta.processo.partes %}
                                    <div class="parte-row card mb-2 p-3" style="position: relative;">
                                        <input type="hidden" name="partes[{{ loop.index0 }}][id]" value="{{ parte.id }}">
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label class="form-label">Tipo</label>
                                                <select name="partes[{{ loop.index0 }}][tipo]" class="form-select">
                                                    <option value="PARTE" {% if parte.tipo == 'PARTE' %}selected{% endif %}>Parte</option>
                                                    <option value="ADVOGADO" {% if parte.tipo == 'ADVOGADO' %}selected{% endif %}>Advogado</option>
                                                    <option value="JUIZ" {% if parte.tipo == 'JUIZ' %}selected{% endif %}>Juiz</option>
                                                    <option value="PROMOTOR" {% if parte.tipo == 'PROMOTOR' %}selected{% endif %}>Promotor</option>
                                                </select>
                                            </div>
                                            <div class="col-md-5">
                                                <label class="form-label">Nome</label>
                                                <input type="text" name="partes[{{ loop.index0 }}][nome]" class="form-control parte-nome"
                                                       placeholder="Nome da parte" value="{{ parte.nome }}">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Documento</label>
                                                <input type="text" name="partes[{{ loop.index0 }}][documento]" class="form-control"
                                                       placeholder="CPF/CNPJ" value="{{ parte.documento ?: '' }}">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Papel</label>
                                                <input type="text" name="partes[{{ loop.index0 }}][papel]" class="form-control"
                                                       placeholder="Polo ativo/passivo" value="{{ parte.papel ?: '' }}">
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-parte"
                                                style="display: {{ pasta.processo.partes|length > 1 ? 'block' : 'none' }}; position: absolute; top: 8px; right: 12px;"
                                                title="Remover"><i class="bi bi-trash"></i></button>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="parte-row card mb-2 p-3" style="position: relative;">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label">Tipo</label>
                                            <select name="partes[0][tipo]" class="form-select">
                                                <option value="PARTE">Parte</option>
                                                <option value="ADVOGADO">Advogado</option>
                                                <option value="JUIZ">Juiz</option>
                                                <option value="PROMOTOR">Promotor</option>
                                            </select>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label">Nome</label>
                                            <input type="text" name="partes[0][nome]" class="form-control parte-nome" placeholder="Nome da parte">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Documento</label>
                                            <input type="text" name="partes[0][documento]" class="form-control" placeholder="CPF/CNPJ">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Papel</label>
                                            <input type="text" name="partes[0][papel]" class="form-control" placeholder="Polo ativo/passivo">
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-parte"
                                            style="display: none; position: absolute; top: 8px; right: 12px;"
                                            title="Remover"><i class="bi bi-trash"></i></button>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                </div>{# fim tab-sproc-partes #}

                {# ── SUB-ABA: Movimentações ── #}
                <div class="subprocesso-tab-content" id="tab-sproc-movimentacoes">
                <div class="card card-outline card-info mb-0 border-top-0 rounded-top-0">
                    <div class="card-header d-flex justify-content-between align-items-center border-top-0">
                        <button type="button" id="btn-add-movimentacao" class="btn btn-sm btn-info ms-auto">
                            <i class="bi bi-plus-lg me-1"></i> Adicionar Movimentação
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="movimentacoesContainer">
                            {% if pasta.processo is not null and pasta.processo.movimentacoes|length > 0 %}
                                {% set movimentacoesOrdenadas = pasta.processo.movimentacoes|sort((a, b) => b.dataMovimentacao <=> a.dataMovimentacao) %}
                                {% for mov in movimentacoesOrdenadas %}
                                    <div class="movimentacao-row card mb-2 p-3" style="position: relative;">
                                        <input type="hidden" name="movimentacoes[{{ loop.index0 }}][id]" value="{{ mov.id }}">
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label class="form-label">Data</label>
                                                <input type="date" name="movimentacoes[{{ loop.index0 }}][dataMovimentacao]" class="form-control"
                                                       value="{{ mov.dataMovimentacao ? mov.dataMovimentacao|date('Y-m-d') : '' }}">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Descrição</label>
                                                <input type="text" name="movimentacoes[{{ loop.index0 }}][descricao]" class="form-control mov-descricao"
                                                       placeholder="Descrição da movimentação" value="{{ mov.descricao }}" required>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Tipo</label>
                                                <input type="text" name="movimentacoes[{{ loop.index0 }}][tipo]" class="form-control"
                                                       placeholder="Tipo de movimento" value="{{ mov.tipo ?: '' }}">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Órgão</label>
                                                <input type="text" name="movimentacoes[{{ loop.index0 }}][orgao]" class="form-control"
                                                       placeholder="Órgão" value="{{ mov.orgao ?: '' }}">
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"
                                                style="display: {{ pasta.processo.movimentacoes|length > 1 ? 'block' : 'none' }}; position: absolute; top: 8px; right: 12px;"
                                                title="Remover"><i class="bi bi-trash"></i></button>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="movimentacao-row card mb-2 p-3" style="position: relative;">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label">Data</label>
                                            <input type="date" name="movimentacoes[0][dataMovimentacao]" class="form-control">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Descrição</label>
                                            <input type="text" name="movimentacoes[0][descricao]" class="form-control mov-descricao"
                                                   placeholder="Descrição da movimentação" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Tipo</label>
                                            <input type="text" name="movimentacoes[0][tipo]" class="form-control" placeholder="Tipo de movimento">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Órgão</label>
                                            <input type="text" name="movimentacoes[0][orgao]" class="form-control" placeholder="Órgão">
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"
                                            style="display: none; position: absolute; top: 8px; right: 12px;"
                                            title="Remover"><i class="bi bi-trash"></i></button>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                </div>{# fim tab-sproc-movimentacoes #}

            </div>{# fim tab-processo #}

            {# ── Rodapé com ações ── #}
            <div class="pasta-footer">
                <a href="{{ isEdit ? path('pasta_show', {id: pasta.id}) : path('expediente_index') }}"
                   class="btn btn-secondary">
                    <i class="bi bi-x-lg me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    {{ isEdit ? 'Salvar Alterações' : 'Criar Pasta' }}
                </button>
            </div>

        </form>
    </div>
</section>

{# Modal de carregamento durante busca DataJud #}
<div id="loadingModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Buscando...</span>
                </div>
                <p class="mt-3">Buscando processo no DataJud...</p>
            </div>
        </div>
    </div>
</div>

{# Modal de Mensagens #}
<div id="feedbackModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div id="feedbackHeader" class="modal-header bg-secondary text-white">
                <h5 id="feedbackTitle" class="modal-title">Mensagem</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                <p id="feedbackMessage" class="mb-0"></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Barra de abas ──────────────────────────────────── */
.pasta-wizard-tabs {
    display: flex;
    border-bottom: 3px solid #1a6fa3;
    margin-bottom: 0;
    background: #fff;
}

.pasta-tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    padding: 10px 24px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #888;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    outline: none;
}

.pasta-tab:hover {
    color: #1a6fa3;
}

.pasta-tab.active {
    color: #1a6fa3;
    border-bottom-color: #1a6fa3;
}

/* ── Painel de conteúdo ─────────────────────────────── */
.pasta-tab-content {
    display: none;
    background: #e8eaec;
    min-height: 480px;
    padding: 32px 40px 28px;
}

.pasta-tab-content.active {
    display: block;
}

.pasta-section-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #333;
    margin-bottom: 28px;
}

/* ── Campos ─────────────────────────────────────────── */
.pasta-field-group {
    margin-bottom: 20px;
}

.pasta-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #444;
    margin-bottom: 6px;
}

.pasta-input {
    display: block;
    width: 100%;
    padding: 6px 8px;
    font-size: 0.85rem;
    background: #d6d8da;
    border: none;
    border-radius: 2px;
    color: #222;
    outline: none;
}

.pasta-input--short {
    width: 140px;
}

.pasta-input:focus {
    background: #cdd0d3;
    box-shadow: 0 0 0 2px rgba(26,111,163,0.25);
}

.pasta-textarea {
    display: block;
    width: 100%;
    padding: 8px;
    font-size: 0.85rem;
    background: #d6d8da;
    border: none;
    border-radius: 2px;
    color: #222;
    resize: vertical;
    outline: none;
}

.pasta-textarea:focus {
    background: #cdd0d3;
    box-shadow: 0 0 0 2px rgba(26,111,163,0.25);
}

/* ── Dropzone ───────────────────────────────────────── */
.pasta-dropzone {
    position: relative;
    background: #d6d8da;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 210px;
    max-width: 660px;
    cursor: pointer;
    transition: background 0.15s;
}

.pasta-dropzone:hover,
.pasta-dropzone.drag-over {
    background: #c8cbcd;
}

.pasta-dropzone-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
}

.pasta-dropzone-icon {
    font-size: 3rem;
    color: #555;
    margin-bottom: 12px;
}

.pasta-dropzone-label {
    font-size: 0.88rem;
    color: #555;
    margin: 0;
}

/* ── Lista de arquivos ──────────────────────────────── */
.pasta-file-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    max-width: 660px;
}

.pasta-file-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: #333;
    padding: 4px 0;
}

.pasta-file-name {
    flex: 1;
}

.pasta-file-remove {
    background: none;
    border: none;
    color: #c0392b;
    cursor: pointer;
    padding: 2px 4px;
    font-size: 0.85rem;
    line-height: 1;
}

.pasta-file-remove:hover {
    color: #922b21;
}


/* ── Sub-abas do processo ───────────────────────────── */
.subprocesso-tabs {
    display: flex;
    border-bottom: 2px solid #6c757d;
    background: #e8eaec;
    margin-bottom: 0;
}
.subprocesso-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    padding: 8px 18px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #888;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    outline: none;
}
.subprocesso-tab:hover { color: #495057; }
.subprocesso-tab.active { color: #495057; border-bottom-color: #495057; }
.subprocesso-tab-content { display: none; }
.subprocesso-tab-content.active { display: block; }
.subprocesso-tab-content .card { border-radius: 0 0 4px 4px; margin-bottom: 0; }

/* ── Rodapé ─────────────────────────────────────────── */
.pasta-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0 8px;
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {

    // ── Alternância de abas ──────────────────────────
    document.querySelectorAll('.pasta-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.pasta-tab').forEach(function (t) { t.classList.remove('active'); });
            document.querySelectorAll('.pasta-tab-content').forEach(function (c) { c.classList.remove('active'); });

            tab.classList.add('active');
            var painel = document.getElementById('tab-' + tab.dataset.tab);
            if (painel) painel.classList.add('active');
        });
    });

    // ── Alternância de sub-abas do processo ─────────
    document.querySelectorAll('.subprocesso-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.subprocesso-tab').forEach(function (t) { t.classList.remove('active'); });
            document.querySelectorAll('.subprocesso-tab-content').forEach(function (c) { c.classList.remove('active'); });
            tab.classList.add('active');
            var painel = document.getElementById('tab-' + tab.dataset.subtab);
            if (painel) painel.classList.add('active');
        });
    });

    // ── Dropzone do contrato ─────────────────────────
    var dropzone  = document.getElementById('contrato-dropzone');
    var fileInput = document.getElementById('contrato-input');
    var fileList  = document.getElementById('contrato-file-list');

    if (dropzone && fileInput) {
        dropzone.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropzone.classList.add('drag-over');
        });

        dropzone.addEventListener('dragleave', function () {
            dropzone.classList.remove('drag-over');
        });

        dropzone.addEventListener('drop', function (e) {
            e.preventDefault();
            dropzone.classList.remove('drag-over');
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                renderArquivos(e.dataTransfer.files);
            }
        });

        fileInput.addEventListener('change', function () {
            if (fileInput.files.length > 0) {
                renderArquivos(fileInput.files);
            }
        });
    }

    function renderArquivos(files) {
        // Remove entradas não-existentes anteriores
        fileList.querySelectorAll('.pasta-file-item:not([data-existing])').forEach(function (el) { el.remove(); });

        Array.from(files).forEach(function (file) {
            var li = document.createElement('li');
            li.className = 'pasta-file-item';
            li.innerHTML =
                '<i class="bi bi-file-earmark me-1"></i>' +
                '<span class="pasta-file-name">' + escapeHtml(file.name) + '</span>' +
                '<button type="button" class="pasta-file-remove" title="Remover"><i class="bi bi-trash"></i></button>';

            li.querySelector('.pasta-file-remove').addEventListener('click', function () {
                li.remove();
                fileInput.value = '';
            });

            fileList.appendChild(li);
        });
    }

    function escapeHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Select2 para tribunal ────────────────────────
    if (typeof $.fn.select2 !== 'undefined') {
        $('.select2-tribunal').select2({
            width: '100%',
            placeholder: 'Selecione um tribunal',
            language: { noResults: function() { return 'Nenhum tribunal encontrado'; } }
        });
        const initialTribunal = '{{ pasta.processo is not null ? pasta.processo.siglaTribunal : '' }}';
        $('#siglaTribunal').val(initialTribunal || 'tjdft').trigger('change');
    }

    // ── Adicionar parte ──────────────────────────────
    var btnAddParte = document.getElementById('btn-add-parte');
    if (btnAddParte) {
        btnAddParte.addEventListener('click', function() {
            var container = document.getElementById('partesContainer');
            var index = container.querySelectorAll('.parte-row').length;
            container.insertAdjacentHTML('beforeend',
                '<div class="parte-row card mb-2 p-3" style="position: relative;">' +
                    '<div class="row g-2">' +
                        '<div class="col-md-3"><label class="form-label">Tipo</label>' +
                            '<select name="partes[' + index + '][tipo]" class="form-select">' +
                                '<option value="PARTE">Parte</option>' +
                                '<option value="ADVOGADO">Advogado</option>' +
                                '<option value="JUIZ">Juiz</option>' +
                                '<option value="PROMOTOR">Promotor</option>' +
                            '</select></div>' +
                        '<div class="col-md-5"><label class="form-label">Nome</label>' +
                            '<input type="text" name="partes[' + index + '][nome]" class="form-control parte-nome" placeholder="Nome da parte"></div>' +
                        '<div class="col-md-2"><label class="form-label">Documento</label>' +
                            '<input type="text" name="partes[' + index + '][documento]" class="form-control" placeholder="CPF/CNPJ"></div>' +
                        '<div class="col-md-2"><label class="form-label">Papel</label>' +
                            '<input type="text" name="partes[' + index + '][papel]" class="form-control" placeholder="Polo ativo/passivo"></div>' +
                    '</div>' +
                    '<button type="button" class="btn btn-outline-danger btn-sm remove-parte"' +
                        ' style="position: absolute; top: 8px; right: 12px;" title="Remover"><i class="bi bi-trash"></i></button>' +
                '</div>'
            );
            attachRemoveParteListener();
        });
    }

    function attachRemoveParteListener() {
        document.querySelectorAll('.remove-parte').forEach(function(btn) {
            btn.removeEventListener('click', removeParteFn);
            btn.addEventListener('click', removeParteFn);
        });
        updateRemoveButtons();
    }

    function removeParteFn(e) {
        e.preventDefault();
        e.target.closest('.parte-row').remove();
        updateRemoveButtons();
    }

    // ── Adicionar movimentação ───────────────────────
    var btnAddMov = document.getElementById('btn-add-movimentacao');
    if (btnAddMov) {
        btnAddMov.addEventListener('click', function() {
            var container = document.getElementById('movimentacoesContainer');
            var index = container.querySelectorAll('.movimentacao-row').length;
            container.insertAdjacentHTML('beforeend',
                '<div class="movimentacao-row card mb-2 p-3" style="position: relative;">' +
                    '<div class="row g-2">' +
                        '<div class="col-md-3"><label class="form-label">Data</label>' +
                            '<input type="date" name="movimentacoes[' + index + '][dataMovimentacao]" class="form-control"></div>' +
                        '<div class="col-md-4"><label class="form-label">Descrição</label>' +
                            '<input type="text" name="movimentacoes[' + index + '][descricao]" class="form-control mov-descricao" placeholder="Descrição da movimentação" required></div>' +
                        '<div class="col-md-3"><label class="form-label">Tipo</label>' +
                            '<input type="text" name="movimentacoes[' + index + '][tipo]" class="form-control" placeholder="Tipo de movimento"></div>' +
                        '<div class="col-md-2"><label class="form-label">Órgão</label>' +
                            '<input type="text" name="movimentacoes[' + index + '][orgao]" class="form-control" placeholder="Órgão"></div>' +
                    '</div>' +
                    '<button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"' +
                        ' style="position: absolute; top: 8px; right: 12px;" title="Remover"><i class="bi bi-trash"></i></button>' +
                '</div>'
            );
            attachRemoveMovimentacaoListener();
            sortarMovimentacoesPorData();
        });
    }

    function attachRemoveMovimentacaoListener() {
        document.querySelectorAll('.remove-movimentacao').forEach(function(btn) {
            btn.removeEventListener('click', removeMovimentacaoFn);
            btn.addEventListener('click', removeMovimentacaoFn);
        });
        updateRemoveButtons();
    }

    function removeMovimentacaoFn(e) {
        e.preventDefault();
        e.target.closest('.movimentacao-row').remove();
        updateRemoveButtons();
    }

    function updateRemoveButtons() {
        var partes = document.querySelectorAll('.parte-row').length;
        document.querySelectorAll('.remove-parte').forEach(function(btn) {
            btn.style.display = partes > 1 ? 'block' : 'none';
        });
        var movs = document.querySelectorAll('.movimentacao-row').length;
        document.querySelectorAll('.remove-movimentacao').forEach(function(btn) {
            btn.style.display = movs > 1 ? 'block' : 'none';
        });
    }

    function sortarMovimentacoesPorData() {
        var container = document.getElementById('movimentacoesContainer');
        if (!container) { return; }
        var movimentacoes = Array.from(container.querySelectorAll('.movimentacao-row'));
        movimentacoes.sort(function(a, b) {
            var dataA = a.querySelector('input[name*="dataMovimentacao"]').value;
            var dataB = b.querySelector('input[name*="dataMovimentacao"]').value;
            if (!dataA && !dataB) { return 0; }
            if (!dataA) { return 1; }
            if (!dataB) { return -1; }
            return new Date(dataB) - new Date(dataA);
        });
        movimentacoes.forEach(function(mov, idx) {
            container.appendChild(mov);
            mov.querySelectorAll('input, select').forEach(function(field) {
                var name = field.getAttribute('name');
                if (name) { field.setAttribute('name', name.replace(/\[\d+\]/, '[' + idx + ']')); }
            });
        });
    }

    function showFeedbackModal(type, message) {
        var modalElement = document.getElementById('feedbackModal');
        var headerElement = document.getElementById('feedbackHeader');
        var titleElement = document.getElementById('feedbackTitle');
        var messageElement = document.getElementById('feedbackMessage');
        var styles = {
            success: { title: 'Sucesso', headerClass: 'modal-header bg-success text-white' },
            warning: { title: 'Atenção', headerClass: 'modal-header bg-warning text-dark' },
            error:   { title: 'Erro',    headerClass: 'modal-header bg-danger text-white' }
        };
        var selectedStyle = styles[type] || styles.error;
        headerElement.className = selectedStyle.headerClass;
        titleElement.textContent = selectedStyle.title;
        messageElement.innerHTML = message;
        new bootstrap.Modal(modalElement).show();
    }

    // ── Buscar no DataJud ────────────────────────────
    var btnDataJud = document.getElementById('btn-datajud');
    if (btnDataJud) {
        btnDataJud.addEventListener('click', async function(e) {
            e.preventDefault();
            var numeroProcesso = document.getElementById('numeroProcesso').value;
            var siglaTribunal  = document.getElementById('siglaTribunal').value;
            if (!numeroProcesso) { showFeedbackModal('warning', 'Informe o número do processo.'); return; }
            if (!siglaTribunal)  { showFeedbackModal('warning', 'Informe a sigla do tribunal.'); return; }

            var modal = new bootstrap.Modal(document.getElementById('loadingModal'));
            modal.show();

            try {
                var response = await fetch('{{ path("api_datajud_search") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ numeroProcesso: numeroProcesso, tribunalAlias: siglaTribunal.toLowerCase() })
                });
                var data = await response.json();
                modal.hide();

                if (!response.ok || !data.success) {
                    showFeedbackModal('error', data.error || 'Erro ao buscar processo no CNJ/DataJud.');
                    return;
                }

                var processData = data.data;
                document.getElementById('orgaoJulgador').value     = processData.orgaoJulgador || '';
                document.getElementById('classeProcessual').value  = processData.classeProcessual || '';
                document.getElementById('assuntoProcessual').value = processData.assuntoProcessual || '';
                document.getElementById('situacaoProcesso').value  = processData.situacaoProcesso || 'EM_ANDAMENTO';
                document.getElementById('instancia').value         = processData.instancia || 'G1';
                document.getElementById('dataDistribuicao').value  = processData.dataDistribuicao || '';
                document.getElementById('dataBaixa').value         = processData.dataBaixa || '';

                var partesContainer = document.getElementById('partesContainer');
                partesContainer.innerHTML = '';
                var partesList = processData.partes && processData.partes.length > 0 ? processData.partes : [{}];
                partesList.forEach(function(parte, idx) {
                    partesContainer.insertAdjacentHTML('beforeend',
                        '<div class="parte-row card mb-2 p-3" style="position: relative;">' +
                            '<div class="row g-2">' +
                                '<div class="col-md-3"><label class="form-label">Tipo</label>' +
                                    '<select name="partes[' + idx + '][tipo]" class="form-select">' +
                                        '<option value="PARTE" ' + ((parte.tipo||'') === 'PARTE' ? 'selected' : '') + '>Parte</option>' +
                                        '<option value="ADVOGADO" ' + ((parte.tipo||'') === 'ADVOGADO' ? 'selected' : '') + '>Advogado</option>' +
                                        '<option value="JUIZ" ' + ((parte.tipo||'') === 'JUIZ' ? 'selected' : '') + '>Juiz</option>' +
                                        '<option value="PROMOTOR" ' + ((parte.tipo||'') === 'PROMOTOR' ? 'selected' : '') + '>Promotor</option>' +
                                    '</select></div>' +
                                '<div class="col-md-5"><label class="form-label">Nome</label>' +
                                    '<input type="text" name="partes[' + idx + '][nome]" class="form-control parte-nome"' +
                                    ' value="' + escapeHtml(parte.nome || '') + '" placeholder="Nome da parte"></div>' +
                                '<div class="col-md-2"><label class="form-label">Documento</label>' +
                                    '<input type="text" name="partes[' + idx + '][documento]" class="form-control"' +
                                    ' value="' + escapeHtml(parte.documento || '') + '" placeholder="CPF/CNPJ"></div>' +
                                '<div class="col-md-2"><label class="form-label">Papel</label>' +
                                    '<input type="text" name="partes[' + idx + '][papel]" class="form-control"' +
                                    ' value="' + escapeHtml(parte.papel || '') + '" placeholder="Polo ativo/passivo"></div>' +
                            '</div>' +
                            '<button type="button" class="btn btn-outline-danger btn-sm remove-parte"' +
                            ' style="display: ' + (partesList.length > 1 ? 'block' : 'none') + '; position: absolute; top: 8px; right: 12px;"' +
                            ' title="Remover"><i class="bi bi-trash"></i></button>' +
                        '</div>'
                    );
                });

                var movimentacoesContainer = document.getElementById('movimentacoesContainer');
                movimentacoesContainer.innerHTML = '';
                var movsList = processData.movimentacoes && processData.movimentacoes.length > 0 ? processData.movimentacoes : [{}];
                movsList.forEach(function(mov, idx) {
                    movimentacoesContainer.insertAdjacentHTML('beforeend',
                        '<div class="movimentacao-row card mb-2 p-3" style="position: relative;">' +
                            '<div class="row g-2">' +
                                '<div class="col-md-3"><label class="form-label">Data</label>' +
                                    '<input type="date" name="movimentacoes[' + idx + '][dataMovimentacao]" class="form-control"' +
                                    ' value="' + escapeHtml(mov.dataMovimentacao || '') + '"></div>' +
                                '<div class="col-md-4"><label class="form-label">Descrição</label>' +
                                    '<input type="text" name="movimentacoes[' + idx + '][descricao]" class="form-control mov-descricao"' +
                                    ' value="' + escapeHtml(mov.descricao || '') + '" placeholder="Descrição da movimentação" required></div>' +
                                '<div class="col-md-3"><label class="form-label">Tipo</label>' +
                                    '<input type="text" name="movimentacoes[' + idx + '][tipo]" class="form-control"' +
                                    ' value="' + escapeHtml(mov.tipo || '') + '" placeholder="Tipo de movimento"></div>' +
                                '<div class="col-md-2"><label class="form-label">Órgão</label>' +
                                    '<input type="text" name="movimentacoes[' + idx + '][orgao]" class="form-control"' +
                                    ' value="' + escapeHtml(mov.orgao || '') + '" placeholder="Órgão"></div>' +
                            '</div>' +
                            '<button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"' +
                            ' style="display: ' + (movsList.length > 1 ? 'block' : 'none') + '; position: absolute; top: 8px; right: 12px;"' +
                            ' title="Remover"><i class="bi bi-trash"></i></button>' +
                        '</div>'
                    );
                });

                attachRemoveParteListener();
                attachRemoveMovimentacaoListener();
                sortarMovimentacoesPorData();
                showFeedbackModal('success', 'Processo carregado com sucesso! Os dados foram preenchidos no formulário. Você pode editá-los antes de salvar.');

            } catch (error) {
                var loadingModal = document.getElementById('loadingModal');
                if (loadingModal) { bootstrap.Modal.getInstance(loadingModal)?.hide(); }
                showFeedbackModal('error', 'Erro ao buscar processo no CNJ/DataJud. Tente novamente em instantes.');
            }
        });
    }

    attachRemoveParteListener();
    attachRemoveMovimentacaoListener();
    sortarMovimentacoesPorData();
});
</script>
{% endblock %}
