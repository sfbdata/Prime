{% set acaoTexto = pasta.nomeAcao
    ?: (pasta.processoPrincipal
        ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso)
        : null) %}
{% set clienteTexto = pasta.clientes|length > 0 ? pasta.clientes[0].nomeExibicao : (pasta.nomeCliente ?: 'Cliente não informado') %}
{% set tarefasAbertas = pasta.tarefas|filter(t => t.status != 'concluida') %}
{% set tarefasAtrasadas = tarefasAbertas|filter(t => t.prazo and t.prazo < date()) %}
{% set tarefasComPrazo = tarefasAbertas|filter(t => t.prazo)|sort((a, b) => a.prazo <=> b.prazo) %}
{% set proximoPrazo = tarefasComPrazo|first %}
{% set ultimaAtividade = pasta.modificadoEm ?: pasta.criadoEm %}
{% set diasAtividade = date().diff(ultimaAtividade).days %}

<article class="pasta-card pasta-row-link pasta-prio-{{ pasta.prioridade.value }}"
         data-href="{{ path('pasta_show', {id: pasta.id}) }}">
    <div class="pasta-card-main">
        <div class="pasta-card-identity-wrap">
            <span class="pasta-card-file-icon" aria-hidden="true"><i class="bi bi-folder2-open"></i></span>
            <div class="pasta-card-identity">
                <div class="pasta-card-reference">
                    <span class="pasta-card-reference-label">NUP</span>
                    <span class="pasta-card-nup">{{ pasta.nup }}</span>
                </div>
                <h3 class="pasta-card-cliente">
                    {{ clienteTexto }}
                    {% if pasta.clientes|length > 1 %}<small>+{{ pasta.clientes|length - 1 }}</small>{% endif %}
                </h3>
                <p class="pasta-card-acao"><i class="bi bi-briefcase"></i>{{ acaoTexto ?: 'Assunto não informado' }}</p>
            </div>
        </div>

        <div class="pasta-card-flags">
            <span class="expediente-priority expediente-priority--{{ pasta.prioridade.value }}">
                {% if pasta.prioridade.value == 'urgente' %}<i class="bi bi-exclamation-triangle-fill"></i>{% else %}<i class="bi bi-flag"></i>{% endif %}
                {{ pasta.prioridadeLabel }}
            </span>
            <span class="expediente-status expediente-status--{{ pasta.situacao }}">
                <span class="expediente-status-dot" aria-hidden="true"></span>
                {{ pasta.situacao == 'ativo' ? 'Ativa' : 'Arquivada' }}
            </span>
            <a href="{{ path('pasta_show', {id: pasta.id}) }}" class="pasta-card-open-link" aria-label="Abrir pasta {{ pasta.nup }}">
                Abrir <i class="bi bi-arrow-up-right"></i>
            </a>
            <div class="dropdown pasta-card-menu-wrap">
                <button type="button" class="pasta-card-menu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ações da pasta {{ pasta.nup }}">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" href="{{ path('pasta_show', {id: pasta.id}) }}"><i class="bi bi-box-arrow-up-right me-2"></i>Abrir pasta</a>
                    <button type="button" class="dropdown-item js-mover-para"
                            data-pasta-id="{{ pasta.id }}" data-pasta-nome="{{ pasta.nup }}"
                            data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                            data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}">
                        <i class="bi bi-tags me-2"></i>Mover para marcador
                    </button>
                    <button type="button" class="dropdown-item js-toggle-situacao"
                            data-situacao="{{ pasta.situacao }}"
                            data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}"
                            data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}">
                        <i class="bi bi-archive me-2"></i>{{ pasta.situacao == 'ativo' ? 'Arquivar' : 'Reativar' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="pasta-card-operations">
        <div class="pasta-card-operation pasta-card-operation--responsavel pasta-responsavel-cel" data-pasta-id="{{ pasta.id }}">
            <span class="pasta-operation-label"><i class="bi bi-person"></i>Responsável</span>
            {{ include('pasta/_resp_chip.html.twig', {pasta: pasta, fotos: fotos|default({})}) }}
        </div>

        <div class="pasta-card-operation pasta-card-operation--prazo {{ proximoPrazo and proximoPrazo.prazo < date() ? 'is-critical' : '' }}">
            <span class="pasta-operation-label"><i class="bi bi-calendar-event"></i>Próximo prazo</span>
            {% if proximoPrazo %}
                <span class="pasta-operation-value"><i class="bi bi-calendar-event"></i>{{ proximoPrazo.prazo|date('d/m/Y') }}</span>
            {% else %}
                <span class="pasta-operation-muted">Sem prazo próximo</span>
            {% endif %}
        </div>

        <div class="pasta-card-operation pasta-card-operation--metas {{ tarefasAtrasadas|length > 0 ? 'is-critical' : '' }}">
            <span class="pasta-operation-label"><i class="bi bi-check2-square"></i>Metas</span>
            {% if tarefasAtrasadas|length > 0 %}
                <a href="{{ path('pasta_show', {id: pasta.id}) }}#tarefas" class="pasta-operation-alert">
                    {{ tarefasAtrasadas|length }} atrasada{{ tarefasAtrasadas|length != 1 ? 's' : '' }}
                </a>
            {% elseif tarefasAbertas|length > 0 %}
                <span class="pasta-operation-value">{{ tarefasAbertas|length }} em andamento</span>
            {% else %}
                <span class="pasta-operation-muted">Sem metas abertas</span>
            {% endif %}
        </div>

        <div class="pasta-card-operation pasta-card-operation--marcadores pasta-card-marc pasta-marcadores-col" data-pasta-id="{{ pasta.id }}">
            <span class="pasta-operation-label"><i class="bi bi-tags"></i>Marcadores</span>
            <div class="d-flex gap-1 align-items-center">
                {% if pasta.marcadores|length > 0 %}
                    {% set primeiro = pasta.marcadores|first %}
                    <span class="badge rounded-pill px-2 marcador-principal expediente-marker"
                          style="{% if primeiro.cor %}--marker-color:{{ primeiro.cor }};background:{{ primeiro.cor }};color:#333;border:1px solid rgba(0,0,0,.1);{% else %}background:var(--bs-tertiary-bg);color:var(--bs-body-color);{% endif %}">
                        {{ primeiro.nome }}
                    </span>
                    {% if pasta.marcadores|length > 1 %}
                        <span class="badge rounded-pill px-2 marcadores-extra expediente-marker-extra"
                              data-marcadores-json="{{ pasta.marcadores|slice(1)|map(m => {nome: m.nome, cor: m.cor})|json_encode }}">
                            +{{ pasta.marcadores|length - 1 }}
                        </span>
                    {% endif %}
                {% else %}
                    <span class="pasta-operation-muted">Sem marcador</span>
                {% endif %}
                <button type="button"
                        class="pasta-card-marker-action js-mover-para"
                        data-pasta-id="{{ pasta.id }}"
                        data-pasta-nome="{{ pasta.nup }}"
                        data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                        data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}"
                        title="Mover para marcador" aria-label="Mover pasta {{ pasta.nup }} para marcador">
                    <i class="bi bi-tags"></i>
                </button>
            </div>
        </div>

        <div class="pasta-card-operation pasta-card-operation--atividade pasta-card-activity">
            <span class="pasta-operation-label"><i class="bi bi-clock-history"></i>Última atividade</span>
            <span class="pasta-operation-value"><i class="bi bi-activity"></i>{% if diasAtividade == 0 %}Hoje{% elseif diasAtividade == 1 %}Há 1 dia{% else %}Há {{ diasAtividade }} dias{% endif %}</span>
        </div>
    </div>
</article>
