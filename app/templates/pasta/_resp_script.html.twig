{# Comportamento do chip de responsavel. Ja era escrito para reuso: delega tudo
   no document e guarda o bind em document.__pastaRespMenuBound, entao incluir em
   mais de uma pagina (ou duas vezes na mesma) nao duplica listener. #}
<script>
(function () {
    /* Chip de responsável (avatar + nome) + menu compartilhado #pastaRespMenu.
       Tudo delegado no document e guardado, porque este script re-executa a cada
       troca de resultados (busca ao vivo/paginação). O menu e os chips são
       re-renderizados pelo servidor, então buscamos sempre o DOM atual. */
    var chipAtivo = null;

    function escResp(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function avatarHtml(nome, fotoUrl) {
        var partes = String(nome).trim().split(/\s+/).filter(Boolean);
        var ini = (partes.length > 1 ? (partes[0][0] + partes[partes.length - 1][0]) : String(nome).slice(0, 2)).toUpperCase();
        if (fotoUrl) {
            return '<span class="resp-avatar resp-avatar-img" style="width:24px;height:24px;" data-ini="' + escResp(ini) + '">' +
                   '<img src="' + escResp(fotoUrl) + '" alt="" ' +
                   'onerror="this.parentNode.classList.remove(\'resp-avatar-img\');this.parentNode.classList.add(\'resp-avatar-ini\');this.parentNode.textContent=this.parentNode.dataset.ini;">' +
                   '</span>';
        }

        return '<span class="resp-avatar resp-avatar-ini" style="width:24px;height:24px;font-size:10px;">' + escResp(ini) + '</span>';
    }

    function renderChip(chip, userId, nome, fotoUrl) {
        chip.dataset.respId = userId || '';
        var html;
        if (userId) {
            html = avatarHtml(nome, fotoUrl) + '<span class="pasta-resp-nome">' + escResp(nome) + '</span>';
            chip.title = nome;
        } else {
            html = '<span class="resp-avatar resp-avatar-vazio" style="width:24px;height:24px;"><i class="bi bi-person"></i></span>' +
                   '<span class="pasta-resp-nome text-muted">Sem responsável</span>';
            chip.title = 'Definir responsável';
        }
        html += '<i class="bi bi-chevron-down pasta-resp-caret"></i>';
        chip.innerHTML = html;
    }

    /* Compara ignorando acento E caixa: 'jose' tem de achar 'José'. Sem isto a
       busca fica quebrada para metade dos nomes brasileiros. NFD separa a letra
       do acento e o replace descarta a marca solta. */
    function normalizar(txt) {
        return String(txt || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    }

    function opcoesVisiveis(menu) {
        return Array.prototype.filter.call(
            menu.querySelectorAll('.pasta-resp-opcao'),
            function (op) { return !op.hidden; }
        );
    }

    function marcar(menu, opcao) {
        menu.querySelectorAll('.pasta-resp-opcao.marcada').forEach(function (op) {
            op.classList.remove('marcada');
            op.setAttribute('aria-selected', 'false');
        });
        if (!opcao) return;
        opcao.classList.add('marcada');
        opcao.setAttribute('aria-selected', 'true');
        // Só rola quando o item marcado saiu de vista; scrollIntoView incondicional
        // faz a lista tremer a cada tecla.
        var lista = menu.querySelector('.pasta-resp-lista');
        if (!lista) return;
        var ro = opcao.getBoundingClientRect();
        var rl = lista.getBoundingClientRect();
        if (ro.top < rl.top)          lista.scrollTop -= (rl.top - ro.top);
        else if (ro.bottom > rl.bottom) lista.scrollTop += (ro.bottom - rl.bottom);
    }

    function filtrar(menu) {
        var campo = menu.querySelector('.pasta-resp-busca');
        var vazio = menu.querySelector('.pasta-resp-vazio');
        var termo = normalizar(campo ? campo.value : '');
        var achou = 0;

        menu.querySelectorAll('.pasta-resp-opcao').forEach(function (op) {
            var bate = !termo || normalizar(op.dataset.nome).indexOf(termo) !== -1;
            op.hidden = !bate;
            if (bate) achou++;
        });

        if (vazio) vazio.hidden = achou > 0;

        // Digitar troca quem sobrou: o marcado vai para o primeiro da lista nova,
        // senão o Enter escolheria alguém que o filtro acabou de esconder.
        var visiveis = opcoesVisiveis(menu);
        marcar(menu, visiveis.length ? visiveis[0] : null);

        // O menu ENCOLHE ao filtrar. Quando ele abriu para cima (chip perto do
        // rodapé), encolher deixaria um vão entre ele e o chip.
        if (chipAtivo) posicionar(menu, chipAtivo);
    }

    function limparBusca(menu) {
        var campo = menu.querySelector('.pasta-resp-busca');
        if (campo) campo.value = '';
        filtrar(menu);
    }

    function fecharMenu() {
        var menu = document.getElementById('pastaRespMenu');
        // chipAtivo zerado ANTES de limparBusca: filtrar() reposiciona usando ele,
        // e reposicionar um menu que acabou de fechar nao faz sentido.
        chipAtivo = null;
        if (menu) {
            menu.hidden = true;
            limparBusca(menu);
        }
    }

    function abrirMenu(chip) {
        var menu = document.getElementById('pastaRespMenu');
        if (!menu) return;
        chipAtivo = chip;
        var respId = chip.dataset.respId || '';
        menu.querySelectorAll('.pasta-resp-opcao').forEach(function (op) {
            op.classList.toggle('ativa', (op.dataset.userId || '') === respId);
        });
        menu.hidden = false;

        // Abre sempre limpo e ja marcando o primeiro, para o Enter ter alvo.
        limparBusca(menu);
        posicionar(menu, chip);

        /* Foco no campo e o que faz a busca ser "instantanea": abriu, ja digita.
           No celular NAO: daria foco a um input e abriria o teclado virtual por
           cima da propria lista que o usuario quer ler. */
        var campo = menu.querySelector('.pasta-resp-busca');
        var toque = window.matchMedia && window.matchMedia('(hover: none)').matches;
        if (campo && !toque) campo.focus();
    }

    function posicionar(menu, chip) {
        var r  = chip.getBoundingClientRect();
        var mw = menu.offsetWidth, mh = menu.offsetHeight;
        var left = r.left;
        var top  = r.bottom + 4;
        if (left + mw > window.innerWidth - 8)  left = window.innerWidth - 8 - mw;
        if (left < 8) left = 8;
        if (top + mh > window.innerHeight - 8)  top = r.top - mh - 4;
        if (top < 8) top = 8;
        menu.style.left = left + 'px';
        menu.style.top  = top + 'px';
    }

    function salvarResponsavel(chip, userId, nome, fotoUrl) {
        var prevHtml = chip.innerHTML;
        var prevId   = chip.dataset.respId || '';
        renderChip(chip, userId, nome, fotoUrl); // otimista
        chip.classList.add('salvando');

        var body = new URLSearchParams({ _token: chip.dataset.csrf, responsavel_id: userId || '' });
        fetch(chip.dataset.url, {
            method: 'PATCH',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            chip.classList.remove('salvando');
            if (!res.ok || !res.data.sucesso) {
                chip.innerHTML = prevHtml;
                chip.dataset.respId = prevId;
                alert((res.data && res.data.erro) || 'Erro ao alterar responsável.');
            }
        })
        .catch(function () {
            chip.classList.remove('salvando');
            chip.innerHTML = prevHtml;
            chip.dataset.respId = prevId;
        });
    }

    if (!document.__pastaRespMenuBound) {
        document.__pastaRespMenuBound = true;

        document.addEventListener('click', function (e) {
            var chip = e.target.closest('.pasta-resp-chip');
            if (chip) {
                e.preventDefault();
                var menu = document.getElementById('pastaRespMenu');
                if (menu && !menu.hidden && chipAtivo === chip) { fecharMenu(); return; }
                abrirMenu(chip);

                return;
            }

            var opc = e.target.closest('.pasta-resp-opcao');
            if (opc && chipAtivo) {
                e.preventDefault();
                var uid = opc.dataset.userId || '';
                if ((chipAtivo.dataset.respId || '') !== uid) {
                    salvarResponsavel(chipAtivo, uid, opc.dataset.nome || '', opc.dataset.foto || '');
                }
                fecharMenu();

                return;
            }

            if (!e.target.closest('#pastaRespMenu')) fecharMenu();
        });

        document.addEventListener('input', function (e) {
            if (e.target && e.target.classList && e.target.classList.contains('pasta-resp-busca')) {
                var menu = e.target.closest('.pasta-resp-menu');
                if (menu) filtrar(menu);
            }
        });

        document.addEventListener('keydown', function (e) {
            var menu = document.getElementById('pastaRespMenu');
            var aberto = menu && !menu.hidden;

            if (e.key === 'Escape') { fecharMenu(); return; }
            if (!aberto) return;

            // Setas andam so pelo que o filtro deixou visivel; Enter escolhe o
            // marcado. E o que o <select> nativo fazia e o chip tinha perdido.
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                var visiveis = opcoesVisiveis(menu);
                if (!visiveis.length) return;
                var atual = menu.querySelector('.pasta-resp-opcao.marcada');
                var i = visiveis.indexOf(atual);
                var passo = e.key === 'ArrowDown' ? 1 : -1;
                // Circula: descer no ultimo volta ao primeiro, e vice-versa.
                var prox = (i === -1)
                    ? (passo === 1 ? 0 : visiveis.length - 1)
                    : (i + passo + visiveis.length) % visiveis.length;
                marcar(menu, visiveis[prox]);
                return;
            }

            if (e.key === 'Enter') {
                var alvo = menu.querySelector('.pasta-resp-opcao.marcada');
                if (!alvo || !chipAtivo) return;
                e.preventDefault();
                if ((chipAtivo.dataset.respId || '') !== (alvo.dataset.userId || '')) {
                    salvarResponsavel(chipAtivo, alvo.dataset.userId || '',
                                      alvo.dataset.nome || '', alvo.dataset.foto || '');
                }
                fecharMenu();
            }
        });
        // Fecha ao rolar a PÁGINA (o menu é position:fixed e descolaria do chip),
        // mas não ao rolar DENTRO do próprio menu (lista de colaboradores rolável).
        document.addEventListener('scroll', function (e) {
            var alvo = e.target;
            if (alvo && alvo.nodeType === 1 && alvo.closest && alvo.closest('#pastaRespMenu')) return;
            fecharMenu();
        }, true);
        window.addEventListener('resize', fecharMenu);
    }
}());
</script>
