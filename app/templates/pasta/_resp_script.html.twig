{# Comportamento do chip de responsavel. Ja era escrito para reuso: delega tudo
   no document e guarda o bind em document.__pastaRespMenuBound, entao incluir em
   mais de uma pagina (ou duas vezes na mesma) nao duplica listener. #}
{# Textos do script abaixo; o BJ_T so e lido no clique, depois do bj-traducao.js do base. #}
{{ catalogo_js('pasta_resp.js.resp') }}
{# Confirmação da troca de responsável: L8 do desenho 03 (acesso-restrito-18-11-26, dc L517-523), com os valores do
   CSS do desenho. Prefixo próprio para não herdar o .modal/.btn do sistema. #}
<style>
.resp-troca-fundo { position: fixed; inset: 0; z-index: 9100; background: rgba(13,27,42,.45); display: flex; align-items: center; justify-content: center; padding: 14px; }
.resp-troca { width: min(470px,100%); background: #fff; border-radius: 4px; border-top: 4px solid #c08a12; box-shadow: 0 20px 50px -12px rgba(13,27,42,.45); padding: 18px 20px; display: flex; flex-direction: column; gap: 11px; font-size: 13.5px; color: #34505f; line-height: 1.5; text-align: left; }
.resp-troca-titulo { font-size: 16px; color: #12242f; font-weight: bold; }
.resp-troca-titulo .bi { color: #c08a12; }
.resp-troca-manter { display: flex; gap: 9px; align-items: flex-start; padding: 9px 10px; background: #f3f7fa; border-radius: 4px; cursor: pointer; margin: 0; font-weight: normal; }
.resp-troca-manter input { width: 16px; height: 16px; margin-top: 2px; accent-color: #0a6fa0; flex: none; }
.resp-troca-nota { font-size: 12px; color: #7a8e9b; }
.resp-troca-acoes { display: flex; gap: 8px; justify-content: flex-end; }
.resp-troca-acoes button { height: 38px; border: none; border-radius: 4px; font: inherit; font-size: 13.5px; font-weight: bold; cursor: pointer; }
.resp-troca-nao { padding: 0 14px; background: #e2e9ee; color: #243845; }
.resp-troca-sim { padding: 0 16px; background: #0a6fa0; color: #fff; }
.resp-troca-sim:hover { background: #2b7ab0; }
</style>
<script>
(function () {
    /* Chip de responsável (avatar + nome) + menu compartilhado #pastaRespMenu.
       Tudo delegado no document e guardado, porque este script re-executa a cada
       troca de resultados (busca ao vivo/paginação). O menu e os chips são
       re-renderizados pelo servidor, então buscamos sempre o DOM atual. */
    var chipAtivo = null;

    function escResp(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function avatarHtml(nome, fotoUrl) {
        var partes = String(nome).trim().split(/\s+/).filter(Boolean);
        var ini = (partes.length > 1 ? (partes[0][0] + partes[partes.length - 1][0]) : String(nome).slice(0, 2)).toUpperCase();
        if (fotoUrl) {
            return '<span class="resp-avatar resp-avatar-img" style="width:24px;height:24px;" data-ini="' + escResp(ini) + '">' +
                   '<img src="' + escResp(fotoUrl) + '" alt="" ' +
                   'onerror="this.parentNode.classList.remove(\'resp-avatar-img\');this.parentNode.classList.add(\'resp-avatar-ini\');this.parentNode.textContent=this.parentNode.dataset.ini;">' +
                   '</span>';
        }

        return '<span class="resp-avatar resp-avatar-ini" style="width:24px;height:24px;font-size:10px;">' + escResp(ini) + '</span>';
    }

    /* Na pasta, o title; no Expediente, a dica do desenho 03 pelo sistema de dicas da lista (`data-tip`). */
    function dica(chip, naPasta, noExpediente) {
        if (chip.dataset.contexto === 'pasta') { chip.title = naPasta; return; }
        chip.removeAttribute('title');
        chip.setAttribute('data-tip', noExpediente);
    }

    function renderChip(chip, userId, nome, fotoUrl) {
        chip.dataset.respId = userId || '';
        var html;
        if (userId) {
            html = avatarHtml(nome, fotoUrl) + '<span class="pasta-resp-nome">' + escResp(nome) + '</span>';
            dica(chip, nome, BJ_T.t('pasta_resp.js.resp.dica_alterar', { nome: nome }));
        } else {
            // PAS-013b: o chip vazio redesenhado é o MESMO que o _resp_chip monta no contexto
            // dele — na pasta `bi-person-dash` sem `.text-muted` (desenho); no Expediente como era.
            var naPasta = chip.dataset.contexto === 'pasta';
            html = '<span class="resp-avatar resp-avatar-vazio" style="width:24px;height:24px;"><i class="bi ' + (naPasta ? 'bi-person-dash' : 'bi-person') + '"></i></span>' +
                   '<span class="pasta-resp-nome' + (naPasta ? '' : ' text-muted') + '">' + escResp(BJ_T.t('pasta_resp.js.resp.sem_responsavel')) + '</span>';
            dica(chip, BJ_T.t('pasta_resp.js.resp.definir'), BJ_T.t('pasta_resp.js.resp.dica_atribuir'));
        }
        html += '<i class="bi bi-chevron-down pasta-resp-caret"></i>';
        chip.innerHTML = html;
    }

    /* Compara ignorando acento E caixa: 'jose' tem de achar 'José'. Sem isto a
       busca fica quebrada para metade dos nomes brasileiros. NFD separa a letra
       do acento e o replace descarta a marca solta. */
    function normalizar(txt) {
        return String(txt || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    }

    function opcoesVisiveis(menu) {
        return Array.prototype.filter.call(
            menu.querySelectorAll('.pasta-resp-opcao'),
            function (op) { return !op.hidden; }
        );
    }

    function marcar(menu, opcao) {
        menu.querySelectorAll('.pasta-resp-opcao.marcada').forEach(function (op) {
            op.classList.remove('marcada');
            op.setAttribute('aria-selected', 'false');
        });
        if (!opcao) return;
        opcao.classList.add('marcada');
        opcao.setAttribute('aria-selected', 'true');
        // Só rola quando o item marcado saiu de vista; scrollIntoView incondicional
        // faz a lista tremer a cada tecla.
        var lista = menu.querySelector('.pasta-resp-lista');
        if (!lista) return;
        var ro = opcao.getBoundingClientRect();
        var rl = lista.getBoundingClientRect();
        if (ro.top < rl.top)          lista.scrollTop -= (rl.top - ro.top);
        else if (ro.bottom > rl.bottom) lista.scrollTop += (ro.bottom - rl.bottom);
    }

    function filtrar(menu) {
        var campo = menu.querySelector('.pasta-resp-busca');
        var vazio = menu.querySelector('.pasta-resp-vazio');
        var termo = normalizar(campo ? campo.value : '');
        var achou = 0;

        menu.querySelectorAll('.pasta-resp-opcao').forEach(function (op) {
            var bate = !termo || normalizar(op.dataset.nome).indexOf(termo) !== -1;
            op.hidden = !bate;
            if (bate) achou++;
        });

        if (vazio) vazio.hidden = achou > 0;

        // Digitar troca quem sobrou: o marcado vai para o primeiro da lista nova,
        // senão o Enter escolheria alguém que o filtro acabou de esconder.
        var visiveis = opcoesVisiveis(menu);
        marcar(menu, visiveis.length ? visiveis[0] : null);

        // O menu ENCOLHE ao filtrar. Quando ele abriu para cima (chip perto do
        // rodapé), encolher deixaria um vão entre ele e o chip.
        if (chipAtivo) posicionar(menu, chipAtivo);
    }

    function limparBusca(menu) {
        var campo = menu.querySelector('.pasta-resp-busca');
        if (campo) campo.value = '';
        filtrar(menu);
    }

    function fecharMenu() {
        var menu = document.getElementById('pastaRespMenu');
        // chipAtivo zerado ANTES de limparBusca: filtrar() reposiciona usando ele,
        // e reposicionar um menu que acabou de fechar nao faz sentido.
        chipAtivo = null;
        if (menu) {
            menu.hidden = true;
            limparBusca(menu);
        }
    }

    function abrirMenu(chip) {
        var menu = document.getElementById('pastaRespMenu');
        if (!menu) return;
        chipAtivo = chip;
        var respId = chip.dataset.respId || '';
        menu.querySelectorAll('.pasta-resp-opcao').forEach(function (op) {
            op.classList.toggle('ativa', (op.dataset.userId || '') === respId);
        });
        menu.hidden = false;

        // Abre sempre limpo e ja marcando o primeiro, para o Enter ter alvo.
        limparBusca(menu);
        posicionar(menu, chip);

        /* Foco no campo e o que faz a busca ser "instantanea": abriu, ja digita.
           No celular NAO: daria foco a um input e abriria o teclado virtual por
           cima da propria lista que o usuario quer ler. */
        var campo = menu.querySelector('.pasta-resp-busca');
        var toque = window.matchMedia && window.matchMedia('(hover: none)').matches;
        if (campo && !toque) campo.focus();
    }

    function posicionar(menu, chip) {
        var r  = chip.getBoundingClientRect();
        var mw = menu.offsetWidth, mh = menu.offsetHeight;
        var left = r.left;
        var top  = r.bottom + 4;
        if (left + mw > window.innerWidth - 8)  left = window.innerWidth - 8 - mw;
        if (left < 8) left = 8;
        if (top + mh > window.innerHeight - 8)  top = r.top - mh - 4;
        if (top < 8) top = 8;
        menu.style.left = left + 'px';
        menu.style.top  = top + 'px';
    }

    /* Aviso curto da troca: o da Lista (ExpAviso) ou o da pasta (avisarPs). */
    function avisarTroca(texto) {
        if (window.ExpAviso) { window.ExpAviso(texto); return; }
        if (window.avisarPs) { window.avisarPs(texto); }
    }

    /* `troca` ({de, para, nup}) só quando a pasta tinha responsável e passou pela confirmação L8. */
    function salvarResponsavel(chip, userId, nome, fotoUrl, manter, troca) {
        var prevHtml = chip.innerHTML;
        var prevId   = chip.dataset.respId || '';
        renderChip(chip, userId, nome, fotoUrl); // otimista
        chip.classList.add('salvando');

        var campos = { _token: chip.dataset.csrf, responsavel_id: userId || '' };
        if (manter) { campos.manter_colaborador = '1'; }
        var body = new URLSearchParams(campos);
        fetch(chip.dataset.url, {
            method: 'PATCH',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            chip.classList.remove('salvando');
            if (!res.ok || !res.data.sucesso) {
                chip.innerHTML = prevHtml;
                chip.dataset.respId = prevId;
                (window.avisarErroPs || window.alert)((res.data && res.data.erro) || BJ_T.t('pasta_resp.js.resp.erro_alterar'));

                return;
            }
            if (!troca || res.data.mudou === false) { return; }
            // O texto segue o que o servidor fez: sem vínculo ativo no escritório, o anterior não fica.
            var mantido = res.data.colaboradorMantido === true;
            var chave = 'pasta_resp.js.resp.troca_feita' + (troca.semNovo ? '_sem' : '') + (mantido ? '_mantido' : '_desvinculado');
            avisarTroca(BJ_T.t(chave, { nup: troca.nup, para: troca.para, de: troca.de }));
            if (mantido && window.ExpCompartilhar && window.ExpCompartilhar.atualizar) {
                window.ExpCompartilhar.atualizar(chip.dataset.pastaId);
            }
        })
        .catch(function () {
            chip.classList.remove('salvando');
            chip.innerHTML = prevHtml;
            chip.dataset.respId = prevId;
        });
    }

    /* Confirmação L8 (desenho 03): abre só quando a pasta já tem responsável e ele muda. "Manter como colaborador"
       começa desmarcado; Cancelar, o fundo e o Esc fecham sem gravar. */
    function confirmarTroca(troca, aoConfirmar) {
        var negrito = function (s) { return '<b>' + escResp(s) + '</b>'; };
        var fundo = document.createElement('div');
        fundo.className = 'resp-troca-fundo';
        fundo.innerHTML =
            '<div class="resp-troca" role="alertdialog" aria-modal="true" aria-label="' + escResp(BJ_T.t('pasta_resp.js.resp.troca_aria')) + '">' +
                '<div class="resp-troca-titulo"><i class="bi bi-exclamation-triangle-fill"></i> ' +
                    escResp(BJ_T.t('pasta_resp.js.resp.troca_titulo', { nup: troca.nup })) + '</div>' +
                '<div>' + BJ_T.t(troca.semNovo ? 'pasta_resp.js.resp.troca_texto_sem' : 'pasta_resp.js.resp.troca_texto',
                    { deNegrito: negrito(troca.de), paraNegrito: negrito(troca.para), de: escResp(troca.de) }) + '</div>' +
                '<label class="resp-troca-manter"><input type="checkbox"><span>' +
                    escResp(BJ_T.t('pasta_resp.js.resp.troca_manter', { de: troca.de })) + '</span></label>' +
                '<div class="resp-troca-nota">' + escResp(BJ_T.t('pasta_resp.js.resp.troca_historico')) + '</div>' +
                '<div class="resp-troca-acoes">' +
                    '<button type="button" class="resp-troca-nao">' + escResp(BJ_T.t('pasta_resp.js.resp.troca_cancelar')) + '</button>' +
                    '<button type="button" class="resp-troca-sim">' + escResp(BJ_T.t('pasta_resp.js.resp.troca_confirmar')) + '</button>' +
                '</div>' +
            '</div>';
        var fechar = function () {
            document.removeEventListener('keydown', teclas, true);
            if (fundo.parentNode) { fundo.parentNode.removeChild(fundo); }
        };
        var teclas = function (e) {
            if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); fechar(); }
        };
        fundo.addEventListener('click', function (e) {
            if (e.target === fundo || e.target.closest('.resp-troca-nao')) { fechar(); return; }
            if (e.target.closest('.resp-troca-sim')) {
                var manter = fundo.querySelector('.resp-troca-manter input').checked;
                fechar();
                aoConfirmar(manter);
            }
        });
        document.addEventListener('keydown', teclas, true);
        document.body.appendChild(fundo);
        fundo.querySelector('.resp-troca-sim').focus();
    }

    /* Escolha no menu. Mesma pessoa não chega aqui; pasta sem responsável troca direto; com responsável, L8. */
    function escolher(chip, userId, nome, fotoUrl) {
        if (chip.dataset.restrito === '1') {
            (window.ExpAviso || window.avisarErroPs || window.alert)(BJ_T.t('pasta_resp.js.resp.restrito_fixo'));

            return;
        }
        if ((chip.dataset.respId || '') === '') {
            salvarResponsavel(chip, userId, nome, fotoUrl, false, null);

            return;
        }
        var atual = chip.querySelector('.pasta-resp-nome');
        var troca = {
            nup: chip.dataset.nup || '',
            de: atual ? atual.textContent.trim() : '',
            para: userId ? nome : BJ_T.t('pasta_resp.js.resp.sem_responsavel'),
            semNovo: !userId,
        };
        confirmarTroca(troca, function (manter) {
            salvarResponsavel(chip, userId, nome, fotoUrl, manter, troca);
        });
    }

    if (!document.__pastaRespMenuBound) {
        document.__pastaRespMenuBound = true;

        document.addEventListener('click', function (e) {
            var chip = e.target.closest('.pasta-resp-chip');
            if (chip) {
                e.preventDefault();
                var menu = document.getElementById('pastaRespMenu');
                if (menu && !menu.hidden && chipAtivo === chip) { fecharMenu(); return; }
                abrirMenu(chip);

                return;
            }

            var opc = e.target.closest('.pasta-resp-opcao');
            if (opc && chipAtivo) {
                e.preventDefault();
                var uid = opc.dataset.userId || '';
                if ((chipAtivo.dataset.respId || '') !== uid) {
                    escolher(chipAtivo, uid, opc.dataset.nome || '', opc.dataset.foto || '');
                }
                fecharMenu();

                return;
            }

            if (e.target.closest('.pasta-resp-fechar') || !e.target.closest('#pastaRespMenu')) fecharMenu();
        });

        document.addEventListener('input', function (e) {
            if (e.target && e.target.classList && e.target.classList.contains('pasta-resp-busca')) {
                var menu = e.target.closest('.pasta-resp-menu');
                if (menu) filtrar(menu);
            }
        });

        document.addEventListener('keydown', function (e) {
            var menu = document.getElementById('pastaRespMenu');
            var aberto = menu && !menu.hidden;

            if (e.key === 'Escape') { fecharMenu(); return; }
            if (!aberto) return;

            // Setas andam so pelo que o filtro deixou visivel; Enter escolhe o
            // marcado. E o que o <select> nativo fazia e o chip tinha perdido.
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                var visiveis = opcoesVisiveis(menu);
                if (!visiveis.length) return;
                var atual = menu.querySelector('.pasta-resp-opcao.marcada');
                var i = visiveis.indexOf(atual);
                var passo = e.key === 'ArrowDown' ? 1 : -1;
                // Circula: descer no ultimo volta ao primeiro, e vice-versa.
                var prox = (i === -1)
                    ? (passo === 1 ? 0 : visiveis.length - 1)
                    : (i + passo + visiveis.length) % visiveis.length;
                marcar(menu, visiveis[prox]);
                return;
            }

            if (e.key === 'Enter') {
                var alvo = menu.querySelector('.pasta-resp-opcao.marcada');
                if (!alvo || !chipAtivo) return;
                e.preventDefault();
                if ((chipAtivo.dataset.respId || '') !== (alvo.dataset.userId || '')) {
                    escolher(chipAtivo, alvo.dataset.userId || '',
                             alvo.dataset.nome || '', alvo.dataset.foto || '');
                }
                fecharMenu();
            }
        });
        // Fecha ao rolar a PÁGINA (o menu é position:fixed e descolaria do chip),
        // mas não ao rolar DENTRO do próprio menu (lista de colaboradores rolável).
        document.addEventListener('scroll', function (e) {
            var alvo = e.target;
            if (alvo && alvo.nodeType === 1 && alvo.closest && alvo.closest('#pastaRespMenu')) return;
            fecharMenu();
        }, true);
        window.addEventListener('resize', fecharMenu);
    }
}());
</script>
