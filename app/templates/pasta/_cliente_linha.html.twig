{# Uma linha de cliente vinculado: nome, documento e acoes.

   UM partial serve o principal e os outros — o que muda e a estrela (cheia e
   inerte no principal, vazia e clicavel nos demais) e a classe do bloco de fora.
   Dois templates quase iguais divergiriam na primeira alteracao.

   Icone de cadastro (L7, desenho 1.2.3 dc L.1381 e L.6125-6126): verde quando o
   cadastro esta completo, ambar quando falta algo. A regra e a do servico
   `PendenciasDoCadastro` (funcao Twig `cliente_pendencias`), e o title lista O
   QUE falta. Clicar nele — ou o botao direito em qualquer ponto da linha — abre a
   janela "Detalhes do cliente" (pasta-clientes.js).
   Este partial e a UNICA fonte da linha: vincular/cadastrar por XHR devolve o
   `html` dele (PastaController::htmlLinhaCliente) e o JS do show so o insere —
   nao ha mais espelho JS, e a linha nova nasce com o icone como as demais.

   Parametros: pasta, cliente, ehPrincipal (bool); opcionais podeMexerNoCliente (bool)
   e cpfDuplicado (bool).
   Selo "CPF duplicado" (desenho 02 VS 18.10.26, L1509 e L6527-6536): outro cliente
   vinculado a ESTA pasta tem o mesmo documento (so digitos). Quem decide e o servico
   `ClientesDuplicadosDaPasta`; o trilho calcula uma vez e repassa, o XHR cai no
   fallback (funcao `pasta_clientes_duplicados`). O desenho so fala de CPF: para PJ o
   selo diz "CNPJ duplicado".
   C6-PMC-03: a estrela vazia (tornar principal) e a lixeira (desvincular) so para
   quem o servidor deixaria usa-las — EDIT na pasta e pasta fora da lapide. O
   trilho repassa a decisao; o XHR (htmlLinhaCliente) nao, entao o fallback e aqui
   (`can_access_resource` guarda a resposta por requisicao). A estrela cheia do
   principal fica: e leitura, nao acao. #}
{% set podeMexerNoCliente = podeMexerNoCliente is defined
    ? podeMexerNoCliente
    : (can_access_resource('pasta', pasta.id, 'edit') and not pasta.estaExcluida) %}
{% set doc = cliente.cpf is defined ? cliente.cpf : (cliente.cnpj is defined ? cliente.cnpj : null) %}
{% set cpfDuplicado = cpfDuplicado is defined
    ? cpfDuplicado
    : cliente.id in pasta_clientes_duplicados(pasta) %}
{% set rotuloDoc = cliente.cpf is defined ? 'CPF' : 'CNPJ' %}
{% set pendencias = cliente_pendencias(cliente) %}
{% set cadCompleto = pendencias is empty %}
{% set cadDica = cadCompleto
    ? 'pasta_lista.cliente_linha.cad_completo'|trans
    : (pendencias|length == 1 ? 'pasta_lista.cliente_linha.cad_incompleto_uma' : 'pasta_lista.cliente_linha.cad_incompleto_varias')|trans({total: pendencias|length ~ ''})
      ~ "\n" ~ pendencias|map(p => '• ' ~ p)|join("\n") %}
{# Iniciais das DUAS primeiras palavras, como o desenho (e como o JS do show). #}
{% set partesNome = cliente.nomeExibicao|trim|split(' ')|filter(p => p is not empty) %}
{% set iniciais = partesNome|slice(0, 2)|map(p => p|slice(0, 1))|join('')|upper %}
<div class="cliente-linha d-flex align-items-center gap-2 py-2"
     data-cliente-id="{{ cliente.id }}"
     {#- Para pasta-clientes-duplicados.js recalcular o selo de TODAS as linhas depois de vincular ou
         desvincular sem recarregar (dc L6527-6536). A chave e um HMAC dos digitos (mesma comparacao
         do servico), nunca o documento cru. #}
     data-doc-chave="{{ pasta_cliente_doc_chave(cliente) }}"
     data-doc-tipo="{{ rotuloDoc|lower }}"
     {# O token vai na LINHA, nao so no form: quando a estrela cheia (que nao tem
        form) precisa voltar a ser botao, o JS nao teria de onde tira-lo. #}
     {%- if podeMexerNoCliente %} data-token-principal="{{ csrf_token('pasta_cliente_principal_' ~ pasta.id ~ '_' ~ cliente.id) }}"{% endif %}>

    <span class="cliente-avatar" aria-hidden="true">{{ iniciais ?: '?' }}</span>

    <div class="cliente-identidade flex-grow-1">
        {# O nome vai num <span> proprio, e nao solto: e ELE que trunca com
           reticencias quando nao cabe. Texto solto ao lado do selo nao encolhe,
           e a linha inteira vazava para fora do cartao. #}
        <div class="cliente-nome">
            <span class="cliente-nome-texto">{{ cliente.nomeExibicao }}</span>
            <button type="button"
                    class="cliente-cad js-ps-cli-detalhes cliente-cad--{{ cadCompleto ? 'completo' : 'pendente' }}"
                    data-pendencias="{{ pendencias|length }}"
                    title="{{ cadDica }}" aria-label="{{ cadDica }}"><i class="bi bi-person-vcard" aria-hidden="true"></i></button>
            {%- if cpfDuplicado %}<span class="ps-selo-duplicado" title="{{ 'pasta_lista.cliente_linha.duplicado_dica'|trans({doc: rotuloDoc}) }}">{{ 'pasta_lista.cliente_linha.duplicado'|trans({doc: rotuloDoc}) }}</span>{% endif -%}
            {%- if ehPrincipal %}<span class="ps-selo-principal">{{ 'pasta_lista.cliente_linha.principal'|trans }}</span>{% endif -%}
        </div>
        {% set telefone = cliente.telefoneCelular ?: cliente.telefoneFixo %}
        {% if doc or telefone %}
            <div class="cliente-doc">
                {% if doc %}
                    <span><span class="cliente-doc-rotulo">{{ doc|documento_br_rotulo }}</span>
                    <span class="cliente-doc-valor">{{ doc|documento_br }}</span></span>
                {% endif %}
                {% if telefone %}
                    <span class="cliente-tel"><i class="bi bi-telephone" aria-hidden="true"></i> {{ telefone|telefone_br }}</span>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div class="d-flex gap-1 flex-shrink-0 js-cliente-acoes">
        {# Dois estados: cheia = e o principal desta pasta, vazia = clique para trocar.
           Nao existe "desmarcar": pasta com cliente SEMPRE tem principal. #}
        {% if ehPrincipal %}
            <span class="btn btn-xs btn-primary disabled js-cliente-principal-estrela"
                  data-cliente-id="{{ cliente.id }}"
                  title="{{ (podeMexerNoCliente ? 'pasta_lista.cliente_linha.principal_dica_trocar' : 'pasta_lista.cliente_linha.principal_dica')|trans }}">
                <i class="bi bi-star-fill"></i>
            </span>
        {% elseif podeMexerNoCliente %}
            <form method="post" action="{{ path('pasta_cliente_principal', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-cliente-principal m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_principal_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                <button type="submit" class="btn btn-xs btn-outline-secondary" title="{{ 'pasta_lista.cliente_linha.tornar_principal'|trans }}">
                    <i class="bi bi-star"></i>
                </button>
            </form>
        {% endif %}

        <a href="{{ path('cliente_show', {id: cliente.id}) }}"
           class="cliente-abrir"
           title="{{ 'pasta_lista.cliente_linha.abrir_dica'|trans }}" aria-label="{{ 'pasta_lista.cliente_linha.abrir_rotulo'|trans({nome: cliente.nomeExibicao})|e('html_attr') }}">
            {# Dois icones (auditoria 2 D8, dc L.6127): fechada no repouso, aberta no
               hover/foco. Quem troca e o CSS (.ps-cli-abrir-*), sem JS. #}
            <i class="bi bi-folder-fill ps-cli-abrir-fechada" aria-hidden="true"></i>
            <i class="bi bi-folder2-open ps-cli-abrir-aberta" aria-hidden="true"></i>
        </a>

        {% if podeMexerNoCliente %}
            <form method="post" action="{{ path('pasta_cliente_desvincular', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-desvincular-cliente m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_desvincular_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                <button type="submit" class="btn btn-xs btn-outline-danger" title="{{ 'pasta_lista.cliente_linha.desvincular'|trans }}">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
        {% endif %}
    </div>
</div>
