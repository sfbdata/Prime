{# Uma linha de cliente vinculado: nome, documento e acoes.

   UM partial serve o principal e os outros — o que muda e a estrela (cheia e
   inerte no principal, vazia e clicavel nos demais) e a classe do bloco de fora.
   Dois templates quase iguais divergiriam na primeira alteracao.

   Parametros: pasta, cliente, ehPrincipal (bool). #}
{% set doc = cliente.cpf is defined ? cliente.cpf : (cliente.cnpj is defined ? cliente.cnpj : null) %}
<div class="cliente-linha d-flex align-items-center gap-2 py-2"
     data-cliente-id="{{ cliente.id }}"
     {# O token vai na LINHA, nao so no form: quando a estrela cheia (que nao tem
        form) precisa voltar a ser botao, o JS nao teria de onde tira-lo. #}
     data-token-principal="{{ csrf_token('pasta_cliente_principal_' ~ pasta.id ~ '_' ~ cliente.id) }}">

    <i class="bi bi-person-circle text-muted flex-shrink-0"></i>

    <div class="cliente-identidade flex-grow-1">
        {# O nome vai num <span> proprio, e nao solto: e ELE que trunca com
           reticencias quando nao cabe. Texto solto ao lado do selo nao encolhe,
           e a linha inteira vazava para fora do cartao. #}
        <div class="cliente-nome">
            <span class="cliente-nome-texto">{{ cliente.nomeExibicao }}</span>
            {%- if ehPrincipal %}<span class="ps-selo-principal">Principal</span>{% endif -%}
        </div>
        {% if doc %}
            <div class="cliente-doc">
                <span class="cliente-doc-rotulo">{{ doc|documento_br_rotulo }}</span>
                <span class="cliente-doc-valor">{{ doc|documento_br }}</span>
            </div>
        {% endif %}
    </div>

    <div class="d-flex gap-1 flex-shrink-0 js-cliente-acoes">
        {# Dois estados: cheia = e o principal desta pasta, vazia = clique para trocar.
           Nao existe "desmarcar": pasta com cliente SEMPRE tem principal. #}
        {% if ehPrincipal %}
            <span class="btn btn-xs btn-primary disabled js-cliente-principal-estrela"
                  data-cliente-id="{{ cliente.id }}"
                  title="Cliente principal desta pasta — a Média por CPF é dele. Clique na estrela de outro para trocar">
                <i class="bi bi-star-fill"></i>
            </span>
        {% else %}
            <form method="post" action="{{ path('pasta_cliente_principal', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-cliente-principal m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_principal_' ~ pasta.id ~ '_' ~ cliente.id) }}">
                <button type="submit" class="btn btn-xs btn-outline-secondary" title="Tornar cliente principal (a Média por CPF passa a ser dele)">
                    <i class="bi bi-star"></i>
                </button>
            </form>
        {% endif %}

        <a href="{{ path('cliente_show', {id: cliente.id}) }}"
           class="btn btn-xs btn-outline-secondary"
           title="Abrir ficha do cliente (documentos e anexos ficam lá)">
            <i class="bi bi-box-arrow-up-right"></i>
        </a>

        <form method="post" action="{{ path('pasta_cliente_desvincular', {id: pasta.id, cliente: cliente.id}) }}" class="js-ajax-desvincular-cliente m-0">
            <input type="hidden" name="_token" value="{{ csrf_token('pasta_cliente_desvincular_' ~ pasta.id ~ '_' ~ cliente.id) }}">
            <button type="submit" class="btn btn-xs btn-outline-danger" title="Desvincular cliente da pasta">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </div>
</div>
