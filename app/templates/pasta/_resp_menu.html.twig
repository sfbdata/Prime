{# Menu compartilhado de responsavel: UM por pagina, servindo todos os chips.
   O JS (_resp_script) o encontra por id e o posiciona junto do chip clicado.
   Recebe os colaboradores por parametro em vez de herdar do escopo, para nao
   depender de quem inclui. #}
{% import '_partials/_avatar_usuario.html.twig' as av %}
{% set fotosResponsaveis = fotosResponsaveis|default({}) %}
{# ── Menu compartilhado de responsável (1× para tabela e cartões) ────────── #}
<div class="pasta-resp-menu" id="pastaRespMenu" role="listbox" aria-label="Escolher responsável" hidden>
    <button type="button" class="pasta-resp-opcao" data-user-id="" data-nome="Sem responsável" data-foto="">
        <span class="resp-avatar resp-avatar-vazio" style="width:24px;height:24px;"><i class="bi bi-person-dash"></i></span>
        <span class="pasta-resp-nome text-muted">Sem responsável</span>
    </button>
    {% for u in usuarios %}
        {% set fotoU = fotosResponsaveis[u.id]|default(null) %}
        <button type="button" class="pasta-resp-opcao"
                data-user-id="{{ u.id }}"
                data-nome="{{ u.fullName }}"
                data-foto="{{ fotoU ? path('app_profile_foto_serve', {nome: fotoU}) : '' }}">
            {{ av.avatar(u.fullName, fotoU, 24) }}
            <span class="pasta-resp-nome">{{ u.fullName }}</span>
        </button>
    {% endfor %}
</div>
