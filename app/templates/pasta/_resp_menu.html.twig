{# Menu compartilhado de responsavel: UM por pagina, servindo todos os chips.
   O JS (_resp_script) o encontra por id e o posiciona junto do chip clicado.
   Recebe os colaboradores por parametro em vez de herdar do escopo, para nao
   depender de quem inclui.

   Estrutura em duas partes, e a divisao NAO e decorativa: a busca fica fora da
   area rolavel, senao o campo sobe e some assim que o usuario rola os nomes. #}
{% import '_partials/_avatar_usuario.html.twig' as av %}
{% set fotosResponsaveis = fotosResponsaveis|default({}) %}
<div class="pasta-resp-menu" id="pastaRespMenu" hidden>

    {# ── Busca: parada no topo ── #}
    <div class="pasta-resp-busca-wrap">
        <i class="bi bi-search pasta-resp-busca-icone" aria-hidden="true"></i>
        <input type="text"
               class="pasta-resp-busca"
               placeholder="Filtrar…"
               autocomplete="off"
               spellcheck="false"
               role="combobox"
               aria-expanded="true"
               aria-autocomplete="list"
               aria-controls="pastaRespLista"
               aria-label="Filtrar colaboradores pelo nome">
    </div>

    {# ── Lista: a parte que rola ── #}
    <div class="pasta-resp-lista" id="pastaRespLista" role="listbox" aria-label="Escolher responsável">
        <button type="button" class="pasta-resp-opcao" role="option" aria-selected="false"
                data-user-id="" data-nome="Sem responsável" data-foto="">
            <span class="resp-avatar resp-avatar-vazio" style="width:24px;height:24px;"><i class="bi bi-person-dash"></i></span>
            <span class="pasta-resp-nome text-muted">Sem responsável</span>
        </button>
        {% for u in usuarios %}
            {% set fotoU = fotosResponsaveis[u.id]|default(null) %}
            <button type="button" class="pasta-resp-opcao" role="option" aria-selected="false"
                    data-user-id="{{ u.id }}"
                    data-nome="{{ u.fullName }}"
                    data-foto="{{ fotoU ? path('app_profile_foto_serve', {nome: fotoU}) : '' }}">
                {{ av.avatar(u.fullName, fotoU, 24) }}
                <span class="pasta-resp-nome">{{ u.fullName }}</span>
            </button>
        {% endfor %}

        {# Sem isto, filtrar ate nao sobrar ninguem deixa um retangulo vazio com
           cara de tela quebrada. O JS so troca o atributo hidden. #}
        <div class="pasta-resp-vazio" hidden>
            <i class="bi bi-search me-1"></i>Nenhum colaborador encontrado
        </div>
    </div>
</div>
