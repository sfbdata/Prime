{# "Relatório como caixa de entrada" da Central de envios (F3d; desenho 05 VS 21.10.26, marcação L300-305 e L502-514,
   lógica L698-717; spec docs/specs/comercial-relatorio.md). Incluído pelo _comercial.html.twig no lugar do antigo
   bloco "Monitoramento", dentro da raiz de cada modo (`.mc[data-modo]`). Traz o próprio <link> e <script>, sem script inline (o HTML da
   campanha vai num iframe sandbox="", que não executa script). A lista, as contagens e o visualizador vêm por JSON quando a seção abre.
   As URLs com id levam o marcador 999999999 (casa com o requisito `RelatorioDoMasterController::ID`; o JS o troca).
   F3e (spec docs/specs/comercial-marcas.md): a estrela, o arquivo e a remoção (marcas de cada Master, no servidor), os
   botões da seleção, as abas Com estrela e Arquivadas, o menu do botão direito (dc L504), "Reenviar a quem não leu"
   (só aviso) e "Exportar destinatários" (CSV pelo servidor). "Encaminhar para um e-mail" fica no menu, desabilitado,
   até o dono decidir.
   Duas instâncias (spec docs/specs/comercial-relatorio-venda.md): `secao` ('com' na seção Comercial, 'ind' na seção
   Indicações) vai no data-mc-relatorio e no sufixo dos ids; `recursos` (só na da seção Comercial) traz o <link>, o
   <script> e o catálogo do JS, para não repetirem na página.
   Os textos moram no catálogo (bloco `comercial_relatorio`, spec idioma-do-sistema §8); o que vem do PHP (rótulos de
   estado, KPIs, dica e leitura) fica como está. #}
{% set secao = secao|default('com') %}
{% set recursos = recursos is defined ? recursos : true %}
{% if recursos %}
<link rel="stylesheet" href="{{ asset('css/master-comercial-relatorio.css') }}">
{% endif %}
<section class="mc-caixa mc-rl" aria-label="{{ 'comercial_relatorio.rotulo'|trans }}" data-mc-relatorio="{{ secao }}"
         data-url-lista="{{ path('master_comercial_relatorio') }}"
         data-url-campanha="{{ path('master_comercial_campanha', {id: 999999999}) }}"
         data-url-cancelar="{{ path('master_comercial_campanha_cancelar', {id: 999999999}) }}"
         data-url-marcas="{{ path('master_comercial_relatorio_marcas') }}"
         data-url-csv="{{ path('master_comercial_campanha_destinatarios', {id: 999999999}) }}"
         data-token="{{ csrf_token('master_comercial') }}">
    {# L301: selecionar, atualizar, com algo selecionado Arquivar (Desarquivar na aba Arquivadas), Estrela e a lixeira,
       a contagem da seleção, a busca e a faixa da página. #}
    <div class="mc-rl-barra">
        <button type="button" class="mc-rl-ic" title="{{ 'comercial_relatorio.barra.selecionar'|trans }}" aria-label="{{ 'comercial_relatorio.barra.selecionar'|trans }}" data-mc-rl-sel-todos><i class="bi bi-square" aria-hidden="true" data-mc-rl-sel-ic></i></button>
        <button type="button" class="mc-rl-ic mc-rl-redondo" title="{{ 'comercial_relatorio.barra.atualizar'|trans }}" aria-label="{{ 'comercial_relatorio.barra.atualizar'|trans }}" data-mc-rl-atualizar><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
        <button type="button" class="mc-rl-acao" title="{{ 'comercial_relatorio.barra.arquivar'|trans }}" data-mc-rl-marcar="arquivar" hidden><i class="bi bi-archive" aria-hidden="true"></i> <span data-mc-rl-arq-txt>{{ 'comercial_relatorio.barra.arquivar'|trans }}</span></button>
        <button type="button" class="mc-rl-acao" title="{{ 'comercial_relatorio.barra.estrela_dica'|trans }}" data-mc-rl-marcar="estrela" hidden><i class="bi bi-star" aria-hidden="true"></i> {{ 'comercial_relatorio.barra.estrela'|trans }}</button>
        <button type="button" class="mc-rl-ic mc-rl-redondo mc-rl-lixeira" title="{{ 'comercial_relatorio.barra.remover'|trans }}" aria-label="{{ 'comercial_relatorio.barra.remover'|trans }}" data-mc-rl-marcar="remover" hidden><i class="bi bi-trash3" aria-hidden="true"></i></button>
        <span class="mc-rl-sel-n" data-mc-rl-sel-n hidden></span>
        <span class="mc-rl-vao"></span>
        <label class="mc-rl-busca"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="{{ 'comercial_relatorio.barra.buscar'|trans }}" aria-label="{{ 'comercial_relatorio.barra.buscar'|trans }}" maxlength="120" data-mc-rl-busca></label>
        <span class="mc-rl-faixa" data-mc-rl-faixa>{{ 'comercial_relatorio.barra.faixa_vazia'|trans }}</span>
        <button type="button" class="mc-rl-ic mc-rl-redondo" title="{{ 'comercial_relatorio.barra.pagina_anterior'|trans }}" aria-label="{{ 'comercial_relatorio.barra.pagina_anterior'|trans }}" data-mc-rl-pagina="-1" disabled><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
        <button type="button" class="mc-rl-ic mc-rl-redondo" title="{{ 'comercial_relatorio.barra.proxima_pagina'|trans }}" aria-label="{{ 'comercial_relatorio.barra.proxima_pagina'|trans }}" data-mc-rl-pagina="1" disabled><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
    </div>
    {# L302: as abas com a contagem, os rótulos, os ícones, os subtítulos e as cores do dc (L700). #}
    <div class="mc-rl-abas" role="tablist" aria-label="{{ 'comercial_relatorio.abas.rotulo'|trans }}">
        {% for a in [
            ['env', 'comercial_relatorio.abas.env.rotulo'|trans, 'bi-send', 'comercial_relatorio.abas.env.sub'|trans],
            ['ag', 'comercial_relatorio.abas.ag.rotulo'|trans, 'bi-clock', 'comercial_relatorio.abas.ag.sub'|trans],
            ['rec', 'comercial_relatorio.abas.rec.rotulo'|trans, 'bi-arrow-repeat', 'comercial_relatorio.abas.rec.sub'|trans],
            ['est', 'comercial_relatorio.abas.est.rotulo'|trans, 'bi-star', 'comercial_relatorio.abas.est.sub'|trans],
            ['arq', 'comercial_relatorio.abas.arq.rotulo'|trans, 'bi-archive', 'comercial_relatorio.abas.arq.sub'|trans],
        ] %}
            <button type="button" role="tab" class="mc-rl-aba mc-rl-aba-{{ a[0] }}" data-mc-rl-aba="{{ a[0] }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"><i class="bi {{ a[2] }}" aria-hidden="true"></i><span class="mc-rl-aba-texto"><b class="mc-rl-aba-rot">{{ a[1] }}<span class="mc-rl-aba-n" data-mc-rl-n hidden></span></b><span class="mc-rl-aba-sub">{{ a[3] }}</span></span></button>
        {% endfor %}
    </div>
    <div class="mc-rl-msg" role="status" data-mc-rl-msg hidden><i class="bi bi-info-circle" aria-hidden="true"></i> <span data-mc-rl-msg-texto></span></div>
    <div class="mc-rl-lista" role="tabpanel" data-mc-rl-lista aria-busy="true"></div>
    {# L502-514: o visualizador da campanha, preenchido pelo JS. #}
    <div class="mc-rl-ver" data-mc-rl-ver hidden>
        <div class="mc-rl-ver-fundo" data-mc-rl-fechar></div>
        <div class="mc-rl-ver-caixa" role="dialog" aria-modal="true" aria-labelledby="mc-rl-ver-assunto-{{ secao }}">
            <div class="mc-rl-ver-barra">
                <button type="button" class="mc-rl-ver-voltar" title="{{ 'comercial_relatorio.ver.voltar'|trans }}" aria-label="{{ 'comercial_relatorio.ver.voltar'|trans }}" data-mc-rl-fechar><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
                <span class="mc-rl-vao"></span>
                <button type="button" class="mc-rl-ver-acao" data-mc-rl-duplicar><i class="bi bi-files" aria-hidden="true"></i>{{ 'comercial_relatorio.ver.duplicar'|trans }}</button>
                <button type="button" class="mc-rl-ver-acao" data-mc-rl-reenviar><i class="bi bi-arrow-repeat" aria-hidden="true"></i>{{ 'comercial_relatorio.ver.reenviar'|trans }}</button>
                <button type="button" class="mc-rl-ver-acao" data-mc-rl-csv="completo"><i class="bi bi-filetype-csv" aria-hidden="true"></i>{{ 'comercial_relatorio.ver.exportar'|trans }}</button>
                <button type="button" class="mc-rl-ver-acao mc-rl-ver-cancelar" data-mc-rl-cancelar hidden><i class="bi bi-x-circle" aria-hidden="true"></i>{{ 'comercial_relatorio.ver.cancelar'|trans }}</button>
            </div>
            <div class="mc-rl-ver-corpo">
                <div class="mc-rl-ver-titulo"><span id="mc-rl-ver-assunto-{{ secao }}" data-mc-rl-v="assunto"></span> <span class="mc-rl-ver-st" data-mc-rl-v="situacao"></span></div>
                <div class="mc-rl-ver-de">
                    <span class="mc-rl-ver-avatar" aria-hidden="true">B</span>
                    <span class="mc-rl-ver-quem"><b data-mc-rl-v="nome"></b> <span data-mc-rl-v="endereco"></span><br>{{ 'comercial_relatorio.ver.para'|trans }} <span data-mc-rl-v="publico"></span> · {{ 'comercial_relatorio.ver.modelo'|trans }} <span data-mc-rl-v="modelo"></span></span>
                    <span class="mc-rl-ver-quando" data-mc-rl-v="quando"></span>
                </div>
                <div class="mc-rl-ver-kpis" data-mc-rl-kpis></div>
                <div class="mc-rl-ver-grade">
                    <iframe class="mc-rl-ver-html" title="{{ 'comercial_relatorio.ver.quadro'|trans }}" sandbox="" data-mc-rl-html></iframe>
                    <div class="mc-rl-ver-dest">
                        <div class="mc-rl-ver-dest-titulo">{{ 'comercial_relatorio.ver.destinatarios'|trans }}</div>
                        <div class="mc-rl-ver-dest-lista" data-mc-rl-dest></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# L504: o menu do botão direito na linha. O título é o nome da campanha; fecha no clique fora, no botão direito
       fora e no Esc. Itens e separadores na ordem do dc (L704). "Encaminhar para um e-mail" fica desabilitado até o
       dono decidir (mandar teste para qualquer endereço contraria a regra C4). #}
    <div class="mc-rl-ctx" data-mc-rl-ctx hidden>
        <div class="mc-rl-ctx-fundo" data-mc-rl-ctx-fechar></div>
        <div class="mc-rl-ctx-caixa" role="menu" aria-labelledby="mc-rl-ctx-titulo-{{ secao }}">
            <div class="mc-rl-ctx-titulo" id="mc-rl-ctx-titulo-{{ secao }}" data-mc-rl-ctx-titulo></div>
            <button type="button" role="menuitem" class="mc-rl-ctx-item" data-mc-rl-ctx-acao="abrir"><i class="bi bi-envelope-open" aria-hidden="true"></i>{{ 'comercial_relatorio.menu.abrir'|trans }}</button>
            <button type="button" role="menuitem" class="mc-rl-ctx-item" data-mc-rl-ctx-acao="duplicar"><i class="bi bi-files" aria-hidden="true"></i>{{ 'comercial_relatorio.menu.duplicar'|trans }}</button>
            <button type="button" role="menuitem" class="mc-rl-ctx-item" data-mc-rl-ctx-acao="reenviar"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>{{ 'comercial_relatorio.menu.reenviar'|trans }}</button>
            <div class="mc-rl-ctx-sep" role="separator"></div>
            <button type="button" role="menuitem" class="mc-rl-ctx-item mc-rl-ctx-off" disabled aria-disabled="true" title="{{ 'comercial_relatorio.menu.encaminhar_motivo'|trans }}"><i class="bi bi-forward" aria-hidden="true"></i>{{ 'comercial_relatorio.menu.encaminhar'|trans }}</button>
            <button type="button" role="menuitem" class="mc-rl-ctx-item" data-mc-rl-ctx-acao="estrela"><i class="bi bi-star" aria-hidden="true" data-mc-rl-ctx-estrela-ic></i><span data-mc-rl-ctx-estrela-txt>{{ 'comercial_relatorio.menu.estrela'|trans }}</span></button>
            <button type="button" role="menuitem" class="mc-rl-ctx-item" data-mc-rl-ctx-acao="arquivar"><i class="bi bi-archive" aria-hidden="true"></i><span data-mc-rl-ctx-arq-txt>{{ 'comercial_relatorio.menu.arquivar'|trans }}</span></button>
            <div class="mc-rl-ctx-sep" role="separator"></div>
            <button type="button" role="menuitem" class="mc-rl-ctx-item" data-mc-rl-ctx-acao="csv"><i class="bi bi-filetype-csv" aria-hidden="true"></i>{{ 'comercial_relatorio.menu.exportar'|trans }}</button>
            <div class="mc-rl-ctx-sep" role="separator"></div>
            <button type="button" role="menuitem" class="mc-rl-ctx-item mc-rl-ctx-excluir" data-mc-rl-ctx-acao="excluir"><i class="bi bi-trash3" aria-hidden="true"></i>{{ 'comercial_relatorio.menu.excluir'|trans }}</button>
        </div>
    </div>
</section>
{% if recursos %}
{{ catalogo_js('comercial_relatorio.js') }}
<script src="{{ asset('js/master/comercial-relatorio.js') }}"></script>
{% endif %}
