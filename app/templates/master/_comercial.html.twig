{# Seção "Comercial e e-mails" do /master (desenho 05 VS 18.10.26, L.222-287; spec docs/specs/comercial-e-emails.md).
   Incluída pelo painel.html.twig num <div data-sec-externa="com"> (contrato do #56): o painel.js só mostra a sub-aba
   com este parcial presente, e avisa a troca de seção pelo evento `mp:secao`. Traz o próprio <link> e <script>
   (a CSP do /master aceita 'self', sem inline). Os dados vêm por JSON quando a seção abre.
   As URLs com parâmetro levam um marcador que casa com o requisito da rota (`xchavex`, `xidx`; o JS o troca): em dev e
   em teste o roteador recusa um marcador fora do requisito (`strict_requirements`) e o parcial nem renderizaria.
   Fatia 1a: o bloco "Automações". Fatia 2a: o bloco "Nova campanha de e-mail" (dc L.229-260), antes das Automações,
   na posição do dc: 1 · MODELO, 3 · MENSAGEM, a PRÉVIA DO E-MAIL, "Baixar HTML" e "Enviar teste" (ao Master logado).
   Fatia 2b: "2 · PARA QUEM" (dc L.236-239), a linha de destinatários (L.252), a Frequência (L.253), "Agendar" ou
   "Primeiro envio" e "Enviar campanha" (L.254), e o bloco Monitoramento com a lista de campanhas (L.282-286), sem as
   métricas (fatia 3). Descadastrados, indicações e datas vêm nas seguintes. #}
<link rel="stylesheet" href="{{ asset('css/master-comercial.css') }}">
<div class="mc" data-mc
     data-url-automacoes="{{ path('master_comercial_automacoes') }}"
     data-url-alterar="{{ path('master_comercial_automacao', {chave: 'xchavex'}) }}"
     data-url-simular="{{ path('master_comercial_simular') }}"
     data-url-previa="{{ path('master_comercial_previa', {chave: 'xchavex'}) }}"
     data-token="{{ csrf_token('master_comercial') }}">
    {# Nova campanha de e-mail (dc L.229-260). Os textos e a ordem são do dc; o JS desenha a grade e os blocos. #}
    <section class="mc-caixa mc-cp" data-mc-campanha aria-labelledby="mc-cp-titulo"
             data-url-modelos="{{ path('master_comercial_modelos') }}"
             data-url-criar="{{ path('master_comercial_modelo_criar') }}"
             data-url-salvar="{{ path('master_comercial_modelo_salvar', {id: 'xidx'}) }}"
             data-url-excluir="{{ path('master_comercial_modelo_excluir', {id: 'xidx'}) }}"
             data-url-previa="{{ path('master_comercial_previa_campanha') }}"
             data-url-teste="{{ path('master_comercial_teste') }}"
             data-url-contagem="{{ path('master_comercial_publicos_contagem') }}"
             data-url-campanha="{{ path('master_comercial_campanha_confirmar') }}">
        <div class="mc-cabeca mc-cp-cabeca">
            <i class="bi bi-megaphone mc-cp-cabeca-ic" aria-hidden="true"></i>
            <b class="mc-cabeca-titulo" id="mc-cp-titulo">Nova campanha de e-mail</b>
            <span class="mc-cabeca-sub">convites, ofertas, agradecimentos e novidades · individual ou em grande escala</span>
        </div>
        <div class="mc-cp-grade">
            <div class="mc-cp-col mc-cp-editor">
                <div class="mc-cp-passo">1 · MODELO</div>
                <div class="mc-cp-modelos" data-mc-cp-modelos aria-busy="true"></div>
                <div class="mc-cp-acoes">
                    <button type="button" class="mc-cp-acao" data-mc-cp-novo><i class="bi bi-plus-lg" aria-hidden="true"></i>Novo modelo</button>
                    <button type="button" class="mc-cp-acao" data-mc-cp-duplicar><i class="bi bi-copy" aria-hidden="true"></i>Duplicar</button>
                    <label class="mc-cp-acao"><i class="bi bi-upload" aria-hidden="true"></i>Importar HTML<input type="file" accept=".html,.htm" class="mc-cp-arquivo" data-mc-cp-importar></label>
                    <button type="button" class="mc-cp-acao mc-cp-acao-salvar" data-mc-cp-salvar data-mc-cp-so-proprio hidden><i class="bi bi-check2" aria-hidden="true"></i>Salvar modelo</button>
                    <button type="button" class="mc-cp-acao mc-cp-acao-excluir" data-mc-cp-excluir data-mc-cp-so-proprio hidden><i class="bi bi-trash" aria-hidden="true"></i>Excluir</button>
                </div>
                {# 2 · PARA QUEM (dc L.236-239): os 6 públicos com os rótulos, os ícones e as descrições literais do dc (L.539). O número
                   vem da contagem do servidor. #}
                <div class="mc-cp-passo mc-cp-passo-seguinte">2 · PARA QUEM</div>
                <div class="mc-cp-publicos" data-mc-cp-publicos>
                    {% for p in [
                        ['leads', 'Base de contatos', 'bi-person-lines-fill', 'Inscritos pela página de vagas e campanhas'],
                        ['prim', 'Usuários primários', 'bi-person-badge', 'Quem abriu conta, em todas as contas'],
                        ['sec', 'Usuários secundários', 'bi-people', 'Convidados de todas as contas'],
                        ['todos', 'Todos os cadastrados', 'bi-buildings', 'Primários e secundários'],
                        ['csv', 'Importar lista (CSV)', 'bi-filetype-csv', 'Planilha com e-mail e nome'],
                        ['indiv', 'Individual', 'bi-person', 'Digite um ou mais e-mails'],
                    ] %}
                        <button type="button" class="mc-cp-publico" data-mc-cp-publico="{{ p[0] }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"><i class="bi {{ p[2] }}" aria-hidden="true"></i><span class="mc-cp-publico-texto"><span class="mc-cp-publico-rot">{{ p[1] }}</span><span class="mc-cp-publico-desc">{{ p[3] }}</span></span><b class="mc-cp-publico-n" data-mc-cp-n></b></button>
                    {% endfor %}
                </div>
                {# Filtrar destinatários (desenho 05 VS 21.10.26, L260-264; spec §9): fechado, mostra o selo com quantos
                   campos estão preenchidos e "N de M com filtro" ou "Todos (M)"; aberto, a busca, os atalhos (L664), os
                   selects e a linha "N de M atendem ao filtro". Quem conta é o servidor (F2). #}
                <div class="mc-cf" data-mc-cf>
                    <button type="button" class="mc-cf-cabeca" data-mc-cf-abrir aria-expanded="false" aria-controls="mc-cf-painel">
                        <i class="bi bi-funnel" aria-hidden="true"></i><b class="mc-cf-titulo">FILTRAR DESTINATÁRIOS</b>
                        <span class="mc-cf-selo" data-mc-cf-selo hidden></span>
                        <span class="mc-cf-espaco"></span>
                        <span class="mc-cf-curto" data-mc-cf-curto></span>
                        <i class="bi bi-chevron-down mc-cf-seta" data-mc-cf-seta aria-hidden="true"></i>
                    </button>
                    <div class="mc-cf-painel" id="mc-cf-painel" data-mc-cf-painel hidden>
                        <label class="mc-cf-busca"><i class="bi bi-envelope" aria-hidden="true"></i><input type="text" data-mc-cf-campo="q" maxlength="500" placeholder="E-mail ou nome específico (separe vários por vírgula)" aria-label="E-mail ou nome específico"></label>
                        <div class="mc-cf-atalhos" data-mc-cf-atalhos>
                            {% for a in [
                                ['Todos', {}], ['Só mulheres', {gen: 'F'}], ['Só homens', {gen: 'M'}], ['Advogados', {cargo: 'adv'}],
                                ['Estagiários', {cargo: 'est'}], ['Primários', {papel: 'prim'}], ['Aniversariantes do mês', {aniv: 'mes'}],
                            ] %}
                                <button type="button" class="mc-cf-atalho" data-mc-cf-atalho="{{ a[1]|json_encode|e('html_attr') }}" aria-pressed="false">{{ a[0] }}</button>
                            {% endfor %}
                        </div>
                        <div class="mc-cf-selects">
                            {% set selects = [
                                ['gen', 'Gênero: todos', [['F', 'Feminino'], ['M', 'Masculino']]],
                                ['id', 'Idade: todas', [['a', '18 a 24'], ['b', '25 a 34'], ['c', '35 a 44'], ['d', '45 a 54'], ['e', '55 ou mais']]],
                                ['uf', 'Estado: todos', comercial_ufs_do_filtro()|map(u => [u, u])],
                                ['papel', 'Perfil: todos', [['prim', 'Usuário primário'], ['sec', 'Usuário secundário']]],
                                ['cargo', 'Cargo: todos', [['adv', 'Advogado(a)'], ['est', 'Estagiário(a)'], ['ctl', 'Controladoria'], ['fin', 'Financeiro'], ['adm', 'Administrativo / assistente'], ['out', 'Outros']]],
                                ['oab', 'OAB: todas', [['conf', 'OAB confirmada'], ['pend', 'OAB pendente'], ['sem', 'Sem OAB']]],
                                ['plano', 'Plano: todos', comercial_planos_do_filtro()|map(p => [p.codigo, p.nome])],
                                ['aniv', 'Aniversário: todos', [['mes', 'Aniversariantes deste mês'], ['prox', 'Aniversariantes do próximo mês']]],
                            ] %}
                            {% for s in selects %}
                                <select class="mc-cf-select" data-mc-cf-campo="{{ s[0] }}" aria-label="{{ s[1]|split(':')|first }}">
                                    <option value="">{{ s[1] }}</option>
                                    {% for o in s[2] %}<option value="{{ o[0] }}">{{ o[1] }}</option>{% endfor %}
                                </select>
                            {% endfor %}
                        </div>
                        <div class="mc-cf-resultado"><i class="bi bi-people" aria-hidden="true"></i><span data-mc-cf-resultado></span><button type="button" class="mc-cf-limpar" data-mc-cf-limpar hidden>Limpar filtro</button></div>
                    </div>
                </div>
                <label class="mc-cp-csv" data-mc-cp-csv hidden><i class="bi bi-upload" aria-hidden="true"></i><span class="mc-cp-csv-txt" data-mc-cp-csv-txt>Selecionar arquivo .csv</span><input type="file" accept=".csv,.txt" class="mc-cp-arquivo" data-mc-cp-csv-arquivo></label>
                <textarea class="mc-cp-individual" rows="2" placeholder="E-mails separados por vírgula" aria-label="E-mails separados por vírgula" data-mc-cp-individual hidden></textarea>
                <div class="mc-cp-passo mc-cp-passo-seguinte">3 · MENSAGEM</div>
                <label class="mc-cp-campo">ASSUNTO<input type="text" class="mc-cp-entrada" data-mc-cp-campo="assunto" maxlength="255"></label>
                <label class="mc-cp-campo">TÍTULO<input type="text" class="mc-cp-entrada" data-mc-cp-campo="titulo" maxlength="255"></label>
                <label class="mc-cp-campo" data-mc-cp-so-proprio hidden>NOME DO MODELO<input type="text" class="mc-cp-entrada" data-mc-cp-campo="nome" maxlength="40"></label>
                <div class="mc-cp-modo" data-mc-cp-simples>
                    <label class="mc-cp-campo">TEXTO <span class="mc-cp-dica">use {nome} para o primeiro nome</span><textarea class="mc-cp-texto" rows="5" data-mc-cp-campo="corpo"></textarea></label>
                    <label class="mc-cp-campo">BOTÃO<input type="text" class="mc-cp-entrada" data-mc-cp-campo="cta" maxlength="120"></label>
                </div>
                <div class="mc-cp-modo" data-mc-cp-blocos hidden>
                    <div class="mc-cp-blocos-titulo">BLOCOS <span class="mc-cp-dica">monte o layout; a prévia atualiza na hora</span></div>
                    <div class="mc-cp-lista" data-mc-cp-lista></div>
                    <div class="mc-cp-novos" data-mc-cp-novos></div>
                </div>
                <label class="mc-cp-campo" data-mc-cp-html hidden>HTML IMPORTADO<textarea class="mc-cp-codigo" rows="8" data-mc-cp-campo="html" spellcheck="false"></textarea></label>
            </div>
            <div class="mc-cp-col mc-cp-lado">
                <div class="mc-cp-passo">PRÉVIA DO E-MAIL</div>
                <iframe class="mc-cp-previa" title="Prévia do e-mail" sandbox="" data-mc-cp-previa></iframe>
                {# L.252: K desta lista, os descadastrados e os sem autorização que saíram (o JS escreve a frase). #}
                <div class="mc-cp-dest"><i class="bi bi-people" aria-hidden="true"></i> <span data-mc-cp-dest></span></div>
                {# L.253: a frequência, com os rótulos do dc (L.557). #}
                <div class="mc-cp-freq">
                    <span class="mc-cp-freq-rot"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Frequência</span>
                    <div class="mc-cp-freq-ops" role="group" aria-label="Frequência">
                        {% for f in [['unica', 'Envio único'], ['semanal', 'Semanal'], ['quinzenal', 'Quinzenal'], ['mensal', 'Mensal']] %}
                            <button type="button" class="mc-cp-freq-op" data-mc-cp-freq="{{ f[0] }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">{{ f[1] }}</button>
                        {% endfor %}
                    </div>
                </div>
                {# L.254: "Agendar" (ou "Primeiro envio" na recorrente, L.557), Baixar HTML, Enviar teste e Enviar campanha. #}
                <div class="mc-cp-botoes">
                    <label class="mc-cp-agenda"><i class="bi bi-calendar-event" aria-hidden="true"></i><span data-mc-cp-agenda-rot>Agendar</span><input type="datetime-local" class="mc-cp-agenda-data" data-mc-cp-agenda></label>
                    <span class="mc-cp-vao"></span>
                    <button type="button" class="mc-cp-botao" data-mc-cp-baixar><i class="bi bi-filetype-html" aria-hidden="true"></i>Baixar HTML</button>
                    <button type="button" class="mc-cp-botao" data-mc-cp-teste><i class="bi bi-send-check" aria-hidden="true"></i>Enviar teste</button>
                    <button type="button" class="mc-cp-enviar" data-mc-cp-enviar><i class="bi bi-send" aria-hidden="true"></i>Enviar campanha</button>
                </div>
                <div class="mc-cp-msg" role="status" data-mc-cp-aviso hidden><i class="bi bi-info-circle" aria-hidden="true"></i> <span data-mc-cp-msg></span></div>
                <div class="mc-cp-lgpd"><i class="bi bi-shield-check" aria-hidden="true"></i> LGPD: só recebe quem se cadastrou ou autorizou. Todo e-mail leva o link "Não quero mais receber", repetidos e descadastrados são retirados, e o envio é feito pelo servidor em lotes para não cair no spam.</div>
            </div>
        </div>
    </section>
    <section class="mc-caixa" aria-labelledby="mc-auto-titulo">
        <div class="mc-cabeca">
            <i class="bi bi-lightning-charge mc-cabeca-ic" aria-hidden="true"></i>
            <b class="mc-cabeca-titulo" id="mc-auto-titulo">Automações</b>
            <span class="mc-cabeca-sub">e-mails enviados sozinhos a cada cadastro e confirmação</span>
            <button type="button" class="mc-botao" data-mc-simular><i class="bi bi-play-circle" aria-hidden="true"></i>Simular novo cadastro</button>
        </div>
        <div class="mc-msg" data-mc-msg role="status" hidden></div>
        <div class="mc-autos" data-mc-autos aria-busy="true"></div>
        <div class="mc-fila">
            <div class="mc-fila-titulo">ÚLTIMOS DISPAROS</div>
            <div data-mc-fila></div>
        </div>
        <div class="mc-previa" data-mc-previa hidden>
            <div class="mc-previa-cabeca"><b data-mc-previa-titulo></b><button type="button" class="mc-botao" data-mc-previa-fechar aria-label="Fechar a prévia"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <iframe class="mc-previa-quadro" data-mc-previa-quadro title="Prévia do e-mail" sandbox></iframe>
        </div>
    </section>
    {# Monitoramento (dc L.282-286): a lista das 12 últimas campanhas (L.586). Os números por campanha são da fatia 3; a
       linha diz "Métricas: aguarda servidor", como o dc. #}
    <section class="mc-caixa mc-mon" aria-labelledby="mc-mon-titulo" data-mc-monitoramento
             data-url-campanhas="{{ path('master_comercial_campanhas') }}">
        <div class="mc-cabeca">
            <i class="bi bi-graph-up mc-mon-ic" aria-hidden="true"></i>
            <b class="mc-cabeca-titulo" id="mc-mon-titulo">Monitoramento</b>
            <span class="mc-cabeca-sub">entregas, aberturas, cliques e descadastros por campanha</span>
        </div>
        <div class="mc-camps" data-mc-camps aria-busy="true"></div>
    </section>
</div>
<script src="{{ asset('js/master/comercial.js') }}"></script>
<script src="{{ asset('js/master/comercial-campanha.js') }}"></script>
<script src="{{ asset('js/master/comercial-monitoramento.js') }}"></script>
