{# Desenho: docs/design/perfis-1.0/mapa-brasil.html. Página do iframe do mapa no Painel do Master (ROLE_SUPER_ADMIN).
   O navegador não chama site externo: d3 local, malhas locais, municípios e dados públicos pelas rotas /master/*. #}
{% set cfg = {
    malhaUf: asset('js/master/geo/brasil-uf.geojson'),
    malhaMundo: asset('js/master/geo/mundo-110m.json'),
    municipios: path('master_ibge_municipios', {uf: 'XX'}),
    populacao: path('master_ibge_populacao', {uf: 'XX'}),
    dadosMapa: path('master_dados_mapa'),
    fontes: path('master_fontes_resumo'),
    atualizar: path('master_fontes_atualizar'),
    tabela: path('master_fontes_tabela'),
    oab: path('master_fontes_oab'),
    xlsx: asset('js/vendor/xlsx/xlsx.full.min.js'),
    csrf: csrf_token('master_fontes'),
    seccionais: path('master_dados_seccionais'),
    divulgar: path('master_seccional_divulgar', {uf: 'XX'}),
    csrfSeccionais: csrf_token('master_seccionais')
} %}
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8">
<title>Mapa do Brasil por estado</title>
<script src="{{ asset('js/vendor/d3/d3.min.js') }}"></script>
<style>
html,body{margin:0;height:100%;font-family:Arial,Helvetica,sans-serif;background:#fff;overflow:hidden}
#m{width:100%;height:100%;display:block}
.uf{stroke:#b9c7d2;stroke-width:.8;transition:opacity .45s ease,fill .3s;cursor:pointer}
.uf:hover{opacity:.82}
.mun{stroke:#c9d6df;cursor:default;transition:fill .25s,opacity .3s}
.mun:hover{fill-opacity:.8}
.msg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#7d909d;font-size:13px;text-align:center;padding:20px}
#tip{position:fixed;width:max-content;max-width:min(320px,calc(100vw - 16px));white-space:pre-line;overflow-wrap:anywhere;box-sizing:border-box;line-height:1.35;z-index:20;pointer-events:none;background:#e5f1f7;color:#0b4f73;font-size:12px;font-weight:bold;padding:6px 9px;border-radius:4px;box-shadow:0 4px 12px rgba(18,36,47,.15);opacity:0;transition:opacity .12s}
#painel{position:absolute;z-index:6!important;top:10px;left:10px;width:230px;background:#fff;border:1px solid #dfe7ed;border-radius:4px;box-shadow:0 6px 20px rgba(18,36,47,.12);opacity:0;transform:translateY(-6px);transition:opacity .35s,transform .35s;pointer-events:none;z-index:4}
#painel.on{opacity:1;transform:none;pointer-events:auto}
#painel .top{user-select:none;touch-action:none;display:flex;align-items:center;gap:8px;padding:9px 10px;background:#0a6fa0;color:#fff;border-radius:4px 4px 0 0}
#voltar{width:28px;height:28px;border:none;border-radius:4px;background:rgba(255,255,255,.16);color:#fff;font-size:17px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s}
#voltar:hover{background:rgba(255,255,255,.3)}
#painel b{font-size:13.5px;flex:1}
#painel .sub{font-size:11px;opacity:.85;font-weight:normal;display:block}
#lista{max-height:260px;overflow:auto;font-size:12.5px;color:#243845}
#lista div{display:flex;justify-content:space-between;gap:8px;padding:6px 10px;border-bottom:1px solid #eef2f5;position:relative}
#lista div span{position:relative}
#lista div i{position:absolute;left:0;top:0;bottom:0;background:#e5f1f7}
#lista .vazio{color:#7d909d;justify-content:center}
#lista .ins{font-size:11px;color:#5b7383;background:#f7f9fb}
#carreg{position:absolute;right:12px;top:12px;font-size:11.5px;color:#5b7383;background:#f7f9fb;border:1px solid #e2e9ee;padding:5px 9px;border-radius:4px;opacity:0;transition:opacity .2s}
#zCtl{position:absolute;z-index:3!important;right:12px;bottom:12px;display:flex;flex-direction:column;background:#fff;border:1px solid #dfe7ed;border-radius:4px;box-shadow:0 4px 14px rgba(18,36,47,.12);overflow:hidden;z-index:4}#zCtl button{width:32px;height:30px;border:none;border-bottom:1px solid #eef2f5;background:#fff;color:#0a6fa0;font:bold 17px Arial;cursor:pointer;transition:background .15s}#zCtl button:last-child{border-bottom:none;font-size:14px}#zCtl button:hover{background:#e5f1f7}#m{cursor:grab}#m:active{cursor:grabbing}
#mk{position:fixed;z-index:30;display:none;background:#fff;border:1px solid #dfe7ed;border-radius:4px;box-shadow:0 8px 24px rgba(18,36,47,.18);padding:8px 10px 10px;font-size:12px;color:#243845;width:196px}
#mk .t{font-weight:bold;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#mk .s{font-size:10.5px;color:#5b7383;letter-spacing:.4px;margin-bottom:7px}
#mk .g{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}#mk .g button{width:24px;height:24px;border-radius:4px;border:1px solid rgba(18,36,47,.15);cursor:pointer;transition:transform .12s}#mk .g button:hover{transform:scale(1.15)}#mk .g button.on{box-shadow:0 0 0 2px #fff,0 0 0 4px #0a6fa0}
/* Seccionais da OAB (spec master-seccionais-oab): marcador no centroide e "Registrar divulgação" no menu do botão direito */
.sec-mk{fill:#fff;stroke:#0a6fa0;stroke-width:2px;vector-effect:non-scaling-stroke;cursor:pointer;filter:drop-shadow(0 1px 2px rgba(18,36,47,.35))}
#mk .dv .s{text-transform:uppercase}#mk .dv{margin:6px 0 9px;padding-bottom:9px;border-bottom:1px solid #eef2f5}#mk .dv .b{display:flex;flex-direction:column;gap:4px}
#mk .dv .b button{height:26px;border:1px solid #c5d2db;border-radius:3px;background:#fff;color:#34505f;font:bold 11.5px Arial;cursor:pointer;display:flex;align-items:center;gap:6px;padding:0 8px;text-align:left}
#mk .dv .b button:hover{background:#e5f1f7;color:#0a6fa0}#mk .dv .b button i{width:7px;height:7px;border-radius:50%;box-shadow:0 0 0 1px rgba(18,36,47,.35)}
#mk .dv input{box-sizing:border-box;width:100%;height:26px;margin-top:5px;border:1px solid #d3dde4;border-radius:3px;font:12px Arial;color:#243845;padding:0 6px}
#mk .dv .m{margin-top:5px;font-size:11px;color:#5b7383;line-height:1.35}#mk .dv .m.erro{color:#a3232b}#mk .dv .m.ok{color:#1e7b45}
#mk .x{margin-top:8px;width:100%;height:28px;border:none;border-radius:3px;background:#f3f6f8;color:#34505f;font:bold 12px Arial;cursor:pointer}#mk .x:hover{background:#e5f1f7;color:#0a6fa0}
</style></head><body data-cfg="{{ cfg|json_encode|e('html_attr') }}">
<svg id="m"><defs><filter id="sombra" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#0a3d5c" flood-opacity=".3"/></filter></defs></svg>
<div id="tip"></div><div class="msg" id="msg">Carregando mapa…</div><div id="carreg">Carregando municípios…</div>
<div id="painel"><div class="top"><button id="voltar" title="Voltar ao mapa do Brasil" aria-label="Voltar ao mapa do Brasil">&#8592;</button><b id="pNome"></b></div><div id="lista"></div></div>
<div id="mk"></div>
<script src="{{ asset('js/master/mapa-agregado.js') }}"></script>
<script src="{{ asset('js/master/mapa-brasil.js') }}"></script>
<script src="{{ asset('js/master/mapa-dados.js') }}"></script>
</body></html>
