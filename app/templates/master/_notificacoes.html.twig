{# Seção "Central de Notificações" do /master (desenho 05 Perfis 1.2 VS 21.10.26, SECS L565, template L309-322 e
   lógica nfVals L724-749; spec docs/specs/master-central-de-notificacoes.md).
   Incluída pelo painel.html.twig num <div data-sec-externa="notif">, como a Comercial: o painel.js só mostra o botão
   da seção com este parcial presente e avisa a troca de seção pelo evento `mp:secao`. O esqueleto (barra, abas, lista
   e a janela da mensagem) é estático; o public/js/master/notificacoes.js preenche com o JSON de /master/notificacoes.
   Todo texto de mensagem vem de fora (visitante da tela de entrada, autor de sugestão): o JS só escreve com
   textContent. As URLs com parâmetro levam o marcador `xorigemx`/`0` que o JS troca. #}
<div class="nf" data-nf
     data-url-listar="{{ path('master_notificacoes_listar') }}"
     data-url-marcar="{{ path('master_notificacoes_marcar') }}"
     data-url-abrir="{{ path('master_notificacoes_abrir', {origem: 'xorigemx', id: 0}) }}"
     data-url-responder="{{ path('master_notificacoes_responder', {origem: 'xorigemx', id: 0}) }}"
     data-token="{{ csrf_token('master_notificacoes') }}"
     data-eu="{{ app.user ? app.user.id : '' }}">
    <div class="nf-caixa">
        <div class="nf-barra">
            <button type="button" class="nf-ico" title="Selecionar" aria-label="Selecionar" data-nf-sel-todos><i class="bi bi-square" data-nf-sel-ic aria-hidden="true"></i></button>
            <button type="button" class="nf-ico nf-ico-redondo" title="Atualizar" aria-label="Atualizar" data-nf-atualizar><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
            <span class="nf-acoes" data-nf-acoes hidden>
                <button type="button" class="nf-acao" title="Marcar como lida" data-nf-lote="lida"><i class="bi bi-envelope-open" aria-hidden="true"></i> Marcar como lida</button>
                <button type="button" class="nf-acao" title="Não lida" data-nf-lote="nao_lida"><i class="bi bi-envelope" aria-hidden="true"></i> Não lida</button>
                <button type="button" class="nf-acao" data-nf-lote="arquivar" data-nf-arq><i class="bi bi-archive" aria-hidden="true"></i> <span data-nf-arq-txt>Arquivar</span></button>
                <span class="nf-sel-n"><span data-nf-sel-n>0</span> selecionada(s)</span>
            </span>
            <span class="nf-espaco"></span>
            <label class="nf-busca"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Buscar mensagem" aria-label="Buscar mensagem" maxlength="200" data-nf-busca></label>
            <span class="nf-pag" data-nf-pag>0 de 0</span>
            <span class="nf-paginas" data-nf-paginas hidden>
                <button type="button" class="nf-ico nf-ico-redondo" title="Mais novas" aria-label="Mais novas" data-nf-pag-ant><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                <button type="button" class="nf-ico nf-ico-redondo" title="Mais antigas" aria-label="Mais antigas" data-nf-pag-prox><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </span>
        </div>
        <div class="nf-abas" role="tablist">
            {% for a in [
                ['rec', 'Recebidas', 'bi-inbox', 'Tudo que chegou'],
                ['nl', 'Não lidas', 'bi-envelope', 'Ainda sem abrir'],
                ['est', 'Com estrela', 'bi-star', 'Marcadas'],
                ['resp', 'Respondidas', 'bi-reply', 'Já respondidas'],
                ['arq', 'Arquivadas', 'bi-archive', 'Fora da caixa'],
            ] %}
                <button type="button" class="nf-aba{{ loop.first ? ' on' : '' }}" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-nf-aba="{{ a[0] }}"><i class="bi {{ a[2] }}" aria-hidden="true"></i><span class="nf-aba-txt"><b class="nf-aba-rot">{{ a[1] }}{% if a[0] in ['rec', 'nl'] %}<span class="nf-aba-n" data-nf-n hidden></span>{% endif %}</b><span class="nf-aba-sub">{{ a[3] }}</span></span></button>
            {% endfor %}
        </div>
        <div class="nf-vazio" data-nf-vazio hidden><i class="bi bi-inbox" aria-hidden="true"></i>Nenhuma mensagem aqui.</div>
        <div class="nf-msg" data-nf-msg hidden></div>
        <div class="nf-lista" data-nf-lista aria-busy="true"></div>
    </div>

    <div class="nf-ver" data-nf-ver hidden>
        <div class="nf-ver-fundo" data-nf-fechar></div>
        <div class="nf-ver-centro">
            <div class="nf-ver-janela" role="dialog" aria-modal="true" aria-labelledby="nf-ver-ass">
                <div class="nf-ver-topo">
                    <button type="button" class="nf-ico nf-ico-redondo nf-ver-btn" title="Voltar" aria-label="Voltar" data-nf-fechar><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
                    <button type="button" class="nf-ico nf-ico-redondo nf-ver-btn" title="Arquivar" aria-label="Arquivar" data-nf-arq-um><i class="bi bi-archive" aria-hidden="true"></i></button>
                    <button type="button" class="nf-ico nf-ico-redondo nf-ver-btn nf-ver-estrela" title="Estrela" aria-label="Estrela" data-nf-est-um><i class="bi bi-star" data-nf-est-um-ic aria-hidden="true"></i></button>
                    <span class="nf-espaco"></span>
                    <span class="nf-ver-em" data-nf-ver-em></span>
                </div>
                <div class="nf-ver-corpo">
                    <div class="nf-ver-cab"><b class="nf-ver-ass" id="nf-ver-ass" data-nf-ver-ass></b><span class="nf-ver-tag" data-nf-ver-tag></span></div>
                    <div class="nf-ver-de">
                        <span class="nf-ver-ini" data-nf-ver-ini></span>
                        <span class="nf-ver-quem">
                            <b class="nf-ver-nome" data-nf-ver-de></b>
                            <span class="nf-ver-para">para Master do Sistema</span>
                            <div class="nf-ver-txt" data-nf-ver-txt></div>
                        </span>
                    </div>
                </div>
                <div class="nf-hist" data-nf-hist hidden></div>
                <div class="nf-resp" data-nf-resp hidden>
                    <div class="nf-resp-cab"><i class="bi bi-reply" aria-hidden="true"></i><span data-nf-resp-para></span></div>
                    <textarea rows="4" maxlength="5000" class="nf-resp-txt" aria-label="Resposta" data-nf-resp-txt></textarea>
                    <div class="nf-resp-rodape">
                        <button type="button" class="nf-enviar" data-nf-enviar><i class="bi bi-send" aria-hidden="true"></i>Enviar resposta</button>
                        <span class="nf-resp-msg" data-nf-resp-msg hidden></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="{{ asset('js/master/notificacoes.js') }}"></script>
