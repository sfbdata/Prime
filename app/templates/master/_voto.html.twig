{# Aba "Voto" do /master (spec docs/specs/bluejus-voto.md, D5 e D7, fase A1b): o Master libera o BlueJus Voto por
   escritório. Nenhum desenho tem esta tela: os componentes são os que o painel já usa (.mp-card, .mp-cab-roxo, a chave
   do .mp-rec-item com role="switch", a grade com .mp-lin), como na aba da I.A.
   Incluída pelo painel.html.twig dentro de <div class="mp-voto" data-painel-aba="voto">. A grade vem por JSON quando a
   aba abre (public/js/master/voto.js); clicar na chave grava na hora, sem botão Salvar. "Liberar todos" e "Bloquear todos"
   (M5.9) aplicam o estado aos escritórios ativos de uma vez, depois da confirmação interna do painel. As regras moram nos UseCases
   do domínio Voto.
   Estatísticas de todas as votações (W2-7, bloco C): o desenho 18 (H245) manda; os componentes .vC, .vH, .vB, .vL, .vF,
   .vKpis, .vKpi, .vLin e .vChip são os dele, copiados com o escopo .mp-voto-est em master-voto.css. A lista vem por
   JSON (master_voto_estatisticas) e o JS a desenha; o CSV é o link do botão. Só números agregados.
   Textos no catálogo (master.voto.*; os do JS em master.js.voto.*, entregues pelo catalogo_js do painel). #}
<link rel="stylesheet" href="{{ asset('css/master-voto.css') }}">
<div class="mp-voto-raiz" data-mp-voto
     data-url-dados="{{ path('master_voto_dados') }}"
     data-url-escritorio="{{ path('master_voto_escritorio', {tenantId: 0}) }}"
     data-url-todos="{{ path('master_voto_todos') }}"
     data-token="{{ csrf_token('master_voto') }}">

    <div class="mp-voto-msg" data-mp-voto-msg role="status" hidden></div>

    <section class="mp-card mp-voto-card" aria-labelledby="mp-voto-liberacao">
        <div class="mp-cab-roxo"><i class="bi bi-archive"></i><b id="mp-voto-liberacao">{{ 'master.voto.liberacao.titulo'|trans }}</b><span data-mp-voto-contagem></span></div>
        <p class="mp-voto-nota">{{ 'master.voto.liberacao.nota'|trans }}</p>
        <div class="mp-voto-acoes">
            <button type="button" class="mp-btn-roxo" id="mp-voto-liberar-todos" data-mp-voto-todos="1" disabled><i class="bi bi-unlock" aria-hidden="true"></i>{{ 'master.voto.liberacao.liberar_todos'|trans }}</button>
            <button type="button" class="mp-btn-cinza" id="mp-voto-bloquear-todos" data-mp-voto-todos="0" disabled><i class="bi bi-lock" aria-hidden="true"></i>{{ 'master.voto.liberacao.bloquear_todos'|trans }}</button>
        </div>
        <div class="mp-rolagem">
            <div class="mp-voto-grade">
                <div class="mp-voto-cab">
                    <div>{{ 'master.voto.liberacao.col_nome'|trans }}</div>
                    <div>{{ 'master.voto.liberacao.col_liberado'|trans }}</div>
                </div>
                <div data-mp-voto-linhas><div class="mp-carregando">{{ 'master.painel.carregando'|trans }}</div></div>
            </div>
        </div>
    </section>

    <section class="mp-voto-est" data-mp-voto-est
             data-url-dados="{{ path('master_voto_estatisticas') }}"
             data-url-csv="{{ path('master_voto_estatisticas_csv') }}"
             aria-labelledby="mp-voto-est-titulo">
        <div class="vC">
            <div class="vH"><i class="bi bi-bar-chart-line"></i><span id="mp-voto-est-titulo">{{ 'master.voto.estatisticas.titulo'|trans }}</span><span class="mp-est-esp"></span><a class="vB" href="{{ path('master_voto_estatisticas_csv') }}" data-mp-est-csv><i class="bi bi-download"></i>{{ 'master.voto.estatisticas.exportar'|trans }}</a></div>
            <div class="vLin mp-est-filtro">
                <label class="vL mp-est-cat">{{ 'master.voto.estatisticas.categoria'|trans }}<select class="vF" data-mp-est-categoria><option value="">{{ 'master.voto.estatisticas.todas'|trans }}</option></select></label>
                <div class="mp-est-nota">{{ 'master.voto.estatisticas.nota'|trans }}</div>
            </div>
            <div class="vLin"><div class="vKpis" data-mp-est-kpis></div></div>
            <div data-mp-est-linhas><div class="vLin mp-est-vazio">{{ 'master.painel.carregando'|trans }}</div></div>
        </div>
    </section>
</div>
<script src="{{ asset('js/master/voto.js') }}"></script>
