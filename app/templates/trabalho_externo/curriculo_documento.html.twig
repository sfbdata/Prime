{#
    Currículo formatado do Trabalho Externo: o `cvHTML` do desenho 06 (l.920 a 938), A4 com barra
    lateral de 72 mm em #0a6fa0. Recebe só arrays já resolvidos pelo DocumentoDoCurriculo:
    - x: os blocos (contato, habilidades, idiomas, disponibilidade, experiências, formações...);
    - pdf: o Dompdf não desenha grade nem flex, então a moldura vira tabela e os alinhamentos viram
      float; as seções, a ordem e os textos são os mesmos da pré-visualização;
    - foto: a URL da rota de download (HTML) ou o arquivo da área temporária (PDF); null = iniciais;
    - logo: o arquivo da área temporária no PDF; no HTML vêm os do próprio sistema.
    "Disponibilidade" some quando vazia (decisão 9). O período usa "a" no lugar do travessão.
#}
{% set logoSrc = pdf ? logo : asset('images/logo/bluejus-logo-nav.png') %}
{% set simboloSrc = pdf ? null : asset('images/logo/bluejus_simbolo.svg') %}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Currículo · {{ x.nome }}</title>
<style>@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#1d2a33;background:#e9eef2;-webkit-print-color-adjust:exact;print-color-adjust:exact}.pg{width:210mm;min-height:297mm;margin:0 auto;background:#fff;display:grid;grid-template-columns:72mm 1fr;box-shadow:0 4px 18px rgba(0,0,0,.08)}.sd{background:#0a6fa0;color:#fff;padding:14mm 8mm 10mm;display:flex;flex-direction:column;gap:7mm}.ft{width:38mm;height:38mm;border-radius:50%;margin:0 auto;background:#fff center/cover no-repeat;border:3px solid rgba(255,255,255,.85)}.ft.ini{display:flex;align-items:center;justify-content:center;font-size:30pt;font-weight:bold;color:#0a6fa0}.sb h4{margin:0 0 2.5mm;font-size:9pt;letter-spacing:1.4px;text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,.35);padding-bottom:1.5mm}.sb ul{list-style:none;margin:0;padding:0;font-size:8.6pt;line-height:1.45}.sb li{margin-bottom:2mm;word-break:break-word}.sb li b{display:block;font-size:7.4pt;letter-spacing:.6px;text-transform:uppercase;opacity:.75}.tg{display:flex;flex-wrap:wrap;gap:1.6mm}.tg span{font-size:8pt;background:rgba(255,255,255,.16);border-radius:2px;padding:1mm 2.2mm}.lv{display:flex;justify-content:space-between;font-size:8.6pt;margin-bottom:1.5mm}.sl{margin-top:auto;display:flex;align-items:center;gap:2.5mm;font-size:7.4pt;opacity:.85}.sl img{height:6mm}.mn{padding:14mm 12mm 10mm 11mm;display:flex;flex-direction:column}.hd{border-bottom:2px solid #0a6fa0;padding-bottom:5mm;margin-bottom:6mm}.hd h1{margin:0;font-size:24pt;letter-spacing:.4px;color:#0b3550}.hd .tt{margin-top:1.5mm;font-size:10.5pt;color:#0a6fa0;font-weight:bold;letter-spacing:.5px}.hd .sit{margin-top:1.5mm;font-size:9pt;color:#5b7383}h3{margin:0 0 3mm;font-size:10pt;letter-spacing:1.6px;text-transform:uppercase;color:#0a6fa0;display:flex;align-items:center;gap:2mm}h3:after{content:"";flex:1;height:1px;background:#d5e3ec}.bl{margin-bottom:6mm}.bl p{margin:0;font-size:9.6pt;line-height:1.55;text-align:justify;white-space:pre-line}.it{position:relative;padding-left:4.5mm;margin-bottom:3.6mm;border-left:2px solid #d5e3ec}.it:before{content:"";position:absolute;left:-1.6mm;top:1.2mm;width:2.4mm;height:2.4mm;border-radius:50%;background:#0a6fa0}.ih{display:flex;justify-content:space-between;gap:3mm;font-size:9.8pt}.ih b{color:#0b3550;text-transform:uppercase;letter-spacing:.3px}.ih span{color:#5b7383;font-size:8.6pt;white-space:nowrap}.io{font-size:9pt;color:#34505f;margin-top:.6mm}.it p{margin:1.2mm 0 0;font-size:9pt;line-height:1.5;color:#34505f}.ar{display:flex;flex-wrap:wrap;gap:1.8mm}.ar span{font-size:8.6pt;border:1px solid #cfe0ea;color:#0b5f86;border-radius:2px;padding:.8mm 2.4mm}.ft2{margin-top:auto;padding-top:4mm;border-top:1px solid #e6edf2;display:flex;justify-content:space-between;align-items:center;font-size:7.6pt;color:#7a8e9b}.ft2 img{height:5mm}@media print{body{background:#fff}.pg{box-shadow:none;margin:0}}</style>
{% if pdf %}
<style>body{background:#fff;font-family:"DejaVu Sans",Arial,sans-serif}.fundo{position:fixed;left:0;top:0;width:72mm;height:297mm;background:#0a6fa0;z-index:-1}table.pg{display:table;width:210mm;border-collapse:collapse;box-shadow:none;margin:0;background:transparent}table.pg td.sd{width:72mm;display:table-cell;vertical-align:top;padding:14mm 8mm 10mm;background:transparent}table.pg td.mn{display:table-cell;vertical-align:top;padding:14mm 12mm 10mm 11mm}.sb{margin-top:7mm}img.ft{display:block;width:38mm;height:38mm;border-radius:19mm}div.ft.ini{display:block;text-align:center;line-height:38mm;background:#fff}.tg span,.ar span{display:inline-block;margin:0 1.4mm 1.6mm 0}.lv{display:block}.lv b{margin-left:2mm}.sl{margin-top:10mm;display:block}h3{display:block;border-bottom:1px solid #d5e3ec;padding-bottom:1mm}h3:after{display:none}.ih{display:block}.ih b,.ih span{display:block}.ih span{margin-top:.6mm}.ft2{display:block;margin-top:8mm}.ft2 img{margin-left:4mm;vertical-align:middle}</style>
{% endif %}
</head>
<body>
{% if pdf %}<div class="fundo"></div><table class="pg"><tr><td class="sd">{% else %}<div class="pg"><aside class="sd">{% endif %}
{% if foto is null %}
<div class="ft ini">{{ x.iniciais }}</div>
{% elseif pdf %}
<img class="ft" src="{{ foto }}" alt="">
{% else %}
<div class="ft" style="background-image:url('{{ foto }}')"></div>
{% endif %}
{% if x.contato is not empty %}
<div class="sb"><h4>Contato</h4><ul>{% for c in x.contato %}<li><b>{{ c[0] }}</b>{{ c[1] }}</li>{% endfor %}</ul></div>
{% endif %}
{% if x.habilidades is not empty %}
<div class="sb"><h4>Habilidades</h4><div class="tg">{% for h in x.habilidades %}<span>{{ h }}</span>{% endfor %}</div></div>
{% endif %}
{% if x.idiomas is not empty %}
<div class="sb"><h4>Idiomas</h4>{% for i in x.idiomas %}<div class="lv"><span>{{ i.lng }}</span><b>{{ i.nivel }}</b></div>{% endfor %}</div>
{% endif %}
{% if x.disponibilidade is not empty %}
<div class="sb"><h4>Disponibilidade</h4><ul>{% for d in x.disponibilidade %}<li><b>{{ d[0] }}</b>{{ d[1] }}</li>{% endfor %}</ul></div>
{% endif %}
<div class="sl">{% if simboloSrc %}<img src="{{ simboloSrc }}" alt="">{% endif %}<span>Currículo gerado no BlueJus</span></div>
{% if pdf %}</td><td class="mn">{% else %}</aside><main class="mn">{% endif %}
<div class="hd"><h1>{{ x.nome }}</h1>{% if x.titulos %}<div class="tt">{{ x.titulos }}</div>{% endif %}<div class="sit">{{ x.situacao }}</div></div>
{% if x.resumo %}
<div class="bl"><h3>Perfil profissional</h3><p>{{ x.resumo }}</p></div>
{% endif %}
{% if x.experiencias is not empty %}
<div class="bl"><h3>Experiência</h3>{% for e in x.experiencias %}<div class="it"><div class="ih"><b>{{ e.cargo }}</b><span>{{ e.periodo }}</span></div><div class="io">{{ e.org }}</div>{% if e.desc %}<p>{{ e.desc }}</p>{% endif %}</div>{% endfor %}</div>
{% endif %}
{% if x.formacoes is not empty %}
<div class="bl"><h3>Formação</h3>{% for f in x.formacoes %}<div class="it"><div class="ih"><b>{{ f.curso }}</b><span>{{ f.periodo }}</span></div><div class="io">{{ f.inst }}</div></div>{% endfor %}</div>
{% endif %}
{% if x.areas is not empty %}
<div class="bl"><h3>Áreas de atuação</h3><div class="ar">{% for a in x.areas %}<span>{{ a }}</span>{% endfor %}</div></div>
{% endif %}
<div class="ft2"><span>{{ x.nome }}{% if x.email %} · {{ x.email }}{% endif %}</span>{% if logoSrc %}<img src="{{ logoSrc }}" alt="BlueJus">{% else %}<b style="color:#0a6fa0">BlueJus</b>{% endif %}</div>
{% if pdf %}</td></tr></table>{% else %}</main></div>{% endif %}
</body>
</html>
