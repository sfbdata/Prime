{% extends 'base.html.twig' %}

{#
    Trabalho Externo: central nacional de advocacia correspondente.
    Desenho aprovado: docs/design/trabalho-externo/06 - Trabalho Externo 1.0.dc.html (spec em
    docs/specs/trabalho-externo.md). O cabeçalho azul, a subnav e a barra lateral do protótipo
    são a moldura do sistema (base.html.twig); o seletor "Simula o acesso de cada perfil" não
    existe aqui, porque o perfil vem do servidor.

    O template só monta o esqueleto fixo. Lista, KPIs, chips, painel lateral, modais e avisos são
    desenhados pelo public/js/trabalho-externo.js a partir de `data-painel` (MontarPainelUseCase).
    Rotas com {codigo} vão com o marcador TE-0, trocado no JS pelo código real.
#}

{% block title %}{{ 'trabalho_externo.painel.titulo_pagina'|trans }}{% endblock %}

{% block body_class %}te-body{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/trabalho-externo.css') }}">
{% endblock %}

{% block body %}
{% set marcador = 'TE-0' %}
<div class="te-page" id="tePagina"
     data-painel="{{ painel|json_encode|e('html_attr') }}"
     data-codigo-marcador="{{ marcador }}"
     data-eu-id="{{ app.user.id }}"
     data-url-index="{{ path('trabalho_externo_index') }}"
     data-url-painel="{{ path('trabalho_externo_painel') }}"
     data-url-detalhe="{{ path('trabalho_externo_detalhe', {codigo: marcador}) }}"
     data-url-solicitacao="{{ path('trabalho_externo_solicitacao') }}"
     data-url-escritorios-solicitantes="{{ path('trabalho_externo_escritorio_criar') }}"
     data-url-acao="{{ path('trabalho_externo_acao', {codigo: marcador, acao: '__acao__'}) }}"
     data-url-proposta="{{ path('trabalho_externo_proposta', {codigo: marcador}) }}"
     data-url-mensagem="{{ path('trabalho_externo_mensagem', {codigo: marcador}) }}"
     data-url-lida="{{ path('trabalho_externo_lida', {codigo: marcador}) }}"
     data-url-checklist="{{ path('trabalho_externo_checklist', {codigo: marcador, indice: 0}) }}"
     data-url-andamento="{{ path('trabalho_externo_andamento', {codigo: marcador}) }}"
     data-url-anexar="{{ path('trabalho_externo_anexar', {codigo: marcador}) }}"
     data-url-documento="{{ path('trabalho_externo_documento', {codigo: marcador, id: 0}) }}"
     data-url-despachar="{{ path('trabalho_externo_despachar', {codigo: marcador}) }}"
     data-url-pagamento-comprovante="{{ path('trabalho_externo_pagamento_comprovante', {codigo: marcador}) }}"
     data-url-pagamento-confirmar="{{ path('trabalho_externo_pagamento_confirmar', {codigo: marcador}) }}"
     data-url-pagamento-valor="{{ path('trabalho_externo_pagamento_valor', {codigo: marcador}) }}"
     data-url-pagamento-recusar="{{ path('trabalho_externo_pagamento_recusar', {codigo: marcador}) }}"
     data-url-pagamento-avisar="{{ path('trabalho_externo_pagamento_avisar', {codigo: marcador}) }}"
     data-url-despacho-responder="{{ path('trabalho_externo_despacho_responder', {codigo: marcador}) }}"
     data-url-despacho-respostas="{{ path('trabalho_externo_despacho_respostas', {codigo: marcador}) }}"
     data-url-despacho-extrato="{{ path('trabalho_externo_despacho_extrato', {codigo: marcador}) }}"
     data-url-convites="{{ path('trabalho_externo_convidar', {codigo: marcador}) }}"
     data-url-whatsapp="{{ path('trabalho_externo_whatsapp_avisar', {codigo: marcador}) }}"
     data-url-marcacoes="{{ path('trabalho_externo_marcacoes') }}"
     data-url-mensagens-marcacoes="{{ path('trabalho_externo_mensagens_marcacoes', {codigo: marcador}) }}"
     data-url-mensagem-apagar="{{ path('trabalho_externo_mensagem_apagar', {codigo: marcador, id: 0}) }}"
     data-url-configuracao="{{ path('trabalho_externo_configuracao') }}"
     data-url-vagas="{{ path('trabalho_externo_vagas') }}"
     data-url-vaga="{{ path('trabalho_externo_vaga', {codigo: 'VG-0'}) }}"
     data-url-vaga-salvar="{{ path('trabalho_externo_vaga_salvar') }}"
     data-url-vaga-acao="{{ path('trabalho_externo_vaga_acao', {codigo: 'VG-0', acao: '__acao__'}) }}"
     data-url-vaga-editar="{{ path('trabalho_externo_vaga_editar', {codigo: 'VG-0'}) }}"
     data-url-vaga-excluir="{{ path('trabalho_externo_vaga_excluir', {codigo: 'VG-0'}) }}"
     data-url-vagas-visita="{{ path('trabalho_externo_vagas_visita') }}"
     data-url-vagas-marcacoes="{{ path('trabalho_externo_vagas_marcacoes') }}"
     data-url-vagas-compartilhar="{{ path('trabalho_externo_vagas_compartilhar') }}"
     data-url-vagas-divulgacao="{{ path('trabalho_externo_vagas_divulgacao') }}"
     data-url-vaga-candidatura="{{ path('trabalho_externo_vaga_candidatura', {codigo: 'VG-0'}) }}"
     data-url-vaga-recusa="{{ path('trabalho_externo_vaga_recusar', {codigo: 'VG-0'}) }}"
     data-url-vaga-recusa-desfazer="{{ path('trabalho_externo_vaga_recusa_desfazer', {codigo: 'VG-0'}) }}"
     data-url-vaga-enviar="{{ path('trabalho_externo_vaga_enviar', {codigo: 'VG-0'}) }}"
     data-url-candidatura-status="{{ path('trabalho_externo_candidatura_status', {id: 0}) }}"
     data-url-engajamento="{{ path('trabalho_externo_engajamento') }}"
     data-url-vagas-alerta="{{ path('trabalho_externo_vagas_alerta') }}"
     data-url-curriculos="{{ path('trabalho_externo_curriculos') }}"
     data-url-curriculo="{{ path('trabalho_externo_curriculo', {codigo: 'CV-0'}) }}"
     data-url-curriculo-salvar="{{ path('trabalho_externo_curriculo_salvar') }}"
     data-url-curriculo-arquivo="{{ path('trabalho_externo_curriculo_arquivo', {tipo: 'foto'})|replace({'/foto': '/__tipo__'}) }}"
     data-url-curriculo-excluir-meu="{{ path('trabalho_externo_curriculo_excluir_meu') }}"
     data-url-curriculo-excluir="{{ path('trabalho_externo_curriculo_excluir', {codigo: 'CV-0'}) }}"
     data-url-curriculo-status="{{ path('trabalho_externo_curriculo_status', {codigo: 'CV-0'}) }}"
     data-url-curriculo-nota="{{ path('trabalho_externo_curriculo_nota', {codigo: 'CV-0'}) }}"
     data-url-curriculos-marcacoes="{{ path('trabalho_externo_curriculos_marcacoes') }}"
     data-url-curriculo-previa="{{ path('trabalho_externo_curriculo_previa') }}"
     data-url-curriculo-word="{{ path('trabalho_externo_curriculo_word') }}"
     data-url-andamentos="{{ path('trabalho_externo_andamentos') }}"
     {#- "Sons de alerta" do Meu Perfil (perfil_sons()): com "0" o toque do andamento (D10 do desenho 24.10.26) não soa. #}
     data-perfil-sons="{{ perfil_sons() ? '1' : '0' }}"
     data-url-curriculos-csv="{{ path('trabalho_externo_curriculos_csv') }}"
     data-url-curriculos-painel="{{ path('trabalho_externo_curriculos_painel') }}"
     data-url-alertas-csv="{{ path('trabalho_externo_alertas_csv') }}"
     data-url-campanha="{{ path('trabalho_externo_campanha') }}"
     data-url-campanha-csv="{{ path('trabalho_externo_campanha_csv') }}"
     data-url-campanha-html="{{ path('trabalho_externo_campanha_html') }}"
     data-url-campanha-registro="{{ path('trabalho_externo_campanha_registro') }}"
     data-url-simbolo="{{ asset('images/logo/bluejus_simbolo.svg') }}"
     {#- Conta com o e-mail a confirmar não convida (spec login-desenho-10): o JS mostra o aviso e o botão de reenviar o link. #}
     {%- if app.user is not null and not app.user.emailConfirmado %}
     data-recusa-email-a-confirmar="{{ constant('App\\Auth\\UseCase\\CriarConviteEscritorioUseCase::RECUSA_EMAIL_A_CONFIRMAR') }}"
     data-url-reenviar-confirmacao="{{ path('conta_confirmacao_reenviar') }}"
     data-csrf-reenviar-confirmacao="{{ csrf_token('conta_confirmacao_reenviar') }}"
     {%- endif %}>

    <div class="te-titulo-linha">
        <h1 class="te-titulo">
            <i class="bi bi-geo-alt"></i>
            <span class="te-titulo-textos">
                <span class="te-titulo-nome">{{ 'trabalho_externo.painel.nome'|trans }}</span>
                <span class="te-titulo-sub">{{ 'trabalho_externo.painel.subtitulo'|trans }}</span>
            </span>
        </h1>
        <div class="te-titulo-acoes" id="teTituloAcoes"></div>
    </div>

    {# Faixa da pré-visualização do Master (spec §9): fora de #teLiberado, aparece também no bloqueio. #}
    <div id="tePrevia"></div>

    <div id="teBloqueio"></div>

    {# Faixa de abas de módulo (desenho VS 18.10.26, linhas 85 a 87): o JS mostra "Vagas" só a quem a vê. #}
    <div id="teModulos"></div>

    <div id="teLiberado">
        <div id="teAviso"></div>

        <div class="te-periodo" id="tePeriodo"></div>
        <div class="te-kpis" id="teKpis"></div>

        <div class="te-filtros">
            <div class="te-chips" id="teChips"></div>
            <label class="te-busca">
                <i class="bi bi-search"></i>
                <input type="text" id="teBusca" placeholder="{{ 'trabalho_externo.painel.busca_placeholder'|trans }}" autocomplete="off">
            </label>
        </div>

        {# Barra de lote e aviso da lixeira (spec VS 18.10.26 §3.3): o JS preenche conforme a seleção e o filtro. #}
        <div id="teLote"></div>

        <div class="te-tabela-caixa">
            <div class="te-tabela">
                <div class="te-grade te-grade--cab">
                    <div class="te-cab-sel" id="teCabSel"></div><div>{{ 'trabalho_externo.painel.coluna.id'|trans }}</div><div>{{ 'trabalho_externo.painel.coluna.servico'|trans }}</div><div>{{ 'trabalho_externo.painel.coluna.origem_execucao'|trans }}</div><div>{{ 'trabalho_externo.painel.coluna.prazo'|trans }}</div><div>{{ 'trabalho_externo.painel.coluna.responsavel'|trans }}</div><div>{{ 'trabalho_externo.painel.coluna.situacao'|trans }}</div><div class="te-centro">{{ 'trabalho_externo.painel.coluna.chat'|trans }}</div><div></div>
                </div>
                <div id="teLinhas"></div>
            </div>
        </div>
    </div>

    {# Aba Vagas (spec VS 18.10.26 §4.1, desenho linhas 152 a 169; busca `tlBuscaPh`, l.1114): irmã de #teLiberado; o JS troca uma pela outra. #}
    <div id="teVagas" hidden>
        <div class="te-vg-barra">
            <div class="te-vg-sel" id="teVgSel"></div>
            <label class="te-vg-busca">
                <i class="bi bi-search"></i>
                <input type="text" id="teVgBusca" placeholder="{{ 'trabalho_externo.painel.vagas_busca_placeholder'|trans }}" autocomplete="off">
            </label>
            <div class="te-vg-filtros" id="teVgFiltros"></div>
            <span class="te-espaco"></span>
            <div class="te-vg-acoes" id="teVgAcoes"></div>
        </div>
        <div id="teVgLote"></div>
        <div id="teVgVazio"></div>
        <div class="te-vg-grade" id="teVgGrade"></div>
    </div>

    {# Aba Currículos / Meu currículo (spec VS 18.10.26 §4.5): o JS desenha o banco ou o cartão do externo. #}
    <div id="teCurriculos" hidden></div>

    {# Camadas sobrepostas: o JS preenche e mostra. Ficam dentro do .te-page para herdar os tokens do tema. #}
    <div id="teMenu"></div>
    <div id="teDrawer"></div>
    <div id="teNova"></div>
    <div id="teCfg"></div>
    <div id="teConf"></div>
    <div id="teToast"></div>
    <div id="teDesfazer"></div>
    <div id="teVagaModal"></div>
    {# Animação depois de enviar a solicitação (desenho 06 de 24/10, l.737 a 767). #}
    <div id="teEnvio"></div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/trabalho-externo.js') }}" defer></script>
{% endblock %}
