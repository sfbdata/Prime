{#
    Página pública de vagas do Trabalho Externo (desenho `Vagas Publicas.dc.html`, spec VS 18.10.26 §4.2).
    Sem login e sem o layout do sistema: o desenho tem cabeçalho próprio. Os estilos são os inline do
    desenho, passados para classes `vp-*`. Só chega aqui o que o desenho diz que a página mostra
    (cargo, local, tipo, áreas); o bloco borrado de cada cartão é enfeite fixo, sem dado da vaga.

    Contas (P1, decidida pelo desenho em 19/10, spec §4.2): o candidato é o usuário externo (Solicitante
    de qualquer escritório, ou Convidado), e o único cadastro do desenho é "Criar minha conta e
    escritório". Por isso "criar conta" e "divulgar" vão os dois para o /cadastro, e "Entrar" para o /login.
#}
{% set vagas = pagina.vagas %}
{% set total = pagina.total %}
{% set cargos = pagina.cargos %}
{% set ufsVagas = pagina.ufsDasVagas %}
{% set urlCand = path('auth_cadastro') %}
{% set urlDivulgar = path('auth_cadastro') %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, follow">
    <meta name="referrer" content="no-referrer">
    <title>Vagas para Advogados e área Jurídica · BlueJus</title>
    <meta property="og:title" content="Vagas para Advogados e área Jurídica · BlueJus">
    <meta property="og:description" content="Vagas abertas para advogados, estagiários, correspondentes e equipe jurídica. Crie sua conta grátis e candidate-se.">
    <meta property="og:image" content="{{ absolute_url('/images/logo/bluejus_simbolo.svg') }}">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/vagas-publicas.css') }}">
</head>
<body class="vp-body">
<div class="vp-pagina" id="vpPagina" data-publico="{{ app.request.query.get('p') == 'esc' ? 'esc' : 'cand' }}">
    <header class="vp-topo">
        <img src="/images/logo/bluejus-white-transparent-nav.png" alt="BlueJus" class="vp-logo">
        <span class="vp-flex"></span>
        <a href="{{ path('app_login') }}" class="vp-entrar">Entrar</a>
        <a href="{{ urlCand }}" class="vp-criar" data-so="cand">Criar conta grátis</a>
        <a href="{{ urlDivulgar }}" class="vp-criar" data-so="esc">Criar conta grátis</a>
    </header>

    <section class="vp-hero" data-screen-label="Topo">
        <span class="vp-bola vp-bola--1"></span><span class="vp-bola vp-bola--2"></span>
        <div class="vp-hero-in">
            <div class="vp-hero-txt">
                <div class="vp-publicos" role="tablist">
                    <button type="button" data-publico="cand"><i class="bi bi-person-badge"></i>Procuro vaga</button>
                    <button type="button" data-publico="esc"><i class="bi bi-building"></i>Quero contratar</button>
                </div><br>
                <div class="vp-selo"><span class="vp-pulso"></span>
                    <span data-so="cand">{% if vagas is not empty %}{{ total }} vaga(s) aberta(s){% if pagina.geradoEm %} · atualizado em {{ pagina.geradoEm }}{% endif %}{% else %}Central de vagas jurídicas{% endif %}</span>
                    <span data-so="esc">Para escritórios · divulgação gratuita</span>
                </div>
                <h1 class="vp-h1">
                    <span data-so="cand">{{ vagas is not empty ? 'Vagas para Advogados e área Jurídica' : 'Sua próxima vaga na área jurídica começa aqui' }}</span>
                    <span data-so="esc">Encontre advogados e profissionais jurídicos sem gastar com anúncio</span>
                </h1>
                <p class="vp-sub">
                    <span data-so="cand">{% if vagas is not empty %}Escritórios da rede BlueJus estão contratando {{ cargos is not empty ? cargos|slice(0, 3)|join(', ')|lower : 'profissionais da área jurídica' }}{% if ufsVagas is not empty %} em {{ ufsVagas|slice(0, 4)|join(', ') }}{% endif %}. Crie sua conta grátis para ver os detalhes e se candidatar em 1 clique.{% else %}Vagas para advogados, estagiários, correspondentes e equipe jurídica. Crie sua conta grátis para acompanhar.{% endif %}</span>
                    <span data-so="esc">Divulgue grátis para advogados, estagiários, correspondentes e equipe jurídica de todo o Brasil. A equipe BlueJus revisa a vaga e entrega a você uma seleção dos candidatos mais compatíveis.</span>
                </p>
                <div class="vp-hero-ctas">
                    <a href="{{ urlCand }}" class="vp-cta" data-so="cand"><i class="bi bi-person-plus"></i>Criar conta grátis e me candidatar</a>
                    <a href="#alertas" class="vp-cta2" data-so="cand"><i class="bi bi-bell"></i>Receber vagas por e-mail</a>
                    <a href="{{ urlDivulgar }}" class="vp-cta" data-so="esc"><i class="bi bi-megaphone"></i>Divulgar minha vaga grátis</a>
                    <a href="#passos" class="vp-cta2" data-so="esc"><i class="bi bi-play-circle"></i>Como funciona</a>
                </div>
            </div>
            <div class="vp-nums">
                {% set numsCand = vagas is not empty
                    ? [['', total, total == 1 ? 'vaga aberta' : 'vagas abertas'], ['', cargos|length, cargos|length == 1 ? 'cargo' : 'cargos'], ['', ufsVagas|length ?: 1, ufsVagas|length > 1 ? 'estados' : 'estado'], ['', 'Grátis', 'para se candidatar']]
                    : [['bi-lightning-charge', '1 clique', 'para se candidatar'], ['bi-file-earmark-person', 'PDF', 'currículo profissional'], ['bi-bell', 'Avisos', 'de vaga nova'], ['bi-cash-coin', 'Grátis', 'sem pegadinha']] %}
                {% for n in numsCand %}
                    <div class="vp-num" data-so="cand">{% if n[0] %}<i class="bi {{ n[0] }}"></i>{% endif %}<b class="{{ n[0] ? 'vp-num-ic' : 'vp-num-v' }}">{{ n[1] }}</b><span>{{ n[2] }}</span></div>
                {% endfor %}
                {% for n in [['bi-cash-coin', 'R$ 0', 'para divulgar'], ['bi-funnel', 'Seleção', 'dos melhores candidatos'], ['bi-shield-check', 'Revisada', 'pela equipe BlueJus'], ['bi-share', 'Rede', 'WhatsApp, e-mail e LinkedIn']] %}
                    <div class="vp-num" data-so="esc"><i class="bi {{ n[0] }}"></i><b class="vp-num-ic">{{ n[1] }}</b><span>{{ n[2] }}</span></div>
                {% endfor %}
            </div>
        </div>
    </section>

    <main class="vp-main">
        {% if pagina.comLink and vagas is empty %}
            <div class="vp-preenchidas" data-so="cand">
                <span class="vp-preenchidas-ic"><i class="bi bi-hourglass-split"></i></span>
                <div class="vp-preenchidas-txt"><b>As vagas deste link já foram preenchidas</b><div>Novas vagas entram na Central o tempo todo. Crie sua conta e ative os avisos para chegar primeiro na próxima.</div></div>
                <a href="{{ urlCand }}" class="vp-btn"><i class="bi bi-person-plus"></i>Criar conta grátis</a>
            </div>
        {% endif %}

        {% if vagas is not empty %}
            <section class="vp-lista" data-screen-label="Vagas">
                <div class="vp-lista-cab"><h2>{{ vagas|length == 1 ? 'Vaga compartilhada com você' : 'Vagas compartilhadas com você' }}</h2><span>{{ pagina.indicadoPor ? 'Indicadas por ' ~ pagina.indicadoPor : '' }}{{ pagina.geradoEm ? ' · ' ~ pagina.geradoEm : '' }}</span></div>
                <div class="vp-grade">
                    {% for v in vagas %}
                        <div class="vp-card" style="animation-delay: {{ loop.index0 * 80 }}ms">
                            <div class="vp-card-topo"><span class="vp-card-ic"><i class="bi bi-briefcase"></i></span><div class="vp-card-tit"><b>{{ v.titulo }}</b><span>{{ v.cargo }}</span></div>{% if v.qtd > 1 %}<span class="vp-card-q">{{ v.qtd }} vagas</span>{% endif %}</div>
                            <div class="vp-card-dados"><span><i class="bi bi-geo-alt"></i>{{ v.local }}</span><span><i class="bi bi-file-earmark-text"></i>{{ v.contratacao }}</span></div>
                            <div class="vp-card-areas">{% for a in v.areas %}<span>{{ a }}</span>{% endfor %}</div>
                            <div class="vp-card-bloq">
                                <div class="vp-card-borrado" aria-hidden="true">Remuneração: R$ ●●●●<br>Escritório: ●●●●●●●● ●●●●●<br>Requisitos e atividades da vaga ●●●●●●</div>
                                <a href="{{ urlCand }}"><i class="bi bi-lock-fill"></i>Crie sua conta para ver os detalhes</a>
                            </div>
                            <a href="{{ urlCand }}" class="vp-card-cta"><i class="bi bi-send"></i>Quero me candidatar</a>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <section id="passos" class="vp-esc" data-screen-label="Para escritórios" data-so="esc">
            <div><div class="vp-esc-k">PARA ESCRITÓRIOS DE ADVOCACIA</div><h2>Divulgue sua vaga grátis e receba os melhores candidatos</h2><p>Você envia a vaga, a equipe BlueJus revisa, divulga para advogados, estagiários e correspondentes e entrega uma seleção dos candidatos mais compatíveis. Sem anúncio pago, sem triagem de centenas de currículos.</p><a href="{{ urlDivulgar }}" class="vp-btn-verde"><i class="bi bi-megaphone"></i>Divulgar minha vaga grátis</a></div>
            <div class="vp-esc-passos">
                {% for p in [['1', 'Crie a conta do escritório', 'Leva 2 minutos e é gratuito.'], ['2', 'Envie a vaga', 'Formulário padrão: cargo, local, requisitos e por quanto tempo divulgar.'], ['3', 'BlueJus revisa e divulga', 'Publicada na Central e compartilhada com a rede.'], ['4', 'Receba os melhores candidatos', 'A equipe seleciona os mais compatíveis e envia para você.']] %}
                    <div class="vp-passo"><span>{{ p[0] }}</span><span><b>{{ p[1] }}</b>{{ p[2] }}</span></div>
                {% endfor %}
            </div>
        </section>

        <section class="vp-benef" data-screen-label="Benefícios" data-so="cand">
            <h2>Por que criar sua conta no BlueJus</h2>
            <p>É grátis e leva poucos minutos.</p>
            <div class="vp-benef-grade">
                {% for b in [['bi-lightning-charge', '#c76a12', '#fff4d6', 'Candidatura em 1 clique', 'Cadastre o currículo uma vez e use em todas as vagas.'], ['bi-file-earmark-person', '#0a6fa0', '#e5f1f7', 'Currículo profissional grátis', 'Gere seu currículo formatado em PDF, pronto para enviar.'], ['bi-bell', '#5b3f9e', '#efeaf8', 'Avisos de vaga nova', 'Receba primeiro as vagas da sua área e da sua cidade.'], ['bi-building', '#1e7b45', '#e9f6ee', 'Rede de escritórios', 'Vagas de escritórios revisadas pela equipe BlueJus.']] %}
                    <div class="vp-benef-item"><span style="background: {{ b[2] }}; color: {{ b[1] }};"><i class="bi {{ b[0] }}"></i></span><span><b>{{ b[3] }}</b>{{ b[4] }}</span></div>
                {% endfor %}
            </div>
        </section>

        <section id="alertas" class="vp-alertas" data-screen-label="Alertas por e-mail"
                 data-url="{{ path('trabalho_externo_vagas_alertas') }}" data-csrf="{{ csrf_token(csrf) }}" data-token="{{ token }}"
                 data-areas-sugeridas="{{ pagina.areasSugeridas|json_encode|e('html_attr') }}">
            <div class="vp-lead-ok" hidden>
                <span class="vp-lead-ok-ic"><i class="bi bi-envelope-check"></i></span>
                <div class="vp-lead-ok-tit">Pronto! Você vai receber as vagas por e-mail</div>
                <div class="vp-lead-ok-txt" id="vpLeadTxt"></div>
                <a href="{{ urlCand }}" class="vp-btn"><i class="bi bi-person-plus"></i>Criar conta agora</a>
            </div>
            <div class="vp-lead-form">
                <div class="vp-lead-cab"><span><i class="bi bi-bell"></i></span><div><h2>Receba vagas da sua área por e-mail</h2><p>Seja um dos primeiros a saber. Você pode cancelar quando quiser.</p></div></div>
                <div class="vp-lead-campos">
                    <input id="vpEmail" type="email" placeholder="Seu e-mail" autocomplete="email" maxlength="180">
                    <select id="vpUf"><option value="">Todo o Brasil</option>{% for u in pagina.ufs %}<option value="{{ u }}">{{ u }}</option>{% endfor %}</select>
                </div>
                <div class="vp-lead-rot">ÁREAS DE INTERESSE</div>
                <div class="vp-lead-areas" id="vpAreas">{% for a in pagina.areas %}<button type="button" data-area="{{ a }}">{{ a }}</button>{% endfor %}</div>
                <label class="vp-lead-lgpd"><input type="checkbox" id="vpLgpd"><span>{{ pagina.consentimento }}</span></label>
                <div class="vp-lead-erro" id="vpErro" hidden><i class="bi bi-exclamation-circle"></i> <span></span></div>
                <button type="button" class="vp-lead-btn" id="vpInscrever"><i class="bi bi-envelope-paper"></i>Quero receber as vagas</button>
            </div>
        </section>

        <section class="vp-share" data-screen-label="Compartilhar">
            <i class="bi bi-people"></i>
            <div><b>Conhece alguém que procura vaga jurídica?</b><div>Compartilhe estas vagas com colegas, grupos da faculdade e da OAB.</div></div>
            <a href="https://wa.me/?text={{ ('⚖️ Vagas para Advogados e área Jurídica disponíveis no BlueJus! ' ~ (vagas is not empty ? total ~ ' vaga(s): ' ~ cargos|slice(0, 3)|join(', ') ~ '. ' : '') ~ 'Veja: ' ~ (token ? url('trabalho_externo_vagas_link', {token: token}) : url('trabalho_externo_vagas_publicas')))|url_encode }}" target="_blank" rel="noopener noreferrer" class="vp-btn-verde"><i class="bi bi-whatsapp"></i>Enviar no WhatsApp</a>
        </section>
    </main>

    <section class="vp-sistema" data-screen-label="Sistema BlueJus">
        <div class="vp-sistema-in">
            <div><div class="vp-sistema-k">MAIS QUE UMA CENTRAL DE VAGAS</div><h2>O sistema que organiza o escritório inteiro</h2><p>Pastas e expedientes, prazos e publicações do PJe, metas da equipe, financeiro e um assistente com inteligência artificial que avisa o que precisa de atenção. Tudo em um só lugar.</p><a href="{{ urlDivulgar }}" class="vp-btn-branco"><i class="bi bi-rocket-takeoff"></i>Criar conta e conhecer</a></div>
            <div class="vp-recursos">
                {% for r in [['bi-folder2-open', 'Pastas e expedientes', 'Tudo do cliente em um lugar.'], ['bi-alarm', 'Prazos e PJe', 'Publicações e prazos sob controle.'], ['bi-stars', 'Assistente com IA', 'Avisa o que precisa de atenção.'], ['bi-graph-up', 'Metas e financeiro', 'Produtividade e honorários.']] %}
                    <div class="vp-recurso"><i class="bi {{ r[0] }}"></i><b>{{ r[1] }}</b><span>{{ r[2] }}</span></div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="vp-faq" data-screen-label="Perguntas">
        <h2>Perguntas frequentes</h2>
        <div class="vp-faq-lista">
            {% for f in [['É grátis mesmo?', 'Sim. Criar a conta, cadastrar o currículo, gerar o PDF, se candidatar e divulgar vagas não tem custo.'], ['Preciso ter OAB?', 'Não para todas as vagas. Há vagas para advogados, estagiários, estudantes, bacharéis e equipe administrativa. Cada vaga informa se exige OAB ativa.'], ['Como meu escritório divulga uma vaga?', 'Crie a conta, clique em Divulgar uma vaga e preencha os dados. A equipe BlueJus revisa, publica e envia ao escritório uma seleção dos candidatos mais compatíveis.'], ['Meus dados ficam protegidos?', 'Sim. Seguimos a LGPD: o currículo só é compartilhado com o escritório da vaga a que você se candidatar, e você pode excluir tudo quando quiser.'], ['O que mais o BlueJus faz?', 'É um sistema completo de gestão para escritórios: pastas, prazos, publicações, metas, financeiro e assistente com inteligência artificial.']] %}
                <div class="vp-faq-item"><button type="button" aria-expanded="false"><span>{{ f[0] }}</span><i class="bi bi-plus-lg"></i></button><div class="vp-faq-r" hidden>{{ f[1] }}</div></div>
            {% endfor %}
        </div>
    </section>

    <div class="vp-barra">
        <a href="{{ urlCand }}" class="vp-barra-1"><i class="bi bi-person-plus"></i>Procuro vaga</a>
        <a href="{{ urlDivulgar }}" class="vp-barra-2"><i class="bi bi-megaphone"></i>Quero divulgar vaga</a>
    </div>
    <footer class="vp-rodape">BlueJus · gestão para escritórios de advocacia · As vagas são publicadas por escritórios da rede e revisadas pela equipe BlueJus.</footer>
</div>
<script src="{{ asset('js/vagas-publicas.js') }}" defer></script>
</body>
</html>
