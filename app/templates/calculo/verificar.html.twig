{# Verificação pública do código do PDF do Cálculo (spec calculo-atualizacao-monetaria §7). Página avulsa, sem o layout do
   sistema (quem confere pode não ter conta), no mesmo cartão central das páginas públicas.
   Contexto: `resultado` (ResultadoDaVerificacao|null), `aviso` (limite|sessao|arquivo_grande|null), `codigo` (digitado). #}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>{{ 'calculo.verificacao.titulo'|trans }}</title>
    <style>
        body { margin:0; background:#f3f6f8; font-family:Arial, Helvetica, sans-serif; color:#12242f; }
        .cv-campo { display:flex; flex-direction:column; gap:5px; font-size:11.5px; font-weight:bold; color:#4a6373; text-align:left; margin-top:14px; }
        .cv-campo input { height:38px; box-sizing:border-box; border:1px solid #d3dde4; border-radius:3px; padding:0 10px; font-size:14px; font-weight:normal; color:#12242f; background:#fff; }
        .cv-campo input[type=file] { height:auto; padding:7px 10px; font-size:13px; }
        .cv-dica { font-size:12px; font-weight:normal; color:#7a8e9b; }
        .cv-ok, .cv-ruim, .cv-aviso { margin-top:16px; border-radius:3px; padding:11px 14px; font-size:13.5px; line-height:1.55; text-align:left; }
        .cv-ok { background:#e9f6ee; border:1px solid #b9e0c7; color:#1e5e37; }
        .cv-ruim { background:#fdf1f2; border:1px solid #f3c6cb; color:#842029; }
        .cv-aviso { background:#fffaf0; border:1px solid #f1d38a; color:#7a5200; }
        .cv-ok b { display:block; font-size:15px; margin-bottom:4px; }
    </style>
</head>
<body style="min-height:100vh; display:flex; flex-direction:column;">
    <header style="background:#0a6fa0; color:#fff; height:58px; display:flex; align-items:center; padding:0 18px;">
        <span style="font-size:20px; font-weight:bold;">BlueJus</span>
    </header>
    <main style="flex:1; display:flex; align-items:center; justify-content:center; padding:40px 16px;">
        <div style="width:min(520px, 100%); background:#fff; border:1px solid #dde5eb; border-radius:8px; padding:30px 28px; text-align:center;">
            <h1 style="font-size:19px; font-weight:bold; margin:0 0 6px;">{{ 'calculo.verificacao.titulo'|trans }}</h1>
            <p style="margin:0; font-size:14px; color:#4a6373; line-height:1.55;">{{ 'calculo.verificacao.subtitulo'|trans }}</p>

            <form method="post" action="{{ path('calculo_verificar') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('calculo_verificar') }}">
                <label class="cv-campo">{{ 'calculo.verificacao.codigo_rotulo'|trans }}
                    <input type="text" name="codigo" value="{{ codigo }}" maxlength="20" placeholder="{{ 'calculo.verificacao.codigo_ph'|trans }}" autocomplete="off" autocapitalize="characters" spellcheck="false">
                </label>
                <label class="cv-campo">{{ 'calculo.verificacao.arquivo_rotulo'|trans }}
                    <input type="file" name="arquivo" accept="application/pdf,.pdf">
                    <span class="cv-dica">{{ 'calculo.verificacao.arquivo_dica'|trans }}</span>
                </label>
                <button type="submit" style="margin-top:18px; height:40px; padding:0 22px; border:none; border-radius:3px; background:#0a6fa0; color:#fff; font-size:14.5px; font-weight:bold; cursor:pointer;">{{ 'calculo.verificacao.botao'|trans }}</button>
            </form>

            {% if aviso %}
                <div class="cv-aviso" role="alert">{{ ('calculo.verificacao.' ~ aviso)|trans }}</div>
            {% elseif resultado %}
                {% if resultado.estado == 'encontrado' %}
                    <div class="cv-ok" role="status">
                        <b>{{ 'calculo.verificacao.encontrado'|trans }} {{ resultado.codigo }}</b>
                        {{ 'calculo.verificacao.emitido_por'|trans({escritorio: resultado.escritorio ?? ''}) }}<br>
                        {{ 'calculo.verificacao.emitido_em'|trans({data: resultado.emitidoEm|date('d/m/Y H:i')}) }}<br>
                        {{ 'calculo.verificacao.atualizado_ate'|trans({data: resultado.atualizadoAte|date('d/m/Y')}) }}<br>
                        {{ 'calculo.verificacao.total'|trans({valor: resultado.total|number_format(2, ',', '.')}) }}
                    </div>
                    {% if resultado.confere is same as(true) %}
                        <div class="cv-ok" role="status">{{ 'calculo.verificacao.confere_sim'|trans }}</div>
                    {% elseif resultado.confere is same as(false) %}
                        <div class="cv-ruim" role="alert">{{ 'calculo.verificacao.confere_nao'|trans }}</div>
                    {% else %}
                        <div class="cv-aviso">{{ 'calculo.verificacao.sem_arquivo'|trans }}</div>
                    {% endif %}
                {% else %}
                    <div class="cv-ruim" role="alert">{{ ('calculo.verificacao.' ~ resultado.estado)|trans }}</div>
                {% endif %}
            {% endif %}
        </div>
    </main>
</body>
</html>
