{# A do topo: sempre visível quando há pastas, como no desenho (dc L.131-135); com 1 página, só o "1".
   Setas em ícone (bi-chevron-double-left/left/right/double-right), como o dc L.428-430 (AUD-13).
   A do rodapé (`paginacaoRodape`, só do BlueJus): só com mais de uma página, como era antes.
   Dicas do desenho 03 (dc `pags`: "Primeira página", "Página N de M"...) pelo sistema de dicas da lista. #}
{% if pagination.total_items > 0 and (not (paginacaoRodape ?? false) or pagination.total_pages > 1) %}
    {% set max_botoes = 8 %}
    {% set total = pagination.total_pages %}
    {% set atual = pagination.current_page %}
    {% set metade = (max_botoes / 2)|round(0, 'floor') %}
    {% set start = atual - metade %}
    {% set end   = start + max_botoes - 1 %}
    {% if start < 1 %}
        {% set start = 1 %}
        {% set end = min(total, start + max_botoes - 1) %}
    {% endif %}
    {% if end > total %}
        {% set end = total %}
        {% set start = max(1, end - max_botoes + 1) %}
    {% endif %}

    <nav aria-label="{{ 'expediente.paginacao.rotulo'|trans }}" class="d-flex align-items-center justify-content-end my-0">
        <ul class="pagination pagination-sm mb-0">

            <li class="page-item {{ pagination.current_page <= 1 ? 'disabled' : '' }}">
                <button type="button"
                        class="page-link btn-pagina"
                        data-page="1"
                        aria-label="{{ 'expediente.paginacao.primeira'|trans }}" data-tip="{{ 'expediente.paginacao.primeira'|trans }}"
                        {% if pagination.current_page <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}>
                    <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
                </button>
            </li>

            <li class="page-item {{ pagination.current_page <= 1 ? 'disabled' : '' }}">
                <button type="button"
                        class="page-link btn-pagina"
                        data-page="{{ pagination.current_page - 1 }}"
                        aria-label="{{ 'expediente.paginacao.anterior'|trans }}" data-tip="{{ 'expediente.paginacao.anterior'|trans }}"
                        {% if pagination.current_page <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}>
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
            </li>

            {% for p in start..end %}
                <li class="page-item {{ p == pagination.current_page ? 'active' : '' }}">
                    <button type="button"
                            class="page-link btn-pagina"
                            data-page="{{ p }}"
                            aria-label="{{ 'expediente.paginacao.pagina_n_de_m'|trans({pagina: p ~ '', total: total ~ ''}) }}" data-tip="{{ 'expediente.paginacao.pagina_n_de_m'|trans({pagina: p ~ '', total: total ~ ''}) }}"
                            {% if p == pagination.current_page %}aria-current="page"{% endif %}>
                        {{ p }}
                    </button>
                </li>
            {% endfor %}

            <li class="page-item {{ pagination.total_pages <= pagination.current_page ? 'disabled' : '' }}">
                <button type="button"
                        class="page-link btn-pagina"
                        data-page="{{ pagination.current_page + 1 }}"
                        aria-label="{{ 'expediente.paginacao.proxima'|trans }}" data-tip="{{ 'expediente.paginacao.proxima'|trans }}"
                        {% if pagination.total_pages <= pagination.current_page %}aria-disabled="true" tabindex="-1"{% endif %}>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </li>

            <li class="page-item {{ pagination.total_pages <= pagination.current_page ? 'disabled' : '' }}">
                <button type="button"
                        class="page-link btn-pagina"
                        data-page="{{ pagination.total_pages }}"
                        aria-label="{{ 'expediente.paginacao.ultima'|trans }}" data-tip="{{ 'expediente.paginacao.ultima'|trans }}"
                        {% if pagination.total_pages <= pagination.current_page %}aria-disabled="true" tabindex="-1"{% endif %}>
                    <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
                </button>
            </li>

        </ul>
    </nav>
{% endif %}
