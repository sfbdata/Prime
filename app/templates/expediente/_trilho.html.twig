{# Trilho do Expediente no desenho 1.1 (dc L.74-95, E12): "Todas as pastas" com atualizar, os filtros do sistema
   (EXPEDIENTES) e os marcadores com submarcadores, arrastáveis. Renderizado aqui e servido de novo pela rota
   `expediente_trilho` depois de criar, editar, excluir ou reordenar um marcador (expediente-trilho.js).
   Quem é o item aberto e quais grupos estão abertos é estado da tela: o JS reaplica depois de cada troca. #}
{% set filtrosSistema = [
    {chave: 'resp10',     nome: 'Respondidos nos últimos 10 dias',               icone: 'bi-reply',          nota: 'Pastas com comentário, meta, prazo ou ação registrada nos últimos 10 dias (cada pasta conta uma vez)'},
    {chave: 'findou',     nome: 'Prazo findou nos últimos 10 dias sem resposta', icone: 'bi-hourglass-bottom', nota: 'Um prazo (registrado na pasta ou de meta) venceu nos últimos 10 dias e não houve nenhuma ação na pasta depois da data'},
    {chave: 'aud',        nome: 'Audiência',                                     icone: 'bi-people',         nota: 'Pastas com audiência marcada (hoje ou futura), registrada em Próximos prazos da pasta'},
    {chave: 'prazo',      nome: 'Expediente com prazo',                          icone: 'bi-calendar-event', nota: 'Pastas com prazo em aberto de hoje em diante: registrado na pasta ou de meta'},
    {chave: 'metas',      nome: 'Metas não respondidas',                         icone: 'bi-check2-square',  nota: 'Pastas com meta aberta ainda sem resposta ou conclusão'},
    {chave: 'protocolar', nome: 'Protocolar',                                    icone: 'bi-send',           nota: 'Em breve: depende da fase Protocolo do andamento da pasta, que o sistema ainda não tem', emBreve: true},
] %}
<div class="exp-tri" id="expTrilho"
     data-url-trilho="{{ path('expediente_trilho') }}"
     data-url-acervo="{{ path('expediente_acervo_geral') }}"
     data-url-marcador="{{ path('expediente_marcador_pastas', {id: 0}) }}"
     data-url-criar="{{ path('expediente_marcador_criar') }}"
     data-url-editar="{{ path('expediente_marcador_editar', {id: 0}) }}"
     data-url-excluir="{{ path('expediente_marcador_excluir', {id: 0}) }}"
     data-url-reordenar="{{ path('expediente_marcador_reordenar', {id: 0}) }}"
     data-csrf-criar="{{ csrf_token('marcador') }}"
     data-csrf-lista="{{ csrf_token('expediente_lista') }}"
     data-total="{{ totalPastas }}">

    <button type="button" class="exp-tri-todas expediente-menu-link" data-painel="{{ path('expediente_acervo_geral') }}"
            data-tip="Todas as pastas · {{ totalPastas|number_format(0, ',', '.') }}">
        <i class="bi bi-folder2" aria-hidden="true"></i>
        <span class="exp-tri-rotulo exp-tri-todas-nome">Todas as pastas</span>
        <span class="exp-tri-atualizar js-tri-padrao" role="button" tabindex="0"
              data-tip="Atualizar e voltar ao início (todas as pastas, sem filtros)" aria-label="Atualizar e voltar ao início">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
        </span>
    </button>

    <div class="exp-tri-cab exp-tri-cab--sistema">
        <span class="exp-tri-titulo">Expedientes</span>
        <i class="bi bi-lock exp-tri-cadeado" data-tip="Filtros do sistema: não podem ser editados nem excluídos" aria-hidden="true"></i>
    </div>
    <div class="exp-tri-lista" role="list" aria-label="Filtros do sistema">
        {% for f in filtrosSistema %}
            {% set n = f.emBreve ?? false ? null : (contagensExpediente[f.chave] ?? 0) %}
            <div role="listitem">
                <div class="exp-tri-item exp-tri-sistema{% if f.emBreve ?? false %} is-em-breve{% endif %}{% if f.chave == 'findou' and n > 0 %} is-alerta{% endif %}"
                     role="button" tabindex="0" data-expediente="{{ f.chave }}" data-nome="{{ f.nome }}" data-nota="{{ f.nota }}"
                     data-icone="{{ f.icone }}" data-tip-fechado="{{ f.nome }}"
                     {% if f.emBreve ?? false %}aria-disabled="true" data-tip="{{ f.nome }} · em breve"{% endif %}>
                    <i class="bi bi-chevron-right exp-tri-seta" aria-hidden="true"></i>
                    <i class="bi {{ f.icone }} exp-tri-icone-fechado" aria-hidden="true"></i>
                    <span class="exp-tri-rotulo exp-tri-nome">{{ f.nome }}</span>
                    <span class="exp-tri-n">{% if f.emBreve ?? false %}<span class="exp-tri-breve">em breve</span>{% else %}{{ n }}{% endif %}</span>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="exp-tri-cab exp-tri-cab--marcadores">
        <span class="exp-tri-titulo">Marcadores</span>
        <button type="button" class="exp-tri-mais js-tri-cab-mais" data-tip="Opções dos marcadores" aria-label="Opções dos marcadores" aria-haspopup="menu">
            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
        </button>
        <button type="button" class="exp-tri-recolher js-tri-recolher" id="expedienteSidebarToggleBtn" data-tip="Recolher painel" aria-label="Recolher ou expandir o painel">
            <i class="bi bi-chevron-left" id="expedienteSidebarToggleIcon" aria-hidden="true"></i>
        </button>
    </div>
    <div class="exp-tri-lista" id="lista-marcadores" role="list" aria-label="Marcadores">
        {% for marcador in pastas %}
            {% set corTela = marcador.cor|cor_marcador %}
            {% set total = contagemRaiz[marcador.id] ?? 0 %}
            <div role="listitem" class="exp-tri-grupo" id="item-pasta-{{ marcador.id }}">
                <div class="exp-tri-item exp-tri-marcador expediente-menu-link" role="button" tabindex="0" draggable="true"
                     data-marcador-id="{{ marcador.id }}" data-pai-id="" data-nome="{{ marcador.nome }}"
                     data-cor="{{ marcador.cor }}" data-cor-tela="{{ corTela }}" data-descricao="{{ marcador.descricao }}"
                     data-n="{{ total }}" data-filhos="{{ marcador.filhos|length }}"
                     data-token="{{ csrf_token('editar_marcador_' ~ marcador.id) }}"
                     data-token-excluir="{{ csrf_token('excluir_marcador_' ~ marcador.id) }}"
                     data-tip="{{ marcador.descricao ?: marcador.nome }}" style="--mk-cor: {{ corTela }};">
                    <span class="exp-tri-abrir{% if marcador.filhos is empty %} is-vazio{% endif %} js-tri-abrir"
                          {% if marcador.filhos is not empty %}data-tip="Ver {{ marcador.filhos|length }} submarcador(es)" role="button" aria-label="Ver submarcadores" aria-expanded="false"{% endif %}>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </span>
                    <i class="bi bi-folder-fill exp-tri-pasta" aria-hidden="true"></i>
                    <span class="exp-tri-rotulo exp-tri-nome expediente-item-nome">{{ marcador.nome }}</span>
                    <button type="button" class="exp-tri-opcoes js-tri-opcoes" aria-label="Opções do marcador" data-tip="Opções do marcador">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                    <span class="exp-tri-n js-contagem-marcador">{{ total > 0 ? total : '' }}</span>
                </div>
                {% if marcador.filhos is not empty %}
                    <div class="exp-tri-subs" role="list" hidden>
                        {% for sub in marcador.filhos %}
                            {% set corSub = sub.cor|cor_marcador %}
                            {% set nSub = contagemPastas[sub.id] ?? 0 %}
                            <div role="listitem" id="item-pasta-{{ sub.id }}">
                                <div class="exp-tri-item exp-tri-marcador exp-tri-sub expediente-submenu-link" role="button" tabindex="0" draggable="true"
                                     data-marcador-id="{{ sub.id }}" data-pai-id="{{ marcador.id }}" data-nome="{{ sub.nome }}"
                                     data-cor="{{ sub.cor }}" data-cor-tela="{{ corSub }}" data-descricao="{{ sub.descricao }}"
                                     data-n="{{ nSub }}" data-filhos="0"
                                     data-token="{{ csrf_token('editar_marcador_' ~ sub.id) }}"
                                     data-token-excluir="{{ csrf_token('excluir_marcador_' ~ sub.id) }}"
                                     data-tip="{{ sub.descricao ?: sub.nome }}" style="--mk-cor: {{ corSub }};">
                                    <i class="bi bi-folder-fill exp-tri-pasta" aria-hidden="true"></i>
                                    <span class="exp-tri-rotulo exp-tri-nome expediente-item-nome">{{ sub.nome }}</span>
                                    <button type="button" class="exp-tri-opcoes js-tri-opcoes" aria-label="Opções do marcador" data-tip="Opções do marcador">
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                    <span class="exp-tri-n js-contagem-marcador">{{ nSub > 0 ? nSub : '' }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
