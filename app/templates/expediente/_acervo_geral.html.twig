<div class="p-3" id="acervo-geral-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="m-0"><i class="bi bi-folder2-open me-2"></i>Acervo geral</h5>
        <button type="button" class="btn btn-sm btn-primary" style="background-color:#0069a0;border-color:#0069a0;"
                data-bs-toggle="modal" data-bs-target="#modalNovaPasta">
            <i class="bi bi-plus-lg me-1"></i> Nova Pasta
        </button>
    </div>

    {{ include('expediente/_paginacao.html.twig') }}
    {{ include('pasta/_tabela.html.twig') }}
    {{ include('expediente/_paginacao.html.twig') }}
</div>

<script>
(function () {
    var painel = document.getElementById('expediente-painel');
    var form = document.getElementById('formFiltrosPasta');
    if (!form || !painel) return;

    function carregarComFiltros(url) {
        painel.innerHTML = '<div class="p-4 text-center text-muted"><i class="bi bi-hourglass-split"></i> Carregando...</div>';
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                painel.innerHTML = html;
                painel.scrollIntoView({ block: 'start' });
            })
            .catch(function () {
                painel.innerHTML = '<div class="p-4 alert alert-danger">Erro ao carregar o conteúdo.</div>';
            });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        carregarComFiltros(form.action + '?' + new URLSearchParams(new FormData(form)).toString());
    });

    painel.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-pagina');
        if (!btn) return;
        e.preventDefault();
        var params = new URLSearchParams(new FormData(form));
        params.set('page', btn.dataset.page);
        carregarComFiltros(form.action + '?' + params.toString());
    });
})();
</script>
