{# Barra do acervo do desenho (dc L.79-82): faixa clara, título 17px e "Nova Pasta" cinza que fica azul. #}
<div class="exp-painel" id="acervo-geral-wrapper">
    <div class="exp-barra">
        {# Título (dc `titulo`, L.120, E12): o filtro do sistema aberto no trilho, ou "Acervo geral"; clicar volta
           ao acervo geral sem filtros. #}
        {% set TITULOS = {resp10: 'expediente.acervo.titulo.resp10'|trans, findou: 'expediente.acervo.titulo.findou'|trans, aud: 'expediente.acervo.titulo.aud'|trans, prazo: 'expediente.acervo.titulo.prazo'|trans, metas: 'expediente.acervo.titulo.metas'|trans, protocolar: 'expediente.acervo.titulo.protocolar'|trans} %}
        <h2 class="exp-barra-titulo" role="button" tabindex="0" data-tip="{{ 'expediente.acervo.voltar_dica'|trans }}"><i class="bi bi-folder2" aria-hidden="true"></i>{{ TITULOS[filters.expediente ?? ''] ?? 'expediente.acervo.titulo.geral'|trans }}</h2>
        <button type="button" class="exp-nova-pasta"
                data-bs-toggle="modal" data-bs-target="#modalNovaPasta"
                data-tip="{{ 'expediente.acervo.nova_pasta_dica'|trans }}">
            <i class="bi bi-folder-plus" aria-hidden="true"></i>{{ 'expediente.acervo.nova_pasta'|trans }}
        </button>
        {{ include('pasta/_filtro_situacao.html.twig') }}
    </div>

    {{ include('pasta/_filtros.html.twig') }}

    <div id="pastas-resultado">
        {{ include('expediente/_lista.html.twig') }}
        {# A paginação do desenho é a do topo (dentro da tabela); esta, no rodapé, é só do BlueJus e só
           aparece com mais de uma página. #}
        <div class="mt-2">
            {{ include('expediente/_paginacao.html.twig', {paginacaoRodape: true}) }}
        </div>
    </div>
</div>
