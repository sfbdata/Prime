<div class="expediente-workspace" id="acervo-geral-wrapper">
    <div class="expediente-context-bar">
        <div>
            <span class="expediente-context-kicker">Visão geral</span>
            <h2 class="expediente-context-title">{{ tituloPainel|default('Todas as pastas') }}</h2>
        </div>
        <div class="expediente-total" aria-label="Total de pastas encontradas">
            <strong>{{ pagination.total_items }}</strong>
            <span>pasta{{ pagination.total_items != 1 ? 's' : '' }}</span>
        </div>
    </div>

    {{ include('pasta/_filtros.html.twig') }}

    <div id="pastas-resultado">
        {{ include('pasta/_tabela.html.twig') }}
        <div class="expediente-pagination-footer">
            {{ include('expediente/_paginacao.html.twig') }}
        </div>
    </div>
</div>
