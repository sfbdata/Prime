{% set corFundo = marcador.cor ? 'background:' ~ marcador.cor ~ ';border-left:4px solid rgba(0,0,0,0.12);' : '' %}
<div class="p-3" id="painel-marcador-wrapper" data-marcador-id="{{ marcador.id }}">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="m-0 d-flex align-items-center gap-2">
            <span class="badge rounded-pill px-2 py-1"
                  {% if marcador.cor %}style="background:{{ marcador.cor }};color:#333;border:1px solid rgba(0,0,0,0.1);"{% else %}style="background:#e9ecef;color:#333;"{% endif %}>
                <i class="bi bi-tag me-1"></i>{{ marcador.nome }}
            </span>
            <span class="text-muted small fw-normal">{{ pastas|length }} pasta{{ pastas|length != 1 ? 's' : '' }}</span>
        </h5>
        <a href="{{ path('pasta_new') }}" class="btn btn-sm btn-success">
            <i class="bi bi-plus-lg me-1"></i> Nova Pasta
        </a>
    </div>

    {{ include('pasta/_tabela.html.twig') }}
</div>

<script>
(function () {
    var painel = document.getElementById('expediente-painel');
    var form = document.getElementById('formFiltrosPasta');
    if (!form || !painel) return;

    function carregarComFiltros(url) {
        painel.innerHTML = '<div class="p-4 text-center text-muted"><i class="bi bi-hourglass-split"></i> Carregando...</div>';
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) { painel.innerHTML = html; })
            .catch(function () {
                painel.innerHTML = '<div class="p-4 alert alert-danger">Erro ao carregar o conteúdo.</div>';
            });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        carregarComFiltros(form.action + '?' + new URLSearchParams(new FormData(form)).toString());
    });
})();
</script>
