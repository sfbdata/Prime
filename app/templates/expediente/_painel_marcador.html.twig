{% set corFundo = marcador.cor ? 'background:' ~ marcador.cor ~ ';border-left:4px solid rgba(0,0,0,0.12);' : '' %}
<div class="p-2 p-md-3" id="painel-marcador-wrapper" data-marcador-id="{{ marcador.id }}">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge rounded-pill px-2 py-1 fs-6"
                  {% if marcador.cor %}style="background:{{ marcador.cor }};color:#333;border:1px solid rgba(0,0,0,0.1);"{% else %}style="background:#e9ecef;color:#333;"{% endif %}>
                <i class="bi bi-tag me-1"></i>{{ marcador.nome }}
            </span>
            <span class="text-muted small fw-normal">{{ pagination.total_items }} pasta{{ pagination.total_items != 1 ? 's' : '' }}</span>
        </div>
        <button type="button" class="btn btn-sm btn-primary" style="background-color:#0069a0;border-color:#0069a0;" data-bs-toggle="modal" data-bs-target="#modalNovaPasta">
            <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">Nova Pasta</span><span class="d-sm-none">Nova</span>
        </button>
    </div>

    {{ include('expediente/_paginacao.html.twig') }}
    {{ include('pasta/_tabela.html.twig') }}
    {{ include('expediente/_paginacao.html.twig') }}
</div>

<script>
(function () {
    var painel = document.getElementById('expediente-painel');
    var form = document.getElementById('formFiltrosPasta');
    if (!form || !painel) return;

    function carregarComFiltros(url) {
        painel.innerHTML = '<div class="p-4 text-center text-muted"><i class="bi bi-hourglass-split"></i> Carregando...</div>';
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                painel.innerHTML = html;
                painel.scrollIntoView({ block: 'start' });
            })
            .catch(function () {
                painel.innerHTML = '<div class="p-4 alert alert-danger">Erro ao carregar o conteúdo.</div>';
            });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        carregarComFiltros(form.action + '?' + new URLSearchParams(new FormData(form)).toString());
    });

    painel.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-pagina');
        if (!btn) return;
        e.preventDefault();
        var params = new URLSearchParams(new FormData(form));
        params.set('page', btn.dataset.page);
        carregarComFiltros(form.action + '?' + params.toString());
    });
})();
</script>
