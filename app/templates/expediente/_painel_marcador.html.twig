{% set corFundo = marcador.cor ? 'background:' ~ marcador.cor ~ ';border-left:4px solid rgba(0,0,0,0.12);' : '' %}
{# Barra do desenho (dc L.79-82): o título é o nome do marcador. O pastel do usuário fica como fundo do
   nome (decisão 14/10), e o total de pastas do marcador continua ao lado. #}
<div class="exp-painel" id="painel-marcador-wrapper" data-marcador-id="{{ marcador.id }}">
    <div class="exp-barra">
        <h2 class="exp-barra-titulo">
            <i class="bi bi-folder2" aria-hidden="true"></i>
            <span class="exp-barra-marcador"{% if marcador.cor %} style="background:{{ marcador.cor }};"{% endif %}>{{ marcador.nome }}</span>
            <span class="exp-barra-total">{{ pagination.total_items }} pasta{{ pagination.total_items != 1 ? 's' : '' }}</span>
        </h2>
        <button type="button" class="exp-nova-pasta" data-bs-toggle="modal" data-bs-target="#modalNovaPasta"
                title="Abrir uma nova pasta (o número é gerado automaticamente)">
            <i class="bi bi-folder-plus" aria-hidden="true"></i><span class="d-none d-sm-inline">Nova Pasta</span><span class="d-sm-none">Nova</span>
        </button>
        {{ include('pasta/_filtro_situacao.html.twig') }}
    </div>

    {{ include('pasta/_filtros.html.twig') }}

    <div id="pastas-resultado">
        {{ include('pasta/_tabela.html.twig') }}
        {# A paginação do desenho é a do topo (dentro da tabela); esta, no rodapé, é só do BlueJus e só
           aparece com mais de uma página. #}
        <div class="mt-2">
            {{ include('expediente/_paginacao.html.twig', {paginacaoRodape: true}) }}
        </div>
    </div>
</div>
