{% set corFundo = marcador.cor ? 'background:' ~ marcador.cor ~ ';border-left:4px solid rgba(0,0,0,0.12);' : '' %}
<div class="expediente-workspace" id="painel-marcador-wrapper" data-marcador-id="{{ marcador.id }}">
    <div class="expediente-context-bar">
        <div>
            <span class="expediente-context-kicker">Marcador</span>
            <h2 class="expediente-context-title d-flex align-items-center gap-2">
            <span class="expediente-marker-dot"
                  {% if marcador.cor %}style="background:{{ marcador.cor }};color:#333;border:1px solid rgba(0,0,0,0.1);"{% else %}style="background:var(--bs-tertiary-bg);color:var(--bs-body-color);"{% endif %}>
            </span>
            {{ marcador.nome }}
            </h2>
        </div>
        <div class="expediente-total"><strong>{{ pagination.total_items }}</strong><span>pasta{{ pagination.total_items != 1 ? 's' : '' }}</span></div>
    </div>

    {{ include('pasta/_filtros.html.twig') }}

    <div id="pastas-resultado">
        {{ include('pasta/_tabela.html.twig') }}
        <div class="expediente-pagination-footer">
            {{ include('expediente/_paginacao.html.twig') }}
        </div>
    </div>
</div>
