{% set grupoId = 'pasta-' ~ marcador.id %}
{% set estiloLink = marcador.cor ? '--marcador-cor:' ~ marcador.cor ~ ';' : '' %}
<li class="expediente-menu-item" id="item-pasta-{{ marcador.id }}">
    <a href="#" class="expediente-menu-link{{ marcador.cor ? ' com-cor' : '' }}"
       data-grupo="{{ grupoId }}" data-cor="{{ marcador.cor }}"
       data-marcador-id="{{ marcador.id }}"
       {% if estiloLink %}style="{{ estiloLink }}"{% endif %}>
        <i class="bi bi-chevron-right expediente-chevron"></i>
        <i class="bi bi-folder2 expediente-icon"></i>
        {% if marcador.cor %}<span class="marcador-cor-dot" style="background:{{ marcador.cor }};" title="{{ marcador.nome }}"></span>{% endif %}
        <span class="expediente-item-nome" title="{{ marcador.nome }}">{{ marcador.nome }}</span>
        <button type="button"
                class="expediente-btn-add-sub ms-auto"
                data-pai-id="{{ marcador.id }}"
                data-pai-nome="{{ marcador.nome }}"
                title="Novo sub-marcador">
            <i class="bi bi-plus-lg"></i>
        </button>
        <button type="button"
                class="expediente-btn-acao js-editar-marcador"
                data-id="{{ marcador.id }}"
                data-nome="{{ marcador.nome }}"
                data-token="{{ csrf_token('editar_marcador_' ~ marcador.id) }}"
                data-token-excluir="{{ csrf_token('excluir_marcador_' ~ marcador.id) }}"
                title="Editar marcador">
            <i class="bi bi-pencil"></i>
        </button>
        {% if contagemPastas[marcador.id] is defined and contagemPastas[marcador.id] > 0 %}
            <span class="js-contagem-marcador ms-1" title="{{ contagemPastas[marcador.id] }} pasta(s)">{{ contagemPastas[marcador.id] }}</span>
        {% endif %}
    </a>
    <ul class="expediente-submenu" id="grupo-{{ grupoId }}">
        {% for sub in marcador.filhos %}
            {% set estiloSub = sub.cor ? '--marcador-cor:' ~ sub.cor ~ ';' : '' %}
            <li id="item-pasta-{{ sub.id }}">
                <a href="#" class="expediente-submenu-link{{ sub.cor ? ' com-cor' : '' }}"
                   data-cor="{{ sub.cor }}" data-marcador-id="{{ sub.id }}"
                   {% if estiloSub %}style="{{ estiloSub }}"{% endif %}>
                    <i class="bi bi-folder2 expediente-sub-icon"></i>
                    {% if sub.cor %}<span class="marcador-cor-dot" style="background:{{ sub.cor }};"></span>{% endif %}
                    <span class="expediente-item-nome" title="{{ sub.nome }}">{{ sub.nome }}</span>
                    <button type="button"
                            class="expediente-btn-acao expediente-btn-acao-sub js-editar-marcador ms-auto"
                            data-id="{{ sub.id }}"
                            data-nome="{{ sub.nome }}"
                            data-token="{{ csrf_token('editar_marcador_' ~ sub.id) }}"
                            data-token-excluir="{{ csrf_token('excluir_marcador_' ~ sub.id) }}"
                            title="Editar sub-marcador">
                        <i class="bi bi-pencil"></i>
                    </button>
                    {% if contagemPastas[sub.id] is defined and contagemPastas[sub.id] > 0 %}
                        <span class="js-contagem-marcador ms-1" title="{{ contagemPastas[sub.id] }} pasta(s)">{{ contagemPastas[sub.id] }}</span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
</li>
