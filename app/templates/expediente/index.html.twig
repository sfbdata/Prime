{% extends 'base.html.twig' %}

{% macro paletaCores(containerId) %}
<div class="marcador-cores" id="{{ containerId }}">
    <button type="button" class="marcador-cor-btn" data-cor="" title="Sem cor">
        <i class="bi bi-slash-circle text-muted" style="font-size:1rem;"></i>
    </button>
    <button type="button" class="marcador-cor-btn" data-cor="#fde8e8" style="background:#fde8e8;" title="Rosa"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#fde8f5" style="background:#fde8f5;" title="Lilás rosa"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#ede8fd" style="background:#ede8fd;" title="Lavanda"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#e8eafd" style="background:#e8eafd;" title="Azul lavanda"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#e8f4fd" style="background:#e8f4fd;" title="Azul claro"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#e8fdf0" style="background:#e8fdf0;" title="Verde menta"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#fdf6e8" style="background:#fdf6e8;" title="Amarelo creme"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#fde8d0" style="background:#fde8d0;" title="Pêssego"></button>
    <button type="button" class="marcador-cor-btn" data-cor="#f0f0f0" style="background:#f0f0f0;" title="Cinza claro"></button>
</div>
{% endmacro %}

{% block title %}Expediente{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-inbox-fill me-2"></i>Expediente</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Label do painel ativo (mobile) ── #}
        <div class="d-flex d-md-none align-items-center mb-2 px-1" style="min-height:28px;">
            <small class="text-muted" id="labelPainelAtivo"></small>
        </div>

        {# ── Botão pull-tab mobile (fixo na borda esquerda) ── #}
        <button type="button" class="btn-expediente-pull-tab d-md-none" id="btnAbrirDrawer"
                aria-label="Abrir menu de navegação" aria-expanded="false">
            <i class="bi bi-chevron-right" id="iconePullTab"></i>
        </button>

        {# ── Overlay mobile ── #}
        <div class="expediente-overlay" id="expedienteOverlay"></div>

        <div class="row g-0" style="min-height: calc(100vh - 160px);">

            {# ── Menu lateral do expediente ── #}
            <div class="col-auto expediente-sidebar" id="expedienteSidebar">
                {# Header do drawer — visível apenas em mobile #}
                <div class="drawer-header d-md-none">
                    <span><i class="bi bi-layout-sidebar me-1"></i> Expediente</span>
                    <button type="button" class="drawer-header-close" id="btnFecharDrawer" aria-label="Fechar menu">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                {# Botão de colapsar — visível apenas em desktop #}
                <button type="button" class="expediente-sidebar-toggle-btn d-none d-md-flex" id="expedienteSidebarToggleBtn"
                        title="Retrair menu" aria-label="Retrair/expandir menu lateral">
                    <i class="bi bi-chevron-left" id="expedienteSidebarToggleIcon"></i>
                </button>

                <div class="expediente-menu">

                    <nav class="expediente-nav">

                        {# ── Pastas ── #}
                        <div class="expediente-marcadores-header">
                            <span class="expediente-marcadores-titulo">Pastas</span>
                            <button type="button"
                                    class="expediente-marcadores-add"
                                    title="Nova Pasta"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalNovaPasta">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <ul class="expediente-menu-list">
                            <li class="expediente-menu-item">
                                <a href="#"
                                   class="expediente-menu-link"
                                   data-painel="{{ path('expediente_acervo_geral') }}">
                                    <i class="bi bi-folder2-open expediente-icon expediente-icon--no-chevron"></i>
                                    <span>Todas as pastas</span>
                                </a>
                            </li>
                        </ul>

                        {# ── Marcadores (pastas organizadoras) ── #}
                        <div class="expediente-marcadores-header">
                            <span class="expediente-marcadores-titulo">Marcadores</span>
                            <button type="button" class="expediente-marcadores-add js-abrir-modal-marcador"
                                    data-pai-id="" title="Novo marcador">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <ul class="expediente-menu-list" id="lista-marcadores">

                            {# Marcadores do banco #}
                            {% for marcador in pastas %}
                                {% include 'expediente/_pasta_item.html.twig' with { marcador: marcador } %}
                            {% endfor %}

                        </ul>

                    </nav>
                </div>
            </div>

            {{ include('_partials/modal_nova_pasta.html.twig') }}

            {# ── Modal: novo marcador / sub-marcador ── #}
            <div class="modal fade" id="modalNovoMarcador" tabindex="-1" aria-labelledby="modalNovoMarcadorLabel" aria-hidden="true">
                <div class="modal-dialog modal-sm modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title" id="modalNovoMarcadorLabel">
                                <i class="bi bi-tag me-1"></i> <span id="modalMarcadorTitulo">Novo marcador</span>
                            </h6>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3">
                            <input type="hidden" id="marcadorPaiId">
                            <input type="hidden" id="marcadorPaiNome">
                            <div id="marcadorContexto" class="text-muted small mb-2" style="display:none;">
                                Sub-marcador de: <strong id="marcadorPaiNomeExibir"></strong>
                            </div>
                            <label for="nomeMarcador" class="form-label form-label-sm">Nome</label>
                            <input type="text" id="nomeMarcador" class="form-control form-control-sm mb-3"
                                   placeholder="Ex.: Em andamento, Aguardando…" maxlength="100" autocomplete="off">
                            <label class="form-label form-label-sm d-block mb-1">Cor do marcador</label>
                            {{ _self.paletaCores('criarCoresMarcador') }}
                            <div id="marcadorErro" class="text-danger small mt-2" style="display:none;"></div>
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-primary btn-sm" id="btnSalvarMarcador">
                                <i class="bi bi-check-lg me-1"></i> Salvar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Modal: editar marcador ── #}
            <div class="modal fade" id="modalEditarMarcador" tabindex="-1" aria-labelledby="modalEditarMarcadorLabel" aria-hidden="true">
                <div class="modal-dialog modal-sm modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title" id="modalEditarMarcadorLabel">
                                <i class="bi bi-pencil me-1"></i> Editar marcador
                            </h6>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3">
                            <input type="hidden" id="editarMarcadorId">
                            <input type="hidden" id="editarMarcadorToken">
                            <input type="hidden" id="editarMarcadorTokenExcluir">

                            <label for="editarNomeMarcador" class="form-label form-label-sm">Nome</label>
                            <input type="text" id="editarNomeMarcador" class="form-control form-control-sm mb-3"
                                   maxlength="100" autocomplete="off">

                            <label class="form-label form-label-sm d-block mb-1">Cor do marcador</label>
                            {{ _self.paletaCores('editarCoresMarcador') }}

                            <div id="editarMarcadorErro" class="text-danger small mt-2" style="display:none;"></div>
                        </div>
                        <div class="modal-footer py-2 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-danger btn-sm" id="btnExcluirMarcadorModal">
                                <i class="bi bi-trash3 me-1"></i> Excluir
                            </button>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary btn-sm" id="btnSalvarEdicaoMarcador">
                                    <i class="bi bi-check-lg me-1"></i> Salvar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Modal: mover pasta para marcadores ── #}
            {{ include('_partials/modal_mover_marcador.html.twig', {
                todosMarcadores: todosMarcadores,
                urlPastaMarcadores: path('expediente_pasta_marcadores', {id: 0}),
                delegateSelector: '#expediente-painel',
                onSucessoCallback: 'moverParaAtualizarBadgesTabela'
            }) }}

            {# ── Área de conteúdo principal ── #}
            <div class="col expediente-content">
                <div id="expediente-painel">
                    <div class="expediente-content-placeholder">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="text-muted mt-3">Selecione um grupo para visualizar os expedientes</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Layout geral ─────────────────────────────────────────────── */
.expediente-sidebar {
    width: 260px;
    min-width: 260px;
    border-right: 1px solid #e2e8f0;
    background: #f8f9fb;
    overflow: visible; /* visível para o botão de toggle não ser cortado */
    transition: width 0.22s cubic-bezier(.4,0,.2,1), min-width 0.22s cubic-bezier(.4,0,.2,1);
    position: relative;
    z-index: 10; /* garante que o botão de toggle fique na frente do conteúdo */
    flex-shrink: 0;
}

/* O scroll fica no menu interno, não na sidebar (para botão de toggle não ser cortado) */
.expediente-menu {
    overflow-y: auto;
    overflow-x: hidden;
    height: 100%;
    max-height: calc(100vh - 160px);
    position: relative;
    z-index: 0; /* fica abaixo do botão de toggle que usa z-index: 20 */
}

/* ── Estado retraído (collapsed) ─────────────────────────────── */
.expediente-sidebar.sidebar-collapsed {
    width: 52px;
    min-width: 52px;
}

.expediente-sidebar.sidebar-collapsed .expediente-menu-link span:not(.marcador-cor-dot),
.expediente-sidebar.sidebar-collapsed .expediente-marcadores-titulo,
.expediente-sidebar.sidebar-collapsed .expediente-btn-add-sub,
.expediente-sidebar.sidebar-collapsed .expediente-btn-acao,
.expediente-sidebar.sidebar-collapsed .expediente-chevron,
.expediente-sidebar.sidebar-collapsed .expediente-submenu,
.expediente-sidebar.sidebar-collapsed .expediente-icon--no-chevron ~ span {
    display: none !important;
}

.expediente-sidebar.sidebar-collapsed .js-contagem-marcador {
    display: none !important;
}

.expediente-sidebar.sidebar-collapsed .expediente-marcadores-header {
    justify-content: center;
    padding: 8px 4px;
}

.expediente-sidebar.sidebar-collapsed .expediente-marcadores-add {
    display: flex !important;
}

.expediente-sidebar.sidebar-collapsed .expediente-menu-link {
    justify-content: center;
    padding: 10px 4px;
}

.expediente-sidebar.sidebar-collapsed .expediente-icon {
    margin-left: 0 !important;
    font-size: 1.05rem;
}

.expediente-sidebar.sidebar-collapsed .expediente-icon--no-chevron {
    margin-left: 0 !important;
}

/* Dot colorido no estado collapsed — reposicionado como círculo sobre o ícone */
.expediente-sidebar.sidebar-collapsed .marcador-cor-dot {
    display: inline-block !important;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: -12px;
    margin-left: -4px;
    border: 1.5px solid rgba(0,0,0,0.12);
    position: relative;
    top: -6px;
    left: 2px;
}

/* ── Botão de toggle da sidebar ───────────────────────────────── */
.expediente-sidebar-toggle-btn {
    position: sticky;
    top: 500px; /* posição vertical sticky ajustada visualmente — não é cálculo geométrico */
    margin-left: calc(100% - 13px); /* mantém o botão na borda direita com sidebar expandida e retraída */
    z-index: 20;
    width: 26px;
    height: 26px;
    background: #0069a0;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.10);
    transition: background 0.15s, box-shadow 0.15s;
    color: #fff;
    font-size: 0.7rem;
    padding: 0;
}

.expediente-sidebar-toggle-btn:hover {
    background: #005580;
    color: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.14);
}

/* ── Botão pull-tab mobile (fixo na borda esquerda) ────────────── */
.btn-expediente-pull-tab {
    display: none;
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1051; /* acima do drawer */
    width: 28px;
    height: 52px;
    padding: 0;
    background: #fff;
    border: 1px solid #dee2e6;
    border-left: none;
    border-radius: 0 8px 8px 0;
    box-shadow: 2px 0 8px rgba(0,0,0,0.10);
    color: #6c757d;
    font-size: 0.95rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: left 0.25s cubic-bezier(.4,0,.2,1), background 0.15s, color 0.15s, box-shadow 0.15s;
}
.btn-expediente-pull-tab:hover,
.btn-expediente-pull-tab:focus {
    background: #f0f4ff;
    color: #0d6efd;
    box-shadow: 2px 0 12px rgba(13,110,253,0.18);
    outline: none;
}
.btn-expediente-pull-tab.drawer-aberto {
    left: 280px;
    background: #f0f4ff;
    color: #0d6efd;
    box-shadow: 2px 0 8px rgba(13,110,253,0.13);
}

/* ── Overlay mobile ───────────────────────────────────────────── */
.expediente-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 1040;
    backdrop-filter: blur(2px);
}
.expediente-overlay.show { display: block; }

/* ── Drawer mobile ────────────────────────────────────────────── */
@media (max-width: 767.98px) {
    .expediente-sidebar {
        position: fixed !important;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 1050;
        width: 280px !important;
        min-width: 280px !important;
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(.4,0,.2,1);
        background: #fff;
        box-shadow: 4px 0 20px rgba(0,0,0,0.15);
        overflow-y: auto;
        padding-top: 56px; /* espaço para header do drawer */
    }
    .expediente-sidebar.drawer-open {
        transform: translateX(0);
    }
    /* Cancela o collapsed no mobile */
    .expediente-sidebar.sidebar-collapsed {
        width: 280px !important;
        min-width: 280px !important;
    }
    .expediente-sidebar.sidebar-collapsed .expediente-menu-link span,
    .expediente-sidebar.sidebar-collapsed .expediente-marcadores-titulo,
    .expediente-sidebar.sidebar-collapsed .expediente-btn-add-sub,
    .expediente-sidebar.sidebar-collapsed .expediente-btn-acao,
    .expediente-sidebar.sidebar-collapsed .expediente-chevron,
    .expediente-sidebar.sidebar-collapsed .js-contagem-marcador {
        display: flex !important;
    }
    .expediente-sidebar.sidebar-collapsed .expediente-marcadores-titulo { display: inline !important; }
    .expediente-sidebar.sidebar-collapsed .expediente-menu-link span { display: inline !important; }
    .expediente-sidebar.sidebar-collapsed .js-contagem-marcador { display: inline-flex !important; }
    .expediente-sidebar.sidebar-collapsed .expediente-menu-link {
        justify-content: flex-start;
        padding: 6px 8px;
    }
    /* Restaura o swatch como quadrado (não círculo) no drawer mobile */
    .expediente-sidebar.sidebar-collapsed .marcador-cor-dot {
        border-radius: 3px !important;
        top: 0 !important;
        left: 0 !important;
        margin-top: 0 !important;
        margin-left: 0 !important;
        position: static !important;
    }
    .expediente-sidebar-toggle-btn { display: none !important; }
    .btn-expediente-pull-tab { display: flex !important; }

    /* Header do drawer mobile */
    .drawer-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 50px;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        font-weight: 600;
        font-size: 0.88rem;
        color: #212529;
    }
    .drawer-header-close {
        background: none;
        border: none;
        font-size: 1.1rem;
        color: #6c757d;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 4px;
    }
    .drawer-header-close:hover { background: #e9ecef; color: #212529; }

    /* Painel ocupa tela cheia */
    .expediente-content { overflow-x: hidden; }
    .row.g-0 { flex-direction: column !important; }
}

/* ── Conteúdo ─────────────────────────────────────────────────── */
.expediente-content {
    overflow-y: auto;
    min-width: 0;
}

.expediente-content-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 300px;
}

/* ── Lista do menu ────────────────────────────────────────────── */
.expediente-menu-list {
    list-style: none;
    margin: 0;
    padding: 2px 8px 6px;
}

.expediente-menu-item {
    border-bottom: none;
}

/* ── Links do menu principal ──────────────────────────────────── */
.expediente-menu-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    color: #374151;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    border-radius: 6px;
    transition: background 0.12s, color 0.12s;
    cursor: pointer;
}

.expediente-menu-link:hover {
    background: #eef2f7;
    color: #111827;
}

.expediente-menu-link.active {
    background: #e8f0fe;
    color: #1a56db;
    font-weight: 600;
}

.expediente-menu-link.active .expediente-icon,
.expediente-menu-link.active .expediente-chevron {
    color: #1a56db;
}

.expediente-chevron {
    font-size: 0.7rem;
    width: 12px;
    flex-shrink: 0;
    transition: transform 0.2s;
    color: #9ca3af;
}

.expediente-icon {
    font-size: 0.9rem;
    flex-shrink: 0;
    color: #6b7280;
}

.expediente-icon--no-chevron {
    margin-left: 18px;
}

/* ── Nome do item: truncamento com ellipsis ───────────────────── */
.expediente-item-nome {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ── Swatch de cor (visível apenas no estado colapsado) ──────── */
.marcador-cor-dot {
    display: none;
}

/* ── Badge de contagem ──────────────────────────────────────────── */
.js-contagem-marcador {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    font-size: 0.64rem !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    padding: 1px 6px !important;
    background: rgba(0,0,0,0.06) !important;
    border: 1px solid rgba(0,0,0,0.09) !important;
    border-radius: 999px !important;
    color: #6b7280 !important;
    vertical-align: middle !important;
}

/* ── Submenus ─────────────────────────────────────────────────── */
.expediente-submenu {
    list-style: none;
    margin: 2px 8px 2px 26px;
    padding: 0 0 0 8px;
    display: none;
    border-top: none;
    border-left: 2px solid #e2e8f0;
}

.expediente-submenu.show {
    display: block;
}

.expediente-submenu li {
    border-bottom: none;
}

.expediente-submenu-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    color: #4b5563;
    text-decoration: none;
    font-size: 0.79rem;
    border-radius: 5px;
    transition: background 0.12s, color 0.12s;
}

.expediente-submenu-link:hover {
    background: #eef2f7;
    color: #111827;
}

.expediente-submenu-link.active {
    background: #e8f0fe;
    color: #1a56db;
    font-weight: 600;
}

.expediente-sub-icon {
    font-size: 0.78rem;
    color: #9ca3af;
    flex-shrink: 0;
}

/* ── Botão + inline no marcador pai ──────────────────────────── */
.expediente-btn-add-sub {
    background: none;
    border: none;
    padding: 2px 5px;
    color: transparent;
    font-size: 0.72rem;
    cursor: pointer;
    border-radius: 4px;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.12s, background 0.12s;
}

.expediente-menu-link:hover .expediente-btn-add-sub,
.expediente-menu-link.active .expediente-btn-add-sub {
    color: #9ca3af;
}

.expediente-btn-add-sub:hover {
    background: rgba(0,0,0,0.07);
    color: #374151 !important;
}

/* ── Modal "Mover para" — árvore hierárquica ──────────────────── */
.mover-para-item {
    display: flex;
    align-items: stretch;
    position: relative;
    border-bottom: 1px solid #f0f0f0;
}
.mover-para-item:last-child { border-bottom: none; }

.mover-para-cb {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
}

.mover-para-label {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    padding: 9px 12px 9px 0;
    cursor: pointer;
    user-select: none;
    transition: background .12s;
    border-radius: 0;
}
.mover-para-label:hover { background: #f8f9fa; }

.mover-para-cb:checked + .mover-para-label {
    background: #eef4ff;
}

.mover-para-stripe {
    flex-shrink: 0;
    width: 4px;
    align-self: stretch;
    border-radius: 0;
    margin-right: 4px;
}

.mover-para-chevron {
    flex-shrink: 0;
    width: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #adb5bd;
    font-size: .72rem;
    cursor: pointer;
    padding: 2px;
    border-radius: 3px;
    transition: background .1s;
}
.mover-para-chevron:hover { background: rgba(0,0,0,.07); color: #495057; }

.mover-para-icon {
    flex-shrink: 0;
    font-size: .78rem;
    opacity: .85;
}

.mover-para-nome {
    flex: 1;
    font-size: .85rem;
    font-weight: 500;
    color: #212529;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mover-para-count {
    flex-shrink: 0;
    font-size: .7rem;
    color: #adb5bd;
    background: #f1f3f5;
    border-radius: 10px;
    padding: 1px 6px;
    margin-left: auto;
}

/* Filhos */
.mover-para-grupo { overflow: hidden; }
.mover-para-grupo-oculto { display: none; }

.mover-para-filho .mover-para-label {
    padding-left: 0;
    background: #fafafa;
}
.mover-para-filho .mover-para-label:hover { background: #f1f4ff; }
.mover-para-filho .mover-para-cb:checked + .mover-para-label { background: #e8f0fe; }

.mover-para-indent {
    flex-shrink: 0;
    width: 26px;
}

/* Scroll com barra estilizada */
#moverParaLista::-webkit-scrollbar { width: 4px; }
#moverParaLista::-webkit-scrollbar-thumb { background: #dee2e6; border-radius: 4px; }

/* ── Paleta de cores do modal de edição ──────────────────────── */
.marcador-cores {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.marcador-cor-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s, transform 0.12s;
    background: #fff;
    outline: none;
}

.marcador-cor-btn:hover {
    transform: scale(1.15);
    border-color: #6c757d;
}

.marcador-cor-btn.ativo {
    border-color: #0d6efd;
    box-shadow: 0 0 0 2px rgba(13,110,253,.25);
}

/* ── Fundo colorido no item do menu ──────────────────────────── */
.expediente-menu-link.com-cor {
    border-left: 3px solid transparent;
}

/* ── Botões de ação inline (editar / excluir) ─────────────────── */
.expediente-btn-acao {
    background: none;
    border: none;
    padding: 2px 5px;
    color: transparent;
    font-size: 0.72rem;
    cursor: pointer;
    border-radius: 4px;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.12s, background 0.12s;
}

.expediente-menu-link:hover .expediente-btn-acao,
.expediente-menu-link.active .expediente-btn-acao {
    color: #9ca3af;
}

.expediente-btn-acao:hover {
    background: rgba(0,0,0,0.07);
    color: #374151 !important;
}

.expediente-btn-acao.js-excluir-marcador:hover {
    background: rgba(220,53,69,0.10);
    color: #dc3545 !important;
}

.expediente-btn-acao-sub {
    color: transparent;
    font-size: 0.72rem;
}

.expediente-submenu-link:hover .expediente-btn-acao-sub {
    color: #9ca3af;
}

.expediente-btn-acao-sub:hover {
    background: rgba(0,0,0,0.07);
    color: #374151 !important;
}

.expediente-btn-acao-sub.js-excluir-marcador:hover {
    background: rgba(220,53,69,0.10);
    color: #dc3545 !important;
}

/* ── Header de marcadores ─────────────────────────────────────── */
.expediente-marcadores-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 14px 5px;
    border-top: 1px solid #e2e8f0;
}

.expediente-nav > .expediente-marcadores-header:first-child {
    border-top: none;
    padding-top: 8px;
}

.expediente-marcadores-titulo {
    font-size: 0.615rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: #94a3b8;
}

.expediente-marcadores-add {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: none;
    border: 1.5px dashed #0069a0;
    border-radius: 5px;
    color: #0069a0;
    font-size: 0.7rem;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: border-color 0.15s, color 0.15s, background 0.15s, border-style 0.15s;
}

.expediente-marcadores-add:hover {
    border-color: #004d78;
    border-style: solid;
    color: #004d78;
    background: #e8f4fb;
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/* ── Linhas clicáveis da tabela de pastas (delegado no document) ── */
document.addEventListener('click', function (e) {
    var tr = e.target.closest('tr.pasta-row-link');
    if (!tr) return;
    if (e.target.closest('button, a, form, input, select, .js-toggle-situacao')) return;
    window.location.href = tr.dataset.href;
});

/* ── Alternar situação da pasta por duplo-clique na badge ── */
document.addEventListener('dblclick', function (e) {
    var badge = e.target.closest('.js-toggle-situacao');
    if (!badge) return;
    e.stopPropagation();

    if (badge.dataset.ocupado === '1') return;
    badge.dataset.ocupado = '1';

    fetch(badge.dataset.url, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '_token=' + encodeURIComponent(badge.dataset.csrf),
    })
    .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
    .then(function (res) {
        badge.dataset.ocupado = '';
        if (!res.ok || !res.data.sucesso) {
            alert(res.data.erro || 'Erro ao alterar situação.');
            return;
        }
        var eAtivo = res.data.novaSituacao === 'ativo';
        badge.classList.remove('text-bg-success', 'text-bg-secondary');
        badge.classList.add(eAtivo ? 'text-bg-success' : 'text-bg-secondary');
        badge.textContent      = eAtivo ? 'Ativo' : 'Arquivado';
        badge.dataset.situacao = res.data.novaSituacao;
    })
    .catch(function () {
        badge.dataset.ocupado = '';
        alert('Erro de comunicação com o servidor.');
    });
});

document.addEventListener('DOMContentLoaded', function () {
    // ── Toggle sidebar (desktop) ──────────────────────────────────
    var sidebar         = document.getElementById('expedienteSidebar');
    var toggleBtn       = document.getElementById('expedienteSidebarToggleBtn');
    var toggleIcon      = document.getElementById('expedienteSidebarToggleIcon');
    var labelPainel     = document.getElementById('labelPainelAtivo');
    var collapsed       = localStorage.getItem('expediente_sidebar_collapsed') === '1';

    function aplicarEstadoSidebar() {
        if (collapsed) {
            sidebar.classList.add('sidebar-collapsed');
            toggleIcon.className = 'bi bi-chevron-right';
            if (toggleBtn) toggleBtn.title = 'Expandir menu';
        } else {
            sidebar.classList.remove('sidebar-collapsed');
            toggleIcon.className = 'bi bi-chevron-left';
            if (toggleBtn) toggleBtn.title = 'Retrair menu';
        }
    }
    aplicarEstadoSidebar();

    if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
            collapsed = !collapsed;
            localStorage.setItem('expediente_sidebar_collapsed', collapsed ? '1' : '0');
            aplicarEstadoSidebar();
            // Reposicionar tooltips
            atualizarTooltipsSidebar();
        });
    }

    // Tooltips nos links da sidebar quando colapsada
    function atualizarTooltipsSidebar() {
        sidebar.querySelectorAll('.expediente-menu-link[data-painel], .expediente-menu-link[data-grupo]').forEach(function (link) {
            var nomeTip = link.querySelector('span') ? link.querySelector('span').textContent.trim() : '';
            var inst = bootstrap.Tooltip.getInstance(link);
            if (collapsed) {
                if (!inst) {
                    new bootstrap.Tooltip(link, { title: nomeTip, placement: 'right', trigger: 'hover' });
                }
            } else {
                if (inst) inst.dispose();
            }
        });
    }
    atualizarTooltipsSidebar();

    // ── Drawer mobile ─────────────────────────────────────────────
    var overlay         = document.getElementById('expedienteOverlay');
    var btnAbrir        = document.getElementById('btnAbrirDrawer');
    var btnFechar       = document.getElementById('btnFecharDrawer');
    var iconePullTab    = document.getElementById('iconePullTab');

    function abrirDrawer() {
        sidebar.classList.add('drawer-open');
        overlay.classList.add('show');
        document.body.style.overflow = 'hidden';
        if (btnAbrir) {
            btnAbrir.classList.add('drawer-aberto');
            btnAbrir.setAttribute('aria-expanded', 'true');
            btnAbrir.setAttribute('aria-label', 'Fechar menu de navegação');
        }
        if (iconePullTab) {
            iconePullTab.className = 'bi bi-chevron-left';
        }
    }
    function fecharDrawer() {
        sidebar.classList.remove('drawer-open');
        overlay.classList.remove('show');
        document.body.style.overflow = '';
        if (btnAbrir) {
            btnAbrir.classList.remove('drawer-aberto');
            btnAbrir.setAttribute('aria-expanded', 'false');
            btnAbrir.setAttribute('aria-label', 'Abrir menu de navegação');
        }
        if (iconePullTab) {
            iconePullTab.className = 'bi bi-chevron-right';
        }
    }
    if (btnAbrir)  btnAbrir.addEventListener('click', function () {
        sidebar.classList.contains('drawer-open') ? fecharDrawer() : abrirDrawer();
    });
    if (btnFechar) btnFechar.addEventListener('click', fecharDrawer);
    if (overlay)   overlay.addEventListener('click', fecharDrawer);

    // Fechar drawer ao selecionar item no mobile
    document.addEventListener('click', function (e) {
        if (window.innerWidth < 768 && sidebar.classList.contains('drawer-open')) {
            var link = e.target.closest('.expediente-menu-link[data-painel], .expediente-submenu-link[data-marcador-id], .expediente-menu-link[data-grupo]');
            if (link) setTimeout(fecharDrawer, 180);
        }
    });

    var painel           = document.getElementById('expediente-painel');
    var urlCriar         = '{{ path('expediente_marcador_criar') }}';
    var urlExcluir       = '{{ path('expediente_marcador_excluir', {'id': 0}) }}';
    var urlEditar        = '{{ path('expediente_marcador_editar', {'id': 0}) }}';
    var urlPainelMarcador = '{{ path('expediente_marcador_pastas', {'id': 0}) }}';
    var urlPastaMarcadores = '{{ path('expediente_pasta_marcadores', {'id': 0}) }}';
    var csrfToken        = '{{ csrf_token('marcador') }}';

    // Marcadores disponíveis no tenant (para o modal "Mover para")
    var todosMarcadores = {{ todosMarcadores|map(m => {id: m.id, nome: m.nome, cor: m.cor, paiId: m.pai ? m.pai.id : null})|json_encode|raw }};

    // ── Seleciona "Todas as pastas" automaticamente ao abrir a página ──
    (function () {
        var linkTodasPastas = document.querySelector('.expediente-menu-link[data-painel]');
        if (linkTodasPastas) {
            linkTodasPastas.classList.add('active');
            carregarPainel(linkTodasPastas.dataset.painel, 'Todas as pastas');
        }
    })();

    // ── Carrega painel via AJAX — "Todas as pastas" ──
    document.querySelectorAll('.expediente-menu-link[data-painel]').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelectorAll('.expediente-menu-link').forEach(function (l) { l.classList.remove('active'); });
            this.classList.add('active');
            carregarPainel(this.dataset.painel, 'Todas as pastas');
        });
    });

    // ── Clicar em marcador raiz ou sub-marcador: carrega painel (delegado) ──
    document.getElementById('lista-marcadores').addEventListener('click', function (e) {
        // Sub-marcador
        var subLink = e.target.closest('.expediente-submenu-link[data-marcador-id]');
        if (subLink) {
            e.preventDefault();
            e.stopPropagation();
            document.querySelectorAll('.expediente-menu-link, .expediente-submenu-link').forEach(function (l) { l.classList.remove('active'); });
            subLink.classList.add('active');
            var url = urlPainelMarcador.replace('/0/', '/' + subLink.dataset.marcadorId + '/');
            var nomeSubLink = subLink.querySelector('span') ? subLink.querySelector('span').textContent.trim() : '';
            carregarPainel(url, nomeSubLink);
            return;
        }

        // Marcador raiz (link com data-grupo e data-marcador-id)
        var rootLink = e.target.closest('.expediente-menu-link[data-grupo]');
        if (rootLink && !e.target.closest('button')) {
            toggleSubmenu.call(rootLink, e);
        }
    });

    // ── Paleta de cores compartilhada ──
    function inicializarPaletaCores(containerId) {
        var container = document.getElementById(containerId);
        var corAtiva  = '';

        container.addEventListener('click', function (e) {
            var btn = e.target.closest('.marcador-cor-btn');
            if (!btn) return;
            corAtiva = btn.dataset.cor;
            container.querySelectorAll('.marcador-cor-btn').forEach(function (b) { b.classList.remove('ativo'); });
            btn.classList.add('ativo');
        });

        return {
            getCor:   function ()    { return corAtiva; },
            definir:  function (cor) {
                corAtiva = cor || '';
                container.querySelectorAll('.marcador-cor-btn').forEach(function (b) {
                    b.classList.toggle('ativo', b.dataset.cor === corAtiva);
                });
            },
        };
    }

    // ── Modal novo marcador ──
    var modal        = document.getElementById('modalNovoMarcador');
    var inputNome    = document.getElementById('nomeMarcador');
    var inputPaiId   = document.getElementById('marcadorPaiId');
    var inputPaiNome = document.getElementById('marcadorPaiNome');
    var divContexto  = document.getElementById('marcadorContexto');
    var spanPaiNome  = document.getElementById('marcadorPaiNomeExibir');
    var divErro      = document.getElementById('marcadorErro');
    var tituloModal  = document.getElementById('modalMarcadorTitulo');
    var paletaCriar  = inicializarPaletaCores('criarCoresMarcador');

    function abrirModal(paiId, paiNome) {
        inputPaiId.value   = paiId   || '';
        inputPaiNome.value = paiNome || '';
        inputNome.value    = '';
        divErro.style.display = 'none';
        paletaCriar.definir('');

        if (paiId) {
            tituloModal.textContent   = 'Novo sub-marcador';
            spanPaiNome.textContent   = paiNome;
            divContexto.style.display = '';
        } else {
            tituloModal.textContent   = 'Novo marcador';
            divContexto.style.display = 'none';
        }

        bootstrap.Modal.getOrCreateInstance(modal).show();
        setTimeout(function () { inputNome.focus(); }, 300);
    }

    // Botão + do header de marcadores
    document.querySelectorAll('.js-abrir-modal-marcador').forEach(function (btn) {
        btn.addEventListener('click', function () {
            abrirModal(this.dataset.paiId || '', this.dataset.paiNome || '');
        });
    });

    // Botão + sub-marcador (delegado — funciona para itens inseridos via JS também)
    document.getElementById('lista-marcadores').addEventListener('click', function (e) {
        var btn = e.target.closest('.expediente-btn-add-sub');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        abrirModal(btn.dataset.paiId, btn.dataset.paiNome);
    });

    // ── Modal editar marcador ──
    var modalEditar        = document.getElementById('modalEditarMarcador');
    var editarId           = document.getElementById('editarMarcadorId');
    var editarToken        = document.getElementById('editarMarcadorToken');
    var editarTokenExcluir = document.getElementById('editarMarcadorTokenExcluir');
    var editarNome         = document.getElementById('editarNomeMarcador');
    var editarErro         = document.getElementById('editarMarcadorErro');
    var paletaEditar       = inicializarPaletaCores('editarCoresMarcador');

    function abrirModalEditar(id, nomeAtual, corAtual, token, tokenExcluir) {
        editarId.value           = id;
        editarToken.value        = token;
        editarTokenExcluir.value = tokenExcluir || '';
        editarNome.value         = nomeAtual;
        editarErro.style.display = 'none';
        paletaEditar.definir(corAtual);

        bootstrap.Modal.getOrCreateInstance(modalEditar).show();
        setTimeout(function () { editarNome.focus(); editarNome.select(); }, 300);
    }

    // Botão editar (delegado)
    document.getElementById('lista-marcadores').addEventListener('click', function (e) {
        var btn = e.target.closest('.js-editar-marcador');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();

        var item = document.getElementById('item-pasta-' + btn.dataset.id);
        var link = item ? item.querySelector('.expediente-menu-link, .expediente-submenu-link') : null;
        var corAtual = link ? (link.dataset.cor || '') : '';

        abrirModalEditar(btn.dataset.id, btn.dataset.nome, corAtual, btn.dataset.token, btn.dataset.tokenExcluir);
    });

    document.getElementById('btnSalvarEdicaoMarcador').addEventListener('click', function () {
        var nome = editarNome.value.trim();
        if (!nome) { editarNome.focus(); return; }

        var btn = this;
        btn.disabled = true;
        editarErro.style.display = 'none';

        var id  = editarId.value;
        var url = urlEditar.replace('/0', '/' + id);

        fetch(url, {
            method: 'PATCH',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '_token=' + encodeURIComponent(editarToken.value) +
                  '&nome='  + encodeURIComponent(nome) +
                  '&cor='   + encodeURIComponent(paletaEditar.getCor()),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            btn.disabled = false;
            if (!res.ok) {
                editarErro.textContent   = res.data.erro || 'Erro ao salvar.';
                editarErro.style.display = '';
                return;
            }
            var item = document.getElementById('item-pasta-' + res.data.id);
            if (item) {
                // Atualiza span do nome
                var span = item.querySelector('a span');
                if (span) span.textContent = res.data.nome;

                // Atualiza cor no link
                var link = item.querySelector('.expediente-menu-link, .expediente-submenu-link');
                if (link) {
                    link.dataset.cor = res.data.cor || '';
                    aplicarCorNoLink(link, res.data.cor);
                }

                // Atualiza data-nome nos botões do item
                item.querySelectorAll('[data-id="' + res.data.id + '"]').forEach(function (b) {
                    b.dataset.nome = res.data.nome;
                });
                // Atualiza data-pai-nome nos botões de sub-marcador
                item.querySelectorAll('[data-pai-id="' + res.data.id + '"]').forEach(function (b) {
                    b.dataset.paiNome = res.data.nome;
                });
            }
            bootstrap.Modal.getInstance(modalEditar).hide();
        })
        .catch(function () {
            btn.disabled = false;
            editarErro.textContent   = 'Erro de comunicação.';
            editarErro.style.display = '';
        });
    });

    function aplicarCorNoLink(link, cor) {
        if (cor) {
            link.style.backgroundColor = cor;
            link.style.borderLeft = '3px solid rgba(0,0,0,0.15)';
            link.classList.add('com-cor');
        } else {
            link.style.backgroundColor = '';
            link.style.borderLeft = '';
            link.classList.remove('com-cor');
        }
    }

    function escurecer(hex) {
        var r = parseInt(hex.slice(1,3),16) - 30;
        var g = parseInt(hex.slice(3,5),16) - 30;
        var b = parseInt(hex.slice(5,7),16) - 30;
        return 'rgb(' + Math.max(0,r) + ',' + Math.max(0,g) + ',' + Math.max(0,b) + ')';
    }

    // Botão excluir dentro do modal de edição
    document.getElementById('btnExcluirMarcadorModal').addEventListener('click', function () {
        var id    = editarId.value;
        var nome  = editarNome.value.trim() || '?';
        var token = editarTokenExcluir.value;
        var item  = document.getElementById('item-pasta-' + id);

        var temSubs = item && item.querySelector('.expediente-submenu li');
        var msg = temSubs
            ? 'Excluir o marcador "' + nome + '" removerá todos os seus sub-marcadores. Continuar?'
            : 'Excluir o marcador "' + nome + '"?';

        if (!confirm(msg)) return;

        var url = urlExcluir.replace('/0', '/' + id);
        var btnExcluir = this;
        btnExcluir.disabled = true;
        editarErro.style.display = 'none';

        fetch(url, {
            method: 'DELETE',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '_token=' + encodeURIComponent(token),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            btnExcluir.disabled = false;
            if (!res.ok) {
                editarErro.textContent   = res.data.erro || 'Erro ao excluir.';
                editarErro.style.display = '';
                return;
            }
            bootstrap.Modal.getInstance(modalEditar).hide();
            if (item) item.remove();
        })
        .catch(function () {
            btnExcluir.disabled = false;
            editarErro.textContent   = 'Erro de comunicação.';
            editarErro.style.display = '';
        });
    });

    document.getElementById('btnSalvarMarcador').addEventListener('click', function () {
        var nome  = inputNome.value.trim();
        var paiId = inputPaiId.value;

        if (!nome) { inputNome.focus(); return; }

        var btn = this;
        btn.disabled = true;

        var body = new URLSearchParams({ nome: nome, _token: csrfToken, cor: paletaCriar.getCor() });
        if (paiId) body.append('pai_id', paiId);

        fetch(urlCriar, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            if (!res.ok) {
                divErro.textContent   = res.data.erro || 'Erro ao salvar.';
                divErro.style.display = '';
                btn.disabled = false;
                return;
            }
            inserirNoMenu(res.data);
            bootstrap.Modal.getInstance(modal).hide();
            btn.disabled = false;
        })
        .catch(function () {
            divErro.textContent   = 'Erro de comunicação.';
            divErro.style.display = '';
            btn.disabled = false;
        });
    });

    function inserirNoMenu(marcador) {
        if (marcador.paiId) {
            // Sub-marcador: adiciona dentro do submenu do pai
            var submenu = document.getElementById('grupo-pasta-' + marcador.paiId);
            if (!submenu) return;

            var li = document.createElement('li');
            li.id        = 'item-pasta-' + marcador.id;
            li.innerHTML = criarHtmlSub(marcador);
            // Insere antes do botão "Novo sub-marcador"
            var btnNovo = submenu.querySelector('.js-abrir-modal-marcador');
            submenu.insertBefore(li, btnNovo ? btnNovo.parentElement : null);
            submenu.classList.add('show');

            var chevron = submenu.previousElementSibling
                ? submenu.previousElementSibling.querySelector('.expediente-chevron')
                : null;
            if (chevron) {
                chevron.classList.remove('bi-chevron-right');
                chevron.classList.add('bi-chevron-down');
            }
        } else {
            // Marcador raiz
            var lista = document.getElementById('lista-marcadores');
            var li = document.createElement('li');
            li.id        = 'item-pasta-' + marcador.id;
            li.className = 'expediente-menu-item';
            li.innerHTML = criarHtmlRaiz(marcador);
            lista.appendChild(li);

            // delegação cuida do click — sem listener manual necessário
        }
    }

    function criarHtmlRaiz(marcador) {
        var grupoId     = 'pasta-' + marcador.id;
        var csrfExcluir = marcador.csrfExcluir || '';
        var csrfEditar  = marcador.csrfEditar  || '';
        var cor         = marcador.cor         || '';
        var classeLink  = 'expediente-menu-link' + (cor ? ' com-cor' : '');
        var estiloLink  = cor ? ' style="background:' + cor + ';border-left:3px solid rgba(0,0,0,0.15);"' : '';
        var dotCor = cor ? '<span class="marcador-cor-dot" style="background:' + escHtml(cor) + ';" title="' + escHtml(marcador.nome) + '"></span>' : '';
        return '<a href="#" class="' + classeLink + '" data-grupo="' + grupoId + '" data-cor="' + escHtml(cor) + '" data-marcador-id="' + marcador.id + '"' + estiloLink + '>' +
               '<i class="bi bi-chevron-right expediente-chevron"></i>' +
               '<i class="bi bi-folder2 expediente-icon"></i>' +
               dotCor +
               '<span class="expediente-item-nome" title="' + escHtml(marcador.nome) + '">' + escHtml(marcador.nome) + '</span>' +
               '<button type="button" class="expediente-btn-add-sub ms-auto"' +
               ' data-pai-id="' + marcador.id + '" data-pai-nome="' + escHtml(marcador.nome) + '"' +
               ' title="Novo sub-marcador"><i class="bi bi-plus-lg"></i></button>' +
               '<button type="button" class="expediente-btn-acao js-editar-marcador"' +
               ' data-id="' + marcador.id + '" data-nome="' + escHtml(marcador.nome) + '" data-token="' + escHtml(csrfEditar) + '" data-token-excluir="' + escHtml(csrfExcluir) + '"' +
               ' title="Editar marcador"><i class="bi bi-pencil"></i></button>' +
               '</a>' +
               '<ul class="expediente-submenu" id="grupo-pasta-' + marcador.id + '">' +
               '</ul>';
    }

    function criarHtmlSub(marcador) {
        var csrfExcluir = marcador.csrfExcluir || '';
        var csrfEditar  = marcador.csrfEditar  || '';
        var cor         = marcador.cor         || '';
        var classeLink  = 'expediente-submenu-link' + (cor ? ' com-cor' : '');
        var estiloLink  = cor ? ' style="background:' + cor + ';border-left:3px solid rgba(0,0,0,0.15);"' : '';
        var dotCor = cor ? '<span class="marcador-cor-dot" style="background:' + escHtml(cor) + ';"></span>' : '';
        return '<a href="#" class="' + classeLink + '" data-cor="' + escHtml(cor) + '" data-marcador-id="' + marcador.id + '"' + estiloLink + '>' +
               '<i class="bi bi-folder2 expediente-sub-icon"></i>' +
               dotCor +
               '<span class="expediente-item-nome" title="' + escHtml(marcador.nome) + '">' + escHtml(marcador.nome) + '</span>' +
               '<button type="button" class="expediente-btn-acao expediente-btn-acao-sub js-editar-marcador ms-auto"' +
               ' data-id="' + marcador.id + '" data-nome="' + escHtml(marcador.nome) + '" data-token="' + escHtml(csrfEditar) + '" data-token-excluir="' + escHtml(csrfExcluir) + '"' +
               ' title="Editar sub-marcador"><i class="bi bi-pencil"></i></button>' +
               '</a>';
    }

    function injetarHtmlComScripts(container, html) {
        container.innerHTML = html;
        container.querySelectorAll('script').forEach(function (scriptOriginal) {
            var novoScript = document.createElement('script');
            Array.from(scriptOriginal.attributes).forEach(function (attr) {
                novoScript.setAttribute(attr.name, attr.value);
            });
            novoScript.textContent = scriptOriginal.textContent;
            scriptOriginal.parentNode.replaceChild(novoScript, scriptOriginal);
        });
    }

    function carregarPainel(url, nomeAtivo) {
        document.querySelectorAll('.expediente-menu-link').forEach(function (l) { l.classList.remove('active'); });
        painel.innerHTML = '<div class="p-4 text-center text-muted"><i class="bi bi-hourglass-split"></i> Carregando...</div>';
        if (labelPainel && nomeAtivo) labelPainel.textContent = nomeAtivo;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) { injetarHtmlComScripts(painel, html); })
            .catch(function () {
                painel.innerHTML = '<div class="p-4 alert alert-danger">Erro ao carregar o conteúdo.</div>';
            });
    }

    function toggleSubmenu(e) {
        e.preventDefault();
        var grupo   = this.dataset.grupo;
        var submenu = document.getElementById('grupo-' + grupo);
        var chevron = this.querySelector('.expediente-chevron');

        document.querySelectorAll('.expediente-menu-link').forEach(function (l) {
            l.classList.remove('active');
        });
        this.classList.add('active');

        // Extrai o id do marcador a partir do grupo ("pasta-{id}")
        var marcadorId = grupo ? grupo.replace('pasta-', '') : null;
        if (marcadorId) {
            var url = urlPainelMarcador.replace('/0/', '/' + marcadorId + '/');
            var nomeMarcador = this.querySelector('span') ? this.querySelector('span').textContent.trim() : '';
            carregarPainel(url, nomeMarcador);
        }

        if (!submenu) return;
        var aberto = submenu.classList.contains('show');
        var folderIcon = this.querySelector('.expediente-icon');
        if (aberto) {
            submenu.classList.remove('show');
            if (chevron) { chevron.classList.remove('bi-chevron-down'); chevron.classList.add('bi-chevron-right'); }
            if (folderIcon) { folderIcon.classList.remove('bi-folder2-open'); folderIcon.classList.add('bi-folder2'); }
        } else {
            submenu.classList.add('show');
            if (chevron) { chevron.classList.remove('bi-chevron-right'); chevron.classList.add('bi-chevron-down'); }
            if (folderIcon) { folderIcon.classList.remove('bi-folder2'); folderIcon.classList.add('bi-folder2-open'); }
        }
    }

    // ── Popover customizado dos marcadores extras (delegado — funciona para conteúdo AJAX) ──
    (function () {
        if (document.__marcadoresPopoverInit) return;
        document.__marcadoresPopoverInit = true;

        if (!document.getElementById('marcadores-popover')) {
            var popoverEl = document.createElement('div');
            popoverEl.id = 'marcadores-popover';
            popoverEl.className = 'marcadores-popover-box';
            popoverEl.style.cssText = 'display:none;position:absolute;z-index:9999;background:#fff;border:1px solid #dee2e6;border-radius:8px;padding:8px 10px;box-shadow:0 4px 16px rgba(0,0,0,.13);display:none;flex-direction:column;gap:5px;min-width:120px;max-width:240px;pointer-events:none;';
            document.body.appendChild(popoverEl);
        }

        function escHtmlPop(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function posicionarPopover(anchor) {
            var el = document.getElementById('marcadores-popover');
            if (!el) return;
            var rect = anchor.getBoundingClientRect();
            el.style.visibility = 'hidden';
            el.style.display = 'flex';
            var popRect = el.getBoundingClientRect();
            var top  = rect.top + window.scrollY - popRect.height - 8;
            var left = rect.left + window.scrollX + (rect.width / 2) - (popRect.width / 2);
            if (left < 8) left = 8;
            if (left + popRect.width > window.innerWidth - 8) left = window.innerWidth - 8 - popRect.width;
            if (top < window.scrollY + 8) top = rect.bottom + window.scrollY + 8;
            el.style.top  = top + 'px';
            el.style.left = left + 'px';
            el.style.visibility = '';
        }

        document.addEventListener('mouseover', function (e) {
            var badge = e.target.closest('.marcadores-extra[data-marcadores-json]');
            if (!badge) return;
            var marcadores;
            try { marcadores = JSON.parse(badge.dataset.marcadoresJson); } catch (err) { return; }
            if (!marcadores || marcadores.length === 0) return;
            var el = document.getElementById('marcadores-popover');
            if (!el) return;
            el.innerHTML = marcadores.map(function (m) {
                var bg    = m.cor || '#e9ecef';
                var borda = m.cor ? 'border:1px solid rgba(0,0,0,.1);' : '';
                return '<span style="display:inline-block;border-radius:20px;padding:2px 10px;font-size:.72rem;font-weight:500;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;background:' + bg + ';' + borda + '">' + escHtmlPop(m.nome) + '</span>';
            }).join('');
            posicionarPopover(badge);
        });

        document.addEventListener('mouseout', function (e) {
            var badge = e.target.closest('.marcadores-extra[data-marcadores-json]');
            if (!badge) return;
            var el = document.getElementById('marcadores-popover');
            if (el) el.style.display = 'none';
        });

        document.addEventListener('scroll', function () {
            var el = document.getElementById('marcadores-popover');
            if (el && el.style.display !== 'none') el.style.display = 'none';
        }, true);
    })();

    // ── Atualização em tempo real dos contadores da sidebar ──────────────────
    function alterarContagemSidebar(marcadorId, delta) {
        var item = document.getElementById('item-pasta-' + marcadorId);
        if (!item) return;
        var link  = item.querySelector('.expediente-menu-link, .expediente-submenu-link');
        if (!link) return;
        var badge = link.querySelector('.js-contagem-marcador');
        var count = badge ? parseInt(badge.textContent, 10) : 0;
        count += delta;
        if (count <= 0) {
            if (badge) badge.remove();
            return;
        }
        if (badge) {
            badge.textContent = count;
            badge.title = count + ' pasta(s)';
        } else {
            var novoBadge = document.createElement('span');
            novoBadge.className  = 'js-contagem-marcador ms-1';
            novoBadge.title      = count + ' pasta(s)';
            novoBadge.textContent = count;
            link.appendChild(novoBadge);
        }
    }

    function atualizarContadoresSidebar(oldIds, newIds) {
        oldIds.forEach(function (id) {
            if (newIds.indexOf(id) === -1) alterarContagemSidebar(id, -1);
        });
        newIds.forEach(function (id) {
            if (oldIds.indexOf(id) === -1) alterarContagemSidebar(id, +1);
        });
    }

    // ── Callback pós-salvar do modal "Mover para": atualiza badges na tabela ──
    window.moverParaAtualizarBadgesTabela = function (data, escHtml) {
        var colMarcadores = document.querySelector('td.pasta-marcadores-col[data-pasta-id="' + data.pastaId + '"]');
        if (!colMarcadores) return;
        var btnMover  = colMarcadores.querySelector('.js-mover-para');

        var oldIds = btnMover && btnMover.dataset.marcadoresAtivos
            ? btnMover.dataset.marcadoresAtivos.split(',').filter(Boolean).map(Number)
            : [];
        var newIds = data.marcadores.map(function (m) { return m.id; });
        atualizarContadoresSidebar(oldIds, newIds);
        var novosHtml = '';
        if (data.marcadores.length > 0) {
            var primeiro = data.marcadores[0];
            var bg0    = primeiro.cor || '#e9ecef';
            var borda0 = primeiro.cor ? 'border:1px solid rgba(0,0,0,.1);' : '';
            novosHtml += '<span class="badge rounded-pill px-2" style="background:' + bg0 + ';color:#333;' + borda0 + 'font-size:.68rem;">' + escHtml(primeiro.nome) + '</span>';
            if (data.marcadores.length > 1) {
                var extrasJson = JSON.stringify(data.marcadores.slice(1).map(function (m) { return { nome: m.nome, cor: m.cor || '' }; }));
                novosHtml += ' <span class="badge rounded-pill px-2 marcadores-extra" style="background:#e9ecef;color:#333;font-size:.68rem;cursor:default;" data-marcadores-json=\'' + extrasJson.replace(/'/g, '&#39;') + '\'>&hellip;</span>';
            }
        }
        var wrapper = colMarcadores.querySelector('.d-flex');
        if (wrapper) {
            wrapper.querySelectorAll('span.badge').forEach(function (s) { s.remove(); });
            wrapper.insertAdjacentHTML('afterbegin', novosHtml);
        }
        if (btnMover) {
            btnMover.dataset.marcadoresAtivos = data.marcadores.map(function (m) { return m.id; }).join(',');
        }
    };

});
</script>
{% endblock %}
