{% extends 'base.html.twig' %}

{% block title %}{{ 'expediente.titulo'|trans }}{% endblock %}

{# E8 (fidelidade ao desenho de 13/10): o visual da Lista mora em /css/expediente-lista.css, todo sob
   `.exp-body` — nenhuma regra vaza para outra tela. #}
{% block body_class %}exp-body{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        {# Título do desenho (dc L.57): 40px, pasta azul que fecha e abre ao carregar. #}
        <h1 class="exp-titulo"><span class="exp-titulo-icone" aria-hidden="true"><i class="bi bi-folder-fill"></i><i class="bi bi-folder2-open"></i></span>{{ 'expediente.titulo'|trans }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Label do painel ativo (mobile) ── #}
        <div class="d-flex d-md-none align-items-center mb-2 px-1" style="min-height:28px;">
            <small class="text-muted" id="labelPainelAtivo"></small>
        </div>

        {# ── Botão pull-tab mobile (fixo na borda esquerda) ── #}
        <button type="button" class="btn-expediente-pull-tab d-md-none" id="btnAbrirDrawer"
                aria-label="{{ 'expediente.lista.drawer_abrir'|trans }}" aria-expanded="false">
            <i class="bi bi-chevron-right" id="iconePullTab"></i>
        </button>

        {# ── Overlay mobile ── #}
        <div class="expediente-overlay" id="expedienteOverlay"></div>

        <div class="row g-0" style="min-height: calc(100vh - 160px);">

            {# ── Menu lateral do expediente ── #}
            <div class="col-auto expediente-sidebar" id="expedienteSidebar">
                {# Header do drawer — visível apenas em mobile #}
                <div class="drawer-header d-md-none">
                    <span><i class="bi bi-layout-sidebar me-1"></i> {{ 'expediente.titulo'|trans }}</span>
                    <button type="button" class="drawer-header-close" id="btnFecharDrawer" aria-label="{{ 'expediente.lista.drawer_fechar_menu'|trans }}">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                {{ include('expediente/_trilho.html.twig') }}
            </div>

            {{ include('_partials/modal_nova_pasta.html.twig', {desenho11: true}) }}

            {{ include('expediente/_modais_lista.html.twig') }}

            {# E12: "Alterar marcador" é o menu MARCADOR do desenho, na própria linha (expediente-lista.js). #}

            {# ── Área de conteúdo principal ── #}
            <div class="col expediente-content">
                {# data-painel-inicial: deep-link `?painel=acervo-geral&...` (ex.: número clicável do
                   Dashboard). O controller já filtrou a query por allowlist; o JS abre este painel
                   com precedência sobre o estado salvo no sessionStorage. #}
                <div id="expediente-painel"{% if painelInicial ?? null %} data-painel-inicial="{{ painelInicial }}"{% endif %}>
                    <div class="expediente-content-placeholder">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="text-muted mt-3">{{ 'expediente.lista.placeholder'|trans }}</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{# E8: a janela de confirmação da Pasta (E7) também aqui — exclusão de marcador. #}
{{ include('_partials/_janela_confirmacao.html.twig') }}
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Mais largura para o conteúdo ─────────────────────────────────
   Zera o padding lateral dos container-fluid aninhados desta página.
   O respiro lateral da tabela passa a vir só do painel (.p-3 ≈ 1rem),
   uniforme dos dois lados, igual ao respiro da 1ª coluna (ps-3). */
.app-content > .container-fluid,
section.content > .container-fluid {
    padding-left: 0;
    padding-right: 0;
}
/* Mantém o cabeçalho (título + flashes) com o mesmo respiro de ~1rem */
.app-content-header > .container-fluid,
section.content-header > .container-fluid {
    padding-left: 1rem;
    padding-right: 1rem;
}

/* ── Layout geral: o trilho do desenho 1.1 mora em _trilho.html.twig e expediente-lista.css (E12). ── */
.expediente-sidebar {
    position: relative;
    z-index: 10;
    flex-shrink: 0;
}

/* ── Botão pull-tab mobile (fixo na borda esquerda) ────────────── */
.btn-expediente-pull-tab {
    display: none;
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1051; /* acima do drawer */
    width: 28px;
    height: 52px;
    padding: 0;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-left: none;
    border-radius: 0 8px 8px 0;
    box-shadow: 2px 0 8px rgba(0,0,0,0.10);
    color: var(--bs-secondary-color);
    font-size: 0.95rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: left 0.25s cubic-bezier(.4,0,.2,1), background 0.15s, color 0.15s, box-shadow 0.15s;
}
.btn-expediente-pull-tab:hover,
.btn-expediente-pull-tab:focus {
    background: var(--bs-secondary-bg);
    color: #0d6efd;
    box-shadow: 2px 0 12px rgba(13,110,253,0.18);
    outline: none;
}
.btn-expediente-pull-tab.drawer-aberto {
    left: 280px;
    background: var(--bs-secondary-bg);
    color: #0d6efd;
    box-shadow: 2px 0 8px rgba(13,110,253,0.13);
}

/* ── Overlay mobile ───────────────────────────────────────────── */
.expediente-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 1040;
    backdrop-filter: blur(2px);
}
.expediente-overlay.show { display: block; }

/* ── Drawer mobile ────────────────────────────────────────────── */
@media (max-width: 767.98px) {
    .expediente-sidebar {
        position: fixed !important;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 1050;
        width: 280px !important;
        min-width: 280px !important;
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(.4,0,.2,1);
        background: var(--bs-body-bg);
        box-shadow: 4px 0 20px rgba(0,0,0,0.15);
        overflow-y: auto;
        padding-top: 56px; /* espaço para header do drawer */
    }
    .expediente-sidebar.drawer-open {
        transform: translateX(0);
    }
    .expediente-sidebar.sidebar-collapsed { width: 280px !important; min-width: 280px !important; }
    .exp-tri-recolher { display: none !important; }
    .btn-expediente-pull-tab { display: flex !important; }

    /* Header do drawer mobile */
    .drawer-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 50px;
        background: var(--bs-tertiary-bg);
        border-bottom: 1px solid var(--bs-border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--bs-body-color);
    }
    .drawer-header-close {
        background: none;
        border: none;
        font-size: 1.1rem;
        color: var(--bs-secondary-color);
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 4px;
    }
    .drawer-header-close:hover { background: var(--bs-secondary-bg); color: var(--bs-body-color); }

    /* Painel ocupa tela cheia */
    .expediente-content { overflow-x: hidden; }
    .row.g-0 { flex-direction: column !important; }
}

/* ── Conteúdo ─────────────────────────────────────────────────── */
.expediente-content {
    overflow-y: auto;
    min-width: 0;
}

.expediente-content-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 300px;
}

</style>
{# E8: o visual do desenho de 13/10 vem por último, para ganhar dos estilos antigos acima. #}
<link rel="stylesheet" href="{{ asset('css/expediente-lista.css') }}">
<link rel="stylesheet" href="{{ asset('css/expediente-lista-12.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/expediente-nova-pasta-push.js') }}"></script>
<script>
/* ── Linhas clicáveis da tabela de pastas (delegado no document) ── */
document.addEventListener('click', function (e) {
    var alvo = e.target.closest('.pasta-row-link[data-href]');
    if (!alvo) return;
    if (e.target.closest('button, a, form, input, select, .js-toggle-situacao')) return;
    if (window.ExpMenu && window.ExpMenu.abertoNoToque && window.ExpMenu.abertoNoToque()) return;   // só fecha o menu (dc `abrir`)
    window.location.href = alvo.dataset.href;
});

/* ── Alternar situação da pasta por duplo-clique na badge ── */
// O aviso da página (expediente-lista.js); o alert só se o script não carregou.
function avisarOuAlertar(texto) { if (window.ExpAviso) { window.ExpAviso(texto); } else { alert(texto); } }
document.addEventListener('dblclick', function (e) {
    var badge = e.target.closest('.js-toggle-situacao');
    if (!badge) return;
    e.stopPropagation();

    if (badge.dataset.ocupado === '1') return;
    badge.dataset.ocupado = '1';

    fetch(badge.dataset.url, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        // Manda o destino que a tela mostra: se a pasta mudou em outra aba, não vira o contrário.
        body: '_token=' + encodeURIComponent(badge.dataset.csrf) + '&situacao=' + (badge.dataset.situacao === 'ativo' ? 'arquivado' : 'ativo'),
    })
    .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
    .then(function (res) {
        badge.dataset.ocupado = '';
        if (!res.ok || !res.data.sucesso) {
            avisarOuAlertar(res.data.erro || BJ_T.t('expediente.js.lista.situacao.erro'));
            return;
        }
        var eAtivo = res.data.novaSituacao === 'ativo';
        badge.classList.remove('text-bg-success', 'text-bg-secondary');
        badge.classList.add(eAtivo ? 'text-bg-success' : 'text-bg-secondary');
        badge.textContent      = eAtivo ? BJ_T.t('expediente.js.lista.situacao.ativo') : BJ_T.t('expediente.js.lista.situacao.arquivado');
        badge.dataset.situacao = res.data.novaSituacao;
    })
    .catch(function () {
        badge.dataset.ocupado = '';
        avisarOuAlertar(BJ_T.t('expediente.js.lista.situacao.falha_conexao'));
    });
});

document.addEventListener('DOMContentLoaded', function () {
    // O recolher do trilho, os menus e os cliques nos itens moram em expediente-trilho.js (E12).
    var sidebar         = document.getElementById('expedienteSidebar');
    var labelPainel     = document.getElementById('labelPainelAtivo');

    // ── Drawer mobile ─────────────────────────────────────────────
    var overlay         = document.getElementById('expedienteOverlay');
    var btnAbrir        = document.getElementById('btnAbrirDrawer');
    var btnFechar       = document.getElementById('btnFecharDrawer');
    var iconePullTab    = document.getElementById('iconePullTab');

    function abrirDrawer() {
        sidebar.classList.add('drawer-open');
        overlay.classList.add('show');
        document.body.style.overflow = 'hidden';
        if (btnAbrir) {
            btnAbrir.classList.add('drawer-aberto');
            btnAbrir.setAttribute('aria-expanded', 'true');
            btnAbrir.setAttribute('aria-label', BJ_T.t('expediente.js.lista.drawer_fechar'));
        }
        if (iconePullTab) {
            iconePullTab.className = 'bi bi-chevron-left';
        }
    }
    function fecharDrawer() {
        sidebar.classList.remove('drawer-open');
        overlay.classList.remove('show');
        document.body.style.overflow = '';
        if (btnAbrir) {
            btnAbrir.classList.remove('drawer-aberto');
            btnAbrir.setAttribute('aria-expanded', 'false');
            btnAbrir.setAttribute('aria-label', BJ_T.t('expediente.js.lista.drawer_abrir'));
        }
        if (iconePullTab) {
            iconePullTab.className = 'bi bi-chevron-right';
        }
    }
    if (btnAbrir)  btnAbrir.addEventListener('click', function () {
        sidebar.classList.contains('drawer-open') ? fecharDrawer() : abrirDrawer();
    });
    if (btnFechar) btnFechar.addEventListener('click', fecharDrawer);
    if (overlay)   overlay.addEventListener('click', fecharDrawer);

    // Fechar drawer ao selecionar item no mobile
    document.addEventListener('click', function (e) {
        if (window.innerWidth < 768 && sidebar.classList.contains('drawer-open')) {
            var link = e.target.closest('.exp-tri-todas, .exp-tri-item:not(.is-em-breve)');
            if (link) setTimeout(fecharDrawer, 180);
        }
    });

    var painel           = document.getElementById('expediente-painel');
    var urlPainelMarcador = '{{ path('expediente_marcador_pastas', {'id': 0}) }}';

    // ── Persistência do estado do painel (sessionStorage) ───────────
    // Grava filtros + página atuais a cada recarregamento do painel para
    // poder restaurar ao voltar de uma pasta. A restauração NÃO passa pela
    // barra de endereço: o filtro "busca" é texto livre que pode conter nome
    // de cliente (PII), então fica só no sessionStorage — nada de histórico do
    // navegador. (O fetch AJAX ainda leva "busca" na query string, igual já
    // ocorria com "cliente"; isto protege a barra de endereço, não o access log.)
    var CHAVE_ESTADO_PAINEL = 'expediente:estadoPainel';

    function lerPaginaAtualDoPainel() {
        var ativo = painel.querySelector('.pagination .page-item.active .btn-pagina');
        if (ativo && ativo.dataset.page) {
            var n = parseInt(ativo.dataset.page, 10);
            if (n > 0) return n;
        }
        return 1; // sem paginação (página única) = página 1
    }

    function salvarEstadoPainel() {
        try {
            var form = document.getElementById('formFiltrosPasta');
            if (!form) return; // painel sem tabela (placeholder/erro) — nada a salvar
            var fd = new FormData(form);
            var estado = {
                painelUrl: form.getAttribute('action'), // marcador id ou rota acervo
                filtros: {
                    busca:       fd.get('busca')       || '', // texto livre (pode conter nome de cliente = PII) — só em sessionStorage
                    status:      fd.get('status')      || '',
                    responsavel: fd.get('responsavel') || '',
                    prioridade:  fd.get('prioridade')  || '',
                    data_de:     fd.get('data_de')     || '',
                    data_ate:    fd.get('data_ate')    || '',
                    criado_por:  fd.get('criado_por')  || '', // só existe quando veio por deep-link
                    concluida:   fd.get('concluida')   || '', // idem: "concluídas no período" (coluna Pastas concluídas do Dashboard)
                    expediente:  fd.get('expediente')  || '', // filtro do sistema do trilho (E12)
                    por_pagina:  fd.get('por_pagina')  || '',
                    ordenar:     fd.get('ordenar')     || '',
                    direcao:     fd.get('direcao')     || ''
                },
                page: lerPaginaAtualDoPainel()
            };
            sessionStorage.setItem(CHAVE_ESTADO_PAINEL, JSON.stringify(estado));
        } catch (e) { /* sessionStorage indisponível/cheio — ignora silenciosamente */ }
    }
    // Exposto para os fragmentos AJAX chamarem após cada render do painel
    window.salvarEstadoPainelExpediente = salvarEstadoPainel;

    function voltouDePastaShow() {
        try {
            if (!document.referrer) return false;
            var ref = new URL(document.referrer);
            if (ref.origin !== window.location.origin) return false;
            // pasta_show = /pasta/{id} (prefixo de classe /pasta). Exclui /pasta
            // (index) e rotas com segmentos extras (/pasta/{id}/...).
            return /^\/pasta\/[^\/]+$/.test(ref.pathname);
        } catch (e) { return false; }
    }

    // O trilho (expediente-trilho.js) sabe marcar o item do painel: Todas, um filtro do sistema ou um marcador.
    function reacenderSidebarPainel(painelUrl, expediente) {
        var nome = window.ExpTrilho ? window.ExpTrilho.marcarPorPainel(painelUrl, expediente || '') : '';
        if (labelPainel && nome) labelPainel.textContent = nome;
    }

    function tentarRestaurarEstadoPainel() {
        if (!voltouDePastaShow()) return false;

        var bruto;
        try { bruto = sessionStorage.getItem(CHAVE_ESTADO_PAINEL); }
        catch (e) { return false; }
        if (!bruto) return false;

        var estado;
        try { estado = JSON.parse(bruto); }
        catch (e) { return false; } // estado corrompido — ignora
        if (!estado || !estado.painelUrl) return false;

        var params = new URLSearchParams();
        var f = estado.filtros || {};
        ['busca', 'status', 'responsavel', 'prioridade', 'data_de', 'data_ate', 'criado_por', 'concluida', 'expediente', 'por_pagina', 'ordenar', 'direcao'].forEach(function (k) {
            if (f[k]) params.set(k, f[k]);
        });
        if (estado.page && estado.page > 1) params.set('page', estado.page);

        var qs  = params.toString();
        var url = estado.painelUrl + (qs ? ('?' + qs) : '');

        // Repinta o painel já no estado salvo (sem passar pelo default → sem flicker).
        // O servidor re-renderiza o form com selected/value, então os filtros voltam
        // preenchidos visualmente pelo próprio fetch.
        carregarPainel(url, null);
        reacenderSidebarPainel(estado.painelUrl, f.expediente || '');
        return true;
    }

    // Deep-link `?painel=acervo-geral&...`: o servidor já montou a URL do painel (com os
    // filtros da allowlist) em data-painel-inicial. Vence o estado salvo de propósito — quem
    // clicou num número do Dashboard quer ver a lista daquele número, não a última que viu.
    function tentarAbrirPainelDoDeepLink() {
        var url = painel.dataset.painelInicial;
        if (!url) return false;

        var linkAcervo = document.querySelector('.exp-tri-todas[data-painel]');
        carregarPainel(url, BJ_T.t('expediente.js.lista.todas_as_pastas'));
        if (linkAcervo) reacenderSidebarPainel(linkAcervo.dataset.painel, filtroDoSistemaNaUrl(url));
        consumirParametrosDoDeepLink();

        return true;
    }

    // Filtro do sistema (EXPEDIENTES do trilho, E12) que veio no deep-link, para o trilho marcar o item.
    function filtroDoSistemaNaUrl(url) {
        try { return new URL(url, window.location.origin).searchParams.get('expediente') || ''; } catch (e) { return ''; }
    }

    // Deep-link consumido: tira `painel` e os filtros que ele repassou da barra de endereço
    // (mesma lista de ExpedienteController::PARAMS_DEEP_LINK_ACERVO). Sem isso, voltar a esta
    // página (pasta_show → Voltar) reaplicaria o deep-link e atropelaria o estado salvo no
    // sessionStorage. replaceState: não cria entrada nova no histórico.
    function consumirParametrosDoDeepLink() {
        if (!window.history || typeof window.history.replaceState !== 'function') return;
        var atual;
        try { atual = new URL(window.location.href); } catch (e) { return; }
        ['painel', 'status', 'responsavel', 'prioridade', 'data_de', 'data_ate', 'criado_por', 'concluida', 'expediente', 'por_pagina', 'ordenar', 'direcao', 'page']
            .forEach(function (chave) { atual.searchParams.delete(chave); });
        window.history.replaceState(window.history.state, '', atual.pathname + atual.search + atual.hash);
    }

    // "Criado por" não tem campo na barra de filtro (só chega por deep-link). Para a
    // paginação, a ordenação e os demais filtros — que remontam a URL a partir do form —
    // não o perderem, ele entra no form como hidden. Recebe a URL que acabou de ser
    // carregada; se ela não traz criado_por, não há o que preservar.
    function garantirCampoCriadoPor(urlCarregada) {
        var form = document.getElementById('formFiltrosPasta');
        if (!form || form.querySelector('[name="criado_por"]')) return;

        var valor = '';
        try { valor = new URL(urlCarregada, window.location.origin).searchParams.get('criado_por') || ''; }
        catch (e) { return; }
        if (valor === '') return;

        var campo = document.createElement('input');
        campo.type  = 'hidden';
        campo.name  = 'criado_por';
        campo.value = valor;
        // js-pasta-filtro: o "Limpar tudo" zera junto com os outros filtros.
        campo.className = 'js-pasta-filtro';
        campo.dataset.rotulo = BJ_T.t('expediente.js.lista.criado_por');
        form.appendChild(campo);
    }

    // "Concluídas no período" também só chega por deep-link (coluna Pastas concluídas do Dashboard):
    // mesmo tratamento do "Criado por", para a paginação, a ordenação e as datas não o perderem.
    function garantirCampoConcluida(urlCarregada) {
        var form = document.getElementById('formFiltrosPasta');
        if (!form || form.querySelector('[name="concluida"]')) return;

        var valor = '';
        try { valor = new URL(urlCarregada, window.location.origin).searchParams.get('concluida') || ''; }
        catch (e) { return; }
        if (valor !== '1') return;

        var campo = document.createElement('input');
        campo.type  = 'hidden';
        campo.name  = 'concluida';
        campo.value = valor;
        campo.className = 'js-pasta-filtro';
        campo.dataset.rotulo = BJ_T.t('expediente.js.lista.concluida_no_periodo');
        form.appendChild(campo);
    }

    // ── Bootstrap do painel ──────────────────────────────────────────
    // Deep-link (?painel=acervo-geral) primeiro; depois, se o usuário voltou de uma
    // pasta (pasta_show) e há estado salvo, restaura o painel como estava (filtros +
    // página). Caso contrário, comportamento padrão: "Todas as pastas" (Acervo Geral),
    // página 1, sem filtros.
    (function () {
        if (tentarAbrirPainelDoDeepLink()) return;
        if (tentarRestaurarEstadoPainel()) return;

        var linkTodasPastas = document.querySelector('.exp-tri-todas[data-painel]');
        if (linkTodasPastas) {
            marcarNoTrilho(linkTodasPastas);
            carregarPainel(linkTodasPastas.dataset.painel, BJ_T.t('expediente.js.lista.todas_as_pastas'));
        }
    })();

    function injetarHtmlComScripts(container, html) {
        container.innerHTML = html;
        container.querySelectorAll('script').forEach(function (scriptOriginal) {
            var novoScript = document.createElement('script');
            Array.from(scriptOriginal.attributes).forEach(function (attr) {
                novoScript.setAttribute(attr.name, attr.value);
            });
            novoScript.textContent = scriptOriginal.textContent;
            scriptOriginal.parentNode.replaceChild(novoScript, scriptOriginal);
        });
    }

    /* E8b: o item aberto fica marcado no trilho (LX-TRI-05). Quem chama marca ANTES do carregarPainel; ele
       apagava a marca (só da raiz) logo em seguida, e o selecionado do desenho nunca aparecia. Raiz e
       sub-marcador saem juntos: abrir um marcador raiz deixava marcado o sub-marcador aberto antes. */
    function marcarNoTrilho(link) {
        document.querySelectorAll('.exp-tri-todas, .exp-tri-item').forEach(function (l) { l.classList.remove('active'); l.removeAttribute('aria-current'); });
        if (link) { link.classList.add('active'); link.setAttribute('aria-current', 'true'); }
    }

    /* E12: com `opcoes.efeito`, o efeito do desenho (dc `bxFx`, 1,3 s) "Só um instante, estamos buscando em todo
       o sistema…" fica no lugar da tabela até o tempo dele passar, mesmo que a resposta chegue antes. */
    var EFEITO_BUSCA = '<div class="exp-busca-efeito" role="status"><span class="exp-busca-efeito-txt"><i class="bi bi-stars" aria-hidden="true"></i>' + escHtmlChip(BJ_T.t('expediente.js.lista.buscando')) + '</span><span class="exp-busca-efeito-barra" aria-hidden="true"><span></span></span></div>';

    function carregarPainel(url, nomeAtivo, opcoes) {
        var efeito = !!(opcoes && opcoes.efeito);
        // "Pastas por página" escolhido no Visualizar vale para todo painel (dc `porPag`, guardado no navegador).
        var pp = null;
        try { pp = localStorage.getItem('expediente_por_pagina'); } catch (e) { /* indisponível */ }
        if (pp && url.indexOf('por_pagina=') === -1) url += (url.indexOf('?') === -1 ? '?' : '&') + 'por_pagina=' + encodeURIComponent(pp);
        var inicio = Date.now();
        painel.innerHTML = efeito ? EFEITO_BUSCA : '<div class="p-4 text-center text-muted"><i class="bi bi-hourglass-split"></i> ' + escHtmlChip(BJ_T.t('expediente.js.lista.carregando')) + '</div>';
        if (labelPainel && nomeAtivo) labelPainel.textContent = nomeAtivo;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);

                return r.text();
            })
            .then(function (html) {
                var falta = efeito ? 1300 - (Date.now() - inicio) : 0;
                return falta > 0 ? new Promise(function (ok) { setTimeout(function () { ok(html); }, falta); }) : html;
            })
            .then(function (html) {
                injetarHtmlComScripts(painel, html);
                // Pós-processamento não-crítico: se algo aqui falhar, a tabela já foi
                // injetada e continua visível — não escondemos tudo atrás do erro.
                try { garantirCampoCriadoPor(url); } catch (e) { /* ignora */ }
                try { garantirCampoConcluida(url); } catch (e) { /* ignora */ }
                try { salvarEstadoPainel(); } catch (e) { /* ignora */ }
                try { construirChipsPastas(); } catch (e) { /* ignora */ }
            })
            .catch(function () {
                painel.innerHTML = '<div class="p-4 alert alert-danger">' + escHtmlChip(BJ_T.t('expediente.js.lista.erro_carregar')) + '</div>';
            });
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Filtro de pastas — busca ao vivo (debounce), dropdowns/datas na hora, chips.
    //  Tudo delegado no #expediente-painel (persistente), então sobrevive às trocas
    //  de HTML. Apenas os resultados (#pastas-resultado) recarregam a cada filtro,
    //  deixando a barra de filtro intacta (o campo de busca não perde o foco).
    // ═══════════════════════════════════════════════════════════════════════
    var buscaFiltroTimer = null;

    function escHtmlChip(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function construirChipsPastas() {
        var form = document.getElementById('formFiltrosPasta');
        var box  = document.getElementById('pasta-chips');
        if (!form || !box) return;

        var chips = [];

        // E12: no desenho 1.1 os filtros aparecem nos próprios campos (azul-claros quando valem) e o "Limpar" é
        // o ícone da faixa. Chip só para o "Criado por", que não tem campo (chega pelo deep-link do Dashboard).

        // "Criado por" (hidden, só via deep-link): o nome vem do próprio select de
        // responsável, que lista os mesmos colaboradores ativos do Dashboard.
        var criadoPor = form.querySelector('input[type="hidden"][name="criado_por"]');
        if (criadoPor && criadoPor.value !== '') {
            var selResp = form.querySelector('select[name="responsavel"]');
            var optResp = selResp ? selResp.querySelector('option[value="' + CSS.escape(criadoPor.value) + '"]') : null;
            // `equipe` / `equipe:<cargo>`: "ver pastas" do card Pastas criadas do Dashboard
            // (colaboradores ativos, opcionalmente de um cargo; `__sem__` = sem cargo).
            var valorCriador;
            if (criadoPor.value === 'equipe') {
                valorCriador = BJ_T.t('expediente.js.lista.equipe');
            } else if (criadoPor.value.indexOf('equipe:') === 0) {
                var cargoCriador = criadoPor.value.slice('equipe:'.length);
                valorCriador = BJ_T.t('expediente.js.lista.equipe_cargo', {cargo: (cargoCriador === '__sem__' ? BJ_T.t('expediente.js.lista.sem_cargo') : cargoCriador)});
            } else {
                valorCriador = optResp ? optResp.textContent.trim() : BJ_T.t('expediente.js.lista.colaborador_id', {id: criadoPor.value});
            }
            chips.push({
                campo: 'criado_por',
                rotulo: criadoPor.dataset.rotulo || BJ_T.t('expediente.js.lista.criado_por'),
                valor: valorCriador
            });
        }

        // "Concluídas no período" (hidden, só via deep-link): as datas do filtro passam a valer sobre a conclusão.
        var concluida = form.querySelector('input[type="hidden"][name="concluida"]');
        if (concluida && concluida.value === '1') {
            chips.push({
                campo: 'concluida',
                rotulo: '',
                valor: concluida.dataset.rotulo || BJ_T.t('expediente.js.lista.concluida_no_periodo')
            });
        }

        if (chips.length === 0) { box.innerHTML = ''; return; }

        var html = chips.map(function (c) {
            return '<span class="pasta-chip">' +
                (c.rotulo ? '<span class="pasta-chip-rotulo">' + escHtmlChip(c.rotulo) + ':</span> ' : '') +
                '<span class="pasta-chip-valor">' + escHtmlChip(c.valor) + '</span>' +
                '<button type="button" class="pasta-chip-remover js-chip-remover" data-campo="' + escHtmlChip(c.campo) + '" title="' + escHtmlChip(BJ_T.t('expediente.js.lista.chip_remover')) + '" aria-label="' + escHtmlChip(BJ_T.t('expediente.js.lista.chip_remover_filtro')) + '">' +
                '<i class="bi bi-x"></i></button>' +
                '</span>';
        }).join('');
        html += '<button type="button" class="pasta-chips-limpar js-pasta-limpar">' + escHtmlChip(BJ_T.t('expediente.js.lista.limpar_tudo')) + '</button>';
        box.innerHTML = html;
    }

    /* Nova Pasta salva (modal_nova_pasta, desenho 03 dc `salvarNovaFn`): a lista volta ao NUP decrescente, página 1,
       e avisa. Os filtros ficam como estão, como no desenho. */
    document.addEventListener('exp:pasta-criada', function (e) {
        var f = document.getElementById('formFiltrosPasta');
        var ord = f && f.querySelector('[name="ordenar"]');
        var dir = f && f.querySelector('[name="direcao"]');
        if (ord) ord.value = 'nup';
        if (dir) dir.value = 'desc';
        recarregarResultadosPastas({ page: 1 });
        avisarOuAlertar(BJ_T.t('expediente.js.lista.pasta_criada', {nup: e.detail.nup, cliente: e.detail.cliente}));
    });

    function recarregarResultadosPastas(extraParams) {
        var form = document.getElementById('formFiltrosPasta');
        if (!form) return;

        var params = new URLSearchParams(new FormData(form));
        if (extraParams) {
            Object.keys(extraParams).forEach(function (k) { params.set(k, extraParams[k]); });
        }

        var url   = form.getAttribute('action') + '?' + params.toString();
        var atual = document.getElementById('pastas-resultado');
        if (atual) atual.classList.add('pastas-carregando');

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                var doc  = new DOMParser().parseFromString(html, 'text/html');
                var novo = doc.getElementById('pastas-resultado');
                var alvo = document.getElementById('pastas-resultado');
                if (novo && alvo) {
                    injetarHtmlComScripts(alvo, novo.innerHTML);
                    alvo.classList.remove('pastas-carregando');
                } else {
                    // Fallback improvável: fragmento sem #pastas-resultado — repinta tudo.
                    injetarHtmlComScripts(painel, html);
                }
                salvarEstadoPainel();
            })
            .catch(function () {
                var alvo = document.getElementById('pastas-resultado');
                if (alvo) alvo.classList.remove('pastas-carregando');
            });
    }

    function aplicarFiltrosPastas() {
        construirChipsPastas();
        recarregarResultadosPastas({ page: 1 });
    }

    // Busca livre com debounce (mantém o foco: só #pastas-resultado recarrega)
    painel.addEventListener('input', function (e) {
        if (!e.target.classList || !e.target.classList.contains('js-pasta-busca')) return;
        construirChipsPastas();
        clearTimeout(buscaFiltroTimer);
        buscaFiltroTimer = setTimeout(function () { recarregarResultadosPastas({ page: 1 }); }, 350);
    });

    // Enter na busca aplica imediatamente
    painel.addEventListener('submit', function (e) {
        if (!e.target || e.target.id !== 'formFiltrosPasta') return;
        e.preventDefault();
        clearTimeout(buscaFiltroTimer);
        aplicarFiltrosPastas();
    });

    // Dropdowns (status/responsável/prioridade), datas e "Ordenar por" aplicam ao mudar
    painel.addEventListener('change', function (e) {
        // "Ordenar por" (modo lista): grava nos hidden ordenar/direcao e recarrega o acervo
        if (e.target.classList && e.target.classList.contains('js-pasta-ordenar')) {
            var partes = (e.target.value || '').split('|');
            if (!partes[0]) return;
            var f = document.getElementById('formFiltrosPasta');
            if (f) {
                var co = f.querySelector('[name="ordenar"]');
                var cd = f.querySelector('[name="direcao"]');
                if (co) co.value = partes[0];
                if (cd) cd.value = (partes[1] === 'desc' ? 'desc' : 'asc');
            }
            recarregarResultadosPastas({ page: 1 });
            return;
        }
        if (!e.target.classList || !e.target.classList.contains('js-pasta-filtro')) return;
        aplicarFiltrosPastas();
    });

    // Remover chip, limpar tudo, paginação, abrir calendário e ordenar por coluna
    painel.addEventListener('click', function (e) {
        // Ordenação por cabeçalho (server-side: ordena o acervo inteiro, não só a página)
        var th = e.target.closest('#tabelaPastas th.sortable[data-ordenar]');
        if (th) {
            e.preventDefault();
            var formOrd = document.getElementById('formFiltrosPasta');
            if (formOrd) {
                var campoOrd = formOrd.querySelector('[name="ordenar"]');
                var campoDir = formOrd.querySelector('[name="direcao"]');
                var novaCol  = th.dataset.ordenar;
                var mesma    = campoOrd && campoOrd.value === novaCol;
                var novaDir  = (mesma && campoDir && campoDir.value === 'asc') ? 'desc' : 'asc';
                if (campoOrd) campoOrd.value = novaCol;
                if (campoDir) campoDir.value = novaDir;
                recarregarResultadosPastas({ page: 1 });
            }

            return;
        }

        var calendario = e.target.closest('.js-abrir-calendario');
        if (calendario) {
            e.preventDefault();
            var campoData = calendario.parentNode.querySelector('input[type="date"]');
            if (campoData && typeof campoData.showPicker === 'function') {
                try { campoData.showPicker(); } catch (err) { campoData.focus(); }
            } else if (campoData) {
                campoData.focus();
            }

            return;
        }

        var remover = e.target.closest('.js-chip-remover');
        if (remover) {
            e.preventDefault();
            var form = document.getElementById('formFiltrosPasta');
            var alvo = form && form.elements.namedItem(remover.dataset.campo);
            if (alvo) alvo.value = '';
            aplicarFiltrosPastas();

            return;
        }

        var limpar = e.target.closest('.js-pasta-limpar');
        if (limpar) {
            e.preventDefault();
            var f = document.getElementById('formFiltrosPasta');
            // Limpa só os filtros (busca + dropdowns + datas); a ordenação da tabela
            // é outra dimensão e é preservada (os hidden ordenar/direcao ficam intactos).
            // A Situação da pasta também fica: o Limpar do desenho 03 zera busca, responsável, prioridade e datas
            // (dc `limpar`); a Situação se troca no próprio filtro dela, e o ↻ do painel zera tudo.
            if (f) Array.prototype.filter.call(f.elements, function (el) { return el.matches('.js-pasta-busca, .js-pasta-filtro') && el.name !== 'status'; }).forEach(function (el) { el.value = ''; });
            aplicarFiltrosPastas();

            return;
        }

        var pagina = e.target.closest('.btn-pagina');
        if (pagina) {
            e.preventDefault();
            recarregarResultadosPastas({ page: pagina.dataset.page });
        }
    });

    // ── Popover customizado dos marcadores extras (delegado — funciona para conteúdo AJAX) ──
    (function () {
        if (document.__marcadoresPopoverInit) return;
        document.__marcadoresPopoverInit = true;

        if (!document.getElementById('marcadores-popover')) {
            var popoverEl = document.createElement('div');
            popoverEl.id = 'marcadores-popover';
            popoverEl.className = 'marcadores-popover-box';
            popoverEl.style.cssText = 'display:none;position:absolute;z-index:9999;background:var(--bs-body-bg);border:1px solid var(--bs-border-color);border-radius:8px;padding:8px 10px;box-shadow:0 4px 16px rgba(0,0,0,.13);display:none;flex-direction:column;gap:5px;min-width:120px;max-width:240px;pointer-events:none;';
            document.body.appendChild(popoverEl);
        }

        function escHtmlPop(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function posicionarPopover(anchor) {
            var el = document.getElementById('marcadores-popover');
            if (!el) return;
            var rect = anchor.getBoundingClientRect();
            el.style.visibility = 'hidden';
            el.style.display = 'flex';
            var popRect = el.getBoundingClientRect();
            var top  = rect.top + window.scrollY - popRect.height - 8;
            var left = rect.left + window.scrollX + (rect.width / 2) - (popRect.width / 2);
            if (left < 8) left = 8;
            if (left + popRect.width > window.innerWidth - 8) left = window.innerWidth - 8 - popRect.width;
            if (top < window.scrollY + 8) top = rect.bottom + window.scrollY + 8;
            el.style.top  = top + 'px';
            el.style.left = left + 'px';
            el.style.visibility = '';
        }

        document.addEventListener('mouseover', function (e) {
            var badge = e.target.closest('.marcadores-extra[data-marcadores-json]');
            if (!badge) return;
            var marcadores;
            try { marcadores = JSON.parse(badge.dataset.marcadoresJson); } catch (err) { return; }
            if (!marcadores || marcadores.length === 0) return;
            var el = document.getElementById('marcadores-popover');
            if (!el) return;
            el.innerHTML = marcadores.map(function (m) {
                var bg    = m.cor || 'var(--bs-tertiary-bg)';
                var cor   = m.cor ? '#333' : 'var(--bs-body-color)';
                var borda = m.cor ? 'border:1px solid rgba(0,0,0,.1);' : '';
                return '<span style="display:inline-block;border-radius:20px;padding:2px 10px;font-size:.72rem;font-weight:500;color:' + cor + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;background:' + bg + ';' + borda + '">' + escHtmlPop(m.nome) + '</span>';
            }).join('');
            posicionarPopover(badge);
        });

        document.addEventListener('mouseout', function (e) {
            var badge = e.target.closest('.marcadores-extra[data-marcadores-json]');
            if (!badge) return;
            var el = document.getElementById('marcadores-popover');
            if (el) el.style.display = 'none';
        });

        document.addEventListener('scroll', function () {
            var el = document.getElementById('marcadores-popover');
            if (el && el.style.display !== 'none') el.style.display = 'none';
        }, true);
    })();

    // ── Callback pós-salvar do modal "Mover para": atualiza badges na tabela E no cartão ──
    // Ponte para o trilho e a Lista (expediente-trilho.js, expediente-lista.js): abrir painel, marcar item,
    // recarregar só os resultados com parâmetros extras.
    window.ExpPainel = {
        carregar: carregarPainel,
        marcar: marcarNoTrilho,
        recarregarResultados: recarregarResultadosPastas,
        paginaAtual: lerPaginaAtualDoPainel,
        urlMarcador: function (id) { return urlPainelMarcador.replace('/0/', '/' + id + '/'); }
    };


});
</script>
{{ catalogo_js('expediente.js') }}
