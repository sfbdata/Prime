{# Só os RESULTADOS da listagem de pastas. A barra de filtro fica em
   pasta/_filtros.html.twig (fora da área trocável). #}
{% import '_partials/_avatar_usuario.html.twig' as av %}
{% set filters = filters ?? {} %}
{% set responsaveis = responsaveis ?? [] %}
{% set usuarios = usuarios ?? responsaveis %}
{% set fotosResponsaveis = fotosResponsaveis ?? {} %}
{% set ordCol = ordenar ?? '' %}
{% set ordDir = (direcao ?? '') == 'asc' ? 'asc' : 'desc' %}
{# O que o cabeçalho mostra: sem ordenação escolhida vale a padrão do repositório, NUP decrescente. #}
{% set ordColVis = ordCol ?: 'nup' %}
{% set ordDirVis = ordCol ? ordDir : 'desc' %}
{% import _self as tab %}
{% macro seta(col, atual, dir) %}<i class="bi {{ col == atual ? (dir == 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-chevron-expand' }} sort-icon" aria-hidden="true"></i>{% endmacro %}
{% macro ariaSort(col, atual, dir) %}{% if col == atual %} aria-sort="{{ dir == 'asc' ? 'ascending' : 'descending' }}"{% endif %}{% endmacro %}
{# Favoritas do usuário logado (menu ⋮ da pasta → "Fixar nos favoritos"): uma consulta só,
   e a linha ganha a estrela. Quem as põe no topo é a ordenação do repositório. #}
{% set favoritasIds = pastas_favoritas_ids() %}
{# Parâmetros de quem inclui (padrão = Expediente, que não passa nenhum). As Minhas Demandas (desenho 15,
   pasta/demandas/_acervo) trocam as rotas pelas delas (módulo `pastas`), as colunas padrão e a chave local das
   colunas, tiram o "Painel de marcadores" (a tela não tem trilho) e trocam o resumo e o vazio. #}
{% set rotaPastaNome = rotaPastaNome ?? 'expediente_pasta_nome' %}
{% set rotaPastaTrancar = rotaPastaTrancar ?? 'expediente_pasta_trancar' %}
{% set rotaPastaDestaque = rotaPastaDestaque ?? 'expediente_pasta_destaque' %}
{% set rotaPastaMarcadores = rotaPastaMarcadores ?? 'expediente_pasta_marcadores' %}
{% set urlCsvLista = urlCsvLista ?? path('expediente_exportar_csv') %}
{% set urlColunasLista = urlColunasLista ?? path('expediente_colunas_gravar') %}
{% set colunasPadrao = colunasPadrao ?? null %}
{% set prefixoColunasLocal = prefixoColunasLocal ?? null %}
{% set semPainelMarcadores = semPainelMarcadores ?? false %}
{% set resumoDemandas = resumoDemandas ?? false %}

<style>
@keyframes urgente-pulso {
    0%, 100% { opacity: 1; }
    50%       { opacity: .35; }
}
.badge-urgente-pulso {
    animation: urgente-pulso 1.2s ease-in-out infinite;
}
</style>

{% if pastas|length > 0 %}
<div class="pastas-view pastas-view--tabela" id="pastasView">
{# Topo do resultado no desenho 1.1 (dc L.112-139, AUD-11/12): "Visualizar" e a paginação ficam na MESMA linha
   dos filtros, à direita, e o resumo vem sozinho embaixo. Os filtros moram fora desta área trocável
   (pasta/_filtros); no desktop o `.exp-topo` some da caixa (display: contents, expediente-lista.css) e os
   controles entram na faixa dos filtros. No celular (sem "Visualizar": sempre cartões) fica empilhado. #}
<div class="exp-topo">
    <div class="exp-controles">
        {# "Ordenar por" — só no modo lista (no desktop) e no mobile (nenhum tem cabeçalho de coluna) #}
        {# Mesma ordem que o cabeçalho mostra: sem escolha, a padrão (NUP decrescente). #}
        {% set ordAtual = ordColVis ~ '|' ~ ordDirVis %}
        <div class="pasta-ordenar-wrap">
            <select class="form-select form-select-sm js-pasta-ordenar" aria-label="{{ 'expediente.lista.ordenar.rotulo'|trans }}" title="{{ 'expediente.lista.ordenar.rotulo'|trans }}">
                <option value="" disabled>{{ 'expediente.lista.ordenar.escolher'|trans }}</option>
                <option value="nup|asc"          {% if ordAtual == 'nup|asc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.nup_asc'|trans }}</option>
                <option value="nup|desc"         {% if ordAtual == 'nup|desc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.nup_desc'|trans }}</option>
                <option value="cliente|asc"      {% if ordAtual == 'cliente|asc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.cliente_asc'|trans }}</option>
                <option value="cliente|desc"     {% if ordAtual == 'cliente|desc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.cliente_desc'|trans }}</option>
                <option value="prioridade|desc"  {% if ordAtual == 'prioridade|desc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.prioridade_desc'|trans }}</option>
                <option value="prioridade|asc"   {% if ordAtual == 'prioridade|asc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.prioridade_asc'|trans }}</option>
                <option value="acao|asc"         {% if ordAtual == 'acao|asc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.acao_asc'|trans }}</option>
                <option value="responsavel|asc"  {% if ordAtual == 'responsavel|asc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.responsavel_asc'|trans }}</option>
                <option value="situacao|asc"     {% if ordAtual == 'situacao|asc' %}selected{% endif %}>{{ 'expediente.lista.ordenar.situacao_asc'|trans }}</option>
            </select>
        </div>
        {# "Visualizar" (dc L.151-169, E12): os 5 modos, "Pastas por página" e "Painel de marcadores". #}
        {% set porPaginaAtual = pagination.per_page ?? 50 %}
        <div class="exp-visualizar pasta-view-toggle d-none d-md-block">
            <button type="button" class="exp-visualizar-botao js-visualizar" aria-haspopup="menu" aria-expanded="false"
                    aria-controls="expVisualizarMenu" data-tip="{{ 'expediente.lista.visualizar.dica'|trans }}">
                <i class="bi bi-list-columns-reverse js-visualizar-icone" aria-hidden="true"></i>{{ 'expediente.lista.visualizar.rotulo'|trans }}<i class="bi bi-chevron-down exp-visualizar-seta" aria-hidden="true"></i>
            </button>
            <div class="exp-visualizar-menu" id="expVisualizarMenu" role="menu" aria-label="{{ 'expediente.lista.visualizar.rotulo'|trans }}" hidden>
                {% for m in [
                    ['tabela', 'expediente.lista.visualizar.modo.tabela'|trans, 'bi-list-columns-reverse', 'expediente.lista.visualizar.modo_dica.tabela'|trans],
                    ['compacto', 'expediente.lista.visualizar.modo.compacto'|trans, 'bi-list-columns', 'expediente.lista.visualizar.modo_dica.compacto'|trans],
                    ['simples', 'expediente.lista.visualizar.modo.simples'|trans, 'bi-list', 'expediente.lista.visualizar.modo_dica.simples'|trans],
                    ['lista', 'expediente.lista.visualizar.modo.lista'|trans, 'bi-grid', 'expediente.lista.visualizar.modo_dica.lista'|trans],
                    ['grandes', 'expediente.lista.visualizar.modo.grandes'|trans, 'bi-grid-1x2', 'expediente.lista.visualizar.modo_dica.grandes'|trans]
                ] %}
                <button type="button" class="exp-vis-item js-view-toggle" data-view="{{ m[0] }}" data-icone="{{ m[2] }}" role="menuitemradio" aria-checked="{{ m[0] == 'tabela' ? 'true' : 'false' }}" data-tip="{{ m[3] }}">
                    <span class="exp-vis-ponto" aria-hidden="true"></span><i class="bi {{ m[2] }}" aria-hidden="true"></i>{{ m[1] }}
                </button>
                {% endfor %}
                <div class="exp-vis-sep" role="separator"></div>
                <div class="exp-vis-titulo">{{ 'expediente.lista.visualizar.por_pagina'|trans }}</div>
                <div class="exp-vis-porpag" role="group" aria-label="{{ 'expediente.lista.visualizar.por_pagina'|trans }}">
                    {% for n in [25, 50, 100] %}
                        <button type="button" class="exp-vis-pp js-por-pagina{{ n == porPaginaAtual ? ' is-atual' }}" data-n="{{ n }}" aria-pressed="{{ n == porPaginaAtual ? 'true' : 'false' }}">{{ n }}</button>
                    {% endfor %}
                </div>
                {% if not semPainelMarcadores %}
                <div class="exp-vis-sep" role="separator"></div>
                <button type="button" class="exp-vis-item js-vis-painel" role="menuitemcheckbox" aria-checked="true">
                    <span class="exp-vis-ponto" aria-hidden="true"></span><i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i>{{ 'expediente.lista.visualizar.painel_marcadores'|trans }}
                </button>
                {% endif %}
            </div>
        </div>
        {% if pagination is defined and pagination is not null %}
            {{ include('expediente/_paginacao.html.twig') }}
        {% endif %}
    </div>
    {# Resumo do desenho (dc L.139, `resumo` em L.455): o INTERVALO de pastas desta página ("1 de 50"; na
       segunda, "51 de 100") e o total da consulta inteira, separados por espaços largos (U+2003). A E8 lia
       "página de N" (AUD-14). #}
    {# Linha do resumo (dc L.178-182): botão de colunas (clique e botão direito) e o resumo. #}
    <span class="exp-resumo">
        <button type="button" class="exp-colunas js-colunas" data-url-csv="{{ urlCsvLista }}" data-tip="{{ 'expediente.lista.colunas'|trans }}" aria-label="{{ 'expediente.lista.colunas'|trans }}" aria-haspopup="menu"><i class="bi bi-layout-three-columns" aria-hidden="true"></i></button>
        <i class="bi bi-list-ul" aria-hidden="true"></i>
        {%- if resumoDemandas %}
            {{ 'pasta_lista.demandas.resumo'|trans({total: (pagination.total_items ?? pastas|length)|numero(0)}) }}
        {%- elseif pagination is defined and pagination is not null %}
            {%- set primeiraDaPagina = (pagination.current_page - 1) * pagination.per_page + 1 %}
            {{ 'expediente.lista.resumo.intervalo'|trans({inicio: primeiraDaPagina|numero(0), fim: (primeiraDaPagina + pastas|length - 1)|numero(0)}) }}&#8195;·&#8195;{{ pagination.total_items != 1 ? 'expediente.lista.resumo.total_varias'|trans({total: pagination.total_items|numero(0)}) : 'expediente.lista.resumo.total_uma'|trans({total: pagination.total_items|numero(0)}) }}
        {%- else %}
            {{ pastas|length != 1 ? 'expediente.lista.resumo.contagem_varias'|trans({n: pastas|length ~ ''}) : 'expediente.lista.resumo.contagem_uma'|trans({n: pastas|length ~ ''}) }}
        {%- endif %}
    </span>
</div>

{# ── Tabela (dc L.190-234, E12) ─────────────────────────────────────────
   Colunas do 1.1: NUP · Cliente · Réu · Ação · Prioridade · Responsável · Metas · Marcadores · Situação. Cada
   <col>, <th> e <td> leva `data-col`: o menu de colunas esconde por ele (expediente-lista.js). A linha leva o que
   o menu de botão direito precisa (id, número, nome, trancada, destaque) e as cores do destaque do usuário.
   Cadeado (spec pasta-cadeado D1): `cadeados[id]` traz o nível de quem olha. Pasta OCULTA para a pessoa continua
   listada só com o número, o cliente e o cadeado; as outras células ficam vazias (`data-oculta="1"` abre a janela
   "Pasta N protegida" no lugar da pasta). #}
{% set PRIO = {normal: 'expediente.lista.prioridade.normal'|trans, prioridade: 'expediente.lista.prioridade.alta'|trans, urgente: 'expediente.lista.prioridade.urgente'|trans} %}
{% set PRIO_TIP = {normal: 'expediente.lista.prioridade_dica.normal'|trans, prioridade: 'expediente.lista.prioridade_dica.alta'|trans, urgente: 'expediente.lista.prioridade_dica.urgente'|trans} %}
{% set SIT = {ativo: ['expediente.lista.situacao.ativo'|trans, 'expediente.lista.situacao_dica.ativo'|trans], suspenso: ['expediente.lista.situacao.suspenso'|trans, 'expediente.lista.situacao_dica.suspenso'|trans], cancelado: ['expediente.lista.situacao.cancelado'|trans, 'expediente.lista.situacao_dica.cancelado'|trans], arquivado: ['expediente.lista.situacao.arquivado'|trans, 'expediente.lista.situacao_dica.arquivado'|trans]} %}
{% set reusPorPasta = reusPorPasta ?? {} %}
{% set pastasPorCliente = pastasPorCliente ?? {} %}
{% set destaques = destaques ?? {} %}
{% set cadeados = cadeados ?? {} %}
<div class="pastas-tabela-wrap card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover mb-0" id="tabelaPastas" data-csrf-lista="{{ csrfLista ?? '' }}" data-sou-admin="{{ (souAdministrador ?? false) ? '1' : '0' }}"
               data-chave-colunas="{{ (current_tenant() ? current_tenant().id : 0) ~ ':' ~ (app.user ? app.user.id : 0) }}"
               data-colunas="{{ (colunasSalvas ?? null)|json_encode|e('html_attr') }}"
               data-url-colunas="{{ urlColunasLista }}"{% if colunasPadrao is not null %} data-colunas-padrao="{{ colunasPadrao|json_encode|e('html_attr') }}"{% endif %}{% if prefixoColunasLocal %} data-prefixo-colunas-local="{{ prefixoColunasLocal }}"{% endif %}>
            <colgroup>
                <col data-col="nup"><col data-col="cliente"><col data-col="reu"><col data-col="acao"><col data-col="prio">
                <col data-col="resp"><col data-col="metas"><col data-col="marc"><col data-col="sit">
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th data-col="nup" class="sortable {{ ordColVis == 'nup' ? ordDirVis }}" data-ordenar="nup" title="{{ 'expediente.lista.coluna_dica.nup'|trans }}"{{ tab.ariaSort('nup', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-upc me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.nup'|trans }}</span>{{ tab.seta('nup', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="cliente" class="sortable {{ ordColVis == 'cliente' ? ordDirVis }}" data-ordenar="cliente" title="{{ 'expediente.lista.coluna_dica.cliente'|trans }}"{{ tab.ariaSort('cliente', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-person me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.cliente'|trans }}</span>{{ tab.seta('cliente', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="reu" class="sortable col-reu-tabela {{ ordColVis == 'reu' ? ordDirVis }}" data-ordenar="reu" title="{{ 'expediente.lista.coluna_dica.reu'|trans }}"{{ tab.ariaSort('reu', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-person-x me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.reu'|trans }}</span>{{ tab.seta('reu', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="acao" class="sortable col-acao-tabela {{ ordColVis == 'acao' ? ordDirVis }}" data-ordenar="acao" title="{{ 'expediente.lista.coluna_dica.acao'|trans }}"{{ tab.ariaSort('acao', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-bank me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.acao'|trans }}</span>{{ tab.seta('acao', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="prio" class="sortable {{ ordColVis == 'prioridade' ? ordDirVis }}" data-ordenar="prioridade" title="{{ 'expediente.lista.coluna_dica.prioridade'|trans }}"{{ tab.ariaSort('prioridade', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-flag me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.prioridade'|trans }}</span>{{ tab.seta('prioridade', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="resp" class="sortable col-resp-tabela {{ ordColVis == 'responsavel' ? ordDirVis }}" data-ordenar="responsavel" title="{{ 'expediente.lista.coluna_dica.responsavel'|trans }}"{{ tab.ariaSort('responsavel', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-person-badge me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.responsavel'|trans }}</span>{{ tab.seta('responsavel', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="metas" class="col-tarefas-tabela" title="{{ 'expediente.lista.coluna_dica.metas'|trans }}"><span class="exp-th"><i class="bi bi-check2-square me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.metas'|trans }}</span></span></th>
                    <th data-col="marc" class="sortable col-marc-tabela {{ ordColVis == 'marcadores' ? ordDirVis }}" data-ordenar="marcadores" title="{{ 'expediente.lista.coluna_dica.marcadores'|trans }}"{{ tab.ariaSort('marcadores', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-tags me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.marcadores'|trans }}</span>{{ tab.seta('marcadores', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="sit" class="sortable {{ ordColVis == 'situacao' ? ordDirVis }}" data-ordenar="situacao" title="{{ 'expediente.lista.coluna_dica.situacao'|trans }}"{{ tab.ariaSort('situacao', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-circle-half me-1"></i><span class="exp-th-rot">{{ 'expediente.lista.coluna.situacao'|trans }}</span>{{ tab.seta('situacao', ordColVis, ordDirVis) }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for pasta in pastas %}
                {% set identificador = identificador_pasta(pasta) %}
                {% set nomeLinha = identificador ?: (pasta.clientes|length > 0 ? pasta.clientes|map(c => c.nomeExibicao)|join('; ') : '') %}
                {% set reus = reusPorPasta[pasta.id] ?? [] %}
                {% set cliPrin = pasta.clientePrincipal %}
                {% set rep = cliPrin ? (pastasPorCliente[cliPrin.id] ?? 0) : 0 %}
                {% set dest = destaques[pasta.id] ?? '' %}
                {% set sit = pasta.estaExcluida ? null : (SIT[pasta.situacao] ?? [pasta.situacao, '']) %}
                {% set cad = cadeados[pasta.id] ?? null %}
                {% set oculta = cad is not null and cad.nivel == 'oculto' %}
                {# D1: a linha da pasta oculta não diz a prioridade nem a situação (nem a lápide). #}
                <tr class="pasta-row-link{% if not oculta and pasta.prioridade.value == 'urgente' %} pasta-row-urgente{% endif %}{% if not oculta and pasta.estaExcluida %} pasta-excluida{% endif %}"
                    style="cursor:pointer;" data-href="{{ path('pasta_show', {id: pasta.id}) }}"
                    data-pasta-id="{{ pasta.id }}" data-nup="{{ pasta.nup }}" data-nome="{{ nomeLinha }}"
                    data-url-nome="{{ path(rotaPastaNome, {id: pasta.id}) }}"
                    data-url-trancar="{{ path(rotaPastaTrancar, {id: pasta.id}) }}"
                    data-url-destaque="{{ path(rotaPastaDestaque, {id: pasta.id}) }}"
                    data-trancada="{{ cad ? '1' : '0' }}" data-oculta="{{ oculta ? '1' : '0' }}"{% if oculta %} data-csrf-pedir="{{ csrf_token('pasta_acesso_' ~ pasta.id) }}"{% endif %}
                    data-nome-editavel="{{ identificador is not null and identificador != pasta.nomeCliente ? '0' : '1' }}"
                    {% if dest %}data-dest="{{ dest }}"{% endif %}>
                    <td data-col="nup" class="fw-semibold align-middle" data-favorito-celula="{{ pasta.id }}">
                        <span class="exp-nup">{% if favoritasIds[pasta.id] is defined %}<i class="bi bi-star-fill pasta-favorita-estrela me-1 js-pasta-tabela-favorita" data-pasta-id="{{ pasta.id }}" title="{{ 'expediente.lista.favorita'|trans }}" aria-label="{{ 'expediente.lista.favorita'|trans }}"></i>{% endif %}{{ pasta.nup }}</span>
                        {%- if cad %}
                            <i class="bi bi-lock exp-cadeado js-cadeado" aria-label="{{ 'expediente.lista.pasta_trancada'|trans }}"
                               data-tip="{{ cad.por ? 'expediente.lista.cadeado_dica_por'|trans({por: cad.por, em: cad.em}) : 'expediente.lista.cadeado_dica_primario'|trans({em: cad.em}) }}"></i>
                        {%- endif %}
                    </td>
                    <td data-col="cliente" class="align-middle exp-cel-cliente">
                        {# O NOME DA PASTA vem primeiro; o cliente cadastrado é o fallback (a ordenação por cliente usa a
                           mesma precedência, ver PastaRepository). #}
                        <span class="exp-cliente-linha">
                        {% if identificador %}
                            <span class="text-truncate js-nome-cliente" data-tip="{{ identificador }}">{{ identificador }}</span>
                        {% elseif pasta.clientes|length > 0 %}
                            {% if pasta.clientes|length == 1 %}
                                <span class="text-truncate js-nome-cliente" data-tip="{{ pasta.clientes[0].nomeExibicao }}">{{ pasta.clientes[0].nomeExibicao }}</span>
                            {% else %}
                                {%- set nomesClientes = pasta.clientes|map(c => c.nomeExibicao)|join('||') %}
                                <span class="clientes-resumo text-truncate js-nome-cliente"
                                      data-bs-placement="right"
                                      data-clientes="{{ nomesClientes }}">
                                    {{ pasta.clientes[0].nomeExibicao }}&hellip;
                                    <span class="badge text-bg-secondary ms-1" style="font-size:.65rem;">+{{ pasta.clientes|length - 1 }}</span>
                                </span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted js-nome-cliente">{{ 'expediente.lista.sem_cliente'|trans }}</span>
                        {% endif %}
                        {% if rep > 1 %}<span class="exp-rep" data-tip="{{ 'expediente.lista.repetidas_dica'|trans({n: rep ~ ''}) }}">{{ 'expediente.lista.repetidas'|trans({n: rep ~ ''}) }}</span>{% endif %}
                        </span>
                    </td>
                    {% if oculta %}
                    {# D1: da pasta oculta só ficam o número, o cliente e o cadeado. #}
                    <td data-col="reu" class="align-middle col-reu-tabela"></td>
                    <td data-col="acao" class="col-acao-tabela align-middle"></td>
                    <td data-col="prio" class="align-middle"></td>
                    <td data-col="resp" class="col-resp-tabela align-middle"></td>
                    <td data-col="metas" class="col-tarefas-tabela align-middle"></td>
                    <td data-col="marc" class="col-marc-tabela align-middle"></td>
                    <td data-col="sit" class="align-middle"></td>
                    {% else %}
                    <td data-col="reu" class="align-middle col-reu-tabela">
                        {% if reus is not empty %}
                            <span class="text-truncate d-block exp-reu" data-tip="{{ 1 < reus|length ? 'expediente.lista.reus_dica'|trans({reus: reus|join(' · ')}) : reus[0] }}">{{ reus[0] }}{{ reus|length > 1 ? ' ' ~ 'expediente.lista.reu_e_outros'|trans }}</span>
                        {% else %}
                            <span class="text-truncate d-block exp-reu exp-reu--vazio" data-tip="{{ 'expediente.lista.reu_vazio_dica'|trans }}">{{ 'expediente.lista.reu_vazio'|trans }}</span>
                        {% endif %}
                    </td>
                    <td data-col="acao" class="col-acao-tabela align-middle">
                        {% set acao = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso) : '') %}
                        <span class="text-truncate d-block" {% if acao %}data-tip="{{ acao }}"{% endif %}>{% if acao %}{{ acao }}{% else %}<span class="text-muted">{{ 'expediente.lista.acao_vazia'|trans }}</span>{% endif %}</span>
                    </td>
                    <td data-col="prio" class="align-middle" data-sort="{{ pasta.prioridade.value == 'urgente' ? 3 : (pasta.prioridade.value == 'prioridade' ? 2 : 1) }}">
                        <span class="badge exp-prio" data-prio="{{ pasta.prioridade.value }}" data-tip="{{ PRIO_TIP[pasta.prioridade.value] }}">
                            <i class="bi bi-flag-fill" aria-hidden="true"></i>{{ PRIO[pasta.prioridade.value] }}
                        </span>
                    </td>
                    <td data-col="resp" class="col-resp-tabela align-middle pasta-responsavel-cel" data-pasta-id="{{ pasta.id }}">
                        {{ include('pasta/_resp_chip.html.twig', {pasta: pasta, fotos: fotosResponsaveis, respContexto: 'expediente'}) }}
                    </td>
                    {# Metas (dc L.215, E12): número de metas ABERTAS, em azul, com a dica do desenho. Sem meta aberta, a
                       célula fica vazia: o dc mostra "–", e a regra do dono proíbe travessão em texto do sistema. #}
                    {% set metasAbertas = pasta.tarefas|filter(t => t.status != 'concluida')|length %}
                    <td data-col="metas" class="col-tarefas-tabela align-middle"{% if metasAbertas == 0 %} title="{{ 'expediente.lista.sem_metas'|trans }}"{% endif %}>
                        {% if metasAbertas > 0 %}
                            <a href="{{ path('pasta_show', {id: pasta.id}) }}#tarefas" class="badge exp-metas text-decoration-none"
                               data-metas="abertas" data-tip="{{ 'expediente.lista.metas_dica'|trans({n: metasAbertas ~ ''}) }}">
                                <i class="bi bi-check2-square me-1"></i>{{ metasAbertas }}
                            </a>
                        {% else %}
                            <span class="exp-sem-metas"><span class="visually-hidden">{{ 'expediente.lista.sem_metas'|trans }}</span></span>
                        {% endif %}
                    </td>
                    <td data-col="marc" class="col-marc-tabela pasta-marcadores-col align-middle" data-pasta-id="{{ pasta.id }}" data-sort="{{ 0 < pasta.marcadores|length ? (pasta.marcadores|first).nome : '' }}">
                        <div class="d-flex flex-nowrap gap-1 align-items-center">
                            {% if pasta.marcadores|length > 0 %}
                                {% set primeiro = pasta.marcadores|first %}
                                {% set corChip = primeiro.cor|cor_marcador %}
                                {%- set nomesMarcadores = pasta.marcadores|map(m => m.nome)|join(', ') %}
                                <button type="button" class="exp-chip-marc marcador-principal js-marc-pop" data-chip="1" style="--mk-cor: {{ corChip }};"
                                        data-tip="{{ primeiro.descricao ?: nomesMarcadores }}">
                                    <i class="bi bi-folder-fill" aria-hidden="true"></i><span>{{ primeiro.nome }}</span>
                                </button>
                                {% if pasta.marcadores|length > 1 %}
                                    {%- set marcadoresExtras = pasta.marcadores|slice(1)|map(m => {nome: m.nome, cor: m.cor|cor_marcador})|json_encode %}
                                    <span class="badge rounded-pill px-2 marcadores-extra"
                                          data-marcadores-json="{{ marcadoresExtras }}">
                                        +{{ pasta.marcadores|length - 1 }}
                                    </span>
                                {% endif %}
                            {% endif %}
                            {%- set idsMarcadores = pasta.marcadores|map(m => m.id)|join(',') %}
                            <button type="button"
                                    class="exp-tag-vazio js-marc-pop{% if 0 < pasta.marcadores|length %} is-escondido{% endif %}"
                                    data-tagvazio="1"
                                    data-pasta-id="{{ pasta.id }}"
                                    data-pasta-nome="{{ pasta.nup }}"
                                    data-marcadores-ativos="{{ idsMarcadores }}"
                                    data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}"
                                    data-url="{{ path(rotaPastaMarcadores, {id: pasta.id}) }}"
                                    data-tip="{{ 'expediente.lista.adicionar_marcador'|trans }}" aria-label="{{ 'expediente.lista.adicionar_marcador'|trans }}">
                                <i class="bi bi-tag" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                    <td data-col="sit" class="align-middle">
                        {% if pasta.estaExcluida %}
                            {# Sem js-toggle-situacao de propósito: o duplo-clique não pode ressuscitar uma pasta excluída. #}
                            <span class="badge text-bg-danger pasta-badge-excluida"
                                  title="{% if pasta.excluidaPor %}{{ 'expediente.lista.excluida_em_por'|trans({data: pasta.excluidaEm|data_hora, nome: pasta.excluidaPor.fullName}) }}{% else %}{{ 'expediente.lista.excluida_em'|trans({data: pasta.excluidaEm|data_hora}) }}{% endif %}">
                                {{ 'expediente.lista.excluida'|trans }}
                            </span>
                        {% elseif pasta.situacao in ['ativo', 'arquivado'] %}
                        <span class="badge js-toggle-situacao {{ pasta.situacao == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}"
                              style="cursor:pointer;user-select:none;"
                              data-situacao="{{ pasta.situacao }}"
                              data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}"
                              data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}"
                              data-tip="{{ 'expediente.lista.situacao_dica_alternar'|trans({situacao: sit[1], data: pasta.dataAbertura|data}) }}">
                            {{ sit[0] }}
                        </span>
                        {% else %}
                        <span class="badge exp-sit-fixa" data-situacao="{{ pasta.situacao }}" data-tip="{{ 'expediente.lista.situacao_dica_aberta'|trans({situacao: sit[1], data: pasta.dataAbertura|data}) }}">{{ sit[0] }}</span>
                        {% endif %}
                    </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── Lista (dc L.236-248): uma linha por pasta ── #}
<div class="exp-simples">
    {% for pasta in pastas %}
        {% set nomeLinha = identificador_pasta(pasta) ?: (pasta.clientes|length > 0 ? pasta.clientes[0].nomeExibicao : 'expediente.lista.sem_cliente'|trans) %}
        {% set acao = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.numeroProcesso) : '') %}
        {% set sitS = pasta.estaExcluida ? 'excluida' : pasta.situacao %}
        {% set cad = cadeados[pasta.id] ?? null %}
        {% set oculta = cad is not null and cad.nivel == 'oculto' %}
        {# `div` com data-href, como a linha da tabela: sem link nativo, o aviso de pasta trancada vale para todo clique. #}
        <div class="exp-simples-linha pasta-row-link{% if not oculta and pasta.estaExcluida %} pasta-excluida{% endif %}" data-href="{{ path('pasta_show', {id: pasta.id}) }}" role="link" tabindex="0" data-pasta-id="{{ pasta.id }}" data-trancada="{{ cad ? '1' : '0' }}" data-oculta="{{ oculta ? '1' : '0' }}"{% if oculta %} data-csrf-pedir="{{ csrf_token('pasta_acesso_' ~ pasta.id) }}"{% endif %} data-nup="{{ pasta.nup }}">
            {% if oculta %}<span class="exp-simples-ponto"></span>{% else %}<span class="exp-simples-ponto" data-situacao="{{ sitS }}" data-tip="{{ pasta.estaExcluida ? 'expediente.lista.excluida'|trans : (SIT[pasta.situacao][1] ?? '') }}"></span>{% endif %}
            <span class="exp-simples-nup">{{ pasta.nup }}</span>
            <span class="exp-simples-cli" data-tip="{{ nomeLinha }}">{{ nomeLinha }}</span>
            {% if oculta %}
            <span class="exp-simples-acao"><i class="bi bi-lock exp-cadeado" aria-label="{{ 'expediente.lista.pasta_trancada'|trans }}"></i></span>
            {% else %}
            <span class="exp-simples-acao" data-tip="{{ acao }}">{{ acao }}</span>
            {% set r = pasta.responsavel %}
            <span class="exp-simples-av{{ r ? '' : ' is-vazio' }}" data-tip="{{ r ? r.fullName : 'expediente.lista.sem_responsavel'|trans }}">{{ r ? (r.fullName|split(' ')|filter(p => p != '')|slice(0, 2)|map(p => p|first)|join|upper) : '?' }}</span>
            {% endif %}
        </div>
    {% endfor %}
</div>

{# ── Cartões e cartões grandes (dc L.249-260) — desktop nos modos de cartão, e sempre no celular ── #}
<div class="pastas-lista exp-cartoes">
    {% for pasta in pastas %}
        {% set nomeLinha = identificador_pasta(pasta) ?: (pasta.clientes|length > 0 ? pasta.clientes[0].nomeExibicao : 'expediente.lista.sem_cliente'|trans) %}
        {% set acao = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.numeroProcesso) : '') %}
        {% set r = pasta.responsavel %}
        {% set eFavorita = favoritasIds[pasta.id] is defined %}
        {% set cad = cadeados[pasta.id] ?? null %}
        {% set oculta = cad is not null and cad.nivel == 'oculto' %}
        {# `div` com data-href (como a linha da tabela): o cartão tem o botão da estrela dentro, e botão não vai em link.
           A estrela de favorito é só do BlueJus (o desenho não tem); lápide mostra só o indicador. #}
        <div class="exp-cartao pasta-card pasta-row-link{% if not oculta and pasta.estaExcluida %} pasta-excluida{% endif %}" data-href="{{ path('pasta_show', {id: pasta.id}) }}" data-pasta-id="{{ pasta.id }}" data-trancada="{{ cad ? '1' : '0' }}" data-oculta="{{ oculta ? '1' : '0' }}"{% if oculta %} data-csrf-pedir="{{ csrf_token('pasta_acesso_' ~ pasta.id) }}"{% endif %} data-nup="{{ pasta.nup }}">
            <span class="exp-cartao-topo pasta-card-topo">
                <span class="pasta-card-ident">
                    {% if oculta %}
                    {% elseif pasta.estaExcluida %}
                        {% if eFavorita %}<i class="bi bi-star-fill pasta-favorita-estrela" title="{{ 'expediente.lista.favorita'|trans }}" aria-label="{{ 'expediente.lista.favorita'|trans }}"></i>{% endif %}
                    {% else %}
                        <button type="button" class="pasta-card-fav js-pasta-card-favorito{{ eFavorita ? ' is-favorita' : '' }}"
                                aria-pressed="{{ eFavorita ? 'true' : 'false' }}"
                                aria-label="{{ eFavorita ? 'expediente.lista.favorito_tirar'|trans : 'expediente.lista.favorito_marcar'|trans }}"
                                title="{{ eFavorita ? 'expediente.lista.favorito_tirar'|trans : 'expediente.lista.favorito_marcar'|trans }}"
                                data-pasta-id="{{ pasta.id }}"
                                data-url="{{ path('pasta_favorito_alternar', {id: pasta.id}) }}"
                                data-csrf="{{ csrf_token('pasta_favorito_' ~ pasta.id) }}">
                            <i class="bi {{ eFavorita ? 'bi-star-fill' : 'bi-star' }}" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    <span class="exp-cartao-nup pasta-card-nup">{{ 'expediente.lista.cartao_pasta'|trans({nup: pasta.nup ~ ''}) }}{% if cad %} <i class="bi bi-lock exp-cadeado" aria-label="{{ 'expediente.lista.pasta_trancada'|trans }}"></i>{% endif %}</span>
                </span>
                {% if not oculta %}
                <span class="exp-cartao-vao"></span>
                <span class="exp-prio exp-prio--cartao" data-prio="{{ pasta.prioridade.value }}"><i class="bi bi-flag-fill" aria-hidden="true"></i>{{ PRIO[pasta.prioridade.value] }}</span>
                {% if pasta.estaExcluida %}
                    <span class="exp-sit-chip" data-situacao="excluida"><span class="exp-sit-chip-ponto"></span>{{ 'expediente.lista.excluida'|trans }}</span>
                {% else %}
                    <span class="exp-sit-chip" data-situacao="{{ pasta.situacao }}"><span class="exp-sit-chip-ponto"></span>{{ SIT[pasta.situacao][0] ?? pasta.situacao }}</span>
                {% endif %}
                {% endif %}
            </span>
            <span class="exp-cartao-cli" data-tip="{{ nomeLinha }}">{{ nomeLinha }}</span>
            {% if not oculta %}
            <span class="exp-cartao-acao" data-tip="{{ acao }}">{{ acao ?: 'expediente.lista.acao_vazia'|trans }}</span>
            <span class="exp-cartao-pe">
                <span class="exp-simples-av{{ r ? '' : ' is-vazio' }}">{{ r ? (r.fullName|split(' ')|filter(p => p != '')|slice(0, 2)|map(p => p|first)|join|upper) : '?' }}</span>
                <span class="exp-cartao-resp">{{ r ? r.fullName : 'expediente.lista.sem_responsavel'|trans }}</span>
                <span class="exp-cartao-vao"></span>
                {% if pasta.marcadores|length > 0 %}
                    {% set primeiro = pasta.marcadores|first %}
                    <span class="exp-chip-marc exp-chip-marc--cartao" style="--mk-cor: {{ primeiro.cor|cor_marcador }};">{{ primeiro.nome }}{% if pasta.marcadores|length > 1 %} +{{ pasta.marcadores|length - 1 }}{% endif %}</span>
                {% endif %}
            </span>
            {% endif %}
        </div>
    {% endfor %}
</div>

{{ include('pasta/_resp_menu.html.twig', {usuarios: usuarios, fotosResponsaveis: fotosResponsaveis|default({}), respContexto: 'expediente'}) }}
</div>{# /#pastasView #}
{% else %}
{% if resumoDemandas %}
{# Desenho 15 (dc L.644): sem demanda, o resumo continua e diz "Nenhuma demanda encontrada". #}
<div class="exp-topo exp-topo--vazio">
    <span class="exp-resumo"><i class="bi bi-list-ul" aria-hidden="true"></i>{{ 'pasta_lista.demandas.resumo_vazio'|trans }}</span>
</div>
{% endif %}
{# Vazio do desenho (dc L.214). #}
<div class="exp-vazio">
    <i class="bi bi-folder-x" aria-hidden="true"></i>
    {% if filters.busca or filters.status or filters.responsavel or filters.prioridade or filters.data_de or filters.data_ate %}
        {{ 'expediente.lista.vazio_filtros'|trans }}
    {% else %}
        {{ (vazioSemFiltro ?? 'expediente.lista.vazio')|trans }}
    {% endif %}
</div>
{% endif %}

<style>
/* ── Tabela desktop ──────────────────────────────────────────── */
#tabelaPastas { table-layout: fixed; width: 100%; min-width: 920px; }
#tabelaPastas thead th {
    white-space: nowrap;
    vertical-align: middle;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bs-secondary-color);
    border-bottom: 2px solid var(--bs-border-color);
    padding: 10px 10px;
}
#tabelaPastas tbody td {
    vertical-align: middle;
    font-size: 0.75rem;
    padding: 8px 10px;
    border-bottom: 1px solid var(--bs-border-color);
    text-transform: uppercase;
}
/* Respiro extra à direita da coluna Prioridade (rótulo encosta no vizinho) */
#tabelaPastas thead th[data-col="prio"],
#tabelaPastas tbody td[data-col="prio"] {
    padding-right: 14px;
}

/* Colunas centralizadas: Metas, Marcadores, Situação */
#tabelaPastas thead th.col-tarefas-tabela,
#tabelaPastas tbody td.col-tarefas-tabela,
#tabelaPastas thead th.col-marc-tabela,
#tabelaPastas tbody td.col-marc-tabela,
#tabelaPastas thead th[data-col="sit"],
#tabelaPastas tbody td:last-child {
    text-align: center;
}
#tabelaPastas tbody td.col-marc-tabela .d-flex {
    justify-content: center;
}
/* Marcadores numa só linha: chip principal trunca, badge +N e botão não encolhem */
#tabelaPastas tbody td.col-marc-tabela .marcador-principal {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#tabelaPastas tbody td.col-marc-tabela .marcadores-extra,
#tabelaPastas tbody td.col-marc-tabela .js-mover-para {
    flex-shrink: 0;
}
/* Respiro simétrico na última coluna (Situação) sem desalinhar o centro */
#tabelaPastas thead th:last-child,
#tabelaPastas tbody td:last-child { padding-left: 14px; padding-right: 14px; }
#tabelaPastas tbody tr:last-child td { border-bottom: none; }
#tabelaPastas tbody tr:hover { background: var(--bs-secondary-bg); }
.clientes-resumo { cursor: default; white-space: nowrap; }
.sortable { cursor: pointer; user-select: none; }
.sortable:hover { background-color: rgba(0,0,0,0.04); }
.sort-icon { font-size: 0.68em; opacity: 0.35; flex-shrink: 0; vertical-align: middle; margin-left: 2px; }
.sortable.asc .sort-icon, .sortable.desc .sort-icon { opacity: 1; color: #0d6efd; }

/* Ocultar colunas secundárias em telas médias */
@media (max-width: 900px) {
    .col-acao-tabela, .col-resp-tabela, .col-tarefas-tabela, .col-reu-tabela { display: none; }
}
@media (max-width: 768px) {
    .col-marc-tabela { display: none; }
}

/* ── Modo lista: cartões (desktop view=lista + mobile) ─────────── */
.pastas-lista { display: flex; flex-direction: column; gap: 10px; padding: 4px 2px; }

.pasta-card {
    position: relative;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 12px;
    padding: 12px 16px 12px 22px;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
    transition: box-shadow .15s, transform .05s;
    cursor: pointer;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.pasta-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.10); }
.pasta-card:active { transform: scale(.998); }
/* Barra lateral colorida pela prioridade */
.pasta-card::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 5px;
    background: var(--bs-secondary-color);
}
.pasta-card.pasta-prio-prioridade::before { background: var(--bs-warning); }
.pasta-card.pasta-prio-urgente::before {
    background: var(--bs-danger);
    animation: urgente-pulso 1.2s ease-in-out infinite;
}

.pasta-card-topo { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.pasta-card-ident { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
.pasta-favorita-estrela { color: #f0b400; font-size: .8rem; }
/* Estrela de favorito do cartão: convenção da estrela de linha do explorador (dc L.4743) —
   ligada #f0b400, desligada apagada, hover #e0a400. Área de toque de 32px no celular. */
.pasta-card-fav {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 24px; height: 24px; margin: -4px -6px -4px -4px; padding: 0; align-self: center;
    border: 0; border-radius: 4px; background: transparent; cursor: pointer;
    font-size: 13px; line-height: 1; color: #b4c2cc; opacity: .55;
    transition: color .15s, opacity .15s;
}
.pasta-card-fav:hover, .pasta-card-fav:focus-visible { color: #e0a400; opacity: 1; }
.pasta-card-fav:focus-visible { outline: 2px solid var(--bs-primary); outline-offset: 1px; }
.pasta-card-fav.is-favorita { color: #f0b400; opacity: 1; }
.pasta-card-fav[aria-busy="true"] { cursor: progress; opacity: .4; }
[data-bs-theme="dark"] .pasta-card-fav:not(.is-favorita) { color: #7d8f9b; }
@media (max-width: 767.98px) {
    .pasta-card-fav { width: 32px; height: 32px; margin: -8px -8px -8px -8px; font-size: 15px; }
}
.pasta-card-nup { font-weight: 600; font-size: .78rem; color: var(--bs-secondary-color); white-space: nowrap; }
.pasta-card-cliente {
    font-size: .95rem; font-weight: 600; color: var(--bs-body-color); text-transform: uppercase;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
/* Pasta excluída (lápide): continua na lista, riscada, para o número dela não sumir sem
   explicação. O risco vai no TEXTO das células, não na linha inteira, senão ele atravessa
   badge e foto de responsável — que não são texto e ficam ilegíveis. */
.pasta-excluida { opacity: .65; }
.pasta-excluida td:first-child,
.pasta-excluida td .text-truncate,
.pasta-excluida .pasta-card-cliente,
.pasta-excluida .pasta-card-nup { text-decoration: line-through; }
.pasta-badge-excluida { cursor: default; user-select: none; }

.pasta-card-flags { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.pasta-card-flags .badge { font-size: .72rem; }

.pasta-card-acao {
    font-size: .82rem; color: var(--bs-secondary-color); text-transform: uppercase;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.pasta-card-acoes { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.pasta-card-marc .d-flex { flex-wrap: wrap; }
.pasta-card-dias { font-size: .75rem; flex-shrink: 0; }

/* Toggle de view + "Ordenar por" */
.pasta-view-toggle .btn.active {
    background: var(--bs-secondary-bg);
    color: var(--bs-body-color);
    border-color: var(--bs-border-color);
}
.pasta-ordenar-wrap .js-pasta-ordenar { width: auto; min-width: 168px; border-radius: 20px; }

/* ── Alternância de layout ─────────────────────────────────────── */
/* Desktop: respeita a view escolhida */
@media (min-width: 768px) {
    .pastas-view--tabela .pastas-lista { display: none; }
    .pastas-view--lista  .pastas-tabela-wrap { display: none; }
    .pastas-view--tabela .pasta-ordenar-wrap { display: none; } /* ordena por cabeçalho na tabela */
}
/* Mobile: sempre cartões, nunca tabela; toggle escondido pelo d-none */
@media (max-width: 767.98px) {
    .pastas-tabela-wrap { display: none; }
}



/* Filtros responsivos */
@media (max-width: 575.98px) {
    #filtrosPasta .row > div { flex: 0 0 100%; max-width: 100%; }
}

/* ── Popover de marcadores extras ── */
.marcadores-popover-box {
    position: absolute;
    z-index: 9999;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    padding: 8px 10px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.13);
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 120px;
    max-width: 240px;
    pointer-events: none;
}
.marcadores-popover-badge {
    display: inline-block;
    border-radius: 20px;
    padding: 2px 10px;
