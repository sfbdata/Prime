{# Só os RESULTADOS da listagem de pastas. A barra de filtro fica em
   pasta/_filtros.html.twig (fora da área trocável). #}
{% import '_partials/_avatar_usuario.html.twig' as av %}
{% set filters = filters ?? {} %}
{% set responsaveis = responsaveis ?? [] %}
{% set usuarios = usuarios ?? responsaveis %}
{% set fotosResponsaveis = fotosResponsaveis ?? {} %}
{% set ordCol = ordenar ?? '' %}
{% set ordDir = (direcao ?? '') == 'asc' ? 'asc' : 'desc' %}
{# O que o cabeçalho mostra: sem ordenação escolhida vale a padrão do repositório, NUP decrescente. #}
{% set ordColVis = ordCol ?: 'nup' %}
{% set ordDirVis = ordCol ? ordDir : 'desc' %}
{% import _self as tab %}
{% macro seta(col, atual, dir) %}<i class="bi {{ col == atual ? (dir == 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-chevron-expand' }} sort-icon" aria-hidden="true"></i>{% endmacro %}
{% macro ariaSort(col, atual, dir) %}{% if col == atual %} aria-sort="{{ dir == 'asc' ? 'ascending' : 'descending' }}"{% endif %}{% endmacro %}
{# Favoritas do usuário logado (menu ⋮ da pasta → "Fixar nos favoritos"): uma consulta só,
   e a linha ganha a estrela. Quem as põe no topo é a ordenação do repositório. #}
{% set favoritasIds = pastas_favoritas_ids() %}

<style>
@keyframes urgente-pulso {
    0%, 100% { opacity: 1; }
    50%       { opacity: .35; }
}
.badge-urgente-pulso {
    animation: urgente-pulso 1.2s ease-in-out infinite;
}
</style>

{% if pastas|length > 0 %}
<div class="pastas-view pastas-view--tabela" id="pastasView">
{# Topo do resultado no desenho 1.1 (dc L.112-139, AUD-11/12): "Visualizar" e a paginação ficam na MESMA linha
   dos filtros, à direita, e o resumo vem sozinho embaixo. Os filtros moram fora desta área trocável
   (pasta/_filtros); no desktop o `.exp-topo` some da caixa (display: contents, expediente-lista.css) e os
   controles entram na faixa dos filtros. No celular (sem "Visualizar": sempre cartões) fica empilhado. #}
<div class="exp-topo">
    <div class="exp-controles">
        {# "Ordenar por" — só no modo lista (no desktop) e no mobile (nenhum tem cabeçalho de coluna) #}
        {# Mesma ordem que o cabeçalho mostra: sem escolha, a padrão (NUP decrescente). #}
        {% set ordAtual = ordColVis ~ '|' ~ ordDirVis %}
        <div class="pasta-ordenar-wrap">
            <select class="form-select form-select-sm js-pasta-ordenar" aria-label="Ordenar por" title="Ordenar por">
                <option value="" disabled>Ordenar por…</option>
                <option value="nup|asc"          {% if ordAtual == 'nup|asc' %}selected{% endif %}>NUP (crescente)</option>
                <option value="nup|desc"         {% if ordAtual == 'nup|desc' %}selected{% endif %}>NUP (decrescente)</option>
                <option value="cliente|asc"      {% if ordAtual == 'cliente|asc' %}selected{% endif %}>Cliente (A-Z)</option>
                <option value="cliente|desc"     {% if ordAtual == 'cliente|desc' %}selected{% endif %}>Cliente (Z-A)</option>
                <option value="prioridade|desc"  {% if ordAtual == 'prioridade|desc' %}selected{% endif %}>Prioridade (maior primeiro)</option>
                <option value="prioridade|asc"   {% if ordAtual == 'prioridade|asc' %}selected{% endif %}>Prioridade (menor primeiro)</option>
                <option value="acao|asc"         {% if ordAtual == 'acao|asc' %}selected{% endif %}>Ação (A-Z)</option>
                <option value="responsavel|asc"  {% if ordAtual == 'responsavel|asc' %}selected{% endif %}>Responsável (A-Z)</option>
                <option value="situacao|asc"     {% if ordAtual == 'situacao|asc' %}selected{% endif %}>Situação</option>
            </select>
        </div>
        {# "Visualizar" (dc L.151-169, E12): os 5 modos, "Pastas por página" e "Painel de marcadores". #}
        {% set porPaginaAtual = pagination.per_page ?? 50 %}
        <div class="exp-visualizar pasta-view-toggle d-none d-md-block">
            <button type="button" class="exp-visualizar-botao js-visualizar" aria-haspopup="menu" aria-expanded="false"
                    aria-controls="expVisualizarMenu" data-tip="Escolher como exibir as pastas">
                <i class="bi bi-list-columns-reverse js-visualizar-icone" aria-hidden="true"></i>Visualizar<i class="bi bi-chevron-down exp-visualizar-seta" aria-hidden="true"></i>
            </button>
            <div class="exp-visualizar-menu" id="expVisualizarMenu" role="menu" aria-label="Visualizar" hidden>
                {% for m in [
                    ['tabela', 'Detalhes', 'bi-list-columns-reverse', 'Tabela com todas as colunas'],
                    ['compacto', 'Detalhes compactos', 'bi-list-columns', 'Tabela com linhas mais baixas'],
                    ['simples', 'Lista', 'bi-list', 'Uma linha por pasta'],
                    ['lista', 'Cartões', 'bi-grid', 'Pastas em cartões'],
                    ['grandes', 'Cartões grandes', 'bi-grid-1x2', 'Cartões maiores, mais legíveis']
                ] %}
                <button type="button" class="exp-vis-item js-view-toggle" data-view="{{ m[0] }}" data-icone="{{ m[2] }}" role="menuitemradio" aria-checked="{{ m[0] == 'tabela' ? 'true' : 'false' }}" data-tip="{{ m[3] }}">
                    <span class="exp-vis-ponto" aria-hidden="true"></span><i class="bi {{ m[2] }}" aria-hidden="true"></i>{{ m[1] }}
                </button>
                {% endfor %}
                <div class="exp-vis-sep" role="separator"></div>
                <div class="exp-vis-titulo">Pastas por página</div>
                <div class="exp-vis-porpag" role="group" aria-label="Pastas por página">
                    {% for n in [25, 50, 100] %}
                        <button type="button" class="exp-vis-pp js-por-pagina{{ n == porPaginaAtual ? ' is-atual' }}" data-n="{{ n }}" aria-pressed="{{ n == porPaginaAtual ? 'true' : 'false' }}">{{ n }}</button>
                    {% endfor %}
                </div>
                <div class="exp-vis-sep" role="separator"></div>
                <button type="button" class="exp-vis-item js-vis-painel" role="menuitemcheckbox" aria-checked="true">
                    <span class="exp-vis-ponto" aria-hidden="true"></span><i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i>Painel de marcadores
                </button>
            </div>
        </div>
        {% if pagination is defined and pagination is not null %}
            {{ include('expediente/_paginacao.html.twig') }}
        {% endif %}
    </div>
    {# Resumo do desenho (dc L.139, `resumo` em L.455): o INTERVALO de pastas desta página ("1 de 50"; na
       segunda, "51 de 100") e o total da consulta inteira, separados por espaços largos (U+2003). A E8 lia
       "página de N" (AUD-14). #}
    {# Linha do resumo (dc L.178-182): botão de colunas (clique e botão direito) e o resumo. #}
    <span class="exp-resumo">
        <button type="button" class="exp-colunas js-colunas" data-url-csv="{{ path('expediente_exportar_csv') }}" data-tip="Colunas da tabela" aria-label="Colunas da tabela" aria-haspopup="menu"><i class="bi bi-layout-three-columns" aria-hidden="true"></i></button>
        <i class="bi bi-list-ul" aria-hidden="true"></i>
        {%- if pagination is defined and pagination is not null %}
            {%- set primeiraDaPagina = (pagination.current_page - 1) * pagination.per_page + 1 %}
            {{ primeiraDaPagina|number_format(0, ',', '.') }} de {{ (primeiraDaPagina + pastas|length - 1)|number_format(0, ',', '.') }}&#8195;·&#8195;Total: {{ pagination.total_items|number_format(0, ',', '.') }} pasta{{ pagination.total_items != 1 ? 's' : '' }}
        {%- else %}
            {{ pastas|length }} pasta{{ pastas|length != 1 ? 's' : '' }}
        {%- endif %}
    </span>
</div>

{# ── Tabela (dc L.190-234, E12) ─────────────────────────────────────────
   Colunas do 1.1: NUP · Cliente · Réu · Ação · Prioridade · Responsável · Metas · Marcadores · Situação. Cada
   <col>, <th> e <td> leva `data-col`: o menu de colunas esconde por ele (expediente-lista.js). A linha leva o que
   o menu de botão direito precisa (id, número, nome, trancada, destaque) e as cores do destaque do usuário. #}
{% set PRIO = {normal: 'Normal', prioridade: 'Alta', urgente: 'Urgente'} %}
{% set PRIO_TIP = {normal: 'Prioridade normal: segue o fluxo padrão', prioridade: 'Prioridade alta: tratar antes das demais', urgente: 'Urgente: exige providência imediata'} %}
{% set SIT = {ativo: ['Ativo', 'Pasta em andamento'], suspenso: ['Suspenso', 'Andamento suspenso temporariamente'], cancelado: ['Cancelado', 'Pasta cancelada'], arquivado: ['Arquivado', 'Pasta encerrada e arquivada']} %}
{% set reusPorPasta = reusPorPasta ?? {} %}
{% set pastasPorCliente = pastasPorCliente ?? {} %}
{% set destaques = destaques ?? {} %}
<div class="pastas-tabela-wrap card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover mb-0" id="tabelaPastas" data-csrf-lista="{{ csrfLista ?? '' }}" data-sou-admin="{{ (souAdministrador ?? false) ? '1' : '0' }}"
               data-chave-colunas="{{ (current_tenant() ? current_tenant().id : 0) ~ ':' ~ (app.user ? app.user.id : 0) }}">
            <colgroup>
                <col data-col="nup"><col data-col="cliente"><col data-col="reu"><col data-col="acao"><col data-col="prio">
                <col data-col="resp"><col data-col="metas"><col data-col="marc"><col data-col="sit">
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th data-col="nup" class="sortable {{ ordColVis == 'nup' ? ordDirVis }}" data-ordenar="nup" title="Número único da pasta"{{ tab.ariaSort('nup', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-upc me-1"></i><span class="exp-th-rot">NUP</span>{{ tab.seta('nup', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="cliente" class="sortable {{ ordColVis == 'cliente' ? ordDirVis }}" data-ordenar="cliente" title="Ordenar por cliente"{{ tab.ariaSort('cliente', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-person me-1"></i><span class="exp-th-rot">Cliente</span>{{ tab.seta('cliente', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="reu" class="sortable col-reu-tabela {{ ordColVis == 'reu' ? ordDirVis }}" data-ordenar="reu" title="Parte adversa · ordenar por réu"{{ tab.ariaSort('reu', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-person-x me-1"></i><span class="exp-th-rot">Réu</span>{{ tab.seta('reu', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="acao" class="sortable col-acao-tabela {{ ordColVis == 'acao' ? ordDirVis }}" data-ordenar="acao" title="Ordenar por ação"{{ tab.ariaSort('acao', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-bank me-1"></i><span class="exp-th-rot">Ação</span>{{ tab.seta('acao', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="prio" class="sortable {{ ordColVis == 'prioridade' ? ordDirVis }}" data-ordenar="prioridade" title="Ordenar por prioridade"{{ tab.ariaSort('prioridade', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-flag me-1"></i><span class="exp-th-rot">Prioridade</span>{{ tab.seta('prioridade', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="resp" class="sortable col-resp-tabela {{ ordColVis == 'responsavel' ? ordDirVis }}" data-ordenar="responsavel" title="Ordenar por responsável"{{ tab.ariaSort('responsavel', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-person-badge me-1"></i><span class="exp-th-rot">Responsável</span>{{ tab.seta('responsavel', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="metas" class="col-tarefas-tabela" title="Metas abertas na pasta"><span class="exp-th"><i class="bi bi-check2-square me-1"></i><span class="exp-th-rot">Metas</span></span></th>
                    <th data-col="marc" class="sortable col-marc-tabela {{ ordColVis == 'marcadores' ? ordDirVis }}" data-ordenar="marcadores" title="Ordenar por marcador"{{ tab.ariaSort('marcadores', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-tags me-1"></i><span class="exp-th-rot">Marcadores</span>{{ tab.seta('marcadores', ordColVis, ordDirVis) }}</span></th>
                    <th data-col="sit" class="sortable {{ ordColVis == 'situacao' ? ordDirVis }}" data-ordenar="situacao" title="Ordenar por situação"{{ tab.ariaSort('situacao', ordColVis, ordDirVis) }}><span class="exp-th"><i class="bi bi-circle-half me-1"></i><span class="exp-th-rot">Situação</span>{{ tab.seta('situacao', ordColVis, ordDirVis) }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for pasta in pastas %}
                {% set identificador = identificador_pasta(pasta) %}
                {% set nomeLinha = identificador ?: (pasta.clientes|length > 0 ? pasta.clientes|map(c => c.nomeExibicao)|join('; ') : '') %}
                {% set reus = reusPorPasta[pasta.id] ?? [] %}
                {% set cliPrin = pasta.clientePrincipal %}
                {% set rep = cliPrin ? (pastasPorCliente[cliPrin.id] ?? 0) : 0 %}
                {% set dest = destaques[pasta.id] ?? '' %}
                {% set sit = pasta.estaExcluida ? null : (SIT[pasta.situacao] ?? [pasta.situacao, '']) %}
                <tr class="pasta-row-link{% if pasta.prioridade.value == 'urgente' %} pasta-row-urgente{% endif %}{% if pasta.estaExcluida %} pasta-excluida{% endif %}"
                    style="cursor:pointer;" data-href="{{ path('pasta_show', {id: pasta.id}) }}"
                    data-pasta-id="{{ pasta.id }}" data-nup="{{ pasta.nup }}" data-nome="{{ nomeLinha }}"
                    data-url-nome="{{ path('expediente_pasta_nome', {id: pasta.id}) }}"
                    data-url-trancar="{{ path('expediente_pasta_trancar', {id: pasta.id}) }}"
                    data-url-destaque="{{ path('expediente_pasta_destaque', {id: pasta.id}) }}"
                    data-trancada="{{ pasta.estaTrancada ? '1' : '0' }}"
                    data-nome-editavel="{{ identificador is not null and identificador != pasta.nomeCliente ? '0' : '1' }}"
                    {% if dest %}data-dest="{{ dest }}"{% endif %}>
                    <td data-col="nup" class="fw-semibold align-middle" data-favorito-celula="{{ pasta.id }}">
                        <span class="exp-nup">{% if favoritasIds[pasta.id] is defined %}<i class="bi bi-star-fill pasta-favorita-estrela me-1 js-pasta-tabela-favorita" data-pasta-id="{{ pasta.id }}" title="Fixada nos favoritos" aria-label="Fixada nos favoritos"></i>{% endif %}{{ pasta.nup }}</span>
                        {%- if pasta.estaTrancada %}
                            <i class="bi bi-lock exp-cadeado js-cadeado" aria-label="Pasta trancada"
                               data-tip="Documentos sigilosos · pasta trancada{{ pasta.trancadaPor ? ' por ' ~ pasta.trancadaPor.fullName : ' pelo usuário primário' }}{{ pasta.trancadaEm ? ' em ' ~ pasta.trancadaEm|date('d/m/Y') }}"></i>
                        {%- endif %}
                    </td>
                    <td data-col="cliente" class="align-middle exp-cel-cliente">
                        {# O NOME DA PASTA vem primeiro; o cliente cadastrado é o fallback (a ordenação por cliente usa a
                           mesma precedência, ver PastaRepository). #}
                        <span class="exp-cliente-linha">
                        {% if identificador %}
                            <span class="text-truncate js-nome-cliente" data-tip="{{ identificador }}">{{ identificador }}</span>
                        {% elseif pasta.clientes|length > 0 %}
                            {% if pasta.clientes|length == 1 %}
                                <span class="text-truncate js-nome-cliente" data-tip="{{ pasta.clientes[0].nomeExibicao }}">{{ pasta.clientes[0].nomeExibicao }}</span>
                            {% else %}
                                <span class="clientes-resumo text-truncate js-nome-cliente"
                                      data-bs-placement="right"
                                      data-clientes="{{ pasta.clientes|map(c => c.nomeExibicao)|join('||') }}">
                                    {{ pasta.clientes[0].nomeExibicao }}&hellip;
                                    <span class="badge text-bg-secondary ms-1" style="font-size:.65rem;">+{{ pasta.clientes|length - 1 }}</span>
                                </span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted js-nome-cliente">Sem cliente</span>
                        {% endif %}
                        {% if rep > 1 %}<span class="exp-rep" data-tip="{{ rep }} pastas com o mesmo nome e CPF">{{ rep }}x</span>{% endif %}
                        </span>
                    </td>
                    <td data-col="reu" class="align-middle col-reu-tabela">
                        {% if reus is not empty %}
                            <span class="text-truncate d-block exp-reu" data-tip="{{ reus|length > 1 ? 'Réus: ' ~ reus|join(' · ') : reus[0] }}">{{ reus[0] }}{{ reus|length > 1 ? ' e outros' }}</span>
                        {% else %}
                            <span class="text-truncate d-block exp-reu exp-reu--vazio" data-tip="Réu não informado no cadastro da pasta">Não informado</span>
                        {% endif %}
                    </td>
                    <td data-col="acao" class="col-acao-tabela align-middle">
                        {% set acao = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.assuntoProcessual ?: pasta.processoPrincipal.numeroProcesso) : '') %}
                        <span class="text-truncate d-block" {% if acao %}data-tip="{{ acao }}"{% endif %}>{% if acao %}{{ acao }}{% else %}<span class="text-muted">Não informada</span>{% endif %}</span>
                    </td>
                    <td data-col="prio" class="align-middle" data-sort="{{ pasta.prioridade.value == 'urgente' ? 3 : (pasta.prioridade.value == 'prioridade' ? 2 : 1) }}">
                        <span class="badge exp-prio" data-prio="{{ pasta.prioridade.value }}" data-tip="{{ PRIO_TIP[pasta.prioridade.value] }}">
                            <i class="bi bi-flag-fill" aria-hidden="true"></i>{{ PRIO[pasta.prioridade.value] }}
                        </span>
                    </td>
                    <td data-col="resp" class="col-resp-tabela align-middle pasta-responsavel-cel" data-pasta-id="{{ pasta.id }}">
                        {{ include('pasta/_resp_chip.html.twig', {pasta: pasta, fotos: fotosResponsaveis, respContexto: 'expediente'}) }}
                    </td>
                    {# Metas (dc L.215, E12): número de metas ABERTAS, em azul, com a dica do desenho. Sem meta aberta, a
                       célula fica vazia: o dc mostra "–", e a regra do dono proíbe travessão em texto do sistema. #}
                    {% set metasAbertas = pasta.tarefas|filter(t => t.status != 'concluida')|length %}
                    <td data-col="metas" class="col-tarefas-tabela align-middle"{% if metasAbertas == 0 %} title="Sem metas abertas"{% endif %}>
                        {% if metasAbertas > 0 %}
                            <a href="{{ path('pasta_show', {id: pasta.id}) }}#tarefas" class="badge exp-metas text-decoration-none"
                               data-metas="abertas" data-tip="{{ metasAbertas }} meta(s) aberta(s) nesta pasta">
                                <i class="bi bi-check2-square me-1"></i>{{ metasAbertas }}
                            </a>
                        {% else %}
                            <span class="exp-sem-metas"><span class="visually-hidden">Sem metas abertas</span></span>
                        {% endif %}
                    </td>
                    <td data-col="marc" class="col-marc-tabela pasta-marcadores-col align-middle" data-pasta-id="{{ pasta.id }}" data-sort="{{ pasta.marcadores|length > 0 ? (pasta.marcadores|first).nome : '' }}">
                        <div class="d-flex flex-nowrap gap-1 align-items-center">
                            {% if pasta.marcadores|length > 0 %}
                                {% set primeiro = pasta.marcadores|first %}
                                {% set corChip = primeiro.cor|cor_marcador %}
                                <button type="button" class="exp-chip-marc marcador-principal js-marc-pop" data-chip="1" style="--mk-cor: {{ corChip }};"
                                        data-tip="{{ primeiro.descricao ?: pasta.marcadores|map(m => m.nome)|join(', ') }}">
                                    <i class="bi bi-folder-fill" aria-hidden="true"></i><span>{{ primeiro.nome }}</span>
                                </button>
                                {% if pasta.marcadores|length > 1 %}
                                    <span class="badge rounded-pill px-2 marcadores-extra"
                                          data-marcadores-json="{{ pasta.marcadores|slice(1)|map(m => {nome: m.nome, cor: m.cor|cor_marcador})|json_encode }}">
                                        +{{ pasta.marcadores|length - 1 }}
                                    </span>
                                {% endif %}
                            {% endif %}
                            <button type="button"
                                    class="exp-tag-vazio js-marc-pop{% if pasta.marcadores|length > 0 %} is-escondido{% endif %}"
                                    data-tagvazio="1"
                                    data-pasta-id="{{ pasta.id }}"
                                    data-pasta-nome="{{ pasta.nup }}"
                                    data-marcadores-ativos="{{ pasta.marcadores|map(m => m.id)|join(',') }}"
                                    data-csrf-token="{{ csrf_token('pasta_marcadores_' ~ pasta.id) }}"
                                    data-url="{{ path('expediente_pasta_marcadores', {id: pasta.id}) }}"
                                    data-tip="Adicionar marcador" aria-label="Adicionar marcador">
                                <i class="bi bi-tag" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                    <td data-col="sit" class="align-middle">
                        {% if pasta.estaExcluida %}
                            {# Sem js-toggle-situacao de propósito: o duplo-clique não pode ressuscitar uma pasta excluída. #}
                            <span class="badge text-bg-danger pasta-badge-excluida"
                                  title="Excluída em {{ pasta.excluidaEm|date('d/m/Y H:i') }}{% if pasta.excluidaPor %} por {{ pasta.excluidaPor.fullName }}{% endif %}">
                                Excluída
                            </span>
                        {% elseif pasta.situacao in ['ativo', 'arquivado'] %}
                        <span class="badge js-toggle-situacao {{ pasta.situacao == 'ativo' ? 'text-bg-success' : 'text-bg-secondary' }}"
                              style="cursor:pointer;user-select:none;"
                              data-situacao="{{ pasta.situacao }}"
                              data-url="{{ path('pasta_alternar_situacao', {id: pasta.id}) }}"
                              data-csrf="{{ csrf_token('pasta_alternar_situacao_' ~ pasta.id) }}"
                              data-tip="{{ sit[1] }} · aberta em {{ pasta.dataAbertura|date('d/m/Y') }} · duplo clique alterna entre ativo e arquivado">
                            {{ sit[0] }}
                        </span>
                        {% else %}
                        <span class="badge exp-sit-fixa" data-situacao="{{ pasta.situacao }}" data-tip="{{ sit[1] }} · aberta em {{ pasta.dataAbertura|date('d/m/Y') }}">{{ sit[0] }}</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── Lista (dc L.236-248): uma linha por pasta ── #}
<div class="exp-simples">
    {% for pasta in pastas %}
        {% set nomeLinha = identificador_pasta(pasta) ?: (pasta.clientes|length > 0 ? pasta.clientes[0].nomeExibicao : 'Sem cliente') %}
        {% set acao = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.numeroProcesso) : '') %}
        {% set sitS = pasta.estaExcluida ? 'excluida' : pasta.situacao %}
        {# `div` com data-href, como a linha da tabela: sem link nativo, o aviso de pasta trancada vale para todo clique. #}
        <div class="exp-simples-linha pasta-row-link{% if pasta.estaExcluida %} pasta-excluida{% endif %}" data-href="{{ path('pasta_show', {id: pasta.id}) }}" role="link" tabindex="0" data-pasta-id="{{ pasta.id }}" data-trancada="{{ pasta.estaTrancada ? '1' : '0' }}" data-nup="{{ pasta.nup }}">
            <span class="exp-simples-ponto" data-situacao="{{ sitS }}" data-tip="{{ pasta.estaExcluida ? 'Excluída' : (SIT[pasta.situacao][1] ?? '') }}"></span>
            <span class="exp-simples-nup">{{ pasta.nup }}</span>
            <span class="exp-simples-cli" data-tip="{{ nomeLinha }}">{{ nomeLinha }}</span>
            <span class="exp-simples-acao" data-tip="{{ acao }}">{{ acao }}</span>
            {% set r = pasta.responsavel %}
            <span class="exp-simples-av{{ r ? '' : ' is-vazio' }}" data-tip="{{ r ? r.fullName : 'Sem responsável' }}">{{ r ? (r.fullName|split(' ')|filter(p => p != '')|slice(0, 2)|map(p => p|first)|join|upper) : '?' }}</span>
        </div>
    {% endfor %}
</div>

{# ── Cartões e cartões grandes (dc L.249-260) — desktop nos modos de cartão, e sempre no celular ── #}
<div class="pastas-lista exp-cartoes">
    {% for pasta in pastas %}
        {% set nomeLinha = identificador_pasta(pasta) ?: (pasta.clientes|length > 0 ? pasta.clientes[0].nomeExibicao : 'Sem cliente') %}
        {% set acao = pasta.nomeAcao ?: (pasta.processoPrincipal ? (pasta.processoPrincipal.classeProcessual ?: pasta.processoPrincipal.numeroProcesso) : '') %}
        {% set r = pasta.responsavel %}
        {% set eFavorita = favoritasIds[pasta.id] is defined %}
        {# `div` com data-href (como a linha da tabela): o cartão tem o botão da estrela dentro, e botão não vai em link.
           A estrela de favorito é só do BlueJus (o desenho não tem); lápide mostra só o indicador. #}
        <div class="exp-cartao pasta-card pasta-row-link{% if pasta.estaExcluida %} pasta-excluida{% endif %}" data-href="{{ path('pasta_show', {id: pasta.id}) }}" data-pasta-id="{{ pasta.id }}" data-trancada="{{ pasta.estaTrancada ? '1' : '0' }}" data-nup="{{ pasta.nup }}">
            <span class="exp-cartao-topo pasta-card-topo">
                <span class="pasta-card-ident">
                    {% if pasta.estaExcluida %}
                        {% if eFavorita %}<i class="bi bi-star-fill pasta-favorita-estrela" title="Fixada nos favoritos" aria-label="Fixada nos favoritos"></i>{% endif %}
                    {% else %}
                        <button type="button" class="pasta-card-fav js-pasta-card-favorito{{ eFavorita ? ' is-favorita' : '' }}"
                                aria-pressed="{{ eFavorita ? 'true' : 'false' }}"
                                aria-label="{{ eFavorita ? 'Tirar dos favoritos' : 'Marcar como favorito' }}"
                                title="{{ eFavorita ? 'Tirar dos favoritos' : 'Marcar como favorito' }}"
                                data-pasta-id="{{ pasta.id }}"
                                data-url="{{ path('pasta_favorito_alternar', {id: pasta.id}) }}"
                                data-csrf="{{ csrf_token('pasta_favorito_' ~ pasta.id) }}">
                            <i class="bi {{ eFavorita ? 'bi-star-fill' : 'bi-star' }}" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    <span class="exp-cartao-nup pasta-card-nup">PASTA {{ pasta.nup }}{% if pasta.estaTrancada %} <i class="bi bi-lock exp-cadeado" aria-label="Pasta trancada"></i>{% endif %}</span>
                </span>
                <span class="exp-cartao-vao"></span>
                <span class="exp-prio exp-prio--cartao" data-prio="{{ pasta.prioridade.value }}"><i class="bi bi-flag-fill" aria-hidden="true"></i>{{ PRIO[pasta.prioridade.value] }}</span>
