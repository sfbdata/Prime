<script>
(function () {
    /* E12: os 5 modos do desenho (dc `visOpcoes`), com chave própria (a tela Pastas segue com `pastasView`).
       tabela e compacto são a tabela (compacto com linhas baixas); simples é a lista de uma linha; lista e
       grandes são os cartões. Quem vinha do `pastasView` = 'lista' continua nos cartões. */
    var STORAGE_KEY = 'expediente_modo';
    var MODOS = { tabela: 'bi-list-columns-reverse', compacto: 'bi-list-columns', simples: 'bi-list', lista: 'bi-grid', grandes: 'bi-grid-1x2' };
    function aplicarView(view) {
        var wrap = document.getElementById('pastasView');
        if (!wrap) return;
        if (!MODOS[view]) view = 'tabela';
        var cartoes = view === 'lista' || view === 'grandes';
        wrap.classList.toggle('pastas-view--lista', cartoes);
        wrap.classList.toggle('pastas-view--tabela', view === 'tabela' || view === 'compacto');
        wrap.classList.toggle('pastas-view--simples', view === 'simples');
        wrap.classList.toggle('pastas-view--compacto', view === 'compacto');
        wrap.classList.toggle('pastas-view--grandes', view === 'grandes');
        wrap.setAttribute('data-modo', view);
        wrap.querySelectorAll('.js-view-toggle').forEach(function (b) {
            b.classList.toggle('active', b.dataset.view === view);
            b.setAttribute('aria-checked', b.dataset.view === view ? 'true' : 'false');
        });
        var icone = wrap.querySelector('.js-visualizar-icone');
        if (icone) { icone.className = 'bi ' + MODOS[view] + ' js-visualizar-icone'; }
    }
    var salvo = null;
    try { salvo = localStorage.getItem(STORAGE_KEY) || (localStorage.getItem('pastasView') === 'lista' ? 'lista' : null); } catch (e) { /* indisponível */ }
    aplicarView(salvo || 'tabela');
    /* Estrela de favorito do cartão: mesmo endpoint e mesmo contrato do menu ⋮ da pasta
       (`pasta_favorito_alternar` → `{favorita: bool}`). O estado mostrado espelha a RESPOSTA,
       não o clique — se o POST falhar, fica o gravado. Delegado no document uma vez só. */
    if (!document.__pastaCardFavoritoBound) {
        document.__pastaCardFavoritoBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.js-pasta-card-favorito');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            if (btn.getAttribute('aria-busy') === 'true') return;
            btn.setAttribute('aria-busy', 'true');

            var corpo = new FormData();
            corpo.append('_token', btn.dataset.csrf);

            fetch(btn.dataset.url, {
                method: 'POST',
                body: corpo,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            })
                .then(function (r) {
                    return r.json().then(function (d) { return { ok: r.ok, dados: d }; });
                })
                .then(function (r) {
                    if (!r.ok || typeof r.dados.favorita !== 'boolean') {
                        window.alert((r.dados && (r.dados.erro || r.dados.mensagem)) || 'Não foi possível alterar os favoritos.');
                        return;
                    }
                    var on = r.dados.favorita;
                    var rotulo = on ? 'Tirar dos favoritos' : 'Marcar como favorito';
                    document.querySelectorAll('.js-pasta-card-favorito[data-pasta-id="' + btn.dataset.pastaId + '"]').forEach(function (b) {
                        b.classList.toggle('is-favorita', on);
                        b.setAttribute('aria-pressed', on ? 'true' : 'false');
                        b.setAttribute('aria-label', rotulo);
                        b.title = rotulo;
                        var ic = b.querySelector('i');
                        if (ic) { ic.className = 'bi ' + (on ? 'bi-star-fill' : 'bi-star'); }
                    });
                    /* O indicador da linha da TABELA (mesma pasta) acompanha: nasce ao ligar,
                       sai ao desligar — como o servidor o renderiza (só na favorita). */
                    document.querySelectorAll('td[data-favorito-celula="' + btn.dataset.pastaId + '"]').forEach(function (celula) {
                        var ind = celula.querySelector('.js-pasta-tabela-favorita');
                        if (on && !ind) {
                            ind = document.createElement('i');
                            ind.className = 'bi bi-star-fill pasta-favorita-estrela me-1 js-pasta-tabela-favorita';
                            ind.dataset.pastaId = btn.dataset.pastaId;
                            ind.title = 'Fixada nos favoritos';
                            ind.setAttribute('aria-label', 'Fixada nos favoritos');
                            celula.insertBefore(ind, celula.firstChild);
                        } else if (!on && ind) {
                            ind.remove();
                        }
                    });
                })
                .catch(function () { window.alert('Erro de comunicação. Tente novamente.'); })
                .then(function () { btn.removeAttribute('aria-busy'); });
        });
    }

    /* Handler do toggle ligado uma única vez no document (guarda evita empilhar,
       já que este script re-executa a cada troca de resultados). */
    if (!document.__expModoBound) {
        document.__expModoBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.js-view-toggle');
            if (!btn) return;
            var view = MODOS[btn.dataset.view] ? btn.dataset.view : 'tabela';
            try { localStorage.setItem(STORAGE_KEY, view); } catch (err) { /* ignora */ }
            aplicarView(view);
        });
    }
}());
</script>
