{% extends 'admin/platform/_base_platform.html.twig' %}

{% block title %}{{ 'plataforma.convites.titulo'|trans({termo: 'termos.master'|trans}) }}{% endblock %}

{% block platform_body %}
<div class="container py-4">
    <h1 class="h3 mb-4">{{ 'plataforma.convites.titulo'|trans({termo: 'termos.master'|trans}) }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'sucesso' ? 'success' : (type == 'erro' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card mb-4">
        <div class="card-header fw-semibold">{{ 'plataforma.convites.novo'|trans }}</div>
        <div class="card-body">
            <form method="post" action="{{ path('admin_platform_convite_criar') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('convite_novo') }}">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="email">{{ 'plataforma.convites.email'|trans }} <span class="text-danger">*</span></label>
                        <input type="email" id="email" name="email" class="form-control" required maxlength="180">
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="full_name">{{ 'plataforma.convites.nome_opcional'|trans }}</label>
                        <input type="text" id="full_name" name="full_name" class="form-control" maxlength="255">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">{{ 'plataforma.convites.convidar'|trans }}</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">{{ 'plataforma.convites.enviados'|trans }}</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'plataforma.convites.email'|trans }}</th>
                        <th>{{ 'plataforma.convites.nome'|trans }}</th>
                        <th>{{ 'plataforma.convites.status'|trans }}</th>
                        <th>{{ 'plataforma.convites.enviado_em'|trans }}</th>
                        <th>{{ 'plataforma.convites.expira_em'|trans }}</th>
                        <th>{{ 'plataforma.convites.reenvios'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for convite in convites %}
                    <tr>
                        <td>{{ convite.email }}</td>
                        <td>{{ convite.nomeConvidado ?? 'plataforma.convites.sem_informacao'|trans }}</td>
                        <td>
                            {% if convite.status == 'pending' %}
                                <span class="badge bg-warning text-dark">{{ 'plataforma.convites.pendente'|trans }}</span>
                            {% elseif convite.status == 'accepted' %}
                                <span class="badge bg-success">{{ 'plataforma.convites.aceito'|trans }}</span>
                            {% elseif convite.status == 'revoked' %}
                                <span class="badge bg-secondary">{{ 'plataforma.convites.revogado'|trans }}</span>
                            {% elseif convite.status == 'expired' %}
                                <span class="badge bg-dark">{{ 'plataforma.convites.expirado'|trans }}</span>
                            {% else %}
                                <span class="badge bg-body-tertiary text-dark">{{ convite.status }}</span>
                            {% endif %}
                        </td>
                        <td>{{ convite.createdAt|data_hora }}</td>
                        <td>{{ convite.expiresAt|data_hora }}</td>
                        <td>{{ convite.reenvioCount }}/3</td>
                        <td class="text-end">
                            {% if convite.status == 'pending' %}
                                {% if convite.podeReenviar %}
                                    {# data-confirmar: a pergunta sai do JavaScript inline (menu-usuario.js; achado de auditoria interna F3). #}
                                    <form method="post" action="{{ path('admin_platform_convite_reenviar', {id: convite.id}) }}" class="d-inline"
                                          data-confirmar="{{ 'plataforma.convites.confirmar_reenviar'|trans({email: convite.email}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('convite_reenviar_' ~ convite.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary me-1">
                                            {{ 'plataforma.convites.reenviar'|trans }}
                                        </button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('admin_platform_convite_revogar', {id: convite.id}) }}" class="d-inline"
                                      data-confirmar="{{ 'plataforma.convites.confirmar_revogar'|trans({email: convite.email}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('convite_revogar_' ~ convite.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        {{ 'plataforma.convites.revogar'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">{{ 'plataforma.convites.vazio'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
