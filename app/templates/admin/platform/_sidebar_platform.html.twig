{# Sidebar da área de plataforma (super-admin, fora de escritório) #}
{% set currentRoute = app.request.attributes.get('_route')|default('') %}

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<aside class="app-sidebar pje-sidebar" id="pjeSidebar">
    <div class="sidebar-wrapper pje-menu-wrapper">
        <nav>
            <ul class="pje-menu-list">
                <li class="pje-menu-separator">Plataforma</li>
                <li class="pje-menu-item">
                    <a href="{{ path('admin_platform_dashboard') }}"
                       class="pje-menu-link {{ currentRoute == 'admin_platform_dashboard' ? 'active' : '' }}">
                        <i class="bi bi-speedometer2 pje-nav-icon"></i><span>Dashboard</span>
                    </a>
                </li>
                <li class="pje-menu-item">
                    <a href="{{ path('admin_platform_convite_index') }}"
                       class="pje-menu-link {{ currentRoute starts with 'admin_platform_convite' ? 'active' : '' }}">
                        <i class="bi bi-envelope-paper pje-nav-icon"></i><span>Convites</span>
                    </a>
                </li>
                <li class="pje-menu-item">
                    <a href="{{ path('admin_platform_oab_index') }}"
                       class="pje-menu-link {{ currentRoute starts with 'admin_platform_oab' ? 'active' : '' }}">
                        <i class="bi bi-patch-check pje-nav-icon"></i><span>Revisão de OAB</span>
                    </a>
                </li>

                <li class="pje-menu-separator">Sistema</li>
                <li class="pje-menu-item">
                    <a href="{{ path('expediente_index') }}" class="pje-menu-link">
                        <i class="bi bi-box-arrow-left pje-nav-icon"></i><span>Voltar ao sistema</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</aside>
