{% extends 'admin/platform/_base_platform.html.twig' %}

{% block title %}{{ 'plataforma.oab.titulo'|trans }}{% endblock %}

{% block platform_body %}
<div class="platform-header">
    <div>
        <h1 class="platform-title">{{ 'plataforma.oab.titulo'|trans }}</h1>
        <p class="platform-subtitle">{{ 'plataforma.oab.subtitulo'|trans }}</p>
    </div>
    <span class="platform-badge"><i class="bi bi-people-fill"></i> {{ 'plataforma.oab.contagem'|trans({n: total, qtd: total ~ ''}) }}</span>
</div>

{# Os avisos (flash) saem pelo base.html.twig, que esvazia a flashbag antes deste bloco. #}

{# Filtros + busca #}
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center justify-content-between">
        {% set filtros = {'pendentes': 'plataforma.oab.filtro.pendentes'|trans, 'divergente': 'plataforma.oab.filtro.divergente'|trans, 'nao_verificada': 'plataforma.oab.filtro.nao_verificada'|trans, 'confirmada': 'plataforma.oab.filtro.confirmada'|trans, 'todas': 'plataforma.oab.filtro.todas'|trans} %}
        <div class="platform-filters">
            {% for chave, rotulo in filtros %}
                <a href="{{ path('admin_platform_oab_index', {status: chave, q: busca}) }}"
                   class="platform-filter {{ statusAtual == chave ? 'active' : '' }}">{{ rotulo }}</a>
            {% endfor %}
        </div>
        <form method="get" action="{{ path('admin_platform_oab_index') }}" class="d-flex gap-2">
            <input type="hidden" name="status" value="{{ statusAtual }}">
            <div class="platform-search">
                <i class="bi bi-search"></i>
                <input type="search" name="q" value="{{ busca }}" class="form-control form-control-sm"
                       placeholder="{{ 'plataforma.oab.busca_placeholder'|trans }}" style="min-width:230px">
            </div>
            <button type="submit" class="btn btn-sm btn-primary">{{ 'plataforma.oab.buscar'|trans }}</button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table platform-table align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">{{ 'plataforma.oab.nome'|trans }}</th>
                    <th>{{ 'plataforma.oab.email'|trans }}</th>
                    <th>{{ 'plataforma.oab.oab'|trans }}</th>
                    <th>{{ 'plataforma.oab.nome_cna'|trans }}</th>
                    <th>{{ 'plataforma.oab.status'|trans }}</th>
                    <th>{{ 'plataforma.oab.verificada_em'|trans }}</th>
                    <th class="text-end pe-4">{{ 'plataforma.oab.acoes'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for item in itens %}
                {% set s = item.oabStatus ? item.oabStatus.value : null %}
                {% set ctx = {status: statusAtual, q: busca, pagina: pagina} %}
                <tr class="{{ s == 'divergente' ? 'platform-row-divergente' : '' }}">
                    <td class="ps-4 platform-name-strong">{{ item.nome }}</td>
                    <td class="text-secondary">{{ item.email }}</td>
                    <td class="platform-oab-num">
                        {{ item.oabNumero ~ '/' ~ item.oabUf }}
                        {% set principal = item.tipo.value == 'principal' %}
                        <span class="badge rounded-pill ms-1 oab-selo-tipo {{ principal ? 'text-bg-primary' : 'text-bg-secondary' }}"><i class="bi {{ principal ? 'bi-star-fill' : 'bi-diagram-2' }} me-1"></i>{{ (principal ? 'plataforma.oab.principal' : 'plataforma.oab.suplementar')|trans|upper }}</span>
                    </td>
                    <td>{% if (item.oabNomeOficial ?? null) is not null %}{{ item.oabNomeOficial }}{% else %}<span class="text-muted small">{{ 'plataforma.oab.nao_informado'|trans }}</span>{% endif %}</td>
                    <td>{% include '_oab_status.html.twig' with {status: item.oabStatus, size: 'sm'} only %}</td>
                    <td class="text-secondary">{{ item.oabVerificadaEm ? item.oabVerificadaEm|data_hora : 'plataforma.oab.sem_registro'|trans }}</td>
                    <td class="text-end pe-4">
                        <div class="d-inline-flex gap-1">
                            {% if s != 'confirmada' %}
                                <form method="post" action="{{ path('admin_platform_oab_confirmar', ctx|merge({id: item.id})) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('oab_confirmar_' ~ item.id) }}">
                                    <input type="hidden" name="numero" value="{{ item.oabNumero }}">
                                    <input type="hidden" name="uf" value="{{ item.oabUf }}">
                                    <button class="btn btn-sm btn-success" title="{{ 'plataforma.oab.confirmar_dica'|trans }}" data-bs-toggle="tooltip">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            {% else %}
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-danger dropdown-toggle" data-bs-toggle="dropdown" title="{{ 'plataforma.oab.reverter_dica'|trans }}">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>{{ 'plataforma.oab.reverter'|trans }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><h6 class="dropdown-header">{{ 'plataforma.oab.reverter_para'|trans }}</h6></li>
                                        <li>
                                            <form method="post" action="{{ path('admin_platform_oab_reverter', ctx|merge({id: item.id})) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('oab_reverter_' ~ item.id) }}">
                                                <input type="hidden" name="numero" value="{{ item.oabNumero }}">
                                                <input type="hidden" name="uf" value="{{ item.oabUf }}">
                                                <input type="hidden" name="destino" value="nao_verificada">
                                                <button class="dropdown-item" type="submit"><i class="bi bi-clock-history me-2 text-warning"></i>{{ 'plataforma.oab.nao_verificada'|trans }}</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form method="post" action="{{ path('admin_platform_oab_reverter', ctx|merge({id: item.id})) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('oab_reverter_' ~ item.id) }}">
                                                <input type="hidden" name="numero" value="{{ item.oabNumero }}">
                                                <input type="hidden" name="uf" value="{{ item.oabUf }}">
                                                <input type="hidden" name="destino" value="divergente">
                                                <button class="dropdown-item" type="submit"><i class="bi bi-exclamation-triangle me-2 text-danger"></i>{{ 'plataforma.oab.divergente'|trans }}</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            {% endif %}
                            <form method="post" action="{{ path('admin_platform_oab_reverificar', ctx|merge({id: item.id})) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('oab_reverificar_' ~ item.id) }}">
                                <button class="btn btn-sm btn-outline-secondary" title="{{ 'plataforma.oab.reverificar_dica'|trans }}" data-bs-toggle="tooltip">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">
                        <div class="platform-empty">
                            <i class="bi bi-patch-check"></i>
                            <div class="platform-empty-title">{{ 'plataforma.oab.vazio_titulo'|trans }}</div>
                            <div>{{ (busca ? 'plataforma.oab.vazio_com_busca' : 'plataforma.oab.vazio_sem_busca')|trans }}</div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if totalPaginas > 1 %}
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            {% for p in 1..totalPaginas %}
                <li class="page-item {{ p == pagina ? 'active' : '' }}">
                    <a class="page-link" href="{{ path('admin_platform_oab_index', {status: statusAtual, q: busca, pagina: p}) }}">{{ p }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
</script>
{% endblock %}
