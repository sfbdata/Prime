{% extends 'admin/platform/_base_platform.html.twig' %}

{% block title %}Revisão de OAB{% endblock %}

{% block platform_body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Revisão de OAB</h1>
</div>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'sucesso' ? 'success' : (type == 'erro' ? 'danger' : (type == 'info' ? 'info' : 'secondary')) }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

{# Filtros + busca #}
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            {% set filtros = {'pendentes': 'Pendentes', 'divergente': 'Divergentes', 'nao_verificada': 'Não verificadas', 'confirmada': 'Confirmadas', 'todas': 'Todas'} %}
            <div class="btn-group btn-group-sm" role="group">
                {% for chave, rotulo in filtros %}
                    <a href="{{ path('admin_platform_oab_index', {status: chave, q: busca}) }}"
                       class="btn btn-outline-primary {{ statusAtual == chave ? 'active' : '' }}">{{ rotulo }}</a>
                {% endfor %}
            </div>
            <form method="get" action="{{ path('admin_platform_oab_index') }}" class="d-flex gap-2">
                <input type="hidden" name="status" value="{{ statusAtual }}">
                <input type="search" name="q" value="{{ busca }}" class="form-control form-control-sm"
                       placeholder="Nome, e-mail ou nº OAB" style="min-width:220px">
                <button type="submit" class="btn btn-sm btn-primary">Buscar</button>
            </form>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">Usuários ({{ total }})</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>OAB</th>
                    <th>Nome no CNA</th>
                    <th>Status</th>
                    <th>Verificada em</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            {% for item in itens %}
                {% set s = item.oabStatus ? item.oabStatus.value : null %}
                {% set ctx = {status: statusAtual, q: busca, pagina: pagina} %}
                <tr>
                    <td>{{ item.nome }}</td>
                    <td>{{ item.email }}</td>
                    <td>{{ item.oabNumero ? (item.oabNumero ~ '/' ~ item.oabUf) : '—' }}</td>
                    <td>{{ item.oabNomeOficial ?? '—' }}</td>
                    <td>
                        {% if s == 'confirmada' %}<span class="badge bg-success">Confirmada</span>
                        {% elseif s == 'divergente' %}<span class="badge bg-danger">Divergente</span>
                        {% elseif s == 'nao_verificada' %}<span class="badge bg-warning text-dark">Não verificada</span>
                        {% else %}<span class="badge bg-secondary">—</span>{% endif %}
                    </td>
                    <td>{{ item.oabVerificadaEm ? item.oabVerificadaEm|date('d/m/Y H:i') : '—' }}</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            {% if s != 'confirmada' %}
                                <form method="post" action="{{ path('admin_platform_oab_confirmar', ctx|merge({id: item.id})) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('oab_confirmar_' ~ item.id) }}">
                                    <button class="btn btn-sm btn-success" title="Marcar confirmada"><i class="bi bi-check-lg"></i></button>
                                </form>
                            {% else %}
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-danger dropdown-toggle" data-bs-toggle="dropdown">Reverter</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <form method="post" action="{{ path('admin_platform_oab_reverter', ctx|merge({id: item.id})) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('oab_reverter_' ~ item.id) }}">
                                                <input type="hidden" name="destino" value="nao_verificada">
                                                <button class="dropdown-item" type="submit">→ Não verificada</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form method="post" action="{{ path('admin_platform_oab_reverter', ctx|merge({id: item.id})) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('oab_reverter_' ~ item.id) }}">
                                                <input type="hidden" name="destino" value="divergente">
                                                <button class="dropdown-item" type="submit">→ Divergente</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            {% endif %}
                            <form method="post" action="{{ path('admin_platform_oab_reverificar', ctx|merge({id: item.id})) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('oab_reverificar_' ~ item.id) }}">
                                <button class="btn btn-sm btn-outline-secondary" title="Re-verificar (automático dormente)"><i class="bi bi-arrow-repeat"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Nenhum usuário nesta fila.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if totalPaginas > 1 %}
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            {% for p in 1..totalPaginas %}
                <li class="page-item {{ p == pagina ? 'active' : '' }}">
                    <a class="page-link" href="{{ path('admin_platform_oab_index', {status: statusAtual, q: busca, pagina: p}) }}">{{ p }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endif %}
{% endblock %}
