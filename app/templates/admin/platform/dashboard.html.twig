{% extends 'admin/platform/_base_platform.html.twig' %}

{% block title %}{{ 'plataforma.painel.titulo'|trans({termo: 'termos.master'|trans}) }}{% endblock %}

{% block platform_body %}
<div class="platform-header">
    <div>
        <h1 class="platform-title">{{ 'plataforma.painel.titulo'|trans({termo: 'termos.master'|trans}) }}</h1>
        <p class="platform-subtitle">{{ 'plataforma.painel.subtitulo'|trans }}</p>
    </div>
    <span class="platform-badge"><i class="bi bi-shield-lock-fill"></i> {{ 'termos.master'|trans }}</span>
</div>

{% set cards = [
    {route: 'admin_platform_oab_index',     icon: 'patch-check',     title: 'plataforma.painel.oab_titulo'|trans, desc: 'plataforma.painel.oab_descricao'|trans},
    {route: 'admin_platform_convite_index', icon: 'envelope-paper',  title: 'plataforma.painel.convites_titulo'|trans, desc: 'plataforma.painel.convites_descricao'|trans({termo: 'termos.master'|trans})}
] %}

<div class="row g-3">
    {% for c in cards %}
        <div class="col-md-6 col-xl-4">
            <a href="{{ path(c.route) }}" class="platform-tile">
                <span class="platform-tile-icon"><i class="bi bi-{{ c.icon }}"></i></span>
                <span class="platform-tile-body">
                    <span class="platform-tile-title">{{ c.title }}</span>
                    <span class="platform-tile-desc">{{ c.desc }}</span>
                </span>
                <i class="bi bi-arrow-right platform-tile-arrow"></i>
            </a>
        </div>
    {% endfor %}
</div>
{% endblock %}
