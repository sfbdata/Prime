{# Confirmação do descadastro de e-mail (POST da rota pública `email_descadastro`, spec push-avisar-quando-chegar D3).
   Contexto: `remetente` (escritório ou "BlueJus"), `todos` (opt-out total gravado).
   Página avulsa, sem o layout do sistema: quem chega aqui pode não estar logado. #}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>{{ 'publicas.descadastro.confirmado.titulo'|trans }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,Helvetica,sans-serif;">
    <main style="max-width:520px;margin:48px auto;padding:0 16px;">
        <div style="background-color:#ffffff;border-radius:8px;overflow:hidden;">
            <div style="background-color:#0a6fa0;padding:20px 28px;">
                <p style="margin:0;font-size:20px;font-weight:bold;color:#ffffff;">BlueJus</p>
            </div>
            <div style="padding:28px;">
                <h1 style="margin:0 0 12px;font-size:18px;color:#1a1a2e;">{{ 'publicas.descadastro.confirmado.titulo'|trans }}</h1>
                <p style="margin:0 0 12px;font-size:15px;color:#444444;line-height:1.6;">
                    {% if todos %}{{ 'publicas.descadastro.confirmado.todos'|trans({remetente: remetente}) }}{% else %}{{ 'publicas.descadastro.confirmado.estes_avisos'|trans({remetente: remetente}) }}{% endif %}
                </p>
                <p style="margin:0;font-size:13px;color:#888888;line-height:1.5;">
                    {{ 'publicas.descadastro.confirmado.pode_fechar'|trans }} {% if not todos %}{{ 'publicas.descadastro.confirmado.demais'|trans({remetente: remetente}) }}{% endif %}
                </p>
            </div>
        </div>
    </main>
</body>
</html>
