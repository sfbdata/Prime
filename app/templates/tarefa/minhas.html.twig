{% extends 'base.html.twig' %}

{#
   Tela "Minhas Metas" — reorganizada por PAPEL (abas).
   Desenho-alvo: docs/design/minhas-metas/vs-22-10-26/04 - Minhas Metas 22.10.26.dc.html · Spec: docs/specs/minhas-metas-abas.md

   O que fica FORA de [data-filtro-resultado] (título, KPIs, abas, barra de filtro) não recarrega
   ao filtrar — é o que mantém o foco no campo de busca, padrão do Expediente.
#}

{% block title %}{{ 'metas.titulo'|trans }}{% endblock %}

{% set aba = painel.aba %}

{% block body_class %}mm-body{% endblock %}

{% block body %}
{# Moldura do desenho (dc L49): 24/22/32, coluna com 16px entre os blocos, até 1600px. O fundo #f3f6f8 e o respiro
   zerado da moldura do sistema ficam presos em `.mm-body` (decisão do dono de 22/10: nada muda nas outras telas). #}
<div class="mm-page">
    <header class="mm-topo">
        {# Cabeçalho do desenho (dc L50-56): H1 36px com o traço azul, 18px até "Atualizado às" e o subtítulo 8px
           abaixo. Sem migalha (o desenho não tem). `.mm-cabecalho` escopa o tamanho: a Equipe usa o mesmo `.mm-titulo`. #}
        <div class="mm-cabecalho">
            <div class="mm-cabecalho-linha">
                <h1 class="mm-titulo">{{ 'metas.titulo'|trans }}</h1>
                {# Hora em que o servidor leu as metas; a recarga parcial do filtro traz a hora da nova leitura
                   (`data-mm-lido-as` no fragmento) e o script abaixo a copia. #}
                <span class="mm-atualizado"><span class="mm-atualizado-ponto" aria-hidden="true"></span>{{ 'metas.atualizado_as'|trans }} <span data-mm-atualizado-hora>{{ 'now'|hora }}</span></span>
            </div>
            <p class="mm-subtitulo">{{ 'metas.subtitulo'|trans }}</p>
        </div>
        {# BlueJus IA (desenho 04 VS 29.10.26): só para quem usa o módulo, como o botão da pasta. #}
        {% if can_access_module('inteligencia') and recurso_visivel('assistente') %}
            {{ include('tarefa/_ia_botao.html.twig') }}
        {% endif %}
    </header>

    {% if can_access_module('inteligencia') and recurso_visivel('assistente') %}
        {{ include('tarefa/_ia_painel.html.twig') }}
    {% endif %}

    {# Só filtros preenchidos entram na URL: parâmetro vazio na barra de endereço é ruído. #}
    {% set base = filtros|filter(v => v != '') %}

    {# ── Esteira da pasta (geral do escritório) e o divisor "Suas metas" (desenho 22/10, dc L58-61) ── #}
    {% if esteira is defined %}
        {{ include('tarefa/_esteira.html.twig', {comModo: base|merge({aba: aba.value})}) }}
    {% endif %}

    {# ── KPIs (dc 31/10 L82-83): atalhos, não resumo do filtro. Anel tracejado e ícone no canto (JS `VIS`), rótulo com
       traço, número grande e a descrição embaixo; borda inferior na cor do indicador. ── #}
    {% set kpis = painel.kpis %}
    {% set atalhos = [
        { chave: 'atrasadas', icone: 'bi-exclamation-octagon', rotulo: 'metas.prazo.atrasadas'|trans, valor: kpis.atrasadas, sub: 'metas.kpis.sob_sua_responsabilidade'|trans, tom: 'danger', destino: { aba: 'responsavel', prazo: 'vencidas' } },
        { chave: 'proximas', icone: 'bi-hourglass-split', rotulo: 'metas.prazo.vencem_em_7_dias'|trans, valor: kpis.proximas, sub: 'metas.kpis.ainda_da_tempo'|trans, tom: 'warn', destino: { aba: 'responsavel', prazo: 'proximas' } },
        { chave: 'revisao', icone: 'bi-clipboard2-check', rotulo: 'metas.kpis.aguardando_sua_revisao'|trans, valor: kpis.aguardando_revisao, sub: 'metas.kpis.criadas_por_voce'|trans, tom: 'accent', destino: { aba: 'criei' } },
        { chave: 'sem_prazo', icone: 'bi-calendar-x', rotulo: 'metas.prazo.sem_prazo'|trans, valor: kpis.sem_prazo, sub: 'metas.kpis.abertas_sem_data'|trans, tom: 'cinza', destino: { aba: 'responsavel', prazo: 'sem' } }
    ] %}
    <div class="mm-kpis">
        {% for k in atalhos %}
            <a href="{{ path('tarefa_minhas', k.destino) }}" class="mm-kpi tom-{{ k.tom }}"
               title="{{ 'metas.kpis.ver'|trans({rotulo: k.rotulo|lower}) }}">
                <span class="mm-kpi-anel" aria-hidden="true"></span>
                <span class="mm-kpi-icone" aria-hidden="true"><i class="bi {{ k.icone }}"></i></span>
                <span class="mm-kpi-rotulo">{{ k.rotulo }}</span>
                <span class="mm-kpi-traco" aria-hidden="true"></span>
                {# O número das atrasadas só fica vermelho se houver atrasadas (dc `numCor`). #}
                <b class="mm-kpi-valor{{ k.chave == 'atrasadas' and 0 < k.valor ? ' is-alerta' : '' }}">{{ k.valor }}</b>
                <span class="mm-kpi-sub">{{ k.sub }}</span>
            </a>
        {% endfor %}
    </div>

    {# ── Abas + filtros num cartão só (dc L66-79) e o resultado ──
       As abas moram dentro da raiz do filtro só pela caixa visual: o filtro-tabela.js reage a campos e às classes
       `js-filtro-*`, não a elas. Prioridade: a da META (normal/alta/urgente). Rótulos do prazo do desenho (dc L77);
       os valores `vencidas`/`proximas`/`sem` não mudam (KPIs). "Limpar filtros" (dc L78): o motor só desenha o
       botão com filtro ativo; a etapa da esteira conta como filtro e sai junto (script abaixo). #}
    {% set contagens = painel.contagensPorAba %}
    {% set abas = [
        { valor: 'responsavel', rotulo: 'metas.abas.responsavel'|trans, icone: 'bi-person-check' },
        { valor: 'criei', rotulo: 'metas.abas.criei'|trans, icone: 'bi-send' },
        { valor: 'acompanhando', rotulo: 'metas.abas.acompanhando'|trans, icone: 'bi-bookmark' },
        { valor: 'todas', rotulo: 'metas.abas.todas'|trans, icone: 'bi-layers' }
    ] %}
    <div class="mm-filtro" data-filtro-root data-filtro-endpoint="{{ path('tarefa_minhas') }}" data-ft-rotulo-limpar="{{ 'metas.filtros.limpar'|trans }}">
        <div class="mm-barra-cartao">
            <div class="mm-abas" role="tablist" aria-label="{{ 'metas.abas.rotulo'|trans }}">
                {% for a in abas %}
                    <a href="{{ path('tarefa_minhas', base|merge({aba: a.valor})) }}"
                       class="mm-aba {{ aba.value == a.valor ? 'is-ativa' : '' }}"
                       role="tab" aria-selected="{{ aba.value == a.valor ? 'true' : 'false' }}"
                       data-aba="{{ a.valor }}">
                        <i class="bi {{ a.icone }}"></i>
                        <span>{{ a.rotulo }}</span>
                        <span class="mm-aba-badge">{{ contagens[a.valor] ?? 0 }}</span>
                    </a>
                {% endfor %}
            </div>
            <span class="mm-barra-sep" aria-hidden="true"></span>
            {{ include('_partials/_filtro_barra.html.twig', {
                busca_placeholder: 'metas.filtros.busca_placeholder'|trans,
                filtros: filtros,
                facetas: [
                    { name: 'prioridade', rotulo: 'metas.filtros.prioridade'|trans, tipo: 'select', opcoes: [
                        { valor: 'normal', label: 'metas.prioridade.normal'|trans },
                        { valor: 'alta', label: 'metas.prioridade.alta'|trans },
                        { valor: 'urgente', label: 'metas.prioridade.urgente'|trans }
                    ] },
                    { name: 'prazo', rotulo: 'metas.filtros.prazo'|trans, tipo: 'select', opcoes: [
                        { valor: 'vencidas', label: 'metas.prazo.atrasadas'|trans },
                        { valor: 'proximas', label: 'metas.prazo.vencem_em_7_dias'|trans },
                        { valor: 'sem', label: 'metas.prazo.sem_prazo'|trans }
                    ] }
                ]
            }) }}
        </div>

        <div data-filtro-resultado>
            {{ include('tarefa/_resultado.html.twig') }}
        </div>
    </div>
</div>
{# Modal "Concluir etapa e passar adiante" do botão do cartão (desenho 04 L131; spec Fase 3). #}
{{ include('tarefa/_meta_passagem_modal.html.twig', {contexto: 'lista'}) }}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
{{ catalogo_js('metas.js', 'metas.passagem.js') }}
<script src="{{ asset('js/meta-passagem.js') }}"></script>
{% if can_access_module('inteligencia') and recurso_visivel('assistente') %}<script src="{{ asset('js/chat-ia-markdown.js') }}"></script><script src="{{ asset('js/central-ia-chat.js') }}"></script><script src="{{ asset('js/minhas-metas-ia.js') }}"></script>{% endif %}
{% if esteira is defined and esteira.podeConfigurar %}<script src="{{ asset('js/esteira-da-pasta.js') }}"></script>{% endif %}
<script>
// A aba e a etapa da esteira são estado da tela: entram no form de filtro como campos ocultos para sobreviverem à
// recarga parcial. Sem isso, filtrar dentro de "Criei" jogaria o usuário de volta em "Sou responsável". A etapa é
// também filtro (dc L232): leva `js-filtro-campo` para o motor contá-la e mostrar o "Limpar filtros".
(function () {
    var raiz = document.querySelector('[data-filtro-root]');
    if (!raiz) { return; }
    var form = raiz.querySelector('[data-filtro-form]');
    if (!form) { return; }

    [['aba', {{ aba.value|json_encode|raw }}, ''], ['etapa', {{ filtros.etapa|default('')|json_encode|raw }}, 'js-filtro-campo']]
        .forEach(function (par) {
            if (!par[1]) { return; }
            var campo = document.createElement('input');
            campo.type      = 'hidden';
            campo.name      = par[0];
            campo.value     = par[1];
            campo.className = par[2];
            form.appendChild(campo);
        });

    // "Limpar filtros" com a etapa ligada: a esteira (fora do fragmento) também tem de apagar a caixa ativa, então a
    // tela recarrega inteira, na mesma aba e sem filtro nenhum. Sem a etapa, o motor limpa só o fragmento.
    raiz.addEventListener('click', function (e) {
        var etapa = form.querySelector('input[name="etapa"]');
        if (!e.target.closest('.js-filtro-limpar') || !etapa || etapa.value === '') { return; }
        e.stopPropagation();
        window.location.href = {{ path('tarefa_minhas', {aba: aba.value})|json_encode|raw }};
    }, true);
}());

// "Atualizado às": o fragmento recarregado pelo filtro traz a hora da nova leitura em
// `data-mm-lido-as`; o cabeçalho (que não recarrega) passa a mostrá-la.
(function () {
    var alvo    = document.querySelector('[data-filtro-resultado]');
    var relogio = document.querySelector('[data-mm-atualizado-hora]');
    if (!alvo || !relogio || !window.MutationObserver) { return; }
    new MutationObserver(function () {
        var lido = alvo.querySelector('[data-mm-lido-as]');
        if (lido) { relogio.textContent = lido.getAttribute('data-mm-lido-as'); }
    }).observe(alvo, { childList: true });
}());

// Marcador de acompanhamento — alterna sem recarregar a página.
var ABA_ATUAL = {{ aba.value|json_encode|raw }};
document.addEventListener('click', function (e) {
    var botao = e.target.closest('[data-acompanhar]');
    if (!botao) { return; }

    e.preventDefault();
    if (botao.disabled) { return; }
    botao.disabled = true;

    var dados = new FormData();
    dados.append('_token', botao.dataset.token);

    fetch(botao.dataset.acompanhar, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: dados,
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
        if (!d.sucesso) { return; }

        botao.classList.toggle('is-marcada', d.acompanhando);
        var icone = botao.querySelector('i');
        if (icone) { icone.className = d.acompanhando ? 'bi bi-bookmark-fill' : 'bi bi-bookmark'; }
        botao.title = d.acompanhando ? BJ_T.t('metas.js.parar_de_acompanhar') : BJ_T.t('metas.js.acompanhar_esta_meta');
        botao.setAttribute('aria-pressed', d.acompanhando ? 'true' : 'false');

        // O clique muda o conteúdo de OUTRA aba, então o badge dela tem de acompanhar na
        // hora. Os números vêm do servidor na mesma resposta — sem isso a aba "Em
        // acompanhamento" ficava em zero até o usuário apertar F5.
        if (d.contagens) {
            Object.keys(d.contagens).forEach(function (chave) {
                var aba = document.querySelector('.mm-aba[data-aba="' + chave + '"] .mm-aba-badge');
                if (aba) { aba.textContent = d.contagens[chave]; }
            });
        }

        // Desmarcar estando NA aba "Em acompanhamento" tira a meta da lista que se está
        // olhando. Some com a linha e acerta o contador do grupo, em vez de deixar na tela
        // um item que não pertence mais ali.
        if (!d.acompanhando && ABA_ATUAL === 'acompanhando') {
            var linha = botao.closest('.mm-meta');
            if (linha) {
                // O contador fica no cabeçalho da <section> do grupo (dc L85); as linhas moram na faixa abaixo dele.
                var grupo    = linha.closest('.mm-grupo');
                var contador = grupo ? grupo.querySelector('.mm-grupo-contagem') : null;
                if (contador) {
                    contador.textContent = Math.max(0, parseInt(contador.textContent, 10) - 1);
                }

                linha.style.transition = 'opacity .2s';
                linha.style.opacity    = '0';
                window.setTimeout(function () { linha.remove(); }, 200);
            }
        }
    })
    .finally(function () { botao.disabled = false; });
});

// Linha inteira clicável (dc L88, LIS-15): o clique em qualquer ponto da linha abre a META, o
// mesmo destino do título (decisão do dono de 14/10: a pasta não). O título continua sendo o
// link real, focável pelo teclado e lido pelo leitor de tela; a linha só delega o clique para
// ele. Controles internos (marcador, Concluir etapa, link da pasta) seguem com a ação deles,
// e quem está selecionando texto não é levado para outra página. Como num link: Ctrl, Cmd,
// Shift ou o botão do meio (que chega como `auxclick`) abrem em outra aba ou janela.
function abrirMetaPelaLinha(e) {
    var linha = e.target.closest('[data-mm-linha-clicavel]');
    if (!linha || e.defaultPrevented) { return; }
    var meio = e.type === 'auxclick';
    if (meio ? e.button !== 1 : e.button !== 0) { return; }
    if (e.target.closest('a, button, input, select, textarea, label')) { return; }
    var selecao = window.getSelection ? String(window.getSelection()) : '';
    if (selecao !== '') { return; }

    var titulo = linha.querySelector('a.mm-meta-titulo');
    if (!titulo) { return; }
    if (meio || e.ctrlKey || e.metaKey || e.shiftKey) {
        e.preventDefault();
        window.open(titulo.href, '_blank', 'noopener');
        return;
    }
    titulo.click();
}
document.addEventListener('click', abrirMetaPelaLinha);
document.addEventListener('auxclick', abrirMetaPelaLinha);

// Avisos (flash) do sistema nesta tela: embaixo no centro, empilhados. Só o de sucesso é o aviso do desenho (dc L132)
// e some em 3 segundos (.is-toast); o de erro fica, com a cor de erro, até a pessoa fechar no X.
document.querySelectorAll('.mm-body .app-content-header .alert').forEach(function (aviso) {
    var sucesso = aviso.classList.contains('alert-success');
    var icone = document.createElement('i');
    icone.className = sucesso ? 'bi bi-check-circle' : 'bi bi-exclamation-circle';
    aviso.prepend(icone);
    if (!sucesso) return;
    aviso.classList.add('is-toast');
    window.setTimeout(function () { aviso.remove(); }, 3000);
});
</script>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<link rel="stylesheet" href="{{ asset('css/minhas-metas.css') }}">
<link rel="stylesheet" href="{{ asset('css/minhas-metas-ia.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-passagem.css') }}">
{% endblock %}
