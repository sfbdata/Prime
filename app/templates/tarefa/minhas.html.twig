{% extends 'base.html.twig' %}

{#
   Tela "Minhas Metas" — reorganizada por PAPEL (abas).
   Desenho-alvo: docs/design/redesign-19-10-26/04 - Minhas Metas 1.0.dc.html (dono, 21/10) · Spec: docs/specs/minhas-metas-abas.md

   O que fica FORA de [data-filtro-resultado] (título, KPIs, abas, barra de filtro) não recarrega
   ao filtrar — é o que mantém o foco no campo de busca, padrão do Expediente.
#}

{% block title %}{{ 'metas.titulo'|trans }}{% endblock %}

{% set aba = painel.aba %}

{% block body %}
<div class="mm-page">
<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-end gap-3 flex-wrap mb-2">
            {# Cabeçalho do desenho (dc L46-51): H1 36px sem ícone, 18px até "Atualizado às" e o
               subtítulo 8px abaixo. `.mm-cabecalho` escopa o tamanho: a tela de Equipe usa o mesmo
               `.mm-titulo` e não muda. #}
            <div class="mm-cabecalho min-w-0">
                <div class="mm-cabecalho-linha">
                    <h1 class="mm-titulo">{{ 'metas.titulo'|trans }}</h1>
                    {# Hora em que o servidor leu as metas — informação real; a recarga parcial do filtro
                       traz a hora da nova leitura (`data-mm-lido-as` no fragmento) e o script abaixo a copia. #}
                    <span class="mm-atualizado"><span class="mm-atualizado-ponto" aria-hidden="true"></span>{{ 'metas.atualizado_as'|trans }} <span data-mm-atualizado-hora>{{ 'now'|hora }}</span></span>
                </div>
                <p class="mm-subtitulo">{{ 'metas.subtitulo'|trans }}</p>
            </div>
            <div class="flex-grow-1"></div>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">{{ 'metas.migalha.home'|trans }}</a></li>
                <li class="breadcrumb-item active">{{ 'metas.titulo'|trans }}</li>
            </ol>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        {# ── KPIs: atalhos, não resumo do filtro ── #}
        {% set kpis = painel.kpis %}
        {% set atalhos = [
            { chave: 'atrasadas',  rotulo: 'metas.prazo.atrasadas'|trans, valor: kpis.atrasadas,          sub: 'metas.kpis.sob_sua_responsabilidade'|trans, tom: 'danger', icone: 'bi-exclamation-octagon', destino: { aba: 'responsavel', prazo: 'vencidas' } },
            { chave: 'proximas',   rotulo: 'metas.prazo.vencem_em_7_dias'|trans, valor: kpis.proximas,           sub: 'metas.kpis.ainda_da_tempo'|trans, tom: 'warn',   icone: 'bi-hourglass-split',     destino: { aba: 'responsavel', prazo: 'proximas' } },
            { chave: 'revisao',    rotulo: 'metas.kpis.aguardando_sua_revisao'|trans, valor: kpis.aguardando_revisao, sub: 'metas.kpis.criadas_por_voce'|trans, tom: 'accent', icone: 'bi-clipboard2-check',    destino: { aba: 'criei' } },
            { chave: 'sem_prazo',  rotulo: 'metas.prazo.sem_prazo'|trans, valor: kpis.sem_prazo,          sub: 'metas.kpis.abertas_sem_data'|trans, tom: 'cinza',  icone: 'bi-calendar-x',          destino: { aba: 'responsavel', prazo: 'sem' } }
        ] %}
        <div class="mm-kpis mb-3">
            {% for k in atalhos %}
                {% set ativo = (k.destino.aba == aba.value) and ((k.destino.prazo|default('')) == filtros.prazo) and (k.destino.prazo is defined or filtros.prazo == '') %}
                <a href="{{ path('tarefa_minhas', k.destino) }}"
                   class="mm-kpi tom-{{ k.tom }} {{ ativo and k.destino.prazo is defined ? 'is-ativo' : '' }}"
                   title="{{ 'metas.kpis.ver'|trans({rotulo: k.rotulo|lower}) }}">
                    {# Indicador do desenho (dc L54-61): halo, ícone, rótulo sublinhado na cor, número
                       grande e faixa inferior. O número das atrasadas só fica vermelho se houver atrasadas. #}
                    <span class="mm-kpi-halo" aria-hidden="true"></span>
                    <span class="mm-kpi-icone" aria-hidden="true"><i class="bi {{ k.icone }}"></i></span>
                    <span class="mm-kpi-rotulo">{{ k.rotulo }}</span>
                    <span class="mm-kpi-valor{{ k.chave == 'atrasadas' and 0 < k.valor ? ' is-alerta' : '' }}">{{ k.valor }}</span>
                    <span class="mm-kpi-sub">{{ k.sub }}</span>
                    <span class="mm-kpi-faixa" aria-hidden="true"></span>
                </a>
            {% endfor %}
        </div>

        {# ── Abas (papel) + modo de exibição ── #}
        {% set contagens = painel.contagensPorAba %}
        {% set abas = [
            { valor: 'responsavel',  rotulo: 'metas.abas.responsavel'|trans, icone: 'bi-person-check' },
            { valor: 'criei',        rotulo: 'metas.abas.criei'|trans, icone: 'bi-send' },
            { valor: 'acompanhando', rotulo: 'metas.abas.acompanhando'|trans, icone: 'bi-bookmark' },
            { valor: 'todas',        rotulo: 'metas.abas.todas'|trans, icone: 'bi-layers' }
        ] %}
        {# Só filtros preenchidos entram na URL — parâmetro vazio na barra de endereço é ruído,
           e `modo` só aparece quando não é o padrão (cartões). #}
        {% set base = filtros|filter(v => v != '') %}
        {% set comModo = painel.modoLista ? base|merge({modo: 'lista'}) : base %}
        {# ── Abas + filtros + modo, num cartão só (dc L65-75), e o resultado ──
           As abas moram dentro da raiz do filtro só pela caixa visual: o filtro-tabela.js reage a
           campos e às classes `js-filtro-*`, não a elas.
           Rótulos do prazo do desenho (dc L78); os valores `vencidas`/`proximas`/`sem` não mudam (KPIs).
           "Limpar filtros" (dc L79): o motor só desenha o botão com filtro ativo e zera busca e selects,
           não a aba (campo oculto sem `js-filtro-campo`). #}
        <div data-filtro-root data-filtro-endpoint="{{ path('tarefa_minhas') }}" data-ft-rotulo-limpar="{{ 'metas.filtros.limpar'|trans }}">
            <div class="mm-barra-cartao">
                <div class="mm-abas" role="tablist" aria-label="{{ 'metas.abas.rotulo'|trans }}">
                    {% for a in abas %}
                        <a href="{{ path('tarefa_minhas', comModo|merge({aba: a.valor})) }}"
                           class="mm-aba {{ aba.value == a.valor ? 'is-ativa' : '' }}"
                           role="tab" aria-selected="{{ aba.value == a.valor ? 'true' : 'false' }}"
                           data-aba="{{ a.valor }}">
                            <i class="bi {{ a.icone }}"></i>
                            <span>{{ a.rotulo }}</span>
                            <span class="mm-aba-badge">{{ contagens[a.valor] ?? 0 }}</span>
                        </a>
                    {% endfor %}
                </div>
                <span class="mm-barra-sep" aria-hidden="true"></span>
            {{ include('_partials/_filtro_barra.html.twig', {
                busca_placeholder: 'metas.filtros.busca_placeholder'|trans,
                filtros: filtros,
                facetas: [
                    { name: 'prioridade', rotulo: 'metas.filtros.prioridade'|trans, tipo: 'select', opcoes: [
                        { valor: 'normal', label: 'metas.prioridade.normal'|trans },
                        { valor: 'prioridade', label: 'metas.prioridade.prioridade'|trans },
                        { valor: 'urgente', label: 'metas.prioridade.urgente'|trans }
                    ] },
                    { name: 'prazo', rotulo: 'metas.filtros.prazo'|trans, tipo: 'select', opcoes: [
                        { valor: 'vencidas', label: 'metas.prazo.atrasadas'|trans },
                        { valor: 'proximas', label: 'metas.prazo.vencem_em_7_dias'|trans },
                        { valor: 'sem', label: 'metas.prazo.sem_prazo'|trans }
                    ] }
                ]
            }) }}
                <div class="mm-modos" role="group" aria-label="{{ 'metas.modos.rotulo'|trans }}">
                    <a href="{{ path('tarefa_minhas', base|merge({aba: aba.value})) }}"
                       class="mm-modo {{ painel.modoLista ? '' : 'is-ativo' }}" title="{{ 'metas.modos.cartoes'|trans }}" aria-label="{{ 'metas.modos.cartoes'|trans }}">
                        <i class="bi bi-grid-1x2"></i>
                    </a>
                    <a href="{{ path('tarefa_minhas', base|merge({aba: aba.value, modo: 'lista'})) }}"
                       class="mm-modo {{ painel.modoLista ? 'is-ativo' : '' }}" title="{{ 'metas.modos.lista'|trans }}" aria-label="{{ 'metas.modos.lista'|trans }}">
                        <i class="bi bi-list-ul"></i>
                    </a>
                </div>
            </div>

            <div data-filtro-resultado>
                {{ include('tarefa/_resultado.html.twig') }}
            </div>
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
{{ catalogo_js('metas.js') }}
<script>
// A aba e o modo são estado da tela, não filtro: entram no form de filtro como campos
// ocultos para sobreviverem à recarga parcial. Sem isso, filtrar dentro de "Criei" jogaria
// o usuário de volta em "Sou responsável" — o mesmo modo de falha já registrado no
// Expediente, quando um filtro não representável no form se perdia na primeira interação.
(function () {
    var raiz = document.querySelector('[data-filtro-root]');
    if (!raiz) { return; }
    var form = raiz.querySelector('[data-filtro-form]');
    if (!form) { return; }

    [['aba', {{ aba.value|json_encode|raw }}], ['modo', {{ (painel.modoLista ? 'lista' : '')|json_encode|raw }}]]
        .forEach(function (par) {
            if (!par[1]) { return; }
            var campo = document.createElement('input');
            campo.type  = 'hidden';
            campo.name  = par[0];
            campo.value = par[1];
            form.appendChild(campo);
        });
}());

// "Atualizado às": o fragmento recarregado pelo filtro traz a hora da nova leitura em
// `data-mm-lido-as`; o cabeçalho (que não recarrega) passa a mostrá-la.
(function () {
    var alvo    = document.querySelector('[data-filtro-resultado]');
    var relogio = document.querySelector('[data-mm-atualizado-hora]');
    if (!alvo || !relogio || !window.MutationObserver) { return; }
    new MutationObserver(function () {
        var lido = alvo.querySelector('[data-mm-lido-as]');
        if (lido) { relogio.textContent = lido.getAttribute('data-mm-lido-as'); }
    }).observe(alvo, { childList: true });
}());

// O modo (cartões/lista) é preferência de tela, não dado do escritório: fica no navegador de
// quem escolheu. Guardado só quando veio explícito na URL, e reaplicado na próxima visita —
// nunca no servidor, e nunca sobrescrevendo uma escolha que o usuário acabou de fazer.
(function () {
    var CHAVE = 'jusprime.minhasMetas.modo';
    var url   = new URL(window.location.href);
    var naUrl = url.searchParams.get('modo');

    try {
        if (naUrl !== null) {
            window.localStorage.setItem(CHAVE, naUrl === 'lista' ? 'lista' : 'cartoes');
            return;
        }
        if (window.localStorage.getItem(CHAVE) === 'lista') {
            url.searchParams.set('modo', 'lista');
            window.location.replace(url.toString());
        }
    } catch (e) {
        // Navegador com armazenamento bloqueado: a tela segue no modo padrão, sem quebrar.
    }
}());

// Marcador de acompanhamento — alterna sem recarregar a página.
var ABA_ATUAL = {{ aba.value|json_encode|raw }};
document.addEventListener('click', function (e) {
    var botao = e.target.closest('[data-acompanhar]');
    if (!botao) { return; }

    e.preventDefault();
    if (botao.disabled) { return; }
    botao.disabled = true;

    var dados = new FormData();
    dados.append('_token', botao.dataset.token);

    fetch(botao.dataset.acompanhar, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: dados,
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
        if (!d.sucesso) { return; }

        botao.classList.toggle('is-marcada', d.acompanhando);
        var icone = botao.querySelector('i');
        if (icone) { icone.className = d.acompanhando ? 'bi bi-bookmark-fill' : 'bi bi-bookmark'; }
        botao.title = d.acompanhando ? BJ_T.t('metas.js.parar_de_acompanhar') : BJ_T.t('metas.js.acompanhar_esta_meta');
        botao.setAttribute('aria-pressed', d.acompanhando ? 'true' : 'false');

        // O clique muda o conteúdo de OUTRA aba, então o badge dela tem de acompanhar na
        // hora. Os números vêm do servidor na mesma resposta — sem isso a aba "Em
        // acompanhamento" ficava em zero até o usuário apertar F5.
        if (d.contagens) {
            Object.keys(d.contagens).forEach(function (chave) {
                var aba = document.querySelector('.mm-aba[data-aba="' + chave + '"] .mm-aba-badge');
                if (aba) { aba.textContent = d.contagens[chave]; }
            });
        }

        // Desmarcar estando NA aba "Em acompanhamento" tira a meta da lista que se está
        // olhando. Some com a linha e acerta o contador do grupo, em vez de deixar na tela
        // um item que não pertence mais ali.
        if (!d.acompanhando && ABA_ATUAL === 'acompanhando') {
            var linha = botao.closest('.mm-meta, .mm-linha');
            if (linha) {
                // Todos os grupos ficam abertos (Concluídas inclusive, desenho 04): o cabeçalho é irmão da linha.
                var grupo  = linha.previousElementSibling;
                while (grupo && !grupo.matches('.mm-grupo-cabeca, .mm-separador')) {
                    grupo = grupo.previousElementSibling;
                }
                // Cada grupo é uma <section> própria (dc L83): o cabeçalho segue irmão das linhas.
                var contador = grupo ? grupo.querySelector('.mm-grupo-contagem') : null;
                if (contador) {
                    contador.textContent = Math.max(0, parseInt(contador.textContent, 10) - 1);
                }

                linha.style.transition = 'opacity .2s';
                linha.style.opacity    = '0';
                window.setTimeout(function () { linha.remove(); }, 200);
            }
        }
    })
    .finally(function () { botao.disabled = false; });
});

// Linha inteira clicável (dc L88, LIS-15): o clique em qualquer ponto da linha abre a META, o
// mesmo destino do título (decisão do dono de 14/10: a pasta não). O título continua sendo o
// link real, focável pelo teclado e lido pelo leitor de tela; a linha só delega o clique para
// ele. Controles internos (marcador, ⋮, link da pasta, itens do menu) seguem com a ação deles,
// e quem está selecionando texto não é levado para outra página. Como num link: Ctrl, Cmd,
// Shift ou o botão do meio (que chega como `auxclick`) abrem em outra aba ou janela.
function abrirMetaPelaLinha(e) {
    var linha = e.target.closest('[data-mm-linha-clicavel]');
    if (!linha || e.defaultPrevented) { return; }
    var meio = e.type === 'auxclick';
    if (meio ? e.button !== 1 : e.button !== 0) { return; }
    if (e.target.closest('a, button, input, select, textarea, label, .dropdown-menu')) { return; }
    var selecao = window.getSelection ? String(window.getSelection()) : '';
    if (selecao !== '') { return; }

    var titulo = linha.querySelector('a.mm-meta-titulo');
    if (!titulo) { return; }
    if (meio || e.ctrlKey || e.metaKey || e.shiftKey) {
        e.preventDefault();
        window.open(titulo.href, '_blank', 'noopener');
        return;
    }
    titulo.click();
}
document.addEventListener('click', abrirMetaPelaLinha);
document.addEventListener('auxclick', abrirMetaPelaLinha);

/* "Encaminhar via Chat I.A" no ⋮ do cartão (R223): só ids, lidos dos `data-*` que o Twig renderizou; o despacho é da
   janela da Central (`bj-central:despachar`, spec encaminhar-via-chat-ia §4.1). O dropdown fecha sozinho. */
document.addEventListener('click', function (e) {
    var item = e.target.closest('.js-mm-encaminhar');
    if (!item) { return; }
    var pastaId = Number(item.getAttribute('data-encaminhar-pasta'));
    var itemId  = Number(item.getAttribute('data-encaminhar-id'));
    if (!pastaId || !itemId || item.getAttribute('data-encaminhar-tipo') !== 'meta') { return; }
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('bj-central:despachar', {
        detail: { pastaId: pastaId, tipo: 'meta', itemId: itemId }
    }));
});
</script>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<link rel="stylesheet" href="{{ asset('css/minhas-metas.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-numero-global.css') }}">
{% endblock %}
