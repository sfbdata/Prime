{% extends 'base.html.twig' %}

{% block title %}Minhas Metas{% endblock %}

{% block body %}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="bi bi-check2-square me-2"></i>Minhas Metas</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item active">Minhas Metas</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div data-filtro-root data-filtro-endpoint="{{ path('tarefa_minhas') }}">
            {{ include('_partials/_filtro_barra.html.twig', {
                busca_placeholder: 'Buscar por título ou descrição da meta…',
                filtros: filtros,
                facetas: [
                    { name: 'status', rotulo: 'Status', tipo: 'select', opcoes: [
                        { valor: 'pendente', label: 'Pendente' },
                        { valor: 'em_revisao', label: 'Para Revisão' },
                        { valor: 'concluida', label: 'Concluída' }
                    ] },
                    { name: 'prioridade', rotulo: 'Prioridade', tipo: 'select', opcoes: [
                        { valor: 'normal', label: 'Normal' },
                        { valor: 'prioridade', label: 'Prioridade' },
                        { valor: 'urgente', label: 'Urgente' }
                    ] },
                    { name: 'prazo', rotulo: 'Prazo', tipo: 'select', opcoes: [
                        { valor: 'vencidas', label: 'Vencidas' },
                        { valor: 'proximas', label: 'Próximas (7 dias)' },
                        { valor: 'sem', label: 'Sem prazo' }
                    ] }
                ]
            }) }}

            <div data-filtro-resultado>
                {{ include('tarefa/_resultado.html.twig') }}
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
{% endblock %}
