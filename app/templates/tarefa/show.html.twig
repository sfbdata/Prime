    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid #dee2e6;
    background: #f8f9fa;
}
.tarefa-status-card.status-pendente { border-color: #adb5bd; background: #f8f9fa; }
.tarefa-status-card.status-em_revisao { border-color: #ffc107; background: #fff9e6; }
.tarefa-status-card.status-concluida { border-color: #198754; background: #edf7f1; }

.tarefa-status-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
}
.status-pendente .tarefa-status-icon { color: #6c757d; }
.status-em_revisao .tarefa-status-icon { color: #e6a500; }
.status-concluida .tarefa-status-icon { color: #198754; }

.tarefa-status-titulo {
    font-size: .9rem;
    font-weight: 600;
    color: #212529;
}
.tarefa-status-sub {
    font-size: .75rem;
    color: #9aa0ac;
    margin-top: 2px;
}

/* ── Timeline ── */
.tarefa-timeline-icon {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: .78rem;
    flex-shrink: 0;
}
.tarefa-timeline-body {
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 6px 10px;
    background: #fafafa;
    min-width: 0;
}
.tarefa-timeline-body--mensagem {
    border-left: 3px solid #0dcaf0;
    background: rgba(13,202,240,.04);
    border-radius: 0 6px 6px 0;
}

/* ── Chip de arquivo anexado ── */
.tarefa-anexo-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.tarefa-anexo-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f0f4ff;
    border: 1px solid #c5d5f8;
