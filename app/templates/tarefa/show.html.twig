{% extends 'base.html.twig' %}

{% block title %}{{ 'metas.detalhe.titulo'|trans({id: (tarefa.numero ?? tarefa.id) ~ ''}) }}{% endblock %}

{# O fundo #f3f6f8 e o respiro da página (desenho 04B L17 e L34) valem só aqui: meta-detalhe.css pendura tudo em .meta-body. #}
{% block body_class %}meta-body{% endblock %}

{% block body %}
{# Editor rico (barra de formatação). Quill auto-hospedado — sem CDN externo. #}
<link rel="stylesheet" href="{{ asset('js/quill/quill.snow.css') }}">
<link rel="stylesheet" href="{{ asset('css/editor-rico.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-despacho.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-detalhe.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-passagem.css') }}">
<script src="{{ asset('js/quill/quill.js') }}"></script>
<script src="{{ asset('js/editor-rico.js') }}" defer></script>
<script src="{{ asset('js/pasta-mencoes.js') }}" defer></script>
<script src="{{ asset('js/meta-detalhe.js') }}" defer></script>
<script src="{{ asset('js/meta-despacho.js') }}" defer></script>
<script src="{{ asset('js/meta-passagem.js') }}" defer></script>

{# Moldura do desenho 04B (L34): blocos soltos, até 1280px no centro, 14px entre eles. #}
<div class="meta-moldura">

    {# Cabeçalho (L35-39): seta de voltar às metas, "Meta #N" (número da meta no escritório; sem número, o id) e a
       trilha "Expediente / Pasta X / Meta". #}
    <div class="meta-cabeca">
        <a href="{{ path('tarefa_minhas') }}" class="meta-voltar" title="{{ 'metas.detalhe.voltar_as_metas'|trans }}" aria-label="{{ 'metas.detalhe.voltar_as_metas'|trans }}"><i class="bi bi-arrow-left"></i></a>
        <h1 class="meta-titulo"><i class="bi bi-list-check"></i>{{ 'metas.detalhe.titulo'|trans({id: (tarefa.numero ?? tarefa.id) ~ ''}) }}</h1>
        <span class="meta-cabeca-espaco"></span>
        <nav class="meta-trilha" aria-label="{{ 'metas.detalhe.trilha.rotulo'|trans }}"><a href="{{ path('expediente_index') }}">{{ 'metas.detalhe.trilha.expediente'|trans }}</a> / <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}">{{ 'metas.detalhe.trilha.pasta'|trans({nup: tarefa.pasta.nup ~ ''}) }}</a> / {{ 'metas.detalhe.trilha.meta'|trans }}</nav>
    </div>

    {# Trilho ETAPA DA PASTA (L42-44), entre o cabeçalho e as colunas. #}
    {{ include('tarefa/_meta_etapa_trilho.html.twig') }}

    {# Colunas (L47): a meta (flex 999 1 520px) e a lateral (flex 1 1 300px); na tela estreita a lateral desce. #}
    <div class="meta-colunas">

        <section class="meta-principal">
            {# Título da meta (L49) #}
            <div class="meta-principal-titulo"><b>{{ tarefa.titulo }}</b></div>

            {# Faixa "Aguardando" (L50) #}
            {{ include('tarefa/_meta_aguardando.html.twig') }}

            {# Pasta e DEMANDA (L52-54) #}
            <div class="meta-demanda">
                <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}" class="meta-pasta" title="{{ 'metas.detalhe.abrir_a_pasta'|trans }}"><i class="bi bi-folder2-open"></i>{{ 'metas.detalhe.pasta'|trans({nup: tarefa.pasta.nup ~ ''}) }}{% set nomeDaPasta = identificador_pasta(tarefa.pasta) %}{% if nomeDaPasta %}<span class="meta-pasta-cliente">· {{ nomeDaPasta }}</span>{% endif %}</a>
                <div class="meta-demanda-rotulo">{{ 'metas.detalhe.demanda'|trans }}</div>
                <div class="meta-demanda-texto">{{ tarefa.descricao|trim is not empty ? tarefa.descricao|nl2br : 'metas.detalhe.sem_descricao'|trans }}</div>
            </div>

            {# DESPACHO (L56-71): faixa do mesmo cartão, com o Extrato à direita (L150). A folha abre em janela nova e
               já pede a impressão; sem JS, o link abre a folha do mesmo jeito. #}
            <div class="meta-historico" id="tarefa-timeline-card">
                <div class="despacho-cabeca-bloco">
                    <b class="despacho-titulo">{{ 'metas.detalhe.despacho_titulo'|trans }}</b>
                    <a href="{{ path('tarefa_extrato', {id: tarefa.id}) }}" target="_blank" rel="noopener" class="despacho-extrato" data-extrato
                       title="{{ 'metas.despacho.extrato_dica'|trans }}"><i class="bi bi-printer"></i>{{ 'metas.despacho.extrato'|trans }}</a>
                </div>

                {# Campo do despacho + ação (L58-66), sempre visível, também na meta concluída: lá o despacho entra
                   como registro, sem mudar o status. #}
                {{ include('tarefa/_despacho_formulario.html.twig', {formulario: despachos.formulario}) }}

                {# Linha do tempo (L69-71): sem separador por data, sem rolagem própria; "DESPACHO N" do mais antigo
                   ao mais novo; o traço vertical liga cada marcador ao seguinte. #}
                {% if linhaDoTempo is empty %}
                    <div class="despacho-vazio"><i class="bi bi-clock"></i>{{ 'metas.detalhe.sem_eventos'|trans }}</div>
                {% endif %}
                <div id="timelineList" class="despacho-lista">
                    {% for l in linhaDoTempo %}
                        {{ include('tarefa/_despacho.html.twig', {ultimo: loop.last}) }}
                    {% endfor %}
                </div>
            </div>
        </section>

        {# Lateral (L76-85): situação, Concluir e passar adiante, Acompanhar e DETALHES, 10px entre eles. #}
        <aside class="meta-lateral">

            {{ include('tarefa/_meta_situacao.html.twig') }}

            {# Concluir e passar adiante, Próximo passo e Devolver para X (L78-82; D3). Concluir, do responsável ou do
               criador; Devolver, só do responsável que não criou a meta, na meta pendente. #}
            {% if etapa.podeConcluir or etapa.podeDevolver %}
            <div class="mp-lateral">
                {% if etapa.podeConcluir %}
                <button type="button" class="mp-concluir" data-mp-abrir="{{ path('tarefa_passagem', {id: tarefa.id}) }}">
                    <i class="bi bi-check2-circle"></i>{{ etapa.proxima ? 'metas.passagem.concluir_e_passar'|trans({etapa: etapa.proxima}) : 'metas.passagem.concluir_meta'|trans }}
                </button>
                <div class="mp-lateral-proximo">{{ etapa.proxima ? 'metas.passagem.proximo_passo'|trans({etapa: etapa.proxima, setor: etapa.setorDaProxima}) : 'metas.passagem.ultima_etapa'|trans }}</div>
                {% endif %}
                {% if etapa.podeDevolver %}
                <button type="button" class="mp-devolver" data-mp-devolver>
                    <i class="bi bi-arrow-return-left"></i>{{ 'metas.passagem.devolver_para'|trans({nome: etapa.devolverPara}) }}
                </button>
                {% endif %}
            </div>
            {% endif %}

            {# Acompanhar (L83-84): marcação PESSOAL, não muda a meta para os colegas. #}
            {% set acompanhando = tarefa.ehAcompanhadaPor(app.user) %}
            <button type="button"
                    id="btnAcompanharMeta"
                    class="meta-acompanhar{% if acompanhando %} is-ativo{% endif %}"
                    data-url="{{ path('tarefa_acompanhar', {id: tarefa.id}) }}"
                    data-token="{{ csrf_token('acompanhar_tarefa_' ~ tarefa.id) }}"
                    aria-pressed="{{ acompanhando ? 'true' : 'false' }}">
                <i class="bi {{ acompanhando ? 'bi-bookmark-fill' : 'bi-bookmark' }}"></i><span>{{ (acompanhando ? 'metas.detalhe.acompanhando' : 'metas.detalhe.acompanhar')|trans }}</span>
            </button>
            <div class="meta-so-voce">{{ 'metas.detalhe.so_voce_ve'|trans }}</div>

            {# DETALHES DA META (L85). A lateral termina aqui: o voltar é pela seta e pela trilha do cabeçalho. #}
            {{ include('tarefa/_meta_detalhes.html.twig') }}

        </aside>
    </div>
</div>

{# O aviso (toast) do desenho (L176) depois do Lembrar (L133). Vem na URL, não em flash: o base.html.twig consome os
   flashes (e o meta-detalhe.js os mostra neste mesmo aviso). O meta-despacho.js tira o parâmetro da barra de endereço. #}
{% if app.request.query.get('lembrete') == 'enviado' %}
    <div class="meta-toast" role="status" data-meta-toast><i class="bi bi-check-circle"></i>{{ 'metas.detalhe.aguardando.lembrete_enviado'|trans }}</div>
{% endif %}

{# Janelas da página. O desenho usa prompt(); aqui vão no componente de janela do próprio desenho, o da devolução
   (L106): cabeçalho #0a6fa0, cantos de 3px. Abrem pelo data-md-abrir; fecham no X, no Cancelar, no fundo e no Esc
   (meta-detalhe.js). #}

{# Responsáveis (L85, "Alterar" de RESPONSÁVEIS) #}
<div class="md-modal" id="modalEditarResponsaveis" hidden>
    <div class="md-modal-fundo" data-md-fechar></div>
    <div class="md-modal-centro">
        <form class="md-modal-caixa" role="dialog" aria-modal="true" aria-labelledby="modalEditarResponsaveisLabel"
              method="post" action="{{ path('tarefa_update_responsaveis', {id: tarefa.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('update_responsaveis_' ~ tarefa.id) }}">
            <div class="md-modal-cabeca">
                <i class="bi bi-people" aria-hidden="true"></i>
                <b id="modalEditarResponsaveisLabel">{{ 'metas.detalhe.responsaveis_titulo'|trans }}</b>
                <button type="button" class="md-modal-x" data-md-fechar aria-label="{{ 'metas.detalhe.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="md-modal-corpo">
                <div class="md-texto">{{ 'metas.detalhe.responsaveis_sub'|trans }}</div>
                <input type="text" id="buscaResponsavel" class="md-campo" placeholder="{{ 'metas.detalhe.buscar_membro'|trans }}" autocomplete="off" aria-label="{{ 'metas.detalhe.buscar_membro'|trans }}">
                <div id="listaResponsaveis" class="md-lista">
                    {% for user in users %}
                        {% set iniciais = user.fullName|split(' ')|map(n => n|slice(0,1))|join('')|upper|slice(0,2) %}
                        {% set selecionado = tarefa.responsaveis.contains(user) %}
                        <label class="md-pessoa{% if selecionado %} is-ativo{% endif %}" data-nome="{{ user.fullName|lower }}">
                            <input type="checkbox" name="responsaveis[]" value="{{ user.id }}" class="md-pessoa-marca"{% if selecionado %} checked{% endif %}>
                            <span class="md-pessoa-iniciais">{{ iniciais }}</span>
                            <span class="md-pessoa-nome">{{ user.fullName }}</span>
                            <i class="bi bi-check2 md-pessoa-check" aria-hidden="true"></i>
                        </label>
                    {% endfor %}
                    <div id="respSemResultado" class="md-lista-vazia" hidden>{{ 'metas.detalhe.sem_membro'|trans }}</div>
                </div>
                <div id="responsaveisSelecionados" class="md-escolhidos"></div>
                <div class="md-contagem"><span id="contadorSelecionados">0</span> {{ 'metas.detalhe.responsaveis_selecionados'|trans }}</div>
            </div>
            <div class="md-modal-pe">
                <button type="button" class="md-cancelar" data-md-fechar>{{ 'metas.detalhe.cancelar'|trans }}</button>
                <button type="submit" class="md-confirmar"><i class="bi bi-check2" aria-hidden="true"></i>{{ 'metas.detalhe.salvar_responsaveis'|trans }}</button>
            </div>
        </form>
    </div>
</div>

{% if podeEditarPrazo %}
{# Prazo (L85, "Alterar" de PRAZO; só quem pode) #}
<div class="md-modal" id="modalEditarPrazo" hidden>
    <div class="md-modal-fundo" data-md-fechar></div>
    <div class="md-modal-centro">
        <form class="md-modal-caixa" role="dialog" aria-modal="true" aria-labelledby="modalEditarPrazoLabel"
              method="post" action="{{ path('tarefa_atualizar_prazo', {id: tarefa.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('atualizar_prazo_tarefa_' ~ tarefa.id) }}">
            <div class="md-modal-cabeca">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                <b id="modalEditarPrazoLabel">{{ 'metas.detalhe.prazo_titulo'|trans }}</b>
                <button type="button" class="md-modal-x" data-md-fechar aria-label="{{ 'metas.detalhe.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="md-modal-corpo">
                <label for="campoPrazo" class="md-rotulo">{{ 'metas.detalhe.detalhes.prazo'|trans }}</label>
                <input type="date" id="campoPrazo" name="prazo" class="md-campo" value="{{ tarefa.prazo ? tarefa.prazo|date('Y-m-d') : '' }}">
                <div class="md-texto">{{ 'metas.detalhe.prazo_sub'|trans }}</div>
            </div>
            <div class="md-modal-pe">
                <button type="button" class="md-cancelar" data-md-fechar>{{ 'metas.detalhe.cancelar'|trans }}</button>
                <button type="submit" class="md-confirmar"><i class="bi bi-check2" aria-hidden="true"></i>{{ 'metas.detalhe.salvar_prazo'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

{# Certificar cumprimento de um despacho (L161, C15). O action e o token vêm do botão do despacho (meta-despacho.js). #}
<div class="md-modal" id="modalCertificarDespacho" hidden>
    <div class="md-modal-fundo" data-md-fechar></div>
    <div class="md-modal-centro">
        <form class="md-modal-caixa" role="dialog" aria-modal="true" aria-labelledby="modalCertificarDespachoLabel"
              method="post" action="" id="formCertificarDespacho">
            <input type="hidden" name="_token" value="">
            <div class="md-modal-cabeca">
                <i class="bi bi-patch-check" aria-hidden="true"></i>
                <b id="modalCertificarDespachoLabel">{{ 'metas.despacho.certificar'|trans }}</b>
                <button type="button" class="md-modal-x" data-md-fechar aria-label="{{ 'metas.detalhe.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="md-modal-corpo">
                <label for="certidaoTexto" class="md-rotulo">{{ 'metas.despacho.certidao_rotulo'|trans }}</label>
                <textarea class="md-campo-texto" id="certidaoTexto" name="certidao" rows="4" maxlength="1000" required
                          data-inicio="{{ 'metas.despacho.certidao_inicio'|trans|e('html_attr') }}"></textarea>
                <div class="md-texto">{{ 'metas.despacho.certidao_dica'|trans }}</div>
            </div>
            <div class="md-modal-pe">
                <button type="button" class="md-cancelar" data-md-fechar>{{ 'metas.detalhe.cancelar'|trans }}</button>
                <button type="submit" class="md-confirmar"><i class="bi bi-patch-check" aria-hidden="true"></i>{{ 'metas.despacho.certificar'|trans }}</button>
            </div>
        </form>
    </div>
</div>

{# Visualizador único de documentos (módulo visualizador-documento.js): o anexo antigo do despacho abre aqui. O modal
   é o do módulo (contrato de ids com o VisualizadorDocumento), fora da moldura do desenho. #}
<link rel="stylesheet" href="{{ asset('css/visualizador-documento.css') }}">
<div class="modal fade" id="previewDocModal" tabindex="-1" aria-labelledby="previewDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewDocModalLabel">
                    <i class="bi bi-eye me-1"></i> <span id="previewDocNome"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'metas.detalhe.fechar'|trans }}"></button>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="min-height: 70vh;">
                <div id="previewDocConteudo" class="w-100 h-100"></div>
            </div>
            <div class="modal-footer">
                <a id="previewDocDownload" href="#" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i> {{ 'metas.detalhe.baixar'|trans }}
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">{{ 'metas.detalhe.fechar'|trans }}</button>
            </div>
        </div>
    </div>
</div>
<script src="{{ asset('js/visualizador-documento.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* Conteúdo do preview montado por public/js/visualizador-documento.js */
    VisualizadorDocumento.ligarModal(document.getElementById('previewDocModal'));
});
</script>

{% if etapa.podeConcluir %}{{ include('tarefa/_meta_passagem_modal.html.twig', {contexto: 'meta'}) }}{% endif %}
{% if etapa.podeDevolver %}{{ include('tarefa/_meta_devolucao_modal.html.twig') }}{% endif %}
{{ catalogo_js('metas.detalhe.js', 'metas.despacho.js', 'metas.passagem.js') }}

{% endblock %}
