{% extends 'base.html.twig' %}

{% block title %}Tarefa #{{ tarefa.id }}{% endblock %}

{% set statusBadge = {
    'pendente':    'text-bg-secondary',
    'em_revisao':  'text-bg-warning',
    'concluida':   'text-bg-success',
} %}

{% block body %}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-list-task me-2"></i>Tarefa #{{ tarefa.id }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}">{{ tarefa.pasta.nup }}</a>
                    </li>
                    <li class="breadcrumb-item active">Tarefa</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        {% for type, msgs in app.flashes %}
            {% for msg in msgs %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show mb-3" role="alert">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title fw-semibold">{{ tarefa.titulo }}</h3>
                <div class="card-tools d-flex align-items-center gap-2">
                    <span class="badge {{ statusBadge[tarefa.status] ?? 'text-bg-secondary' }}">
                        {{ statusLabels[tarefa.status] ?? tarefa.status }}
                    </span>
                </div>
            </div>

            <div class="card-body">
                <div class="row">

                    {# ── Coluna principal ── #}
                    <div class="col-12 col-lg-8 order-2 order-lg-1">

                        {# Info boxes #}
                        <div class="row mb-4 g-2">
                            <div class="col-6 col-md-3">
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Criada em</span>
                                    <span class="tarefa-meta-value">{{ tarefa.dataCriacao|date('d/m/Y') }}</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Autor</span>
                                    <span class="tarefa-meta-value text-truncate">
                                        {{ tarefa.criadoPor ? tarefa.criadoPor.fullName : '—' }}
                                    </span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Responsável</span>
                                    <span class="tarefa-meta-value text-truncate">
                                        {{ tarefa.responsavel ? tarefa.responsavel.fullName : '—' }}
                                    </span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                {% set prazoInfo = tarefa.prazoInfo %}
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Prazo</span>
                                    <span class="tarefa-meta-value">
                                        {% if prazoInfo.dias is not null %}
                                            <span class="badge text-bg-{{ prazoInfo.cor }}">{{ prazoInfo.texto }}</span>
                                            <small class="d-block text-muted" style="font-size:.7em;">{{ tarefa.prazo|date('d/m/Y') }}</small>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# Tabs #}
                        <ul class="nav nav-tabs" id="tarefaTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#detalhes"
                                        type="button" role="tab" aria-selected="true">
                                    <i class="bi bi-card-text me-1"></i>Detalhes
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#historico"
                                        type="button" role="tab" aria-selected="false">
                                    <i class="bi bi-clock-history me-1"></i>Histórico
                                    {% if timelineItems|length > 0 %}
                                        <span class="badge text-bg-secondary ms-1">{{ timelineItems|length }}</span>
                                    {% endif %}
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content mt-3">

                            {# ── Tab Detalhes ── #}
                            <div class="tab-pane fade show active" id="detalhes" role="tabpanel">
                                <div class="mb-3">
                                    <p class="text-sm fw-semibold text-muted mb-1">
                                        <i class="bi bi-card-text me-1"></i>Descrição
                                    </p>
                                    <div class="ps-2 text-body">{{ tarefa.descricao|nl2br }}</div>
                                </div>

                                {% if tarefa.dataConclusao %}
                                <div class="mt-3 p-2 rounded bg-success bg-opacity-10 border border-success border-opacity-25">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    <span class="small text-success fw-semibold">
                                        Concluída em {{ tarefa.dataConclusao|date('d/m/Y H:i') }}
                                    </span>
                                </div>
                                {% endif %}
                            </div>

                            {# ── Tab Histórico / Chat ── #}
                            <div class="tab-pane fade" id="historico" role="tabpanel">

                                {# Campo de mensagem + ação #}
                                {% if tarefa.status != 'concluida' %}
                                <div class="border-bottom pb-3 mb-3">
                                    <form id="formTarefaMensagem" method="post"
                                          action="{{ path('tarefa_mensagem', {id: tarefa.id}) }}"
                                          enctype="multipart/form-data">
                                        <input type="hidden" name="_token" value="{{ csrf_token('mensagem_tarefa_' ~ tarefa.id) }}">
                                        <input type="hidden" name="acao" id="acaoMensagem" value="">

                                        <textarea name="mensagem" id="tarefaMensagemConteudo"
                                                  class="form-control form-control-sm mb-2"
                                                  rows="2" maxlength="5000"
                                                  placeholder="Escreva uma observação… (Ctrl+Enter para enviar)"></textarea>

                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <input type="file" name="arquivo_mensagem" class="form-control form-control-sm" style="max-width:260px;">

                                            {# Botões contextuais pelo ciclo de vida #}
                                            {% if tarefa.status == 'pendente' %}
                                                <button type="button" class="btn btn-warning btn-sm ms-auto flex-shrink-0"
                                                        onclick="submeterMensagem('enviar')">
                                                    <i class="bi bi-send me-1"></i>Enviar para Revisão
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                        onclick="submeterMensagem('')">
                                                    <i class="bi bi-chat me-1"></i>Só comentar
                                                </button>
                                            {% elseif tarefa.status == 'em_revisao' %}
                                                <button type="button" class="btn btn-secondary btn-sm ms-auto flex-shrink-0"
                                                        onclick="submeterMensagem('devolver')">
                                                    <i class="bi bi-arrow-return-left me-1"></i>Devolver
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                        onclick="submeterMensagem('')">
                                                    <i class="bi bi-chat me-1"></i>Só comentar
                                                </button>
                                            {% endif %}
                                        </div>
                                    </form>
                                </div>
                                {% endif %}

                                {# Timeline #}
                                <div id="timelineList" style="max-height: 500px; overflow-y: auto; padding: 2px 4px;">
                                    {% if timelineItems|length == 0 %}
                                        <div class="text-center text-muted py-5">
                                            <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-25"></i>
                                            <span class="small">Nenhum evento registrado ainda.</span>
                                        </div>
                                    {% else %}
                                        {% set lastDate = null %}
                                        {% for item in timelineItems %}
                                            {% set currentDate = item.dataHora|date('Y-m-d') %}
                                            {% if currentDate != lastDate %}
                                                <div class="d-flex align-items-center gap-2 my-2">
                                                    <hr class="flex-grow-1 my-0 opacity-25">
                                                    <span class="badge text-bg-light border text-muted small fw-normal px-2">
                                                        {{ item.dataHora|date('d/m/Y') }}
                                                    </span>
                                                    <hr class="flex-grow-1 my-0 opacity-25">
                                                </div>
                                                {% set lastDate = currentDate %}
                                            {% endif %}

                                            <div class="d-flex gap-2 mb-2 tarefa-timeline-entry{% if item.tipo.value == 'mensagem' %} tarefa-timeline-entry--mensagem{% endif %}">
                                                <div class="flex-shrink-0 pt-1">
                                                    <span class="badge rounded-circle tarefa-timeline-icon {{ item.badgeCss }}">
                                                        <i class="bi {{ item.icone }}"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1 tarefa-timeline-body{% if item.tipo.value == 'mensagem' %} tarefa-timeline-body--mensagem{% endif %}">
                                                    <div class="d-flex justify-content-between align-items-start gap-1">
                                                        <span class="fw-semibold small">{{ item.titulo }}</span>
                                                        <small class="text-muted flex-shrink-0">{{ item.dataHora|date('H:i') }}</small>
                                                    </div>
                                                    {% if item.detalhe %}
                                                        <div class="mt-1 small {% if item.tipo.value == 'mensagem' %}text-body{% else %}text-muted{% endif %}">
                                                            {{ item.detalhe|nl2br }}
                                                        </div>
                                                    {% endif %}
                                                    {% if item.autorNome or item.autorEmail %}
                                                        <div class="mt-1">
                                                            <small class="text-muted">
                                                                <i class="bi bi-person me-1"></i>{{ item.autorNome ?? item.autorEmail }}
                                                            </small>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                        <div class="text-center py-2">
                                            <span class="badge text-bg-light border text-muted small fw-normal">
                                                <i class="bi bi-check2-all me-1"></i>Início do histórico
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>

                            </div>
                        </div>{# /tab-content #}

                    </div>{# /col principal #}

                    {# ── Sidebar ── #}
                    <div class="col-12 col-lg-4 order-1 order-lg-2">

                        {# Status visual #}
                        <div class="tarefa-status-card mb-3 status-{{ tarefa.status }}">
                            <div class="tarefa-status-icon">
                                {% if tarefa.status == 'pendente' %}
                                    <i class="bi bi-hourglass-split"></i>
                                {% elseif tarefa.status == 'em_revisao' %}
                                    <i class="bi bi-eye"></i>
                                {% else %}
                                    <i class="bi bi-check-circle-fill"></i>
                                {% endif %}
                            </div>
                            <div>
                                <div class="tarefa-status-titulo">{{ statusLabels[tarefa.status] ?? tarefa.status }}</div>
                                {% if tarefa.dataAlteracao %}
                                    <div class="tarefa-status-sub">Atualizado {{ tarefa.dataAlteracao|date('d/m/Y H:i') }}</div>
                                {% endif %}
                            </div>
                        </div>

                        {# Concluir tarefa #}
                        {% if tarefa.status != 'concluida' %}
                        <div class="mb-3">
                            <form method="post" action="{{ path('tarefa_concluir', {id: tarefa.id}) }}"
                                  onsubmit="return confirm('Confirma a conclusão desta tarefa?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('concluir_tarefa_' ~ tarefa.id) }}">
                                <button type="submit" class="btn btn-success btn-sm w-100">
                                    <i class="bi bi-check2-circle me-1"></i>Concluir Tarefa
                                </button>
                            </form>
                        </div>
                        {% endif %}

                        {# Voltar #}
                        <div class="d-grid">
                            <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}#tarefas"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>Voltar à Pasta
                            </a>
                        </div>

                    </div>{# /sidebar #}

                </div>{# /row #}
            </div>{# /card-body #}
        </div>{# /card #}

    </div>
</section>

<style>
/* ── Meta boxes ── */
.tarefa-meta-box {
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 10px 12px;
    background: #fafafa;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.tarefa-meta-label {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #9aa0ac;
    font-weight: 600;
}
.tarefa-meta-value {
    font-size: .88rem;
    color: #212529;
    font-weight: 500;
    display: block;
}

/* ── Status card ── */
.tarefa-status-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid #dee2e6;
    background: #f8f9fa;
}
.tarefa-status-card.status-pendente { border-color: #adb5bd; background: #f8f9fa; }
.tarefa-status-card.status-em_revisao { border-color: #ffc107; background: #fff9e6; }
.tarefa-status-card.status-concluida { border-color: #198754; background: #edf7f1; }

.tarefa-status-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
}
.status-pendente .tarefa-status-icon { color: #6c757d; }
.status-em_revisao .tarefa-status-icon { color: #e6a500; }
.status-concluida .tarefa-status-icon { color: #198754; }

.tarefa-status-titulo {
    font-size: .9rem;
    font-weight: 600;
    color: #212529;
}
.tarefa-status-sub {
    font-size: .75rem;
    color: #9aa0ac;
    margin-top: 2px;
}

/* ── Timeline ── */
.tarefa-timeline-icon {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: .78rem;
    flex-shrink: 0;
}
.tarefa-timeline-body {
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 6px 10px;
    background: #fafafa;
    min-width: 0;
}
.tarefa-timeline-body--mensagem {
    border-left: 3px solid #0dcaf0;
    background: rgba(13,202,240,.04);
    border-radius: 0 6px 6px 0;
}
</style>

<script>
function submeterMensagem(acao) {
    document.getElementById('acaoMensagem').value = acao;
    document.getElementById('formTarefaMensagem').submit();
}

document.addEventListener('DOMContentLoaded', function () {
    var textarea = document.getElementById('tarefaMensagemConteudo');
    if (textarea) {
        textarea.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                submeterMensagem('');
            }
        });
    }

    // Scroll timeline ao final
    var tl = document.getElementById('timelineList');
    if (tl) tl.scrollTop = tl.scrollHeight;
});
</script>

{% endblock %}
