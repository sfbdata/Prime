{% extends 'base.html.twig' %}

{% block title %}Meta #{{ tarefa.id }}{% endblock %}

{% set statusBadge = {
    'pendente':    'text-bg-secondary',
    'em_revisao':  'text-bg-warning',
    'concluida':   'text-bg-success',
} %}

{% block body %}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-list-task me-2"></i>Meta #{{ tarefa.id }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}">{{ tarefa.pasta.nup }}</a>
                    </li>
                    <li class="breadcrumb-item active">Meta</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        {% for type, msgs in app.flashes %}
            {% for msg in msgs %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show mb-3" role="alert">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title fw-semibold">{{ tarefa.titulo }}</h3>
                <div class="card-tools d-flex align-items-center gap-2">
                    <span class="badge {{ statusBadge[tarefa.status] ?? 'text-bg-secondary' }}">
                        {{ statusLabels[tarefa.status] ?? tarefa.status }}
                    </span>
                </div>
            </div>

            <div class="card-body">
                <div class="row">

                    {# ── Coluna principal ── #}
                    <div class="col-12 col-lg-8 order-2 order-lg-1">

                        {# Info boxes #}
                        <div class="row mb-4 g-2">
                            <div class="col-6 col-md-3">
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Criada em</span>
                                    <span class="tarefa-meta-value">{{ tarefa.dataCriacao|date('d/m/Y') }}</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Autor</span>
                                    <span class="tarefa-meta-value text-truncate">
                                        {{ tarefa.criadoPor ? tarefa.criadoPor.fullName : '—' }}
                                    </span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label d-flex align-items-center">
                                        Responsáveis
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-muted" data-bs-toggle="modal" data-bs-target="#modalEditarResponsaveis" title="Editar responsáveis">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </span>
                                    <span class="tarefa-meta-value">
                                        {% if tarefa.responsaveis|length > 0 %}
                                            {% for resp in tarefa.responsaveis %}
                                                <div class="text-truncate">{{ resp.fullName }}</div>
                                            {% endfor %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                {% set prazoInfo = tarefa.prazoInfo %}
                                <div class="tarefa-meta-box">
                                    <span class="tarefa-meta-label">Prazo</span>
                                    <span class="tarefa-meta-value">
                                        {% if prazoInfo.dias is not null %}
                                            <span class="badge text-bg-{{ prazoInfo.cor }}">{{ prazoInfo.texto }}</span>
                                            <small class="d-block text-muted" style="font-size:.7em;">{{ tarefa.prazo|date('d/m/Y') }}</small>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# ── Detalhes ── #}
                        <div class="mt-3">
                                <div class="mb-3">
                                    <p class="text-sm text-muted mb-1">
                                        <i class="bi bi-folder me-1"></i>Pasta: 
                                        <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}" class="text-decoration-none">{{ tarefa.pasta.nup }}</a>
                                    </p>
                                    <p class="text-sm fw-semibold text-muted mb-1">
                                        <i class="bi bi-card-text me-1"></i>Descrição
                                    </p>
                                    <div class="ps-2 text-body">{{ tarefa.descricao|nl2br }}</div>
                                </div>

                                <hr class="my-4">

                                {% if tarefa.dataConclusao %}
                                <div class="mt-3 p-2 rounded bg-success bg-opacity-10 border border-success border-opacity-25">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    <span class="small text-success fw-semibold">
                                        Concluída em {{ tarefa.dataConclusao|date('d/m/Y H:i') }}
                                    </span>
                                </div>
                                {% endif %}

                                <div class="card mt-4" id="tarefa-timeline-card">
                                    <div class="card-header">
                                        <h3 class="card-title mb-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-clock-history me-1"></i>Histórico
                                            <span class="badge text-bg-secondary" id="timeline-count">{{ timelineItems|length }}</span>
                                        </h3>
                                    </div>

                                    {# Campo de mensagem + ação #}
                                    {% if tarefa.status != 'concluida' %}
                                    <div class="card-body border-bottom pb-3">
                                    <form id="formTarefaMensagem" method="post"
                                          action="{{ path('tarefa_mensagem', {id: tarefa.id}) }}"
                                          enctype="multipart/form-data">
                                        <input type="hidden" name="_token" value="{{ csrf_token('mensagem_tarefa_' ~ tarefa.id) }}">
                                        <input type="hidden" name="acao" id="acaoMensagem" value="">

                                        <textarea name="mensagem" id="tarefaMensagemConteudo"
                                                  class="form-control form-control-sm mb-2"
                                                  rows="2" maxlength="5000"
                                                  placeholder="Escreva uma observação… (Ctrl+Enter para enviar)"></textarea>

                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <input type="file" name="arquivo_mensagem" class="form-control form-control-sm" style="max-width:260px;">

                                            {# Botões contextuais pelo ciclo de vida #}
                                            {% if tarefa.status == 'pendente' %}
                                                <button type="button" class="btn btn-warning btn-sm ms-auto flex-shrink-0"
                                                        onclick="submeterMensagem('enviar')">
                                                    <i class="bi bi-send me-1"></i>Enviar para Revisão
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                        onclick="submeterMensagem('')">
                                                    <i class="bi bi-chat me-1"></i>Só comentar
                                                </button>
                                            {% elseif tarefa.status == 'em_revisao' %}
                                                <button type="button" class="btn btn-secondary btn-sm ms-auto flex-shrink-0"
                                                        onclick="submeterMensagem('devolver')">
                                                    <i class="bi bi-arrow-return-left me-1"></i>Devolver
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                        onclick="submeterMensagem('')">
                                                    <i class="bi bi-chat me-1"></i>Só comentar
                                                </button>
                                            {% endif %}
                                        </div>
                                    </form>
                                </div>
                                {% endif %}

                                {# Timeline #}
                                <div class="card-body p-2">
                                    <div id="timelineList" style="max-height: 480px; overflow-y: auto; padding: 4px 8px;">
                                    {% if timelineItems|length == 0 %}
                                        <div class="text-center text-muted py-5">
                                            <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-25"></i>
                                            <span class="small">Nenhum evento registrado ainda.</span>
                                        </div>
                                    {% else %}
                                        {% set lastDate = null %}
                                        {% for item in timelineItems %}
                                            {% set currentDate = item.dataHora|date('Y-m-d') %}
                                            {% if currentDate != lastDate %}
                                                <div class="d-flex align-items-center gap-2 my-2">
                                                    <hr class="flex-grow-1 my-0 opacity-25">
                                                    <span class="badge text-bg-light border text-muted small fw-normal px-2">
                                                        {{ item.dataHora|date('d/m/Y') }}
                                                    </span>
                                                    <hr class="flex-grow-1 my-0 opacity-25">
                                                </div>
                                                {% set lastDate = currentDate %}
                                            {% endif %}

                                            <div class="d-flex gap-2 mb-2 tarefa-timeline-entry{% if item.tipo.value == 'mensagem' %} tarefa-timeline-entry--mensagem{% endif %}">
                                                <div class="flex-shrink-0 pt-1">
                                                    <span class="badge rounded-circle tarefa-timeline-icon {{ item.badgeCss }}">
                                                        <i class="bi {{ item.icone }}"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1 tarefa-timeline-body{% if item.tipo.value == 'mensagem' %} tarefa-timeline-body--mensagem{% endif %}">
                                                    <div class="d-flex justify-content-between align-items-start gap-1">
                                                        <span class="fw-semibold small">{{ item.titulo }}</span>
                                                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                            {% if item.tipo.value == 'mensagem' and item.detalhe and item.usuarioId == app.user.id and tarefa.status != 'concluida' %}
                                                                <button type="button"
                                                                        class="btn btn-link btn-sm p-0 text-secondary btn-editar-msg"
                                                                        title="Editar mensagem"
                                                                        data-msg-id="{{ item.mensagemId }}"
                                                                        data-conteudo="{{ item.detalhe|e('html_attr') }}"
                                                                        data-csrf="{{ csrf_token('editar_mensagem_tarefa_' ~ item.mensagemId) }}"
                                                                        data-url="{{ path('tarefa_mensagem_editar', {id: item.mensagemId}) }}">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                            {% endif %}
                                                            <small class="text-muted">
                                                                {{ item.dataHora|date('H:i') }}
                                                                {% if item.editadoEm %}<span class="ms-1 fst-italic tarefa-msg-editado">(editado)</span>{% endif %}
                                                            </small>
                                                        </div>
                                                    </div>
                                                    {% if item.detalhe %}
                                                        <div class="mt-1 small tarefa-msg-conteudo {% if item.tipo.value == 'mensagem' %}text-body{% else %}text-muted{% endif %}"
                                                             {% if item.mensagemId %}id="tarefa-msg-conteudo-{{ item.mensagemId }}"{% endif %}>
                                                            {{ item.detalhe|nl2br }}
                                                        </div>
                                                    {% endif %}
                                                    {% if item.arquivoAnexo and item.mensagemId %}
                                                        {% set ext      = item.arquivoAnexo|split('.')|last|lower %}
                                                        {% set mimeMap  = {
                                                            'pdf':  'application/pdf',
                                                            'jpg':  'image/jpeg',
                                                            'jpeg': 'image/jpeg',
                                                            'png':  'image/png',
                                                            'gif':  'image/gif',
                                                            'webp': 'image/webp',
                                                            'svg':  'image/svg+xml',
                                                            'mp3':  'audio/mpeg',
                                                            'mp4':  'video/mp4',
                                                            'webm': 'video/webm',
                                                        } %}
                                                        {% set mime     = mimeMap[ext] ?? 'application/octet-stream' %}
                                                        {% set ehImagem = mime starts with 'image/' %}
                                                        {% set ehPdf    = mime == 'application/pdf' %}
                                                        {% set urlView  = path('tarefa_mensagem_arquivo_view', {id: item.mensagemId}) %}
                                                        <div class="mt-2 tarefa-anexo-wrap">
                                                            <span class="tarefa-anexo-chip">
                                                                <i class="bi {% if ehImagem %}bi-image{% elseif ehPdf %}bi-file-pdf{% else %}bi-file-earmark{% endif %} me-1"></i>
                                                                <span class="tarefa-anexo-nome">{{ item.arquivoAnexo|split('/')|last }}</span>
                                                                <button type="button"
                                                                        class="tarefa-anexo-btn"
                                                                        title="Visualizar arquivo"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#previewDocModal"
                                                                        data-url="{{ urlView }}"
                                                                        data-nome="{{ item.arquivoAnexo|split('/')|last }}"
                                                                        data-mime="{{ mime }}">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </span>
                                                        </div>
                                                    {% endif %}
                                                    {% if item.autorNome or item.autorEmail %}
                                                        <div class="mt-1">
                                                            <small class="text-muted">
                                                                <i class="bi bi-person me-1"></i>{{ item.autorNome ?? item.autorEmail }}
                                                            </small>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                        <div class="text-center py-2">
                                            <span class="badge text-bg-light border text-muted small fw-normal">
                                                <i class="bi bi-check2-all me-1"></i>Início do histórico
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>

                            </div>

                        </div>

                        </div>

                    </div>{# /col principal #}

                    {# ── Sidebar ── #}
                    <div class="col-12 col-lg-4 order-1 order-lg-2">

                        {# Status visual #}
                        <div class="tarefa-status-card mb-3 status-{{ tarefa.status }}">
                            <div class="tarefa-status-icon">
                                {% if tarefa.status == 'pendente' %}
                                    <i class="bi bi-hourglass-split"></i>
                                {% elseif tarefa.status == 'em_revisao' %}
                                    <i class="bi bi-eye"></i>
                                {% else %}
                                    <i class="bi bi-check-circle-fill"></i>
                                {% endif %}
                            </div>
                            <div>
                                <div class="tarefa-status-titulo">{{ statusLabels[tarefa.status] ?? tarefa.status }}</div>
                                {% if tarefa.dataAlteracao %}
                                    <div class="tarefa-status-sub">Atualizado {{ tarefa.dataAlteracao|date('d/m/Y H:i') }}</div>
                                {% endif %}
                            </div>
                        </div>

                        {# Concluir tarefa #}
                        {% if tarefa.status != 'concluida' %}
                        <div class="mb-3">
                            <form method="post" action="{{ path('tarefa_concluir', {id: tarefa.id}) }}"
                                  onsubmit="return confirm('Confirma a conclusão desta meta?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('concluir_tarefa_' ~ tarefa.id) }}">
                                <button type="submit" class="btn btn-success btn-sm w-100">
                                    <i class="bi bi-check2-circle me-1"></i>Concluir Meta
                                </button>
                            </form>
                        </div>
                        {% endif %}

                        {# Voltar #}
                        <div class="d-grid">
                            <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}#tarefas"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>Voltar à Pasta
                            </a>
                        </div>

                    </div>{# /sidebar #}

                </div>{# /row #}
            </div>{# /card-body #}
        </div>{# /card #}

    </div>
</section>

{# Modal para editar responsáveis #}
<div class="modal fade" id="modalEditarResponsaveis" tabindex="-1" aria-labelledby="modalEditarResponsaveisLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <h5 class="modal-title fw-semibold mb-0" id="modalEditarResponsaveisLabel">
                        <i class="bi bi-people-fill me-2 text-primary"></i>Responsáveis pela Meta
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Pesquise e selecione os membros da equipe</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" action="{{ path('tarefa_update_responsaveis', {id: tarefa.id}) }}">
                <div class="modal-body pt-2 pb-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_responsaveis_' ~ tarefa.id) }}">

                    {# Campo de busca #}
                    <div class="resp-search-wrap mb-2">
                        <i class="bi bi-search resp-search-icon"></i>
                        <input type="text" id="buscaResponsavel" class="resp-search-input"
                               placeholder="Buscar membro…" autocomplete="off">
                    </div>

                    {# Lista de usuários #}
                    <div id="listaResponsaveis" class="resp-lista">
                        {% for user in users %}
                            {% set iniciais = user.fullName|split(' ')|map(n => n|slice(0,1))|join('')|upper|slice(0,2) %}
                            {% set selecionado = tarefa.responsaveis.contains(user) %}
                            <label class="resp-item{% if selecionado %} resp-item--ativo{% endif %}"
                                   data-nome="{{ user.fullName|lower }}">
                                <input type="checkbox" name="responsaveis[]"
                                       value="{{ user.id }}"
                                       class="resp-checkbox"
                                       {% if selecionado %}checked{% endif %}>
                                <span class="resp-avatar-md">{{ iniciais }}</span>
                                <span class="resp-nome">{{ user.fullName }}</span>
                                <i class="bi bi-check2 resp-check-icon"></i>
                            </label>
                        {% endfor %}
                        <div id="respSemResultado" class="resp-sem-resultado d-none">
                            <i class="bi bi-person-x"></i> Nenhum membro encontrado.
                        </div>
                    </div>

                    {# Chips dos selecionados #}
                    <div id="responsaveisSelecionados" class="resp-chips-wrap d-flex flex-wrap gap-2 mt-3">
                        {# preenchido por JS #}
                    </div>

                    <div class="mt-2 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-muted" style="font-size:.8rem;"></i>
                        <span class="text-muted" style="font-size:.8rem;">
                            <span id="contadorSelecionados">0</span> responsável(is) selecionado(s)
                        </span>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                        <i class="bi bi-x me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Salvar Responsáveis
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
/* ── Modal Responsáveis — lista nativa ── */

/* Campo de busca */
.resp-search-wrap {
    position: relative;
}
.resp-search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: #adb5bd;
    font-size: .9rem;
    pointer-events: none;
}
.resp-search-input {
    width: 100%;
    border: 1.5px solid #dee2e6;
    border-radius: 8px;
    padding: 8px 12px 8px 34px;
    font-size: .88rem;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
    box-sizing: border-box;
    background: #fff;
}
.resp-search-input:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 3px rgba(13,110,253,.1);
}

/* Lista scrollável */
.resp-lista {
    max-height: 260px;
    overflow-y: auto;
    border: 1.5px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
}
.resp-lista::-webkit-scrollbar { width: 5px; }
.resp-lista::-webkit-scrollbar-track { background: transparent; }
.resp-lista::-webkit-scrollbar-thumb { background: #dee2e6; border-radius: 4px; }

/* Cada linha de usuário */
.resp-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    cursor: pointer;
    border-bottom: 1px solid #f5f5f5;
    transition: background .12s;
    user-select: none;
    margin: 0;
}
.resp-item:last-of-type { border-bottom: none; }
.resp-item:hover { background: #f5f8ff; }
.resp-item--ativo { background: #edf3ff; }
.resp-item--ativo:hover { background: #deeaff; }

/* Esconde o checkbox nativo */
.resp-checkbox { display: none; }

/* Avatar médio */
.resp-avatar-md {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f8ef7, #6c5ce7);
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: .02em;
}
.resp-item--ativo .resp-avatar-md {
    background: linear-gradient(135deg, #1a6ef5, #5b21b6);
}

/* Nome */
.resp-nome {
    flex: 1;
    font-size: .88rem;
    color: #212529;
    font-weight: 400;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.resp-item--ativo .resp-nome { font-weight: 500; color: #1a3a6b; }

/* Ícone de check à direita */
.resp-check-icon {
    font-size: .9rem;
    color: #198754;
    opacity: 0;
    transition: opacity .12s;
    flex-shrink: 0;
}
.resp-item--ativo .resp-check-icon { opacity: 1; }

/* Sem resultado */
.resp-sem-resultado {
    padding: 20px 14px;
    text-align: center;
    font-size: .85rem;
    color: #adb5bd;
}

/* Chips de resumo (avatar sm) */
.resp-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f0f4ff;
    border: 1px solid #c5d5f8;
    border-radius: 20px;
    padding: 3px 10px 3px 4px;
    font-size: .8rem;
    color: #1a3a6b;
}
.resp-avatar-sm {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f8ef7, #6c5ce7);
    color: #fff;
    font-size: .62rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-transform: uppercase;
}

/* ── Meta boxes ── */
.tarefa-meta-box {
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 10px 12px;
    background: #fafafa;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.tarefa-meta-label {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #9aa0ac;
    font-weight: 600;
}
.tarefa-meta-value {
    font-size: .88rem;
    color: #212529;
    font-weight: 500;
    display: block;
}

/* ── Status card ── */
