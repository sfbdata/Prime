    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
}
.tarefa-anexo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #0d6efd;
    color: #fff;
    font-size: .75rem;
    flex-shrink: 0;
    text-decoration: none;
    transition: background .15s;
}
.tarefa-anexo-btn:hover {
    background: #0a58ca;
    color: #fff;
}
</style>

<script>
/* ── Modal Responsáveis — lista nativa ── */
(function () {
    function iniciaisDeNome(nome) {
        return nome.split(' ').filter(Boolean)
            .map(function (p) { return p[0].toUpperCase(); })
            .slice(0, 2).join('');
    }

    function atualizarResumo() {
        var checks   = document.querySelectorAll('.resp-checkbox:checked');
        var container = document.getElementById('responsaveisSelecionados');
        var contador  = document.getElementById('contadorSelecionados');
        if (!container || !contador) return;

        container.innerHTML = '';
        contador.textContent = checks.length;

        checks.forEach(function (cb) {
            var item     = cb.closest('.resp-item');
            var nomeEl   = item ? item.querySelector('.resp-nome') : null;
            var nome     = nomeEl ? nomeEl.textContent.trim() : '';
            var iniciais = iniciaisDeNome(nome);

            var chip = document.createElement('div');
            chip.className = 'resp-chip';

            var av = document.createElement('span');
            av.className = 'resp-avatar-sm';
            av.textContent = iniciais;

            var lbl = document.createElement('span');
            lbl.textContent = nome;

            chip.appendChild(av);
            chip.appendChild(lbl);
            container.appendChild(chip);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('modalEditarResponsaveis');
        if (!modalEl) return;

        /* Inicializa estado visual ao abrir */
        modalEl.addEventListener('shown.bs.modal', function () {
            atualizarResumo();
            var busca = document.getElementById('buscaResponsavel');
            if (busca) { busca.value = ''; busca.focus(); }
        });

        /* Toggle ao clicar na linha */
        var lista = document.getElementById('listaResponsaveis');
        if (lista) {
            lista.addEventListener('change', function (e) {
                if (!e.target.classList.contains('resp-checkbox')) return;
                var item = e.target.closest('.resp-item');
                if (item) item.classList.toggle('resp-item--ativo', e.target.checked);
                atualizarResumo();
            });
        }

        /* Filtro de busca */
        var busca = document.getElementById('buscaResponsavel');
        if (busca) {
            busca.addEventListener('input', function () {
                var q = this.value.toLowerCase().trim();
                var items = document.querySelectorAll('#listaResponsaveis .resp-item');
                var visiveis = 0;
                items.forEach(function (item) {
                    var nome = (item.dataset.nome || '');
                    var visivel = !q || nome.includes(q);
                    item.style.display = visivel ? '' : 'none';
                    if (visivel) visiveis++;
                });
                var semResult = document.getElementById('respSemResultado');
                if (semResult) semResult.classList.toggle('d-none', visiveis > 0);
            });
        }
    });
})();

function submeterMensagem(acao) {
    document.getElementById('acaoMensagem').value = acao;
    document.getElementById('formTarefaMensagem').submit();
}

document.addEventListener('DOMContentLoaded', function () {
    var textarea = document.getElementById('tarefaMensagemConteudo');
    if (textarea) {
        textarea.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                submeterMensagem('');
            }
        });
    }

    // Scroll timeline ao final
    var tl = document.getElementById('timelineList');
    if (tl) tl.scrollTop = tl.scrollHeight;
});

// Edição inline de mensagem do histórico (apenas o autor; espelha _detalhes_obs)
(function () {
    'use strict';

    function esc(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    const timeline = document.getElementById('timelineList');
    if (!timeline) { return; }

    timeline.addEventListener('click', function (e) {
        const btnEditar = e.target.closest('.btn-editar-msg');
        if (!btnEditar) { return; }

        const msgId        = btnEditar.dataset.msgId;
        const conteudoDiv  = document.getElementById('tarefa-msg-conteudo-' + msgId);
        if (!conteudoDiv) { return; }
        const conteudoAtual = btnEditar.dataset.conteudo;

        const textarea = document.createElement('textarea');
        textarea.className = 'form-control form-control-sm w-100 mb-2';
        textarea.rows = 3;
        textarea.maxLength = 5000;
        textarea.value = conteudoAtual;

        const btnConfirmar = document.createElement('button');
        btnConfirmar.type = 'button';
        btnConfirmar.className = 'btn btn-sm btn-success me-1';
        btnConfirmar.textContent = 'Salvar';

        const btnCancelar = document.createElement('button');
        btnCancelar.type = 'button';
        btnCancelar.className = 'btn btn-sm btn-outline-secondary';
        btnCancelar.textContent = 'Cancelar';

        const acoesBtns = document.createElement('div');
        acoesBtns.className = 'mb-1';
        acoesBtns.appendChild(btnConfirmar);
        acoesBtns.appendChild(btnCancelar);

        conteudoDiv.style.display = 'none';
        conteudoDiv.after(textarea);
        textarea.after(acoesBtns);
        textarea.focus();
        btnEditar.disabled = true;

        function encerrarEdicao() {
            textarea.remove();
            acoesBtns.remove();
            conteudoDiv.style.display = '';
            btnEditar.disabled = false;
        }

        btnCancelar.addEventListener('click', encerrarEdicao);

        btnConfirmar.addEventListener('click', async function () {
            const novoConteudo = textarea.value.trim();
            if (novoConteudo === '') { alert('A mensagem não pode ser vazia.'); return; }

            const fd = new FormData();
            fd.append('_token', btnEditar.dataset.csrf);
            fd.append('conteudo', novoConteudo);

            btnConfirmar.disabled = true;

            try {
                const resp = await fetch(btnEditar.dataset.url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                const data = await resp.json();
                if (!resp.ok) {
                    btnConfirmar.disabled = false;
                    alert(data.erro ?? 'Erro ao editar.');
                    return;
                }

                conteudoDiv.innerHTML = esc(data.conteudo).replace(/\n/g, '<br>');
                btnEditar.dataset.conteudo = data.conteudo;

                // Injeta a marca "(editado)" ao lado da hora, se ainda não houver
                const small = btnEditar.parentElement.querySelector('small.text-muted');
                if (small && !small.querySelector('.tarefa-msg-editado')) {
                    const marca = document.createElement('span');
                    marca.className = 'ms-1 fst-italic tarefa-msg-editado';
                    marca.textContent = '(editado)';
                    small.appendChild(marca);
                }

                encerrarEdicao();
            } catch (_) {
                btnConfirmar.disabled = false;
                alert('Erro de rede. Tente novamente.');
            }
        });
    });
})();
</script>

{# Modal: Preview de arquivo do chat #}
<div class="modal fade" id="previewDocModal" tabindex="-1" aria-labelledby="previewDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewDocModalLabel">
                    <i class="bi bi-eye me-1"></i> <span id="previewDocNome"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="min-height: 70vh;">
                <div id="previewDocConteudo" class="w-100 h-100"></div>
            </div>
            <div class="modal-footer">
                <a id="previewDocDownload" href="#" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i> Baixar
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const previewModal    = document.getElementById('previewDocModal');
    const previewConteudo = document.getElementById('previewDocConteudo');
    const previewNome     = document.getElementById('previewDocNome');
    const previewDownload = document.getElementById('previewDocDownload');

    previewModal.addEventListener('show.bs.modal', function (e) {
        const btn  = e.relatedTarget;
        const url  = btn.dataset.url;
        const nome = btn.dataset.nome;
        const mime = btn.dataset.mime;

        previewNome.textContent = nome;
        previewDownload.href = url.replace('/visualizar', '/download');
        previewConteudo.innerHTML = '';

        if (mime === 'application/pdf') {
            previewConteudo.innerHTML =
                `<iframe src="${url}" class="w-100 border-0" style="height:75vh;" title="${nome}"></iframe>`;
        } else if (mime.startsWith('image/')) {
            previewConteudo.innerHTML =
                `<img src="${url}" class="img-fluid d-block mx-auto p-3" style="max-height:75vh;object-fit:contain;" alt="${nome}">`;
        } else if (mime.startsWith('audio/')) {
            previewConteudo.innerHTML =
                `<div class="p-4 text-center w-100">
                    <i class="bi bi-file-earmark-music display-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-3">${nome}</p>
                    <audio controls class="w-100" style="max-width:500px;">
                        <source src="${url}" type="${mime}">
                        Seu navegador não suporta reprodução de áudio.
                    </audio>
                 </div>`;
        } else if (mime.startsWith('video/')) {
            previewConteudo.innerHTML =
                `<video controls class="w-100 d-block" style="max-height:75vh;">
                    <source src="${url}" type="${mime}">
                    Seu navegador não suporta reprodução de vídeo.
                 </video>`;
        } else {
            previewConteudo.innerHTML =
                `<div class="p-5 text-center text-muted w-100">
                    <i class="bi bi-file-earmark display-1 d-block mb-3"></i>
                    <p>Pré-visualização não disponível para este tipo de arquivo.</p>
                    <a href="${url.replace('/visualizar', '/download')}" class="btn btn-primary">
                        <i class="bi bi-download me-1"></i> Baixar arquivo
                    </a>
                 </div>`;
        }
    });

    previewModal.addEventListener('hide.bs.modal', function () {
        previewConteudo.innerHTML = '';
    });
});
</script>

