<script>
// Marcador de acompanhamento — alterna sem sair da página. Marcação PESSOAL: nada muda para
// os colegas, então não há confirmação nem recarga.
(function () {
    var botao = document.getElementById('btnAcompanharMeta');
    if (!botao) { return; }

    botao.addEventListener('click', function () {
        if (botao.disabled) { return; }
        botao.disabled = true;

        var dados = new FormData();
        dados.append('_token', botao.dataset.token);

        fetch(botao.dataset.url, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: dados,
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.sucesso) { return; }
            botao.classList.toggle('btn-primary', d.acompanhando);
            botao.classList.toggle('btn-outline-secondary', !d.acompanhando);
            botao.setAttribute('aria-pressed', d.acompanhando ? 'true' : 'false');
            botao.querySelector('i').className = (d.acompanhando ? 'bi bi-bookmark-fill' : 'bi bi-bookmark') + ' me-1';
            botao.querySelector('span').textContent = d.acompanhando ? BJ_T.t('metas.detalhe.js.acompanhando') : BJ_T.t('metas.detalhe.js.acompanhar');
        })
        .finally(function () { botao.disabled = false; });
    });
}());
</script>

