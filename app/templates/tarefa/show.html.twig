{% extends 'base.html.twig' %}

{% block title %}{{ 'metas.detalhe.titulo'|trans({id: (tarefa.numero ?? tarefa.id) ~ ''}) }}{% endblock %}

{% set statusBadge = {
    'pendente':    'text-bg-secondary',
    'em_revisao':  'text-bg-warning',
    'concluida':   'text-bg-success',
} %}

{% block body %}
{# Editor rico (barra de formatação). Quill auto-hospedado — sem CDN externo. #}
<link rel="stylesheet" href="{{ asset('js/quill/quill.snow.css') }}">
<link rel="stylesheet" href="{{ asset('css/editor-rico.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-numero-global.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-despacho.css') }}">
<link rel="stylesheet" href="{{ asset('css/meta-detalhe.css') }}">
<script src="{{ asset('js/quill/quill.js') }}"></script>
<script src="{{ asset('js/editor-rico.js') }}" defer></script>
<script src="{{ asset('js/meta-despacho.js') }}" defer></script>


{# Cabeçalho (desenho 04B L35-39; spec L5): seta de voltar às metas, "Meta #N" e a trilha
   "Expediente / Pasta X / Meta". #}
<div class="content-header">
    <div class="container-fluid">
        <div class="meta-cabeca mb-2">
            <a href="{{ path('tarefa_minhas') }}" class="meta-voltar" title="{{ 'metas.detalhe.voltar_as_metas'|trans }}" aria-label="{{ 'metas.detalhe.voltar_as_metas'|trans }}"><i class="bi bi-arrow-left"></i></a>
            {# "Meta #N" com o número da meta no escritório (desenho 04B L37); meta sem número cai no id. #}
            <h1 class="m-0 meta-titulo"><i class="bi bi-list-check"></i>{{ 'metas.detalhe.titulo'|trans({id: (tarefa.numero ?? tarefa.id) ~ ''}) }}</h1>
            <span class="meta-cabeca-espaco"></span>
            <nav class="meta-trilha" aria-label="{{ 'metas.detalhe.trilha.rotulo'|trans }}"><a href="{{ path('expediente_index') }}">{{ 'metas.detalhe.trilha.expediente'|trans }}</a> / <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}">{{ 'metas.detalhe.trilha.pasta'|trans({nup: tarefa.pasta.nup ~ ''}) }}</a> / {{ 'metas.detalhe.trilha.meta'|trans }}</nav>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        {% for type, msgs in app.flashes %}
            {% for msg in msgs %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show mb-3" role="alert">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title fw-semibold">{{ tarefa.titulo }}{{ include('tarefa/_numero_global.html.twig', {numero: tarefa.numero, local: numeroNaPasta}) }}</h3>
                <div class="card-tools d-flex align-items-center gap-2">
                    <span class="badge {{ statusBadge[tarefa.status] ?? 'text-bg-secondary' }}">
                        {{ statusLabels[tarefa.status] ?? tarefa.status }}
                    </span>
                </div>
            </div>

            <div class="card-body">
                <div class="row">

                    {# ── Coluna principal ── #}
                    <div class="col-12 col-lg-8 order-2 order-lg-1">

                        {# Faixa "Aguardando" (desenho 04B L50; spec L2). As 4 caixas que ficavam aqui viraram o bloco
                           DETALHES DA META da lateral (L85; spec L4). #}
                        {{ include('tarefa/_meta_aguardando.html.twig') }}

                        {# ── Detalhes ── #}
                        <div class="mt-3">
                                <div class="mb-3">
                                    <p class="text-sm text-muted mb-1">
                                        <i class="bi bi-folder me-1"></i>{{ 'metas.detalhe.pasta'|trans }} 
                                        <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}" class="text-decoration-none">{{ tarefa.pasta.nup }}</a>
                                    </p>
                                    <p class="text-sm fw-semibold text-muted mb-1">
                                        <i class="bi bi-card-text me-1"></i>{{ 'metas.detalhe.descricao'|trans }}
                                    </p>
                                    <div class="ps-2 text-body">{{ tarefa.descricao|nl2br }}</div>
                                </div>

                                <hr class="my-4">

                                {% if tarefa.dataConclusao %}
                                <div class="mt-3 p-2 rounded bg-success bg-opacity-10 border border-success border-opacity-25">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    <span class="small text-success fw-semibold">
                                        {{ 'metas.detalhe.concluida_em'|trans({data: tarefa.dataConclusao|data_hora}) }}
                                    </span>
                                </div>
                                {% endif %}

                                <div class="card mt-4" id="tarefa-timeline-card">
                                    <div class="card-header">
                                        {# Bloco DESPACHO do desenho 04B (L57); o Extrato é da Fase 2b. #}
                                        <h3 class="card-title mb-0 despacho-titulo">{{ 'metas.detalhe.despacho_titulo'|trans }}</h3>
                                    </div>

                                    {# Campo do despacho + ação (desenho 04B L58-66; C10 a C12) #}
                                    {% if tarefa.status != 'concluida' %}
                                        {{ include('tarefa/_despacho_formulario.html.twig', {formulario: despachos.formulario}) }}
                                    {% endif %}

                                {# Timeline #}
                                <div class="card-body p-2">
                                    <div id="timelineList" style="max-height: 480px; overflow-y: auto; padding: 4px 8px;">
                                    {% if timelineItems|length == 0 %}
                                        <div class="text-center text-muted py-5">
                                            <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-25"></i>
                                            <span class="small">{{ 'metas.detalhe.sem_eventos'|trans }}</span>
                                        </div>
                                    {% else %}
                                        {% set lastDate = null %}
                                        {% for item in timelineItems %}
                                            {% set currentDate = item.dataHora|date('Y-m-d') %}
                                            {% if currentDate != lastDate %}
                                                <div class="d-flex align-items-center gap-2 my-2">
                                                    <hr class="flex-grow-1 my-0 opacity-25">
                                                    <span class="badge bg-body-tertiary text-body-secondary border text-muted small fw-normal px-2">
                                                        {{ item.dataHora|data }}
                                                    </span>
                                                    <hr class="flex-grow-1 my-0 opacity-25">
                                                </div>
                                                {% set lastDate = currentDate %}
                                            {% endif %}

                                            {% if item.tipo.value == 'mensagem' and item.mensagemId and despachos.linhas[item.mensagemId] is defined %}
                                                {{ include('tarefa/_despacho.html.twig', {item: item, d: despachos.linhas[item.mensagemId]}) }}
                                            {% else %}
                                            <div class="d-flex gap-2 mb-2 tarefa-timeline-entry{% if item.tipo.value == 'mensagem' %} tarefa-timeline-entry--mensagem{% endif %}">
                                                <div class="flex-shrink-0 pt-1">
                                                    <span class="badge rounded-circle tarefa-timeline-icon {{ item.badgeCss }}">
                                                        <i class="bi {{ item.icone }}"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1 tarefa-timeline-body{% if item.tipo.value == 'mensagem' %} tarefa-timeline-body--mensagem{% endif %}">
                                                    <div class="d-flex justify-content-between align-items-start gap-1">
                                                        <span class="fw-semibold small">{{ item.titulo }}</span>
                                                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                            {% if item.tipo.value == 'mensagem' and item.detalhe and item.usuarioId == app.user.id and tarefa.status != 'concluida' %}
                                                                <button type="button"
                                                                        class="btn btn-link btn-sm p-0 text-secondary btn-editar-msg"
                                                                        title="{{ 'metas.detalhe.editar_mensagem'|trans }}"
                                                                        data-msg-id="{{ item.mensagemId }}"
                                                                        data-conteudo="{{ item.detalhe|e('html_attr') }}"
                                                                        data-conteudo-html="{{ item.detalhe|texto_rico|e('html_attr') }}"
                                                                        data-csrf="{{ csrf_token('editar_mensagem_tarefa_' ~ item.mensagemId) }}"
                                                                        data-url="{{ path('tarefa_mensagem_editar', {id: item.mensagemId}) }}">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                            {% endif %}
                                                            <small class="text-muted">
                                                                {{ item.dataHora|hora }}
                                                                {% if item.editadoEm %}<span class="ms-1 fst-italic tarefa-msg-editado">{{ 'metas.detalhe.editado'|trans }}</span>{% endif %}
                                                            </small>
                                                        </div>
                                                    </div>
                                                    {% if item.detalhe %}
                                                        <div class="mt-1 small tarefa-msg-conteudo {% if item.tipo.value == 'mensagem' %}text-body{% else %}text-muted{% endif %}"
                                                             {% if item.mensagemId %}id="tarefa-msg-conteudo-{{ item.mensagemId }}"{% endif %}>
                                                            {% if item.tipo.value == 'mensagem' %}
                                                                {# Escrito por uma pessoa: passa pelo editor rico. #}
                                                                <span class="editor-rico-conteudo"><span class="ql-editor">{{ item.detalhe|texto_rico }}</span></span>
                                                            {% else %}
                                                                {# Texto do sistema: segue escapado. #}
                                                                {{ item.detalhe|nl2br }}
                                                            {% endif %}
                                                        </div>
                                                    {% endif %}
                                                    {% if item.arquivoAnexo and item.mensagemId %}
                                                        {% set ext      = item.arquivoAnexo|split('.')|last|lower %}
                                                        {% set mimeMap  = {
                                                            'pdf':  'application/pdf',
                                                            'jpg':  'image/jpeg',
                                                            'jpeg': 'image/jpeg',
                                                            'png':  'image/png',
                                                            'gif':  'image/gif',
                                                            'webp': 'image/webp',
                                                            'svg':  'image/svg+xml',
                                                            'mp3':  'audio/mpeg',
                                                            'mp4':  'video/mp4',
                                                            'webm': 'video/webm',
                                                        } %}
                                                        {% set mime     = mimeMap[ext] ?? 'application/octet-stream' %}
                                                        {% set ehImagem = mime starts with 'image/' %}
                                                        {% set ehPdf    = mime == 'application/pdf' %}
                                                        {% set urlView  = path('tarefa_mensagem_arquivo_view', {id: item.mensagemId}) %}
                                                        <div class="mt-2 tarefa-anexo-wrap">
                                                            <span class="tarefa-anexo-chip">
                                                                <i class="bi {% if ehImagem %}bi-image{% elseif ehPdf %}bi-file-pdf{% else %}bi-file-earmark{% endif %} me-1"></i>
                                                                <span class="tarefa-anexo-nome">{{ item.arquivoAnexo|split('/')|last }}</span>
                                                                <button type="button"
                                                                        class="tarefa-anexo-btn"
                                                                        title="{{ 'metas.detalhe.visualizar_arquivo'|trans }}"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#previewDocModal"
                                                                        data-url="{{ urlView }}"
                                                                        data-nome="{{ item.arquivoAnexo|split('/')|last }}"
                                                                        data-mime="{{ mime }}">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </span>
                                                        </div>
                                                    {% endif %}
                                                    {% if item.autorNome or item.autorEmail %}
                                                        <div class="mt-1">
                                                            <small class="text-muted">
                                                                <i class="bi bi-person me-1"></i>{{ item.autorNome ?? item.autorEmail }}
                                                            </small>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            {% endif %}
                                        {% endfor %}
                                        <div class="text-center py-2">
                                            <span class="badge bg-body-tertiary text-body-secondary border text-muted small fw-normal">
                                                <i class="bi bi-check2-all me-1"></i>{{ 'metas.detalhe.inicio_do_historico'|trans }}
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>

                            </div>

                        </div>

                        </div>

                    </div>{# /col principal #}

                    {# ── Sidebar ── #}
                    <div class="col-12 col-lg-4 order-1 order-lg-2">

                        {# Painel de situação (desenho 04B L77; spec L3) #}
                        <div class="mb-3">{{ include('tarefa/_meta_situacao.html.twig') }}</div>

                        {# Acompanhar — marcação PESSOAL: não muda a meta para os colegas. #}
                        {% set acompanhando = tarefa.ehAcompanhadaPor(app.user) %}
                        <div class="mb-3">
                            <button type="button"
                                    id="btnAcompanharMeta"
                                    class="btn btn-sm w-100 {{ acompanhando ? 'btn-primary' : 'btn-outline-secondary' }}"
                                    data-url="{{ path('tarefa_acompanhar', {id: tarefa.id}) }}"
                                    data-token="{{ csrf_token('acompanhar_tarefa_' ~ tarefa.id) }}"
                                    aria-pressed="{{ acompanhando ? 'true' : 'false' }}">
                                <i class="bi {{ acompanhando ? 'bi-bookmark-fill' : 'bi-bookmark' }} me-1"></i>
                                <span>{{ (acompanhando ? 'metas.detalhe.acompanhando' : 'metas.detalhe.acompanhar')|trans }}</span>
                            </button>
                            <div class="form-text small">{{ 'metas.detalhe.so_voce_ve'|trans }}</div>
                        </div>

                        {# Concluir tarefa #}
                        {% if tarefa.status != 'concluida' %}
                        <div class="mb-3">
                            <form method="post" action="{{ path('tarefa_concluir', {id: tarefa.id}) }}"
                                  onsubmit="return confirm('{{ 'metas.detalhe.confirmar_conclusao'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('concluir_tarefa_' ~ tarefa.id) }}">
                                <button type="submit" class="btn btn-success btn-sm w-100">
                                    <i class="bi bi-check2-circle me-1"></i>{{ 'metas.detalhe.concluir_meta'|trans }}
                                </button>
                            </form>
                        </div>
                        {% endif %}

                        {# Excluir meta (somente criador, dentro da janela) #}
                        {% if podeExcluirMeta %}
                        <div class="mb-3">
                            <form method="post" action="{{ path('tarefa_excluir', {id: tarefa.id}) }}"
                                  onsubmit="return confirm('{{ 'metas.detalhe.confirmar_exclusao'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('excluir_tarefa_' ~ tarefa.id) }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-trash me-1"></i>{{ 'metas.detalhe.excluir_meta'|trans }}
                                </button>
                            </form>
                        </div>
                        {% endif %}

                        {# DETALHES DA META (desenho 04B L85; spec L4) #}
                        <div class="mb-3">{{ include('tarefa/_meta_detalhes.html.twig') }}</div>

                        {# Voltar #}
                        <div class="d-grid">
                            <a href="{{ path('pasta_show', {id: tarefa.pasta.id}) }}#tarefas"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>{{ 'metas.detalhe.voltar_a_pasta'|trans }}
                            </a>
                        </div>

                    </div>{# /sidebar #}

                </div>{# /row #}
            </div>{# /card-body #}
        </div>{# /card #}

    </div>
</section>

{# Modal para editar responsáveis #}
<div class="modal fade" id="modalEditarResponsaveis" tabindex="-1" aria-labelledby="modalEditarResponsaveisLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <h5 class="modal-title fw-semibold mb-0" id="modalEditarResponsaveisLabel">
                        <i class="bi bi-people-fill me-2 text-primary"></i>{{ 'metas.detalhe.responsaveis_titulo'|trans }}
                    </h5>
                    <p class="text-muted small mb-0 mt-1">{{ 'metas.detalhe.responsaveis_sub'|trans }}</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'metas.detalhe.fechar'|trans }}"></button>
            </div>
            <form method="post" action="{{ path('tarefa_update_responsaveis', {id: tarefa.id}) }}">
                <div class="modal-body pt-2 pb-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_responsaveis_' ~ tarefa.id) }}">

                    {# Campo de busca #}
                    <div class="resp-search-wrap mb-2">
                        <i class="bi bi-search resp-search-icon"></i>
                        <input type="text" id="buscaResponsavel" class="resp-search-input"
                               placeholder="{{ 'metas.detalhe.buscar_membro'|trans }}" autocomplete="off">
                    </div>

                    {# Lista de usuários #}
                    <div id="listaResponsaveis" class="resp-lista">
                        {% for user in users %}
                            {% set iniciais = user.fullName|split(' ')|map(n => n|slice(0,1))|join('')|upper|slice(0,2) %}
                            {% set selecionado = tarefa.responsaveis.contains(user) %}
                            <label class="resp-item{% if selecionado %} resp-item--ativo{% endif %}"
                                   data-nome="{{ user.fullName|lower }}">
                                <input type="checkbox" name="responsaveis[]"
                                       value="{{ user.id }}"
                                       class="resp-checkbox"
                                       {% if selecionado %}checked{% endif %}>
                                <span class="resp-avatar-md">{{ iniciais }}</span>
                                <span class="resp-nome">{{ user.fullName }}</span>
                                <i class="bi bi-check2 resp-check-icon"></i>
                            </label>
                        {% endfor %}
                        <div id="respSemResultado" class="resp-sem-resultado d-none">
                            <i class="bi bi-person-x"></i> {{ 'metas.detalhe.sem_membro'|trans }}
                        </div>
                    </div>

                    {# Chips dos selecionados #}
                    <div id="responsaveisSelecionados" class="resp-chips-wrap d-flex flex-wrap gap-2 mt-3">
                        {# preenchido por JS #}
                    </div>

                    <div class="mt-2 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-muted" style="font-size:.8rem;"></i>
                        <span class="text-muted" style="font-size:.8rem;">
                            <span id="contadorSelecionados">0</span> {{ 'metas.detalhe.responsaveis_selecionados'|trans }}
                        </span>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                        <i class="bi bi-x me-1"></i>{{ 'metas.detalhe.cancelar'|trans }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>{{ 'metas.detalhe.salvar_responsaveis'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% if podeEditarPrazo %}
{# Modal para alterar o prazo (apenas o criador) #}
<div class="modal fade" id="modalEditarPrazo" tabindex="-1" aria-labelledby="modalEditarPrazoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <h5 class="modal-title fw-semibold mb-0" id="modalEditarPrazoLabel">
                        <i class="bi bi-calendar-event me-2 text-primary"></i>{{ 'metas.detalhe.prazo_titulo'|trans }}
                    </h5>
                    <p class="text-muted small mb-0 mt-1">{{ 'metas.detalhe.prazo_sub'|trans }}</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'metas.detalhe.fechar'|trans }}"></button>
            </div>
            <form method="post" action="{{ path('tarefa_atualizar_prazo', {id: tarefa.id}) }}">
                <div class="modal-body pt-2 pb-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('atualizar_prazo_tarefa_' ~ tarefa.id) }}">
                    <label for="campoPrazo" class="form-label form-label-sm fw-semibold">{{ 'metas.detalhe.prazo'|trans }}</label>
                    <input type="date" id="campoPrazo" name="prazo" class="form-control form-control-sm"
                           value="{{ tarefa.prazo ? tarefa.prazo|date('Y-m-d') : '' }}">
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                        <i class="bi bi-x me-1"></i>{{ 'metas.detalhe.cancelar'|trans }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>{{ 'metas.detalhe.salvar_prazo'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<style>
/* ── Modal Responsáveis — lista nativa ── */

/* Campo de busca */
.resp-search-wrap {
    position: relative;
}
.resp-search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--bs-secondary-color);
    font-size: .9rem;
    pointer-events: none;
}
.resp-search-input {
    width: 100%;
    border: 1.5px solid var(--bs-border-color);
    border-radius: 8px;
    padding: 8px 12px 8px 34px;
    font-size: .88rem;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
    box-sizing: border-box;
    background: var(--bs-body-bg);
}
.resp-search-input:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 3px rgba(13,110,253,.1);
}

/* Lista scrollável */
.resp-lista {
    max-height: 260px;
    overflow-y: auto;
    border: 1.5px solid var(--bs-border-color);
    border-radius: 8px;
    background: var(--bs-body-bg);
}
.resp-lista::-webkit-scrollbar { width: 5px; }
.resp-lista::-webkit-scrollbar-track { background: transparent; }
.resp-lista::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 4px; }

/* Cada linha de usuário */
.resp-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    cursor: pointer;
    border-bottom: 1px solid var(--bs-border-color);
    transition: background .12s;
    user-select: none;
    margin: 0;
}
.resp-item:last-of-type { border-bottom: none; }
.resp-item:hover { background: var(--bs-secondary-bg); }
.resp-item--ativo { background: var(--bs-secondary-bg); }
.resp-item--ativo:hover { background: var(--bs-secondary-bg); }

/* Esconde o checkbox nativo */
.resp-checkbox { display: none; }

/* Avatar médio */
.resp-avatar-md {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f8ef7, #6c5ce7);
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: .02em;
}
.resp-item--ativo .resp-avatar-md {
