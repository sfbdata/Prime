{# Uma meta no modo cartões.
   `meta` = App\Entity\Tarefa\Tarefa · `tom` = tom do grupo que a contém (pinta a faixa lateral)
   O número antes do título é o da meta NA PASTA (R239, decisão do dono 14/10), o mesmo da aba Metas da
   pasta; vem pré-carregado em `painel.numeroNaPasta`. Número global não existe por escritório: não aparece. #}
{# Vem pré-carregado do UseCase: perguntar à entidade custaria uma consulta por linha. #}
{% set acompanhando = painel.estaAcompanhando(meta.id) %}

{# Pílula e texto do prazo do desenho de 13/10, derivados do dado real pela regra que escolhe o grupo. #}
{% set status = painel.statusDaMeta(meta) %}
{% set prazo = painel.prazoDaMeta(meta) %}

<article class="mm-meta tom-{{ tom }}">
    <div class="mm-meta-corpo">
        <div class="mm-meta-topo">
            {% set numPasta = painel.numeroNaPasta(meta.id) %}
            <a href="{{ path('tarefa_show', {id: meta.id}) }}" class="mm-meta-titulo" title="{{ meta.titulo }}">{% if numPasta %}<span class="mm-meta-num" title="Meta {{ numPasta }} da pasta {{ meta.pasta.nup }}">{{ numPasta }}.</span>{% endif %}{{ meta.titulo }}</a>
            {% if meta.pasta.prioridade.value != 'normal' %}
                <span class="mm-prioridade tom-{{ meta.pasta.prioridade.value == 'urgente' ? 'danger' : 'warn' }}">
                    <i class="bi bi-flag-fill"></i>{{ meta.pasta.prioridadeLabel }}
                </span>
            {% endif %}
        </div>

        <div class="mm-meta-linha2">
            <a href="{{ path('pasta_show', {id: meta.pasta.id}) }}" class="mm-meta-info" title="Abrir a pasta">
                {# Corte no Twig, não no CSS: aqui o texto é um item flex no meio de outros,
                   e `text-overflow` num flex item sem largura fixa não corta nada. #}
                <i class="bi bi-folder"></i>{{ meta.pasta.nup }}{% if meta.pasta.nomeCliente %} · {{ meta.pasta.nomeCliente|length > 38 ? meta.pasta.nomeCliente|slice(0, 38) ~ '…' : meta.pasta.nomeCliente }}{% endif %}
            </a>

            {% if painel.aba.value == 'responsavel' %}
                <span class="mm-meta-info" title="Quem delegou esta meta">
                    <i class="bi bi-person"></i>{{ meta.criadoPor ? 'de ' ~ meta.criadoPor.fullName : 'sem criador' }}
                </span>
            {% elseif meta.responsaveis|length > 0 %}
                <span class="mm-meta-info" title="Responsáveis: {{ meta.responsaveis|map(r => r.fullName)|join(', ') }}">
                    <i class="bi bi-people"></i>{{ (meta.responsaveis|first).fullName }}{% if meta.responsaveis|length > 1 %} +{{ meta.responsaveis|length - 1 }}{% endif %}
                </span>
            {% else %}
                <span class="mm-meta-info"><i class="bi bi-people"></i>sem responsável</span>
            {% endif %}

            <span class="mm-prazo{{ prazo.atrasado ? ' is-atrasado' : '' }}"{% if meta.prazo %} title="Prazo: {{ meta.prazo|date('d/m/Y') }}"{% endif %}>
                <i class="bi bi-calendar-event"></i>{{ prazo.texto }}
            </span>

            {% set comentarios = painel.totalDeMensagens(meta.id) %}
            {% if comentarios > 0 %}
                <span class="mm-meta-info" title="Comentários na meta">
                    <i class="bi bi-chat"></i>{{ comentarios }}
                </span>
            {% endif %}
        </div>
    </div>

    <div class="mm-meta-lado">
        <span class="mm-pilula tom-{{ status.tom }}">{{ status.rotulo }}</span>
        <span class="mm-meta-datas">
            criada {{ meta.dataCriacao|date('d/m/Y') }}{% if meta.dataAlteracao %} · mod. {{ meta.dataAlteracao|date('d/m/Y') }}{% endif %}
        </span>
    </div>

    <div class="mm-meta-acoes">
        <button type="button"
                class="mm-marcador {{ acompanhando ? 'is-marcada' : '' }}"
                data-acompanhar="{{ path('tarefa_acompanhar', {id: meta.id}) }}"
                data-token="{{ csrf_token('acompanhar_tarefa_' ~ meta.id) }}"
                aria-pressed="{{ acompanhando ? 'true' : 'false' }}"
                title="{{ acompanhando ? 'Deixar de acompanhar' : 'Acompanhar' }}">
            <i class="bi {{ acompanhando ? 'bi-bookmark-fill' : 'bi-bookmark' }}"></i>
        </button>
        {# ⋮ "Opções" do desenho (dc L98) com os itens que a especificação pede (R118, R236) e que já
           existem no sistema — o ⋮ do protótipo só alternava o marcador, defeito não reproduzido.
           "Abrir relatório completo" mantém o acesso à meta que a antiga seta dava. Os outros dois
           levam à aba Metas da pasta com a meta realçada (PMC-044); "Editar nome" abre ali a edição
           que já existe no ⋮ da pasta (pasta-metas.js, `acao=renomear`), com a mesma regra de
           exibição: pasta excluída é somente leitura. "Encaminhar via Chat I.A" (R223, MM-MENU-11) vem por
           último, como a especificação lista, com o mesmo ícone do ⋮ da aba Metas (D:3737): só ids em
           `data-*` (a pasta da meta e a meta), o clique dispara `bj-central:despachar` (script de
           minhas.html.twig). Só com a Central (`encaminharMetas`, do _resultado) e fora da lápide.
           `strategy: fixed` tira o menu do recorte do cartão (`overflow: hidden`). #}
        <div class="dropdown mm-menu">
            <button type="button" class="mm-acao-icone" title="Opções" aria-label="Opções da meta"
                    data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item mm-menu-item" href="{{ path('tarefa_show', {id: meta.id}) }}"><i class="bi bi-file-earmark-text"></i>Abrir relatório completo</a></li>
                <li><a class="dropdown-item mm-menu-item" href="{{ path('pasta_show', {id: meta.pasta.id, meta: meta.id}) }}#tarefas"><i class="bi bi-folder2-open"></i>Ir para a aba Metas da pasta</a></li>
                {% if not meta.pasta.estaExcluida %}
                    <li><a class="dropdown-item mm-menu-item" href="{{ path('pasta_show', {id: meta.pasta.id, meta: meta.id, acao: 'renomear'}) }}#tarefas"><i class="bi bi-pencil"></i>Editar nome</a></li>
                {% endif %}
                {% if encaminharMetas|default(false) and meta.pasta and not meta.pasta.estaExcluida %}
                    <li><button type="button" class="dropdown-item mm-menu-item js-mm-encaminhar" data-encaminhar-pasta="{{ meta.pasta.id }}" data-encaminhar-tipo="meta" data-encaminhar-id="{{ meta.id }}"><i class="bi bi-send"></i>Encaminhar via Chat I.A</button></li>
                {% endif %}
            </ul>
        </div>
    </div>
</article>
