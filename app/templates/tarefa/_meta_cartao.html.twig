{# Uma meta do grupo (desenho 04 de 22/10, dc L87-103).
   `meta` = App\Entity\Tarefa\Tarefa · `tom` = tom do grupo (pinta a faixa lateral) · `numero` = posição da meta no
   grupo, que recomeça em 1 a cada grupo (dc `m.num`; decisão do dono de 22/10, no lugar do nº na pasta).
   Filhos diretos como no desenho: corpo, lado, marcador e "Concluir etapa". #}
{# Vem pré-carregado do UseCase: perguntar à entidade custaria uma consulta por linha. #}
{% set acompanhando = painel.estaAcompanhando(meta.id) %}

{# Pílula e texto do prazo, derivados do dado real pela regra que escolhe o grupo. #}
{% set status = painel.statusDaMeta(meta) %}
{% set prazo = painel.prazoDaMeta(meta) %}

{# A linha inteira abre a meta (dc L87): `data-mm-linha-clicavel` liga a delegação em minhas.html.twig, que repassa o
   clique para o título (o link real, o único focável). #}
<article class="mm-meta tom-{{ tom }}" data-mm-linha-clicavel>
    <div class="mm-meta-corpo">
        <a href="{{ path('tarefa_show', {id: meta.id}) }}" class="mm-meta-titulo" title="{{ meta.titulo }}"><span class="mm-meta-num">{{ numero }}.</span>{{ meta.titulo }}</a>

        <div class="mm-meta-linha2">
            {# Pasta (dc L91): bi-folder2, nº em negrito azul, " · " e o nome do cliente. Continua sendo o link da pasta. #}
            <a href="{{ path('pasta_show', {id: meta.pasta.id}) }}" class="mm-meta-info mm-meta-pasta" title="{{ 'metas.cartao.abrir_a_pasta'|trans }}">
                <i class="bi bi-folder2"></i><b class="mm-meta-pasta-num">{{ meta.pasta.nup }}</b>{% set nomeDaPasta = identificador_pasta(meta.pasta) %}{% if nomeDaPasta %} · {{ nomeDaPasta }}{% endif %}
            </a>

            {# Sempre "de {quem criou}" (dc L92), em qualquer aba. #}
            <span class="mm-meta-info" title="{{ 'metas.cartao.quem_delegou'|trans }}">
                <i class="bi bi-person"></i>{{ meta.criadoPor ? 'metas.comum.de_criador'|trans({nome: meta.criadoPor.fullName}) : 'metas.cartao.sem_criador'|trans }}
            </span>

            <span class="mm-prazo{{ prazo.atrasado ? ' is-atrasado' : '' }}"{% if meta.prazo %} title="{{ 'metas.cartao.prazo_dica'|trans({data: meta.prazo|data}) }}"{% endif %}>
                <i class="bi bi-calendar-event"></i>{{ prazo.texto }}
            </span>
        </div>

        {# Etapa da pasta (dc L94): "i/T · Etapa" e, enquanto não concluída, a próxima com o setor.
           Etapa fora da sequência do tipo de demanda (consultoria em Acompanhamento) mostra só o nome. #}
        {% set et = painel.etapaDaMeta(meta) %}
        {% set nomeDaEtapa = et.nome ?? et.etapa.rotulo|trans %}
        <div class="mm-meta-etapa">
            <span class="mm-meta-etapa-chip" title="{{ 'metas.cartao.etapa_dica'|trans }}">
                <i class="bi {{ et.etapa.icone }}" aria-hidden="true"></i>{{ et.posicao ? 'metas.cartao.etapa'|trans({posicao: et.posicao, total: et.total, etapa: nomeDaEtapa}) : nomeDaEtapa }}
            </span>
            {% if et.proxima %}
                <span class="mm-meta-etapa-proximo">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>{{ 'metas.cartao.proximo'|trans({etapa: et.nomeDaProxima ?? et.proxima.rotulo|trans, setor: et.proxima.setor|trans}) }}
                </span>
            {% endif %}
        </div>
    </div>

    <div class="mm-meta-lado">
        <span class="mm-pilula tom-{{ status.tom }}">{{ status.rotulo|trans }}</span>
        <span class="mm-meta-datas">{{ 'metas.cartao.criada_em'|trans({data: meta.dataCriacao|data}) }}</span>
    </div>

    <button type="button"
            class="mm-marcador {{ acompanhando ? 'is-marcada' : '' }}"
            data-acompanhar="{{ path('tarefa_acompanhar', {id: meta.id}) }}"
            data-token="{{ csrf_token('acompanhar_tarefa_' ~ meta.id) }}"
            aria-pressed="{{ acompanhando ? 'true' : 'false' }}"
            title="{{ acompanhando ? 'metas.marcador.parar_de_acompanhar'|trans : 'metas.marcador.acompanhar_esta_meta'|trans }}">
        <i class="bi {{ acompanhando ? 'bi-bookmark-fill' : 'bi-bookmark' }}"></i>
    </button>
    {# "Concluir etapa" (dc L102; spec Fase 3): abre o modal da passagem. Só na meta aberta (spec 2.2), fora da lápide e
       para o responsável ou quem criou a meta (D3); o servidor confere de novo. #}
    {% if meta.status != 'concluida' and not meta.pasta.estaExcluida and cuida_da_meta(meta, app.user) %}
        {% set proximaDaMeta = et.proxima ? (et.nomeDaProxima ?? et.proxima.rotulo|trans) : null %}
        <button type="button" class="mp-cartao-concluir" data-mp-abrir="{{ path('tarefa_passagem', {id: meta.id}) }}"
                title="{{ proximaDaMeta ? 'metas.passagem.cartao.dica_passar'|trans({etapa: proximaDaMeta}) : 'metas.passagem.cartao.dica_encerrar'|trans }}">
            <i class="bi bi-check2-circle"></i>{{ 'metas.passagem.cartao.concluir_etapa'|trans }}
        </button>
    {% endif %}
</article>
