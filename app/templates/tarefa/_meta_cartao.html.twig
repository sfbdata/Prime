{# Uma meta no modo cartões.
   `meta` = App\Entity\Tarefa\Tarefa · `tom` = tom do grupo que a contém (pinta a faixa lateral)
   O número antes do título é o da meta NA PASTA (R239, decisão do dono 14/10), o mesmo da aba Metas da
   pasta; vem pré-carregado em `painel.numeroNaPasta`. Depois do título, o selo "Nº 0001" (nº da meta no escritório). #}
{# Vem pré-carregado do UseCase: perguntar à entidade custaria uma consulta por linha. #}
{% set acompanhando = painel.estaAcompanhando(meta.id) %}

{# Pílula e texto do prazo do desenho de 13/10, derivados do dado real pela regra que escolhe o grupo. #}
{% set status = painel.statusDaMeta(meta) %}
{% set prazo = painel.prazoDaMeta(meta) %}

{# A linha inteira abre a meta (dc L88, LIS-15): `data-mm-linha-clicavel` liga a delegação em
   minhas.html.twig, que repassa o clique para o título (o link real, o único focável). #}
<article class="mm-meta tom-{{ tom }}" data-mm-linha-clicavel>
    <div class="mm-meta-corpo">
        <div class="mm-meta-topo">
            {% set numPasta = painel.numeroNaPasta(meta.id) %}
            <a href="{{ path('tarefa_show', {id: meta.id}) }}" class="mm-meta-titulo" title="{{ meta.titulo }}">{% if numPasta %}<span class="mm-meta-num" title="{{ 'metas.cartao.num_na_pasta_dica'|trans({numero: numPasta ~ '', nup: meta.pasta.nup ~ ''}) }}">{{ numPasta }}.</span>{% endif %}{{ meta.titulo }}</a>{{ include('tarefa/_numero_global.html.twig', {numero: meta.numero, local: numPasta}) }}
        </div>

        <div class="mm-meta-linha2">
            {# Pasta do desenho (dc L92): bi-folder2, nº em negrito azul, " · " e o nome inteiro do
               cliente (a linha quebra se precisar). Continua sendo o link para a pasta. #}
            <a href="{{ path('pasta_show', {id: meta.pasta.id}) }}" class="mm-meta-info mm-meta-pasta" title="{{ 'metas.cartao.abrir_a_pasta'|trans }}">
                <i class="bi bi-folder2"></i><b class="mm-meta-pasta-num">{{ meta.pasta.nup }}</b>{% if meta.pasta.nomeCliente %} · {{ meta.pasta.nomeCliente }}{% endif %}
            </a>

            {% if painel.aba.value == 'responsavel' %}
                <span class="mm-meta-info" title="{{ 'metas.cartao.quem_delegou'|trans }}">
                    <i class="bi bi-person"></i>{{ meta.criadoPor ? 'metas.comum.de_criador'|trans({nome: meta.criadoPor.fullName}) : 'metas.cartao.sem_criador'|trans }}
                </span>
            {% elseif meta.responsaveis|length > 0 %}
                {% set nomesResponsaveis = meta.responsaveis|map(r => r.fullName)|join(', ') %}<span class="mm-meta-info" title="{{ 'metas.cartao.responsaveis_dica'|trans({nomes: nomesResponsaveis}) }}">
                    <i class="bi bi-people"></i>{{ (meta.responsaveis|first).fullName }}{% if meta.responsaveis|length > 1 %} +{{ meta.responsaveis|length - 1 }}{% endif %}
                </span>
            {% else %}
                <span class="mm-meta-info"><i class="bi bi-people"></i>{{ 'metas.cartao.sem_responsavel'|trans }}</span>
            {% endif %}

            <span class="mm-prazo{{ prazo.atrasado ? ' is-atrasado' : '' }}"{% if meta.prazo %} title="{{ 'metas.cartao.prazo_dica'|trans({data: meta.prazo|data}) }}"{% endif %}>
                <i class="bi bi-calendar-event"></i>{{ prazo.texto }}
            </span>

            {% set comentarios = painel.totalDeMensagens(meta.id) %}
            {% if comentarios > 0 %}
                <span class="mm-meta-info" title="{{ 'metas.cartao.comentarios'|trans }}">
                    <i class="bi bi-chat"></i>{{ comentarios }}
                </span>
            {% endif %}
        </div>

        {# Etapa da pasta (desenho 22/10, dc L95): "i/T · Etapa" e, enquanto não concluída, a próxima com o setor.
           Etapa fora da sequência do tipo de demanda (consultoria em Acompanhamento) mostra só o nome. #}
        {% set et = painel.etapaDaMeta(meta) %}
        {% set nomeDaEtapa = et.nome ?? et.etapa.rotulo|trans %}
        <div class="mm-meta-etapa">
            <span class="mm-meta-etapa-chip" title="{{ 'metas.cartao.etapa_dica'|trans }}">
                <i class="bi {{ et.etapa.icone }}" aria-hidden="true"></i>{{ et.posicao ? 'metas.cartao.etapa'|trans({posicao: et.posicao, total: et.total, etapa: nomeDaEtapa}) : nomeDaEtapa }}
            </span>
            {% if et.proxima %}
                <span class="mm-meta-etapa-proximo">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>{{ 'metas.cartao.proximo'|trans({etapa: et.nomeDaProxima ?? et.proxima.rotulo|trans, setor: et.proxima.setor|trans}) }}
                </span>
            {% endif %}
        </div>
    </div>

    <div class="mm-meta-lado">
        <span class="mm-pilula tom-{{ status.tom }}">{{ status.rotulo|trans }}</span>
        <span class="mm-meta-datas">
            {{ 'metas.cartao.criada_em'|trans({data: meta.dataCriacao|data}) }}
        </span>
    </div>

    <div class="mm-meta-acoes">
        <button type="button"
                class="mm-marcador {{ acompanhando ? 'is-marcada' : '' }}"
                data-acompanhar="{{ path('tarefa_acompanhar', {id: meta.id}) }}"
                data-token="{{ csrf_token('acompanhar_tarefa_' ~ meta.id) }}"
                aria-pressed="{{ acompanhando ? 'true' : 'false' }}"
                title="{{ acompanhando ? 'metas.marcador.parar_de_acompanhar'|trans : 'metas.marcador.acompanhar_esta_meta'|trans }}">
            <i class="bi {{ acompanhando ? 'bi-bookmark-fill' : 'bi-bookmark' }}"></i>
        </button>
        {# ⋮ "Opções" do desenho (dc L98) com os itens que a especificação pede (R118, R236) e que já
           existem no sistema — o ⋮ do protótipo só alternava o marcador, defeito não reproduzido.
           "Abrir relatório completo" mantém o acesso à meta que a antiga seta dava. Os outros dois
           levam à aba Metas da pasta com a meta realçada (PMC-044); "Editar nome" abre ali a edição
           que já existe no ⋮ da pasta (pasta-metas.js, `acao=renomear`), com a mesma regra de
           exibição: pasta excluída é somente leitura. "Encaminhar via Chat I.A" (R223, MM-MENU-11) vem por
           último, com o ícone do ⋮ da aba Metas (desenho 02 D:3737): só ids em `data-*` (a pasta da meta e a
           meta); o clique dispara `bj-central:despachar` (script de minhas.html.twig). Só com a Central
           (`encaminharMetas`, do _resultado) e fora da lápide. É `<button>` dentro do `.dropdown-menu`: a linha
           clicável ignora os dois.
           `strategy: fixed` tira o menu do recorte do cartão (`overflow: hidden`). #}
        <div class="dropdown mm-menu">
            <button type="button" class="mm-acao-icone" title="{{ 'metas.cartao.opcoes'|trans }}" aria-label="{{ 'metas.cartao.opcoes_da_meta'|trans }}"
                    data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item mm-menu-item" href="{{ path('tarefa_show', {id: meta.id}) }}"><i class="bi bi-file-earmark-text"></i>{{ 'metas.cartao.menu.abrir_relatorio'|trans }}</a></li>
                <li><a class="dropdown-item mm-menu-item" href="{{ path('pasta_show', {id: meta.pasta.id, meta: meta.id}) }}#tarefas"><i class="bi bi-folder2-open"></i>{{ 'metas.cartao.menu.ir_para_aba_metas'|trans }}</a></li>
                {% if not meta.pasta.estaExcluida %}
                    <li><a class="dropdown-item mm-menu-item" href="{{ path('pasta_show', {id: meta.pasta.id, meta: meta.id, acao: 'renomear'}) }}#tarefas"><i class="bi bi-pencil"></i>{{ 'metas.cartao.menu.editar_nome'|trans }}</a></li>
                {% endif %}
                {% if encaminharMetas|default(false) and not meta.pasta.estaExcluida %}
                    <li><button type="button" class="dropdown-item mm-menu-item js-mm-encaminhar" data-encaminhar-pasta="{{ meta.pasta.id }}" data-encaminhar-tipo="meta" data-encaminhar-id="{{ meta.id }}"><i class="bi bi-send"></i>{{ 'metas.cartao.menu.encaminhar_chat_ia'|trans }}</button></li>
                {% endif %}
            </ul>
        </div>
    </div>
</article>
