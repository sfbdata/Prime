{#
    Bloco lateral DETALHES DA META (desenho 04B de 22/10, L85 e L162-164; spec L4), no lugar das 4 caixas do topo.
    Recebe `situacao` (SituacaoDaMetaOutput), `tarefa` e `podeEditarPrazo`. O "Alterar" do prazo abre o modal de
    prazo (só para quem pode); o de responsáveis, o de responsáveis. As duas janelas são as do show (meta-detalhe.js).
#}
<div class="meta-detalhes" data-detalhes>
    <div class="meta-detalhes-cabeca"><i class="bi bi-info-circle" aria-hidden="true"></i> {{ 'metas.detalhe.detalhes.titulo'|trans }}</div>
    <div class="meta-detalhes-item meta-detalhes-prazo{% if situacao.atrasada %} meta-detalhes-prazo--atrasada{% endif %}"
         {% if podeEditarPrazo %}role="button" tabindex="0" data-md-abrir="modalEditarPrazo" title="{{ 'metas.detalhe.detalhes.alterar_prazo_dica'|trans }}"{% endif %}>
        <div class="meta-detalhes-rotulo">{{ 'metas.detalhe.detalhes.prazo'|trans }}{% if podeEditarPrazo %}<span class="meta-detalhes-alterar">{{ 'metas.detalhe.detalhes.alterar'|trans }}</span>{% endif %}</div>
        {% if situacao.atrasada %}
            <div class="meta-detalhes-atraso">
                <div class="meta-detalhes-atraso-texto">
                    <b>{{ 'metas.detalhe.detalhes.atrasada'|trans }}</b>
                    <span>{{ 'metas.detalhe.detalhes.venceu_em'|trans({data: situacao.prazo|data}) }}</span>
                </div>
                <div class="meta-detalhes-atraso-dias">
                    <b class="meta-detalhes-atraso-n">{{ situacao.diasDeAtraso }}</b>
                    <b>{{ 'metas.detalhe.detalhes.dias'|trans({n: situacao.diasDeAtraso}) }}</b>
                </div>
            </div>
        {% else %}
            <div class="meta-detalhes-prazo-data">{{ situacao.prazo ? situacao.prazo|data : 'metas.detalhe.detalhes.sem_prazo'|trans }}</div>
        {% endif %}
    </div>
    <div class="meta-detalhes-item meta-detalhes-responsaveis" role="button" tabindex="0"
         data-md-abrir="modalEditarResponsaveis" title="{{ 'metas.detalhe.detalhes.alterar_responsaveis_dica'|trans }}">
        <div class="meta-detalhes-rotulo">{{ 'metas.detalhe.detalhes.responsaveis'|trans }}<span class="meta-detalhes-alterar">{{ 'metas.detalhe.detalhes.alterar'|trans }}</span></div>
        {% for resp in tarefa.responsaveis %}
            <div class="meta-detalhes-valor">{{ resp.fullName }}</div>
        {% else %}
            <div class="meta-detalhes-valor meta-detalhes-vazio">{{ 'metas.comum.nao_informado'|trans }}</div>
        {% endfor %}
    </div>
    <div class="meta-detalhes-item meta-detalhes-criada">
        <div class="meta-detalhes-rotulo">{{ 'metas.detalhe.detalhes.criada_em'|trans }}</div>
        <div class="meta-detalhes-valor">{{ situacao.criadaEm|data }}<span class="meta-detalhes-ha">· {{ situacao.diasDesdeACriacao == 0 ? 'metas.detalhe.detalhes.criada_hoje'|trans : 'metas.detalhe.detalhes.criada_ha'|trans({n: situacao.diasDesdeACriacao}) }}</span></div>
    </div>
    <div class="meta-detalhes-item meta-detalhes-despachante">
        <div class="meta-detalhes-rotulo">{{ 'metas.detalhe.detalhes.despachante'|trans }}</div>
        <div class="meta-detalhes-valor">{{ situacao.despachante ?? 'metas.comum.nao_informado'|trans }}</div>
    </div>
</div>
