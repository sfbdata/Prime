{# ───────────────────────────────────────────────────────────────────────────
   Fragmento trocável das Minhas Metas (dentro de [data-filtro-resultado]).
   Reexecutado a cada filtro pelo motor public/js/filtro-tabela.js.

   O agrupamento NÃO é feito aqui: vem pronto do AgrupadorDeMetas, porque decidir o
   que é urgente é regra de negócio e precisa de teste. Este arquivo só desenha.
─────────────────────────────────────────────────────────────────────────── #}
{# Hora desta leitura: o cabeçalho mostra "Atualizado às" e a atualiza a cada recarga parcial. #}
<span hidden data-mm-lido-as="{{ 'now'|hora }}"></span>
{# Lista e trilho de 340px (dc L81). O trilho aparece também com a lista vazia (o aside não depende de haver grupos). #}
<div class="mm-arranjo">

    <div class="mm-coluna-lista">
        {% if painel.estaVazia %}
            {# Vazio do desenho (dc L107): uma caixa só, sem ícone, sempre com o texto do desenho. #}
            <div class="mm-vazio-caixa">{{ 'metas.vazio.com_filtro'|trans }}</div>
        {% else %}
            {# Cada grupo é um cartão próprio (dc L84-86), empilhados com 12px entre eles; as metas ficam numa faixa
               cinza com 6px entre elas. A classe `mm-grupo-<chave>` dá ao grupo a cor dele (ponto e faixa das linhas).
               Todos abertos, Concluídas inclusive. O número antes do título recomeça em 1 a cada grupo (dc `m.num`). #}
            {% for grupo in painel.grupos %}
                <section class="mm-grupo mm-grupo-{{ grupo.chave }}" aria-label="{{ grupo.rotulo|trans }}">
                    <div class="mm-grupo-cabeca">
                        <span class="mm-dot" style="background: var(--mm-grupo-cor, var(--mm-cinza-dot))"></span>
                        <span class="mm-grupo-nome">{{ grupo.rotulo|trans }}</span>
                        <span class="mm-grupo-contagem">{{ grupo.total }}</span>
                    </div>
                    <div class="mm-grupo-itens">
                        {% for meta in grupo.metas %}
                            {{ include('tarefa/_meta_cartao.html.twig', {meta: meta, tom: grupo.tom, numero: loop.index}) }}
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        {% endif %}
    </div>

    <aside class="mm-trilho">

        {# ── Seu andamento (dc L112-118): sobre TODAS as metas da pessoa; não muda com a aba nem com os filtros ── #}
        <div class="mm-cartao mm-trilho-bloco mm-trilho-andamento">
            <div class="mm-andamento-cabeca">
                <h2 class="mm-cartao-titulo">{{ 'metas.trilho.seu_andamento'|trans }}</h2>
                <span class="mm-andamento-periodo">{{ 'metas.trilho.ultimos_30_dias'|trans }}</span>
            </div>
            <div class="mm-andamento-numero">
                <span class="mm-progresso-numero">{{ 'metas.trilho.x_de_y'|trans({concluidas: painel.totalConcluidas ~ '', total: painel.totalDoAndamento ~ ''}) }}</span>
                <span class="mm-andamento-periodo">{{ 'metas.trilho.concluidas'|trans }}</span>
            </div>
            <div class="mm-progresso-barra" role="progressbar"
                 aria-valuenow="{{ painel.percentualConcluido }}" aria-valuemin="0" aria-valuemax="100"
                 aria-label="{{ 'metas.trilho.percentual_concluidas'|trans }}">
                <span style="width: {{ painel.percentualConcluido }}%"></span>
            </div>
            <div class="mm-fatias">
                {% for fatia in painel.fatiasDoAndamento %}
                    <span class="mm-fatia tom-{{ fatia.tom }}">
                        <span class="mm-dot"></span>
                        {{ fatia.chave|trans({total: fatia.total ~ ''}) }}
                    </span>
                {% endfor %}
            </div>
        </div>

        {# ── Precisa de atenção (dc L119-127): as atrasadas de todas as metas da pessoa, no máximo 4, sem "Ver
           todas". Sem atrasadas, só o cabeçalho (o desenho não tem frase de vazio). ── #}
        <div class="mm-cartao mm-trilho-atencao">
            <div class="mm-cartao-cabeca">
                <h2 class="mm-cartao-titulo">{{ 'metas.atencao.titulo'|trans }}</h2>
            </div>
            {% for meta in painel.metasQuePrecisamDeAtencao %}
                {% set info = meta.prazoInfo %}
                {# Item de largura inteira (dc L122). Abre a pasta no Expediente (04 L236; spec minhas-metas-esteira-2210, L1). #}
                <a href="{{ path('pasta_show', {id: meta.pasta.id}) }}" class="mm-atencao-item">
                    <i class="bi bi-exclamation-triangle-fill mm-atencao-icone" aria-hidden="true"></i>
                    <span class="mm-atencao-texto">
                        {# "Título · Pasta NNN" (dc `atencao`): a pasta da meta atrasada sem abrir nada. #}
                        <span class="mm-atencao-titulo">{{ 'metas.atencao.titulo_e_pasta'|trans({titulo: meta.titulo, nup: meta.pasta.nup ~ ''}) }}</span>
                        <span class="mm-atencao-meta">
                            {{ 'metas.atencao.prazo'|trans({data: meta.prazo ? meta.prazo|data : 'metas.atencao.prazo_nao_informado'|trans}) }} · {{ info.texto }}
                            {#- dc `atencao` (P:178): sempre "de <criador>", em qualquer aba. #}
                            {%- if meta.criadoPor %} · {{ 'metas.comum.de_criador'|trans({nome: meta.criadoPor.fullName}) }}{% endif %}
                        </span>
                    </span>
                </a>
            {% endfor %}
        </div>

    </aside>
</div>
