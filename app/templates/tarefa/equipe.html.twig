{% extends 'base.html.twig' %}

{#
   Lista "Metas da equipe" (/tarefas/equipe): destino dos números de metas da tabela Desempenho
   do Dashboard. O total desta página é o número que foi clicado — ver ListarMetasDaEquipeUseCase.

   Reaproveita o "modo lista" das Minhas Metas (classes mm-* de minhas-metas.css, mesma grade de
   7 colunas). O `tarefa/_resultado.html.twig` não serve aqui: ele desenha o painel pessoal
   (abas, trilho, acompanhamento) a partir de um MinhasMetasOutput.
#}

{% block title %}{{ lista.titulo }}{% endblock %}

{% block body %}
<div class="mm-page">
<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-end gap-3 flex-wrap mb-2">
            <div class="min-w-0">
                <h1 class="mm-titulo" data-equipe-titulo><i class="bi bi-people me-2"></i>{{ lista.titulo }}</h1>
                <p class="mm-subtitulo">{{ lista.descricao }}</p>
            </div>
            <div class="flex-grow-1"></div>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('dashboard_index', lista.filtros|filter((v, k) => k in ['responsavel', 'cargo', 'data_de', 'data_ate'])) }}">Dashboard</a></li>
                <li class="breadcrumb-item active">Metas da equipe</li>
            </ol>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="mm-cartao">
            {% if lista.estaVazia %}
                <div class="mm-vazio" data-equipe-vazio>
                    <i class="bi bi-check2-all"></i>
                    <div class="mm-vazio-titulo">Nenhuma meta encontrada com esses filtros</div>
                    <div class="mm-vazio-sub">Volte ao Dashboard e escolha outro colaborador, cargo ou período.</div>
                </div>
            {% else %}
                <div class="mm-tabela-scroll">
                    <div class="mm-tabela" data-equipe-lista>

                        <div class="mm-linha mm-linha-cabeca">
                            <div></div>
                            <div class="mm-th">Meta</div>
                            <div class="mm-th">Responsável</div>
                            <div class="mm-th">Prazo</div>
                            <div class="mm-th">Status</div>
                            <div class="mm-th">Criada</div>
                            <div></div>
                        </div>

                        {% for meta in lista.metas %}
                            {% set info = meta.prazoInfo %}
                            {% set concluida = meta.status == 'concluida' %}
                            {% set emRevisao = meta.status == 'em_revisao' %}
                            {% set tomPrazo = concluida ? 'muted' : (emRevisao ? 'accent' : (info.cor == 'danger' ? 'danger' : (info.cor == 'warning' ? 'warn' : 'cinza'))) %}
                            {% set tomStatus = concluida ? 'ok' : (emRevisao ? 'accent' : (info.dias is not null and info.dias < 0 ? 'danger' : 'warn')) %}
                            {% set rotuloStatus = concluida ? 'Concluída' : (emRevisao ? 'Em revisão' : (info.dias is not null and info.dias < 0 ? 'Atrasada' : 'Pendente')) %}
                            {% set nomes = meta.responsaveis|map(r => r.fullName) %}

                            <div class="mm-linha" data-equipe-meta="{{ meta.id }}">
                                <div></div>

                                <div class="mm-linha-meta">
                                    <a href="{{ path('tarefa_show', {id: meta.id}) }}" class="mm-linha-titulo" title="{{ meta.titulo }}">{{ meta.titulo }}</a>
                                    <a href="{{ path('pasta_show', {id: meta.pasta.id}) }}" class="mm-linha-pasta">
                                        {{ meta.pasta.nup }}{% if meta.pasta.nomeCliente %} · {{ meta.pasta.nomeCliente }}{% endif %}
                                    </a>
                                </div>

                                <div class="mm-linha-quem">
                                    {% if nomes|length > 0 %}
                                        <span class="mm-avatar mm-avatar-sm">{{ nomes|first|slice(0, 1) }}</span>
                                        <span title="{{ nomes|join(', ') }}">{{ nomes|first }}{% if nomes|length > 1 %} +{{ nomes|length - 1 }}{% endif %}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </div>

                                <span class="mm-prazo tom-{{ tomPrazo }}">
                                    <i class="bi bi-calendar-event"></i>
                                    {%- if meta.prazo is null %}sem prazo
                                    {%- elseif concluida %}{{ meta.prazo|date('d/m/Y') }}
                                    {%- else %}{{ info.texto }}{% endif %}
                                </span>

                                <div><span class="mm-pilula tom-{{ tomStatus }}">{{ rotuloStatus }}</span></div>

                                <span class="mm-linha-atualizada">{{ meta.dataCriacao|date('d/m/Y') }}</span>

                                <a href="{{ path('tarefa_show', {id: meta.id}) }}" class="mm-acao-icone" title="Abrir a meta">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </div>
                        {% endfor %}

                    </div>
                </div>
            {% endif %}

            <div class="mm-separador d-flex align-items-center flex-wrap gap-2" style="border-bottom: none;">
                <span class="mm-grupo-nota" data-equipe-total="{{ lista.total }}">{{ lista.total }} meta{{ lista.total == 1 ? '' : 's' }}</span>
                <div class="flex-grow-1"></div>
                {# Paginação por links simples (sem XHR): cada link leva os mesmos filtros — trocar de
                   página não pode mudar o que está sendo contado. #}
                {% if lista.totalPaginas > 1 %}
                    {% set janela = 2 %}
                    {% set inicio = max(1, lista.pagina - janela) %}
                    {% set fim = min(lista.totalPaginas, lista.pagina + janela) %}

                    <nav aria-label="Paginação das metas" data-equipe-paginacao>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item {{ lista.pagina <= 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('tarefa_equipe', lista.filtros|merge({page: max(1, lista.pagina - 1)})) }}" aria-label="Página anterior">&lsaquo;</a>
                            </li>
                            {% for p in inicio..fim %}
                                <li class="page-item {{ p == lista.pagina ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('tarefa_equipe', lista.filtros|merge({page: p})) }}"
                                       {% if p == lista.pagina %}aria-current="page"{% endif %}>{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ lista.pagina >= lista.totalPaginas ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('tarefa_equipe', lista.filtros|merge({page: min(lista.totalPaginas, lista.pagina + 1)})) }}" aria-label="Próxima página">&rsaquo;</a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            </div>
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/minhas-metas.css') }}">
{% endblock %}
