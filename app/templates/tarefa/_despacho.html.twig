{#
    Um item da linha do tempo da meta no formato único do desenho 04B de 22/10 (L70-71, L127 e L161; spec
    minhas-metas-esteira-2210, C11 a C15 e L6). Recebe `l` (ItemDaLinhaDoTempoOutput) e `tarefa`. Todo item, despacho
    ou evento, é um cartão "DESPACHO N · tipo"; `l.tom` dá a cor. Só o despacho (`d`) tem registro, anexo, prazo,
    ciência e certidão. Registro (D1): "Registrado por NOME (Cargo) em ... · Cód. XXXX.XXXX", com o código ligado à
    página de validação. Mensagem antiga (sem código) fica sem a linha de local e data e sem a de registro, e é a
    única que se edita.
#}
{% set item = l.item %}
{% set d = l.despacho %}
<div class="despacho-item despacho-item--{{ l.tom }} tarefa-timeline-entry{% if d %} tarefa-timeline-entry--mensagem{% endif %}" id="{{ d ? 'despacho-' ~ item.mensagemId : 'evento-' ~ l.numero }}">
    <div class="despacho-marca"><span class="despacho-icone"><i class="bi {{ l.icone }}"></i></span></div>
    <div class="despacho-cartao">
        <div class="despacho-cabeca">
            <b class="despacho-numero">{{ 'metas.despacho.numero'|trans({n: l.numero}) }}</b>
            <span class="despacho-tipo">· {{ l.tipo|trans }}</span>
            {% if l.maisRecente %}<span class="despacho-recente">{{ 'metas.despacho.mais_recente'|trans }}</span>{% endif %}
            <span class="flex-grow-1"></span>
            {# Despacho registrado (com código) não se edita; só a mensagem antiga, do próprio autor. #}
            {% if d and d.codigo is null and item.detalhe and item.usuarioId == app.user.id and tarefa.status != 'concluida' %}
                <button type="button"
                        class="btn btn-link btn-sm p-0 text-secondary btn-editar-msg"
                        title="{{ 'metas.detalhe.editar_mensagem'|trans }}"
                        data-msg-id="{{ item.mensagemId }}"
                        data-conteudo="{{ item.detalhe|e('html_attr') }}"
                        data-conteudo-html="{{ item.detalhe|texto_rico|e('html_attr') }}"
                        data-csrf="{{ csrf_token('editar_mensagem_tarefa_' ~ item.mensagemId) }}"
                        data-url="{{ path('tarefa_mensagem_editar', {id: item.mensagemId}) }}">
                    <i class="bi bi-pencil"></i>
                </button>
            {% endif %}
            <small class="despacho-em">
                {{ (d ? d.registradoEm : item.dataHora)|data_hora }}
                {% if item.editadoEm %}<span class="ms-1 fst-italic tarefa-msg-editado">{{ 'metas.detalhe.editado'|trans }}</span>{% endif %}
            </small>
        </div>

        <div class="despacho-corpo">
            {% if not d %}
                {% if item.autorNome or item.autorEmail %}<div class="despacho-quem"><b>{{ item.autorNome ?? item.autorEmail }}</b></div>{% endif %}
                {# Texto do sistema (auditoria): segue escapado. #}
                {% if item.detalhe %}<div class="despacho-texto">{{ item.detalhe|nl2br }}</div>{% endif %}
            {% else %}
            <div class="despacho-quem"><b>{{ d.autor }}</b></div>
            {% if item.detalhe %}
                <div class="tarefa-msg-conteudo despacho-texto" id="tarefa-msg-conteudo-{{ item.mensagemId }}">
                    <span class="editor-rico-conteudo"><span class="ql-editor">{{ item.detalhe|texto_rico }}</span></span>
                </div>
            {% endif %}

            {% if d.codigo %}
                {% if d.cidade %}
                    <div class="despacho-local">{{ 'metas.despacho.local_e_data'|trans({cidade: d.cidade, data: d.registradoEm}) }}</div>
                {% endif %}
                <div class="despacho-registro">
                    <i class="bi bi-patch-check"></i>
                    <span>{{ 'metas.despacho.registrado_por'|trans }} <b>{{ (d.registradoPor ?? d.autor)|upper }}</b>{% if d.cargo %} ({{ d.cargo }}){% endif %} {{ 'metas.despacho.registrado_em'|trans({data: d.registradoEm|data, hora: d.registradoEm|hora}) }} · <a href="{{ path('tarefa_registro_validar', {codigo: d.codigo}) }}" title="{{ 'metas.despacho.conferir_registro'|trans }}">{{ 'metas.despacho.codigo'|trans({codigo: d.codigo}) }}</a></span>
                </div>
            {% endif %}

            {% if item.arquivoAnexo %}
                {% set ext      = item.arquivoAnexo|split('.')|last|lower %}
                {% set mimeMap  = {
                    'pdf':  'application/pdf',
                    'jpg':  'image/jpeg',
                    'jpeg': 'image/jpeg',
                    'png':  'image/png',
                    'gif':  'image/gif',
                    'webp': 'image/webp',
                    'svg':  'image/svg+xml',
                    'mp3':  'audio/mpeg',
                    'mp4':  'video/mp4',
                    'webm': 'video/webm',
                } %}
                {% set mime     = mimeMap[ext] ?? 'application/octet-stream' %}
                {% set ehImagem = mime starts with 'image/' %}
                {% set ehPdf    = mime == 'application/pdf' %}
                <div class="mt-2 tarefa-anexo-wrap">
                    <span class="tarefa-anexo-chip">
                        <i class="bi {% if ehImagem %}bi-image{% elseif ehPdf %}bi-file-pdf{% else %}bi-file-earmark{% endif %} me-1"></i>
                        <span class="tarefa-anexo-nome">{{ item.arquivoAnexo|split('/')|last }}</span>
                        <button type="button"
                                class="tarefa-anexo-btn"
                                title="{{ 'metas.detalhe.visualizar_arquivo'|trans }}"
                                data-bs-toggle="modal"
                                data-bs-target="#previewDocModal"
                                data-url="{{ path('tarefa_mensagem_arquivo_view', {id: item.mensagemId}) }}"
                                data-nome="{{ item.arquivoAnexo|split('/')|last }}"
                                data-mime="{{ mime }}">
                            <i class="bi bi-eye"></i>
                        </button>
                    </span>
                </div>
            {% endif %}

            {% if d.certidao %}
                <div class="despacho-certidao">
                    <i class="bi bi-patch-check"></i> {{ d.certidao }} · {{ 'metas.despacho.certidao_assinatura'|trans({nome: d.certificadoPor ?? '', quando: d.certificadoEm|data_hora}) }}
                </div>
            {% endif %}

            <div class="despacho-rodape">
                {% if d.prazo %}
                    <span class="despacho-cumprir{% if d.prazoVencido %} despacho-cumprir--vencido{% endif %}"><i class="bi bi-calendar-event"></i> {{ 'metas.despacho.cumprir_ate'|trans({data: d.prazo|data}) }}</span>
                {% endif %}
                {% if d.ciente %}
                    <span class="despacho-ciente"><i class="bi bi-eye"></i> {{ 'metas.despacho.ciente'|trans({nome: d.ciente, quando: d.cienteEm|data_hora}) }}</span>
                {% endif %}
                <span class="flex-grow-1"></span>
                {% if d.podeCertificar %}
                    <button type="button" class="despacho-certificar"
                            data-bs-toggle="modal" data-bs-target="#modalCertificarDespacho"
                            data-url="{{ path('tarefa_mensagem_certificar', {id: item.mensagemId}) }}"
                            data-token="{{ csrf_token('certificar_despacho_' ~ item.mensagemId) }}">{{ 'metas.despacho.certificar'|trans }}</button>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</div>
