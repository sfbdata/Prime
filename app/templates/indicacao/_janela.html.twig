{#
    Janela "Indicar o BlueJus" (spec indicar-bluejus.md; desenho bj-contas.js L98-133, `indicar()`). Aberta pelo item
    do menu do usuário ([data-ind-abrir], templates/menu_usuario/_dropdown.html.twig). Os textos fixos estão aqui; o
    que depende da pessoa (nome, link curto, mensagem, pendências do cadastro, trava e "SUAS INDICAÇÕES") vem do
    GET indicacao_janela e é montado por public/js/indicacao.js com textContent/createElement.
    Recebe do base: `_ehPrimario`, `_ehMaster` (o texto da dica muda para quem chama a equipe, bj-contas.js L116).
#}
<link rel="stylesheet" href="{{ asset('css/indicacao.css') }}">
<div class="modal fade mu-modal ind-modal" id="modalIndicacao" tabindex="-1" aria-labelledby="modalIndicacaoTitulo" aria-hidden="true"
     data-url-janela="{{ path('indicacao_janela') }}"
     data-url-email="{{ path('indicacao_email') }}"
     data-url-whatsapp="{{ path('indicacao_canal', {canal: 'whatsapp'}) }}"
     data-url-link="{{ path('indicacao_canal', {canal: 'link'}) }}"
     data-token="{{ csrf_token('indicacao') }}">
    <div class="modal-dialog modal-dialog-centered ind-dialogo">
        <div class="modal-content">
            <div class="mu-modal-topo">
                <b id="modalIndicacaoTitulo">Indicar o BlueJus</b>
                <button type="button" class="ind-x" data-bs-dismiss="modal" aria-label="Fechar">×</button>
            </div>
            <div class="ind-corpo">
                <div class="ind-dica">
                    <span class="ind-dica-icone" aria-hidden="true">💡</span>
                    <span>Convide colegas e outros escritórios para <b>criar a própria conta</b> no BlueJus. Quem aceitar abre um escritório novo e não entra na sua equipe.
                        {%- if current_tenant() and (_ehPrimario|default(false) or _ehMaster|default(false)) %} Para chamar alguém para a <b>sua equipe</b>, use <b>Convites do escritório</b>.
                        {%- elseif current_tenant() %} Quem chama pessoas para a equipe deste escritório é o usuário primário.{% endif %}</span>
                </div>

                <div class="ind-pendencias" data-ind-pendencias hidden>
                    <b>Complete seu cadastro para enviar convites</b><br>
                    <span data-ind-pendencias-texto></span>
                    <div class="ind-pendencias-acao"><a href="{{ path('app_profile') }}" class="ind-btn ind-btn-pri">Completar meu cadastro</a></div>
                </div>

                <div class="ind-trava" data-ind-trava role="alert" hidden></div>

                <div class="ind-envio" data-ind-envio hidden>
                    <div class="ind-quem">O convite é enviado em seu nome: <b data-ind-nome></b> · link curto <b data-ind-link></b></div>
                    <div class="ind-campos">
                        <input type="text" class="ind-campo" id="indNome" maxlength="120" placeholder="Nome (opcional)" aria-label="Nome (opcional)" autocomplete="off">
                        <input type="email" class="ind-campo" id="indEmail" maxlength="180" placeholder="E-mail" aria-label="E-mail" autocomplete="off">
                    </div>
                    <textarea class="ind-campo ind-mensagem" id="indMensagem" rows="4" aria-label="Mensagem do convite"></textarea>
                    <div class="ind-acoes">
                        <button type="button" class="ind-btn ind-btn-pri" data-ind-email>Enviar convite por e-mail</button>
                        <button type="button" class="ind-btn ind-btn-wa" data-ind-whatsapp>WhatsApp</button>
                        <button type="button" class="ind-btn ind-btn-sec" data-ind-copiar>Copiar link curto</button>
                    </div>
                </div>

                <div class="ind-aviso" data-ind-aviso role="status" aria-live="polite" hidden></div>

                <div class="ind-titulo-lista">SUAS INDICAÇÕES (<span data-ind-total>0</span>)</div>
                <div class="ind-lista" data-ind-lista>
                    <div class="ind-vazio">Nenhuma indicação ainda.</div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="{{ asset('js/indicacao.js') }}" defer></script>
