{% extends 'base.html.twig' %}

{% block title %}{{ 'processo.index.titulo'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0">{{ 'processo.index.titulo'|trans }}</h1>
        <div class="d-flex gap-2">
            {% if can_access_module('djen') %}
                <a href="{{ path('push_processual_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-newspaper me-1"></i> {{ 'processo.comum.push'|trans }}
                </a>
            {% endif %}
            <a href="{{ path('processo_new') }}" class="btn btn-success">{{ 'processo.index.cadastrar'|trans }}</a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {% set tribunalOpcoes = [] %}
        {% for sigla in tribunais|keys %}
            {% set tribunalOpcoes = tribunalOpcoes|merge([{ valor: sigla, label: sigla }]) %}
        {% endfor %}

        <div data-filtro-root data-filtro-endpoint="{{ path('processo_index') }}">
            {{ include('_partials/_filtro_barra.html.twig', {
                busca_placeholder: 'processo.index.busca'|trans,
                filtros: filtros,
                facetas: [
                    { name: 'tribunal', rotulo: 'processo.index.filtro.tribunal'|trans, tipo: 'select', opcoes: tribunalOpcoes },
                    { name: 'situacao', rotulo: 'processo.index.filtro.situacao'|trans, tipo: 'select', opcoes: [
                        { valor: 'EM_ANDAMENTO', label: 'processo.situacao.em_andamento'|trans },
                        { valor: 'ENCERRADO', label: 'processo.situacao.encerrado'|trans },
                        { valor: 'SUSPENSO', label: 'processo.situacao.suspenso'|trans },
                        { valor: 'ARQUIVADO', label: 'processo.situacao.arquivado'|trans },
                        { valor: 'BAIXADO', label: 'processo.situacao.baixado'|trans },
                        { valor: 'TRANSITADO_EM_JULGADO', label: 'processo.situacao.transitado_em_julgado'|trans }
                    ] },
                    { name: 'data_de', rotulo: 'processo.index.filtro.de'|trans, tipo: 'date' },
                    { name: 'data_ate', rotulo: 'processo.index.filtro.ate'|trans, tipo: 'date' }
                ]
            }) }}

            <div data-filtro-resultado>
                {{ include('processo/_resultado.html.twig') }}
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<style>
#tabelaProcessos {
    table-layout: fixed;
    width: 100%;
}
#tabelaProcessos th,
#tabelaProcessos td {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: middle;
    text-align: center;
}
.sortable {
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
}
.sortable:hover {
    background-color: rgba(0,0,0,0.05);
}
.sort-icon {
    font-size: 0.7em;
    opacity: 0.4;
    flex-shrink: 0;
}
.sortable.asc .sort-icon,
.sortable.desc .sort-icon {
    opacity: 1;
}
.sortable.asc .sort-icon::before {
    content: "\F148";
}
.sortable.desc .sort-icon::before {
    content: "\F128";
}
</style>
<script src="{{ asset('js/filtro-tabela.js') }}"></script>

{{ include('_partials/modal_access_request.html.twig') }}
{% endblock %}
