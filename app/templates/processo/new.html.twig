{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'processo.form.titulo_editar'|trans : 'processo.form.titulo_novo'|trans }}{% endblock %}

{% block body %}
{# Content Header #}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bi bi-briefcase{{ isEdit ? '-fill' : '' }} me-2"></i>
                    {{ isEdit ? 'processo.form.titulo_editar'|trans : 'processo.form.titulo_novo'|trans }}
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="{{ path('homepage') }}">{{ 'processo.comum.home'|trans }}</a></li>
                    {% if can_access_module('djen') %}
                        <li class="breadcrumb-item"><a href="{{ path('push_processual_index') }}">{{ 'processo.comum.push'|trans }}</a></li>
                    {% endif %}
                    <li class="breadcrumb-item"><a href="{{ path('processo_index') }}">{{ 'processo.comum.processos'|trans }}</a></li>
                    {% if isEdit %}
                        <li class="breadcrumb-item">
                            <a href="{{ path('processo_show', {id: processo.id}) }}">{{ processo.numeroProcesso }}</a>
                        </li>
                    {% endif %}
                    <li class="breadcrumb-item active">{{ isEdit ? 'processo.comum.editar'|trans : 'processo.form.novo'|trans }}</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form method="POST" id="processoForm"
              action="{{ isEdit ? path('processo_edit', {id: processo.id}) : path('processo_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token(isEdit ? 'processo_edit_' ~ processo.id : 'processo_new') }}">

            {# ── Barra de abas do processo ── #}
            <div class="processo-tabs">
                <button type="button" class="processo-tab active" data-tab="proc-info">
                    <i class="bi bi-info-circle me-1"></i> {{ 'processo.comum.informacoes'|trans }}
                </button>
                <button type="button" class="processo-tab" data-tab="proc-cliente">
                    <i class="bi bi-person me-1"></i> {{ 'processo.form.cliente'|trans }}
                </button>
                <button type="button" class="processo-tab" data-tab="proc-partes">
                    <i class="bi bi-people me-1"></i> {{ 'processo.comum.partes'|trans }}
                </button>
                <button type="button" class="processo-tab" data-tab="proc-movimentacoes">
                    <i class="bi bi-clock-history me-1"></i> {{ 'processo.comum.movimentacoes'|trans }}
                </button>
                <button type="button" class="processo-tab" data-tab="proc-assuntos">
                    <i class="bi bi-tags me-1"></i> {{ 'processo.form.assuntos'|trans }}
                </button>
            </div>

            {# ── ABA: Informações do Processo ── #}
            <div class="processo-tab-content active" id="tab-proc-info">
                <div class="card card-primary card-outline mb-0 border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="numeroProcesso" class="form-label">
                                {{ 'processo.comum.numero'|trans }} <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="numeroProcesso" name="numeroProcesso" class="form-control"
                                   placeholder="{{ 'processo.form.numero_exemplo'|trans }}"
                                   value="{{ processo.numeroProcesso ?? '' }}" required>
                            <div class="form-text">{{ 'processo.form.numero_formato'|trans }}</div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button id="btn-datajud" type="button" class="btn btn-info w-100"
                                    data-bs-toggle="tooltip" title="{{ 'processo.form.buscar_cnj_dica'|trans }}">
                                <i class="bi bi-search me-1"></i> {{ 'processo.form.buscar_cnj'|trans }}
                            </button>
                        </div>
                        <div class="col-md-6">
                            <label for="siglaTribunal" class="form-label">
                                {{ 'processo.comum.tribunal'|trans }}
                            </label>
                            <input type="text" id="siglaTribunal" name="siglaTribunal" class="form-control"
                                   value="{{ processo.siglaTribunal ?? '' }}" readonly
                                   placeholder="{{ 'processo.form.tribunal_placeholder'|trans }}">
                            <div class="form-text">{{ 'processo.form.tribunal_ajuda'|trans }}</div>
                        </div>
                        <div class="col-md-6">
                            <label for="orgaoJulgador" class="form-label">
                                {{ 'processo.comum.orgao_julgador'|trans }} <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="orgaoJulgador" name="orgaoJulgador" class="form-control"
                                   value="{{ processo.orgaoJulgador ?? '' }}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="classeProcessual" class="form-label">
                                {{ 'processo.comum.classe_processual'|trans }} <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="classeProcessual" name="classeProcessual" class="form-control"
                                   value="{{ processo.classeProcessual ?? '' }}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="assuntoProcessual" class="form-label">
                                {{ 'processo.form.assunto_processual'|trans }} <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="assuntoProcessual" name="assuntoProcessual" class="form-control"
                                   value="{{ processo.assuntoProcessual ?? '' }}" required>
                        </div>
                        <div class="col-md-4">
                            <label for="situacaoProcesso" class="form-label">
                                {{ 'processo.comum.situacao'|trans }} <span class="text-danger">*</span>
                            </label>
                            <select id="situacaoProcesso" name="situacaoProcesso" class="form-select" required>
                                <option value="EM_ANDAMENTO" {% if (processo.situacaoProcesso ?? 'EM_ANDAMENTO') == 'EM_ANDAMENTO' %}selected{% endif %}>{{ 'processo.situacao.em_andamento'|trans }}</option>
                                <option value="ENCERRADO" {% if (processo.situacaoProcesso ?? '') == 'ENCERRADO' %}selected{% endif %}>{{ 'processo.situacao.encerrado'|trans }}</option>
                                <option value="SUSPENSO" {% if (processo.situacaoProcesso ?? '') == 'SUSPENSO' %}selected{% endif %}>{{ 'processo.situacao.suspenso'|trans }}</option>
                                <option value="PARALISADO" {% if (processo.situacaoProcesso ?? '') == 'PARALISADO' %}selected{% endif %}>{{ 'processo.situacao.paralisado'|trans }}</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="instancia" class="form-label">
                                {{ 'processo.comum.instancia'|trans }} <span class="text-danger">*</span>
                            </label>
                            <select id="instancia" name="instancia" class="form-select" required>
                                <option value="G1" {% if (processo.instancia ?? 'G1') == 'G1' %}selected{% endif %}>{{ 'processo.form.instancia.g1'|trans }}</option>
                                <option value="G2" {% if (processo.instancia ?? '') == 'G2' %}selected{% endif %}>{{ 'processo.form.instancia.g2'|trans }}</option>
                                <option value="ST" {% if (processo.instancia ?? '') == 'ST' %}selected{% endif %}>{{ 'processo.form.instancia.st'|trans }}</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="dataDistribuicao" class="form-label">{{ 'processo.form.data_distribuicao'|trans }}</label>
                            <input type="date" id="dataDistribuicao" name="dataDistribuicao" class="form-control"
                                   value="{{ processo.dataDistribuicao ? processo.dataDistribuicao|date('Y-m-d') : '' }}">
                        </div>
                        <div class="col-md-4">
                            <label for="dataBaixa" class="form-label">{{ 'processo.comum.data_baixa'|trans }}</label>
                            <input type="date" id="dataBaixa" name="dataBaixa" class="form-control"
                                   value="{{ processo.dataBaixa ? processo.dataBaixa|date('Y-m-d') : '' }}">
                        </div>
                    </div>

                    {# Metadados do Datajud — preenchidos automaticamente pela busca no CNJ, não editáveis #}
                    <input type="hidden" id="nivelSigilo" name="nivelSigilo" value="{{ processo.nivelSigilo }}">
                    <input type="hidden" id="formato" name="formato" value="{{ processo.formato }}">
                    <input type="hidden" id="formatoCodigo" name="formatoCodigo" value="{{ processo.formatoCodigo }}">
                    <input type="hidden" id="sistema" name="sistema" value="{{ processo.sistema }}">
                    <input type="hidden" id="sistemaCodigo" name="sistemaCodigo" value="{{ processo.sistemaCodigo }}">
                    <input type="hidden" id="classeCodigo" name="classeCodigo" value="{{ processo.classeCodigo }}">
                    <input type="hidden" id="orgaoJulgadorCodigo" name="orgaoJulgadorCodigo" value="{{ processo.orgaoJulgadorCodigo }}">
                    <input type="hidden" id="orgaoJulgadorMunicipioIbge" name="orgaoJulgadorMunicipioIbge" value="{{ processo.orgaoJulgadorMunicipioIbge }}">
                    <input type="hidden" id="datajudId" name="datajudId" value="{{ processo.datajudId }}">
                </div>
                </div>
            </div>{# fim tab-proc-info #}

            {# ── ABA: Cliente ── #}
            <div class="processo-tab-content" id="tab-proc-cliente">
                <div class="card card-outline card-success mb-0 border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="col-md-8">
                        <label for="cliente_id" class="form-label">{{ 'processo.form.cliente_vinculado'|trans }}</label>
                        <select id="cliente_id" name="cliente_id" class="form-select select2-search">
                            <option value="">{{ 'processo.form.nenhum_cliente'|trans }}</option>
                            {% for cliente in clientes %}
                                <option value="{{ cliente.id }}"
                                    data-nome="{% if cliente.cpf is defined %}{{ cliente.nomeCompleto }}{% else %}{{ cliente.razaoSocial }}{% endif %}"
                                    data-documento="{% if cliente.cpf is defined %}{{ cliente.cpf }}{% else %}{{ cliente.cnpj }}{% endif %}"
                                    {% if processo.cliente is defined and processo.cliente is not null and processo.cliente.id == cliente.id %}selected{% endif %}>
                                    {% if cliente.cpf is defined %}
                                        {{ cliente.nomeCompleto }} ({{ cliente.cpf }})
                                    {% else %}
                                        {{ cliente.razaoSocial }} ({{ cliente.cnpj }})
                                    {% endif %}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                </div>
            </div>{# fim tab-proc-cliente #}

            {# ── ABA: Partes do Processo ── #}
            <div class="processo-tab-content" id="tab-proc-partes">
                <div class="card card-outline card-warning mb-0 border-top-0 rounded-top-0">
                <div class="card-header d-flex justify-content-between align-items-center border-top-0">
                    <button type="button" id="btn-add-parte" class="btn btn-sm btn-warning ms-auto">
                        <i class="bi bi-plus-lg me-1"></i> {{ 'processo.form.adicionar_parte'|trans }}
                    </button>
                </div>
                <div class="card-body">
                    <div id="partesContainer">
                        {% if isEdit and processo.partes|length > 0 %}
                            {# O detector de texto fixo lê o ">" dentro do atributo como fim de tag; a conta fica aqui. #}
                            {% set exibirRemover = processo.partes|length > 1 ? 'block' : 'none' %}
                            {% for parte in processo.partes %}
                                <div class="parte-row card mb-2 p-3" style="position: relative;">
                                    <input type="hidden" name="partes[{{ loop.index0 }}][id]" value="{{ parte.id }}">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label">{{ 'processo.comum.tipo'|trans }}</label>
                                            <select name="partes[{{ loop.index0 }}][tipo]" class="form-select">
                                                <option value="PARTE" {% if parte.tipo == 'PARTE' %}selected{% endif %}>{{ 'processo.form.parte.parte'|trans }}</option>
                                                <option value="ADVOGADO" {% if parte.tipo == 'ADVOGADO' %}selected{% endif %}>{{ 'processo.form.parte.advogado'|trans }}</option>
                                                <option value="JUIZ" {% if parte.tipo == 'JUIZ' %}selected{% endif %}>{{ 'processo.form.parte.juiz'|trans }}</option>
                                                <option value="PROMOTOR" {% if parte.tipo == 'PROMOTOR' %}selected{% endif %}>{{ 'processo.form.parte.promotor'|trans }}</option>
                                            </select>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label">{{ 'processo.comum.nome'|trans }}</label>
                                            <input type="text" name="partes[{{ loop.index0 }}][nome]" class="form-control parte-nome"
                                                   placeholder="{{ 'processo.form.parte.nome_placeholder'|trans }}" value="{{ parte.nome }}">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">{{ 'processo.comum.documento'|trans }}</label>
                                            <input type="text" name="partes[{{ loop.index0 }}][documento]" class="form-control"
                                                   placeholder="{{ 'processo.form.parte.documento_placeholder'|trans }}" value="{{ parte.documento ?: '' }}">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">{{ 'processo.comum.papel'|trans }}</label>
                                            <input type="text" name="partes[{{ loop.index0 }}][papel]" class="form-control"
                                                   placeholder="{{ 'processo.form.parte.papel_placeholder'|trans }}" value="{{ parte.papel ?: '' }}">
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-parte"
                                            style="display: {{ exibirRemover }}; position: absolute; top: 8px; right: 12px;"
                                            title="{{ 'processo.form.remover'|trans }}"><i class="bi bi-trash"></i></button>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="parte-row card mb-2 p-3" style="position: relative;">
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label class="form-label">{{ 'processo.comum.tipo'|trans }}</label>
                                        <select name="partes[0][tipo]" class="form-select">
                                            <option value="PARTE">{{ 'processo.form.parte.parte'|trans }}</option>
                                            <option value="ADVOGADO">{{ 'processo.form.parte.advogado'|trans }}</option>
                                            <option value="JUIZ">{{ 'processo.form.parte.juiz'|trans }}</option>
                                            <option value="PROMOTOR">{{ 'processo.form.parte.promotor'|trans }}</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">{{ 'processo.comum.nome'|trans }}</label>
                                        <input type="text" name="partes[0][nome]" class="form-control parte-nome" placeholder="{{ 'processo.form.parte.nome_placeholder'|trans }}">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">{{ 'processo.comum.documento'|trans }}</label>
                                        <input type="text" name="partes[0][documento]" class="form-control" placeholder="{{ 'processo.form.parte.documento_placeholder'|trans }}">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">{{ 'processo.comum.papel'|trans }}</label>
                                        <input type="text" name="partes[0][papel]" class="form-control" placeholder="{{ 'processo.form.parte.papel_placeholder'|trans }}">
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-parte"
                                        style="display: none; position: absolute; top: 8px; right: 12px;"
                                        title="{{ 'processo.form.remover'|trans }}"><i class="bi bi-trash"></i></button>
                            </div>
                        {% endif %}
                    </div>
                </div>
                </div>
            </div>{# fim tab-proc-partes #}

            {# ── ABA: Movimentações ── #}
            <div class="processo-tab-content" id="tab-proc-movimentacoes">
                <div class="card card-outline card-info mb-0 border-top-0 rounded-top-0">
                <div class="card-header d-flex justify-content-between align-items-center border-top-0">
                    <button type="button" id="btn-add-movimentacao" class="btn btn-sm btn-info ms-auto">
                        <i class="bi bi-plus-lg me-1"></i> {{ 'processo.form.adicionar_movimentacao'|trans }}
                    </button>
                </div>
                <div class="card-body">
                    <div id="movimentacoesContainer">
                        {% if isEdit and processo.movimentacoes|length > 0 %}
                            {# O detector de texto fixo lê o ">" dentro do atributo como fim de tag; a conta fica aqui. #}
                            {% set exibirRemover = processo.movimentacoes|length > 1 ? 'block' : 'none' %}
                            {% set movimentacoesOrdenadas = processo.movimentacoes|sort((a, b) => b.dataMovimentacao <=> a.dataMovimentacao) %}
                            {% for mov in movimentacoesOrdenadas %}
                                <div class="movimentacao-row card mb-2 p-3" style="position: relative;">
                                    <input type="hidden" name="movimentacoes[{{ loop.index0 }}][id]" value="{{ mov.id }}">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label">{{ 'processo.comum.data'|trans }}</label>
                                            <input type="date" name="movimentacoes[{{ loop.index0 }}][dataMovimentacao]" class="form-control"
                                                   value="{{ mov.dataMovimentacao ? mov.dataMovimentacao|date('Y-m-d') : '' }}">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">{{ 'processo.comum.descricao'|trans }}</label>
                                            <input type="text" name="movimentacoes[{{ loop.index0 }}][descricao]" class="form-control mov-descricao"
                                                   placeholder="{{ 'processo.form.movimentacao.descricao_placeholder'|trans }}" value="{{ mov.descricao }}" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">{{ 'processo.comum.tipo'|trans }}</label>
                                            <input type="text" name="movimentacoes[{{ loop.index0 }}][tipo]" class="form-control"
                                                   placeholder="{{ 'processo.form.movimentacao.tipo_placeholder'|trans }}" value="{{ mov.tipo ?: '' }}">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">{{ 'processo.comum.orgao'|trans }}</label>
                                            <input type="text" name="movimentacoes[{{ loop.index0 }}][orgao]" class="form-control"
                                                   placeholder="{{ 'processo.comum.orgao'|trans }}" value="{{ mov.orgao ?: '' }}">
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"
                                            style="display: {{ exibirRemover }}; position: absolute; top: 8px; right: 12px;"
                                            title="{{ 'processo.form.remover'|trans }}"><i class="bi bi-trash"></i></button>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="movimentacao-row card mb-2 p-3" style="position: relative;">
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label class="form-label">{{ 'processo.comum.data'|trans }}</label>
                                        <input type="date" name="movimentacoes[0][dataMovimentacao]" class="form-control">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">{{ 'processo.comum.descricao'|trans }}</label>
                                        <input type="text" name="movimentacoes[0][descricao]" class="form-control mov-descricao"
                                               placeholder="{{ 'processo.form.movimentacao.descricao_placeholder'|trans }}" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">{{ 'processo.comum.tipo'|trans }}</label>
                                        <input type="text" name="movimentacoes[0][tipo]" class="form-control" placeholder="{{ 'processo.form.movimentacao.tipo_placeholder'|trans }}">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">{{ 'processo.comum.orgao'|trans }}</label>
                                        <input type="text" name="movimentacoes[0][orgao]" class="form-control" placeholder="{{ 'processo.comum.orgao'|trans }}">
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"
                                        style="display: none; position: absolute; top: 8px; right: 12px;"
                                        title="{{ 'processo.form.remover'|trans }}"><i class="bi bi-trash"></i></button>
                            </div>
                        {% endif %}
                    </div>
                </div>
                </div>
            </div>{# fim tab-proc-movimentacoes #}

            {# ── ABA: Assuntos ── #}
            <div class="processo-tab-content" id="tab-proc-assuntos">
                <div class="card card-outline card-primary mb-0 border-top-0 rounded-top-0">
                <div class="card-header d-flex justify-content-between align-items-center border-top-0">
                    <small class="text-muted">{{ 'processo.form.assuntos_ajuda'|trans }}</small>
                    <button type="button" id="btn-add-assunto" class="btn btn-sm btn-primary ms-auto">
                        <i class="bi bi-plus-lg me-1"></i> {{ 'processo.form.adicionar_assunto'|trans }}
                    </button>
                </div>
                <div class="card-body">
                    <div id="assuntosContainer">
                        {% if isEdit and processo.assuntos|length > 0 %}
                            {# O detector de texto fixo lê o ">" dentro do atributo como fim de tag; a conta fica aqui. #}
                            {% set exibirRemover = processo.assuntos|length > 1 ? 'block' : 'none' %}
                            {% for assunto in processo.assuntos %}
                                <div class="assunto-row card mb-2 p-3" style="position: relative;">
                                    <input type="hidden" name="assuntos[{{ loop.index0 }}][id]" value="{{ assunto.id }}">
                                    <div class="row g-2">
                                        <div class="col-md-9">
                                            <label class="form-label">{{ 'processo.form.assunto.assunto'|trans }}</label>
                                            <input type="text" name="assuntos[{{ loop.index0 }}][nome]" class="form-control assunto-nome"
                                                   placeholder="{{ 'processo.form.assunto.nome_placeholder'|trans }}" value="{{ assunto.nome }}">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">{{ 'processo.form.assunto.codigo'|trans }}</label>
                                            <input type="number" name="assuntos[{{ loop.index0 }}][codigo]" class="form-control"
                                                   placeholder="{{ 'processo.form.assunto.codigo_placeholder'|trans }}" value="{{ assunto.codigo }}">
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-assunto"
                                            style="display: {{ exibirRemover }}; position: absolute; top: 8px; right: 12px;"
                                            title="{{ 'processo.form.remover'|trans }}"><i class="bi bi-trash"></i></button>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="assunto-row card mb-2 p-3" style="position: relative;">
                                <div class="row g-2">
                                    <div class="col-md-9">
                                        <label class="form-label">{{ 'processo.form.assunto.assunto'|trans }}</label>
                                        <input type="text" name="assuntos[0][nome]" class="form-control assunto-nome" placeholder="{{ 'processo.form.assunto.nome_placeholder'|trans }}">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">{{ 'processo.form.assunto.codigo'|trans }}</label>
                                        <input type="number" name="assuntos[0][codigo]" class="form-control" placeholder="{{ 'processo.form.assunto.codigo_placeholder'|trans }}">
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-assunto"
                                        style="display: none; position: absolute; top: 8px; right: 12px;"
                                        title="{{ 'processo.form.remover'|trans }}"><i class="bi bi-trash"></i></button>
                            </div>
                        {% endif %}
                    </div>
                </div>
                </div>
            </div>{# fim tab-proc-assuntos #}

            {# Botões de ação #}
            <div class="d-flex justify-content-between mb-4">
                <a href="{{ isEdit ? path('processo_show', {id: processo.id}) : path('processo_index') }}"
                   class="btn btn-secondary">
                    <i class="bi bi-x-lg me-1"></i> {{ 'processo.form.cancelar'|trans }}
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    {{ isEdit ? 'processo.form.salvar'|trans : 'processo.form.criar'|trans }}
                </button>
            </div>

        </form>
    </div>
</section>

{# Modal de carregamento durante busca #}
<div id="loadingModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">{{ 'processo.form.buscando'|trans }}</span>
                </div>
                <p class="mt-3">{{ 'processo.form.buscando_datajud'|trans }}</p>
            </div>
        </div>
    </div>
</div>

{# Modal de Mensagens #}
<div id="feedbackModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div id="feedbackHeader" class="modal-header bg-secondary text-white">
                <h5 id="feedbackTitle" class="modal-title">{{ 'processo.form.mensagem'|trans }}</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'processo.form.close'|trans }}"></button>
            </div>
            <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                <p id="feedbackMessage" class="mb-0"></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.processo-tabs {
    display: flex;
    border-bottom: 3px solid #1a6fa3;
    background: var(--bs-body-bg);
    margin-bottom: 0;
}
.processo-tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    padding: 10px 20px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--bs-secondary-color);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    outline: none;
}
.processo-tab:hover { color: #1a6fa3; }
.processo-tab.active { color: #1a6fa3; border-bottom-color: #1a6fa3; }
.processo-tab-content { display: none; }
.processo-tab-content.active { display: block; }
.processo-tab-content .card { border-radius: 0 0 4px 4px; }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ catalogo_js('processo.form.js') }}
<script>
$(document).ready(function () {

    // Texto do catálogo que entra em HTML montado (rótulo, placeholder, title).
    function esc(texto) {
        return String(texto).replace(/[&<>\x22\x27]/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; });
    }

    // ── Alternância de abas do processo ──
    document.querySelectorAll('.processo-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.processo-tab').forEach(function(t) { t.classList.remove('active'); });
            document.querySelectorAll('.processo-tab-content').forEach(function(c) { c.classList.remove('active'); });
            tab.classList.add('active');
            var painel = document.getElementById('tab-' + tab.dataset.tab);
            if (painel) painel.classList.add('active');
        });
    });

    // Select2 para cliente
    $('.select2-search').select2({
        width: '100%',
        placeholder: BJ_T.t('processo.form.js.nenhum_cliente'),
        allowClear: true,
        language: { noResults: function() { return BJ_T.t('processo.form.js.nenhum_cliente_encontrado'); } }
    });

    // Tribunal é campo somente-leitura, derivado do número do processo (padrão CNJ).

    // Adicionar parte
    document.getElementById('btn-add-parte').addEventListener('click', function() {
        const container = document.getElementById('partesContainer');
        const index = container.querySelectorAll('.parte-row').length;
        const html = `
            <div class="parte-row card mb-2 p-3" style="position: relative;">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.tipo'))}</label>
                        <select name="partes[${index}][tipo]" class="form-select">
                            <option value="PARTE">${esc(BJ_T.t('processo.form.js.parte.parte'))}</option>
                            <option value="ADVOGADO">${esc(BJ_T.t('processo.form.js.parte.advogado'))}</option>
                            <option value="JUIZ">${esc(BJ_T.t('processo.form.js.parte.juiz'))}</option>
                            <option value="PROMOTOR">${esc(BJ_T.t('processo.form.js.parte.promotor'))}</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.nome'))}</label>
                        <input type="text" name="partes[${index}][nome]" class="form-control parte-nome" placeholder="${esc(BJ_T.t('processo.form.js.parte.nome_placeholder'))}">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.documento'))}</label>
                        <input type="text" name="partes[${index}][documento]" class="form-control" placeholder="${esc(BJ_T.t('processo.form.js.parte.documento_placeholder'))}">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.papel'))}</label>
                        <input type="text" name="partes[${index}][papel]" class="form-control" placeholder="${esc(BJ_T.t('processo.form.js.parte.papel_placeholder'))}">
                    </div>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm remove-parte"
                        style="position: absolute; top: 8px; right: 12px;" title="${esc(BJ_T.t('processo.form.js.remover'))}">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
        attachRemoveParteListener();
    });

    function attachRemoveParteListener() {
        document.querySelectorAll('.remove-parte').forEach(btn => {
            btn.removeEventListener('click', removeParteFn);
            btn.addEventListener('click', removeParteFn);
        });
        updateRemoveButtons();
    }

    function removeParteFn(e) {
        e.preventDefault();
        e.target.closest('.parte-row').remove();
        updateRemoveButtons();
    }

    // Adicionar movimentação
    document.getElementById('btn-add-movimentacao').addEventListener('click', function() {
        const container = document.getElementById('movimentacoesContainer');
        const index = container.querySelectorAll('.movimentacao-row').length;
        const html = `
            <div class="movimentacao-row card mb-2 p-3" style="position: relative;">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.data'))}</label>
                        <input type="date" name="movimentacoes[${index}][dataMovimentacao]" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.descricao'))}</label>
                        <input type="text" name="movimentacoes[${index}][descricao]" class="form-control mov-descricao"
                               placeholder="${esc(BJ_T.t('processo.form.js.movimentacao.descricao_placeholder'))}" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.tipo'))}</label>
                        <input type="text" name="movimentacoes[${index}][tipo]" class="form-control" placeholder="${esc(BJ_T.t('processo.form.js.movimentacao.tipo_placeholder'))}">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.orgao'))}</label>
                        <input type="text" name="movimentacoes[${index}][orgao]" class="form-control" placeholder="${esc(BJ_T.t('processo.form.js.orgao'))}">
                    </div>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"
                        style="position: absolute; top: 8px; right: 12px;" title="${esc(BJ_T.t('processo.form.js.remover'))}">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
        attachRemoveMovimentacaoListener();
        sortarMovimentacoesPorData();
    });

    function attachRemoveMovimentacaoListener() {
        document.querySelectorAll('.remove-movimentacao').forEach(btn => {
            btn.removeEventListener('click', removeMovimentacaoFn);
            btn.addEventListener('click', removeMovimentacaoFn);
        });
        updateRemoveButtons();
    }

    function removeMovimentacaoFn(e) {
        e.preventDefault();
        e.target.closest('.movimentacao-row').remove();
        updateRemoveButtons();
    }

    // Adicionar assunto
    document.getElementById('btn-add-assunto').addEventListener('click', function() {
        const container = document.getElementById('assuntosContainer');
        const index = container.querySelectorAll('.assunto-row').length;
        const html = `
            <div class="assunto-row card mb-2 p-3" style="position: relative;">
                <div class="row g-2">
                    <div class="col-md-9">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.assunto.assunto'))}</label>
                        <input type="text" name="assuntos[${index}][nome]" class="form-control assunto-nome" placeholder="${esc(BJ_T.t('processo.form.js.assunto.nome_placeholder'))}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">${esc(BJ_T.t('processo.form.js.assunto.codigo'))}</label>
                        <input type="number" name="assuntos[${index}][codigo]" class="form-control" placeholder="${esc(BJ_T.t('processo.form.js.assunto.codigo_placeholder'))}">
                    </div>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm remove-assunto"
                        style="position: absolute; top: 8px; right: 12px;" title="${esc(BJ_T.t('processo.form.js.remover'))}">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
        attachRemoveAssuntoListener();
    });

    function attachRemoveAssuntoListener() {
        document.querySelectorAll('.remove-assunto').forEach(btn => {
            btn.removeEventListener('click', removeAssuntoFn);
            btn.addEventListener('click', removeAssuntoFn);
        });
        updateRemoveButtons();
    }

    function removeAssuntoFn(e) {
        e.preventDefault();
        e.target.closest('.assunto-row').remove();
        updateRemoveButtons();
    }

    function updateRemoveButtons() {
        const partes = document.querySelectorAll('.parte-row').length;
        document.querySelectorAll('.remove-parte').forEach(btn => {
            btn.style.display = partes > 1 ? 'block' : 'none';
        });
        const movs = document.querySelectorAll('.movimentacao-row').length;
        document.querySelectorAll('.remove-movimentacao').forEach(btn => {
            btn.style.display = movs > 1 ? 'block' : 'none';
        });
        const assuntos = document.querySelectorAll('.assunto-row').length;
        document.querySelectorAll('.remove-assunto').forEach(btn => {
            btn.style.display = assuntos > 1 ? 'block' : 'none';
        });
    }

    function sortarMovimentacoesPorData() {
        const container = document.getElementById('movimentacoesContainer');
        const movimentacoes = Array.from(container.querySelectorAll('.movimentacao-row'));
        movimentacoes.sort((a, b) => {
            const dataA = a.querySelector('input[name*="dataMovimentacao"]').value;
            const dataB = b.querySelector('input[name*="dataMovimentacao"]').value;
            if (!dataA && !dataB) return 0;
            if (!dataA) return 1;
            if (!dataB) return -1;
            return new Date(dataB) - new Date(dataA);
        });
        movimentacoes.forEach((mov, idx) => {
            container.appendChild(mov);
            mov.querySelectorAll('input, select').forEach(field => {
                const name = field.getAttribute('name');
                if (name) field.setAttribute('name', name.replace(/\[\d+\]/, `[${idx}]`));
            });
        });
    }

    function showFeedbackModal(type, message) {
        const modalElement = document.getElementById('feedbackModal');
        const headerElement = document.getElementById('feedbackHeader');
        const titleElement = document.getElementById('feedbackTitle');
        const messageElement = document.getElementById('feedbackMessage');
        const styles = {
            success: { title: BJ_T.t('processo.form.js.sucesso'), headerClass: 'modal-header bg-success text-white' },
            warning: { title: BJ_T.t('processo.form.js.atencao'), headerClass: 'modal-header bg-warning text-dark' },
            error:   { title: BJ_T.t('processo.form.js.erro'), headerClass: 'modal-header bg-danger text-white' }
        };
        const selectedStyle = styles[type] ?? styles.error;
        headerElement.className = selectedStyle.headerClass;
        titleElement.textContent = selectedStyle.title;
        messageElement.innerHTML = message;
        new bootstrap.Modal(modalElement).show();
    }

    // Buscar no DataJud
    const btnDataJud = document.getElementById('btn-datajud');
    if (btnDataJud) {
        btnDataJud.addEventListener('click', async function(e) {
            e.preventDefault();
            const numeroProcesso = document.getElementById('numeroProcesso').value;
            if (!numeroProcesso) { showFeedbackModal('warning', esc(BJ_T.t('processo.form.js.informe_numero'))); return; }

            const modal = new bootstrap.Modal(document.getElementById('loadingModal'));
            modal.show();

            try {
                // O tribunal é derivado do número no servidor — não enviamos mais a sigla.
                const response = await fetch('{{ path("api_datajud_search") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ numeroProcesso })
                });
                const data = await response.json();
                modal.hide();

                if (!response.ok || !data.success) {
                    showFeedbackModal('error', data.error || esc(BJ_T.t('processo.form.js.erro_busca')));
                    return;
                }

                const processData = data.data;
                document.getElementById('siglaTribunal').value     = processData.siglaTribunal || '';
                document.getElementById('orgaoJulgador').value     = processData.orgaoJulgador || '';
                document.getElementById('classeProcessual').value  = processData.classeProcessual || '';
                document.getElementById('assuntoProcessual').value = processData.assuntoProcessual || '';
                document.getElementById('situacaoProcesso').value  = processData.situacaoProcesso || 'EM_ANDAMENTO';
                document.getElementById('instancia').value         = processData.instancia || 'G1';
                document.getElementById('dataDistribuicao').value  = processData.dataDistribuicao || '';
                document.getElementById('dataBaixa').value         = processData.dataBaixa || '';

                // Metadados do Datajud — ?? '' (não ||) para preservar o 0 do nível de sigilo, que || zeraria
                document.getElementById('nivelSigilo').value                = processData.nivelSigilo ?? '';
                document.getElementById('formato').value                    = processData.formato ?? '';
                document.getElementById('formatoCodigo').value              = processData.formatoCodigo ?? '';
                document.getElementById('sistema').value                    = processData.sistema ?? '';
                document.getElementById('sistemaCodigo').value              = processData.sistemaCodigo ?? '';
                document.getElementById('classeCodigo').value               = processData.classeCodigo ?? '';
                document.getElementById('orgaoJulgadorCodigo').value        = processData.orgaoJulgadorCodigo ?? '';
                document.getElementById('orgaoJulgadorMunicipioIbge').value = processData.orgaoJulgadorMunicipioIbge ?? '';
                document.getElementById('datajudId').value                  = processData.datajudId ?? '';

                const partesContainer = document.getElementById('partesContainer');
                partesContainer.innerHTML = '';
                const partesList = processData.partes && processData.partes.length > 0 ? processData.partes : [{}];
                partesList.forEach((parte, idx) => {
                    partesContainer.insertAdjacentHTML('beforeend', `
                        <div class="parte-row card mb-2 p-3" style="position: relative;">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.tipo'))}</label>
                                    <select name="partes[${idx}][tipo]" class="form-select">
                                        <option value="PARTE" ${(parte.tipo||'') === 'PARTE' ? 'selected' : ''}>${esc(BJ_T.t('processo.form.js.parte.parte'))}</option>
                                        <option value="ADVOGADO" ${(parte.tipo||'') === 'ADVOGADO' ? 'selected' : ''}>${esc(BJ_T.t('processo.form.js.parte.advogado'))}</option>
                                        <option value="JUIZ" ${(parte.tipo||'') === 'JUIZ' ? 'selected' : ''}>${esc(BJ_T.t('processo.form.js.parte.juiz'))}</option>
                                        <option value="PROMOTOR" ${(parte.tipo||'') === 'PROMOTOR' ? 'selected' : ''}>${esc(BJ_T.t('processo.form.js.parte.promotor'))}</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.nome'))}</label>
                                    <input type="text" name="partes[${idx}][nome]" class="form-control parte-nome"
                                           value="${parte.nome || ''}" placeholder="${esc(BJ_T.t('processo.form.js.parte.nome_placeholder'))}">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.documento'))}</label>
                                    <input type="text" name="partes[${idx}][documento]" class="form-control"
                                           value="${parte.documento || ''}" placeholder="${esc(BJ_T.t('processo.form.js.parte.documento_placeholder'))}">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.papel'))}</label>
                                    <input type="text" name="partes[${idx}][papel]" class="form-control"
                                           value="${parte.papel || ''}" placeholder="${esc(BJ_T.t('processo.form.js.parte.papel_placeholder'))}">
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-parte"
                                    style="display: ${partesList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                                    title="${esc(BJ_T.t('processo.form.js.remover'))}"><i class="bi bi-trash"></i></button>
                        </div>
                    `);
                });

                const movimentacoesContainer = document.getElementById('movimentacoesContainer');
                movimentacoesContainer.innerHTML = '';
                const movsList = processData.movimentacoes && processData.movimentacoes.length > 0 ? processData.movimentacoes : [{}];
                movsList.forEach((mov, idx) => {
                    movimentacoesContainer.insertAdjacentHTML('beforeend', `
                        <div class="movimentacao-row card mb-2 p-3" style="position: relative;">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.data'))}</label>
                                    <input type="date" name="movimentacoes[${idx}][dataMovimentacao]" class="form-control"
                                           value="${mov.dataMovimentacao || ''}">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.descricao'))}</label>
                                    <input type="text" name="movimentacoes[${idx}][descricao]" class="form-control mov-descricao"
                                           value="${mov.descricao || ''}" placeholder="${esc(BJ_T.t('processo.form.js.movimentacao.descricao_placeholder'))}" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.tipo'))}</label>
                                    <input type="text" name="movimentacoes[${idx}][tipo]" class="form-control"
                                           value="${mov.tipo || ''}" placeholder="${esc(BJ_T.t('processo.form.js.movimentacao.tipo_placeholder'))}">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.orgao'))}</label>
                                    <input type="text" name="movimentacoes[${idx}][orgao]" class="form-control"
                                           value="${mov.orgao || ''}" placeholder="${esc(BJ_T.t('processo.form.js.orgao'))}">
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-movimentacao"
                                    style="display: ${movsList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                                    title="${esc(BJ_T.t('processo.form.js.remover'))}"><i class="bi bi-trash"></i></button>
                        </div>
                    `);
                });

                const assuntosContainer = document.getElementById('assuntosContainer');
                assuntosContainer.innerHTML = '';
                const assuntosList = processData.assuntos && processData.assuntos.length > 0 ? processData.assuntos : [{}];
                assuntosList.forEach((assunto, idx) => {
                    assuntosContainer.insertAdjacentHTML('beforeend', `
                        <div class="assunto-row card mb-2 p-3" style="position: relative;">
                            <div class="row g-2">
                                <div class="col-md-9">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.assunto.assunto'))}</label>
                                    <input type="text" name="assuntos[${idx}][nome]" class="form-control assunto-nome"
                                           value="${assunto.nome || ''}" placeholder="${esc(BJ_T.t('processo.form.js.assunto.nome_placeholder'))}">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">${esc(BJ_T.t('processo.form.js.assunto.codigo'))}</label>
                                    <input type="number" name="assuntos[${idx}][codigo]" class="form-control"
                                           value="${assunto.codigo ?? ''}" placeholder="${esc(BJ_T.t('processo.form.js.assunto.codigo_placeholder'))}">
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-assunto"
                                    style="display: ${assuntosList.length > 1 ? 'block' : 'none'}; position: absolute; top: 8px; right: 12px;"
                                    title="${esc(BJ_T.t('processo.form.js.remover'))}"><i class="bi bi-trash"></i></button>
                        </div>
                    `);
                });

                attachRemoveParteListener();
                attachRemoveMovimentacaoListener();
                attachRemoveAssuntoListener();
                sortarMovimentacoesPorData();
                showFeedbackModal('success', esc(BJ_T.t('processo.form.js.carregado')));

            } catch (error) {
                document.getElementById('loadingModal') && bootstrap.Modal.getInstance(document.getElementById('loadingModal'))?.hide();
                showFeedbackModal('error', esc(BJ_T.t('processo.form.js.erro_busca_tente')));
            }
        });
    }

    attachRemoveParteListener();
    attachRemoveMovimentacaoListener();
    attachRemoveAssuntoListener();
    sortarMovimentacoesPorData();

    // Reindexa as linhas de assunto no submit: remover uma do meio e adicionar outra poderia
    // gerar dois assuntos[N] (o índice vem de .length), e o PHP last-wins reescreveria um assunto
    // existente (que carrega o [id]). Renumerar 0..N-1 antes de enviar elimina a colisão.
    document.getElementById('processoForm').addEventListener('submit', function() {
        document.querySelectorAll('#assuntosContainer .assunto-row').forEach(function(row, idx) {
            row.querySelectorAll('input').forEach(function(field) {
                const name = field.getAttribute('name');
                if (name) field.setAttribute('name', name.replace(/^assuntos\[\d+\]/, 'assuntos[' + idx + ']'));
            });
        });
    });
});
</script>
{% endblock %}
