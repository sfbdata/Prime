{# ============================================================================
   Bloco "Notas técnicas" de um processo — sob o cartão do processo (aba Processo
   da pasta) ou sob o teor de uma movimentação (aba Push Processual).

   Desenho 1.2.3: as notas ficam recuadas sob o cartão, ligadas a ele por um
   conector em "L", cada uma numa caixa azul-clara com o selo "NOTA TÉCNICA"; o
   compositor é a mesma caixa, com o rótulo "NOVA NOTA TÉCNICA". No desenho a
   entrada é pelo menu de contexto, que o sistema não tem: aqui é o botão do
   cabeçalho do bloco. O campo é o editor rico da casa (decisão do orquestrador,
   não a textarea simples do desenho).

   A nota é DO PROCESSO — não da pasta. O aviso do cabeçalho diz isso na tela,
   porque a mesma nota aparece em toda pasta que vincula o processo.

   Contrato com o nota-tecnica.js (não mudar): .ps-notas (+ data-url-criar,
   data-csrf-criar, data-pasta-id, data-processo-id, data-publicacao-id,
   data-url-mencionaveis) ·
   .ps-notas-contagem · .ps-notas-lista · .ps-nota-editor (+ textarea) ·
   .ps-nota-erro · .js-nota-nova / .js-nota-cancelar / .js-nota-salvar.

   Contexto: `notas` (NotaTecnicaOutput[]), `processoId` (int),
             `publicacaoId` (int|null), `pastaId` (int),
             `mostrarMovimentacao` (bool, repassado ao item),
             `podeEscreverNota` (bool, opcional — ver PMC-058 abaixo),
             `idSufixoNota` (string, opcional — sufixo dos ids dos cartões quando a mesma
             nota também está em outro bloco da página; FPN-020, o Push pendurado),
             `ocultoSeVazio` (bool, opcional — C6-FPN-04, só o Push pendurado: o bloco
             nasce escondido quando não há nota e o JS o mostra ao abrir o compositor).
   ============================================================================ #}
{% set blocoId = publicacaoId ? 'notas-publicacao-' ~ publicacaoId : 'notas-processo-' ~ processoId %}
{# Pasta lápide: o ⋮ de cada nota fica só com a leitura (PMC-017). Vai aos itens pelo contexto. #}
{% set somenteLeitura = nota_tecnica_somente_leitura(pastaId) %}
{# PMC-058: criar nota exige EDIT da pasta e pasta viva — a regra do servidor. Quem só lê (ou a
   lápide) vê as notas que existem, sem "Adicionar nota técnica", sem compositor e sem "Responder
   com outra nota". A flag vem do include (`podeEscreverNota`, o teor do Push passa a sua) ou do
   `podeEditarPasta` que o parcial da aba Processo já calculou; sem nenhum dos dois, pergunta a
   `can_access_resource`, que guarda a resposta por requisição (um bloco por processo não repete
   a consulta). #}
{% set podeEscreverNota = not somenteLeitura and (podeEscreverNota is defined
    ? podeEscreverNota
    : (podeEditarPasta ?? can_access_resource('pasta', pastaId, 'edit'))) %}
{# C6-FPN-04: o bloco pendurado sob o cartão do Push existe também SEM nota, para o "Adicionar nota
   técnica" do botão direito abrir o compositor sob o cartão sem abrir o teor (abrir marca como
   lida; dc:5392 `abrirNova`). Vazio, ele nasce escondido — o `style` acompanha o `hidden` porque o
   `display:flex` do `.ps-notas` venceria o atributo. `data-oculto-se-vazio` diz ao pasta-push.js
   que pode escondê-lo de novo (sem nota, sem compositor aberto e com o teor fechado). Fora desse
   uso o parâmetro não vem e nada muda. #}
{% set ocultoSeVazio = ocultoSeVazio ?? false %}
{% set blocoOculto = ocultoSeVazio and notas is empty %}
<div class="ps-notas{{ publicacaoId ? ' ps-notas--publicacao' : '' }}" id="{{ blocoId }}"
     {%- if ocultoSeVazio %} data-oculto-se-vazio{% endif %}
     {%- if blocoOculto %} hidden style="display: none"{% endif %}
     data-url-criar="{{ path('processo_nota_tecnica_criar', {id: processoId}) }}"
     data-csrf-criar="{{ csrf_token('processo_nota_tecnica_' ~ processoId) }}"
     data-pasta-id="{{ pastaId }}"
     data-processo-id="{{ processoId }}"
     data-publicacao-id="{{ publicacaoId ?? '' }}"
     {#- @menção (PMC-019): a lista do "@" é a do Registro — só colegas que VEEM esta pasta. Fica
         no bloco, não em `[data-mencionaveis-url]`, que o pasta-mencoes.js reserva ao Registro. #}
     data-url-mencionaveis="{{ pastaId ? path('pasta_mencionaveis', {id: pastaId}) : '' }}">
    <div class="ps-notas-cab">
        <span class="ps-notas-titulo"><i class="bi bi-journal-text" aria-hidden="true"></i>{{ 'processo.notas.titulo'|trans }}</span>
        <span class="ps-contagem ps-notas-contagem" title="{{ 'processo.notas.titulo'|trans }}">{{ notas|length }}</span>
        <span class="ps-notas-aviso">
            {%- if publicacaoId %}{{ 'processo.notas.sobre_movimentacao'|trans }} {% endif -%}
            {{ 'processo.notas.aviso'|trans }}
        </span>
        {% if podeEscreverNota %}
            <span class="ps-cab-espaco"></span>
            <button type="button" class="ps-btn ps-btn--suave ps-btn--nota js-nota-nova" title="{{ 'processo.notas.adicionar'|trans }}" aria-label="{{ 'processo.notas.adicionar'|trans }}">
                <i class="bi bi-journal-plus"></i><span>{{ 'processo.notas.adicionar'|trans }}</span>
            </button>
        {% endif %}
    </div>

    <div class="ps-notas-lista">
        {% for nota in notas %}
            {{ include('processo/_nota_tecnica_item.html.twig', {nota: nota, mostrarMovimentacao: mostrarMovimentacao, somenteLeitura: somenteLeitura, podeEscreverNota: podeEscreverNota, idSufixo: idSufixoNota ?? ''}) }}
        {% endfor %}
    </div>

    {# Desenho dc:1693–1710 (auditoria 2 P3): as notas primeiro, o compositor depois. #}
    {% if podeEscreverNota %}
    <div class="ps-nota-editor" hidden>
        <div class="ps-nota-editor-rotulo"><i class="bi bi-journal-plus" aria-hidden="true"></i>{{ 'processo.notas.nova'|trans }}</div>
        {#- EDT-021: o editor mantém o "Salvar nota" apagado enquanto estiver vazio (contrato
            `data-editor-rico-envio` do editor-rico.js; o id é único por bloco). #}
        <textarea class="ps-nota-textarea" rows="3" maxlength="5000"
                  data-editor-rico-envio="{{ blocoId }}-salvar"
                  aria-label="{{ 'processo.notas.texto'|trans }}"
                  {#- Desenho dc:1713 (aba Processo) e dc:2554 (teor do Push), com a frase da @menção. #}
                  placeholder="{{ publicacaoId ? 'processo.notas.placeholder_despacho'|trans : 'processo.notas.placeholder_processo'|trans }}"></textarea>
        <div class="ps-nota-erro" hidden></div>
        <div class="ps-nota-editor-acoes">
            <button type="button" class="ps-btn js-nota-cancelar">{{ 'processo.notas.cancelar'|trans }}</button>
            <button type="button" class="ps-btn ps-btn--primario js-nota-salvar" id="{{ blocoId }}-salvar" title="{{ 'processo.notas.salvar_dica'|trans }}">{{ 'processo.notas.salvar'|trans }}</button>
        </div>
    </div>
    {% endif %}
</div>
