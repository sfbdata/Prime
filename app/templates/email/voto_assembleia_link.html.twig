{#
    Link pessoal da unidade para votar na assembleia (App\Voto\Service\LinkDaUnidadeMailer). O desenho não tem
    este e-mail: segue o padrão dos e-mails do sistema (convite_escritorio.html.twig).
    Contexto: `assembleia` (título), `unidade` (rótulo), `responsavel` (ou null) e `link` (absoluto).
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'voto.assembleia.gestor.email.titulo'|trans }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,Helvetica,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:32px 0;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden;max-width:600px;width:100%;">
                    <tr>
                        <td style="background-color:#1a56db;padding:24px 32px;">
                            <p style="margin:0;font-size:22px;font-weight:bold;color:#ffffff;">BlueJus</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px;">
                            <p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#1a1a2e;">
                                {{ responsavel ? 'voto.assembleia.gestor.email.ola'|trans({nome: responsavel}) : 'voto.assembleia.gestor.email.ola_sem_nome'|trans }}
                            </p>

                            <p style="margin:0 0 24px;font-size:15px;color:#444444;line-height:1.6;">
                                {{ 'voto.assembleia.gestor.email.texto'|trans({unidade: unidade, assembleia: assembleia}) }}
                            </p>

                            <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                                <tr>
                                    <td style="border-radius:6px;background-color:#1a56db;">
                                        <a href="{{ link }}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:6px;">
                                            {{ 'voto.assembleia.gestor.email.botao'|trans }}
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 16px;font-size:14px;color:#444444;line-height:1.6;">
                                <strong>{{ 'voto.assembleia.gestor.email.aviso'|trans }}</strong>
                            </p>

                            <p style="margin:0;font-size:13px;color:#888888;">
                                {{ 'voto.assembleia.gestor.email.nao_funcionar'|trans }}
                            </p>
                            <p style="margin:4px 0 0;font-size:12px;color:#1a56db;word-break:break-all;">
                                {{ link }}
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
