{#
    Link pessoal da unidade para votar na assembleia (App\Voto\Service\LinkDaUnidadeMailer). O desenho não tem
    este e-mail: segue o padrão dos e-mails do sistema (convite_escritorio.html.twig).
    Contexto: `assembleia` (título), `unidade` (rótulo), `responsavel` (ou null) e `link` (absoluto).
#}
{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'voto.assembleia.gestor.email.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">
    {{ responsavel ? 'voto.assembleia.gestor.email.ola'|trans({nome: responsavel}) : 'voto.assembleia.gestor.email.ola_sem_nome'|trans }}
</p>

<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'voto.assembleia.gestor.email.texto'|trans({unidade: unidade, assembleia: assembleia}) }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="border-radius:4px;background-color:#0a6fa0;">
            <a href="{{ link }}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:4px;">
                {{ 'voto.assembleia.gestor.email.botao'|trans }}
            </a>
        </td>
    </tr>
</table>

<p style="margin:0 0 16px;font-size:14px;color:#34505f;line-height:1.6;">
    <strong>{{ 'voto.assembleia.gestor.email.aviso'|trans }}</strong>
</p>

<p style="margin:0;font-size:13px;color:#5f7684;">
    {{ 'voto.assembleia.gestor.email.nao_funcionar'|trans }}
</p>
<p style="margin:4px 0 0;font-size:12px;color:#0a6fa0;word-break:break-all;">
    {{ link }}
</p>
{% endblock %}
