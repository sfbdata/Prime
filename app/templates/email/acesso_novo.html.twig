<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'emails.acesso_novo.titulo'|trans }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,Helvetica,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:32px 0;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden;max-width:600px;width:100%;">
                    <tr>
                        <td style="background-color:#1a56db;padding:24px 32px;">
                            <p style="margin:0;font-size:22px;font-weight:bold;color:#ffffff;">BlueJus</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px;">
                            <p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#1a1a2e;">{{ 'emails.acesso_novo.ola'|trans({nome: nome}) }}</p>

                            <p style="margin:0 0 16px;font-size:15px;color:#444444;line-height:1.6;">
                                {{ 'emails.acesso_novo.aviso'|trans }}
                            </p>

                            <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;font-size:15px;color:#444444;line-height:1.6;">
                                <tr>
                                    <td style="padding:2px 16px 2px 0;color:#888888;">{{ 'emails.acesso_novo.quando'|trans }}</td>
                                    <td style="padding:2px 0;"><strong>{{ quando|date('d/m/Y H:i', false) }}</strong></td>
                                </tr>
                                <tr>
                                    <td style="padding:2px 16px 2px 0;color:#888888;">{{ 'emails.acesso_novo.navegador'|trans }}</td>
                                    <td style="padding:2px 0;"><strong>{{ navegador ?? ('emails.acesso_novo.desconhecido'|trans) }}</strong></td>
                                </tr>
                                <tr>
                                    <td style="padding:2px 16px 2px 0;color:#888888;">{{ 'emails.acesso_novo.sistema'|trans }}</td>
                                    <td style="padding:2px 0;"><strong>{{ sistema ?? ('emails.acesso_novo.desconhecido'|trans) }}</strong></td>
                                </tr>
                            </table>

                            <p style="margin:0 0 16px;font-size:15px;color:#444444;line-height:1.6;">
                                {{ 'emails.acesso_novo.se_foi_voce'|trans }}
                            </p>
                            <p style="margin:0 0 24px;font-size:15px;color:#444444;line-height:1.6;">
                                {{ 'emails.acesso_novo.se_nao_foi'|trans }}
                            </p>

                            <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                                <tr>
                                    <td style="background-color:#1a56db;border-radius:6px;">
                                        <a href="{{ link }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">{{ 'emails.acesso_novo.botao'|trans }}</a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 8px;font-size:13px;color:#888888;line-height:1.6;">{{ 'emails.acesso_novo.nao_funcionar'|trans }}</p>
                            <p style="margin:0;font-size:13px;color:#1a56db;word-break:break-all;">{{ link }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
