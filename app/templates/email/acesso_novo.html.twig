{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.acesso_novo.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.acesso_novo.ola'|trans({nome: nome}) }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.acesso_novo.aviso'|trans }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    <tr>
        <td style="padding:2px 16px 2px 0;color:#5f7684;">{{ 'emails.acesso_novo.quando'|trans }}</td>
        <td style="padding:2px 0;"><strong>{{ quando|date('d/m/Y H:i', false) }}</strong></td>
    </tr>
    <tr>
        <td style="padding:2px 16px 2px 0;color:#5f7684;">{{ 'emails.acesso_novo.navegador'|trans }}</td>
        <td style="padding:2px 0;"><strong>{{ navegador ?? ('emails.acesso_novo.desconhecido'|trans) }}</strong></td>
    </tr>
    <tr>
        <td style="padding:2px 16px 2px 0;color:#5f7684;">{{ 'emails.acesso_novo.sistema'|trans }}</td>
        <td style="padding:2px 0;"><strong>{{ sistema ?? ('emails.acesso_novo.desconhecido'|trans) }}</strong></td>
    </tr>
</table>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.acesso_novo.se_foi_voce'|trans }}
</p>
<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.acesso_novo.se_nao_foi'|trans }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="background-color:#0a6fa0;border-radius:4px;">
            <a href="{{ link }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">{{ 'emails.acesso_novo.botao'|trans }}</a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;color:#5f7684;line-height:1.6;">{{ 'emails.acesso_novo.nao_funcionar'|trans }}</p>
<p style="margin:0;font-size:13px;color:#0a6fa0;word-break:break-all;">{{ link }}</p>
{% endblock %}
