{% extends 'email/_moldura.html.twig' %}

{# Faixa do topo no vermelho de alerta (o cabeçalho deste e-mail já era vermelho antes da moldura comum). #}
{% set corDaFaixa = '#a3232b' %}

{% block titulo_documento %}{{ 'emails.codigo_exclusao_conta.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.codigo_exclusao_conta.ola'|trans({nome: nome}) }}</p>
<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.codigo_exclusao_conta.pedido_inicio'|trans }} <strong>{{ escritorio }}</strong> {{ 'emails.codigo_exclusao_conta.pedido_fim'|trans }}
    {{ 'emails.codigo_exclusao_conta.use_codigo'|trans }}
</p>
<p style="margin:0 0 24px;font-size:32px;font-weight:bold;letter-spacing:8px;color:#a3232b;">{{ codigo }}</p>
<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    <strong>{{ 'emails.codigo_exclusao_conta.vale'|trans }}</strong> {{ 'emails.codigo_exclusao_conta.digite'|trans }}
</p>
<p style="margin:0;font-size:13px;color:#5f7684;line-height:1.6;">
    {{ 'emails.codigo_exclusao_conta.nao_foi_voce'|trans }}
</p>
{% endblock %}
