{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.redefinicao_senha.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.redefinicao_senha.ola'|trans({nome: nome}) }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.redefinicao_senha.recebemos'|trans }} <strong>BlueJus</strong>.
</p>

<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.redefinicao_senha.clique'|trans }} <strong>{{ 'emails.redefinicao_senha.vale'|trans }}</strong> {{ 'emails.redefinicao_senha.uma_vez'|trans }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="background-color:#0a6fa0;border-radius:4px;">
            <a href="{{ link }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">{{ 'emails.redefinicao_senha.botao'|trans }}</a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;color:#5f7684;line-height:1.6;">
    {{ 'emails.redefinicao_senha.nao_funcionar'|trans }}
</p>
<p style="margin:0 0 16px;font-size:13px;color:#0a6fa0;word-break:break-all;">{{ link }}</p>

<p style="margin:24px 0 0;font-size:13px;color:#5f7684;line-height:1.6;">
    {{ 'emails.redefinicao_senha.nao_pediu'|trans }}
</p>
{% endblock %}
