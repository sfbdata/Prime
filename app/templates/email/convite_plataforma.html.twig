{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.convite_plataforma.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">
    {{ invitation.fullName ? 'emails.convite_plataforma.ola_nome'|trans({nome: invitation.fullName}) : 'emails.convite_plataforma.ola'|trans }}
</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.convite_plataforma.convidado_inicio'|trans }} <strong>BlueJus</strong>{{ 'emails.convite_plataforma.convidado_fim'|trans }}
</p>

<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.convite_plataforma.oab'|trans }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="border-radius:4px;background-color:#0a6fa0;">
            <a href="{{ link }}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:4px;">
                {{ 'emails.convite_plataforma.criar_conta'|trans }}
            </a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;color:#5f7684;">
    {{ 'emails.convite_plataforma.expira'|trans }} <strong>{{ 'emails.convite_plataforma.data_as_hora'|trans({data: invitation.expiresAt|data, hora: invitation.expiresAt|hora}) }}</strong>.
</p>

<p style="margin:0;font-size:13px;color:#5f7684;">
    {{ 'emails.convite_plataforma.nao_funcionar'|trans }}
</p>
<p style="margin:4px 0 0;font-size:12px;color:#0a6fa0;word-break:break-all;">
    {{ link }}
</p>
{% endblock %}

{% block rodape %}
{{ 'emails.convite_plataforma.nao_solicitou'|trans }}
{% endblock %}
