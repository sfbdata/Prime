{# E-mail do escritório ao cliente pelo Push (spec push-avisar-cliente §3): o layout da implementação
   provisória do envio (EnvioDeEmailAoClientePeloMailer), até o Carteiro da 5d assumir layout e rodapé.
   Contexto: `escritorio`, `titulo` (opcional), `corpoHtml` (o miolo, JÁ ESCAPADO por quem montou a
   mensagem: TextoDoEnvioAoCliente::html), `linkDescadastro`. #}
{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ titulo ?: (escritorio ?: 'BlueJus') }}{% endblock %}

{% block cabecalho %}{{ escritorio }}{% endblock %}

{% block corpo %}
{% if titulo %}
    <p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ titulo }}</p>
{% endif %}
{{ corpoHtml|raw }}
{% endblock %}

{% block rodape %}
<p style="margin:0 0 6px;">
    {{ 'emails.push_cliente.motivo'|trans({escritorio: escritorio ?: 'emails.push_cliente.um_escritorio'|trans}) }}
</p>
<p style="margin:0;">
    <a href="{{ linkDescadastro }}" style="color:#5f7684;">{{ 'emails.push_cliente.descadastro'|trans }}</a>
</p>
{% endblock %}
