{# Resumo diário por e-mail (desenho 07, prefT 'resumo': "Prazos e metas do dia, às 8h"; spec docs/specs/resumo-diario-por-email.md).
   Só o miolo: o cabeçalho e o rodapé legal são do layout do Carteiro. Estilo inline (clientes de e-mail).
   Variáveis: nome, escritorio, dia (DateTimeImmutable), itens (ItensDoResumoDiario), url. #}
{% import 'email/comercial/automacao/_blocos.html.twig' as b %}
{{ b.texto((nome ? 'Bom dia, ' ~ nome ~ '.' : 'Bom dia.') ~ ' Este é o seu dia em ' ~ escritorio ~ ', ' ~ dia|date('d/m/Y') ~ '.') }}
{% if itens.prazos is not empty %}
    {{ b.titulo('Prazos e audiências de hoje (' ~ itens.prazos|length ~ ')') }}
    {{ b.noticias(itens.prazos|map(p => [(p.hora ? p.hora ~ ' · ' : '') ~ p.tipo ~ ': ' ~ p.titulo, p.pasta ? 'Pasta ' ~ p.pasta : 'Agenda'])) }}
{% endif %}
{% if itens.metas is not empty %}
    {{ b.titulo('Metas que vencem hoje (' ~ itens.metas|length ~ ')') }}
    {{ b.noticias(itens.metas|map(m => [m.titulo, m.pasta ? 'Pasta ' ~ m.pasta : ''])) }}
{% endif %}
{{ b.botao('Abrir o BlueJus', url) }}
