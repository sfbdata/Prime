{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.convite_escritorio.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">
    {{ invitation.fullName ? 'emails.convite_escritorio.ola_nome'|trans({nome: invitation.fullName}) : 'emails.convite_escritorio.ola'|trans }}
</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    <strong>{{ invitation.tenant ? invitation.tenant.name : 'emails.convite_escritorio.um_escritorio'|trans }}</strong> {{ 'emails.convite_escritorio.convidou'|trans }}
</p>

<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.convite_escritorio.enviado_por'|trans }} <strong>{{ invitation.createdBy ? invitation.createdBy.fullName : 'emails.convite_escritorio.um_administrador'|trans }}</strong>.
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="border-radius:4px;background-color:#0a6fa0;">
            <a href="{{ link }}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:4px;">
                {{ 'emails.convite_escritorio.ver_convite'|trans }}
            </a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;color:#5f7684;">
    {{ 'emails.convite_escritorio.expira'|trans }} <strong>{{ invitation.expiresAt|data }}</strong>.
</p>

<p style="margin:0;font-size:13px;color:#5f7684;">
    {{ 'emails.convite_escritorio.nao_funcionar'|trans }}
</p>
<p style="margin:4px 0 0;font-size:12px;color:#0a6fa0;word-break:break-all;">
    {{ link }}
</p>
{% endblock %}

{% block rodape %}
{{ 'emails.convite_escritorio.nao_esperava'|trans }}
{% endblock %}
