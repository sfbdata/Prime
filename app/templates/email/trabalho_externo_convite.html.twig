{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.trabalho_externo_convite.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.trabalho_externo_convite.ola'|trans({nome: convite.nome}) }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.trabalho_externo_convite.convidou'|trans }} <strong>{{ servico }}</strong> {{ 'emails.trabalho_externo_convite.em'|trans }} <strong>{{ local }}</strong>{% if convite.funcao %}{{ 'emails.trabalho_externo_convite.como'|trans({funcao: convite.funcao}) }}{% endif %}.
</p>

<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.trabalho_externo_convite.acesso'|trans }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="border-radius:4px;background-color:#0a6fa0;">
            <a href="{{ link }}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:4px;">
                {{ 'emails.trabalho_externo_convite.ver_convite'|trans }}
            </a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;color:#5f7684;">
    {{ 'emails.trabalho_externo_convite.vale'|trans }} <strong>{{ convite.validade|data }}</strong>.
</p>

<p style="margin:0;font-size:13px;color:#5f7684;">
    {{ 'emails.trabalho_externo_convite.nao_funcionar'|trans }}
</p>
<p style="margin:4px 0 0;font-size:12px;color:#0a6fa0;word-break:break-all;">
    {{ link }}
</p>
{% endblock %}

{% block rodape %}
{{ 'emails.trabalho_externo_convite.nao_esperava'|trans }}
{% endblock %}
