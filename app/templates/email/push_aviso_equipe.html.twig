{# E-mail do "Avisar quando chegar" para o responsável da pasta (spec push-avisar-quando-chegar §3).
   Contexto: `nome`, `escritorio`, `aviso` (AvisoDaPastaOutput), `linkDaPasta`, `linkDescadastro`.
   Só o resumo de cada movimentação (até 220 caracteres), nunca o teor inteiro; a de processo sob
   segredo de justiça sai só com a linha genérica. #}
{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ aviso.mensagemDoEmail }}{% endblock %}

{% block cabecalho %}{{ escritorio }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.push_aviso_equipe.ola'|trans({nome: nome}) }}</p>

<p style="margin:0 0 20px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ aviso.mensagemDoEmail }}.
</p>

{% for mov in aviso.movimentacoesDoEmail %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 12px;border:1px solid #e3eaef;border-radius:4px;">
        <tr>
            <td style="padding:12px 16px;">
                {% if mov.sigilosa %}
                    {# Segredo de justiça: nem tipo, data, órgão ou resumo saem por e-mail. #}
                    <p style="margin:0;font-size:13px;color:#34505f;line-height:1.5;">{{ constant('App\\Pasta\\DTO\\MovimentacaoDoAvisoOutput::TEXTO_SIGILOSA') }}</p>
                {% else %}
                    <p style="margin:0 0 4px;font-size:14px;font-weight:bold;color:#12242f;">
                        {% if mov.data %}{{ 'emails.push_aviso_equipe.tipo_de_data'|trans({tipo: mov.tipo, data: mov.data}) }}{% else %}{{ mov.tipo }}{% endif %}
                    </p>
                    {% if mov.orgao %}
                        <p style="margin:0 0 6px;font-size:12px;color:#6b8494;">{{ mov.orgao }}</p>
                    {% endif %}
                    {% if mov.resumo %}
                        <p style="margin:0;font-size:13px;color:#34505f;line-height:1.5;">{{ mov.resumo }}</p>
                    {% endif %}
                {% endif %}
            </td>
        </tr>
    </table>
{% endfor %}
{% if aviso.restantesForaDoEmail > 0 %}
    <p style="margin:0 0 12px;font-size:13px;color:#6b8494;">{{ 'emails.push_aviso_equipe.restantes'|trans({quantas: aviso.restantesForaDoEmail ~ ''}) }}</p>
{% endif %}

<table cellpadding="0" cellspacing="0" style="margin:12px 0 24px;">
    <tr>
        <td style="border-radius:4px;background-color:#0a6fa0;">
            <a href="{{ linkDaPasta }}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:4px;">
                {{ 'emails.push_aviso_equipe.abrir_pasta'|trans }}
            </a>
        </td>
    </tr>
</table>

<p style="margin:0;font-size:13px;color:#5f7684;line-height:1.5;">
    {{ 'emails.push_aviso_equipe.motivo'|trans }}
</p>
{% endblock %}

{% block rodape %}
<a href="{{ linkDescadastro }}" style="color:#5f7684;">{{ 'emails.push_aviso_equipe.descadastro'|trans }}</a>
{% endblock %}
