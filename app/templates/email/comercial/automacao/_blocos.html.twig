{# Os blocos dos modelos do desenho 05 (dc L.488-494): texto, título, notícias (Título|Resumo) e botão. Só o miolo:
   o cabeçalho (selo, título) e o rodapé legal são do layout do Carteiro. Estilo inline (clientes de e-mail). #}
{% macro texto(t) %}{% for p in t|split("\n\n") %}<p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#1f3644;">{{ p|nl2br }}</p>{% endfor %}{% endmacro %}
{% macro titulo(t) %}<h2 style="margin:22px 0 10px;font-size:17px;font-weight:bold;color:#12242f;">{{ t }}</h2>{% endmacro %}
{% macro noticias(itens) %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">{% for i in itens %}<tr><td style="padding:10px 0;border-top:1px solid #e3eaef;"><div style="font-size:15px;font-weight:bold;color:#12242f;">{{ i[0] }}</div><div style="font-size:14px;line-height:1.5;color:#4a6373;">{{ i[1] }}</div></td></tr>{% endfor %}</table>{% endmacro %}
{% macro botao(rotulo, url) %}<p style="margin:22px 0;"><a href="{{ url }}" style="display:inline-block;background:#0a6fa0;color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;padding:12px 22px;border-radius:4px;">{{ rotulo }}</a></p>{% endmacro %}
