{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.codigo_senha.titulo'|trans({codigo: codigo}) }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.codigo_senha.ola'|trans({nome: nome}) }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.codigo_senha.use_codigo'|trans }} <strong>BlueJus</strong>:
</p>

<p style="margin:0 0 16px;font-size:32px;font-weight:bold;letter-spacing:8px;color:#12242f;font-family:'Courier New',Courier,monospace;">{{ codigo }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.codigo_senha.vale'|trans }}
</p>

<p style="margin:24px 0 0;font-size:13px;color:#7a8e9b;line-height:1.6;">
    {{ 'emails.codigo_senha.nao_pediu'|trans }}
</p>
{% endblock %}
