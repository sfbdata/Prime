{# Ao remetente (quem criou o documento): um signatário recusou, com o motivo. #}
{% extends 'email/assinatura/_moldura.html.twig' %}
{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'assinatura_eletronica.email.recusa.titulo'|trans }}</p>
<p style="margin:0 0 16px;">{{ 'assinatura_eletronica.email.recusa.texto'|trans({nome: nome, documento: documento}) }}</p>
<p style="margin:0 0 16px;padding:12px 16px;background-color:#f3f6f8;border-left:3px solid #a3232b;color:#243845;">{{ 'assinatura_eletronica.email.recusa.motivo'|trans({motivo: motivo}) }}</p>
<p style="margin:0;">{{ 'assinatura_eletronica.email.recusa.efeito'|trans }}</p>
{% endblock %}
{% block rodape %}{{ 'assinatura_eletronica.email.rodape_remetente'|trans }}{% endblock %}
