{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.cadastro_confirmacao.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.cadastro_confirmacao.ola'|trans({nome: cadastro.nomeCompleto}) }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.cadastro_confirmacao.recebemos'|trans }} <strong>BlueJus</strong> {{ 'emails.cadastro_confirmacao.para_o_escritorio'|trans }}
    <strong>{{ cadastro.nomeEscritorio }}</strong>. {{ 'emails.cadastro_confirmacao.falta_confirmar'|trans }}
</p>

<p style="margin:0 0 24px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.cadastro_confirmacao.clique'|trans }}
</p>

<table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
        <td style="background-color:#0a6fa0;border-radius:4px;">
            <a href="{{ link }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">{{ 'emails.cadastro_confirmacao.botao'|trans }}</a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px;font-size:13px;color:#5f7684;line-height:1.6;">
    {{ 'emails.cadastro_confirmacao.nao_funcionar'|trans }}
</p>
<p style="margin:0 0 16px;font-size:13px;color:#0a6fa0;word-break:break-all;">{{ link }}</p>

<p style="margin:24px 0 0;font-size:13px;color:#5f7684;line-height:1.6;">
    {{ 'emails.cadastro_confirmacao.ignore'|trans }}
</p>
{% endblock %}
