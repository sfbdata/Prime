{% extends 'email/_moldura.html.twig' %}

{% block titulo_documento %}{{ 'emails.teto_codigo_senha.titulo'|trans }}{% endblock %}

{% block corpo %}
<p style="margin:0 0 16px;font-size:18px;font-weight:bold;color:#12242f;">{{ 'emails.teto_codigo_senha.ola'|trans({nome: nome}) }}</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.teto_codigo_senha.aconteceu'|trans }}
</p>

<p style="margin:0 0 16px;font-size:15px;color:#34505f;line-height:1.6;">
    {{ 'emails.teto_codigo_senha.fechou'|trans }}
</p>

<p style="margin:24px 0 0;font-size:13px;color:#7a8e9b;line-height:1.6;">
    {{ 'emails.teto_codigo_senha.nao_foi_voce'|trans }}
</p>
{% endblock %}
