{% from 'voto/_texto_do_resultado.html.twig' import resumo %}
{#
    A decisão da pauta encerrada (desenho, aba Resultados L183): "Resultado: {nº} {nome}" na eleição, "Aprovada" ou
    "Rejeitada" na deliberação Sim/Não (resTx), em verde, ou a situação ("Quórum não atingido", "Empate",
    "Rejeitada: não atingiu o critério exigido") em vermelho. Contexto: `r` (ResultadoDaPauta).
#}
{% if r.decidido %}
    <div class="voto-decisao voto-decisao-ok">{{ (r.vagas > 1 or r.tipo.value == 'deliberacao') ? resumo(r) : 'voto.assembleia.gestor.resultados.resultado'|trans({numero: r.vencedor.numero, rotulo: r.vencedor.rotulo}) }}</div>
{% else %}
    <div class="voto-decisao">{{ resumo(r) }}</div>
{% endif %}
