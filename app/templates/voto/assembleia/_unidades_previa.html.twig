{#
    Prévia da importação (nada foi gravado). Contexto: `previa` (PreviaDaImportacao), `assembleia`, `token` (CSRF).
    A confirmação reenvia o texto já lido e limpo (campo `lista`): o arquivo enviado não é guardado.
#}
{% set a = assembleia %}
{% set limite = 100 %}
<div class="voto-previa" data-voto-previa>
    <div class="voto-etapa-sub">{{ 'voto.assembleia.gestor.unidades.previa_titulo'|trans }}</div>
    <div class="voto-texto">{{ 'voto.assembleia.gestor.unidades.previa_resumo'|trans({validas: previa.validas|length, invalidas: previa.invalidas|length, duplicadas: previa.duplicadas|length}) }}</div>
    {% if previa.invalidas is not empty or previa.duplicadas is not empty %}
        <div class="vAviso voto-relatorio" data-voto-previa-erros>
            {% for inv in previa.invalidas %}
                <div>{{ 'voto.assembleia.gestor.unidades.invalida'|trans({linha: inv.linha, motivo: inv.motivo}) }}</div>
            {% endfor %}
            {% if previa.duplicadas is not empty %}
                <div>{{ 'voto.assembleia.gestor.unidades.duplicadas'|trans({linhas: previa.duplicadas|join(', ')}) }}</div>
            {% endif %}
        </div>
    {% endif %}
    {% for l in previa.validas|slice(0, limite) %}
        <div class="vLin voto-unidade" data-voto-previa-linha>
            <div class="voto-unidade-dados">
                <span class="voto-participacao">{{ 'voto.assembleia.gestor.unidades.previa_linha'|trans({linha: l.linha}) }}</span>
                <b>{{ l.bloco is same as('') ? l.identificacao : l.identificacao ~ ' · ' ~ l.bloco }}</b>
                {% if l.situacao %}<span>{{ l.situacao }}</span>{% endif %}
                {% if l.fracao is not null %}<span>{{ 'voto.assembleia.gestor.unidades.fracao'|trans({fracao: l.fracao|voto_fracao}) }}</span>{% endif %}
                {% if l.responsavel %}<span>{{ l.responsavel }}</span>{% endif %}
                {% if l.email %}<span>{{ l.email }}</span>{% endif %}
            </div>
        </div>
    {% endfor %}
    {% if previa.validas|length > limite %}
        <div class="voto-texto">{{ 'voto.assembleia.gestor.unidades.previa_mais'|trans({n: previa.validas|length - limite}) }}</div>
    {% endif %}
    <form method="post" action="{{ path('voto_assembleia_unidades_importar_confirmar', {id: a.id}) }}" class="voto-form-linha">
        <input type="hidden" name="_token" value="{{ token }}">
        <textarea name="lista" hidden>{{ previa.texto }}</textarea>
        {% if previa.validas is not empty %}
            <button type="submit" class="vP vB"><i class="bi bi-check2"></i>{{ 'voto.assembleia.gestor.unidades.previa_confirmar'|trans({n: previa.validas|length}) }}</button>
        {% else %}
            <div class="voto-estado voto-estado-erro">{{ 'voto.assembleia.gestor.unidades.nenhuma_valida'|trans }}</div>
        {% endif %}
        <a class="vB" href="{{ path('voto_assembleia_unidades', {id: a.id}) }}">{{ 'voto.assembleia.gestor.unidades.previa_cancelar'|trans }}</a>
    </form>
</div>
