{#
    Folha do PDF da minuta de ata (mesma via do comprovante: HTML e GeradorDePdf). O corpo é o mesmo do .docx
    (_minuta_ata_corpo); `corpo` chega pronto de HtmlDaMinutaDeAta, com os campos [[assim]] já como <mark>.
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <title>{{ 'voto.assembleia.gestor.minuta.botao'|trans }}</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; color: #000; font-size: 11px; line-height: 1.55; }
        h1 { font-size: 14px; text-align: center; margin: 0 0 14px; }
        h2 { font-size: 11px; margin: 14px 0 5px; }
        p { margin: 0 0 7px; text-align: justify; }
        p.negrito { font-weight: bold; margin-bottom: 3px; }
        p.pequeno { font-size: 9px; }
        mark { background: #ffff00; }
        table { width: 100%; border-collapse: collapse; margin: 0 0 8px; }
        th, td { border: 1px solid #999; padding: 3px 6px; text-align: left; font-size: 10px; }
        th { font-weight: bold; }
        .assinaturas { margin-top: 34px; text-align: center; }
        .assinaturas p { text-align: center; border-top: 1px solid #000; width: 70%; margin: 40px auto 0; padding-top: 4px; }
    </style>
</head>
<body>
{{ corpo|raw }}
</body>
</html>
