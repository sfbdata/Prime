{% extends 'voto/assembleia/_moldura.html.twig' %}

{#
    Editar uma unidade da lista (a lista ainda pode mudar até a primeira pauta abrir). Sem o telefone: ele só entra pela
    importação. Contexto: `tela` (UnidadeParaEdicao), `assembleia`, `dados` (DadosDaUnidadeInput) e `erro` (texto ou null).
#}

{% set sub = 'unidades' %}

{% block conteudo %}
{% set a = assembleia %}
<div class="vC voto-assistente">
    <div class="vH"><i class="bi bi-pencil"></i>{{ 'voto.assembleia.gestor.unidades.editar_titulo'|trans }}</div>
    <div class="voto-assistente-corpo">
        {% if a.podeAlterarUnidades %}
            {% if erro %}<div class="voto-erro" role="alert" data-voto-erro>{{ erro }}</div>{% endif %}
            <form method="post" action="{{ path('voto_assembleia_unidade_editar', {id: a.id, unidade: tela.id}) }}" class="voto-importar">
                <input type="hidden" name="_token" value="{{ csrf_token('voto_assembleia_' ~ a.id) }}">
                {% include 'voto/assembleia/_unidade_campos.html.twig' with {dados: dados} only %}
                <div class="voto-form-linha">
                    <button type="submit" class="vB vP"><i class="bi bi-check2"></i>{{ 'voto.assembleia.gestor.unidades.salvar'|trans }}</button>
                    <a class="vB" href="{{ path('voto_assembleia_unidades', {id: a.id}) }}">{{ 'voto.assembleia.gestor.unidades.cancelar'|trans }}</a>
                </div>
            </form>
        {% else %}
            <div class="voto-texto">{{ 'voto.assembleia.gestor.unidades.bloqueada'|trans }}</div>
            <div><a class="vB" href="{{ path('voto_assembleia_unidades', {id: a.id}) }}">{{ 'voto.assembleia.gestor.unidades.cancelar'|trans }}</a></div>
        {% endif %}
    </div>
</div>
{% endblock %}
