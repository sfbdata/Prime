{% from 'voto/_texto_do_resultado.html.twig' import resumo %}
{#
    Aba "Resultados" de /voto (desenho L174-184, embutida por AssembleiaController::resultados): um cartão por pauta
    ENCERRADA (cada pauta é uma votação), com a faixa do resultado, os KPIs "Cédulas na urna" e "Participações
    registradas", uma linha por opção (barra sobre o peso válido; com peso, "{votos} un · {fração}"),
    "Abstenções {n} · Nulos {n}" e a decisão. Sem guardiões, o resultado sai no encerramento.
    Contexto: `assembleias` (list<AssembleiaNoPainel>).
#}
{% set encerradas = [] %}
{% for a in assembleias|filter(a => a.publicada) %}
    {% for p in a.pautasEncerradas %}
        {% set encerradas = encerradas|merge([{a: a, p: p}]) %}
    {% endfor %}
{% endfor %}
{% if encerradas is not empty %}
<div class="voto-painel" data-aba="tra">
    {% for item in encerradas %}
        {% set a = item.a %}
        {% set p = item.p %}
        {% set r = p.resultado %}
        {% set primeira_da_assembleia = loop.first or encerradas[loop.index0 - 1].a.id != a.id %}
        <div class="vC voto-resultado" id="{{ primeira_da_assembleia ? 'assembleia-' ~ a.id : 'assembleia-' ~ a.id ~ '-pauta-' ~ p.id }}" data-pauta="{{ p.id }}">
            <div class="vH"><i class="bi bi-shield-check"></i>{{ p.titulo }}<span class="voto-espaco"></span><span class="vChip voto-chip-claro">{{ 'voto.assembleia.gestor.situacao.encerrada'|trans }}</span></div>
            <div class="voto-resultado-corpo">
                <div class="voto-resultado-faixa">{{ p.titulo }}: {{ resumo(r) }}</div>
                <div class="vKpis">
                    <div class="vKpi"><b>{{ r.votantes }}</b><span>{{ 'voto.assembleia.gestor.resultados.cedulas'|trans }}</span></div>
                    <div class="vKpi"><b>{{ p.votantes }}</b><span>{{ 'voto.assembleia.gestor.resultados.participacoes'|trans }}</span></div>
                </div>
                <div class="voto-resultado-grupo">
                    <b class="voto-resultado-titulo">{{ p.titulo }}</b>
                    {% for o in r.opcoes %}
                        <div class="voto-resultado-opcao">
                            <span class="voto-resultado-nome"><b>{{ o.numero }}</b> {{ o.rotulo }}</span>
                            <span class="voto-resultado-barra"><span style="width:{{ o.percentual }}%;"></span></span>
                            <b class="voto-resultado-valor">{{ a.porFracao ? 'voto.assembleia.gestor.resultados.valor_peso'|trans({votos: o.unidades, peso: o.peso|voto_fracao}) : o.unidades }}</b>
                        </div>
                    {% endfor %}
                    <div class="voto-resultado-abst">{{ 'voto.assembleia.gestor.resultados.abstencoes'|trans({n: r.abstencoesUnidades, nulos: r.nulosUnidades}) }}</div>
                    {% include 'voto/assembleia/_decisao.html.twig' with {r: r} only %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endif %}
