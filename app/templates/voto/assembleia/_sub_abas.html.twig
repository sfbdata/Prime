{#
    Sub-abas da Gestão eleitoral (componente .vTab do desenho, L387-388). Perfis aparece só para a Administração.
    Em rascunho o assistente de 5 passos é uma aba só ("Assembleia"; os passos estão no trilho, _assistente_trilho):
    Perfis, Painel e Assembleia. Publicada: Perfis, Painel, Pautas e Unidades e links. "Avaliações" entra ao fim (também em rascunho), só para quem decide a avaliação.
    Contexto: `assembleia` (AssembleiaNoPainel ou null, na criação) e `sub`.
#}
{% set itens = [{id: 'painel', icone: 'bi-speedometer2', href: path('voto_index', {aba: 'ges'})}] %}
{# Perfis (desenho 18, L447): só a Administração, e antes do Painel, como o desenho ordena. #}
{% if voto_gere_equipe() %}
    {% set itens = [{id: 'perfis', icone: 'bi-people', href: path('voto_equipe_index')}]|merge(itens) %}
{% endif %}
{% if assembleia is null %}
    {% set itens = itens|merge([{id: 'assembleia', icone: 'bi-plus-square', href: path('voto_assembleia_nova')}]) %}
{% elseif assembleia.podeAlterarPautas %}
    {% set sub = 'assembleia' %}
    {% set itens = itens|merge([{id: 'assembleia', icone: 'bi-plus-square', href: path('voto_assembleia_editar', {id: assembleia.id})}]) %}
{% else %}
    {% set itens = itens|merge([
        {id: 'pautas', icone: 'bi-list-ol', href: path('voto_assembleia_pautas', {id: assembleia.id})},
        {id: 'unidades', icone: 'bi-list-check', href: path('voto_assembleia_unidades', {id: assembleia.id})},
    ]) %}
{% endif %}
{# Avaliações (desenho 18, H273/H469): também em rascunho, só para quem decide a avaliação (o conselho e a Administração; sem equipe própria, só a Administração). #}
{% if assembleia is not null and voto_decide_avaliacao(assembleia.id) %}
    {% set itens = itens|merge([{id: 'avaliacoes', icone: 'bi-clipboard-check', href: path('voto_assembleia_avaliacoes', {id: assembleia.id})}]) %}
{% endif %}
{# Ocorrências dos eleitores (portal): só para quem gere a assembleia, e só publicada (rascunho ainda não tem link). #}
{% if assembleia is not null and not assembleia.podeAlterarPautas and voto_edita(assembleia.id) %}
    {% set itens = itens|merge([{id: 'ocorrencias', icone: 'bi-chat-left-text', href: path('voto_assembleia_ocorrencias', {id: assembleia.id})}]) %}
{% endif %}
<nav class="vC voto-sub-abas" aria-label="{{ 'voto.assembleia.gestor.sub.rotulo'|trans }}">
    {% for item in itens %}
        <a class="vTab {{ sub == item.id ? 'vTabOn' : '' }}" href="{{ item.href }}" {% if sub == item.id %}aria-current="page"{% endif %}><i class="bi {{ item.icone }}"></i>{{ ('voto.assembleia.gestor.sub.' ~ item.id)|trans }}</a>
    {% endfor %}
</nav>
