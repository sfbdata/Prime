{#
    Aba "Acompanhar" de /voto (desenho L172, embutida por AssembleiaController::acompanhar): por pauta das
    assembleias publicadas (abertas primeiro), nome, "{assembleia} · {n} de {aptos} votaram", chip e "Assistir"
    (vB vP bi-box-arrow-up-right), que abre a página própria para projetar, e "Unidades" (vB bi-grid-3x3-gap), o painel
    de unidades da pauta, só para quem vê a relação de votantes e em cenário com lista de votantes. Nunca parcial de votos.
    Retirada e assembleia arquivada não entram; a pauta suspensa ou cancelada leva o chip do ciclo (_chip_da_pauta).
    Contexto: `assembleias` (list<AssembleiaNoPainel>).
#}
{% set linhas = [] %}
{% for primeiro in [true, false] %}
    {% for a in assembleias|filter(a => a.publicada) %}
        {% for p in a.pautas|filter(p => p.aberta == primeiro and not p.retirada) %}
            {% set linhas = linhas|merge([{a: a, p: p}]) %}
        {% endfor %}
    {% endfor %}
{% endfor %}
<div class="voto-painel" data-aba="aco">
    <div class="vC">
        <div class="vH"><i class="bi bi-broadcast"></i>{{ 'voto.acompanhar.titulo'|trans }}</div>
        <div class="vLin voto-aco-texto">{{ 'voto.assembleia.gestor.acompanhar.texto'|trans }}</div>
        {% for linha in linhas %}
            <div class="vLin voto-aco-linha" data-pauta="{{ linha.p.id }}">
                <div class="voto-aco-nome">
                    <b>{{ linha.p.titulo }}</b>
                    <div class="voto-aco-det">{{ 'voto.assembleia.gestor.acompanhar.detalhe'|trans({assembleia: linha.a.titulo, n: linha.p.votantes, aptos: linha.p.unidadesAptas}) }}</div>
                </div>
                {% include 'voto/assembleia/_chip_da_pauta.html.twig' with {p: linha.p, a: linha.a} only %}
                {% if voto_ve_relacao(linha.a.id) and linha.a.cenario.temListaDeVotantes %}
                    {% if linha.p.aguardandoAMesa %}<button type="button" class="vB" data-voto-indisponivel="{{ 'voto.indisponivel.pauta_nao_aberta'|trans }}">{% else %}<a class="vB" href="{{ path('voto_assembleia_unidades_ao_vivo', {id: linha.a.id, pauta: linha.p.id}) }}" target="_blank" rel="noopener" data-voto-unidades>{% endif %}<i class="bi bi-grid-3x3-gap"></i>{{ 'voto.assembleia.gestor.acompanhar.unidades'|trans }}{% if linha.p.aguardandoAMesa %}</button>{% else %}</a>{% endif %}
                {% endif %}
                {% if linha.p.aguardandoAMesa %}<button type="button" class="vB vP" data-voto-indisponivel="{{ 'voto.indisponivel.pauta_nao_aberta'|trans }}">{% else %}<a class="vB vP" href="{{ path('voto_assembleia_assistir', {id: linha.a.id, pauta: linha.p.id}) }}" target="_blank" rel="noopener" data-voto-assistir>{% endif %}<i class="bi bi-box-arrow-up-right"></i>{{ 'voto.assembleia.gestor.acompanhar.assistir'|trans }}{% if linha.p.aguardandoAMesa %}</button>{% else %}</a>{% endif %}
            </div>
        {% else %}
            <div class="vLin voto-aco-vazio">{{ 'voto.acompanhar.vazio'|trans }}</div>
        {% endfor %}
    </div>
</div>
