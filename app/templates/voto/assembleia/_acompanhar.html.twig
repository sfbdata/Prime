{#
    Aba "Acompanhar" de /voto (desenho L172, embutida por AssembleiaController::acompanhar): por pauta das
    assembleias publicadas (abertas primeiro), nome, "{assembleia} · {n} de {aptos} votaram", chip e "Assistir"
    (vB vP bi-box-arrow-up-right), que abre a página própria para projetar. Nunca parcial de votos.
    Contexto: `assembleias` (list<AssembleiaNoPainel>).
#}
{% set linhas = [] %}
{% for primeiro in [true, false] %}
    {% for a in assembleias|filter(a => a.publicada) %}
        {% for p in a.pautas|filter(p => p.aberta == primeiro) %}
            {% set linhas = linhas|merge([{a: a, p: p}]) %}
        {% endfor %}
    {% endfor %}
{% endfor %}
<div class="voto-painel" data-aba="aco">
    <div class="vC">
        <div class="vH"><i class="bi bi-broadcast"></i>{{ 'voto.acompanhar.titulo'|trans }}</div>
        <div class="vLin voto-aco-texto">{{ 'voto.acompanhar.texto'|trans }}</div>
        {% for linha in linhas %}
            <div class="vLin voto-aco-linha" data-pauta="{{ linha.p.id }}">
                <div class="voto-aco-nome">
                    <b>{{ linha.p.titulo }}</b>
                    <div class="voto-aco-det">{{ 'voto.assembleia.gestor.acompanhar.detalhe'|trans({assembleia: linha.a.titulo, n: linha.p.votantes, aptos: linha.p.unidadesAptas}) }}</div>
                </div>
                <span class="vChip" style="background:{{ linha.p.cor }};">{{ ('voto.assembleia.gestor.situacao.' ~ linha.p.situacao)|trans }}</span>
                <a class="vB vP" href="{{ path('voto_assembleia_assistir', {id: linha.a.id, pauta: linha.p.id}) }}" target="_blank" rel="noopener" data-voto-assistir><i class="bi bi-box-arrow-up-right"></i>{{ 'voto.assembleia.gestor.acompanhar.assistir'|trans }}</a>
            </div>
        {% else %}
            <div class="vLin voto-aco-vazio">{{ 'voto.acompanhar.vazio'|trans }}</div>
        {% endfor %}
    </div>
</div>
