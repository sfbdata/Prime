{% from 'voto/_texto_do_resultado.html.twig' import resumo %}
{#
    Telão (modo assembleia), desenho 18 (.vAo*, L297 e o CSS L51-67): tela cheia própria, nunca pop-up e não é o
    assistir.html.twig (que continua como está). Barra superior (símbolo, título, relógio, Tela cheia, Sair), coluna
    "ORDEM DO DIA" com as pautas e o QR, e um painel principal por pauta (só o da selecionada aparece; o JS troca sem
    recarregar, para não sair da tela cheia). Os números se atualizam pelo JSON voto_assembleia_telao_dados (a cada
    5 s, public/js/voto-telao.js). Resultado com barras só com a pauta encerrada e apurada (C12), sem dado pessoal.
    Botões da mesa (48px/16px): Abrir votação (janela _janela_abrir_votacao, voltar=telao), Encerrar votação com a
    confirmação do desenho, Ir para a apuração (Resultados) e Próxima. O sistema apura ao encerrar: o estado
    "Aguardando a apuração pelos guardiões" do desenho não existe aqui (guardiões são outra frente) e o resultado já aparece.
    Contexto: `a` (AssembleiaNoPainel), `divulgacao`, `selecionada` (id da pauta), `dados` (por id da pauta), `agora`.
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'voto.assembleia.gestor.telao.titulo'|trans({assembleia: a.titulo}) }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/voto.css') }}">
    <link rel="stylesheet" href="{{ asset('css/voto-janela.css') }}">
    <link rel="stylesheet" href="{{ asset('css/voto-telao.css') }}">
</head>
<body class="voto-telao">
{% set token = csrf_token('voto_assembleia_' ~ a.id) %}
{% set pautas = a.pautas %}
<div class="vAo voto-tela" role="dialog" aria-modal="true" aria-label="{{ 'voto.assembleia.gestor.telao.rotulo'|trans }}"
     data-telao data-dados="{{ path('voto_assembleia_telao_dados', {id: a.id}) }}" data-assembleia="{{ a.id }}">
    <div class="vAoTop">
        <img src="{{ asset('images/voto/bj-voto-simbolo.png') }}" alt="" class="vAoSimbolo">
        <div class="vAoTitulo"><b>{{ a.titulo }}</b></div>
        <span class="voto-espaco"></span>
        <span class="vMono vAoHora" data-telao-hora>{{ agora|date('H:i:s') }}</span>
        <button type="button" class="vB vAoB" data-telao-tela-cheia><i class="bi bi-fullscreen"></i>{{ 'voto.assembleia.gestor.telao.tela_cheia'|trans }}</button>
        <a class="vB vAoB" href="{{ path('voto_index', {aba: 'ges', _fragment: 'assembleia-' ~ a.id}) }}"><i class="bi bi-x-lg"></i>{{ 'voto.assembleia.gestor.telao.sair'|trans }}</a>
    </div>
    <div class="vAoG">
        <aside class="vAoL">
            <div class="vAoRotulo">{{ 'voto.assembleia.gestor.telao.ordem_do_dia'|trans }}</div>
            {% for p in pautas %}
                <a class="vAoI {{ p.id == selecionada ? 'vAoOn' : '' }}" href="{{ path('voto_assembleia_telao', {id: a.id, pauta: p.id}) }}" data-telao-ir="{{ p.id }}">
                    <span class="vAoN">{{ loop.index }}</span>
                    <span class="vAoNome">{{ p.titulo }}</span>
                    <span class="vChip" style="background:{{ p.cor }};" data-telao-chip>{{ ('voto.assembleia.gestor.situacao.' ~ p.situacao)|trans }}</span>
                </a>
            {% endfor %}
            <div class="vAoQr">
                <img src="{{ path('voto_assembleia_divulgacao_arquivo', {id: a.id, formato: 'png'}) }}" alt="{{ 'voto.assembleia.gestor.telao.qr_alt'|trans }}">
                <b>{{ 'voto.assembleia.gestor.telao.aponte'|trans }}</b>
                <span>{{ 'voto.assembleia.gestor.telao.codigo'|trans({codigo: divulgacao.codigoDeConferencia}) }}</span>
            </div>
        </aside>
        {% for p in pautas %}
            {% set d = dados[p.id] %}
            {% set r = p.encerrada ? p.resultado : null %}
            <main class="vAoM" data-telao-pauta="{{ p.id }}" data-situacao="{{ p.situacao }}"{% if p.id != selecionada %} hidden{% endif %}>
                <div><span class="vChip vAoChip" style="background:{{ p.cor }};" data-telao-chip>{{ ('voto.assembleia.gestor.situacao.' ~ p.situacao)|trans }}</span></div>
                <h1 class="vAoH1">{{ p.titulo }}</h1>
                <div class="vAoNums">
                    <div><b data-telao-votantes>{{ d.votantes }}</b><small>{{ 'voto.assembleia.gestor.telao.votaram'|trans }}</small></div>
                    <div><b data-telao-aptos>{{ d.aptos }}</b><small>{{ 'voto.assembleia.gestor.telao.aptos'|trans }}</small></div>
                    <div><b data-telao-percentual>{{ d.percentual }}</b><small>{{ (a.porFracao ? 'voto.assembleia.gestor.telao.das_fracoes' : 'voto.assembleia.gestor.telao.de_participacao')|trans }}</small></div>
                </div>
                <div class="vAoBar">
                    <u style="width:{{ d.largura }}%;" data-telao-barra></u>
                    <em data-telao-marca{% if d.quorumMarca is null %} hidden{% endif %} style="left:{{ d.quorumMarca ?? 0 }}%;"></em>
                </div>
                <div class="vAoLinha">
                    <b data-telao-quorum>{{ d.quorumTexto }}</b>
                    {% if p.aberta %}
                        {% if d.segundos is null %}
                            <span data-telao-cron>{{ 'voto.assembleia.gestor.mesa.sem_prazo_definido'|trans }}</span>
                        {% else %}
                            <span data-telao-cron data-segundos="{{ d.segundos }}" data-modelo="{{ 'voto.assembleia.gestor.mesa.encerra_em'|trans({tempo: '{tempo}'}) }}">{{ 'voto.assembleia.gestor.mesa.encerra_em'|trans({tempo: '%02d:%02d'|format(d.segundos // 60, d.segundos % 60)}) }}</span>
                        {% endif %}
                    {% elseif p.aguardandoAMesa %}
                        <span>{{ 'voto.assembleia.gestor.telao.aguardando_abertura'|trans }}</span>
                    {% endif %}
                </div>
                {% if r is not null %}
                    {% set total = max(r.totalDeEscolhas, 1) %}
                    <div class="vAoRes">
                        <div>
                            <div class="vAoResTopo">
                                <b>{{ p.titulo }}</b>
                                <span class="vAoDecisao">{{ r.decidido ? (r.vagas > 1 ? resumo(r) : 'voto.assembleia.gestor.resultados.resultado'|trans({numero: r.vencedor.numero, rotulo: r.vencedor.rotulo})) : r.situacao }}</span>
                            </div>
                            {% for o in r.opcoes %}
                                <div class="vAoIt"><span>{{ o.numero }}&nbsp; {{ o.rotulo }}</span><div><u style="width:{{ (o.unidades * 100 / total)|round }}%;"></u></div><b>{{ o.unidades }}</b></div>
                            {% endfor %}
                            <div class="vAoIt"><span>{{ (p.tipo.eleitoral ? 'voto.assembleia.gestor.telao.brancos' : 'voto.assembleia.gestor.telao.abstencoes')|trans }}</span><div><u style="width:{{ (r.abstencoesUnidades * 100 / total)|round }}%;"></u></div><b>{{ r.abstencoesUnidades }}</b></div>
                            <div class="vAoIt"><span>{{ 'voto.assembleia.gestor.telao.nulos'|trans }}</span><div><u style="width:{{ (r.nulosUnidades * 100 / total)|round }}%;"></u></div><b>{{ r.nulosUnidades }}</b></div>
                        </div>
                    </div>
                {% endif %}
                <div class="vAoMesa">
                    {# Suspender e Retomar votação entram em outra etapa (as rotas ainda não existem): o lugar dos botões é este. #}
                    {% if p.aguardandoAMesa %}
                        <button type="button" class="vB vAoP" data-voto-janela="#janela-abrir-{{ p.id }}"><i class="bi bi-unlock"></i>{{ 'voto.assembleia.gestor.janela_abrir.abrir'|trans }}</button>
                        <div class="voto-telao-janela">{% include 'voto/assembleia/_janela_abrir_votacao.html.twig' with {a: a, p: p, token: token, voltar: 'telao'} only %}</div>
                    {% elseif p.aberta %}
                        <form method="post" action="{{ path('voto_assembleia_pauta_encerrar', {id: a.id, pauta: p.id}) }}" class="vAoEncerrar" data-telao-encerrar>
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="voltar" value="telao">
                            <input type="hidden" name="motivo" value="{{ 'voto.assembleia.gestor.telao.motivo_padrao'|trans }}">
                            <button type="button" class="vB vAoD" data-telao-pedir-encerrar><i class="bi bi-lock"></i>{{ 'voto.assembleia.gestor.telao.encerrar'|trans }}</button>
                            <span class="vAoPergunta" data-telao-pergunta hidden>
                                <b>{{ 'voto.assembleia.gestor.telao.encerrar_pergunta'|trans }}</b>
                                <button type="button" class="vB vAoB" data-telao-continuar>{{ 'voto.assembleia.gestor.telao.continuar'|trans }}</button>
                                <button type="submit" class="vB vAoD"><i class="bi bi-lock"></i>{{ 'voto.assembleia.gestor.telao.confirmar_encerramento'|trans }}</button>
                            </span>
                        </form>
                    {% elseif p.encerrada %}
                        <a class="vB vAoP" href="{{ path('voto_index', {aba: 'tra', _fragment: 'assembleia-' ~ a.id}) }}"><i class="bi bi-calculator"></i>{{ 'voto.assembleia.gestor.telao.ir_apuracao'|trans }}</a>
                    {% endif %}
                    <span class="voto-espaco"></span>
                    {% set proxima = pautas[loop.index0 + 1] ?? null %}
                    {% if proxima is not null %}
                        <a class="vB vAoB vAoProx" href="{{ path('voto_assembleia_telao', {id: a.id, pauta: proxima.id}) }}" data-telao-ir="{{ proxima.id }}">{{ 'voto.assembleia.gestor.telao.proxima'|trans({pauta: proxima.titulo}) }}<i class="bi bi-arrow-right"></i></a>
                    {% endif %}
                </div>
            </main>
        {% endfor %}
    </div>
</div>
{% include 'voto/assembleia/_toast.html.twig' %}
<script src="{{ asset('js/voto-janela.js') }}"></script>
<script src="{{ asset('js/voto-telao.js') }}"></script>
</body>
</html>
