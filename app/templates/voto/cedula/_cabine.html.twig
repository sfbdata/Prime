{#
    Cabine de votação (urna virtual) do desenho 18 (L257-280): tela cheia escura, corpo da urna com o visor à esquerda e a
    placa e o teclado à direita, LEDs na fenda e o rodapé de demonstração. O conteúdo do visor é desenhado por
    js/voto-cabine.js. Recebe `votaveis` (pautas abertas que a unidade ainda não votou), `todas` (pautas abertas com
    opções, para a simulação e as candidaturas), `cedula` e `token`. Spec: docs/specs/voto-cabine.md.
#}
{%- set textos = {} -%}
{%- for chave in ['aria', 'conhecer', 'faixa_simulacao', 'inicio_aperte', 'seu_voto_para', 'numero', 'numero_errado', 'voto_nulo', 'abstencao',
    'rodape_titulo', 'rodape_confirma', 'rodape_corrige', 'dica', 'grava_titulo', 'grava_subtitulo', 'grava_titulo_simulacao',
    'grava_subtitulo_simulacao', 'fim', 'fim_voto', 'fim_simulacao', 'erro_titulo', 'erro_generico', 'voltar', 'concluir',
    'simular_de_novo', 'candidaturas', 'som_desligar', 'som_ligar', 'fala_digite', 'fala_abstencao', 'fala_nulo', 'fala_opcao',
    'fala_fim', 'fala_fim_simulacao', 'confirma'] -%}
    {%- set textos = textos|merge({(chave): ('voto.assembleia.cedula.cabine.' ~ chave)|trans}) -%}
{%- endfor -%}
{%- set dados = {
    assembleia: cedula.assembleia,
    logo: '/images/voto/bj-voto-logo.png',
    csrf: csrf_token('voto_cedula_' ~ token),
    urlVotar: path('voto_assembleia_cedula_votar', {token: token, pauta: 0})|replace({'/pauta/0': '/pauta/__PAUTA__'}),
    pautas: votaveis,
    simulacao: todas,
    textos: textos,
} -%}
<span hidden data-vc-cabine-dados="{{ dados|json_encode|e('html_attr') }}"></span>
<div class="uBg" role="application" aria-label="{{ 'voto.assembleia.cedula.cabine.aria'|trans }}" data-vc-cabine hidden>
    <div class="uBody">
        <div class="uFaixa" data-u-faixa hidden>{{ 'voto.assembleia.cedula.cabine.faixa_simulacao'|trans }}</div>
        <div class="uGr">
            <div class="uMold"><div class="uTela" data-u-tela></div></div>
            <div class="uDir">
                <div class="uPlaca">
                    <img src="/images/voto/bj-voto-simbolo.png" alt="">
                    <b>BLUEJUS<br>VOTO</b>
                    <button type="button" data-u-som aria-label="{{ 'voto.assembleia.cedula.cabine.som_desligar'|trans }}"><i class="bi bi-volume-up" aria-hidden="true"></i></button>
                </div>
                <div class="uTec">
                    {% set braile = {'1': '⠁', '2': '⠃', '3': '⠉', '4': '⠙', '5': '⠑', '6': '⠋', '7': '⠛', '8': '⠓', '9': '⠊', '0': '⠚'} %}
                    {% for n in ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0'] %}
                        <button type="button" class="uT{{ n == '0' ? ' uT0' : '' }}" data-u-tecla="{{ n }}" aria-label="{{ 'voto.assembleia.cedula.cabine.numero_tecla'|trans({n: n}) }}">{{ n }}<span class="uB6" aria-hidden="true">{{ braile[n] }}</span></button>
                    {% endfor %}
                    <div class="uAc">
                        <button type="button" class="uT uBr" data-u-tecla="b" data-u-branco>{{ 'voto.assembleia.cedula.cabine.branco'|trans }}</button>
                        <button type="button" class="uT uCo" data-u-tecla="c" data-u-corrige>{{ 'voto.assembleia.cedula.cabine.corrige'|trans }}</button>
                        <button type="button" class="uT uCf" data-u-tecla="o" data-u-confirma>{{ 'voto.assembleia.cedula.cabine.confirma'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="uFen" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="uDemo">{{ 'voto.assembleia.cedula.cabine.rodape_demo'|trans }}</div>
        <div class="uSr" aria-live="assertive" data-u-fala></div>
    </div>
</div>
