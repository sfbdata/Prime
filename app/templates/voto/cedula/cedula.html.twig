{% extends 'voto/cedula/_layout.html.twig' %}

{#
    Cédula da unidade na assembleia de condomínio (spec docs/specs/voto-assembleia-condominio.md, seção 1, Morador).
    Recebe `cedula` (App\Voto\DTO\CedulaOutput) e `token` (o do link, para as rotas e o CSRF).
    Desenho 18, portal do eleitor (insumo §4): cartão da pessoa identificada (L144), o aviso `.vAviso`, um `.vC` por
    pauta (L147-153) e a cabine de votação (urna virtual, L257-280, partial _cabine). Sem "cifrado", sem código de conferência e sem a faixa de
    demonstração: não há criptografia nem é demonstração (contrato, seção 1, item 4).
#}

{% block titulo %}{{ cedula.assembleia }}{% endblock %}

{% block corpo_atributos %}{% if cedula.esperaAMesa() %} data-vc-recarregar="30"{% endif %}{% endblock %}

{% block conteudo %}
    <div class="vC vcUnidade" data-vc-unidade>
        {% if cedula.apta %}<i class="bi bi-person-check-fill" aria-hidden="true"></i>{% endif %}
        <div class="vcUnidadeTx">
            <b>{{ cedula.assembleia }}</b>
            <div>{{ 'voto.assembleia.cedula.unidade'|trans }} {% if cedula.bloco != '' %}{{ cedula.bloco }} · {% endif %}{{ cedula.unidade }}</div>
        </div>
        {% if not cedula.apta %}<span class="vChip vcChipNaoApto">{{ 'voto.assembleia.cedula.nao_apto'|trans }}</span>{% endif %}
    </div>

    <div class="vAviso" data-vc-sigilo>{{ 'voto.assembleia.cedula.aviso_sigilo'|trans }}</div>

    {# Pautas abertas com opções: `todas` alimenta a simulação e as candidaturas; `votaveis` são as que esta unidade ainda pode votar. #}
    {% set todas = [] %}
    {% set votaveis = [] %}
    {% for pauta in cedula.pautas %}
        {% if cedula.assembleiaPublicada and pauta.aberta() and pauta.opcoes is not empty %}
            {% set opcoes = [] %}
            {% for o in pauta.opcoes %}
                {% set opcoes = opcoes|merge([{id: o.id, numero: o.numero, rotulo: (o.abstencao ? 'voto.assembleia.cedula.abstencao'|trans : o.rotulo), abstencao: o.abstencao}]) %}
            {% endfor %}
            {% set item = {id: pauta.id, titulo: pauta.titulo, opcoes: opcoes} %}
            {% set todas = todas|merge([item]) %}
            {% if cedula.apta and pauta.votouEm is null %}
                {% set votaveis = votaveis|merge([item]) %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% if todas is not empty %}
        <div class="vcAcoes" data-vc-acoes>
            <button type="button" class="vB" data-vc-abrir-candidaturas><i class="bi bi-person-lines-fill" aria-hidden="true"></i>{{ 'voto.assembleia.cedula.cabine.conhecer'|trans }}</button>
            <button type="button" class="vB" data-vc-abrir-simulacao><i class="bi bi-play-circle" aria-hidden="true"></i>{{ 'voto.assembleia.cedula.cabine.simular'|trans }}</button>
            <button type="button" class="vB vP" data-vc-abrir-cabine{{ votaveis is empty ? ' disabled' : '' }}><i class="bi bi-check2-square" aria-hidden="true"></i>{{ 'voto.assembleia.cedula.cabine.votar'|trans }}</button>
        </div>
    {% endif %}

    {% for pauta in cedula.pautas %}
        {% include 'voto/cedula/_pauta.html.twig' with {pauta: pauta, cedula: cedula, token: token} only %}
    {% else %}
        <div class="vAviso" data-vc-vazio>{{ 'voto.assembleia.cedula.vazio'|trans }}</div>
    {% endfor %}

    {# A cabine é fixa na tela; fica no mesmo bloco por causa de `todas` e `votaveis`, que só existem aqui. #}
    {% if todas is not empty %}
        {% include 'voto/cedula/_cabine.html.twig' with {cedula: cedula, token: token, votaveis: votaveis, todas: todas} only %}
    {% endif %}
{% endblock %}

{% block depois %}
    {# Toast do desenho (L281): verde no sucesso, vermelho no erro; some em 3600 ms. #}
    {% for mensagem in app.flashes('voto_cedula_ok') %}
        <div class="vcToast" role="status" data-vc-toast>{{ mensagem }}</div>
    {% endfor %}
    {% for mensagem in app.flashes('voto_cedula_erro') %}
        <div class="vcToast vcToastErro" role="status" data-vc-toast>{{ mensagem }}</div>
    {% endfor %}
{% endblock %}
