{% extends 'base.html.twig' %}

{#
    BlueJus Voto, tela da equipe logada.
    Desenho: docs/design/redesign-08-11-26/18 - Voto - VS 08.11.26.dc.html (spec docs/specs/bluejus-voto.md;
    inventário em docs/specs/bluejus-voto-anexo-telas.md). O cabeçalho azul e o menu no topo do desenho são a
    moldura do sistema (base.html.twig), decisão de 09/11/2026. Componentes e valores vêm do CSS do desenho
    (public/css/voto.css), nunca do AdminLTE.
    Título e as quatro abas. Votar mostra o estado vazio do desenho.
    Assembleia de condomínio (spec docs/specs/voto-assembleia-condominio.md): Gestão eleitoral, Resultados e
    Acompanhar embutem AssembleiaController::painel, ::resultados e ::acompanhar. Sem a faixa "Ambiente
    demonstrativo" do desenho em nenhuma aba: o Voto é usado em votação real (a assembleia).
    Contexto: `aba` = ele | tra | ges | aco.
#}

{% block title %}{{ 'voto.titulo'|trans }}{% endblock %}

{% block body_class %}voto-body{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/voto.css') }}">
{% endblock %}

{% block body %}
{% set abas = [
    {id: 'ele', icone: 'bi-check2-square'},
    {id: 'tra', icone: 'bi-shield-check'},
    {id: 'ges', icone: 'bi-gear'},
    {id: 'aco', icone: 'bi-broadcast'},
] %}
<div class="voto-tela" id="voto">
    <h1 class="voto-titulo">{{ 'voto.titulo'|trans }}</h1>

    <nav class="vC voto-abas" aria-label="{{ 'voto.abas.rotulo'|trans }}">
        {% for a in abas %}
            <a class="vTab {{ aba == a.id ? 'vTabOn' : '' }}" href="{{ path('voto_index', {aba: a.id}) }}"
               {% if aba == a.id %}aria-current="page"{% endif %}><i class="bi {{ a.icone }}"></i>{{ ('voto.abas.' ~ a.id)|trans }}</a>
        {% endfor %}
    </nav>

    {% if aba == 'ele' %}
        <div class="voto-painel" data-aba="ele">
            <div class="vAviso">{{ 'voto.votar.vazio_gestao'|trans }}</div>
        </div>
    {% elseif aba == 'ges' %}
        {{ render(voto_assembleia_aba('painel')) }}
    {% elseif aba == 'tra' %}
        {{ render(voto_assembleia_aba('resultados')) }}
    {% elseif aba == 'aco' %}
        {{ render(voto_assembleia_aba('acompanhar')) }}
    {% endif %}
</div>
{% include 'voto/assembleia/_toast.html.twig' %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/voto-assembleia.js') }}" defer></script>
{% endblock %}
