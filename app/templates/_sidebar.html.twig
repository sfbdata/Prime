{# templates/_sidebar.html.twig — Estilo PJe #}
{% set currentRoute = app.request.attributes.get('_route')|default('') %}

{# Backdrop escuro — fecha o sidebar ao clicar fora #}
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<aside class="app-sidebar pje-sidebar" id="pjeSidebar">

    {# ── Busca rápida ── #}
    <div class="pje-sidebar-search">
        <div class="pje-search-input-group">
            <span class="pje-search-icon"><i class="fa fa-search"></i></span>
            <input type="text" id="sidebarSearchInput"
                   class="pje-search-input"
                   placeholder="{{ 'moldura.menu_lateral.busca'|trans }}"
                   autocomplete="off"
                   aria-label="{{ 'moldura.menu_lateral.busca'|trans }}">
        </div>
        <div class="pje-search-results" id="sidebarSearchResults" style="display:none;">
            <ul class="pje-search-list" id="sidebarSearchList"></ul>
        </div>
    </div>

    {# ── Menu principal ── #}
    <div class="sidebar-wrapper pje-menu-wrapper">
        <nav>
            <ul class="pje-menu-list">

                {% if can_access_module('bi') and recurso_visivel('dashboard') %}
                    <li class="pje-menu-item {{ recurso_marca('dashboard') }}">
                        <a href="{{ path('dashboard_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'dashboard_' ? 'active' : '' }}">
                            <i class="bi bi-bar-chart-line pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.dashboard'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                <li class="pje-menu-item">
                    <a href="{{ path('expediente_index') }}"
                       class="pje-menu-link {{ currentRoute starts with 'expediente_' ? 'active' : '' }}">
                        <i class="bi bi-inbox-fill pje-nav-icon"></i>
                        <span>{{ 'moldura.menu_lateral.expediente'|trans }}</span>
                    </a>
                </li>

                {# Processos e Push Processual foram UNIFICADOS (16/10, pedido do dono): o cadastro de
                   processos mora dentro do Push Processual, e as telas de processo acendem este item.
                   Quem só tem o módulo de processos (sem o Push) não pode perder o caminho até eles:
                   para esse perfil o item continua sendo "Processos". #}
                {% if can_access_module('djen') %}
                    <li class="pje-menu-item">
                        {# O módulo se chamava DJEN: sem o alias, quem digita "djen" (o termo que os
                           usuários conhecem, e o que as notificações antigas dizem) não acha nada.
                           "processos" pelo mesmo motivo: o item Processos saiu do menu. #}
                        <a href="{{ path('push_processual_index') }}"
                           data-busca-alias="djen publicações intimações processos"
                           class="pje-menu-link {{ currentRoute starts with 'push_processual_' or currentRoute starts with 'processo_' ? 'active' : '' }}">
                            <i class="bi bi-newspaper pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.push_processual'|trans }}</span>
                        </a>
                    </li>
                {% elseif can_access_module('processos') %}
                    <li class="pje-menu-item">
                        <a href="{{ path('processo_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'processo_' ? 'active' : '' }}">
                            <i class="bi bi-briefcase pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.processos'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {# Trabalho Externo: logo abaixo do Push Processual, com o selo "NOVO" do desenho
                   (`06 - Trabalho Externo 1.0`, menu lateral). O Master global passa pelo bypass de
                   super admin; a tela decide o resto (aba suspensa, só equipe etc.). #}
                {% if can_access_module('trabalho_externo') and recurso_visivel('trabalho') %}
                    <li class="pje-menu-item {{ recurso_marca('trabalho') }}">
                        <a href="{{ path('trabalho_externo_index') }}"
                           data-busca-alias="correspondente diligência demanda externa"
                           class="pje-menu-link {{ currentRoute starts with 'trabalho_externo_' ? 'active' : '' }}">
                            <i class="bi bi-geo-alt pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.trabalho_externo'|trans }}</span>
                            <span class="pje-menu-novo" style="margin-left:auto; font-size:10px; font-weight:bold; color:#0a6fa0; background:#e5f1f7; padding:1px 6px; border-radius:3px;">{{ 'moldura.menu_lateral.selo_novo'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {% if can_access_module('cobrancas') %}
                    <li class="pje-menu-item">
                        <a href="{{ path('cobranca_carteira_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'cobranca_' ? 'active' : '' }}">
                            <i class="bi bi-cash-coin pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.cobrancas'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {% if can_access_module('tarefas') and recurso_visivel('metas') %}
                    <li class="pje-menu-item {{ recurso_marca('metas') }}">
                        <a href="{{ path('tarefa_minhas') }}"
                           class="pje-menu-link {{ currentRoute starts with 'tarefa_' ? 'active' : '' }}">
                            <i class="bi bi-list-check pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.minhas_metas'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                <li class="pje-menu-item">
                    <a href="{{ path('demandas_index') }}"
                       class="pje-menu-link {{ currentRoute == 'demandas_index' ? 'active' : '' }}">
                        <i class="bi bi-inbox pje-nav-icon"></i>
                        <span>{{ 'moldura.menu_lateral.demandas'|trans }}</span>
                    </a>
                </li>

                {% if can_access_module('agenda') %}
                    <li class="pje-menu-item">
                        <a href="{{ path('agenda_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'agenda_' ? 'active' : '' }}">
                            <i class="bi bi-calendar3 pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.agenda'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {% if can_access_module('kanban') %}
                    <li class="pje-menu-item">
                        <a href="{{ path('kanban_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'kanban_' ? 'active' : '' }}">
                            <i class="bi bi-kanban pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.kanban'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {% if can_access_module('servicedesk') %}
                    <li class="pje-menu-item">
                        <a href="{{ path('service_desk_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'service_desk_' or currentRoute starts with 'servicedesk_' ? 'active' : '' }}">
                            <i class="bi bi-headset pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.service_desk'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {% if can_access_module('ponto') %}
                    <li class="pje-menu-item">
                        <a href="{{ path('ponto_index') }}"
                           class="pje-menu-link {{ currentRoute starts with 'ponto_' ? 'active' : '' }}">
                            <i class="bi bi-fingerprint pje-nav-icon"></i>
                            <span>{{ 'moldura.menu_lateral.ponto_eletronico'|trans }}</span>
                        </a>
                    </li>
                {% endif %}

                {# Seção ADMIN — visível se o usuário tiver qualquer permissão admin.* #}
                {% set hasAnyAdminPerm =
                    can_administer('admin.users.invite') or
                    can_administer('admin.users.manage') or
                    can_administer('admin.tenant.settings.manage') or
                    can_administer('admin.roles.manage') or
                    can_administer('admin.access_requests.approve') or
                    can_administer('admin.servicedesk.manage') or
                    can_administer('admin.ponto.manage') or
                    can_administer('admin.inteligencia.manage') or
                    can_administer('admin.audit.view')
                %}
                {% if hasAnyAdminPerm %}
                    <li class="pje-menu-separator">{{ 'moldura.menu_lateral.secao_admin'|trans }}</li>

                    {% if can_administer('admin.users.invite') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('invite_user') }}"
                               class="pje-menu-link {{ currentRoute == 'invite_user' ? 'active' : '' }}">
                                <i class="bi bi-envelope pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.convidar_usuarios'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.users.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('app_tenant_users', {'tenantId': current_tenant().id}) }}"
                               class="pje-menu-link {{ currentRoute == 'app_tenant_users' ? 'active' : '' }}">
                                <i class="bi bi-people-fill pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.colaboradores'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.tenant.settings.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('app_tenant_show', {'tenantId': current_tenant().id}) }}"
                               class="pje-menu-link {{ currentRoute == 'app_tenant_show' ? 'active' : '' }}">
                                <i class="bi bi-building-gear pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.meu_escritorio'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.roles.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('app_tenant_role_index', {'tenantId': current_tenant().id}) }}"
                               class="pje-menu-link {{ currentRoute starts with 'app_tenant_role_' ? 'active' : '' }}">
                                <i class="bi bi-shield-lock pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.perfis'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.access_requests.approve') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('app_access_request_index') }}"
                               class="pje-menu-link {{ currentRoute starts with 'app_access_request_' ? 'active' : '' }}">
                                <i class="bi bi-key pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.solicitacoes_acesso'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}


                    {% if can_administer('admin.servicedesk.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('servicedesk_index') }}"
                               class="pje-menu-link {{ currentRoute == 'servicedesk_index' ? 'active' : '' }}">
                                <i class="bi bi-headset pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.service_desk_ti'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.ponto.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('app_tenant_sedes', {'tenantId': current_tenant().id}) }}"
                               class="pje-menu-link {{ currentRoute == 'app_tenant_sedes' ? 'active' : '' }}">
                                <i class="bi bi-geo-alt pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.sedes_ponto'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.tenant.settings.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('app_feriado_index', {'tenantId': current_tenant().id}) }}"
                               class="pje-menu-link {{ currentRoute starts with 'app_feriado_' ? 'active' : '' }}">
                                <i class="bi bi-calendar-check pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.feriados_folgas'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.inteligencia.manage') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('inteligencia_admin_config') }}"
                               class="pje-menu-link {{ currentRoute starts with 'inteligencia_admin_' ? 'active' : '' }}">
                                <i class="bi bi-stars pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.bluejus_ia'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}

                    {% if can_administer('admin.audit.view') %}
                        <li class="pje-menu-item">
                            <a href="{{ path('audit_log_index') }}"
                               class="pje-menu-link {{ currentRoute starts with 'audit_log_' ? 'active' : '' }}">
                                <i class="bi bi-shield-check pje-nav-icon"></i>
                                <span>{{ 'moldura.menu_lateral.trilha_auditoria'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}
                {% endif %}

            </ul>
        </nav>
    </div>

</aside>

<script>
(function () {
    'use strict';

    var sidebar  = document.getElementById('pjeSidebar');
    var backdrop = document.getElementById('sidebarBackdrop');

    function openSidebar() {
        sidebar.classList.add('sidebar-open');
        backdrop.classList.add('active');
    }

    function closeSidebar() {
        sidebar.classList.remove('sidebar-open');
        backdrop.classList.remove('active');
    }

    function toggleSidebar() {
        sidebar.classList.contains('sidebar-open') ? closeSidebar() : openSidebar();
    }

    document.addEventListener('DOMContentLoaded', function () {

        // ── Busca rápida ──────────────────────────────────────────
        var input   = document.getElementById('sidebarSearchInput');
        var results = document.getElementById('sidebarSearchResults');
        var list    = document.getElementById('sidebarSearchList');

        var links = Array.from(document.querySelectorAll('.pje-menu-link')).map(function (a) {
            return {
                label: a.querySelector('span') ? a.querySelector('span').textContent.trim() : '',
                alias: a.getAttribute('data-busca-alias') || '',
                href:  a.getAttribute('href')
            };
        }).filter(function (l) { return l.label && l.href && l.href !== '#'; });

        input.addEventListener('input', function () {
            var q = this.value.trim().toLowerCase();
            list.innerHTML = '';
            if (!q) { results.style.display = 'none'; return; }
            var found = links.filter(function (l) { return (l.label + ' ' + l.alias).toLowerCase().includes(q); });
            if (found.length === 0) {
                var vazio = document.createElement('li'); vazio.className = 'pje-search-empty'; vazio.textContent = BJ_T.t('moldura.js.busca_sem_resultado'); list.replaceChildren(vazio);
            } else {
                found.forEach(function (l) {
                    var li = document.createElement('li');
                    li.innerHTML = '<a href="' + l.href + '">' + l.label + '</a>';
                    list.appendChild(li);
                });
            }
            results.style.display = 'block';
        });

        document.addEventListener('click', function (e) {
            var searchEl = document.querySelector('.pje-sidebar-search');
            if (searchEl && !searchEl.contains(e.target)) {
                results.style.display = 'none';
            }
        });

        // ── Botão hamburger ───────────────────────────────────────
        var btn = document.getElementById('sidebarToggleBtn');
        if (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                toggleSidebar();
            });
        }

        // ── Backdrop fecha o sidebar ──────────────────────────────
        backdrop.addEventListener('click', closeSidebar);

        // ── Links do menu fecham o sidebar ────────────────────────
        document.querySelectorAll('.pje-menu-link').forEach(function (link) {
            link.addEventListener('click', closeSidebar);
        });

        // ── Escape fecha o sidebar ────────────────────────────────
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeSidebar();
        });

        // ── MutationObserver: remove sidebar-open que o AdminLTE
        //    possa reinjetar no body depois do carregamento ─────────
        var observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
                if (m.attributeName === 'class' &&
                    document.body.classList.contains('sidebar-open') &&
                    !sidebar.classList.contains('sidebar-open')) {
                    document.body.classList.remove('sidebar-open');
                }
            });
        });
        observer.observe(document.body, { attributes: true });

    });
})();
</script>
