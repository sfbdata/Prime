{% extends 'base.html.twig' %}

{#
   Edição de perfil (desenho "05 - Perfis 1.0", linhas 229-311; spec perfis-master §4.2).
   Secundário: formulário (_form). Primário (isSystem, form nulo): "Primários do escritório",
   promoção de sócio e as caixas marcadas e travadas (D5), sem campos de nome.
#}

{% block title %}{{ 'perfis.editar.titulo'|trans({nome: role.nomeExibido}) }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/perfis.css') }}">
{% endblock %}

{% block body %}
{% set ehPrimario = role.isSystem %}
<div class="pf-page">
    <div class="pf-cabecalho">
        <h1 class="pf-titulo"><i class="bi bi-shield-lock"></i>{{ 'perfis.editar.titulo'|trans({nome: role.nomeExibido}) }}
            {%- if ehPrimario %}<span class="pf-selo-titulo pf-selo-primario">{{ 'termos.primario'|trans|upper }}</span>{% else %}<span class="pf-selo-titulo pf-selo-secundario">{{ 'termos.secundario'|trans|upper }}</span>{% endif -%}
            <span class="pf-titulo-barra"></span></h1>
        <a href="{{ path('app_tenant_role_index', {tenantId: tenantId}) }}" class="pf-btn-cinza"><i class="bi bi-arrow-left"></i>{{ 'perfis.voltar'|trans }}</a>
    </div>

    {% if not ehPrimario %}
        {% include 'tenant_role/_form.html.twig' with {salvarRotulo: 'perfis.editar.salvar'|trans} %}
    {% else %}
        <div class="pf-card pf-card-primarios" data-pf-primarios>
            <div class="pf-primarios-cab"><i class="bi bi-people-fill"></i><b>{{ 'perfis.editar.primarios_titulo'|trans }}</b><span>{{ 'perfis.editar.primarios_contagem'|trans({n: primarios|length}) }}</span></div>
            {% for p in primarios %}
                <div class="pf-primario" data-pf-primario>
                    <span class="pf-avatar {{ p.titular ? 'pf-avatar-titular' : 'pf-avatar-socio' }}">{{ p.iniciais }}</span>
                    <span class="pf-primario-quem"><b>{{ p.nome }}</b><span>{{ p.email }}{% if p.oab %} · {{ 'perfis.editar.oab'|trans({numero: p.oab}) }}{% endif %}</span></span>
                    {% if p.titular %}
                        <span class="pf-tag pf-tag-titular">{{ 'perfis.editar.tag_titular'|trans({papel: 'termos.primario'|trans})|upper }}</span>
                        <i class="bi bi-lock-fill pf-cadeado-titular" title="{{ 'perfis.editar.titular_dica'|trans }}"></i>
                    {% else %}
                        <span class="pf-tag pf-tag-socio">{{ 'perfis.editar.tag_socio'|trans({papel: 'termos.primario'|trans})|upper }}</span>
                        {% if podeGerirPrimarios and not p.protegido %}
                        <form method="post" action="{{ path('app_tenant_role_primario_remover', {tenantId: tenantId, userId: p.userId}) }}" class="d-inline" data-pf-form-remover-primario>
                            <input type="hidden" name="_token" value="{{ csrf_token('remover_primario_' ~ p.userId) }}">
                            <input type="hidden" name="perfil_destino" value="" data-pf-destino>
                            <button type="button" class="pf-acao pf-acao-excluir" title="{{ 'perfis.editar.remover_primario'|trans }}" aria-label="{{ 'perfis.editar.remover_primario'|trans }}"
                                    data-pf-remover-primario data-nome="{{ p.nome }}"><i class="bi bi-trash3"></i></button>
                        </form>
                        {% endif %}
                    {% endif %}
                </div>
            {% endfor %}

            {# Promover e remover sócios é só do primário ou do Master (RegraDosPrimarios); os
               demais veem a lista sem ações. #}
            {% if podeGerirPrimarios %}
            <form method="post" action="{{ path('app_tenant_role_primario_promover', {tenantId: tenantId}) }}" class="pf-promover" data-pf-form-promover>
                <input type="hidden" name="_token" value="{{ csrf_token('promover_primario_' ~ tenantId) }}">
                <b>{{ 'perfis.editar.promover_titulo'|trans }}</b>
                <div class="pf-promover-grade">
                    <select name="usuario" data-pf-promover-select aria-label="{{ 'perfis.editar.promover_campo'|trans }}">
                        <option value="">{{ 'perfis.editar.promover_escolha'|trans }}</option>
                        {% for s in secundarios %}
                            <option value="{{ s.userId }}" data-nome="{{ s.nome }}" data-info="{{ s.email }} · {{ s.oab ? 'perfis.editar.oab'|trans({numero: s.oab}) : 'perfis.editar.sem_oab'|trans }}">{{ s.nome }} · {{ s.perfil }}</option>
                        {% endfor %}
                    </select>
                    <span class="pf-promover-info" data-pf-promover-info data-padrao="{{ 'perfis.editar.promover_info'|trans }}">{{ 'perfis.editar.promover_info'|trans }}</span>
                    <button type="button" class="pf-btn-azul" data-pf-promover><i class="bi bi-person-badge"></i>{{ 'perfis.editar.promover'|trans }}</button>
                </div>
                <span class="pf-promover-msg" data-pf-promover-msg data-padrao="{{ 'perfis.editar.promover_msg'|trans }}">{{ 'perfis.editar.promover_msg'|trans }}</span>
            </form>
            {% endif %}
        </div>

        <template data-pf-perfis-destino>
            {% if perfisSecundarios|length %}
                <label class="pf-campo"><span class="pf-campo-rotulo">{{ 'perfis.editar.destino_rotulo'|trans }}</span>
                    <select data-pf-destino-select>
                        {% for perfil in perfisSecundarios %}<option value="{{ perfil.id }}">{{ perfil.nome }}</option>{% endfor %}
                    </select>
                </label>
            {% else %}
                <span class="pf-campo-erro" data-pf-sem-destino>{{ 'perfis.editar.sem_destino'|trans }}</span>
            {% endif %}
        </template>

        {# Edição sem prazo (spec edicao-sem-prazo §3; linha de checkbox do desenho Perfis 1.2, 21.10 L448). Vale para
           todos os primários do escritório; só um primário ativo muda (o Master vê travado). Envia ao marcar (perfis.js). #}
        <div class="pf-card pf-cartao pf-sem-prazo" data-pf-sem-prazo>
            <div class="pf-cartao-cab"><i class="bi bi-clock-history"></i><b>{{ 'perfis.editar.sem_prazo.titulo'|trans }}</b></div>
            <form method="post" action="{{ path('app_tenant_role_edicao_sem_prazo', {tenantId: tenantId}) }}" data-pf-sem-prazo-form>
                <input type="hidden" name="_token" value="{{ csrf_token('edicao_sem_prazo_' ~ tenantId) }}">
                <label class="pf-item{{ podeMudarSemPrazo ? '' : ' is-travado' }}"><input type="checkbox" name="ligado" value="1" data-pf-sem-prazo-caixa{{ edicaoSemPrazo ? ' checked' : '' }}{{ podeMudarSemPrazo ? '' : ' disabled' }}>{{ 'perfis.editar.sem_prazo.rotulo'|trans }}</label>
            </form>
        </div>

        <div class="pf-cartoes">
            {% for cartao in cartoes %}
                <div class="pf-card pf-cartao">
                    <div class="pf-cartao-cab"><i class="bi {{ cartao.icone }}"></i><b>{{ cartao.rotulo }}</b></div>
                    {% for item in cartao.itens %}
                        <label class="pf-item is-travado"><input type="checkbox" value="{{ item.codigo }}" checked disabled>{{ item.rotulo }}</label>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <div class="pf-rodape">
            <span class="pf-resumo" data-pf-nota-primario>{{ 'perfis.editar.nota_primario'|trans({total: total}) }}</span>
            <a href="{{ path('app_tenant_role_index', {tenantId: tenantId}) }}" class="pf-btn-cancelar">{{ 'perfis.voltar'|trans }}</a>
        </div>
    {% endif %}

    {% include 'tenant_role/_confirmacao.html.twig' %}
</div>
{% endblock %}

{% block javascripts %}
{{ catalogo_js('perfis.js') }}
<script src="{{ asset('js/perfis.js') }}" defer></script>
{% endblock %}
