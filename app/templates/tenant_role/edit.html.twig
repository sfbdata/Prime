{% extends 'base.html.twig' %}

{#
   Edição de perfil (desenho "05 - Perfis 1.0", linhas 229-311; spec perfis-master §4.2).
   Secundário: formulário (_form). Primário (isSystem, form nulo): "Primários do escritório",
   promoção de sócio e as caixas marcadas e travadas (D5), sem campos de nome.
#}

{% block title %}Editar Perfil: {{ role.isSystem ? nomeExibido : role.name }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/perfis.css') }}">
{% endblock %}

{% block body %}
{% set ehPrimario = role.isSystem %}
<div class="pf-page">
    <div class="pf-cabecalho">
        <h1 class="pf-titulo"><i class="bi bi-shield-lock"></i>Editar Perfil: {{ ehPrimario ? nomeExibido : role.name }}
            {%- if ehPrimario %}<span class="pf-selo-titulo pf-selo-primario">PRIMÁRIO</span>{% else %}<span class="pf-selo-titulo pf-selo-secundario">SECUNDÁRIO</span>{% endif -%}
            <span class="pf-titulo-barra"></span></h1>
        <a href="{{ path('app_tenant_role_index', {tenantId: tenantId}) }}" class="pf-btn-cinza"><i class="bi bi-arrow-left"></i>Voltar</a>
    </div>

    {% if not ehPrimario %}
        {% include 'tenant_role/_form.html.twig' with {salvarRotulo: 'Salvar alterações'} %}
    {% else %}
        <div class="pf-card pf-card-primarios" data-pf-primarios>
            <div class="pf-primarios-cab"><i class="bi bi-people-fill"></i><b>Primários do escritório</b><span>{{ primarios|length }} primário(s)</span></div>
            {% for p in primarios %}
                <div class="pf-primario" data-pf-primario>
                    <span class="pf-avatar {{ p.titular ? 'pf-avatar-titular' : 'pf-avatar-socio' }}">{{ p.iniciais }}</span>
                    <span class="pf-primario-quem"><b>{{ p.nome }}</b><span>{{ p.email }}{% if p.oab %} · OAB {{ p.oab }}{% endif %}</span></span>
                    {% if p.titular %}
                        <span class="pf-tag pf-tag-titular">PRIMÁRIO TITULAR</span>
                        <i class="bi bi-lock-fill pf-cadeado-titular" title="O primário titular (quem abriu a conta) não pode ser excluído"></i>
                    {% else %}
                        <span class="pf-tag pf-tag-socio">PRIMÁRIO SÓCIO</span>
                        {% if podeGerirPrimarios %}
                        <form method="post" action="{{ path('app_tenant_role_primario_remover', {tenantId: tenantId, userId: p.userId}) }}" class="d-inline" data-pf-form-remover-primario>
                            <input type="hidden" name="_token" value="{{ csrf_token('remover_primario_' ~ p.userId) }}">
                            <input type="hidden" name="perfil_destino" value="" data-pf-destino>
                            <button type="button" class="pf-acao pf-acao-excluir" title="Remover este primário" aria-label="Remover este primário"
                                    data-pf-remover-primario data-nome="{{ p.nome }}"><i class="bi bi-trash3"></i></button>
                        </form>
                        {% endif %}
                    {% endif %}
                </div>
            {% endfor %}

            {# Promover e remover sócios é só do primário ou do Master (RegraDosPrimarios); os
               demais veem a lista sem ações. #}
            {% if podeGerirPrimarios %}
            <form method="post" action="{{ path('app_tenant_role_primario_promover', {tenantId: tenantId}) }}" class="pf-promover" data-pf-form-promover>
                <input type="hidden" name="_token" value="{{ csrf_token('promover_primario_' ~ tenantId) }}">
                <b>Promover a primário (sócio do escritório)</b>
                <div class="pf-promover-grade">
                    <select name="usuario" data-pf-promover-select aria-label="Usuário secundário a promover">
                        <option value="">Escolha um usuário secundário da conta *</option>
                        {% for s in secundarios %}
                            <option value="{{ s.userId }}" data-nome="{{ s.nome }}" data-info="{{ s.email }}{{ s.oab ? ' · OAB ' ~ s.oab : ' · sem OAB' }}">{{ s.nome }} · {{ s.perfil }}</option>
                        {% endfor %}
                    </select>
                    <span class="pf-promover-info" data-pf-promover-info data-padrao="Só usuários já cadastrados nesta conta podem ser promovidos.">Só usuários já cadastrados nesta conta podem ser promovidos.</span>
                    <button type="button" class="pf-btn-azul" data-pf-promover><i class="bi bi-person-badge"></i>Promover</button>
                </div>
                <span class="pf-promover-msg" data-pf-promover-msg data-padrao="O sócio promovido tem as mesmas competências de gestão do escritório, mas não pode excluir o primário titular. Promoções e remoções vão para a auditoria da conta.">O sócio promovido tem as mesmas competências de gestão do escritório, mas não pode excluir o primário titular. Promoções e remoções vão para a auditoria da conta.</span>
            </form>
            {% endif %}
        </div>

        <template data-pf-perfis-destino>
            {% if perfisSecundarios|length %}
                <label class="pf-campo"><span class="pf-campo-rotulo">PASSA A TER O PERFIL</span>
                    <select data-pf-destino-select>
                        {% for perfil in perfisSecundarios %}<option value="{{ perfil.id }}">{{ perfil.nome }}</option>{% endfor %}
                    </select>
                </label>
            {% else %}
                <span class="pf-campo-erro" data-pf-sem-destino>Não há perfil secundário para este usuário. Crie um perfil secundário antes de remover um primário.</span>
            {% endif %}
        </template>

        <div class="pf-cartoes">
            {% for cartao in cartoes %}
                <div class="pf-card pf-cartao">
                    <div class="pf-cartao-cab"><i class="bi {{ cartao.icone }}"></i><b>{{ cartao.rotulo }}</b></div>
                    {% for item in cartao.itens %}
                        <label class="pf-item is-travado"><input type="checkbox" value="{{ item.codigo }}" checked disabled>{{ item.rotulo }}</label>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <div class="pf-rodape">
            <span class="pf-resumo" data-pf-nota-primario>O usuário primário tem acesso total ao escritório: as {{ total }} permissões estão sempre ativas e não podem ser desmarcadas.</span>
            <a href="{{ path('app_tenant_role_index', {tenantId: tenantId}) }}" class="pf-btn-cancelar">Voltar</a>
        </div>
    {% endif %}

    {% include 'tenant_role/_confirmacao.html.twig' %}
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/perfis.js') }}" defer></script>
{% endblock %}
