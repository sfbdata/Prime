{#
   Formulário do perfil SECUNDÁRIO (novo e edição). Desenho "05 - Perfis 1.0", linhas 229-233
   (faixa + NOME DO PERFIL/DESCRIÇÃO) e 299-309 (cartões, "Marcar todos", rodapé).
   Variáveis: form, cartoes (GruposDePermissaoDoPerfil), total, salvarRotulo, tenantId.

   Todo checkbox do form é desenhado aqui: os cartões cobrem o catálogo inteiro (código que o
   desenho não conhece cai no cartão do grupo). Sobrar campo faria o form_end re-renderizar o
   widget e quebrar com "Field already rendered" (regressão do 0c2a780d).
#}
{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-pf-form-perfil': ''}}) }}

<div class="pf-faixa"><i class="bi bi-info-circle"></i>Perfil de usuário secundário (colaborador). Defina o que ele pode acessar.</div>

{% set errosNome = form.name.vars.errors %}
<div class="pf-card pf-card-campos">
    <label class="pf-campo" for="{{ form.name.vars.id }}">
        <span class="pf-campo-rotulo">NOME DO PERFIL</span>
        {{ form_widget(form.name, {attr: form.name.vars.attr|merge({class: errosNome|length ? 'is-invalido' : ''})}) }}
    </label>
    <label class="pf-campo" for="{{ form.description.vars.id }}">
        <span class="pf-campo-rotulo">DESCRIÇÃO</span>
        {{ form_widget(form.description) }}
        {% for erro in form.description.vars.errors %}<span class="pf-campo-erro">{{ erro.message }}</span>{% endfor %}
    </label>
</div>

<div class="pf-cartoes">
    {% for cartao in cartoes %}
        <div class="pf-card pf-cartao" data-pf-cartao>
            <div class="pf-cartao-cab">
                <i class="bi {{ cartao.icone }}"></i><b>{{ cartao.rotulo }}</b>
                <button type="button" class="pf-marcar-todos" data-pf-todos>Marcar todos</button>
            </div>
            {% for item in cartao.itens %}
                {% for child in form.permissions %}
                    {% if child.vars.value == item.codigo %}
                        <label class="pf-item" for="{{ child.vars.id }}">
                            {{ form_widget(child, {attr: child.vars.attr|merge({'data-pf-permissao': ''})}) }}{{ item.rotulo }}
                        </label>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
    {% endfor %}
</div>

<div class="pf-rodape">
    {% if errosNome|length %}
        <span class="pf-resumo is-erro" data-pf-resumo-erro>{{ errosNome|first.message }}</span>
    {% else %}
        <span class="pf-resumo" data-pf-resumo data-total="{{ total }}">{{ form.permissions.vars.value|length }} de {{ total }} permissões ativas</span>
    {% endif %}
    <a href="{{ path('app_tenant_role_index', {tenantId: tenantId}) }}" class="pf-btn-cancelar">Cancelar</a>
    <button type="submit" class="pf-btn-salvar"><i class="bi bi-check2"></i>{{ salvarRotulo }}</button>
</div>

{{ form_end(form) }}
