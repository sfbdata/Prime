{% extends 'base.html.twig' %}

{#
   Lista "Perfis do Escritório" (desenho "05 - Perfis 1.0", linhas 47-71; spec perfis-master §4.1).
   A linha Master e o seletor "Ver como" só existem no HTML de quem é Master (D2/D7): a prévia
   "Primário" esconde a linha no navegador, sem trocar de usuário.
#}

{% block title %}Perfis do Escritório{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/perfis.css') }}">
{% endblock %}

{% block body %}
<div class="pf-page" data-pf-lista>
    <div class="pf-cabecalho">
        <h1 class="pf-titulo"><i class="bi bi-shield-lock"></i>Perfis do Escritório<span class="pf-titulo-barra"></span></h1>
        {% if master %}
            <div class="pf-ver-como" title="Simulação: o perfil Master só aparece para o Master" data-pf-ver-como>
                <span class="pf-ver-como-rotulo">Ver como</span>
                <button type="button" class="pf-ver-como-btn is-ativo" data-pf-visao="master">Master</button>
                <button type="button" class="pf-ver-como-btn" data-pf-visao="primario">Primário</button>
            </div>
        {% endif %}
        <a href="{{ path('app_tenant_role_new', {tenantId: tenantId}) }}" class="pf-btn-cinza"><i class="bi bi-plus-lg"></i>Novo Perfil</a>
    </div>

    <div class="pf-tabela">
        <div class="pf-tabela-miolo">
            <div class="pf-grade pf-tabela-cab">
                <div>NOME</div><div>CLASSIFICAÇÃO</div><div>DESCRIÇÃO</div><div class="pf-centro">PERMISSÕES</div><div class="pf-centro">USUÁRIOS</div><div class="pf-centro">SISTEMA</div><div class="pf-centro">AÇÕES</div>
            </div>

            {% if master %}
                <div class="pf-grade pf-linha" data-pf-linha data-pf-linha-master data-href="{{ path('master_painel') }}">
                    <div class="pf-col-nome">{{ master.nome }}</div>
                    <div class="pf-col-classe"><span class="pf-selo pf-selo-master"><i class="bi bi-stars"></i>MASTER</span></div>
                    <div class="pf-col-desc">{{ master.descricao }}</div>
                    <div class="pf-col-num">Total</div>
                    <div class="pf-col-num">{{ master.usuarios }}</div>
                    <div class="pf-col-cadeado"><i class="bi bi-lock-fill"></i></div>
                    <div class="pf-col-acoes">
                        <a href="{{ path('master_painel') }}" class="pf-acao pf-acao-editar" title="Editar perfil" aria-label="Editar perfil"><i class="bi bi-pencil"></i></a>
                    </div>
                </div>
            {% endif %}

            {% for perfil in perfis %}
                {% set urlEditar = path('app_tenant_role_edit', {tenantId: tenantId, id: perfil.id}) %}
                <div class="pf-grade pf-linha" data-pf-linha data-href="{{ urlEditar }}">
                    <div class="pf-col-nome">{{ perfil.nome }}</div>
                    <div class="pf-col-classe">
                        {% if perfil.classificacao == 'primario' %}
                            <span class="pf-selo pf-selo-primario"><i class="bi bi-person-badge"></i>PRIMÁRIO</span>
                        {% else %}
                            <span class="pf-selo pf-selo-secundario"><i class="bi bi-person"></i>SECUNDÁRIO</span>
                        {% endif %}
                    </div>
                    <div class="pf-col-desc">{{ perfil.descricao }}</div>
                    <div class="pf-col-num">{{ perfil.permissoes }}</div>
                    <div class="pf-col-num">{{ perfil.usuarios }}</div>
                    <div class="pf-col-cadeado">
                        {% if perfil.podeExcluir %}<i class="bi bi-unlock"></i>{% else %}<i class="bi bi-lock-fill" title="Não pode ser excluído"></i>{% endif %}
                    </div>
                    <div class="pf-col-acoes">
                        <a href="{{ urlEditar }}" class="pf-acao pf-acao-editar" title="Editar perfil" aria-label="Editar perfil"><i class="bi bi-pencil"></i></a>
                        {% if perfil.podeExcluir %}
                            <form method="post" action="{{ path('app_tenant_role_delete', {tenantId: tenantId, id: perfil.id}) }}" class="d-inline" data-pf-form-excluir>
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_role_' ~ perfil.id) }}">
                                <button type="button" class="pf-acao pf-acao-excluir" title="Excluir perfil" aria-label="Excluir perfil"
                                        data-pf-excluir data-nome="{{ perfil.nome }}" data-usuarios="{{ perfil.usuarios }}"><i class="bi bi-trash3"></i></button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="pf-col-desc text-center py-3">Nenhum perfil encontrado.</div>
            {% endfor %}
        </div>
    </div>

    {% include 'tenant_role/_confirmacao.html.twig' %}
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/perfis.js') }}" defer></script>
{% endblock %}
