{% extends 'base.html.twig' %}

{#
   "Acesso restrito" dos Perfis (desenho "05 - Perfis 1.2 - VS 21.10.26", L496 e L822; spec
   perfis-1.2-permissoes-e-hierarquia C2): quem não é primário, nem Master, nem tem admin.roles.manage.
   "Pedir acesso" avisa os primários ativos, um pedido por pessoa por dia; depois dele (até amanhã) a
   tela mostra "Pedido enviado ao primário" no lugar do botão.
#}

{% block title %}{{ 'perfis.restrito.titulo'|trans }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/perfis.css') }}">
{% endblock %}

{% block body %}
<div class="pf-page">
    <div class="pf-restrito" data-pf-restrito>
        <div class="pf-restrito-cartao">
            <div class="pf-restrito-icone"><i class="bi bi-shield-lock"></i></div>
            <div class="pf-restrito-titulo">{{ 'perfis.restrito.titulo'|trans }}</div>
            <div class="pf-restrito-texto">{{ 'perfis.restrito.texto'|trans }}</div>
            <div class="pf-restrito-acoes">
                <a href="{{ path('expediente_index') }}" class="pf-restrito-voltar">{{ 'perfis.voltar'|trans }}</a>
                {% if jaPediuHoje %}
                    <span class="pf-restrito-enviado" data-pf-pedido-enviado><i class="bi bi-check2-circle"></i>{{ 'perfis.restrito.enviado'|trans }}</span>
                {% else %}
                    <form method="post" action="{{ path('app_tenant_role_pedir_acesso', {tenantId: tenantId}) }}" data-pf-form-pedir-acesso>
                        <input type="hidden" name="_token" value="{{ csrf_token('pedir_acesso_perfis_' ~ tenantId) }}">
                        <button type="submit" class="pf-restrito-pedir">{{ 'perfis.restrito.pedir'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
