{% extends 'base.html.twig' %}

{% block title %}Novo Perfil{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/perfis.css') }}">
{% endblock %}

{% block body %}
<div class="pf-page">
    <div class="pf-cabecalho">
        <h1 class="pf-titulo"><i class="bi bi-shield-lock"></i>Novo Perfil<span class="pf-selo-titulo pf-selo-secundario">SECUNDÁRIO</span><span class="pf-titulo-barra"></span></h1>
        <a href="{{ path('app_tenant_role_index', {tenantId: tenantId}) }}" class="pf-btn-cinza"><i class="bi bi-arrow-left"></i>Voltar</a>
    </div>

    {% include 'tenant_role/_form.html.twig' with {salvarRotulo: 'Salvar perfil'} %}
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/perfis.js') }}" defer></script>
{% endblock %}
