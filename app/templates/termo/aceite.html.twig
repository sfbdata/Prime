<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <title>Termos e Condições de Uso — BlueJus</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <style>
        :root {
            --azul: #0078AA;
            --azul-escuro: #015e85;
            --borda: #d9e2ec;
            --texto: #243240;
            --muted: #6b7a8d;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh;
            background: linear-gradient(135deg, #eef3f8 0%, #e3edf4 100%);
            font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--texto);
            display: flex; align-items: center; justify-content: center; padding: 24px;
        }
        .termo-card {
            background: #fff; width: 100%; max-width: 840px; border-radius: 14px;
            box-shadow: 0 18px 50px rgba(1, 60, 90, .18); overflow: hidden;
            display: flex; flex-direction: column; max-height: calc(100vh - 48px);
        }
        .termo-topbar { height: 4px; background: linear-gradient(90deg, var(--azul) 0%, var(--azul-escuro) 100%); }
        .termo-header {
            padding: 26px 32px 20px; border-bottom: 1px solid var(--borda); text-align: center;
        }
        .termo-header img { height: 72px; width: auto; max-width: 88%; margin-bottom: 16px; }
        .termo-header h1 { margin: 0; font-size: 18px; font-weight: 700; color: var(--texto); }
        .termo-header p { margin: 6px 0 0; font-size: 13px; color: var(--muted); }
        .termo-header .versao {
            display: inline-block; margin-top: 10px; padding: 2px 10px; border-radius: 999px;
            background: #e7f3f9; color: var(--azul-escuro); font-size: 12px; font-weight: 600;
        }
        .termo-scroll {
            overflow-y: auto; padding: 26px 32px; line-height: 1.6; font-size: 14px; text-align: justify;
            scrollbar-width: thin; scrollbar-color: #c3d2df transparent;
        }
        .termo-scroll::-webkit-scrollbar { width: 8px; }
        .termo-scroll::-webkit-scrollbar-thumb { background: #c3d2df; border-radius: 8px; }
        .termo-scroll .termo-titulo { font-size: 16px; text-align: center; color: var(--azul-escuro); margin: 0 0 18px; }
        .termo-scroll .termo-clausula {
            font-size: 14px; font-weight: 700; color: var(--azul-escuro); margin: 20px 0 6px;
            border-bottom: 1px solid var(--borda); padding-bottom: 4px;
        }
        .termo-scroll .termo-fecho { text-align: center; font-weight: 600; margin-top: 16px; }
        .termo-footer { padding: 20px 32px; border-top: 1px solid var(--borda); background: #f7fafc; }
        .alerta {
            background: #fdecea; color: #b3261e; border: 1px solid #f5c6c2;
            padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 14px;
        }
        .aceite-check { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 18px; font-size: 14px; cursor: pointer; }
        .aceite-check input { margin-top: 2px; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--azul); cursor: pointer; }
        .acoes { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
        .btn {
            border: 0; border-radius: 9px; padding: 12px 26px; font-size: 14px; font-weight: 600;
            cursor: pointer; text-decoration: none; display: inline-block; transition: background .15s, box-shadow .15s;
        }
        .btn-primary { background: var(--azul); color: #fff; box-shadow: 0 4px 12px rgba(0, 120, 170, .3); }
        .btn-primary:hover:not(:disabled) { background: var(--azul-escuro); }
        .btn-primary:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }
        .links { font-size: 13px; }
        .links a { color: var(--azul); text-decoration: none; font-weight: 600; }
        .links a:hover { text-decoration: underline; }
        .sep { color: #b6c2cf; margin: 0 8px; }
        @media (max-width: 520px) {
            .acoes { flex-direction: column-reverse; align-items: stretch; }
            .btn-primary { text-align: center; }
            .links { text-align: center; }
        }
    </style>
</head>
<body>
    <main class="termo-card">
        <div class="termo-topbar"></div>

        <div class="termo-header">
            <img src="/images/logo/bluejus_logo.svg" alt="BlueJus">
            <h1>Termos e Condições Gerais de Uso</h1>
            <p>Para continuar, leia e aceite os termos abaixo.</p>
            <span class="versao">Versão {{ versao }}</span>
        </div>

        <div class="termo-scroll">
            {% include 'termo/_texto.html.twig' %}
        </div>

        <div class="termo-footer">
            {% for message in app.flashes('erro') %}
                <div class="alerta">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('termo_aceite_registrar') }}">
                <label class="aceite-check">
                    <input type="checkbox" name="aceito" value="1" id="aceito" required>
                    <span>Li e aceito os Termos e Condições Gerais de Uso do BlueJus.</span>
                </label>

                <input type="hidden" name="_token" value="{{ csrf_token('termo_aceite') }}">

                <div class="acoes">
                    <span class="links">
                        <a href="/termos/termos-de-uso.pdf" target="_blank" rel="noopener">Baixar em PDF</a>
                        <span class="sep">·</span>
                        <a href="{{ path('legal_politica_privacidade') }}" target="_blank" rel="noopener">Política de Privacidade</a>
                        <span class="sep">·</span>
                        <a href="{{ path('app_logout') }}">Sair</a>
                    </span>
                    <button type="submit" class="btn btn-primary" id="btnAceitar">Aceitar e continuar</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        // Progressive enhancement: desabilita o botão até marcar o checkbox.
        // Sem JS, o atributo `required` + a validação no servidor garantem o aceite.
        (function () {
            var check = document.getElementById('aceito');
            var btn = document.getElementById('btnAceitar');
            if (!check || !btn) return;
            var sync = function () { btn.disabled = !check.checked; };
            sync();
            check.addEventListener('change', sync);
        })();
    </script>
</body>
</html>
