{% extends 'base.html.twig' %}

{% block title %}Verifique seu e-mail{% endblock %}

{% block stylesheets %}
{% include '_fundo_auth.html.twig' %}
<style>
.senha-wrap { max-width: 460px; }
.senha-card {
    border: 1px solid var(--bs-border-color); border-radius: 1rem;
    background: var(--bs-body-bg);
    box-shadow: 0 18px 48px rgba(1,42,70,.22); overflow: hidden;
}
.senha-body { padding: 2.25rem 1.75rem; text-align: center; }
.senha-icone {
    width: 64px; height: 64px; margin: 0 auto 1rem; border-radius: 50%;
    display: grid; place-items: center; font-size: 1.6rem; color: #fff;
    background: linear-gradient(135deg, #0078AA, #3b9fd4);
}
</style>
{% endblock %}

{% block body %}
<div class="senha-wrap mx-auto py-5">
    <div class="senha-card">
        <div class="senha-body">
            <div class="senha-icone"><i class="bi bi-envelope-check"></i></div>
            <h1 class="h5 fw-bold">Verifique seu e-mail</h1>
            <p class="text-secondary mb-3">
                Se houver uma conta com o e-mail informado, enviamos um link para criar uma nova senha.
                O link vale por <strong>1 hora</strong>.
            </p>
            <p class="text-secondary small mb-4">
                Não chegou? Confira a caixa de spam e o endereço digitado, e
                <a href="{{ path('auth_senha_esqueci') }}">tente novamente</a>.
            </p>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary">Voltar ao login</a>
        </div>
    </div>
</div>
{% endblock %}
