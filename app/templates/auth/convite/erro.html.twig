{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.convite.erro.titulo'|trans }}{% endblock %}

{% block head_meta %}<meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-container">
        {% if motivo == 'expirado' %}
            <h1>{{ 'auth.convite.erro.expirado_titulo'|trans }}</h1>
            <p>{{ 'auth.convite.erro.expirado_texto'|trans }}</p>
        {% elseif motivo == 'ja_utilizado' %}
            <h1>{{ 'auth.convite.erro.usado_titulo'|trans }}</h1>
            <p>{{ 'auth.convite.erro.usado_texto'|trans }}</p>
        {% else %}
            <h1>{{ 'auth.convite.erro.nao_encontrado_titulo'|trans }}</h1>
            <p>{{ 'auth.convite.erro.nao_encontrado_texto'|trans }}</p>
        {% endif %}

        <a href="{{ path('app_login') }}" class="btn-login d-block text-center mt-3">{{ 'auth.comum.ir_para_login'|trans }}</a>
    </div>
</div>
{% endblock %}
