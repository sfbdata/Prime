{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.convite.nao_pertence.titulo'|trans }}{% endblock %}

{% block head_meta %}<meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-container">
        <h1>{{ 'auth.convite.nao_pertence.titulo'|trans }}</h1>
        <p>
            {{ 'auth.convite.nao_pertence.enviado_para'|trans }} <strong>{{ convite.email }}</strong>.
        </p>
        <p>
            {{ 'auth.convite.nao_pertence.outra_conta'|trans }}
        </p>

        <a href="{{ logout_path('main') }}" class="btn-login d-block text-center">{{ 'auth.convite.nao_pertence.sair'|trans }}</a>
    </div>
</div>
{% endblock %}
