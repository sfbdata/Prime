{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.convite.ver_logado.titulo'|trans }}{% endblock %}

{% block head_meta %}<meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-3">{{ 'auth.convite.ver_logado.cabecalho'|trans }}</h2>

                {% if convite.tenantNome %}
                    <p class="fs-5">{{ 'auth.convite.ver_logado.colaborar_em'|trans }} <strong>{{ convite.tenantNome }}</strong>.</p>
                {% endif %}

                {% if convite.criadorNome %}
                    <p class="text-muted">{{ 'auth.convite.ver_logado.convidado_por'|trans({nome: convite.criadorNome}) }}</p>
                {% endif %}

                <p class="text-muted small">{{ 'auth.convite.ver_logado.expira'|trans({data: convite.expiresAt|data}) }}</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'erro' ? 'danger' : (label == 'info' ? 'info' : 'success') }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Pelo link do e-mail a tela tem o token da URL; pela lista do convidado logado, só o id (achado de auditoria interna F6). #}
                {% if convite.token is not null %}
                    {% set acao_aceitar = path('auth_aceite_convite_aceitar', {token: convite.token}) %}
                    {% set acao_recusar = path('auth_aceite_convite_recusar', {token: convite.token}) %}
                    {% set csrf_aceitar = csrf_token('convite_' ~ convite.token) %}
                    {% set csrf_recusar = csrf_aceitar %}
                {% else %}
                    {% set acao_aceitar = path('auth_meu_convite_aceitar', {id: convite.id}) %}
                    {% set acao_recusar = path('auth_meu_convite_recusar', {id: convite.id}) %}
                    {% set csrf_aceitar = csrf_token('convite_aceitar_' ~ convite.id) %}
                    {% set csrf_recusar = csrf_token('convite_recusar_' ~ convite.id) %}
                {% endif %}

                <div class="d-flex gap-3 mt-4">
                    <form method="post" action="{{ acao_aceitar }}">
                        <input type="hidden" name="_token" value="{{ csrf_aceitar }}">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i> {{ 'auth.convite.ver_logado.aceitar'|trans }}
                        </button>
                    </form>
                    <form method="post" action="{{ acao_recusar }}">
                        <input type="hidden" name="_token" value="{{ csrf_recusar }}">
                        <button type="submit" class="btn btn-outline-secondary">{{ 'auth.convite.ver_logado.recusar'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
