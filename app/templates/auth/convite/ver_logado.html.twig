{% extends 'base.html.twig' %}

{% block title %}Convite de Escritório{% endblock %}

{% block head_meta %}<meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-3">Convite de escritório</h2>

                {% if convite.tenantNome %}
                    <p class="fs-5">Você foi convidado para colaborar em <strong>{{ convite.tenantNome }}</strong>.</p>
                {% endif %}

                {% if convite.criadorNome %}
                    <p class="text-muted">Convidado por: {{ convite.criadorNome }}</p>
                {% endif %}

                <p class="text-muted small">Expira em {{ convite.expiresAt|date('d/m/Y') }}</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'erro' ? 'danger' : (label == 'info' ? 'info' : 'success') }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="d-flex gap-3 mt-4">
                    <form method="post" action="{{ path('auth_aceite_convite_aceitar', {token: convite.token}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('convite_' ~ convite.token) }}">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i> Aceitar convite
                        </button>
                    </form>
                    <form method="post" action="{{ path('auth_aceite_convite_recusar', {token: convite.token}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('convite_' ~ convite.token) }}">
                        <button type="submit" class="btn btn-outline-secondary">Recusar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
