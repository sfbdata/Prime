{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.cadastro.titulo'|trans }}{% endblock %}

{% block body %}
<div class="container py-5 text-center" style="max-width: 520px">
    <i class="bi bi-exclamation-triangle display-4 text-warning"></i>
    <h3 class="mt-3">{{ 'auth.comum.nao_foi_possivel_confirmar'|trans }}</h3>
    <p class="text-muted">{{ motivo }}</p>
    <div class="d-flex gap-2 justify-content-center mt-3">
        <a href="{{ path('auth_cadastro') }}" class="btn btn-primary">{{ 'auth.cadastro.refazer'|trans }}</a>
        <a href="{{ path('app_login') }}" class="btn btn-outline-secondary">{{ 'auth.comum.ir_para_login'|trans }}</a>
    </div>
</div>
{% endblock %}
