{#
    Link de confirmação do e-mail (spec docs/specs/cadastro-senha-no-link.md).
    situacao: Pendente (formulário "Crie sua senha"), JaConfirmado, SenhaCriada; motivo: link inválido ou vencido.
    pagina (só com o formulário): os endereços dos Termos e da Política, os mesmos da tela de entrada. A caixa
    "Li e aceito" é a do cadastro (D2 da spec) e é obrigatória: o servidor recusa sem ela.
    A régua de força repete a da troca de senha por código; o comportamento mora em /js/auth/criar-senha.js.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ situacao is not null and situacao.name|lower == 'pendente' ? 'auth.link.titulo_criar'|trans : 'auth.link.titulo_confirmacao'|trans }}{% endblock %}

{% block body %}
<div class="container py-5 confirmacao-email" style="max-width: 520px">
    {% if motivo is not null %}
        <div class="text-center">
            <i class="bi bi-exclamation-triangle display-4 text-warning"></i>
            <h3 class="mt-3">{{ 'auth.comum.nao_foi_possivel_confirmar'|trans }}</h3>
            <p class="text-muted">{{ motivo }}</p>
        </div>
    {% elseif situacao.name|lower == 'pendente' %}
        <div class="text-center">
            <i class="bi bi-shield-lock display-4 text-primary"></i>
            <h3 class="mt-3">{{ 'auth.link.titulo_criar'|trans }}</h3>
        </div>
        <form class="criar-senha mt-3" method="post" action="{{ path('auth_cadastro_criar_senha', {token: token}) }}" novalidate>
            <div class="mb-3">
                <label class="form-label" for="criarSenhaNova">{{ 'auth.link.nova_senha'|trans }}</label>
                <input class="form-control" id="criarSenhaNova" name="senha" type="password" placeholder="{{ 'auth.link.minimo_caracteres'|trans }}" autocomplete="new-password" autofocus>
                <div class="d-flex align-items-center gap-2 mt-2 small criar-senha__forca" data-forca="criarSenhaNova">
                    <div class="progress flex-grow-1" style="height: 4px"><div class="progress-bar criar-senha__barra" style="width: 0%"></div></div>
                    <span class="criar-senha__txt"></span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="criarSenhaConf">{{ 'auth.link.confirmacao_da_nova'|trans }}</label>
                <input class="form-control" id="criarSenhaConf" name="confirmacao" type="password" autocomplete="new-password">
            </div>
            {%- set termos_href = pagina.termosUrl matches '{^https?://}i' ? pagina.termosUrl : '#' -%}
            {%- set priv_href = pagina.privUrl matches '{^https?://}i' ? pagina.privUrl : '#' -%}
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="criarSenhaAceite" name="aceite" value="1">
                <label class="form-check-label" for="criarSenhaAceite">{{ 'auth.comum.li_e_aceito_os'|trans }} <a href="{{ termos_href }}" target="_blank" rel="noopener">{{ 'auth.link.termos_de_uso'|trans }}</a> {{ 'auth.link.e_a'|trans }} <a href="{{ priv_href }}" target="_blank" rel="noopener">{{ 'auth.link.politica'|trans }}</a>.</label>
            </div>
            {% if erro %}
                <div class="alert alert-danger criar-senha__erro" role="alert">{{ erro }}</div>
            {% endif %}
            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Auth\\Controller\\CadastroController::CSRF_CRIAR_SENHA')) }}">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2" aria-hidden="true"></i> {{ 'auth.link.criar_e_confirmar'|trans }}</button>
        </form>
    {% else %}
        <div class="text-center">
            <i class="bi bi-check-circle display-4 text-success"></i>
            <h3 class="mt-3">{{ 'auth.link.confirmado'|trans }}</h3>
            {% if situacao.name|lower == 'senhacriada' %}
                <p class="text-muted">{{ 'auth.link.senha_criada'|trans }}</p>
            {% endif %}
        </div>
    {% endif %}
    {% if motivo is not null or situacao.name|lower != 'pendente' %}
        <div class="d-flex gap-2 justify-content-center mt-3">
            <a href="{{ path('app_login') }}" class="btn btn-primary">{{ 'auth.comum.entrar'|trans }}</a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {% if motivo is null and situacao.name|lower == 'pendente' %}
        {{ catalogo_js('auth.js') }}
        <script src="{{ asset('js/auth/criar-senha.js') }}" defer></script>
    {% endif %}
{% endblock %}
