{% extends 'base.html.twig' %}

{% block title %}{{ 'entrada.registration.titulo'|trans }}{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-container">
        <h1>{{ 'entrada.registration.bem_vindo'|trans({nome: user.fullName}) }}</h1>
        <p>{{ 'entrada.registration.texto'|trans }}</p>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <form method="post">
            <div class="mb-3">
                <label for="password" class="form-label">{{ 'entrada.registration.senha'|trans }}</label>
                <input type="password" id="password" name="password" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="confirm_password" class="form-label">{{ 'entrada.registration.confirme'|trans }}</label>
                <input type="password" id="confirm_password" name="confirm_password" class="form-control" required>
            </div>

            <button class="btn-login" type="submit">{{ 'entrada.registration.criar'|trans }}</button>
        </form>
    </div>
</div>
{% endblock %}
