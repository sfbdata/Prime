{# ───────────────────────────────────────────────────────────────────────────
   Fragmento trocável da lista de cobranças da carteira (dentro de
   [data-filtro-resultado]). Reexecutado a cada busca, filtro, ordenação ou
   virada de página por public/js/filtro-tabela.js — no XHR o controller devolve
   SÓ este arquivo. Nada permissionado entra aqui.
   Recebe Output DTOs (CasoResumoOutput), nunca entidades cruas.
─────────────────────────────────────────────────────────────────────────── #}
{% set busca = filtros.busca|default('') %}
{% set estado = filtros.estado|default('') %}
{% set ordenar = filtros.ordenar|default('saldo') %}
{% set direcao = filtros.direcao|default('desc') %}
{% set rotuloPadrao = 'cobranca_carteira.show.objeto'|trans %}
{% set rotulo = carteira.rotuloObjeto|default(rotuloPadrao) %}

{# A contagem pertence visualmente à barra de busca (o CSS a leva para lá em tela larga), mas mora
   AQUI porque muda a cada filtro — e a barra, que guarda o foco do campo, não recarrega.
   `total` é o tamanho da lista JÁ filtrada; `carteira.totalCasos` é a carteira inteira. #}
<div class="cs-contagem">
    {%- if total == carteira.totalCasos -%}
        {{ total == 1 ? 'cobranca_carteira.casos.contagem_um'|trans({total: total ~ ''}) : 'cobranca_carteira.casos.contagem'|trans({total: total ~ ''}) }}
    {%- else -%}
        {{ 'cobranca_carteira.casos.contagem_filtrada'|trans({total: total ~ '', carteira: carteira.totalCasos ~ ''}) }}
    {%- endif -%}
</div>

{% if casos|length > 0 %}
<div class="cs-lista-rolagem">
    <table class="cs-tabela">
        <thead>
            <tr>
                {# `data-ordenar` é o contrato do filtro-tabela.js: ele lê o valor, alterna a direção e
                   recarrega o fragmento na página 1. Os valores aceitos são os de
                   MontarVisaoCarteiraUseCase::ORDENACOES — inventar um aqui cai no padrão em silêncio.
                   "Estado" NÃO ordena, e por isso não ganha seta: o UseCase não aceita, e uma seta que
                   não faz nada é pior do que seta nenhuma. #}
                <th class="cs-col-obj cs-th-ordenavel{{ ordenar == 'objeto' ? ' ' ~ direcao : '' }}" data-ordenar="objeto" scope="col"
                    aria-sort="{{ ordenar == 'objeto' ? (direcao == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                    <button type="button" class="cs-ordenar">
                        <span>{{ rotulo }}</span>
                        <i class="bi bi-arrow-{{ ordenar == 'objeto' ? (direcao == 'asc' ? 'up' : 'down') : 'down-up' }}"></i>
                    </button>
                </th>
                <th class="cs-col-pessoa cs-th-ordenavel{{ ordenar == 'pessoa' ? ' ' ~ direcao : '' }}" data-ordenar="pessoa" scope="col"
                    aria-sort="{{ ordenar == 'pessoa' ? (direcao == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                    <button type="button" class="cs-ordenar">
                        <span>{{ 'cobranca_carteira.casos.coluna.pessoa'|trans }}</span>
                        <i class="bi bi-arrow-{{ ordenar == 'pessoa' ? (direcao == 'asc' ? 'up' : 'down') : 'down-up' }}"></i>
                    </button>
                </th>
                <th class="cs-col-estado" scope="col">{{ 'cobranca_carteira.casos.coluna.estado'|trans }}</th>
                <th class="cs-col-saldo cs-th-saldo cs-th-ordenavel{{ ordenar == 'saldo' ? ' ' ~ direcao : '' }}" data-ordenar="saldo" scope="col"
                    aria-sort="{{ ordenar == 'saldo' ? (direcao == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                    <button type="button" class="cs-ordenar">
                        <span>{{ 'cobranca_carteira.casos.coluna.saldo'|trans }}</span>
                        <i class="bi bi-arrow-{{ ordenar == 'saldo' ? (direcao == 'asc' ? 'up' : 'down') : 'down-up' }}"></i>
                    </button>
                </th>
                <th class="cs-col-anexo" scope="col"><span class="visually-hidden">{{ 'cobranca_carteira.casos.coluna.anexos'|trans }}</span></th>
            </tr>
        </thead>
        <tbody>
            {% for caso in casos %}
            {# A linha inteira é clicável por JS (conveniência de mouse), mas quem carrega o destino de
               verdade é o <a> da identificação: é ele que dá acesso por teclado, abre em nova aba pelo
               Ctrl+clique e mostra a URL na barra de status. O listener da linha ignora cliques em <a>,
               então os dois não disputam. #}
            <tr class="cs-linha{{ caso.temVencido ? ' cs-linha-vencida' : '' }}" data-href="{{ path('cobranca_objeto_show', {id: caso.objetoId}) }}">
                <td>
                    <a class="cs-obj-nome" href="{{ path('cobranca_objeto_show', {id: caso.objetoId}) }}">{{ caso.objetoIdentificacao }}</a>
                    {% if caso.objetoDescricao %}<div class="cs-obj-desc">{{ caso.objetoDescricao }}</div>{% endif %}
                </td>
                <td class="cs-pessoa">{{ caso.pessoaCobradaNome }}</td>
                <td>
                    <span class="cs-selo cs-selo-{{ caso.statusValue }}">{{ caso.statusLabel }}</span>
                    {# "Pronto p/ encerrar" é indicador DERIVADO (saldo zerado e caso não encerrado),
                       não um quarto estado — por isso texto miúdo abaixo, nunca um selo do mesmo peso. #}
                    {% if caso.prontoParaEncerrar %}
                    <span class="cs-pronto" title="{{ 'cobranca_carteira.casos.pronto_dica'|trans }}">
                        <i class="bi bi-check2-circle"></i>{{ 'cobranca_carteira.casos.pronto'|trans }}
                    </span>
                    {% endif %}
                </td>
                <td class="cs-td-saldo">
                    <div class="cs-saldo{{ caso.saldoExigivel == 0 ? ' is-zero' : '' }}">{{ caso.saldoExigivel|centavos }}</div>
                    {# A sub-linha só repete o VALOR quando o vencido é uma PARTE do saldo. Com o saldo
                       inteiro vencido — que é o caso de 242 das 248 cobranças do dev — imprimir o mesmo
                       número duas vezes na mesma célula não informa nada e faz o olho conferir se são
                       dois valores diferentes. Aí basta dizer que é tudo. #}
                    {% if caso.temVencido %}
                    <div class="cs-saldo-vencido">
                        {%- if caso.saldoVencido == caso.saldoExigivel -%}
                            {{ 'cobranca_carteira.casos.tudo_vencido'|trans }}
                        {%- else -%}
                            {{ 'cobranca_carteira.casos.vencido'|trans({valor: caso.saldoVencido|centavos}) }}
                        {%- endif -%}
                    </div>
                    {% endif %}
                </td>
                <td class="cs-td-anexo">
                    {% if caso.temDocumentos %}<i class="bi bi-paperclip" title="{{ 'cobranca_carteira.casos.tem_documentos'|trans }}" aria-label="{{ 'cobranca_carteira.casos.tem_documentos'|trans }}"></i>{% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# O rodapé acompanha a lista sempre que ela tem linha: a faixa ("Mostrando 1–20 de 121") responde
   "onde eu estou" mesmo quando há uma página só. No estado vazio ele some — "0 de 0" com paginador
   ao lado é ruído. O deslocamento sai de `por_pagina`, NÃO de `casos|length`: a última página vem
   incompleta, e usar o tamanho da lista devolvida faria "Mostrando 7–7 de 121". #}
{% set primeiro = (pagina - 1) * por_pagina + 1 %}
<div class="cs-rodape">
    <span class="cs-faixa">{{ 'cobranca_carteira.casos.faixa'|trans({primeiro: primeiro ~ '', ultimo: (primeiro + casos|length - 1) ~ '', total: total ~ ''}) }}</span>
    {{ include('cobranca/carteira/_paginacao.html.twig', { pagina: pagina, total_paginas: total_paginas }) }}
</div>

{% else %}
<div class="cs-vazio">
    {% if busca is not empty %}
        <i class="bi bi-search"></i>
        <p class="cs-vazio-titulo">{{ 'cobranca_carteira.casos.busca_vazia_titulo'|trans({busca: busca}) }}</p>
        <p class="cs-vazio-texto">
            {{ rotulo == rotuloPadrao ? 'cobranca_carteira.casos.busca_vazia_texto_objeto'|trans : 'cobranca_carteira.casos.busca_vazia_texto'|trans({rotulo: rotulo|lower}) }}
        </p>
        <button type="button" class="cs-btn js-filtro-limpar"><i class="bi bi-x-lg"></i><span>{{ 'cobranca_carteira.casos.limpar_busca'|trans }}</span></button>
    {% elseif estado is not empty %}
        <i class="bi bi-funnel"></i>
        <p class="cs-vazio-titulo">{{ 'cobranca_carteira.casos.estado_vazio_titulo'|trans }}</p>
        <p class="cs-vazio-texto">
            {% set casosDaCarteira = carteira.totalCasos == 1 ? 'cobranca_carteira.casos.contagem_um'|trans({total: carteira.totalCasos ~ ''}) : 'cobranca_carteira.casos.contagem'|trans({total: carteira.totalCasos ~ ''}) %}
            {{ 'cobranca_carteira.casos.estado_vazio_texto'|trans({casos: casosDaCarteira}) }}
        </p>
        <button type="button" class="cs-btn js-filtro-limpar"><i class="bi bi-x-lg"></i><span>{{ 'cobranca_carteira.casos.limpar_filtro'|trans }}</span></button>
    {% else %}
        <i class="bi bi-briefcase"></i>
        <p class="cs-vazio-titulo">{{ 'cobranca_carteira.casos.vazio_titulo'|trans }}</p>
        <p class="cs-vazio-texto">
            {{ rotulo == rotuloPadrao ? 'cobranca_carteira.casos.vazio_texto_objeto'|trans : 'cobranca_carteira.casos.vazio_texto'|trans({rotulo: rotulo|lower}) }}
        </p>
    {% endif %}
</div>
{% endif %}
