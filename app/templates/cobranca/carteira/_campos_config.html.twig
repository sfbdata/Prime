{# Campos de configuração da carteira, compartilhados pelos modais de CRIAR (index) e EDITAR (_acoes_modais).
   Espera no contexto: `form` (view do form) e `ajudaCarteira` (mapa {modo, honorarios} -> [{label, descricao}]).
   Modo e Forma de honorários ganham ícone "?" com popover no hover (init em cobranca-carteira-form.js).
   O percentual usa input-group com sufixo "%" e é ocultado por JS quando a forma é "sem percentual". #}

{%- set modoConteudo = '' -%}
{%- for op in ajudaCarteira.modo -%}{%- set modoConteudo = modoConteudo ~ '<strong>' ~ op.label ~ '</strong>: ' ~ op.descricao ~ (loop.last ? '' : '<br><br>') -%}{%- endfor -%}
{%- set honorariosConteudo = '' -%}
{%- for op in ajudaCarteira.honorarios -%}{%- set honorariosConteudo = honorariosConteudo ~ '<strong>' ~ op.label ~ '</strong>: ' ~ op.descricao ~ (loop.last ? '' : '<br><br>') -%}{%- endfor -%}

{{ form_errors(form) }}

{# As três seções são as do desenho 1B (Operação · Honorários · Encargos por atraso). Este partial
   também alimenta o modal "Nova carteira" da listagem — os títulos aparecem lá igualmente, que é
   o comportamento desejado: é o mesmo formulário. #}
<h6 class="cs-secao">Operação</h6>

<div class="mb-3">
    <label class="form-label" for="{{ form.modo.vars.id }}">
        {{ form.modo.vars.label }}
        <a href="#" class="text-muted ms-1 cobranca-ajuda" role="button" tabindex="0" onclick="return false;"
           data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-html="true"
           data-bs-title="Modo de operação" data-bs-content="{{ modoConteudo|e('html_attr') }}"
           aria-label="Ajuda sobre o modo de operação"><i class="bi bi-question-circle"></i></a>
    </label>
    {{ form_widget(form.modo) }}
    {{ form_errors(form.modo) }}
</div>

{{ form_row(form.toleranciaAtrasoDias) }}
{{ form_row(form.tipoVinculoPreferido) }}
{{ form_row(form.rotuloObjeto) }}

<h6 class="cs-secao mt-4">Honorários</h6>

<div class="mb-3">
    <label class="form-label" for="{{ form.formaHonorarios.vars.id }}">
        {{ form.formaHonorarios.vars.label }}
        <a href="#" class="text-muted ms-1 cobranca-ajuda" role="button" tabindex="0" onclick="return false;"
           data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-html="true"
           data-bs-title="Forma de honorários" data-bs-content="{{ honorariosConteudo|e('html_attr') }}"
           aria-label="Ajuda sobre a forma de honorários"><i class="bi bi-question-circle"></i></a>
    </label>
    {{ form_widget(form.formaHonorarios, {attr: {'data-forma-honorarios': '1'}}) }}
    {{ form_errors(form.formaHonorarios) }}
</div>

<div class="mb-3" data-percentual-wrapper>
    <label class="form-label" for="{{ form.percentualHonorarios.vars.id }}">{{ form.percentualHonorarios.vars.label }}</label>
    <div class="input-group">
        {{ form_widget(form.percentualHonorarios) }}
        <span class="input-group-text">%</span>
    </div>
    {{ form_errors(form.percentualHonorarios) }}
</div>

{# Encargos por atraso (spec "encargos configuráveis em cascata" §4.1) — presentes nos DOIS forms que
   incluem este partial (criar e editar configuração). São o NÍVEL 1 da cascata Carteira → Objeto →
   Obrigação, resolvido NA LEITURA (spec #9): não há mais snapshot no caso, então editar aqui move ao
   vivo tudo que herda e não está congelado. Por isso não há guarda `is defined` aqui — campo faltando
   vira erro de template, que é o que se quer, em vez de sumir calado da tela. #}
<h6 class="cs-secao mt-4">Encargos por atraso</h6>
<div class="form-text mb-3">
    Estas taxas valem <strong>ao vivo</strong>: alterar aqui <strong>recalcula na hora</strong> os
    encargos de toda obrigação <strong>em aberto</strong> que herda desta carteira. Não muda o que já
    está congelado (obrigação paga/liquidada ou substituída por acordo) nem o que tem taxa própria
    no objeto ou na obrigação. Deixe a carência dos honorários <strong>vazia</strong> para usar a
    tolerância de atraso configurada acima.
</div>

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaJurosMensalBp.vars.id }}">{{ form.taxaJurosMensalBp.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.taxaJurosMensalBp) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaJurosMensalBp) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.regimeJuros) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaMultaBp.vars.id }}">{{ form.taxaMultaBp.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.taxaMultaBp) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaMultaBp) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.baseMulta) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaCorrecaoBp.vars.id }}">{{ form.taxaCorrecaoBp.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.taxaCorrecaoBp) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaCorrecaoBp) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.baseCorrecao) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.baseHonorarios) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.carenciaHonorariosDias.vars.id }}">{{ form.carenciaHonorariosDias.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.carenciaHonorariosDias) }}
            <span class="input-group-text">dias</span>
        </div>
        {{ form_errors(form.carenciaHonorariosDias) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.toleranciaJurosMultaDias.vars.id }}">{{ form.toleranciaJurosMultaDias.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.toleranciaJurosMultaDias) }}
            <span class="input-group-text">dias</span>
        </div>
        {{ form_errors(form.toleranciaJurosMultaDias) }}
    </div>
</div>
