{% extends 'base.html.twig' %}

{% block title %}{{ 'cobranca_carteira.show.titulo_pagina'|trans({carteira: carteira.nome}) }}{% endblock %}

{% block body_class %}cs-body{% endblock %}

{# ============================================================================
   Redesenho aprovado: docs/design/design_handoff_carteira_show/ ("Carteira 1B.dc.html"),
   direção 1B — "Lista + trilho lateral", escolhida pelo dono em 27/08/2026.

   O que mudou de ESTRUTURA:
     · o cabeçalho virou CARTÃO (voltar + migalhas + ações · selos · nome · credor
       + frescor · 4 indicadores), no lugar do título solto sobre o fundo;
     · o frescor do dado virou selo CLICÁVEL, com o detalhamento por relatório;
     · lista e trilho passaram de `.row/.col-lg-*` para uma grade de
       `minmax(0,1fr) 340px` — é a medida do desenho, que a grade de 12 colunas
       do Bootstrap não sabe expressar;
     · a lista ganhou filtro por Estado (única peça do desenho que exigiu
       back-end) e o realce de atraso virou raia lateral, não fundo vermelho.

   O que NÃO mudou, de propósito:
     · o `.content-header` continua existindo e continua abrigando o selo de
       "dados atualizados até" — é onde o CarteiraDadosAtualizadosNaTelaTest procura;
     · a lista segue sendo <table>: além de ser a semântica certa para dado
       tabular, é o contrato dos testes de acessibilidade da lista;
     · "Importar relatório" continua levando à tela de 2 passos (upload → prévia
       → confirmar). O desenho propõe um modal com 4 tipos; hoje existe UM tipo
       na tela e os outros três só como comando. Decisão do dono em 28/08: não
       mexer no caminho que grava dinheiro nesta fatia;
     · o menu "⋮" do desenho entrou em 19/10 SÓ com "Editar configuração" (abre o
       mesmo #modalEditarConfiguracao do trilho); em 20/10 ganhou "Exportar lista
       (.xlsx)". Os outros 2 itens (espelho contábil, excluir carteira) não têm rota
       no sistema: decisão do dono, voltam quando as ações existirem.
============================================================================ #}
{% block body %}
{% set rotulo = carteira.rotuloObjeto|default('cobranca_carteira.show.objeto'|trans) %}
<div class="cobrancas-page cs-page">

<section class="content-header">
    <div class="container-fluid">
        <div class="cs-card cs-cabecalho">
            <div class="cs-cab-topo">
                <a href="{{ path('cobranca_carteira_index') }}" class="cs-btn cs-btn-voltar">
                    <i class="bi bi-arrow-left"></i><span>{{ 'cobranca_carteira.show.voltar'|trans }}</span>
                </a>
                <nav class="cs-migalhas" aria-label="{{ 'cobranca_carteira.show.migalhas'|trans }}">
                    <a href="{{ path('homepage') }}">{{ 'cobranca_carteira.show.inicio'|trans }}</a><span>/</span>
                    <a href="{{ path('cobranca_carteira_index') }}">{{ 'cobranca_carteira.comum.cobrancas'|trans }}</a><span>/</span>
                    <span class="cs-migalha-atual" aria-current="page">{{ carteira.nome }}</span>
                </nav>
                <div class="cs-cab-acoes">
                    {% if has_permission('resources.cobranca.gerenciar') %}
                    <button type="button" class="cs-btn" data-bs-toggle="modal" data-bs-target="#modalCriarObjeto">
                        <i class="bi bi-plus-lg"></i><span>{{ 'cobranca_carteira.show.novo_objeto'|trans }}</span>
                    </button>
                    {# Verde cheio: importar relatório é a ação primária desta tela. #}
                    <a href="{{ path('cobranca_importacao_upload', {id: carteira.id}) }}" class="cs-btn cs-btn-verde">
                        <i class="bi bi-upload"></i><span>{{ 'cobranca_carteira.show.importar_relatorio'|trans }}</span>
                    </a>
                    {% endif %}
                    {# ⋮ do desenho 1B (L75-84), só com os itens que têm ação no sistema. O ⋮ aparece para
                       todo mundo que vê a carteira, porque exportar a lista tem a MESMA guarda da tela.
                       "Editar configuração" segue o gate do modal (`forms.editarConfiguracao`, montado só
                       para quem gerencia carteira): o item nunca aponta para um modal que não existe. #}
                    <div class="dropdown cs-mais">
                        <button type="button" class="cs-btn cs-btn-icone" data-bs-toggle="dropdown" data-bs-auto-close="true"
                                aria-expanded="false" title="{{ 'cobranca_carteira.show.mais_acoes'|trans }}" aria-label="{{ 'cobranca_carteira.show.mais_acoes'|trans }}">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end cs-mais-menu">
                            {% if forms.editarConfiguracao is defined %}
                            <button type="button" class="cs-mais-item" data-bs-toggle="modal" data-bs-target="#modalEditarConfiguracao">
                                <i class="bi bi-sliders"></i><span>{{ 'cobranca_carteira.show.editar_configuracao'|trans }}</span>
                            </button>
                            {% endif %}
                            {# Leva o recorte que está na tela. O href já sai com o da carga da página (vale
                               sem JS); como busca e Estado mudam por XHR sem recarregar, o script do fim
                               da página o refaz no clique a partir do formulário da lista. #}
                            {% set filtrosExportar = filtros|filter(v => v is not empty) %}
                            <a class="cs-mais-item" data-exportar-lista
                               data-exportar-base="{{ path('cobranca_carteira_exportar', {id: carteira.id}) }}"
                               href="{{ path('cobranca_carteira_exportar', {id: carteira.id}|merge(filtrosExportar)) }}">
                                <i class="bi bi-file-earmark-spreadsheet"></i><span>{{ 'cobranca_carteira.show.exportar_lista'|trans }}</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cs-cab-corpo">
                <div class="cs-cab-selos">
                    <span class="cs-kicker">{{ 'cobranca_carteira.show.selo_carteira'|trans({id: carteira.id ~ ''}) }}</span>
                    <span class="cs-cab-sep"></span>
                    <span class="cs-pill"><i class="bi bi-diagram-3"></i>{{ carteira.modoLabel }}</span>
                    <span class="cs-pill">
                        <i class="bi bi-percent"></i>{{ carteira.formaHonorariosLabel }}{% if carteira.percentualHonorarios %} · {{ carteira.percentualHonorarios }}%{% endif %}
                    </span>
                </div>

                <h1 class="cs-titulo">{{ carteira.nome }}</h1>

                <div class="cs-cab-credor">
                    <span>{{ 'cobranca_carteira.show.credor'|trans }}
                        {%- if carteira.clienteId %}
                            <a href="{{ path('cliente_show', {id: carteira.clienteId}) }}">{{ carteira.clienteNome }}</a>
                        {%- else %}
                            <strong>{{ carteira.clienteNome }}</strong>
                        {%- endif %}
                    </span>

                    {# ── Até quando os dados estão em dia ────────────────────────────────
                       É a EMISSÃO do relatório, não a hora em que a importação rodou: importar hoje um
                       arquivo de três dias atrás deixa os dados de três dias atrás. E, entre os tipos,
                       manda o MAIS ANTIGO — a carteira é a soma dos relatórios, então o elo mais fraco
                       decide. O detalhamento abaixo mostra isso: é ele que responde "de onde saiu esta
                       data" sem obrigar ninguém a adivinhar.

                       São TRÊS estados, não dois (defeito achado no smoke de 10/08). Sem emissão gravada
                       NÃO quer dizer "nada foi importado": a emissão só passou a ser registrada em
                       07/08, e todo o dado anterior ficou sem ela. Quem separa os dois estados é
                       `totalObjetos`, que o DTO já traz — sem consulta nova. #}
                    {% if carteira.dadosAtualizadosAte %}
                        {% set dias = date().diff(carteira.dadosAtualizadosAte).days %}
                        <div class="dropdown">
                            <button type="button" class="cs-frescor" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                                <i class="bi bi-clock-history"></i>
                                <span>{{ 'cobranca_carteira.show.frescor.atualizados_ate'|trans({data: carteira.dadosAtualizadosAte|data}) }}</span>
                                {# A defasagem sai de `date().diff(...)`, NÃO do filtro `tempo_relativo`: o filtro
                                   compara a data contra a MEIA-NOITE de hoje, e a emissão carrega hora — o que
                                   devolve um dia a menos para quase toda emissão da tarde. Aqui os dois lados são
                                   instantes, que é a conta que a tela sempre fez. #}
                                <span class="{{ 7 < dias ? 'cs-frescor-atraso' : '' }}">
                                    {%- if dias == 0 %}{{ 'cobranca_carteira.show.frescor.hoje'|trans }}
                                    {%- elseif dias == 1 %}{{ 'cobranca_carteira.show.frescor.ha_um_dia'|trans }}
                                    {%- else %}{{ 'cobranca_carteira.show.frescor.ha_dias'|trans({dias: dias ~ ''}) }}
                                    {%- endif %}
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <div class="dropdown-menu cs-frescor-menu">
                                <div class="cs-frescor-titulo">{{ 'cobranca_carteira.show.frescor.titulo'|trans }}</div>
                                <div class="cs-frescor-lista">
                                    {% set ordemEmissao = ['inadimplencia', 'acordos', 'receitas', 'cadastro'] %}
                                    {% set rotulosEmissao = {
                                        'inadimplencia': 'cobranca_carteira.show.frescor.tipo.inadimplencia'|trans,
                                        'acordos': 'cobranca_carteira.show.frescor.tipo.acordos'|trans,
                                        'receitas': 'cobranca_carteira.show.frescor.tipo.receitas'|trans,
                                        'cadastro': 'cobranca_carteira.show.frescor.tipo.cadastro'|trans
                                    } %}
                                    {% set maisAntiga = carteira.dadosAtualizadosAte|date('Y-m-d H:i:s') %}
                                    {# O TIPO da emissão mais antiga, para o rodapé dizer o que importar. Empate
                                       fica com o primeiro na ordem da lista, que é a ordem em que o selo lê. #}
                                    {% set tipoMaisAntigo = null %}
                                    {% for tipo in ordemEmissao|merge(carteira.emissaoPorTipo|keys) %}
                                        {% if tipoMaisAntigo is null and carteira.emissaoPorTipo[tipo] is defined and carteira.emissaoPorTipo[tipo]|date('Y-m-d H:i:s') == maisAntiga %}
                                            {% set tipoMaisAntigo = tipo %}
                                        {% endif %}
                                    {% endfor %}
                                    {% for tipo in ordemEmissao %}
                                        {% if carteira.emissaoPorTipo[tipo] is defined %}
                                        <div class="cs-frescor-item">
                                            <span>{{ rotulosEmissao[tipo] }}</span>
                                            <span class="cs-leader"></span>
                                            <span class="cs-frescor-data {{ carteira.emissaoPorTipo[tipo]|date('Y-m-d H:i:s') == maisAntiga ? 'is-mais-antiga' : '' }}">{{ carteira.emissaoPorTipo[tipo]|data }}</span>
                                        </div>
                                        {% endif %}
                                    {% endfor %}
                                    {# Tipo novo de relatório aparece aqui sem precisar mexer no template. #}
                                    {% for tipo, emissao in carteira.emissaoPorTipo|filter((e, t) => t not in ordemEmissao) %}
                                        <div class="cs-frescor-item">
                                            <span>{{ tipo|capitalize }}</span>
                                            <span class="cs-leader"></span>
                                            <span class="cs-frescor-data {{ emissao|date('Y-m-d H:i:s') == maisAntiga ? 'is-mais-antiga' : '' }}">{{ emissao|data }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                                {# Frase do desenho 1B (L118), com o relatório mais antigo no lugar do "cadastro"
                                   fixo do protótipo. #}
                                {% set importarQual = {
                                    'inadimplencia': 'cobranca_carteira.show.frescor.importar_qual.inadimplencia'|trans,
                                    'acordos': 'cobranca_carteira.show.frescor.importar_qual.acordos'|trans,
                                    'receitas': 'cobranca_carteira.show.frescor.importar_qual.receitas'|trans,
                                    'cadastro': 'cobranca_carteira.show.frescor.importar_qual.cadastro'|trans
                                } %}
                                <div class="cs-frescor-nota">
                                    {{ 'cobranca_carteira.show.frescor.nota'|trans }} <strong>{{ 'cobranca_carteira.show.frescor.nota_mais_antiga'|trans }}</strong>.
                                    {%- if tipoMaisAntigo is not null %}
                                        {{ 'cobranca_carteira.show.frescor.importe'|trans }} <span data-frescor-importar="{{ tipoMaisAntigo }}">{{ importarQual[tipoMaisAntigo] is defined ? importarQual[tipoMaisAntigo] : 'cobranca_carteira.show.frescor.importar_qual.outro'|trans({tipo: tipoMaisAntigo|capitalize}) }}</span> {{ 'cobranca_carteira.show.frescor.para_fechar'|trans }}
                                    {%- endif %}
                                </div>
                            </div>
                        </div>
                    {% elseif carteira.totalObjetos > 0 %}
                        <span class="cs-frescor is-mudo" title="{{ 'cobranca_carteira.show.frescor.desconhecida_dica'|trans }}">
                            <i class="bi bi-clock-history"></i>
                            <span class="cs-frescor-atraso">{{ 'cobranca_carteira.show.frescor.desconhecida'|trans }}</span>
                        </span>
                    {% else %}
                        <span class="cs-frescor is-mudo">
                            <i class="bi bi-clock-history"></i>
                            <span>{{ 'cobranca_carteira.show.frescor.nenhum'|trans }}</span>
                        </span>
                    {% endif %}
                </div>
            </div>

            {# ── Os 4 indicadores ────────────────────────────────────────────
               A sub-linha do primeiro existe para evitar o chamado "o total não bate com a lista":
               busca e filtro recortam a LISTA, nunca os agregados. #}
            <div class="cs-kpis">
                <div class="cs-kpi">
                    <div class="cs-kpi-rotulo">{{ 'cobranca_carteira.show.kpi.saldo'|trans }}</div>
                    <div class="cs-kpi-valor">{{ carteira.saldoConsolidado|centavos }}</div>
                    <div class="cs-kpi-sub">{{ 'cobranca_carteira.show.kpi.saldo_sub'|trans }}</div>
                </div>
                <div class="cs-kpi">
                    <div class="cs-kpi-rotulo">{{ 'cobranca_carteira.show.kpi.vencido'|trans }}</div>
                    <div class="cs-kpi-valor {{ 0 < carteira.saldoVencido ? 'is-vencido' : '' }}">{{ carteira.saldoVencido|centavos }}</div>
                    <div class="cs-kpi-sub">
                        {{ carteira.totalComAtraso == 1 ? 'cobranca_carteira.show.kpi.com_atraso_um'|trans({total: carteira.totalComAtraso ~ ''}) : 'cobranca_carteira.show.kpi.com_atraso'|trans({total: carteira.totalComAtraso ~ ''}) }}
                        {%- if carteira.saldoConsolidado > 0 %} {{ 'cobranca_carteira.show.kpi.do_saldo'|trans({percentual: (carteira.saldoVencido * 100 / carteira.saldoConsolidado)|number_format(1, ',', '.')}) }}{% endif %}
                    </div>
                </div>
                <div class="cs-kpi">
                    <div class="cs-kpi-rotulo">{{ 'cobranca_carteira.show.kpi.objetos'|trans }}</div>
                    <div class="cs-kpi-valor">{{ carteira.totalObjetos }}</div>
                    <div class="cs-kpi-sub">{{ 'cobranca_carteira.show.kpi.rotulo'|trans({rotulo: rotulo}) }}</div>
                </div>
                <div class="cs-kpi">
                    <div class="cs-kpi-rotulo">{{ 'cobranca_carteira.show.kpi.casos_abertos'|trans }}</div>
                    <div class="cs-kpi-valor">{{ carteira.totalCasos }}</div>
                    {% set duracaoTolerancia = carteira.toleranciaAtrasoDias == 1 ? 'cobranca_carteira.comum.dia'|trans({dias: carteira.toleranciaAtrasoDias ~ ''}) : 'cobranca_carteira.comum.dias'|trans({dias: carteira.toleranciaAtrasoDias ~ ''}) %}
                    <div class="cs-kpi-sub">{{ 'cobranca_carteira.show.kpi.tolerancia'|trans({duracao: duracaoTolerancia}) }}</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Grade do desenho: a lista manda, o trilho acompanha ─────────────
           A lista é a razão de existir da página: vem primeiro no DOM e fica com todo o espaço que
           sobra. Configuração e Documentos recuam para uma faixa fixa de 340px — visíveis sem
           clique (foi o que o dono escolheu entre os dois arranjos), mas claramente secundários. #}
        <div class="cs-grade">
            <div class="cs-coluna-lista">
                {# O cartão inteiro é o root do filtro: a barra de busca fica FORA da área trocável
                   (mantém o foco no campo enquanto digita) e o fragmento devolvido pelo XHR não
                   carrega nada permissionado. #}
                <div class="cs-card cs-lista" data-filtro-root data-filtro-endpoint="{{ path('cobranca_carteira_show', {id: carteira.id}) }}">
                    {# Barra própria, e não o `_partials/_filtro_barra.html.twig`: o desenho pede um
                       botão com funil e menu no lugar do `<select>` genérico, e aquele partial é
                       compartilhado com o Expediente e as outras listagens — dar um tipo novo de
                       faceta a ele mudaria a superfície das outras telas sem pedido.

                       O contrato do `public/js/filtro-tabela.js` é o que continua valendo, e ele é
                       todo por atributo/classe: `[data-filtro-form]`, `.js-filtro-busca`,
                       `.js-filtro-campo`, os dois hidden de ordenação e `[data-filtro-chips]`. #}
                    <form data-filtro-form method="get" class="filtro-barra cs-barra">
                        <div class="filtro-linha">
                            <div class="filtro-busca">
                                <i class="bi bi-search"></i>
                                <input type="text" name="busca" class="form-control form-control-sm js-filtro-busca"
                                       data-rotulo="{{ 'cobranca_carteira.show.filtro.busca'|trans }}" placeholder="{{ 'cobranca_carteira.show.filtro.busca_placeholder'|trans({rotulo: rotulo|lower}) }}"
                                       autocomplete="off" value="{{ filtros.busca|default('') }}">
                            </div>

                            {# O `<select>` é quem guarda o valor: é ele que entra no FormData do XHR e
                               é dele que o motor tira o RÓTULO do chip ("Estado: Só com atraso"), coisa
                               que um input escondido com o valor cru não daria. O botão desenhado só o
                               pilota. Sem JS o `<select>` continua à vista e funcionando — quem o
                               esconde é o próprio script, depois de montar o menu. #}
                            <div class="cs-estado dropdown" data-estado-menu data-estado-padrao="{{ 'cobranca_carteira.show.filtro.estado'|trans }}">
                                <select name="estado" class="form-select form-select-sm filtro-select js-filtro-campo cs-estado-nativo"
                                        data-rotulo="{{ 'cobranca_carteira.show.filtro.estado'|trans }}" aria-label="{{ 'cobranca_carteira.show.filtro.filtrar_por_estado'|trans }}">
                                    <option value="">{{ 'cobranca_carteira.show.filtro.todos_os_estados'|trans }}</option>
                                    {% for o in estadoOpcoes %}
                                    <option value="{{ o.valor }}" {{ filtros.estado|default('') == o.valor ? 'selected' : '' }}>{{ o.label }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button" class="cs-estado-btn" data-bs-toggle="dropdown"
                                        data-bs-auto-close="true" aria-expanded="false" aria-label="{{ 'cobranca_carteira.show.filtro.filtrar_por_estado'|trans }}">
                                    <i class="bi bi-funnel"></i>
                                    <span data-estado-rotulo>{{ 'cobranca_carteira.show.filtro.estado'|trans }}</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end cs-estado-menu">
                                    <button type="button" class="cs-estado-opcao" data-estado-valor="">
                                        <span>{{ 'cobranca_carteira.show.filtro.todos_os_estados'|trans }}</span><i class="bi bi-check2"></i>
                                    </button>
                                    {% for o in estadoOpcoes %}
                                    <button type="button" class="cs-estado-opcao" data-estado-valor="{{ o.valor }}">
                                        <span>{{ o.label }}</span><i class="bi bi-check2"></i>
                                    </button>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="ordenar" value="{{ filtros.ordenar|default('') }}">
                        <input type="hidden" name="direcao" value="{{ filtros.direcao|default('') }}">

                        {# Chips dos filtros ativos — montados pelo motor a partir do estado do form. #}
                        <div class="filtro-chips" data-filtro-chips></div>
                    </form>
                    <div data-filtro-resultado>
                        {{ include('cobranca/carteira/_resultado_casos.html.twig') }}
                    </div>
                </div>
            </div>

            <div class="cs-trilho">
                <div class="cs-card">
                    <div class="cs-card-cabeca">
                        <h2>{{ 'cobranca_carteira.show.configuracao.titulo'|trans }}</h2>
                        {% if has_permission('resources.carteira.gerenciar') %}
                        <button type="button" class="cs-btn cs-btn-mini" data-bs-toggle="modal" data-bs-target="#modalEditarConfiguracao">
                            <i class="bi bi-pencil"></i><span>{{ 'cobranca_carteira.show.configuracao.editar'|trans }}</span>
                        </button>
                        {% endif %}
                    </div>
                    {# Rótulo à esquerda, valor à direita, linha pontilhada ligando os dois. As sete
                       linhas aparecem SEMPRE: uma que some conforme o dado faz o trilho mudar de
                       altura entre carteiras e some junto com a pergunta que ela responde. #}
                    <dl class="cs-config">
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.modo'|trans }}</dt><span class="cs-leader"></span><dd>{{ carteira.modoLabel }}</dd>
                        </div>
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.honorarios'|trans }}</dt><span class="cs-leader"></span>
                            <dd>{{ carteira.formaHonorariosLabel }}{% if carteira.percentualHonorarios %} · {{ carteira.percentualHonorarios }}%{% endif %}</dd>
                        </div>
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.tolerancia'|trans }}</dt><span class="cs-leader"></span>
                            <dd>{{ duracaoTolerancia }}</dd>
                        </div>
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.juros'|trans }}</dt><span class="cs-leader"></span><dd>{{ carteira.jurosLabel }}</dd>
                        </div>
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.multa'|trans }}</dt><span class="cs-leader"></span><dd>{{ carteira.multaLabel }}</dd>
                        </div>
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.vinculo'|trans }}</dt><span class="cs-leader"></span><dd>{% if carteira.tipoVinculoPreferidoLabel|default(null) is not empty %}{{ carteira.tipoVinculoPreferidoLabel }}{% else %}<span class="text-muted small">{{ 'cobranca_carteira.comum.nao_informado'|trans }}</span>{% endif %}</dd>
                        </div>
                        <div class="cs-config-linha">
                            <dt>{{ 'cobranca_carteira.show.configuracao.rotulo_objeto'|trans }}</dt><span class="cs-leader"></span><dd>{% if carteira.rotuloObjeto|default(null) is not empty %}{{ carteira.rotuloObjeto }}{% else %}<span class="text-muted small">{{ 'cobranca_carteira.comum.nao_informado'|trans }}</span>{% endif %}</dd>
                        </div>
                    </dl>
                </div>

                {# ── Documentos da carteira ──────────────────────────────────
                   Lista, não tabela: em 340px as cinco colunas viravam rolagem horizontal. A
                   observação continua como TEXTO numa terceira linha (só existe quando há
                   observação) — chegou a virar `title`, e o teste de upload pegou: tooltip não
                   existe para quem usa toque nem para leitor de tela. #}
                <div class="cs-card">
                    <div class="cs-card-cabeca">
                        <h2>{{ 'cobranca_carteira.show.documentos.titulo'|trans }}</h2>
                        {% if documentos|length %}<span class="cs-contador">{{ documentos|length }}</span>{% endif %}
                        {% if has_permission('resources.cobranca.gerenciar') %}
                        <button type="button" class="cs-btn cs-btn-quadrado" data-bs-toggle="modal" data-bs-target="#modalAdicionarDocumentoCarteira" title="{{ 'cobranca_carteira.show.documentos.adicionar'|trans }}" aria-label="{{ 'cobranca_carteira.show.documentos.adicionar'|trans }}">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        {% endif %}
                    </div>
                    {% if documentos|length > 0 %}
                    <ul class="cs-docs">
                        {% for doc in documentos %}
                        {% set ico = arquivo_icone(doc.nomeOriginal) %}
                        <li class="cs-doc">
                            <i class="bi {{ ico.icone }} cs-doc-ico" style="color: {{ ico.cor }}" aria-hidden="true"></i>
                            <div class="cs-doc-texto">
                                <a class="cs-doc-nome" href="{{ path('cobranca_carteira_documento_download', {docId: doc.id}) }}" title="{{ 'cobranca_carteira.show.documentos.baixar'|trans({nome: doc.nomeOriginal}) }}">{{ doc.nomeOriginal }}</a>
                                <div class="cs-doc-meta">{{ doc.categoria.rotulo }} · {{ doc.carregadoEm|data }}</div>
                                {% if doc.observacao %}<div class="cs-doc-obs">{{ doc.observacao }}</div>{% endif %}
                            </div>
                            <div class="cs-doc-acoes">
                                <a href="{{ path('cobranca_carteira_documento_download', {docId: doc.id}) }}" class="cs-doc-acao" title="{{ 'cobranca_carteira.show.documentos.baixar'|trans({nome: doc.nomeOriginal}) }}" aria-label="{{ 'cobranca_carteira.show.documentos.baixar'|trans({nome: doc.nomeOriginal}) }}">
                                    <i class="bi bi-download"></i>
                                </a>
                                {% if has_permission('resources.cobranca.gerenciar') %}
                                {# O `confirm()` nativo continua: são 63 no sistema e não existe componente
                                   de confirmação. Trocar 1 cria inconsistência com 62 — é frente própria. #}
                                <form method="post" action="{{ path('cobranca_carteira_documento_excluir', {docId: doc.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'cobranca_carteira.show.documentos.confirmar_excluir'|trans|e('js') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cobranca_carteira_documento_excluir_' ~ doc.id) }}">
                                    <button type="submit" class="cs-doc-acao is-perigo" title="{{ 'cobranca_carteira.show.documentos.excluir'|trans({nome: doc.nomeOriginal}) }}" aria-label="{{ 'cobranca_carteira.show.documentos.excluir'|trans({nome: doc.nomeOriginal}) }}">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <div class="cs-docs-vazio">
                        {{ 'cobranca_carteira.show.documentos.vazio'|trans }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

{{ include('cobranca/carteira/_acoes_modais.html.twig') }}
</div>
{% endblock %}

