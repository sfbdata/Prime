{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{# Redesenho da carteira — desenho aprovado em docs/design/design_handoff_carteira_show/.
   Vem DEPOIS do cobrancas.css: é ele que redefine o que a tela herda das outras. #}
<link rel="stylesheet" href="{{ asset('css/carteira-show.css') }}">
