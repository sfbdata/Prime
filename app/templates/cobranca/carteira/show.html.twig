{% extends 'base.html.twig' %}

{% block title %}Cobranças · {{ carteira.nome }}{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="{{ path('cobranca_carteira_index') }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-folder2-open"></i>{{ carteira.nome }}</h1>
        </div>
        <div class="text-muted"><i class="bi bi-person-badge me-1"></i>{{ carteira.clienteNome }}</div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Métricas ──────────────────────────────────────────── #}
        <div class="caso-header mb-3">
            <div class="caso-metrics">
                <div class="caso-metric">
                    <div class="caso-metric-label">Saldo consolidado</div>
                    <div class="caso-metric-valor {{ carteira.saldoConsolidado == 0 ? 'saldo-zerado' : '' }}">{{ carteira.saldoConsolidado|centavos }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">Objetos</div>
                    <div class="caso-metric-valor">{{ carteira.totalObjetos }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">Casos</div>
                    <div class="caso-metric-valor">{{ carteira.totalCasos }}</div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            {# ── Configuração ──────────────────────────────────── #}
            <div class="col-lg-4">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold"><i class="bi bi-gear me-1"></i>Configuração</div>
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-6 text-muted">Modo</dt>
                            <dd class="col-6">{{ carteira.modoLabel }}</dd>

                            <dt class="col-6 text-muted">Honorários</dt>
                            <dd class="col-6">{{ carteira.formaHonorariosLabel }}{% if carteira.percentualHonorarios %} ({{ carteira.percentualHonorarios }}%){% endif %}</dd>

                            <dt class="col-6 text-muted">Tolerância de atraso</dt>
                            <dd class="col-6">{{ carteira.toleranciaAtrasoDias }} dia(s)</dd>

                            {% if carteira.tipoVinculoPreferidoLabel %}
                            <dt class="col-6 text-muted">Vínculo preferido</dt>
                            <dd class="col-6">{{ carteira.tipoVinculoPreferidoLabel }}</dd>
                            {% endif %}

                            {% if carteira.rotuloObjeto %}
                            <dt class="col-6 text-muted">Rótulo do objeto</dt>
                            <dd class="col-6">{{ carteira.rotuloObjeto }}</dd>
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>

            {# ── Casos da carteira ─────────────────────────────── #}
            <div class="col-lg-8">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold"><i class="bi bi-briefcase me-1"></i>Casos da carteira</div>
                    <div class="table-responsive">
                        {% if casos|length > 0 %}
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3">Objeto</th>
                                    <th>Pessoa cobrada</th>
                                    <th style="width:110px">Estado</th>
                                    <th class="text-end" style="width:130px">Saldo exigível</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for caso in casos %}
                                <tr class="cobranca-row-link{{ caso.temVencido ? ' cobranca-row-vencido' : '' }}" style="cursor:pointer;" data-href="{{ path('cobranca_caso_show', {id: caso.id}) }}">
                                    <td class="ps-3 align-middle">
                                        <span class="fw-semibold">{{ caso.objetoIdentificacao }}</span>
                                        {% if caso.objetoDescricao %}<div class="text-muted small">{{ caso.objetoDescricao }}</div>{% endif %}
                                    </td>
                                    <td class="align-middle">{{ caso.pessoaCobradaNome }}</td>
                                    <td class="align-middle">
                                        <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
                                        {% if caso.prontoParaEncerrar %}<span class="badge text-bg-success ms-1" data-bs-toggle="tooltip" title="Saldo exigível zerado — pode ser encerrado">Pronto</span>{% endif %}
                                    </td>
                                    <td class="align-middle text-end fw-semibold">{{ caso.saldoExigivel|centavos }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% else %}
                        <div class="cobranca-empty">
                            <div class="empty-ico"><i class="bi bi-briefcase"></i></div>
                            <p class="empty-title">Nenhum caso nesta carteira</p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('click', function (e) {
        var tr = e.target.closest('tr.cobranca-row-link');
        if (!tr) { return; }
        if (e.target.closest('button, a, form, input, select')) { return; }
        window.location.href = tr.dataset.href;
    });
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        if (typeof bootstrap !== 'undefined') { new bootstrap.Tooltip(el); }
    });
});
</script>
{% endblock %}
