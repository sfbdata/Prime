{% extends 'base.html.twig' %}

{% block title %}Cobranças · {{ carteira.nome }}{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="{{ path('cobranca_carteira_index') }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-folder2-open"></i>{{ carteira.nome }}</h1>
            {% if has_permission('resources.cobranca.gerenciar') %}
            <a href="{{ path('cobranca_importacao_upload', {id: carteira.id}) }}" class="btn btn-sm btn-outline-primary ms-auto">
                <i class="bi bi-upload me-1"></i>Importar relatório
            </a>
            {% endif %}
        </div>
        <div class="text-muted"><i class="bi bi-person-badge me-1"></i>{{ carteira.clienteNome }}</div>

        {# ── Até quando os dados estão em dia ────────────────────────────────
           É a EMISSÃO do relatório, não a hora em que a importação rodou: importar hoje um arquivo de
           três dias atrás deixa os dados de três dias atrás. E, entre os tipos, mostramos o MAIS
           ANTIGO — a carteira é a soma dos relatórios, então o elo mais fraco é que manda. #}
        {% if carteira.dadosAtualizadosAte %}
            {% set dias = date().diff(carteira.dadosAtualizadosAte).days %}
            <div class="small mt-1 {{ dias > 7 ? 'text-warning' : 'text-muted' }}"
                 data-bs-toggle="tooltip"
                 title="{% for tipo, emissao in carteira.emissaoPorTipo %}{{ tipo|capitalize }}: {{ emissao|date('d/m/Y H:i') }}{{ not loop.last ? ' · ' }}{% endfor %}">
                <i class="bi bi-clock-history me-1"></i>Dados atualizados até
                <strong>{{ carteira.dadosAtualizadosAte|date('d/m/Y') }}</strong>
                {%- if dias == 0 %} (hoje)
                {%- elseif dias == 1 %} (ontem)
                {%- else %} ({{ dias }} dias atrás)
                {%- endif %}
                <span class="text-muted">· pela importação dos relatórios</span>
            </div>
        {% else %}
            <div class="small mt-1 text-muted">
                <i class="bi bi-clock-history me-1"></i>Nenhum relatório importado ainda
            </div>
        {% endif %}
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Métricas ──────────────────────────────────────────── #}
        <div class="caso-header mb-3">
            <div class="caso-metrics">
                <div class="caso-metric">
                    <div class="caso-metric-label">Saldo consolidado</div>
                    <div class="caso-metric-valor {{ carteira.saldoConsolidado == 0 ? 'saldo-zerado' : '' }}">{{ carteira.saldoConsolidado|centavos }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">Objetos</div>
                    <div class="caso-metric-valor">{{ carteira.totalObjetos }}</div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            {# ── Configuração ──────────────────────────────────── #}
            <div class="col-lg-4">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-gear me-1"></i>Configuração</span>
                        {% if has_permission('resources.carteira.gerenciar') %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEditarConfiguracao">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </button>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-6 text-muted">Modo</dt>
                            <dd class="col-6">{{ carteira.modoLabel }}</dd>

                            <dt class="col-6 text-muted">Honorários</dt>
                            <dd class="col-6">{{ carteira.formaHonorariosLabel }}{% if carteira.percentualHonorarios %} ({{ carteira.percentualHonorarios }}%){% endif %}</dd>

                            <dt class="col-6 text-muted">Tolerância de atraso</dt>
                            <dd class="col-6">{{ carteira.toleranciaAtrasoDias }} dia(s)</dd>

                            {% if carteira.tipoVinculoPreferidoLabel %}
                            <dt class="col-6 text-muted">Vínculo preferido</dt>
                            <dd class="col-6">{{ carteira.tipoVinculoPreferidoLabel }}</dd>
                            {% endif %}

                            {% if carteira.rotuloObjeto %}
                            <dt class="col-6 text-muted">Rótulo do objeto</dt>
                            <dd class="col-6">{{ carteira.rotuloObjeto }}</dd>
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>

            {# ── Cobranças da carteira ─────────────────────────── #}
            <div class="col-lg-8">
                {# O card inteiro é o root do filtro: a barra de busca fica FORA da área trocável
                   (mantém o foco no campo enquanto digita), e o botão "Novo objeto" — que é
                   permissionado — nunca viaja no fragmento devolvido pelo XHR. #}
                <div class="card cobranca-card h-100" data-filtro-root data-filtro-endpoint="{{ path('cobranca_carteira_show', {id: carteira.id}) }}">
                    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-briefcase me-1"></i>Cobranças da carteira</span>
                        {% if has_permission('resources.cobranca.gerenciar') %}
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarObjeto">
                            <i class="bi bi-plus-lg me-1"></i>Novo objeto
                        </button>
                        {% endif %}
                    </div>
                    <div class="card-body pb-0">
                        {{ include('_partials/_filtro_barra.html.twig', {
                            busca_placeholder: 'Buscar por objeto ou pessoa cobrada…',
                            filtros: filtros,
                            facetas: []
                        }) }}
                    </div>
                    <div data-filtro-resultado>
                        {{ include('cobranca/carteira/_resultado_casos.html.twig') }}
                    </div>
                </div>
            </div>
        </div>

        {# ── Documentos da carteira (Ajuste #5) ────────────────── #}
        <div class="card cobranca-card mt-3">
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                <span><i class="bi bi-paperclip me-1"></i>Documentos</span>
                {% if has_permission('resources.cobranca.gerenciar') %}
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalAdicionarDocumentoCarteira">
                    <i class="bi bi-plus-lg me-1"></i>Adicionar documento
                </button>
                {% endif %}
            </div>
            <div class="table-responsive">
                {% if documentos|length > 0 %}
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Data</th>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Observação</th>
                            <th class="text-end" style="width:110px">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for doc in documentos %}
                        <tr>
                            <td class="ps-3 align-middle">{{ doc.carregadoEm|date('d/m/Y H:i') }}</td>
                            <td class="align-middle">{{ doc.nomeOriginal }}</td>
                            <td class="align-middle">{{ doc.categoria.rotulo }}</td>
                            <td class="align-middle text-muted small">{{ doc.observacao ?: '—' }}</td>
                            <td class="align-middle text-end">
                                <a href="{{ path('cobranca_carteira_documento_download', {docId: doc.id}) }}" class="btn btn-sm btn-outline-secondary" title="Baixar">
                                    <i class="bi bi-download"></i>
                                </a>
                                {% if has_permission('resources.cobranca.gerenciar') %}
                                <form method="post" action="{{ path('cobranca_carteira_documento_excluir', {docId: doc.id}) }}" class="d-inline" onsubmit="return confirm('Excluir este documento?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cobranca_carteira_documento_excluir_' ~ doc.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% else %}
                <div class="cobranca-empty">
                    <div class="empty-ico"><i class="bi bi-paperclip"></i></div>
                    <p class="empty-title">Nenhum documento anexado</p>
                </div>
                {% endif %}
            </div>
        </div>

    </div>
</section>

{{ include('cobranca/carteira/_acoes_modais.html.twig') }}
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
<script src="{{ asset('js/cobranca-carteira-form.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* Clique na linha delegado no document — sobrevive à troca do fragmento pela busca. */
    document.addEventListener('click', function (e) {
        var tr = e.target.closest('tr.cobranca-row-link');
        if (!tr) { return; }
        if (e.target.closest('button, a, form, input, select')) { return; }
        window.location.href = tr.dataset.href;
    });
    /* `getOrCreateInstance`: o fragmento da lista também liga os seus ao ser injetado —
       criar duas instâncias no mesmo elemento é erro no Bootstrap. */
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        if (typeof bootstrap !== 'undefined') { bootstrap.Tooltip.getOrCreateInstance(el); }
    });
});
</script>
{% endblock %}
