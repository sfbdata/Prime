{% extends 'base.html.twig' %}

{% block title %}Cobranças · {{ carteira.nome }}{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="{{ path('cobranca_carteira_index') }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-folder2-open"></i>{{ carteira.nome }}</h1>
            {% if has_permission('resources.cobranca.gerenciar') %}
            <a href="{{ path('cobranca_importacao_upload', {id: carteira.id}) }}" class="btn btn-sm btn-outline-primary ms-auto">
                <i class="bi bi-upload me-1"></i>Importar relatório
            </a>
            {% endif %}
        </div>
        <div class="text-muted"><i class="bi bi-person-badge me-1"></i>{{ carteira.clienteNome }}</div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Métricas ──────────────────────────────────────────── #}
        <div class="caso-header mb-3">
            <div class="caso-metrics">
                <div class="caso-metric">
                    <div class="caso-metric-label">Saldo consolidado</div>
                    <div class="caso-metric-valor {{ carteira.saldoConsolidado == 0 ? 'saldo-zerado' : '' }}">{{ carteira.saldoConsolidado|centavos }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">Objetos</div>
                    <div class="caso-metric-valor">{{ carteira.totalObjetos }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">Casos</div>
                    <div class="caso-metric-valor">{{ carteira.totalCasos }}</div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            {# ── Configuração ──────────────────────────────────── #}
            <div class="col-lg-4">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-gear me-1"></i>Configuração</span>
                        {% if has_permission('resources.carteira.gerenciar') %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEditarConfiguracao">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </button>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-6 text-muted">Modo</dt>
                            <dd class="col-6">{{ carteira.modoLabel }}</dd>

                            <dt class="col-6 text-muted">Honorários</dt>
                            <dd class="col-6">{{ carteira.formaHonorariosLabel }}{% if carteira.percentualHonorarios %} ({{ carteira.percentualHonorarios }}%){% endif %}</dd>

                            <dt class="col-6 text-muted">Tolerância de atraso</dt>
                            <dd class="col-6">{{ carteira.toleranciaAtrasoDias }} dia(s)</dd>

                            {% if carteira.tipoVinculoPreferidoLabel %}
                            <dt class="col-6 text-muted">Vínculo preferido</dt>
                            <dd class="col-6">{{ carteira.tipoVinculoPreferidoLabel }}</dd>
                            {% endif %}

                            {% if carteira.rotuloObjeto %}
                            <dt class="col-6 text-muted">Rótulo do objeto</dt>
                            <dd class="col-6">{{ carteira.rotuloObjeto }}</dd>
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>

            {# ── Casos da carteira ─────────────────────────────── #}
            <div class="col-lg-8">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold"><i class="bi bi-briefcase me-1"></i>Casos da carteira</div>
                    <div class="table-responsive">
                        {% if casos|length > 0 %}
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3">Objeto</th>
                                    <th>Pessoa cobrada</th>
                                    <th style="width:110px">Estado</th>
                                    <th class="text-end" style="width:130px">Saldo exigível</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for caso in casos %}
                                <tr class="cobranca-row-link{{ caso.temVencido ? ' cobranca-row-vencido' : '' }}" style="cursor:pointer;" data-href="{{ path('cobranca_objeto_show', {id: caso.objetoId}) }}">
                                    <td class="ps-3 align-middle">
                                        <span class="fw-semibold">{{ caso.objetoIdentificacao }}</span>
                                        {% if caso.objetoDescricao %}<div class="text-muted small">{{ caso.objetoDescricao }}</div>{% endif %}
                                    </td>
                                    <td class="align-middle">{{ caso.pessoaCobradaNome }}</td>
                                    <td class="align-middle">
                                        <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
                                        {% if caso.prontoParaEncerrar %}<span class="badge text-bg-success ms-1" data-bs-toggle="tooltip" title="Saldo exigível zerado — pode ser encerrado">Pronto</span>{% endif %}
                                    </td>
                                    <td class="align-middle text-end fw-semibold">{{ caso.saldoExigivel|centavos }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% else %}
                        <div class="cobranca-empty">
                            <div class="empty-ico"><i class="bi bi-briefcase"></i></div>
                            <p class="empty-title">Nenhum caso nesta carteira</p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# ── Objetos da carteira ───────────────────────────────── #}
        <div class="card cobranca-card mt-3">
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                <span><i class="bi bi-box-seam me-1"></i>Objetos{% if carteira.rotuloObjeto %} · {{ carteira.rotuloObjeto }}{% endif %}</span>
                {% if has_permission('resources.cobranca.gerenciar') %}
                <div class="d-flex gap-1 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalCriarPessoa">
                        <i class="bi bi-person-plus me-1"></i>Nova pessoa
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarObjeto">
                        <i class="bi bi-plus-lg me-1"></i>Novo objeto
                    </button>
                </div>
                {% endif %}
            </div>
            <div class="card-body">
                {% if objetos|length > 0 %}
                <div class="d-flex flex-column gap-2">
                    {% for objeto in objetos %}
                    <div class="border rounded p-2">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                            <div>
                                <a href="{{ path('cobranca_objeto_show', {id: objeto.id}) }}" class="fw-semibold text-decoration-none stretched-link-none">{{ objeto.identificacao }}</a>
                                {% if objeto.descricao %}<div class="text-muted small">{{ objeto.descricao }}</div>{% endif %}
                                {% if objeto.vinculos|length > 0 %}
                                <div class="mt-1 d-flex flex-wrap gap-1">
                                    {% for vinculo in objeto.vinculos %}
                                    <span class="badge text-bg-light border">
                                        {{ vinculo.pessoaNome }} <span class="text-muted">({{ vinculo.tipoLabel }})</span>
                                        {% if has_permission('resources.cobranca.gerenciar') %}
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-danger align-baseline"
                                                data-bs-toggle="modal" data-bs-target="#modalEncerrarVinculo"
                                                data-acao-url="{{ path('cobranca_vinculo_encerrar', {id: vinculo.id}) }}"
                                                data-vinculo-rotulo="{{ vinculo.pessoaNome }} ({{ vinculo.tipoLabel }})"
                                                title="Encerrar vínculo"><i class="bi bi-x-circle"></i></button>
                                        {% endif %}
                                    </span>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                            {% if has_permission('resources.cobranca.gerenciar') %}
                            <div class="d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal" data-bs-target="#modalVincularPessoa"
                                        data-acao-url="{{ path('cobranca_vinculo_criar', {id: objeto.id}) }}"
                                        data-objeto-rotulo="{{ objeto.identificacao }}">
                                    <i class="bi bi-person-plus me-1"></i>Vincular
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#modalAbrirCaso"
                                        data-acao-url="{{ path('cobranca_caso_abrir', {id: objeto.id}) }}"
                                        data-objeto-rotulo="{{ objeto.identificacao }}">
                                    <i class="bi bi-briefcase me-1"></i>Abrir caso
                                </button>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="cobranca-empty">
                    <div class="empty-ico"><i class="bi bi-box-seam"></i></div>
                    <p class="empty-title">Nenhum objeto nesta carteira</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

{{ include('cobranca/carteira/_acoes_modais.html.twig') }}
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/cobranca-carteira-form.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('click', function (e) {
        var tr = e.target.closest('tr.cobranca-row-link');
        if (!tr) { return; }
        if (e.target.closest('button, a, form, input, select')) { return; }
        window.location.href = tr.dataset.href;
    });
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        if (typeof bootstrap !== 'undefined') { new bootstrap.Tooltip(el); }
    });

    /* Modais reutilizáveis: o botão da linha injeta a URL de ação (data-acao-url) e o contexto. */
    [
        { modal: 'modalVincularPessoa', form: 'formVincularPessoa', ctx: '[data-objeto-contexto]', attr: 'data-objeto-rotulo', prefixo: 'Objeto: ' },
        { modal: 'modalAbrirCaso', form: 'formAbrirCaso', ctx: '[data-objeto-caso-contexto]', attr: 'data-objeto-rotulo', prefixo: 'Objeto: ' },
        { modal: 'modalEncerrarVinculo', form: 'formEncerrarVinculo', ctx: '[data-vinculo-contexto]', attr: 'data-vinculo-rotulo', prefixo: 'Vínculo: ' }
    ].forEach(function (cfg) {
        var modal = document.getElementById(cfg.modal);
        if (!modal) { return; }
        modal.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById(cfg.form);
            if (form) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
            var ctx = modal.querySelector(cfg.ctx);
            if (ctx) { ctx.textContent = cfg.prefixo + (botao.getAttribute(cfg.attr) || ''); }
        });
    });
});
</script>
{% endblock %}
