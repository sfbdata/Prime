{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
<script src="{{ asset('js/cobranca-carteira-form.js') }}"></script>
<script src="{{ asset('js/cobranca-soltar-arquivo.js') }}"></script>
{# Troca o <select> de Estado pelo botão com funil e menu do desenho. Melhoria progressiva:
   sem este script o <select> continua à vista e a tela filtra do mesmo jeito. #}
{{ catalogo_js('cobranca_carteira.js') }}
<script src="{{ asset('js/carteira-filtro-estado.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* Clique na linha delegado no document — sobrevive à troca do fragmento pela busca. */
    document.addEventListener('click', function (e) {
        var tr = e.target.closest('tr.cs-linha');
        if (!tr) { return; }
        if (e.target.closest('button, a, form, input, select')) { return; }
        window.location.href = tr.dataset.href;
    });
    /* "Exportar lista (.xlsx)": o href acompanha o recorte ATUAL do formulário da lista (busca, Estado,
       ordenação), que muda por XHR sem recarregar a página. É refeito quando o formulário muda, depois
       de cada troca do fragmento pelo XHR (é aí que ordenação, chips e "limpar" já gravaram os campos
       escondidos) e, por garantia, em todo gesto sobre o próprio link: clique, clique do meio, menu de
       contexto ("copiar link") e foco por teclado. */
    var linkExportar = document.querySelector('a[data-exportar-lista]');
    var formFiltro = document.querySelector('[data-filtro-form]');
    if (linkExportar && formFiltro) {
        var atualizarExportar = function () {
            var params = new URLSearchParams();
            new FormData(formFiltro).forEach(function (valor, nome) {
                if (String(valor).trim() !== '') { params.append(nome, valor); }
            });
            var query = params.toString();
            linkExportar.href = linkExportar.dataset.exportarBase + (query ? '?' + query : '');
        };
        ['input', 'change', 'submit'].forEach(function (tipo) {
            formFiltro.addEventListener(tipo, atualizarExportar);
        });
        ['click', 'auxclick', 'contextmenu', 'mousedown', 'focus'].forEach(function (tipo) {
            linkExportar.addEventListener(tipo, atualizarExportar);
        });
        var resultadoFiltro = document.querySelector('[data-filtro-resultado]');
        if (resultadoFiltro && window.MutationObserver) {
            new MutationObserver(atualizarExportar).observe(resultadoFiltro, { childList: true });
        }
    }
    /* Não há tooltip do Bootstrap nesta tela: o desenho usa `title` nativo, que sobrevive à
       troca do fragmento sem precisar ser religado a cada busca. */
});
</script>
{% endblock %}
