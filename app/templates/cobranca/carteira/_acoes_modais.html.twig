{# Modais de mutação da Carteira. Só renderizados para quem tem a capacidade correspondente (o gate
   real é no controller): configuração exige gerenciar carteira; objeto e documento exigem gerenciar
   cobrança.

   Redesenho 1B: a mecânica continua sendo a do Bootstrap (é o que o resto do sistema usa e o que os
   testes acionam); o que mudou é a moldura — cabeçalho com subtítulo, corpo em seções e rodapé com a
   ação principal em verde, como no desenho. A classe `.cs-modal` é quem veste isso.

   Os CAMPOS de configuração seguem vindo do partial compartilhado `_campos_config.html.twig`, que é o
   mesmo do modal "Nova carteira" da listagem — mexer na composição dos campos aqui mudaria a outra
   tela junto. #}

{# ── Editar configuração da carteira ─────────────────────────────── #}
{% if forms.editarConfiguracao is defined %}
<div class="modal fade cs-modal cs-modal-largo" id="modalEditarConfiguracao" tabindex="-1" aria-labelledby="tituloEditarConfiguracao" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            {{ form_start(forms.editarConfiguracao, {action: path('cobranca_carteira_configurar', {id: carteira.id})}) }}
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="tituloEditarConfiguracao">{{ 'cobranca_carteira.modais.configuracao_titulo'|trans }}</h5>
                    <div class="cs-modal-sub">{{ 'cobranca_carteira.modais.configuracao_sub'|trans }}</div>
                </div>
                <button type="button" class="cs-modal-fechar" data-bs-dismiss="modal" aria-label="{{ 'cobranca_carteira.comum.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                {{ include('cobranca/carteira/_campos_config.html.twig', { form: forms.editarConfiguracao }) }}
            </div>
            <div class="modal-footer">
                <span class="cs-modal-nota">{{ 'cobranca_carteira.modais.exige_permissao'|trans }} <code>resources.carteira.gerenciar</code></span>
                <button type="button" class="cs-btn" data-bs-dismiss="modal">{{ 'cobranca_carteira.comum.cancelar'|trans }}</button>
                <button type="submit" class="cs-btn cs-btn-verde">{{ 'cobranca_carteira.modais.salvar_configuracao'|trans }}</button>
            </div>
            {{ form_end(forms.editarConfiguracao) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Novo objeto (por carteira; action fixa) ─────────────────────── #}
{% if forms.criarObjeto is defined %}
<div class="modal fade cs-modal" id="modalCriarObjeto" tabindex="-1" aria-labelledby="tituloCriarObjeto" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.criarObjeto, {action: path('cobranca_objeto_criar', {id: carteira.id})}) }}
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="tituloCriarObjeto">{{ carteira.rotuloObjeto ? 'cobranca_carteira.modais.novo_objeto_rotulo'|trans({rotulo: carteira.rotuloObjeto|lower}) : 'cobranca_carteira.modais.novo_objeto'|trans }}</h5>
                    <div class="cs-modal-sub">{{ 'cobranca_carteira.modais.objeto_sub'|trans }}</div>
                </div>
                <button type="button" class="cs-modal-fechar" data-bs-dismiss="modal" aria-label="{{ 'cobranca_carteira.comum.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                {# O desenho mostra dois campos (identificação e descrição). O nome de quem será cobrado
                   fica: ele é obrigatório no `CriarObjetoInput` — sem ele o formulário nunca envia, e
                   um campo escondido que impede o envio é pior do que um campo a mais. #}
                {{ form_row(forms.criarObjeto.identificacao) }}
                {{ form_row(forms.criarObjeto.nomeCobrado) }}
                {{ form_row(forms.criarObjeto.descricao) }}
                {{ form_row(forms.criarObjeto.referenciaExterna) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="cs-btn" data-bs-dismiss="modal">{{ 'cobranca_carteira.comum.cancelar'|trans }}</button>
                <button type="submit" class="cs-btn cs-btn-verde">{{ 'cobranca_carteira.modais.criar_e_abrir'|trans }}</button>
            </div>
            {{ form_end(forms.criarObjeto) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Adicionar documento da carteira (form multipart puro, sem FormType) ── #}
{% if has_permission('resources.cobranca.gerenciar') %}
<div class="modal fade cs-modal" id="modalAdicionarDocumentoCarteira" tabindex="-1" aria-labelledby="tituloAdicionarDocumentoCarteira" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('cobranca_carteira_documento_upload', {id: carteira.id}) }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('cobranca_carteira_documento_upload_' ~ carteira.id) }}">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="tituloAdicionarDocumentoCarteira">{{ 'cobranca_carteira.modais.documento_titulo'|trans }}</h5>
                        <div class="cs-modal-sub">{{ 'cobranca_carteira.modais.documento_sub'|trans }}</div>
                    </div>
                    <button type="button" class="cs-modal-fechar" data-bs-dismiss="modal" aria-label="{{ 'cobranca_carteira.comum.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    {# Desenho Carteira 1B L457-461: área de arrastar ou clicar (cobranca-soltar-arquivo.js); o input
                       continua sendo o campo do form. O texto dos limites é o do servidor
                       (EnviarDocumentoUseCase::MIME_LIMITS: imagem até 3 MB), não o "até 10 MB" do desenho:
                       desvio por limite real, aprovado pela coordenação em 21/10; o dono revê. #}
                    <div class="mb-3">
                        <label class="cs-soltar" for="carteiraDocumentoArquivo" data-soltar-arquivo>
                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                            <span class="cs-soltar-titulo">{{ 'cobranca_carteira.modais.soltar_titulo'|trans }}</span>
                            <span class="cs-soltar-dica">{{ 'cobranca_carteira.modais.soltar_dica'|trans }}</span>
                            <span class="cs-soltar-nome" data-soltar-nome hidden></span>
                            <input type="file" class="cs-soltar-input" id="carteiraDocumentoArquivo" name="arquivo" required>
                        </label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="carteiraDocumentoCategoria">{{ 'cobranca_carteira.modais.categoria'|trans }}</label>
                        <select class="form-select" id="carteiraDocumentoCategoria" name="categoria">
                            {% for c in categoriasCarteira %}
                            <option value="{{ c.value }}">{{ c.rotulo }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="carteiraDocumentoObservacao">{{ 'cobranca_carteira.modais.observacao'|trans }} <span class="cs-modal-opcional">{{ 'cobranca_carteira.modais.opcional'|trans }}</span></label>
                        <textarea class="form-control" id="carteiraDocumentoObservacao" name="observacao" rows="3"
                                  placeholder="{{ 'cobranca_carteira.modais.observacao_exemplo'|trans }}"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cs-btn" data-bs-dismiss="modal">{{ 'cobranca_carteira.comum.cancelar'|trans }}</button>
                    <button type="submit" class="cs-btn cs-btn-verde">{{ 'cobranca_carteira.modais.adicionar'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
