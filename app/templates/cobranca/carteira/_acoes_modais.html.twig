{# Modais de mutação da Carteira (Onda 8B-E). Só renderizados para quem tem a capacidade correspondente
   (o gate real é no controller). Config exige gerenciar carteira; objeto/vínculo/abrir-caso exigem
   gerenciar cobrança. Vincular/encerrar/abrir-caso são modais REUTILIZÁVEIS: o botão da linha injeta a
   URL de ação (data-acao-url) via JS. #}

{# ── Editar configuração da carteira ─────────────────────────────── #}
{% if forms.editarConfiguracao is defined %}
<div class="modal fade" id="modalEditarConfiguracao" tabindex="-1" aria-labelledby="tituloEditarConfiguracao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.editarConfiguracao, {action: path('cobranca_carteira_configurar', {id: carteira.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarConfiguracao"><i class="bi bi-gear me-1"></i>Editar configuração</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ include('cobranca/carteira/_campos_config.html.twig', { form: forms.editarConfiguracao }) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
            </div>
            {{ form_end(forms.editarConfiguracao) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Novo objeto (por carteira; action fixa) ─────────────────────── #}
{% if forms.criarObjeto is defined %}
<div class="modal fade" id="modalCriarObjeto" tabindex="-1" aria-labelledby="tituloCriarObjeto" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.criarObjeto, {action: path('cobranca_objeto_criar', {id: carteira.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloCriarObjeto"><i class="bi bi-plus-circle me-1"></i>Novo objeto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.criarObjeto.identificacao) }}
                {{ form_row(forms.criarObjeto.nomeCobrado) }}
                {{ form_row(forms.criarObjeto.descricao) }}
                {{ form_row(forms.criarObjeto.referenciaExterna) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Criar</button>
            </div>
            {{ form_end(forms.criarObjeto) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Adicionar documento da carteira (Ajuste #5; form multipart puro, sem FormType) ── #}
{% if has_permission('resources.cobranca.gerenciar') %}
<div class="modal fade" id="modalAdicionarDocumentoCarteira" tabindex="-1" aria-labelledby="tituloAdicionarDocumentoCarteira" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('cobranca_carteira_documento_upload', {id: carteira.id}) }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('cobranca_carteira_documento_upload_' ~ carteira.id) }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloAdicionarDocumentoCarteira"><i class="bi bi-paperclip me-1"></i>Adicionar documento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="carteiraDocumentoArquivo">Arquivo</label>
                        <input type="file" class="form-control" id="carteiraDocumentoArquivo" name="arquivo" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="carteiraDocumentoCategoria">Categoria</label>
                        <select class="form-select" id="carteiraDocumentoCategoria" name="categoria">
                            {% for c in categoriasCarteira %}
                            <option value="{{ c.value }}">{{ c.rotulo }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="carteiraDocumentoObservacao">Observação</label>
                        <textarea class="form-control" id="carteiraDocumentoObservacao" name="observacao" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
