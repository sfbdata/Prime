{% extends 'base.html.twig' %}

{% block title %}{{ 'cobranca_carteira.lista.titulo_pagina'|trans }}{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="m-0 d-flex align-items-center gap-2">
            <i class="bi bi-cash-coin"></i>{{ 'cobranca_carteira.comum.cobrancas'|trans }}
        </h1>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            {{ include('cobranca/_partials/_subnav.html.twig', { ativo: 'carteiras' }) }}
            {% if formCriarCarteira is defined and formCriarCarteira is not null %}
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarCarteira">
                <i class="bi bi-plus-lg me-1"></i>{{ 'cobranca_carteira.lista.nova_carteira'|trans }}
            </button>
            {% endif %}
        </div>
    </div>
</section>

{% if formCriarCarteira is defined and formCriarCarteira is not null %}
<div class="modal fade" id="modalCriarCarteira" tabindex="-1" aria-labelledby="tituloCriarCarteira" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(formCriarCarteira, {action: path('cobranca_carteira_criar')}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloCriarCarteira"><i class="bi bi-plus-circle me-1"></i>{{ 'cobranca_carteira.lista.nova_carteira'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_carteira.comum.fechar'|trans }}"></button>
            </div>
            <div class="modal-body">
                {{ form_row(formCriarCarteira.nome) }}
                {{ form_row(formCriarCarteira.clienteId) }}
                {# Credor ainda sem cadastro (decisão do dono, 21/10/2026): abre a janela de Cadastro sem pasta
                   (cliente-cadastro.js); ao fechar depois de salvar, a página recarrega com o cliente no select. #}
                <p class="small mt-n2 mb-3">
                    {{ 'cobranca_carteira.lista.cliente_fora_da_lista'|trans }}
                    <a href="#" class="js-cad-abrir" data-url="{{ path('cliente_cadastro_novo') }}" data-bs-dismiss="modal">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i>{{ 'cobranca_carteira.lista.cadastrar_cliente'|trans }}
                    </a>
                </p>
                {{ include('cobranca/carteira/_campos_config.html.twig', { form: formCriarCarteira }) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_carteira.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ 'cobranca_carteira.lista.criar_carteira'|trans }}</button>
            </div>
            {{ form_end(formCriarCarteira) }}
        </div>
    </div>
</div>
{% endif %}

<section class="content">
    <div class="container-fluid">
        <div data-filtro-root data-filtro-endpoint="{{ path('cobranca_carteira_index') }}">
            {{ include('_partials/_filtro_barra.html.twig', {
                busca_placeholder: 'cobranca_carteira.lista.busca_placeholder'|trans,
                filtros: filtros,
                facetas: [
                    { name: 'modo', rotulo: 'cobranca_carteira.lista.faceta_modo'|trans, tipo: 'select', opcoes: [
                        { valor: 'unico', label: 'cobranca_carteira.lista.modo_unico'|trans },
                        { valor: 'multiplo', label: 'cobranca_carteira.lista.modo_multiplo'|trans }
                    ] }
                ]
            }) }}

            <div data-filtro-resultado>
                {{ include('cobranca/carteira/_resultado.html.twig') }}
            </div>
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
<link rel="stylesheet" href="{{ asset('css/cliente-cadastro.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
<script src="{{ asset('js/cobranca-carteira-form.js') }}"></script>
{{ catalogo_js('cliente.js') }}
<script src="{{ asset('js/cliente-cadastro.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* Linhas clicáveis — delegado no document, sobrevive à troca do fragmento */
    document.addEventListener('click', function (e) {
        var tr = e.target.closest('tr.cobranca-row-link');
        if (!tr) { return; }
        if (e.target.closest('button, a, form, input, select')) { return; }
        window.location.href = tr.dataset.href;
    });
});
</script>
{% endblock %}
