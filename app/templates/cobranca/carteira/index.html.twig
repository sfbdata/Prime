{% extends 'base.html.twig' %}

{% block title %}Cobranças · Carteiras{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="m-0 d-flex align-items-center gap-2">
            <i class="bi bi-cash-coin"></i>Cobranças
        </h1>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            {{ include('cobranca/_partials/_subnav.html.twig', { ativo: 'carteiras' }) }}
            {% if formCriarCarteira is defined and formCriarCarteira is not null %}
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarCarteira">
                <i class="bi bi-plus-lg me-1"></i>Nova carteira
            </button>
            {% endif %}
        </div>
    </div>
</section>

{% if formCriarCarteira is defined and formCriarCarteira is not null %}
<div class="modal fade" id="modalCriarCarteira" tabindex="-1" aria-labelledby="tituloCriarCarteira" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(formCriarCarteira, {action: path('cobranca_carteira_criar')}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloCriarCarteira"><i class="bi bi-plus-circle me-1"></i>Nova carteira</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(formCriarCarteira.nome) }}
                {{ form_row(formCriarCarteira.clienteId) }}
                {{ include('cobranca/carteira/_campos_config.html.twig', { form: formCriarCarteira }) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Criar carteira</button>
            </div>
            {{ form_end(formCriarCarteira) }}
        </div>
    </div>
</div>
{% endif %}

<section class="content">
    <div class="container-fluid">
        <div data-filtro-root data-filtro-endpoint="{{ path('cobranca_carteira_index') }}">
            {{ include('_partials/_filtro_barra.html.twig', {
                busca_placeholder: 'Buscar carteira pelo nome…',
                filtros: filtros,
                facetas: [
                    { name: 'modo', rotulo: 'Modo', tipo: 'select', opcoes: [
                        { valor: 'unico', label: 'Uma cobrança por objeto' },
                        { valor: 'multiplo', label: 'Várias cobranças por objeto' }
                    ] }
                ]
            }) }}

            <div data-filtro-resultado>
                {{ include('cobranca/carteira/_resultado.html.twig') }}
            </div>
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
<script src="{{ asset('js/cobranca-carteira-form.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* Linhas clicáveis — delegado no document, sobrevive à troca do fragmento */
    document.addEventListener('click', function (e) {
        var tr = e.target.closest('tr.cobranca-row-link');
        if (!tr) { return; }
        if (e.target.closest('button, a, form, input, select')) { return; }
        window.location.href = tr.dataset.href;
    });
});
</script>
{% endblock %}
