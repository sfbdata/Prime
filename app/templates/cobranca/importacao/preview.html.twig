{% extends 'base.html.twig' %}

{% block title %}{{ confirmado ? 'cobranca_carteira.previa.titulo_pagina_importado'|trans({carteira: carteiraNome}) : 'cobranca_carteira.previa.titulo_pagina_previa'|trans({carteira: carteiraNome}) }}{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="{{ path('cobranca_carteira_show', {id: carteiraId}) }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="m-0 d-flex align-items-center gap-2">
                <i class="bi {{ confirmado ? 'bi-check-circle text-success' : 'bi-eye' }}"></i>
                {{ confirmado ? 'cobranca_carteira.previa.concluida'|trans : 'cobranca_carteira.previa.titulo'|trans }}
            </h1>
        </div>
        <div class="text-muted">
            <i class="bi bi-folder2-open me-1"></i>{{ carteiraNome }}
            {% if nomeArquivo %} · <i class="bi bi-filetype-xlsx me-1"></i>{{ nomeArquivo }}{% endif %}
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {% if not confirmado %}
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1"></i>
            {{ 'cobranca_carteira.previa.aviso.inicio'|trans }} <strong>{{ 'cobranca_carteira.previa.aviso.previa'|trans }}</strong>{{ 'cobranca_carteira.previa.aviso.fim'|trans }}
        </div>
        {% endif %}

        {# ── Resumo ────────────────────────────────────────────── #}
        <div class="caso-header mb-3">
            <div class="caso-metrics">
                <div class="caso-metric">
                    <div class="caso-metric-label">{{ confirmado ? 'cobranca_carteira.previa.obrigacoes_importadas'|trans : 'cobranca_carteira.previa.serao_importadas'|trans }}</div>
                    <div class="caso-metric-valor text-success">{{ resultado.totalImportadas }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">{{ confirmado ? 'cobranca_carteira.previa.atualizadas'|trans : 'cobranca_carteira.previa.serao_atualizadas'|trans }}</div>
                    <div class="caso-metric-valor">{{ resultado.totalAtualizadas }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">{{ 'cobranca_carteira.previa.rejeitadas'|trans }}</div>
                    <div class="caso-metric-valor {{ 0 < resultado.totalRejeitadas ? 'text-danger' : '' }}">{{ resultado.totalRejeitadas }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label">{{ 'cobranca_carteira.previa.ignoradas'|trans }}</div>
                    <div class="caso-metric-valor text-muted">{{ resultado.linhasIgnoradas }}</div>
                </div>
            </div>
            <div class="text-muted small mt-2">
                {{ 'cobranca_carteira.previa.novos'|trans({objetos: resultado.objetosCriados ~ '', pessoas: resultado.pessoasCriadas ~ '', casos: resultado.casosCriados ~ ''}) }}
            </div>
        </div>

        {#
            Dívida que NUNCA teve boleto (spec cobranca-divida-sem-numero-de-boleto.md §4.3). Mesmo
            motivo do bloco abaixo, e o mesmo defeito repetido: a contagem existia só na CLI, e a tela
            é o caminho que o gestor usa. A distinção é jurídica, não cosmética — uma é dívida boletada,
            com número que o condômino confere no extrato; a outra é lançamento antigo que a
            contabilidade nunca cobrou. Quem for negociar precisa saber qual é qual.
        #}
        {% set sem_boleto = resultado.totalSemBoleto + resultado.totalSemBoletoAtualizadas %}
        {% if sem_boleto > 0 %}
        <div class="alert alert-warning d-flex gap-2 align-items-start" role="alert">
            <i class="bi bi-receipt-cutoff mt-1"></i>
            <div>
                {% set paramsSemBoleto = {total: sem_boleto ~ '', novas: resultado.totalSemBoleto ~ '', atualizadas: resultado.totalSemBoletoAtualizadas ~ ''} %}
                <strong>{{ 'cobranca_carteira.previa.sem_boleto.titulo'|trans }}</strong>{{ confirmado ? 'cobranca_carteira.previa.sem_boleto.resumo_criadas'|trans(paramsSemBoleto) : 'cobranca_carteira.previa.sem_boleto.resumo_a_criar'|trans(paramsSemBoleto) }}
                <strong>{{ 'cobranca_carteira.previa.sem_boleto.valor'|trans({valor: (resultado.centavosSemBoleto / 100)|number_format(2, ',', '.')}) }}</strong>
                {{ 'cobranca_carteira.previa.sem_boleto.de_principal'|trans }}
                <div class="small mt-1">
                    {{ 'cobranca_carteira.previa.sem_boleto.nota'|trans }}
                    <code>{{ 'cobranca_carteira.previa.sem_boleto.chave'|trans }}</code>{{ 'cobranca_carteira.previa.sem_boleto.nota_fim'|trans }}
                </div>
            </div>
        </div>
        {% endif %}

        {#
            Os dois avisos da chave NN+competência (spec cobranca-importar-chave-competencia.md). Existiam
            no resultado desde a correção da chave, mas só apareciam na CLI — e a tela é o caminho que o
            gestor usa. Silêncio aqui era o defeito que aquela spec corrigiu: o operador confirmava sem
            saber que uma dívida nova nasceu com um número repetido, ou que um boleto foi reemitido.
        #}
        {% if resultado.referenciasReutilizadas|length > 0 %}
        <div class="alert alert-warning">
            <i class="bi bi-123 me-1"></i>
            <strong>{{ 'cobranca_carteira.previa.reutilizado.titulo'|trans }}</strong> {{ 'cobranca_carteira.previa.reutilizado.em'|trans({total: resultado.referenciasReutilizadas|length ~ ''}) }}
            <strong>{{ 'cobranca_carteira.previa.reutilizado.outra_competencia'|trans }}</strong>{{ 'cobranca_carteira.previa.reutilizado.e'|trans }}
            <strong>{{ 'cobranca_carteira.previa.reutilizado.outra_divida'|trans }}</strong>{{ confirmado ? 'cobranca_carteira.previa.reutilizado.nasceu'|trans : 'cobranca_carteira.previa.reutilizado.vai_nascer'|trans }}
            <div class="small mt-1">{{ 'cobranca_carteira.previa.nossos_numeros'|trans({lista: resultado.referenciasReutilizadas|join(', ')}) }}</div>
        </div>
        {% endif %}

        {% if resultado.vencimentosAlterados|length > 0 %}
        <div class="alert alert-info">
            <i class="bi bi-calendar-event me-1"></i>
            <strong>{{ 'cobranca_carteira.previa.vencimento.titulo'|trans }}</strong> {{ 'cobranca_carteira.previa.vencimento.em'|trans({total: resultado.vencimentosAlterados|length ~ ''}) }}
            <strong>{{ 'cobranca_carteira.previa.vencimento.reemitido'|trans }}</strong>{{ 'cobranca_carteira.previa.vencimento.lancado'|trans }}
            <strong>{{ 'cobranca_carteira.previa.vencimento.nao_sobrescrito'|trans }}</strong>{{ 'cobranca_carteira.previa.vencimento.fim'|trans }}
            <div class="small mt-1">{{ 'cobranca_carteira.previa.nossos_numeros'|trans({lista: resultado.vencimentosAlterados|join(', ')}) }}</div>
        </div>
        {% endif %}

        {% if resultado.sacadosDivergentes|length > 0 %}
        <div class="alert alert-info">
            <i class="bi bi-people me-1"></i>
            <strong>{{ 'cobranca_carteira.previa.sacado.titulo'|trans }}</strong> {{ 'cobranca_carteira.previa.sacado.em'|trans({total: resultado.sacadosDivergentes|length ~ ''}) }}
            <strong>{{ 'cobranca_carteira.previa.sacado.nao_trocada'|trans }}</strong> {{ 'cobranca_carteira.previa.sacado.decisao'|trans }}
            {{ 'cobranca_carteira.previa.sacado.objetos'|trans({lista: resultado.sacadosDivergentes|join(', ')}) }}
        </div>
        {% endif %}

        <div class="row g-3">
            {# ── Rejeitadas ────────────────────────────────────── #}
            <div class="col-lg-6">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold"><i class="bi bi-x-octagon me-1 text-danger"></i>{{ 'cobranca_carteira.previa.rejeitadas_total'|trans({total: resultado.totalRejeitadas ~ ''}) }}</div>
                    <div class="table-responsive">
                        {% if resultado.rejeitadas|length > 0 %}
                        <table class="table mb-0 small">
                            <thead><tr><th class="ps-3">{{ 'cobranca_carteira.previa.referencia'|trans }}</th><th>{{ 'cobranca_carteira.previa.motivo'|trans }}</th></tr></thead>
                            <tbody>
                                {% for linha in resultado.rejeitadas %}
                                <tr>
                                    <td class="ps-3 align-middle fw-semibold">{{ linha.referencia }}</td>
                                    <td class="align-middle">{{ linha.motivo }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% else %}
                        <div class="cobranca-empty py-3"><p class="empty-title mb-0">{{ 'cobranca_carteira.previa.nenhuma_rejeitada'|trans }}</p></div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Importadas / Atualizadas ──────────────────────── #}
            <div class="col-lg-6">
                <div class="card cobranca-card h-100">
                    <div class="card-header fw-semibold"><i class="bi bi-list-check me-1"></i>{{ 'cobranca_carteira.previa.boletos'|trans }}</div>
                    <div class="card-body">
                        <div class="mb-2">
                            <span class="badge text-bg-success">{{ confirmado ? 'cobranca_carteira.previa.importadas'|trans : 'cobranca_carteira.previa.a_importar'|trans }}</span>
                            <span class="small text-muted">{{ resultado.obrigacoesCriadas|length > 0 ? (resultado.obrigacoesCriadas|join(', ')) : 'cobranca_carteira.previa.nenhuma'|trans }}</span>
                        </div>
                        <div>
                            <span class="badge text-bg-secondary">{{ confirmado ? 'cobranca_carteira.previa.atualizadas'|trans : 'cobranca_carteira.previa.a_atualizar'|trans }}</span>
                            <span class="small text-muted">{{ resultado.obrigacoesAtualizadas|length > 0 ? (resultado.obrigacoesAtualizadas|join(', ')) : 'cobranca_carteira.previa.nenhuma'|trans }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Ações ─────────────────────────────────────────────── #}
        <div class="d-flex justify-content-end gap-2 mt-3">
            {% if confirmado %}
                <a href="{{ path('cobranca_carteira_show', {id: carteiraId}) }}" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>{{ 'cobranca_carteira.previa.concluir'|trans }}</a>
            {% else %}
                <a href="{{ path('cobranca_importacao_upload', {id: carteiraId}) }}" class="btn btn-outline-secondary">{{ 'cobranca_carteira.previa.trocar_arquivo'|trans }}</a>
                {% if resultado.totalImportadas > 0 or resultado.totalAtualizadas > 0 %}
                <form method="POST" action="{{ path('cobranca_importacao_confirmar', {id: carteiraId}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('importar_confirmar_' ~ carteiraId) }}">
                    <button type="submit" class="btn btn-success"><i class="bi bi-database-check me-1"></i>{{ 'cobranca_carteira.previa.confirmar'|trans }}</button>
                </form>
                {% endif %}
            {% endif %}
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}
