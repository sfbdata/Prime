{#
   Aba Atividade da Central (spec §4/§5). Uma linha por pessoa, total do setor no topo.

   Volume e efetividade LADO A LADO, sem nota única e sem ranking (decisão do dono): "Contatos" é toda
   tentativa, "Falou com o devedor" é o subconjunto atendido. Sem R$ por pessoa — "Baixas registradas"
   conta o ato, não o mérito da negociação.

   Quem não trabalhou aparece ZERADO: a ausência é a informação que o gestor veio buscar.

   Contexto herdado do index: `atividade`, `periodo`, `carteiraId`.
#}
{% set filtrosDetalhe = { periodo: periodo.atalho, inicio: periodo.inicioTexto, fim: periodo.fimTexto } %}
{% if carteiraId %}{% set filtrosDetalhe = filtrosDetalhe|merge({ carteira: carteiraId }) %}{% endif %}

{% if atividade.pessoas is empty %}
    <div class="cobranca-empty">
        <div class="empty-ico"><i class="bi bi-people"></i></div>
        <div class="empty-title">{{ 'cobranca_pessoa.atividade.sem_pessoas'|trans }}</div>
        <div class="text-muted">{{ 'cobranca_pessoa.atividade.sem_pessoas_texto'|trans }}</div>
    </div>
{% else %}
    {% if atividade.vazia %}
        {#
           "Nenhum TRABALHO", não "nenhum registro": desde o §5.1 as colunas e a última ação só contam
           trabalho de cobrança, então um período só de importação cai aqui — e dizer "nenhum registro"
           seria falso justamente na primeira frase da tela.
        #}
        <p class="cobranca-central-aviso text-muted small mb-2">
            <i class="bi bi-info-circle me-1"></i>{{ 'cobranca_pessoa.atividade.vazia'|trans }}
        </p>
    {% endif %}

    {# Faixa de canais (spec §4): "quantos contatos e por qual meio", a pergunta direta do dono. #}
    <div class="cobranca-central-canais mb-3">
        <span class="cobranca-central-canais-total">{{ 'cobranca_pessoa.atividade.contatos_no_periodo'|trans }} <strong>{{ atividade.totalContatos }}</strong></span>
        <span class="cobranca-central-canais-sep" aria-hidden="true">·</span>
        <span class="cobranca-pastilhas">
            {% for canal in atividade.canais %}
            <span class="cobranca-pastilha {{ canal.quantidade == 0 ? 'is-zerada' : '' }}">
                {{ canal.label }}<strong class="ms-1">{{ canal.quantidade }}</strong>
            </span>
            {% endfor %}
        </span>
    </div>

    <div class="card cobranca-card cobranca-central-tabela">
        <table class="table table-sm align-middle mb-0" id="tabelaAtividade">
            <thead>
                <tr>
                    <th scope="col">{{ 'cobranca_pessoa.atividade.coluna.quem'|trans }}</th>
                    <th scope="col" class="text-end">{{ 'cobranca_pessoa.atividade.coluna.contatos'|trans }}</th>
                    <th scope="col" class="text-end">{{ 'cobranca_pessoa.atividade.coluna.atendidos'|trans }}</th>
                    <th scope="col" class="text-end">{{ 'cobranca_pessoa.atividade.coluna.acordos'|trans }}</th>
                    <th scope="col" class="text-end">{{ 'cobranca_pessoa.atividade.coluna.baixas'|trans }}</th>
                    <th scope="col" class="text-end d-none d-md-table-cell">{{ 'cobranca_pessoa.atividade.coluna.ultima_acao'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                <tr class="cobranca-central-total">
                    <th scope="row">{{ 'cobranca_pessoa.atividade.total_do_setor'|trans }}</th>
                    <td class="text-end">{{ atividade.totalContatos }}</td>
                    <td class="text-end">{{ atividade.totalAtendidos }}</td>
                    <td class="text-end">{{ atividade.totalAcordos }}</td>
                    <td class="text-end">{{ atividade.totalBaixas }}</td>
                    <td class="text-end d-none d-md-table-cell">
                        {% if atividade.ultimaAcaoDoSetor %}{{ include('cobranca/central/_momento.html.twig', { momento: atividade.ultimaAcaoDoSetor }) }}{% else %}<span class="text-muted small">{{ 'cobranca_pessoa.atividade.sem_registro'|trans }}</span>{% endif %}
                    </td>
                </tr>

                {% for pessoa in atividade.pessoas %}
                {% set chave = pessoa.chaveDetalhe %}
                <tr class="js-linha-pessoa cobranca-central-linha {{ pessoa.semResponsavel ? 'is-sem-responsavel' : '' }}"
                    data-chave="{{ chave }}"
                    data-url="{{ path('cobranca_central_atividade_detalhe', filtrosDetalhe|merge({ chave: chave })) }}"
                    role="button" tabindex="0" aria-expanded="false" aria-controls="detalhe-{{ chave }}">
                    <th scope="row" class="fw-normal">
                        <i class="bi bi-chevron-right cobranca-central-chevron"></i>
                        {% if pessoa.semResponsavel %}
                            <span class="text-muted fst-italic">{{ pessoa.nome }}</span>
                            <i class="bi bi-question-circle text-muted ms-1"
                               data-bs-toggle="tooltip"
                               title="{{ 'cobranca_pessoa.atividade.sem_responsavel_dica'|trans }}"></i>
                        {% else %}
                            {{ pessoa.nome }}
                        {% endif %}
                    </th>
                    <td class="text-end">{{ pessoa.contatos }}</td>
                    <td class="text-end">{{ pessoa.atendidos }}</td>
                    <td class="text-end">{{ pessoa.acordos }}</td>
                    <td class="text-end">{{ pessoa.baixas }}</td>
                    <td class="text-end d-none d-md-table-cell">
                        {% if pessoa.ultimaAcao %}{{ include('cobranca/central/_momento.html.twig', { momento: pessoa.ultimaAcao }) }}{% else %}<span class="text-muted small">{{ 'cobranca_pessoa.atividade.sem_registro'|trans }}</span>{% endif %}
                    </td>
                </tr>
                <tr class="js-linha-detalhe cobranca-central-detalhe" id="detalhe-{{ chave }}" hidden>
                    <td colspan="6" class="js-detalhe-conteudo"></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
