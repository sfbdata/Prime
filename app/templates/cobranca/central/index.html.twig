{% extends 'base.html.twig' %}

{% block title %}Cobranças · Central{% endblock %}

{#
   Central de Acompanhamento da Cobrança — Fatia 1 (spec `cobranca-central-acompanhamento.md`).
   Esqueleto das 4 abas com só a de Atividade preenchida; as outras dizem, sem enfeite, que ainda
   não existem. Leitura pura: nenhum formulário de escrita nesta tela.
#}
{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-people"></i>Cobranças</h1>
        {{ include('cobranca/_partials/_subnav.html.twig', { ativo: 'central' }) }}
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Filtros (período + carteira) ─────────────────────── #}
        <form method="get" action="{{ path('cobranca_central') }}" class="row g-2 align-items-end mb-3" id="filtrosCentral">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small mb-1" for="filtroPeriodo">Período</label>
                <select class="form-select form-select-sm" id="filtroPeriodo" name="periodo">
                    {% for valor, rotulo in {
                        'hoje': 'Hoje',
                        'ontem': 'Ontem',
                        'semana': 'Esta semana',
                        'mes': 'Este mês',
                        'personalizado': 'Personalizado'
                    } %}
                    <option value="{{ valor }}" {{ periodo.atalho == valor ? 'selected' : '' }}>{{ rotulo }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-2 js-periodo-personalizado" {{ periodo.atalho != 'personalizado' ? 'hidden' : '' }}>
                <label class="form-label small mb-1" for="filtroInicio">De</label>
                <input type="date" class="form-control form-control-sm" id="filtroInicio" name="inicio" value="{{ periodo.inicioTexto }}">
            </div>
            <div class="col-6 col-md-2 js-periodo-personalizado" {{ periodo.atalho != 'personalizado' ? 'hidden' : '' }}>
                <label class="form-label small mb-1" for="filtroFim">Até</label>
                <input type="date" class="form-control form-control-sm" id="filtroFim" name="fim" value="{{ periodo.fimTexto }}">
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small mb-1" for="filtroCarteira">Carteira</label>
                <select class="form-select form-select-sm" id="filtroCarteira" name="carteira">
                    <option value="">Todas as carteiras</option>
                    {% for c in carteiras %}
                    <option value="{{ c.id }}" {{ carteiraId == c.id ? 'selected' : '' }}>{{ c.nome }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel me-1"></i>Aplicar</button>
            </div>
        </form>

        {# ── Abas ─────────────────────────────────────────────── #}
        <ul class="nav nav-tabs cobranca-central-abas" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="abaAtividade" data-bs-toggle="tab" data-bs-target="#paneAtividade"
                        type="button" role="tab" aria-controls="paneAtividade" aria-selected="true">
                    <i class="bi bi-activity me-1"></i>Atividade
                </button>
            </li>
            {% for aba in [
                { id: 'Resultado', rotulo: 'Resultado', icone: 'graph-up-arrow' },
                { id: 'Pendencias', rotulo: 'Pendências', icone: 'hourglass-split' },
                { id: 'Extrato', rotulo: 'Extrato do devedor', icone: 'person-lines-fill' }
            ] %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="aba{{ aba.id }}" data-bs-toggle="tab" data-bs-target="#pane{{ aba.id }}"
                        type="button" role="tab" aria-controls="pane{{ aba.id }}" aria-selected="false">
                    <i class="bi bi-{{ aba.icone }} me-1"></i>{{ aba.rotulo }}
                </button>
            </li>
            {% endfor %}
        </ul>

        <div class="tab-content cobranca-central-conteudo">
            <div class="tab-pane fade show active" id="paneAtividade" role="tabpanel" aria-labelledby="abaAtividade">
                {{ include('cobranca/central/_aba_atividade.html.twig') }}
            </div>
            {% for aba in [
                { id: 'Resultado', rotulo: 'Resultado' },
                { id: 'Pendencias', rotulo: 'Pendências' },
                { id: 'Extrato', rotulo: 'Extrato do devedor' }
            ] %}
            <div class="tab-pane fade" id="pane{{ aba.id }}" role="tabpanel" aria-labelledby="aba{{ aba.id }}">
                <div class="cobranca-empty">
                    <div class="empty-ico"><i class="bi bi-cone-striped"></i></div>
                    <div class="empty-title">{{ aba.rotulo }} — em construção</div>
                    <div class="text-muted">Esta aba entra numa próxima fatia da Central.</div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';

    // Os campos de data só fazem sentido no atalho "Personalizado".
    var seletorPeriodo = document.getElementById('filtroPeriodo');
    var camposData = document.querySelectorAll('.js-periodo-personalizado');
    if (seletorPeriodo) {
        seletorPeriodo.addEventListener('change', function () {
            var personalizado = seletorPeriodo.value === 'personalizado';
            camposData.forEach(function (campo) { campo.hidden = !personalizado; });
        });
    }

    // Detalhe da pessoa: carregado SOB DEMANDA na rota própria e injetado abaixo da linha clicada.
    // A tabela não embute o detalhe de todo mundo — a primeira consulta não pode crescer com a equipe.
    var tabela = document.getElementById('tabelaAtividade');
    if (!tabela) { return; }

    // A linha é o controle: teclado tem de abrir o detalhe igual ao mouse.
    tabela.addEventListener('keydown', function (evento) {
        if (evento.key !== 'Enter' && evento.key !== ' ') { return; }

        var linha = evento.target.closest('.js-linha-pessoa');
        if (!linha) { return; }

        evento.preventDefault();
        linha.click();
    });

    tabela.addEventListener('click', function (evento) {
        var linha = evento.target.closest('.js-linha-pessoa');
        if (!linha) { return; }

        // Link do detalhe já aberto não pode fechar a linha por baixo do clique.
        if (evento.target.closest('a')) { return; }

        var destino = document.getElementById('detalhe-' + linha.dataset.chave);
        var celula = destino.querySelector('.js-detalhe-conteudo');
        var aberto = !destino.hidden;

        // Um detalhe por vez: abrir outro fecha o anterior, senão a tabela vira uma pilha de painéis.
        tabela.querySelectorAll('.js-linha-detalhe').forEach(function (l) { l.hidden = true; });
        tabela.querySelectorAll('.js-linha-pessoa').forEach(function (l) {
            l.classList.remove('is-aberta');
            l.setAttribute('aria-expanded', 'false');
        });

        if (aberto) { return; }

        destino.hidden = false;
        linha.classList.add('is-aberta');
        linha.setAttribute('aria-expanded', 'true');
        celula.innerHTML = '<div class="text-muted small py-2"><span class="spinner-border spinner-border-sm me-2"></span>Carregando…</div>';

        fetch(linha.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (resposta) {
                if (!resposta.ok) { throw new Error('falha ' + resposta.status); }

                return resposta.text();
            })
            .then(function (html) { celula.innerHTML = html; })
            .catch(function () {
                celula.innerHTML = '<div class="text-danger small py-2">Não foi possível carregar o detalhe. Tente de novo.</div>';
            });
    });
})();
</script>
{% endblock %}
