   ('painel' | 'carteiras' | 'casos' | 'alertas').
─────────────────────────────────────────────────────────────────────────── #}
<nav class="cobranca-subnav" aria-label="Seções de Cobranças">
    <a href="{{ path('cobranca_dashboard') }}"
       class="cobranca-subnav-item {{ ativo == 'painel' ? 'active' : '' }}">
        <i class="bi bi-speedometer2"></i><span>Painel</span>
    </a>
    <a href="{{ path('cobranca_carteira_index') }}"
       class="cobranca-subnav-item {{ ativo == 'carteiras' ? 'active' : '' }}">
        <i class="bi bi-folder2-open"></i><span>Carteiras</span>
    </a>
    <a href="{{ path('cobranca_caso_index') }}"
       class="cobranca-subnav-item {{ ativo == 'casos' ? 'active' : '' }}">
        <i class="bi bi-briefcase"></i><span>Casos</span>
    </a>
    <a href="{{ path('cobranca_alertas') }}"
       class="cobranca-subnav-item {{ ativo == 'alertas' ? 'active' : '' }}">
        <i class="bi bi-bell"></i><span>Alertas</span>
    </a>
