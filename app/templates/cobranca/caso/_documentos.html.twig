{# File-manager de documentos do Caso (Onda 8C) — reusa o public/js/pasta-arquivos.js SEM editá-lo,
   servindo o MESMO contrato data-*/JSON via rotas de Cobrança. Só monta o gerenciador de ESCRITA para
   quem tem resources.cobranca.gerenciar; leitor puro vê uma lista read-only com download. #}
{% if podeGerenciarDocumentos %}
<div class="fm" id="fileManager"
     data-pasta-id="{{ casoId }}"
     data-url-upload="{{ path('cobranca_documento_upload', {id: casoId}) }}"
     data-csrf-upload="{{ csrf_token('cobranca_documento_upload_' ~ casoId) }}"
     data-url-criar-secao="{{ path('cobranca_secao_criar', {id: casoId}) }}"
     data-csrf-criar-secao="{{ csrf_token('cobranca_secao_criar_' ~ casoId) }}"
     data-url-reordenar-secoes="{{ path('cobranca_secoes_reordenar', {id: casoId}) }}"
     data-csrf-reordenar-secoes="{{ csrf_token('reordenar_secoes_cobranca_' ~ casoId) }}"
     data-url-reordenar-docs="{{ path('cobranca_documentos_reordenar', {id: casoId}) }}"
     data-csrf-reordenar-docs="{{ csrf_token('reordenar_docs_cobranca_' ~ casoId) }}"
     data-url-renomear-tpl="{{ path('cobranca_secao_renomear', {secaoId: '__ID__'}) }}"
     data-url-excluir-tpl="{{ path('cobranca_secao_excluir', {secaoId: '__ID__'}) }}">

    <div class="fm-toolbar">
        <nav class="fm-breadcrumb" aria-label="{{ 'cobranca_objeto.documentos.nav_pastas'|trans }}">
            <button type="button" class="fm-crumb" data-nav="root"><i class="bi bi-folder2-open"></i> {{ 'cobranca_objeto.documentos.documentos'|trans }}</button>
            <span class="fm-crumb-sep fm-oculto" id="fmCrumbSep"><i class="bi bi-chevron-right"></i></span>
            <span class="fm-crumb-atual fm-oculto" id="fmCrumbAtual"></span>
        </nav>
        <div class="fm-busca">
            <i class="bi bi-search"></i>
            <input type="search" id="fmBusca" placeholder="{{ 'cobranca_objeto.documentos.buscar_placeholder'|trans }}" autocomplete="off" aria-label="{{ 'cobranca_objeto.documentos.buscar'|trans }}">
        </div>
        <div class="fm-acoes">
            <button type="button" class="btn btn-sm btn-primary" id="fmNovaPasta"><i class="bi bi-folder-plus me-1"></i> {{ 'cobranca_objeto.documentos.nova_pasta'|trans }}</button>
            <button type="button" class="btn btn-sm btn-outline-primary" id="fmUpload"><i class="bi bi-upload me-1"></i> {{ 'cobranca_objeto.documentos.enviar'|trans }}</button>
            <input type="file" id="fmFileInput" multiple class="d-none" accept=".png,.jpg,.jpeg,.pdf,.kml,.xml,.xls,.xlsx,.doc,.docx,.txt,.zip,.mp3,.ogg,.opus,.m4a,.mp4,.mov">
            <div class="fm-view-toggle" role="group" aria-label="{{ 'cobranca_objeto.documentos.modo_exibicao'|trans }}">
                <button type="button" class="fm-view-btn ativo" data-view="lista" title="{{ 'cobranca_objeto.documentos.lista'|trans }}" aria-label="{{ 'cobranca_objeto.documentos.lista'|trans }}"><i class="bi bi-list-ul"></i></button>
                <button type="button" class="fm-view-btn" data-view="grade" title="{{ 'cobranca_objeto.documentos.grade'|trans }}" aria-label="{{ 'cobranca_objeto.documentos.grade'|trans }}"><i class="bi bi-grid-3x3-gap-fill"></i></button>
            </div>
            <select class="fm-select" id="fmOrdenar" aria-label="{{ 'cobranca_objeto.documentos.ordenar'|trans }}">
                <option value="manual">{{ 'cobranca_objeto.documentos.ordem.manual'|trans }}</option>
                <option value="nome">{{ 'cobranca_objeto.documentos.ordem.nome'|trans }}</option>
                <option value="nome_desc">{{ 'cobranca_objeto.documentos.ordem.nome_desc'|trans }}</option>
                <option value="data_desc">{{ 'cobranca_objeto.documentos.ordem.data_desc'|trans }}</option>
                <option value="data">{{ 'cobranca_objeto.documentos.ordem.data'|trans }}</option>
                <option value="tamanho_desc">{{ 'cobranca_objeto.documentos.ordem.tamanho_desc'|trans }}</option>
                <option value="tamanho">{{ 'cobranca_objeto.documentos.ordem.tamanho'|trans }}</option>
            </select>
        </div>
    </div>

    <div class="fm-upload-bar" id="fmUploadBar">
        <i class="bi bi-cloud-arrow-up"></i>
        <span class="fm-upload-nome" id="fmUploadNome"></span>
        <div class="progress" role="progressbar" aria-label="{{ 'cobranca_objeto.documentos.progresso'|trans }}"><div class="progress-bar" id="fmUploadProgresso" style="width:0%"></div></div>
        <span class="text-muted small text-nowrap" id="fmUploadContador"></span>
    </div>

    <div class="fm-body" id="fmBody">
        {# Pastas (seções) — só na raiz #}
        <div class="fm-grupo" id="fmGrupoPastas">
            <div class="fm-grupo-titulo"><i class="bi bi-folder2"></i> {{ 'cobranca_objeto.documentos.pastas'|trans }}</div>
            <div class="fm-pastas" id="fmPastas">
                {% for secao in secoes %}
                    <div class="fm-pasta" data-secao-id="{{ secao.id }}" data-nome="{{ secao.nome|e('html_attr') }}"
                         data-url-renomear="{{ path('cobranca_secao_renomear', {secaoId: secao.id}) }}"
                         data-csrf-renomear="{{ csrf_token('cobranca_secao_renomear_' ~ secao.id) }}"
                         data-url-excluir="{{ path('cobranca_secao_excluir', {secaoId: secao.id}) }}"
                         data-csrf-excluir="{{ csrf_token('cobranca_secao_excluir_' ~ secao.id) }}"
                         tabindex="0" role="button" aria-label="{{ 'cobranca_objeto.documentos.abrir_pasta'|trans({nome: secao.nome}) }}">
                        <span class="fm-pasta-grip" title="{{ 'cobranca_objeto.documentos.arrastar'|trans }}"><i class="bi bi-grip-vertical"></i></span>
                        <span class="fm-pasta-icone"><i class="bi bi-folder-fill"></i></span>
                        <span class="fm-pasta-info">
                            <span class="fm-pasta-nome">{{ secao.nome }}</span>
                            <span class="fm-pasta-contagem" data-secao-contagem="{{ secao.id }}">{{ (secao.total == 1 ? 'cobranca_objeto.documentos.arquivo_contagem' : 'cobranca_objeto.documentos.arquivos_contagem')|trans({n: secao.total ~ ''}) }}</span>
                        </span>
                        <div class="dropdown">
                            <button class="fm-pasta-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'cobranca_objeto.documentos.acoes_pasta'|trans }}" onclick="event.stopPropagation()"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button class="dropdown-item fm-pasta-abrir" type="button"><i class="bi bi-folder2-open me-2"></i>{{ 'cobranca_objeto.documentos.abrir'|trans }}</button></li>
                                <li><button class="dropdown-item fm-pasta-renomear" type="button"><i class="bi bi-pencil me-2"></i>{{ 'cobranca_objeto.documentos.renomear'|trans }}</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger fm-pasta-excluir" type="button"><i class="bi bi-trash me-2"></i>{{ 'cobranca_objeto.documentos.excluir'|trans }}</button></li>
                            </ul>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Arquivos #}
        <div class="fm-grupo" id="fmGrupoArquivos">
            <div class="fm-grupo-titulo"><i class="bi bi-files"></i> <span id="fmArquivosTitulo">{{ 'cobranca_objeto.documentos.arquivos'|trans }}</span></div>
            <div class="fm-arquivos fm-lista" id="fmArquivos">
                <div class="fm-lista-head">
                    <span class="fmh-grip"></span><span>{{ 'cobranca_objeto.documentos.coluna.nome'|trans }}</span><span class="fmh-tipo">{{ 'cobranca_objeto.documentos.coluna.categoria'|trans }}</span>
                    <span class="fmh-tam">{{ 'cobranca_objeto.documentos.coluna.tamanho'|trans }}</span><span class="fmh-data">{{ 'cobranca_objeto.documentos.coluna.modificado'|trans }}</span><span class="fmh-acoes"></span>
                </div>
                {% for item in arquivosFm %}
                    {% set doc = item.doc %}
                    {% set ic = arquivo_icone(doc.nomeOriginal, doc.mimeType) %}
                    <div class="fm-arquivo" data-secao="{{ item.secao }}" data-doc-id="{{ doc.id }}" data-ordem="{{ doc.ordem }}"
                         data-nome="{{ doc.nomeOriginal|e('html_attr') }}" data-tamanho="{{ doc.tamanhoBytes }}"
                         data-data="{{ doc.carregadoEm|date('Y-m-d H:i:s') }}" data-tipo="{{ ic.rotulo|e('html_attr') }}"
                         data-mime="{{ doc.mimeType|e('html_attr') }}"
                         data-url-mover="{{ path('cobranca_documento_mover', {docId: doc.id}) }}"
                         data-csrf-mover="{{ csrf_token('cobranca_doc_mover_' ~ doc.id) }}">
                        <span class="fm-arq-grip" title="{{ 'cobranca_objeto.documentos.arrastar'|trans }}"><i class="bi bi-grip-vertical"></i></span>
                        <div class="fm-arq-principal">
                            <span class="fm-arq-icone"><i class="bi {{ ic.icone }}" style="color: {{ ic.cor }}"></i></span>
                            <span class="text-truncate">
                                <a href="{{ path('cobranca_documento_download', {docId: doc.id}) }}" target="_blank" rel="noopener noreferrer" class="fm-arq-nome" title="{{ doc.nomeOriginal|e('html_attr') }}">{{ doc.nomeOriginal }}</a>
                                <span class="fm-arq-sub">{{ doc.descricao ?? '' }}</span>
                            </span>
                        </div>
                        <div class="fm-arq-tipo"><span class="fm-badge-cat">{{ doc.categoriaLabel }}</span></div>
                        <div class="fm-arq-tam">{{ doc.tamanhoBytes|formatar_bytes }}</div>
                        <div class="fm-arq-data">{{ doc.carregadoEm|date('d/m/Y') }}</div>
                        <div class="fm-arq-acoes">
                            <div class="dropdown">
                                <button class="fm-arq-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'cobranca_objeto.documentos.acoes_arquivo'|trans }}"><i class="bi bi-three-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('cobranca_documento_download', {docId: doc.id}) }}" target="_blank" rel="noopener"><i class="bi bi-download me-2"></i>{{ 'cobranca_objeto.documentos.baixar'|trans }}</a></li>
                                    <li><button type="button" class="dropdown-item fm-arq-mover"><i class="bi bi-folder-symlink me-2"></i>{{ 'cobranca_objeto.documentos.mover_para'|trans }}</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="{{ path('cobranca_documento_excluir', {docId: doc.id}) }}" onsubmit="return confirm('{{ 'cobranca_objeto.documentos.confirmar_excluir'|trans|e('js') }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_documento_cobranca_' ~ doc.id) }}">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>{{ 'cobranca_objeto.documentos.excluir'|trans }}</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="fm-vazio fm-oculto" id="fmArquivosVazio">
                <div class="fm-vazio-icone"><i class="bi bi-cloud-arrow-up"></i></div>
                <div class="fm-vazio-titulo">{{ 'cobranca_objeto.documentos.vazio_titulo'|trans }}</div>
                <div class="fm-vazio-dica">{{ 'cobranca_objeto.documentos.vazio_dica.inicio'|trans }} <strong>{{ 'cobranca_objeto.documentos.enviar'|trans }}</strong>{{ 'cobranca_objeto.documentos.vazio_dica.fim'|trans }}</div>
                {# Chips do desenho Objeto 1A (aba Documentos, área vazia, L424-429): dica visual do que
                   costuma entrar aqui, com o texto e a ordem do desenho. NÃO são as categorias do enum
                   (`CategoriaDocumentoCobranca`) nem filtro: não classificam nem recortam nada. #}
                <div class="fm-vazio-categorias" aria-label="{{ 'cobranca_objeto.documentos.exemplos'|trans }}">
                    {% for exemplo in ['cobranca_objeto.documentos.exemplo.boletos'|trans, 'cobranca_objeto.documentos.exemplo.notificacoes'|trans, 'cobranca_objeto.documentos.exemplo.acordos_assinados'|trans, 'cobranca_objeto.documentos.exemplo.comprovantes'|trans] %}
                    <span class="fm-vazio-categoria">{{ exemplo }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>{# /fm-body #}
</div>{# /fm #}

{# Modal reutilizável de texto (nova pasta / renomear) #}
<div class="modal fade" id="fmInputModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="fmInputTitulo">{{ 'cobranca_objeto.documentos.nova_pasta'|trans }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button></div>
            <div class="modal-body">
                <input type="text" class="form-control" id="fmInputCampo" maxlength="255" placeholder="{{ 'cobranca_objeto.documentos.nome_pasta_placeholder'|trans }}">
                <div class="text-danger small mt-1 d-none" id="fmInputErro"></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button><button type="button" class="btn btn-primary" id="fmInputConfirmar">{{ 'cobranca_objeto.documentos.salvar'|trans }}</button></div>
        </div>
    </div>
</div>

{# Modal mover arquivo para pasta #}
<div class="modal fade" id="fmMoverModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-folder-symlink me-1"></i> {{ 'cobranca_objeto.documentos.mover_para'|trans }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button></div>
            <div class="modal-body"><div class="list-group" id="fmMoverLista"></div></div>
        </div>
    </div>
</div>

{% else %}
    {# Modo leitura: quem não gerencia vê a lista com download, sem o file-manager de escrita. #}
    {% if arquivosFm|length > 0 %}
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th class="ps-3">{{ 'cobranca_objeto.documentos.coluna.nome'|trans }}</th><th>{{ 'cobranca_objeto.documentos.coluna.categoria'|trans }}</th><th class="text-end">{{ 'cobranca_objeto.documentos.coluna.tamanho'|trans }}</th><th style="width:110px">{{ 'cobranca_objeto.documentos.coluna.data'|trans }}</th></tr></thead>
            <tbody>
                {% for item in arquivosFm %}
                {% set doc = item.doc %}
                <tr>
                    <td class="ps-3 align-middle"><a href="{{ path('cobranca_documento_download', {docId: doc.id}) }}" target="_blank" rel="noopener">{{ doc.nomeOriginal }}</a></td>
                    <td class="align-middle">{{ doc.categoriaLabel }}</td>
                    <td class="align-middle text-end">{{ doc.tamanhoBytes|formatar_bytes }}</td>
                    <td class="align-middle">{{ doc.carregadoEm|date('d/m/Y') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="text-center text-muted py-4"><i class="bi bi-folder2-open fs-3 d-block mb-2"></i>{{ 'cobranca_objeto.documentos.leitura_vazio'|trans }}</div>
    {% endif %}
{% endif %}
