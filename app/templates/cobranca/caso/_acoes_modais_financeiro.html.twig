{# Modais financeiros do Caso (Onda 8B-D). Só renderizados para quem tem a capacidade
   `resources.cobranca.movimentacao_financeira` (separada de gerenciar) e num caso NÃO encerrado; o
   gate real é no controller. Registrar/corrigir pagamento e registrar liquidação. #}

{# ── Registrar pagamento (alocações dinâmicas entre obrigações exigíveis) ── #}
<div class="modal fade" id="modalRegistrarPagamento" tabindex="-1" aria-labelledby="tituloRegistrarPagamento" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.registrarPagamento, {action: path('cobranca_pagamento_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarPagamento"><i class="bi bi-cash-coin me-1"></i>Registrar pagamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" data-pagamento-modal
                 data-previa-url="{{ path('cobranca_pagamento_previa', {id: caso.id}) }}">
                {{ form_row(forms.registrarPagamento.data) }}
                {{ form_row(forms.registrarPagamento.valorPago) }}
                {# Prévia ao vivo da divisão dívida/honorários + FIFO (Ajuste 6). Preenchida por JS. #}
                <div class="previa-pagamento small bg-body-tertiary border rounded p-2 mb-2 d-none" data-previa-pagamento></div>
                {{ form_row(forms.registrarPagamento.alocarManualmente) }}
                <div class="alocacao-manual d-none" data-alocacao-manual>
                    <hr>
                    <label class="form-label">Alocações do pagamento</label>
                    <div id="alocacoesPagamentoContainer"
                         data-prototype="{{ form_widget(forms.registrarPagamento.alocacoes.vars.prototype)|e('html_attr') }}"
                         data-index="{{ forms.registrarPagamento.alocacoes|length }}">
                        {% for alocacao in forms.registrarPagamento.alocacoes %}
                        <div class="alocacao-linha border rounded p-2 mb-2">{{ form_widget(alocacao) }}
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">Remover</button>
                        </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(forms.registrarPagamento.alocacoes) }}
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addAlocacaoPagamento"><i class="bi bi-plus-lg me-1"></i>Adicionar alocação</button>
                </div>
                <div class="form-text">O sistema distribui o pagamento automaticamente pela dívida mais antiga (FIFO); os honorários são calculados à parte. Marque <strong>Alocar manualmente</strong> para distribuir você mesmo.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar pagamento</button>
            </div>
            {{ form_end(forms.registrarPagamento) }}
        </div>
    </div>
</div>

{# ── Corrigir pagamento (modal reutilizável; JS injeta action + contexto da linha) ── #}
<div class="modal fade" id="modalCorrigirPagamento" tabindex="-1" aria-labelledby="tituloCorrigirPagamento" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.corrigirPagamento, {attr: {id: 'formCorrigirPagamento'}}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloCorrigirPagamento"><i class="bi bi-pencil-square me-1"></i>Corrigir pagamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" data-pagamento-modal>
                <div class="alert alert-warning small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>A correção <strong>reescreve</strong> a composição do pagamento (sem estorno) e fica registrada na auditoria.</div>
                </div>
                <p class="text-muted small mb-3" data-pagamento-contexto>Pagamento selecionado.</p>
                {{ form_row(forms.corrigirPagamento.data) }}
                {{ form_row(forms.corrigirPagamento.valorPago) }}
                {# Prévia ao vivo (Ajuste 6): a URL depende do pagamento, injetada por JS ao abrir. #}
                <div class="previa-pagamento small bg-body-tertiary border rounded p-2 mb-2 d-none" data-previa-pagamento></div>
                {{ form_row(forms.corrigirPagamento.alocarManualmente) }}
                <div class="alocacao-manual d-none" data-alocacao-manual>
                    <hr>
                    <label class="form-label">Alocações do pagamento</label>
                    <div id="alocacoesCorrigirContainer"
                         data-prototype="{{ form_widget(forms.corrigirPagamento.alocacoes.vars.prototype)|e('html_attr') }}"
                         data-index="{{ forms.corrigirPagamento.alocacoes|length }}">
                        {% for alocacao in forms.corrigirPagamento.alocacoes %}
                        <div class="alocacao-linha border rounded p-2 mb-2">{{ form_widget(alocacao) }}
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">Remover</button>
                        </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(forms.corrigirPagamento.alocacoes) }}
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addAlocacaoCorrigir"><i class="bi bi-plus-lg me-1"></i>Adicionar alocação</button>
                </div>
                <div class="form-text">Por padrão a nova composição é distribuída automaticamente (FIFO). Marque <strong>Alocar manualmente</strong> para distribuir você mesmo.</div>
                {{ form_row(forms.corrigirPagamento.motivoCorrecao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Corrigir pagamento</button>
            </div>
            {{ form_end(forms.corrigirPagamento) }}
        </div>
    </div>
</div>

{# ── Excluir recebimento (modal reutilizável; JS injeta action, token CSRF e contexto da linha) ── #}
<div class="modal fade" id="modalExcluirPagamento" tabindex="-1" aria-labelledby="tituloExcluirPagamento" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="formExcluirPagamento">
                <input type="hidden" name="_token" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloExcluirPagamento"><i class="bi bi-trash me-1"></i>Excluir recebimento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Excluir definitivamente o recebimento de <strong data-pagamento-total-excluir></strong> de <strong data-pagamento-data-excluir></strong>?</p>
                    <div class="alert alert-warning small d-flex align-items-start gap-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>O valor <strong>volta ao saldo devedor</strong> e a obrigação que ele quitou volta a ser cobrada, com os juros correndo de novo. A exclusão fica registrada no histórico.</div>
                    </div>
                    <label class="form-label" for="motivoExcluirPagamento">Motivo <span class="text-muted fw-normal">(opcional)</span></label>
                    <input type="text" name="motivo" id="motivoExcluirPagamento" class="form-control" maxlength="255" placeholder="Ex.: recebimento lançado em duplicidade">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Excluir recebimento</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ── Registrar liquidação não monetária ──────────────────────────── #}
<div class="modal fade" id="modalRegistrarLiquidacao" tabindex="-1" aria-labelledby="tituloRegistrarLiquidacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.registrarLiquidacao, {action: path('cobranca_liquidacao_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarLiquidacao"><i class="bi bi-box-seam me-1"></i>Registrar liquidação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.registrarLiquidacao.tipo) }}
                {{ form_row(forms.registrarLiquidacao.descricaoBem) }}
                {{ form_row(forms.registrarLiquidacao.valorAtribuidoBem) }}
                <div class="form-text mb-2">O valor do bem é opcional e pode diferir do reconhecido.</div>
                {{ form_row(forms.registrarLiquidacao.valorReconhecido) }}
                <div class="form-text mb-2">O valor reconhecido é o que reduz o saldo exigível da dívida.</div>
                {{ form_row(forms.registrarLiquidacao.data) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar liquidação</button>
            </div>
            {{ form_end(forms.registrarLiquidacao) }}
        </div>
    </div>
</div>
