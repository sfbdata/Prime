{# Modais financeiros do Caso (Onda 8B-D). Só renderizados para quem tem a capacidade
   `resources.cobranca.movimentacao_financeira` (separada de gerenciar) e num caso NÃO encerrado; o
   gate real é no controller. Registrar/corrigir pagamento e registrar liquidação. #}

{# ── Registrar pagamento (alocações dinâmicas entre obrigações exigíveis) ── #}
<div class="modal fade" id="modalRegistrarPagamento" tabindex="-1" aria-labelledby="tituloRegistrarPagamento" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.registrarPagamento, {action: path('cobranca_pagamento_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarPagamento"><i class="bi bi-cash-coin me-1"></i>{{ 'cobranca_objeto.financeiro.registrar_pagamento'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
            </div>
            <div class="modal-body" data-pagamento-modal
                 data-previa-url="{{ path('cobranca_pagamento_previa', {id: caso.id}) }}">
                {{ form_row(forms.registrarPagamento.data) }}
                {{ form_row(forms.registrarPagamento.valorPago) }}
                {# Prévia ao vivo da divisão dívida/honorários + FIFO (Ajuste 6). Preenchida por JS. #}
                <div class="previa-pagamento small bg-body-tertiary border rounded p-2 mb-2 d-none" data-previa-pagamento></div>
                {{ form_row(forms.registrarPagamento.alocarManualmente) }}
                <div class="alocacao-manual d-none" data-alocacao-manual>
                    <hr>
                    <label class="form-label">{{ 'cobranca_objeto.financeiro.alocacoes'|trans }}</label>
                    <div id="alocacoesPagamentoContainer"
                         data-prototype="{{ form_widget(forms.registrarPagamento.alocacoes.vars.prototype)|e('html_attr') }}"
                         data-index="{{ forms.registrarPagamento.alocacoes|length }}">
                        {% for alocacao in forms.registrarPagamento.alocacoes %}
                        <div class="alocacao-linha border rounded p-2 mb-2">{{ form_widget(alocacao) }}
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">{{ 'cobranca_objeto.financeiro.remover'|trans }}</button>
                        </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(forms.registrarPagamento.alocacoes) }}
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addAlocacaoPagamento"><i class="bi bi-plus-lg me-1"></i>{{ 'cobranca_objeto.financeiro.adicionar_alocacao'|trans }}</button>
                </div>
                <div class="form-text">{{ 'cobranca_objeto.financeiro.registrar_ajuda.inicio'|trans }} <strong>{{ 'cobranca_objeto.financeiro.alocar_manualmente'|trans }}</strong> {{ 'cobranca_objeto.financeiro.alocar_manualmente_fim'|trans }}</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ 'cobranca_objeto.financeiro.registrar_pagamento'|trans }}</button>
            </div>
            {{ form_end(forms.registrarPagamento) }}
        </div>
    </div>
</div>

{# ── Corrigir pagamento (modal reutilizável; JS injeta action + contexto da linha) ── #}
<div class="modal fade" id="modalCorrigirPagamento" tabindex="-1" aria-labelledby="tituloCorrigirPagamento" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.corrigirPagamento, {attr: {id: 'formCorrigirPagamento'}}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloCorrigirPagamento"><i class="bi bi-pencil-square me-1"></i>{{ 'cobranca_objeto.financeiro.corrigir_pagamento'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
            </div>
            <div class="modal-body" data-pagamento-modal>
                <div class="alert alert-warning small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>{{ 'cobranca_objeto.financeiro.corrigir_aviso.inicio'|trans }} <strong>{{ 'cobranca_objeto.financeiro.corrigir_aviso.reescreve'|trans }}</strong> {{ 'cobranca_objeto.financeiro.corrigir_aviso.fim'|trans }}</div>
                </div>
                <p class="text-muted small mb-3" data-pagamento-contexto>{{ 'cobranca_objeto.financeiro.pagamento_selecionado'|trans }}</p>
                {{ form_row(forms.corrigirPagamento.data) }}
                {{ form_row(forms.corrigirPagamento.valorPago) }}
                {# Prévia ao vivo (Ajuste 6): a URL depende do pagamento, injetada por JS ao abrir. #}
                <div class="previa-pagamento small bg-body-tertiary border rounded p-2 mb-2 d-none" data-previa-pagamento></div>
                {{ form_row(forms.corrigirPagamento.alocarManualmente) }}
                <div class="alocacao-manual d-none" data-alocacao-manual>
                    <hr>
                    <label class="form-label">{{ 'cobranca_objeto.financeiro.alocacoes'|trans }}</label>
                    <div id="alocacoesCorrigirContainer"
                         data-prototype="{{ form_widget(forms.corrigirPagamento.alocacoes.vars.prototype)|e('html_attr') }}"
                         data-index="{{ forms.corrigirPagamento.alocacoes|length }}">
                        {% for alocacao in forms.corrigirPagamento.alocacoes %}
                        <div class="alocacao-linha border rounded p-2 mb-2">{{ form_widget(alocacao) }}
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">{{ 'cobranca_objeto.financeiro.remover'|trans }}</button>
                        </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(forms.corrigirPagamento.alocacoes) }}
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addAlocacaoCorrigir"><i class="bi bi-plus-lg me-1"></i>{{ 'cobranca_objeto.financeiro.adicionar_alocacao'|trans }}</button>
                </div>
                <div class="form-text">{{ 'cobranca_objeto.financeiro.corrigir_ajuda.inicio'|trans }} <strong>{{ 'cobranca_objeto.financeiro.alocar_manualmente'|trans }}</strong> {{ 'cobranca_objeto.financeiro.alocar_manualmente_fim'|trans }}</div>
                {{ form_row(forms.corrigirPagamento.motivoCorrecao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ 'cobranca_objeto.financeiro.corrigir_pagamento'|trans }}</button>
            </div>
            {{ form_end(forms.corrigirPagamento) }}
        </div>
    </div>
</div>

{# ── Excluir recebimento (modal reutilizável; JS injeta action, token CSRF e contexto da linha) ── #}
<div class="modal fade" id="modalExcluirPagamento" tabindex="-1" aria-labelledby="tituloExcluirPagamento" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="formExcluirPagamento">
                <input type="hidden" name="_token" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloExcluirPagamento"><i class="bi bi-trash me-1"></i>{{ 'cobranca_objeto.financeiro.excluir_recebimento'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">{{ 'cobranca_objeto.financeiro.excluir_pergunta.inicio'|trans }} <strong data-pagamento-total-excluir></strong> {{ 'cobranca_objeto.financeiro.excluir_pergunta.meio'|trans }} <strong data-pagamento-data-excluir></strong>{{ 'cobranca_objeto.financeiro.excluir_pergunta.fim'|trans }}</p>
                    <div class="alert alert-warning small d-flex align-items-start gap-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>{{ 'cobranca_objeto.financeiro.excluir_aviso.inicio'|trans }} <strong>{{ 'cobranca_objeto.financeiro.excluir_aviso.volta'|trans }}</strong> {{ 'cobranca_objeto.financeiro.excluir_aviso.fim'|trans }}</div>
                    </div>
                    <label class="form-label" for="motivoExcluirPagamento">{{ 'cobranca_objeto.financeiro.motivo'|trans }} <span class="text-muted fw-normal">{{ 'cobranca_objeto.financeiro.opcional'|trans }}</span></label>
                    <input type="text" name="motivo" id="motivoExcluirPagamento" class="form-control" maxlength="255" placeholder="{{ 'cobranca_objeto.financeiro.motivo_placeholder'|trans }}">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>{{ 'cobranca_objeto.financeiro.excluir_recebimento'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ── Registrar liquidação não monetária ──────────────────────────── #}
<div class="modal fade" id="modalRegistrarLiquidacao" tabindex="-1" aria-labelledby="tituloRegistrarLiquidacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.registrarLiquidacao, {action: path('cobranca_liquidacao_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarLiquidacao"><i class="bi bi-box-seam me-1"></i>{{ 'cobranca_objeto.financeiro.registrar_liquidacao'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.registrarLiquidacao.tipo) }}
                {{ form_row(forms.registrarLiquidacao.descricaoBem) }}
                {{ form_row(forms.registrarLiquidacao.valorAtribuidoBem) }}
                <div class="form-text mb-2">{{ 'cobranca_objeto.financeiro.valor_bem_ajuda'|trans }}</div>
                {{ form_row(forms.registrarLiquidacao.valorReconhecido) }}
                <div class="form-text mb-2">{{ 'cobranca_objeto.financeiro.valor_reconhecido_ajuda'|trans }}</div>
                {{ form_row(forms.registrarLiquidacao.data) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ 'cobranca_objeto.financeiro.registrar_liquidacao'|trans }}</button>
            </div>
            {{ form_end(forms.registrarLiquidacao) }}
        </div>
    </div>
</div>
