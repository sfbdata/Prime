{# ───────────────────────────────────────────────────────────────────────────
   Fragmento trocável da lista de Casos (dentro de [data-filtro-resultado]).
   Reexecutado a cada filtro/página por public/js/filtro-tabela.js.
   Recebe Output DTOs (CasoResumoOutput), nunca entidades cruas. Saldo já derivado.
─────────────────────────────────────────────────────────────────────────── #}
{% set temFiltro = filtros.busca or filtros.status or filtros.carteira %}

<div class="cobranca-resultado-head">
    <div class="cobranca-count">
        <i class="bi bi-briefcase"></i> <strong>{{ total }}</strong>&nbsp;{{ 'cobranca_objeto.casos.contagem'|trans }}
    </div>
    {{ include('_partials/_filtro_paginacao.html.twig', { pagina: pagina, total_paginas: total_paginas }) }}
</div>

{% if casos|length > 0 %}
    <div class="card cobranca-card d-none d-md-block">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-3"><i class="bi bi-box-seam me-1"></i>{{ 'cobranca_objeto.casos.coluna.objeto'|trans }}</th>
                        <th><i class="bi bi-person me-1"></i>{{ 'cobranca_objeto.casos.coluna.pessoa_cobrada'|trans }}</th>
                        <th><i class="bi bi-folder2 me-1"></i>{{ 'cobranca_objeto.casos.coluna.carteira'|trans }}</th>
                        <th style="width:130px"><i class="bi bi-flag me-1"></i>{{ 'cobranca_objeto.casos.coluna.estado'|trans }}</th>
                        <th class="text-end" style="width:130px"><i class="bi bi-cash me-1"></i>{{ 'cobranca_objeto.casos.coluna.saldo_exigivel'|trans }}</th>
                        <th class="text-end" style="width:120px"><i class="bi bi-exclamation-circle me-1"></i>{{ 'cobranca_objeto.casos.coluna.vencido'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for caso in casos %}
                    <tr class="cobranca-row-link{{ caso.temVencido ? ' cobranca-row-vencido' : '' }}" style="cursor:pointer;" data-href="{{ path('cobranca_caso_show', {id: caso.id}) }}">
                        <td class="ps-3 align-middle">
                            <span class="fw-semibold">{{ caso.objetoIdentificacao }}</span>
                            {% if caso.objetoDescricao %}<div class="text-muted small text-truncate" style="max-width:280px;">{{ caso.objetoDescricao }}</div>{% endif %}
                        </td>
                        <td class="align-middle">{{ caso.pessoaCobradaNome }}</td>
                        <td class="align-middle text-muted">{{ caso.carteiraNome }}</td>
                        <td class="align-middle">
                            <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
                            {% if caso.prontoParaEncerrar %}<span class="badge text-bg-success ms-1" data-bs-toggle="tooltip" title="{{ 'cobranca_objeto.casos.pronto_dica'|trans }}">{{ 'cobranca_objeto.casos.pronto'|trans }}</span>{% endif %}
                        </td>
                        <td class="align-middle text-end fw-semibold">{{ caso.saldoExigivel|centavos }}</td>
                        <td class="align-middle text-end {{ caso.temVencido ? 'text-danger fw-semibold' : 'text-muted' }}">{{ caso.saldoVencido|centavos }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-md-none cobranca-cards-lista">
        {% for caso in casos %}
        <div class="cobranca-card-item{{ caso.temVencido ? ' cobranca-row-vencido' : '' }}" style="cursor:pointer;" onclick="window.location.href='{{ path('cobranca_caso_show', {id: caso.id}) }}'">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="cobranca-card-title"><i class="bi bi-box-seam me-1"></i>{{ caso.objetoIdentificacao }}</div>
                <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
            </div>
            <div class="cobranca-card-sub text-muted">{{ caso.pessoaCobradaNome }} · {{ caso.carteiraNome }}</div>
            <div class="mt-1 d-flex justify-content-between">
                <span>{{ 'cobranca_objeto.casos.exigivel'|trans }} <strong>{{ caso.saldoExigivel|centavos }}</strong></span>
                {% if caso.temVencido %}<span class="text-danger">{{ 'cobranca_objeto.casos.vencido_valor'|trans({valor: caso.saldoVencido|centavos}) }}</span>{% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
{% else %}
    <div class="card cobranca-card">
        <div class="cobranca-empty">
            <div class="empty-ico"><i class="bi bi-briefcase"></i></div>
            {% if temFiltro %}
                <p class="empty-title">{{ 'cobranca_objeto.casos.vazio_filtro_titulo'|trans }}</p>
                <p class="text-muted small mb-0">{{ 'cobranca_objeto.casos.vazio_filtro_texto'|trans }}</p>
            {% else %}
                <p class="empty-title">{{ 'cobranca_objeto.casos.vazio_titulo'|trans }}</p>
                <p class="text-muted small mb-0">{{ 'cobranca_objeto.casos.vazio_texto'|trans }}</p>
            {% endif %}
        </div>
    </div>
{% endif %}

<script>
(function () {
    if (typeof bootstrap === 'undefined') { return; }
    document.querySelectorAll('.cobrancas-page [data-bs-toggle="tooltip"]').forEach(function (el) {
        bootstrap.Tooltip.getOrCreateInstance(el);
    });
})();
</script>
