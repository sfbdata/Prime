{# Modais de mutação do Caso (Onda 8B). Só renderizados para quem tem a capacidade de gerenciar
   cobranças; o gate real é no controller. Cada fatia da 8B acrescenta seus modais aqui. #}

{# Bloco de encargos por-obrigação (taxa por-obrigação, espelho R$↔%), compartilhado pelos modais de
   REGISTRAR e EDITAR obrigação. Espera no contexto: `formEncargos` (a view do form, Task 8: por encargo
   um trio `modo{Encargo}`/`{encargo}Bp`/`{encargo}Reais`), `honorarioComposta` (base resolvida do caso —
   Ajuste 2) e `carenciaHonorariosCaso` (carência do caso, em dias — herdada; não há UI de override de
   carência por-obrigação nesta entrega, YAGNI da spec §11).

   Cada encargo é um TRIO: "%" (`jp-taxa-pct`) e "R$" (`jp-taxa-reais`) são os DOIS campos reais do Form —
   qualquer um dos dois pode ser digitado, o outro é preview (JS em `show.html.twig`); o hidden `modo`
   (`jp-taxa-modo`) diz ao servidor qual foi editado por último ('herda'|'percent'|'reais',
   `ConversorTaxaEncargo`, Task 5/7). Deixar os dois vazios = herdar a taxa do caso; a obrigação NUNCA
   congela ao registrar/editar (D6, ao-vivo). #}
{% macro camposEncargos(formEncargos, honorarioComposta = true, carenciaHonorariosCaso = 0) %}
<hr class="my-3">
<h6 class="fw-semibold mb-1">Encargos reconhecidos</h6>
<div class="form-text mb-3">
    Informe o percentual <em>ou</em> o valor em reais — um espelha o outro enquanto você digita; quem
    grava a taxa final (à data de hoje) é o servidor. Juros, multa e correção incidem sobre o
    <strong>valor original</strong>; o <strong>honorário</strong> incide sobre
    {{ honorarioComposta ? 'a base composta (valor + juros + multa + correção)' : 'o valor original (principal)' }}.
    Deixe os dois campos <strong>vazios</strong> para <strong>herdar</strong> a configuração do caso —
    a obrigação nunca congela ao registrar ou editar.
</div>
{# TODO(humano): a spec de encargos ao-vivo propõe estender o bloqueio do campo R$ também a multa/correção
   e à janela de tolerância (juros/multa) — extensão PROPOSTA, ainda NÃO ratificada. Hoje só juros
   (`dias==0`, não vencida) e honorários (dentro da carência) ficam com o R$ bloqueado (spec §5). Se
   aprovado, replicar o mesmo padrão (`data-encargo` + `aplicarBorda` em show.html.twig). #}
<div class="jp-encargos-wrap" data-dias="0" data-carencia="{{ carenciaHonorariosCaso ?? 0 }}">
{% for encargo in [
    {'campo': 'juros', 'rotulo': 'Juros', 'base': 'valorOriginal'},
    {'campo': 'multa', 'rotulo': 'Multa', 'base': 'valorOriginal'},
    {'campo': 'correcao', 'rotulo': 'Correção', 'base': 'valorOriginal'},
    {'campo': 'honorarios', 'rotulo': 'Honorários', 'base': honorarioComposta ? 'composta' : 'valorOriginal'}
] %}
    {% set bpCampo = encargo.campo ~ 'Bp' %}
    {% set reaisCampo = encargo.campo ~ 'Reais' %}
    {% set modoCampo = 'modo' ~ (encargo.campo|capitalize) %}
    <div class="row g-2 mb-3 jp-encargo" data-encargo="{{ encargo.campo }}" data-base="{{ encargo.base }}">
        {{ form_widget(attribute(formEncargos, modoCampo), {'attr': {'class': 'jp-taxa-modo'}}) }}
        <div class="col-5">
            <label class="form-label" for="{{ attribute(formEncargos, bpCampo).vars.id }}">{{ encargo.rotulo }} (%)</label>
            <div class="input-group">
                {{ form_widget(attribute(formEncargos, bpCampo), {'attr': {'class': 'form-control jp-taxa-pct'}}) }}
                <span class="input-group-text">%</span>
            </div>
            {{ form_errors(attribute(formEncargos, bpCampo)) }}
        </div>
        <div class="col-7">
            <label class="form-label" for="{{ attribute(formEncargos, reaisCampo).vars.id }}">{{ encargo.rotulo }} (R$)</label>
            <div class="input-group">
                {{ form_widget(attribute(formEncargos, reaisCampo), {'attr': {'class': 'form-control jp-taxa-reais'}}) }}
                <span class="input-group-text">R$</span>
            </div>
            {{ form_errors(attribute(formEncargos, reaisCampo)) }}
            <div class="d-flex align-items-center justify-content-between mt-1">
                <small class="text-muted jp-taxa-herda">herda do caso</small>
                <button type="button" class="btn btn-link btn-sm p-0 jp-taxa-limpar"
                        aria-label="Limpar {{ encargo.rotulo }} e voltar a herdar do caso">Limpar (herdar)</button>
            </div>
        </div>
    </div>
{% endfor %}
</div>
{% endmacro %}

{# Macro do próprio template: no Twig 3 chamar via `_self` exige o import explícito. #}
{% import _self as blocoEncargos %}

{# ── Registrar obrigação ─────────────────────────────────────────── #}
<div class="modal fade" id="modalRegistrarObrigacao" tabindex="-1" aria-labelledby="tituloRegistrarObrigacao" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.registrarObrigacao, {action: path('cobranca_obrigacao_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarObrigacao"><i class="bi bi-plus-circle me-1"></i>Registrar obrigação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.registrarObrigacao.descricao) }}
                {{ form_row(forms.registrarObrigacao.valorOriginal) }}
                {{ form_row(forms.registrarObrigacao.vencimentoOriginal) }}
                {{ form_row(forms.registrarObrigacao.referenciaExterna) }}
                {{ blocoEncargos.camposEncargos(forms.registrarObrigacao, caso.baseHonorariosComposta, caso.carenciaHonorariosDias) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar</button>
            </div>
            {{ form_end(forms.registrarObrigacao) }}
        </div>
    </div>
</div>

{# ── Editar obrigação (modal reutilizável; JS injeta action + pré-preenche os campos da linha) ── #}
{# `data-preenche-ao-abrir`: este modal é repreenchido campo a campo pelos `data-*` da linha a cada
   abertura, então não pode ser limpo ao fechar — limpá-lo apagaria a reidratação do B5, que chega
   pelo servidor justamente quando o `show` não tem `relatedTarget`. O de "Nova obrigação" não tem a
   marca, e por isso é limpo. #}
<div class="modal fade" id="modalEditarObrigacao" data-preenche-ao-abrir tabindex="-1" aria-labelledby="tituloEditarObrigacao" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.editarObrigacao, {attr: {id: 'formEditarObrigacao'}}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarObrigacao"><i class="bi bi-pencil-square me-1"></i>Editar obrigação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Correção de cadastro — informe o motivo. O saldo se ajusta automaticamente.</p>
                {# F5 (spec §12): quando a obrigação já recebeu pagamento, mudar o valor pode deixar o
                   recebido sobrando ou faltando. Nasce escondido (`d-none`) e o JS de show.html.twig o
                   revela conforme o `data-tem-pagamento` do botão "Editar" da linha — o modal é
                   reutilizável (1 por página), então o gatilho tem de vir do item clicado, não do render. #}
                <div class="alert alert-info small d-flex align-items-start gap-2 mb-3 d-none" data-aviso-reconciliar>
                    <i class="bi bi-info-circle-fill"></i>
                    <div>Esta obrigação já recebeu pagamento. Se você <strong>alterar o valor</strong>, o valor
                        recebido pode ficar sobrando ou faltando — nesse caso, ajuste-o depois em
                        <strong>Corrigir pagamento</strong>, no extrato de movimentos.</div>
                </div>
                {{ form_row(forms.editarObrigacao.descricao) }}
                {{ form_row(forms.editarObrigacao.valorOriginal) }}
                {{ form_row(forms.editarObrigacao.vencimentoOriginal) }}
                {{ form_row(forms.editarObrigacao.referenciaExterna) }}
                {{ blocoEncargos.camposEncargos(forms.editarObrigacao, caso.baseHonorariosComposta, caso.carenciaHonorariosDias) }}
                <hr class="my-3">
                {{ form_row(forms.editarObrigacao.motivo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar correção</button>
            </div>
            {{ form_end(forms.editarObrigacao) }}
        </div>
    </div>
</div>

{# ── Excluir obrigação (modal reutilizável; CSRF manual — JS injeta action + token + descrição) ── #}
<div class="modal fade" id="modalExcluirObrigacao" tabindex="-1" aria-labelledby="tituloExcluirObrigacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="formExcluirObrigacao">
                <input type="hidden" name="_token" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloExcluirObrigacao"><i class="bi bi-trash me-1"></i>Excluir obrigação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Excluir definitivamente <strong data-obrigacao-descricao></strong>? Esta ação não pode ser desfeita.</p>
                    <label class="form-label" for="motivoExcluirObrigacao">Motivo da exclusão</label>
                    <input type="text" name="motivo" id="motivoExcluirObrigacao" class="form-control" maxlength="255" required placeholder="Ex.: obrigação lançada em duplicidade">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Excluir</button>
                </div>
            </form>
        </div>
    </div>
</div>

