{# Modais de mutação do Caso (Onda 8B). Só renderizados para quem tem a capacidade de gerenciar
   cobranças; o gate real é no controller. Cada fatia da 8B acrescenta seus modais aqui. #}

{# ── Registrar obrigação ─────────────────────────────────────────── #}
<div class="modal fade" id="modalRegistrarObrigacao" tabindex="-1" aria-labelledby="tituloRegistrarObrigacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.registrarObrigacao, {action: path('cobranca_obrigacao_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarObrigacao"><i class="bi bi-plus-circle me-1"></i>Registrar obrigação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.registrarObrigacao.descricao) }}
                {{ form_row(forms.registrarObrigacao.valorOriginal) }}
                {{ form_row(forms.registrarObrigacao.vencimentoOriginal) }}
                {{ form_row(forms.registrarObrigacao.referenciaExterna) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar</button>
            </div>
            {{ form_end(forms.registrarObrigacao) }}
        </div>
    </div>
</div>

{# ── Editar obrigação (modal reutilizável; JS injeta action + pré-preenche os campos da linha) ── #}
<div class="modal fade" id="modalEditarObrigacao" tabindex="-1" aria-labelledby="tituloEditarObrigacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.editarObrigacao, {attr: {id: 'formEditarObrigacao'}}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarObrigacao"><i class="bi bi-pencil-square me-1"></i>Editar obrigação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Correção de cadastro — informe o motivo. O saldo se ajusta automaticamente.</p>
                {{ form_row(forms.editarObrigacao.descricao) }}
                {{ form_row(forms.editarObrigacao.valorOriginal) }}
                {{ form_row(forms.editarObrigacao.vencimentoOriginal) }}
                {{ form_row(forms.editarObrigacao.referenciaExterna) }}
                {{ form_row(forms.editarObrigacao.encargosReconhecidos) }}
                {{ form_row(forms.editarObrigacao.motivo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar correção</button>
            </div>
            {{ form_end(forms.editarObrigacao) }}
        </div>
    </div>
</div>

{# ── Excluir obrigação (modal reutilizável; CSRF manual — JS injeta action + token + descrição) ── #}
<div class="modal fade" id="modalExcluirObrigacao" tabindex="-1" aria-labelledby="tituloExcluirObrigacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="formExcluirObrigacao">
                <input type="hidden" name="_token" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloExcluirObrigacao"><i class="bi bi-trash me-1"></i>Excluir obrigação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Excluir definitivamente <strong data-obrigacao-descricao></strong>? Esta ação não pode ser desfeita.</p>
                    <label class="form-label" for="motivoExcluirObrigacao">Motivo da exclusão</label>
                    <input type="text" name="motivo" id="motivoExcluirObrigacao" class="form-control" maxlength="255" required placeholder="Ex.: obrigação lançada em duplicidade">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Excluir</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ── Encerrar caso ───────────────────────────────────────────────── #}
<div class="modal fade" id="modalEncerrarCaso" tabindex="-1" aria-labelledby="tituloEncerrarCaso" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.encerrarCaso, {action: path('cobranca_caso_encerrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEncerrarCaso"><i class="bi bi-flag me-1"></i>Encerrar caso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>O encerramento só é aceito com o <strong>saldo exigível zerado</strong> (invariável 17). A judicialização não impede encerrar.</div>
                </div>
                {{ form_row(forms.encerrarCaso.observacao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-flag me-1"></i>Encerrar caso</button>
            </div>
            {{ form_end(forms.encerrarCaso) }}
        </div>
    </div>
</div>

{# ── Definir próxima ação ────────────────────────────────────────── #}
<div class="modal fade" id="modalDefinirAcao" tabindex="-1" aria-labelledby="tituloDefinirAcao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.definirProximaAcao, {action: path('cobranca_acao_definir', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloDefinirAcao"><i class="bi bi-flag me-1"></i>Definir próxima ação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.definirProximaAcao.descricao) }}
                {{ form_row(forms.definirProximaAcao.prazo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Definir</button>
            </div>
            {{ form_end(forms.definirProximaAcao) }}
        </div>
    </div>
</div>

{# ── Concluir ação (só quando há ação pendente) ──────────────────── #}
{% if caso.proximaAcao and caso.proximaAcao.pendente %}
<div class="modal fade" id="modalConcluirAcao" tabindex="-1" aria-labelledby="tituloConcluirAcao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.concluirAcao, {action: path('cobranca_acao_concluir', {id: caso.proximaAcao.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloConcluirAcao"><i class="bi bi-check2-circle me-1"></i>Concluir ação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">{{ caso.proximaAcao.descricao }}</p>
                {{ form_row(forms.concluirAcao.resultado) }}
                <hr class="my-3">
                <p class="small text-muted mb-2">Se já quiser encadear a próxima ação (opcional):</p>
                {{ form_row(forms.concluirAcao.proximaDescricao) }}
                {{ form_row(forms.concluirAcao.proximoPrazo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Concluir</button>
            </div>
            {{ form_end(forms.concluirAcao) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Alterar pessoa cobrada ──────────────────────────────────────── #}
<div class="modal fade" id="modalAlterarPessoa" tabindex="-1" aria-labelledby="tituloAlterarPessoa" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.alterarPessoa, {action: path('cobranca_caso_alterar_pessoa', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloAlterarPessoa"><i class="bi bi-arrow-left-right me-1"></i>Alterar pessoa cobrada</h5>
