{# ── Editar honorários do caso (Ajuste 2, Fatia A) ─────────────────
   Config de honorários do caso âncora (forma/%/base/carência). Ao salvar, o UseCase recalcula na hora
   os honorários das obrigações automáticas (não congeladas) deste caso e passa a valer para o rateio
   do "Receber" (D-A2-3/D-A2-6). Modal dedicado (action fixo); B5 reabre com o digitado se der erro. #}
<div class="modal fade" id="modalEditarConfigCaso" tabindex="-1" aria-labelledby="tituloEditarConfigCaso" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.editarConfigCaso, {action: path('cobranca_caso_editar_config', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarConfigCaso"><i class="bi bi-percent me-1"></i>Editar honorários do caso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>Alterar os honorários aqui <strong>recalcula na hora</strong> os honorários das obrigações
                        automáticas (não congeladas) deste caso e passa a valer também para o rateio do
                        <strong>Receber</strong>. As obrigações congeladas não são tocadas.</div>
                </div>
                {{ form_errors(forms.editarConfigCaso) }}
                <div class="mb-3">
                    <label class="form-label" for="{{ forms.editarConfigCaso.formaHonorarios.vars.id }}">{{ forms.editarConfigCaso.formaHonorarios.vars.label }}</label>
                    {{ form_widget(forms.editarConfigCaso.formaHonorarios) }}
                    {{ form_errors(forms.editarConfigCaso.formaHonorarios) }}
                </div>
                <div class="mb-3">
                    <label class="form-label" for="{{ forms.editarConfigCaso.percentualHonorarios.vars.id }}">{{ forms.editarConfigCaso.percentualHonorarios.vars.label }}</label>
                    <div class="input-group">
                        {{ form_widget(forms.editarConfigCaso.percentualHonorarios) }}
                        <span class="input-group-text">%</span>
                    </div>
                    {{ form_errors(forms.editarConfigCaso.percentualHonorarios) }}
                </div>
                {{ form_row(forms.editarConfigCaso.baseHonorarios) }}
                <div class="mb-3">
                    <label class="form-label" for="{{ forms.editarConfigCaso.carenciaHonorariosDias.vars.id }}">{{ forms.editarConfigCaso.carenciaHonorariosDias.vars.label }}</label>
                    <div class="input-group">
                        {{ form_widget(forms.editarConfigCaso.carenciaHonorariosDias) }}
                        <span class="input-group-text">dias</span>
                    </div>
                    {{ form_errors(forms.editarConfigCaso.carenciaHonorariosDias) }}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn jp-btn-accent"><i class="bi bi-check-lg me-1"></i>Salvar honorários</button>
            </div>
            {{ form_end(forms.editarConfigCaso) }}
        </div>
    </div>
</div>
