{# ── Judicializar caso (só com o módulo pastas: forms.judicializar existe) ──────────────────────────
   Spec `docs/specs/cobranca-judicializar-cria-pasta.md`. O modal ABRE PREENCHIDO e o botão principal
   CRIA a pasta: o cliente é o responsável principal do caso e a ação é `AÇÃO MONITÓRIA` (a de todos
   os casos de cobrança). Os dois campos são editáveis — o gestor vê antes de criar.

   Vincular uma pasta EXISTENTE continua possível, no bloco de baixo. O modo é um `radio` de verdade,
   então o caminho secundário funciona SEM JavaScript — que era o que um bloco escondido por JS não
   daria.

   ⚠️ O grupo do modo é renderizado INTEIRO, com `form_row`. Renderizar só um dos rádios deixa o
   `modo` como campo não-renderizado, e aí o `form_end` reimprime o grupo completo no rodapé do
   formulário — os dois rádios apareceriam duas vezes. #}
{% if forms.judicializar is defined %}
<div class="modal fade" id="modalJudicializar" tabindex="-1" aria-labelledby="tituloJudicializar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.judicializar, {action: path('cobranca_caso_judicializar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloJudicializar"><i class="bi bi-bank me-1"></i>{{ 'cobranca_objeto.modais.judicializar.titulo'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>{{ 'cobranca_objeto.modais.judicializar.aviso.inicio'|trans }} <strong>{{ 'cobranca_objeto.modais.judicializar.aviso.nao_encerra'|trans }}</strong> {{ 'cobranca_objeto.modais.judicializar.aviso.fim'|trans }}</div>
                </div>

                <div class="cob-judicializar-modo mb-3">{{ form_row(forms.judicializar.modo) }}</div>

                <div class="cob-judicializar-criar" data-modo-bloco="criar">
                    {{ form_row(forms.judicializar.nomeCliente) }}
                    {{ form_row(forms.judicializar.nomeAcao) }}

                    {# O cadastro do cliente principal depende de a ficha ter CPF. Dizer isso aqui evita
                       a pergunta "por que esta pasta ficou sem cliente e a outra não" — a resposta é o
                       dado que falta na ficha, não a operação. #}
                    <p class="small text-secondary mb-0">
                        {% if caso.pessoaCobradaCpf %}
                            <i class="bi bi-person-check me-1"></i>{{ 'cobranca_objeto.modais.judicializar.com_cpf.inicio'|trans({nome: caso.pessoaCobradaNome}) }} <strong>{{ 'cobranca_objeto.modais.judicializar.com_cpf.cliente_principal'|trans }}</strong>{{ 'cobranca_objeto.modais.judicializar.com_cpf.fim'|trans }}
                        {% else %}
                            <i class="bi bi-info-circle me-1"></i>{{ 'cobranca_objeto.modais.judicializar.sem_cpf'|trans({nome: caso.pessoaCobradaNome}) }}
                        {% endif %}
                    </p>
                </div>

                <hr class="my-3" data-modo-separador>

                {# Busca no lugar do antigo `<select>` com TODAS as pastas do escritório (1.099 em
                   produção, rotuladas só pelo número). O id escolhido vai no campo oculto; a lista
                   vem do servidor conforme se digita. #}
                <div class="cob-judicializar-vincular" data-modo-bloco="vincular">
                    <label class="form-label" for="buscarPastaJudicial">{{ 'cobranca_objeto.modais.judicializar.pasta_judicial'|trans }}</label>
                    <div data-buscar-pasta
                         data-url="{{ path('cobranca_pastas_buscar') }}">
                        <input type="text" id="buscarPastaJudicial" class="form-control"
                               placeholder="{{ 'cobranca_objeto.modais.judicializar.buscar_placeholder'|trans }}"
                               autocomplete="off" data-buscar-pasta-campo>
                        <div class="cob-buscar-pasta-resultados list-group mt-1 d-none" data-buscar-pasta-lista></div>
                        <p class="small text-secondary mb-0 mt-1" data-buscar-pasta-escolhida hidden></p>
                    </div>
                    {{ form_widget(forms.judicializar.pastaId) }}
                    {{ form_errors(forms.judicializar.pastaId) }}
                    <p class="small text-secondary mb-0">{{ 'cobranca_objeto.modais.judicializar.so_usada.inicio'|trans }} <strong>{{ 'cobranca_objeto.modais.judicializar.so_usada.vincular'|trans }}</strong> {{ 'cobranca_objeto.modais.judicializar.so_usada.fim'|trans }}</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ 'cobranca_objeto.modais.judicializar.botao'|trans }}</button>
            </div>
            {{ form_end(forms.judicializar) }}
        </div>
    </div>
</div>
{% endif %}

