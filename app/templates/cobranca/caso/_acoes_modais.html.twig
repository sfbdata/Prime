{# Modais de mutação do Caso (Onda 8B). Só renderizados para quem tem a capacidade de gerenciar
   cobranças; o gate real é no controller. Cada fatia da 8B acrescenta seus modais aqui. #}

{# Bloco de encargos separados (F4, spec §11), compartilhado pelos modais de REGISTRAR e EDITAR
   obrigação. Espera no contexto: `formEncargos` (a view do form) e `prefixoEncargos` (o prefixo dos
   ids, só para dar um id único ao input de % de cada modal — os dois modais coexistem na página).

   Cada encargo é um par lado a lado: o "%" à esquerda e o R$ à direita. O R$ é o campo do Form — é ele
   que é submetido, validado e reidratado pelo B5. O "%" é auxiliar: NÃO tem `name`, nunca chega ao
   servidor, e o JS o deriva do R$ sobre o valor original ao abrir o modal. Duas fontes de verdade sobre
   dinheiro divergiriam por arredondamento; aqui só existe uma. #}
{% macro camposEncargos(formEncargos, prefixoEncargos, honorarioComposta = true) %}
<hr class="my-3">
<h6 class="fw-semibold mb-1">Encargos reconhecidos</h6>
<div class="form-text mb-3">
    Informe o percentual <em>ou</em> o valor em reais — um preenche o outro. Juros, multa e correção
    incidem sobre o <strong>valor original</strong>; o <strong>honorário</strong> incide sobre
    {{ honorarioComposta ? 'a base composta (valor + juros + multa + correção)' : 'o valor original (principal)' }}.
    Ao gravar juros, multa ou correção a obrigação fica <strong>congelada</strong>: o cálculo automático
    diário para de atualizá-la. Deixe o honorário <strong>vazio</strong> para calculá-lo automaticamente;
    ao digitar, a obrigação congela.
</div>

{# Cada encargo carrega a PRÓPRIA base do espelho %↔R$: juros/multa/correção sobre o valor original; o
   honorário sobre a base RESOLVIDA do caso (Ajuste 2) — composta (`valor+juros+multa+correção`, o JS de
   `initEspelhoEncargos` soma os quatro) ou principal (`valorOriginal`, campo único). Sem isto, um % de
   honorário digitado numa carteira de base Principal viraria R$ sobre a base errada (achado da auditoria).
   O `?int $honorarios` (Form sem `empty_data`) mapeia campo vazio para `null` = automático; qualquer valor
   digitado = override + congela. #}
{% for encargo in [
    {'campo': 'juros', 'rotulo': 'Juros', 'base': 'valorOriginal'},
    {'campo': 'multa', 'rotulo': 'Multa', 'base': 'valorOriginal'},
    {'campo': 'correcao', 'rotulo': 'Correção', 'base': 'valorOriginal'},
    {'campo': 'honorarios', 'rotulo': 'Honorários', 'base': honorarioComposta ? 'composta' : 'valorOriginal'}
] %}
    <div class="row g-2 mb-3">
        <div class="col-5">
            <label class="form-label" for="{{ prefixoEncargos }}_{{ encargo.campo }}_pct">{{ encargo.rotulo }} (%)</label>
            <div class="input-group">
                <input type="text" class="form-control" inputmode="decimal"
                       id="{{ prefixoEncargos }}_{{ encargo.campo }}_pct"
                       data-encargo-pct="{{ encargo.campo }}" data-encargo-base="{{ encargo.base }}"
                       autocomplete="off">
                <span class="input-group-text">%</span>
            </div>
        </div>
        <div class="col-7">
            <label class="form-label" for="{{ attribute(formEncargos, encargo.campo).vars.id }}">{{ encargo.rotulo }} (R$)</label>
            <div class="input-group">
                {{ form_widget(attribute(formEncargos, encargo.campo)) }}
                <span class="input-group-text">R$</span>
            </div>
            {{ form_errors(attribute(formEncargos, encargo.campo)) }}
        </div>
    </div>
{% endfor %}
{% endmacro %}

{# Macro do próprio template: no Twig 3 chamar via `_self` exige o import explícito. #}
{% import _self as blocoEncargos %}

{# ── Registrar obrigação ─────────────────────────────────────────── #}
<div class="modal fade" id="modalRegistrarObrigacao" tabindex="-1" aria-labelledby="tituloRegistrarObrigacao" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.registrarObrigacao, {action: path('cobranca_obrigacao_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarObrigacao"><i class="bi bi-plus-circle me-1"></i>Registrar obrigação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.registrarObrigacao.descricao) }}
                {{ form_row(forms.registrarObrigacao.valorOriginal) }}
                {{ form_row(forms.registrarObrigacao.vencimentoOriginal) }}
                {{ form_row(forms.registrarObrigacao.referenciaExterna) }}
                {{ blocoEncargos.camposEncargos(forms.registrarObrigacao, 'registrarObrigacao', caso.baseHonorariosComposta) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar</button>
            </div>
            {{ form_end(forms.registrarObrigacao) }}
        </div>
    </div>
</div>

{# ── Editar obrigação (modal reutilizável; JS injeta action + pré-preenche os campos da linha) ── #}
{# `data-preenche-ao-abrir`: este modal é repreenchido campo a campo pelos `data-*` da linha a cada
   abertura, então não pode ser limpo ao fechar — limpá-lo apagaria a reidratação do B5, que chega
   pelo servidor justamente quando o `show` não tem `relatedTarget`. O de "Nova obrigação" não tem a
   marca, e por isso é limpo. #}
<div class="modal fade" id="modalEditarObrigacao" data-preenche-ao-abrir tabindex="-1" aria-labelledby="tituloEditarObrigacao" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.editarObrigacao, {attr: {id: 'formEditarObrigacao'}}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarObrigacao"><i class="bi bi-pencil-square me-1"></i>Editar obrigação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Correção de cadastro — informe o motivo. O saldo se ajusta automaticamente.</p>
                {# F5 (spec §12): quando a obrigação já recebeu pagamento, mudar o valor pode deixar o
                   recebido sobrando ou faltando. Nasce escondido (`d-none`) e o JS de show.html.twig o
                   revela conforme o `data-tem-pagamento` do botão "Editar" da linha — o modal é
                   reutilizável (1 por página), então o gatilho tem de vir do item clicado, não do render. #}
                <div class="alert alert-info small d-flex align-items-start gap-2 mb-3 d-none" data-aviso-reconciliar>
                    <i class="bi bi-info-circle-fill"></i>
                    <div>Esta obrigação já recebeu pagamento. Se você <strong>alterar o valor</strong>, o valor
                        recebido pode ficar sobrando ou faltando — nesse caso, ajuste-o depois em
                        <strong>Corrigir pagamento</strong>, no extrato de movimentos.</div>
                </div>
                {{ form_row(forms.editarObrigacao.descricao) }}
                {{ form_row(forms.editarObrigacao.valorOriginal) }}
                {{ form_row(forms.editarObrigacao.vencimentoOriginal) }}
                {{ form_row(forms.editarObrigacao.referenciaExterna) }}
                {{ blocoEncargos.camposEncargos(forms.editarObrigacao, 'editarObrigacao', caso.baseHonorariosComposta) }}
                <hr class="my-3">
                {{ form_row(forms.editarObrigacao.motivo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar correção</button>
            </div>
            {{ form_end(forms.editarObrigacao) }}
        </div>
    </div>
</div>

{# ── Excluir obrigação (modal reutilizável; CSRF manual — JS injeta action + token + descrição) ── #}
<div class="modal fade" id="modalExcluirObrigacao" tabindex="-1" aria-labelledby="tituloExcluirObrigacao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="formExcluirObrigacao">
                <input type="hidden" name="_token" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloExcluirObrigacao"><i class="bi bi-trash me-1"></i>Excluir obrigação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Excluir definitivamente <strong data-obrigacao-descricao></strong>? Esta ação não pode ser desfeita.</p>
                    <label class="form-label" for="motivoExcluirObrigacao">Motivo da exclusão</label>
                    <input type="text" name="motivo" id="motivoExcluirObrigacao" class="form-control" maxlength="255" required placeholder="Ex.: obrigação lançada em duplicidade">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Excluir</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ── Encerrar caso ───────────────────────────────────────────────── #}
<div class="modal fade" id="modalEncerrarCaso" tabindex="-1" aria-labelledby="tituloEncerrarCaso" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.encerrarCaso, {action: path('cobranca_caso_encerrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEncerrarCaso"><i class="bi bi-flag me-1"></i>Encerrar caso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>O encerramento só é aceito com o <strong>saldo exigível zerado</strong> (invariável 17). A judicialização não impede encerrar.</div>
                </div>
                {{ form_row(forms.encerrarCaso.observacao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-flag me-1"></i>Encerrar caso</button>
            </div>
            {{ form_end(forms.encerrarCaso) }}
        </div>
    </div>
</div>

{# ── Definir próxima ação ────────────────────────────────────────── #}
<div class="modal fade" id="modalDefinirAcao" tabindex="-1" aria-labelledby="tituloDefinirAcao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.definirProximaAcao, {action: path('cobranca_acao_definir', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloDefinirAcao"><i class="bi bi-flag me-1"></i>Definir próxima ação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.definirProximaAcao.descricao) }}
                {{ form_row(forms.definirProximaAcao.prazo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Definir</button>
            </div>
            {{ form_end(forms.definirProximaAcao) }}
        </div>
    </div>
</div>

{# ── Concluir ação (só quando há ação pendente) ──────────────────── #}
{% if caso.proximaAcao and caso.proximaAcao.pendente %}
<div class="modal fade" id="modalConcluirAcao" tabindex="-1" aria-labelledby="tituloConcluirAcao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.concluirAcao, {action: path('cobranca_acao_concluir', {id: caso.proximaAcao.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloConcluirAcao"><i class="bi bi-check2-circle me-1"></i>Concluir ação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">{{ caso.proximaAcao.descricao }}</p>
                {{ form_row(forms.concluirAcao.resultado) }}
                <hr class="my-3">
                <p class="small text-muted mb-2">Se já quiser encadear a próxima ação (opcional):</p>
                {{ form_row(forms.concluirAcao.proximaDescricao) }}
                {{ form_row(forms.concluirAcao.proximoPrazo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Concluir</button>
            </div>
            {{ form_end(forms.concluirAcao) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Alterar pessoa cobrada ──────────────────────────────────────── #}
<div class="modal fade" id="modalAlterarPessoa" tabindex="-1" aria-labelledby="tituloAlterarPessoa" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.alterarPessoa, {action: path('cobranca_caso_alterar_pessoa', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloAlterarPessoa"><i class="bi bi-arrow-left-right me-1"></i>Alterar pessoa cobrada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">A troca é manual e não afeta dívida, pagamentos nem acordos. Atual: <strong>{{ caso.pessoaCobradaNome }}</strong>.</p>
                {{ form_row(forms.alterarPessoa.novaPessoaCobradaId) }}
                {{ form_row(forms.alterarPessoa.motivo) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Alterar</button>
            </div>
            {{ form_end(forms.alterarPessoa) }}
        </div>
    </div>
</div>

{# ── Judicializar caso (só com o módulo pastas: forms.judicializar existe) ── #}
{% if forms.judicializar is defined %}
<div class="modal fade" id="modalJudicializar" tabindex="-1" aria-labelledby="tituloJudicializar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.judicializar, {action: path('cobranca_caso_judicializar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloJudicializar"><i class="bi bi-bank me-1"></i>Judicializar caso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>Vincula uma pasta judicial existente ao caso. A judicialização <strong>não encerra</strong> o caso — o acompanhamento financeiro continua.</div>
                </div>
                {{ form_row(forms.judicializar.pastaId) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Judicializar</button>
            </div>
            {{ form_end(forms.judicializar) }}
        </div>
    </div>
</div>
{% endif %}

{# ── Registrar contato de cobrança ───────────────────────────────── #}
<div class="modal fade" id="modalRegistrarTentativa" tabindex="-1" aria-labelledby="tituloRegistrarTentativa" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(forms.registrarTentativa, {action: path('cobranca_tentativa_registrar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloRegistrarTentativa"><i class="bi bi-telephone me-1"></i>Registrar contato</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(forms.registrarTentativa.dataContato) }}
                {{ form_row(forms.registrarTentativa.canal) }}
                {{ form_row(forms.registrarTentativa.resultado) }}
                {{ form_row(forms.registrarTentativa.observacao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar</button>
            </div>
            {{ form_end(forms.registrarTentativa) }}
        </div>
    </div>
</div>

{# ── Criar acordo (obrigações substituídas + parcelas dinâmicas) ──── #}
<div class="modal fade" id="modalCriarAcordo" tabindex="-1" aria-labelledby="tituloCriarAcordo" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.acordoCriar, {action: path('cobranca_acordo_criar', {id: caso.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloCriarAcordo"><i class="bi bi-file-earmark-text me-1"></i>Criar acordo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" id="corpoCriarAcordo">
                {{ form_row(forms.acordoCriar.dataAcordo) }}
                <div class="mb-3">
                    <label class="form-label">Obrigações substituídas</label>
                    {# Ajuste 9 (INV-I): só DÍVIDA ORIGINAL é oferecida — parcela de acordo vigente não pode ser
                       renegociada aqui. Lista vazia significa que tudo já está dentro de um acordo: sem este
                       aviso o gestor veria um espaço em branco sem explicação. #}
                    {% if forms.acordoCriar.obrigacoesSubstituidasIds.vars.choices is empty %}
                        <div class="alert alert-warning py-2 mb-0 small" role="alert">
                            <i class="bi bi-info-circle me-1"></i>Não há dívidas disponíveis para acordo neste caso.
                            Se já existe um acordo vigente, rompa-o primeiro: as dívidas originais voltam ao saldo
                            e poderão ser acordadas de novo.
                        </div>
                    {% else %}
                        {{ form_widget(forms.acordoCriar.obrigacoesSubstituidasIds) }}
                        {{ form_errors(forms.acordoCriar.obrigacoesSubstituidasIds) }}
                        {# Ajuste 10 (spec §5.3): renegociar dívida já parcialmente paga é legítimo (D7), mas o
                           gestor precisa SABER que há pagamento — a substituída sai do exigível levando a
                           alocação junto, então o valor sugerido é o REMANESCENTE. O JS revela quando alguma
                           marcada tem `data-alocado-centavos > 0`. #}
                        <div class="alert alert-warning d-none py-2 small" id="avisoAcordoComPagamento">
                            <i class="bi bi-info-circle me-1"></i>
                            Uma das dívidas escolhidas <strong>já recebeu pagamento</strong>. O valor sugerido é o que
                            <strong>ainda falta</strong> — não o valor original.
                        </div>
                        <div class="form-text">As obrigações escolhidas saem do saldo exigível e passam a ser cobradas pelas parcelas. Total selecionado: <strong data-acordo-total-selecionado>R$ 0,00</strong>.</div>
                        <div class="form-text">Só dívidas originais podem ser acordadas. Parcelas de um acordo vigente não aparecem aqui — para refazer um acordo, rompa o atual primeiro.</div>
                    {% endif %}
                </div>
                <hr>
                {# ── Gerador de parcelamento (Ajuste 7) ── #}
                <div class="row g-2 align-items-end mb-1" data-acordo-gerador>
                    <div class="col-sm-6 col-md-4">{{ form_row(forms.acordoCriar.valorTotalNegociado) }}</div>
                    <div class="col-sm-6 col-md-4">{{ form_row(forms.acordoCriar.valorEntrada) }}</div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label" for="acordoQtdParcelas">Nº de parcelas</label>
                        <input type="number" min="1" step="1" value="1" class="form-control" id="acordoQtdParcelas">
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label" for="acordoData1">1º vencimento</label>
                        <input type="date" class="form-control" id="acordoData1">
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label" for="acordoPeriodicidade">Periodicidade</label>
                        <select class="form-select" id="acordoPeriodicidade">
                            <option value="mensal">Mensal</option>
                            <option value="quinzenal">Quinzenal</option>
                            <option value="semanal">Semanal</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100" id="acordoGerar"><i class="bi bi-magic me-1"></i>Gerar parcelas</button>
                    </div>
                </div>
                <div class="form-text">Informe o total negociado (desconto/juros ajustam) e a entrada; gere as parcelas e edite o que precisar. Ao mudar o valor de uma parcela, as demais se redistribuem.</div>
                <div class="small text-danger mt-1" data-acordo-erro-gerador></div>
                <hr>
                <label class="form-label">Parcelas do acordo</label>
                <div id="parcelasContainer"
                     data-prototype="{{ form_widget(forms.acordoCriar.parcelas.vars.prototype)|e('html_attr') }}"
                     data-index="{{ forms.acordoCriar.parcelas|length }}">
                    {% for parcela in forms.acordoCriar.parcelas %}
                    <div class="parcela-linha border rounded p-2 mb-2">{{ form_widget(parcela) }}
                        <button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">Remover</button>
                    </div>
                    {% endfor %}
                </div>
                {{ form_errors(forms.acordoCriar.parcelas) }}
                <button type="button" class="btn btn-sm btn-outline-secondary" id="addParcela"><i class="bi bi-plus-lg me-1"></i>Adicionar parcela</button>
