{% extends 'base.html.twig' %}

{% block title %}Cobranças · Caso {{ caso.objetoIdentificacao }}{% endblock %}

{% block body %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <a href="{{ path('cobranca_caso_index') }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
            <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-briefcase"></i>{{ caso.objetoIdentificacao }}</h1>
            <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
            {% if caso.prontoParaEncerrar %}<span class="badge text-bg-success" data-bs-toggle="tooltip" title="Saldo exigível zerado — o gestor pode encerrar (SPEC §17)">Pronto para encerrar</span>{% endif %}
            {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalRegistrarTentativa">
                    <i class="bi bi-telephone me-1"></i>Tentativa
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#modalGerarRevisao">
                    <i class="bi bi-person-exclamation me-1"></i>Revisão
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalEncerrarCaso">
                    <i class="bi bi-flag me-1"></i>Encerrar caso
                </button>
            </div>
            {% endif %}
        </div>
        <div class="text-muted small">
            {% if caso.objetoDescricao %}{{ caso.objetoDescricao }} · {% endif %}
            Carteira: <a href="{{ path('cobranca_carteira_show', {id: caso.carteiraId}) }}">{{ caso.carteiraNome }}</a>
            {% if caso.pastaJudicialId %} · <a href="{{ path('pasta_show', {id: caso.pastaJudicialId}) }}"><i class="bi bi-folder-symlink me-1"></i>Pasta judicial</a>{% endif %}
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Cabeçalho operacional ─────────────────────────────── #}
        <div class="caso-header mb-3">
            <div class="caso-header-top">
                <div>
                    <div class="caso-metric-label">Pessoa cobrada atual</div>
                    <p class="caso-header-titulo mb-0">{{ caso.pessoaCobradaNome }}</p>
                    <div class="caso-header-sub">
                        {% if caso.pessoaCobradaCpf %}<span data-bs-toggle="tooltip" title="CPF">{{ caso.pessoaCobradaCpf }}</span>{% endif %}
                        {% if caso.pessoaCobradaCnpj %}<span data-bs-toggle="tooltip" title="CNPJ">{{ caso.pessoaCobradaCnpj }}</span>{% endif %}
                        {% if caso.pessoaCobradaTelefone %} · <i class="bi bi-telephone"></i> {{ caso.pessoaCobradaTelefone }}{% endif %}
                        {% if caso.pessoaCobradaEmail %} · <i class="bi bi-envelope"></i> {{ caso.pessoaCobradaEmail }}{% endif %}
                    </div>
                </div>
                <div class="text-end">
                    <div class="caso-metric-label">Honorários</div>
                    <div>{{ caso.formaHonorariosLabel }}{% if caso.percentualHonorarios %} <span class="text-muted">({{ caso.percentualHonorarios }}%)</span>{% endif %}</div>
                </div>
            </div>

            <div class="caso-metrics">
                <div class="caso-metric">
                    <div class="caso-metric-label" data-bs-toggle="tooltip" title="Derivado das obrigações exigíveis menos pagamentos e liquidações (SPEC §10)">Saldo exigível</div>
                    <div class="caso-metric-valor {{ caso.saldoExigivel == 0 and not caso.encerrado ? 'saldo-zerado' : '' }}">{{ caso.saldoExigivel|centavos }}</div>
                </div>
                <div class="caso-metric">
                    <div class="caso-metric-label" data-bs-toggle="tooltip" title="Parte do saldo já vencida">Saldo vencido</div>
                    <div class="caso-metric-valor {{ caso.saldoVencido > 0 ? 'saldo-vencido' : '' }}">{{ caso.saldoVencido|centavos }}</div>
                </div>
                <div class="caso-metric flex-grow-1">
                    {% if caso.proximaAcao %}
                        <div class="caso-proxima-acao {{ caso.proximaAcao.atrasada ? 'atrasada' : '' }}">
                            <div class="caso-proxima-acao-titulo d-flex align-items-center gap-2">
                                <span><i class="bi bi-flag-fill me-1"></i>Próxima ação{% if caso.proximaAcao.atrasada %} · <span class="text-warning-emphasis">atrasada</span>{% endif %}</span>
                                {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 ms-auto" data-bs-toggle="modal" data-bs-target="#modalConcluirAcao">Concluir</button>
                                {% endif %}
                            </div>
                            <div class="fw-semibold">{{ caso.proximaAcao.descricao }}</div>
                            {% if caso.proximaAcao.prazo %}<div class="small text-muted">Prazo: {{ caso.proximaAcao.prazo|date('d/m/Y') }}{% if caso.proximaAcao.responsavelNome %} · {{ caso.proximaAcao.responsavelNome }}{% endif %}</div>{% endif %}
                        </div>
                    {% else %}
                        <div class="caso-metric-label">Próxima ação</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted"><i class="bi bi-dash-circle me-1"></i>Nenhuma ação definida</span>
                            {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
                            <button type="button" class="btn btn-sm btn-outline-primary py-0" data-bs-toggle="modal" data-bs-target="#modalDefinirAcao">Definir</button>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Alertas (derivados, read-only — SPEC §14) ─────────── #}
        {% if caso.alertas|length > 0 %}
        <div class="caso-alertas mb-3">
            {% for alerta in caso.alertas %}
            <div class="caso-alerta">
                <span class="badge {{ alerta.tipo.badgeClass }}"><i class="bi {{ alerta.tipo.icone }}"></i></span>
                <span>{{ alerta.descricao }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {# ── Revisões pendentes ────────────────────────────────── #}
        {% if caso.revisoesPendentes|length > 0 %}
        <div class="alert alert-warning d-flex align-items-start gap-2">
            <i class="bi bi-person-exclamation fs-5"></i>
            <div class="flex-grow-1">
                <strong>Revisão de pessoa cobrada pendente</strong>
                {% for r in caso.revisoesPendentes %}
                <div class="small d-flex align-items-center gap-2">
                    <span>{{ r.motivo }}</span>
                    {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
                    <button type="button" class="btn btn-sm btn-outline-primary py-0"
                            data-bs-toggle="modal" data-bs-target="#modalResolverRevisao"
                            data-acao-url="{{ path('cobranca_revisao_resolver', {id: r.id}) }}"
                            data-revisao-motivo="{{ r.motivo }}">Resolver</button>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# ── Abas ──────────────────────────────────────────────── #}
        <ul class="nav nav-tabs" id="casoTabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-obrigacoes" type="button">Obrigações <span class="badge text-bg-secondary">{{ caso.obrigacoes|length }}</span></button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-movimentos" type="button">Pagamentos & Liquidações <span class="badge text-bg-secondary">{{ caso.pagamentos|length + caso.liquidacoes|length }}</span></button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-acordos" type="button">Acordos <span class="badge text-bg-secondary">{{ caso.acordos|length }}</span></button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-documentos" type="button">Documentos</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-historico" type="button">Histórico <span class="badge text-bg-secondary">{{ caso.historico|length }}</span></button></li>
        </ul>
        <div class="tab-content border border-top-0 rounded-bottom p-3 bg-body">
            {# Obrigações #}
            <div class="tab-pane fade show active" id="tab-obrigacoes">
                {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalRegistrarObrigacao">
                        <i class="bi bi-plus-lg me-1"></i>Registrar obrigação
                    </button>
                </div>
                {% endif %}
                {% if caso.obrigacoes|length > 0 %}
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>Descrição</th><th>Vencimento</th><th class="text-end">Original</th><th class="text-end">Encargos</th><th class="text-end">Valor atual</th><th></th></tr></thead>
                    <tbody>
                    {% for o in caso.obrigacoes %}
                    <tr class="{{ o.substituidaPorAcordo ? 'text-muted' : '' }}">
                        <td>{{ o.descricao }}{% if o.referenciaExterna %} <span class="text-muted small">#{{ o.referenciaExterna }}</span>{% endif %}</td>
                        <td>{{ o.vencimentoOriginal|date('d/m/Y') }}</td>
                        <td class="text-end">{{ o.valorOriginal|centavos }}</td>
                        <td class="text-end">{{ o.encargosReconhecidos|centavos }}</td>
                        <td class="text-end fw-semibold">{{ o.valorAtual|centavos }}</td>
                        <td class="text-end">
                            {% if o.substituidaPorAcordo %}<span class="badge text-bg-secondary" data-bs-toggle="tooltip" title="Substituída por acordo vigente — fora do saldo (invariável 15)">Substituída</span>{% endif %}
                            {% if o.ehParcelaAcordo %}<span class="badge text-bg-info" data-bs-toggle="tooltip" title="Parcela de acordo">Parcela</span>{% endif %}
                            {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                    data-bs-toggle="modal" data-bs-target="#modalReconhecerValor"
                                    data-acao-url="{{ path('cobranca_obrigacao_reconhecer', {id: o.id}) }}"
                                    data-obrigacao-descricao="{{ o.descricao }}"
                                    title="Reconhecer valor atualizado">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                {% else %}<p class="text-muted mb-0 text-center py-3">Nenhuma obrigação registrada.</p>{% endif %}
            </div>

            {# Pagamentos & Liquidações #}
            <div class="tab-pane fade" id="tab-movimentos">
                <h6 class="text-muted"><i class="bi bi-cash-stack me-1"></i>Pagamentos</h6>
                {% if caso.pagamentos|length > 0 %}
                <div class="table-responsive mb-3"><table class="table table-sm mb-0">
                    <thead><tr><th>Data</th><th class="text-end">Dívida</th><th class="text-end">Encargos</th><th class="text-end">Honorários</th><th class="text-end">Total</th><th></th></tr></thead>
                    <tbody>
                    {% for p in caso.pagamentos %}
                    <tr>
                        <td>{{ p.data|date('d/m/Y') }}</td>
                        <td class="text-end">{{ p.valorDivida|centavos }}</td>
                        <td class="text-end">{{ p.valorEncargos|centavos }}</td>
                        <td class="text-end">{{ p.valorHonorarios|centavos }}</td>
                        <td class="text-end fw-semibold">{{ p.valorTotal|centavos }}</td>
                        <td>{% if p.foiCorrigido %}<span class="badge text-bg-warning" data-bs-toggle="tooltip" title="Correção sem estorno: {{ p.motivoCorrecao }}">Corrigido</span>{% endif %}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                {% else %}<p class="text-muted">Nenhum pagamento registrado.</p>{% endif %}

                <h6 class="text-muted"><i class="bi bi-box-seam me-1"></i>Liquidações não monetárias</h6>
                {% if caso.liquidacoes|length > 0 %}
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>Data</th><th>Tipo</th><th>Bem</th><th class="text-end">Reconhecido</th></tr></thead>
                    <tbody>
                    {% for l in caso.liquidacoes %}
                    <tr><td>{{ l.data|date('d/m/Y') }}</td><td>{{ l.tipoLabel }}</td><td>{{ l.descricaoBem }}</td><td class="text-end fw-semibold">{{ l.valorReconhecido|centavos }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                {% else %}<p class="text-muted mb-0">Nenhuma liquidação registrada.</p>{% endif %}
            </div>

            {# Acordos #}
            <div class="tab-pane fade" id="tab-acordos">
                {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarAcordo">
                        <i class="bi bi-plus-lg me-1"></i>Novo acordo
                    </button>
                </div>
                {% endif %}
                {% if caso.acordos|length > 0 %}
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>Data</th><th>Estado</th><th class="text-center">Obrig. substituídas</th><th class="text-center">Parcelas</th><th>Observação</th><th></th></tr></thead>
                    <tbody>
                    {% for a in caso.acordos %}
                    <tr>
                        <td>{{ a.dataAcordo|date('d/m/Y') }}</td>
                        <td><span class="badge {{ a.statusBadgeClass }}">{{ a.statusLabel }}</span></td>
                        <td class="text-center">{{ a.qtdObrigacoesSubstituidas }}</td>
                        <td class="text-center">{{ a.qtdParcelas }}</td>
                        <td class="small text-muted">{{ a.motivoRompimento ?: a.motivoCancelamento ?: '—' }}</td>
                        <td class="text-end">
                            {% if has_permission('resources.cobranca.gerenciar') and not caso.encerrado and a.ativo %}
                            <button type="button" class="btn btn-sm btn-outline-success py-0" title="Marcar cumprido"
                                    data-bs-toggle="modal" data-bs-target="#modalCumprirAcordo-{{ a.id }}"><i class="bi bi-check2-all"></i></button>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0" title="Romper"
                                    data-bs-toggle="modal" data-bs-target="#modalRomperAcordo"
                                    data-acao-url="{{ path('cobranca_acordo_romper', {id: a.id}) }}"><i class="bi bi-x-octagon"></i></button>
                            <button type="button" class="btn btn-sm btn-outline-warning py-0" title="Cancelar"
                                    data-bs-toggle="modal" data-bs-target="#modalCancelarAcordo"
                                    data-acao-url="{{ path('cobranca_acordo_cancelar', {id: a.id}) }}"><i class="bi bi-slash-circle"></i></button>
                            {# Cumprir: form inline (sem campos) com CSRF manual #}
                            <div class="modal fade" id="modalCumprirAcordo-{{ a.id }}" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog"><div class="modal-content">
                                    <form method="POST" action="{{ path('cobranca_acordo_cumprir', {id: a.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('marcar_cumprido_' ~ a.id) }}">
                                        <div class="modal-header"><h5 class="modal-title">Marcar acordo cumprido</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
                                        <div class="modal-body">Confirmar que este acordo foi integralmente cumprido? As obrigações substituídas permanecem fora do saldo.</div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-success"><i class="bi bi-check2-all me-1"></i>Confirmar</button>
                                        </div>
                                    </form>
                                </div></div>
                            </div>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                {% else %}<p class="text-muted mb-0 text-center py-3">Nenhum acordo registrado.</p>{% endif %}
            </div>

            {# Documentos (file manager religado na Onda 8C) #}
            <div class="tab-pane fade" id="tab-documentos">
                <div class="text-center text-muted py-4">
                    <i class="bi bi-folder2-open fs-3 d-block mb-2"></i>
                    Os documentos do caso serão gerenciados aqui.
                </div>
            </div>

            {# Histórico (timeline — SPEC §13) #}
            <div class="tab-pane fade" id="tab-historico">
                {% if caso.historico|length > 0 %}
                <ul class="caso-timeline">
                    {% for e in caso.historico|reverse %}
                    <li class="caso-timeline-item">
                        <div class="caso-timeline-tipo">{{ e.tipoLabel }}</div>
                        <div>{{ e.descricao }}</div>
                        <div class="caso-timeline-meta">{{ e.ocorridoEm|date('d/m/Y H:i') }}{% if e.usuarioNome %} · {{ e.usuarioNome }}{% endif %}</div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}<p class="text-muted mb-0 text-center py-3">Sem eventos no histórico.</p>{% endif %}
            </div>
        </div>
    </div>
</section>

{% if has_permission('resources.cobranca.gerenciar') %}
{{ include('cobranca/caso/_acoes_modais.html.twig') }}
{% endif %}
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof bootstrap === 'undefined') { return; }
    document.querySelectorAll('.cobrancas-page [data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });

    /* Modal reutilizável de "reconhecer valor": o botão da linha injeta a URL de ação e o contexto. */
    var modalReconhecer = document.getElementById('modalReconhecerValor');
    if (modalReconhecer) {
        modalReconhecer.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById('formReconhecerValor');
            if (form) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
            var ctx = modalReconhecer.querySelector('[data-obrigacao-contexto]');
            if (ctx) { ctx.textContent = 'Obrigação: ' + (botao.getAttribute('data-obrigacao-descricao') || ''); }
        });
    }

    /* Modal reutilizável de "resolver revisão". */
    var modalResolver = document.getElementById('modalResolverRevisao');
    if (modalResolver) {
        modalResolver.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById('formResolverRevisao');
            if (form) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
            var ctx = modalResolver.querySelector('[data-revisao-contexto]');
            if (ctx) { ctx.textContent = 'Revisão: ' + (botao.getAttribute('data-revisao-motivo') || ''); }
        });
    }

    /* Modais reutilizáveis de romper/cancelar acordo: o botão da linha injeta a URL. */
    ['modalRomperAcordo:formRomperAcordo', 'modalCancelarAcordo:formCancelarAcordo'].forEach(function (par) {
        var ids = par.split(':');
        var modal = document.getElementById(ids[0]);
        if (!modal) { return; }
        modal.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            var form = document.getElementById(ids[1]);
            if (form && botao) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
        });
    });

    /* Coleção dinâmica de parcelas do acordo (prototype do Symfony CollectionType). */
    var parcelasContainer = document.getElementById('parcelasContainer');
    var addParcela = document.getElementById('addParcela');
    if (parcelasContainer && addParcela) {
        addParcela.addEventListener('click', function () {
            var index = parseInt(parcelasContainer.dataset.index || '0', 10);
            var html = (parcelasContainer.dataset.prototype || '').replace(/__name__/g, index);
            var linha = document.createElement('div');
            linha.className = 'parcela-linha border rounded p-2 mb-2';
            linha.innerHTML = html + '<button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-parcela">Remover</button>';
            parcelasContainer.appendChild(linha);
            parcelasContainer.dataset.index = (index + 1).toString();
        });
        parcelasContainer.addEventListener('click', function (e) {
            var btn = e.target.closest('.remover-parcela');
            if (btn) { var linha = btn.closest('.parcela-linha'); if (linha) { linha.remove(); } }
        });
    }
});
</script>
{% endblock %}
