{# ───────────────────────────────────────────────────────────────────────────
   O que já entrou + acordos encerrados (Ajuste 10). Eram as abas "Pagamentos & Liquidações" e "Acordos",
   separadas por tabela do banco. Do ponto de vista do usuário é UM extrato: o que entrou nesta cobrança,
   em dinheiro ou em bem.

   Ordem INVERSA à da dívida, de propósito (spec §4.7): a dívida é uma FILA (a mais antiga primeiro, que é
   como o FIFO abate); o extrato é um EXTRATO (o último acontecimento no topo). Cada seção declara a sua
   direção no cabeçalho para que a inversão não pareça inconsistência.

   Contexto herdado do show: `caso` (CasoDetalheOutput).
─────────────────────────────────────────────────────────────────────────── #}
{% set podeMovimentar = has_permission('resources.cobranca.movimentacao_financeira') and not caso.encerrado %}

{# Fusão dos dois extratos para uma linha do tempo só. Pagamentos e liquidações já vêm `data DESC` dos
   repositórios; o sort (estável no PHP 8) só intercala. Apresentação: nenhum valor é recalculado. #}
{% set movimentos = [] %}
{% for p in caso.pagamentos %}
    {% set movimentos = movimentos|merge([{tipo: 'pagamento', data: p.data, item: p}]) %}
{% endfor %}
{% for l in caso.liquidacoes %}
    {% set movimentos = movimentos|merge([{tipo: 'liquidacao', data: l.data, item: l}]) %}
{% endfor %}
{% set movimentos = movimentos|sort((a, b) => b.data <=> a.data) %}

<div class="jp-secao" id="secao-movimentos">
    <div class="jp-secao-head">
        <h2 class="jp-secao-titulo"><i class="bi bi-arrow-down-left-circle"></i>{{ 'cobranca_objeto.movimentos.titulo'|trans }}</h2>
        <span class="jp-ordem" data-bs-toggle="tooltip"
              title="{{ 'cobranca_objeto.movimentos.ordem_dica'|trans }}">
            <i class="bi bi-sort-down"></i>{{ 'cobranca_objeto.movimentos.ordem'|trans }}
        </span>
        {% if podeMovimentar %}
        <div class="jp-secao-acoes">
            {# Ajuste pós-taxa #3 (dono): esconder os gatilhos "Registrar liquidação"/"Registrar pagamento" —
               "Receber" (por obrigação, em _divida.html.twig) é o único caminho agora. Só UI: os modais
               (#modalRegistrarLiquidacao e #modalRegistrarPagamento), controllers, rotas e UseCases seguem
               intactos e acessíveis — #modalRegistrarPagamento inclusive é reaproveitado pelo próprio
               "Receber". Reversível: descomentar devolve os dois botões.
            <button type="button" class="btn btn-sm jp-btn-outline" data-bs-toggle="modal" data-bs-target="#modalRegistrarLiquidacao">
                <i class="bi bi-box-seam me-1"></i>Registrar liquidação
            </button>
            <button type="button" class="btn btn-sm jp-btn-accent" data-bs-toggle="modal" data-bs-target="#modalRegistrarPagamento">
                <i class="bi bi-cash-coin me-1"></i>Registrar pagamento
            </button>
            #}
        </div>
        {% endif %}
    </div>

    <div class="jp-lista">
        <div class="jp-lista-head">
            <span></span>
            <span>{{ 'cobranca_objeto.movimentos.coluna.entrou_em'|trans }}</span>
            <span>{{ 'cobranca_objeto.movimentos.coluna.o_que_foi'|trans }}</span>
            <span class="col-valor">{{ 'cobranca_objeto.movimentos.coluna.valor'|trans }}</span>
            <span></span>
        </div>

        {% for m in movimentos %}
            {% if m.tipo == 'pagamento' %}
            {% set p = m.item %}
            <div class="jp-mov">
                <div class="jp-mov-ico"><i class="bi bi-cash"></i></div>
                <div class="jp-obr-data"><div class="jp-obr-data-dia">{{ p.data|date('d/m/Y') }}</div></div>
                <div class="jp-obr-desc">
                    {{ 'cobranca_objeto.movimentos.pagamento_recebido'|trans }}
                    <span class="jp-obr-sub">
                        {{ 'cobranca_objeto.movimentos.divida'|trans({valor: p.valorDivida|centavos}) }}
                        {% if p.valorEncargos > 0 %}<span class="opacity-50">|</span> {{ 'cobranca_objeto.movimentos.encargos'|trans({valor: p.valorEncargos|centavos}) }}{% endif %}
                        <span class="opacity-50">|</span> {{ 'cobranca_objeto.movimentos.honorarios'|trans({valor: p.valorHonorarios|centavos}) }}
                    </span>
                </div>
                <div class="jp-mov-valor">{{ p.valorTotal|centavos }}</div>
                <div class="jp-obr-acoes">
                    {% if p.foiCorrigido %}
                    <span class="badge text-bg-warning" data-bs-toggle="tooltip" title="{{ 'cobranca_objeto.movimentos.corrigido_dica'|trans({motivo: p.motivoCorrecao}) }}">{{ 'cobranca_objeto.movimentos.corrigido'|trans }}</span>
                    {% endif %}
                    {% if podeMovimentar %}
                    <button type="button" class="btn btn-sm jp-btn-outline py-0"
                            data-bs-toggle="modal" data-bs-target="#modalCorrigirPagamento"
                            data-acao-url="{{ path('cobranca_pagamento_corrigir', {id: p.id}) }}"
                            data-previa-url="{{ path('cobranca_pagamento_previa_corrigir', {id: p.id}) }}"
                            data-pagamento-data="{{ p.data|date('d/m/Y') }}"
                            data-pagamento-total="{{ p.valorTotal|centavos }}"
                            title="{{ 'cobranca_objeto.movimentos.corrigir_dica'|trans }}">{{ 'cobranca_objeto.movimentos.corrigir'|trans }}</button>
                    <button type="button" class="btn btn-sm jp-btn-outline py-0 text-danger"
                            data-bs-toggle="modal" data-bs-target="#modalExcluirPagamento"
                            data-acao-url="{{ path('cobranca_pagamento_excluir', {id: p.id}) }}"
                            data-token="{{ csrf_token('excluir_pagamento_' ~ p.id) }}"
                            data-pagamento-data="{{ p.data|date('d/m/Y') }}"
                            data-pagamento-total="{{ p.valorTotal|centavos }}"
                            title="{{ 'cobranca_objeto.movimentos.excluir_dica'|trans }}">{{ 'cobranca_objeto.movimentos.excluir'|trans }}</button>
                    {% endif %}
                </div>
            </div>
            {% else %}
            {% set l = m.item %}
            <div class="jp-mov">
                <div class="jp-mov-ico is-liq"><i class="bi bi-box-seam"></i></div>
                <div class="jp-obr-data"><div class="jp-obr-data-dia">{{ l.data|date('d/m/Y') }}</div></div>
                <div class="jp-obr-desc">
                    {{ 'cobranca_objeto.movimentos.liquidacao'|trans({tipo: l.tipoLabel}) }}
                    <span class="jp-obr-sub">
                        {{ l.descricaoBem }} · {{ 'cobranca_objeto.movimentos.valor_reconhecido'|trans }}{% if l.valorAtribuidoBem %} {{ 'cobranca_objeto.movimentos.bem_avaliado'|trans({valor: l.valorAtribuidoBem|centavos}) }}{% endif %}
                    </span>
                </div>
                <div class="jp-mov-valor">{{ l.valorReconhecido|centavos }}</div>
                <div class="jp-obr-acoes"></div>
            </div>
            {% endif %}
        {% else %}
            <div class="jp-vazio">
                <i class="bi bi-arrow-down-left-circle"></i>
                <div class="jp-vazio-titulo">{{ 'cobranca_objeto.movimentos.vazio_titulo'|trans }}</div>
                <p class="jp-vazio-dica">{{ 'cobranca_objeto.movimentos.vazio_dica'|trans }}</p>
            </div>
        {% endfor %}
    </div>
</div>

{# ── Acordos que não movimentam mais a dívida ────────────────────────────────
   Tudo o que não virou grupo na seção Dívida: os ROMPIDOS (as originais voltaram ao total por derivação)
   e, por segurança, qualquer acordo vigente sem parcela viva — assim nenhum acordo some da tela, como
   acontecia na aba "Acordos". O detalhe (e as ações de romper/cumprir) fica em `cobranca_acordo_show`.

   O CANCELADO não chega aqui: `MontarDetalheCasoUseCase` o filtra antes de virar Output, porque para o
   gestor ele deixou de existir (a rota dele dá 404). Sobra a linha do histórico. #}
{% set idsAgrupados = caso.gruposAcordo|map(g => g.acordoId) %}
{% set acordosEncerrados = caso.acordos|filter(a => a.id not in idsAgrupados) %}

{% if acordosEncerrados|length > 0 %}
<div class="jp-secao" id="secao-acordos-encerrados">
    <div class="jp-secao-head">
        <h2 class="jp-secao-titulo"><i class="bi bi-archive"></i>{{ 'cobranca_objeto.movimentos.acordos_encerrados'|trans }}</h2>
        <span class="text-secondary small">{{ 'cobranca_objeto.movimentos.acordos_encerrados_nota'|trans }}</span>
    </div>
    <div class="jp-lista">
        {% for a in acordosEncerrados %}
        <div class="jp-mov">
            <div class="jp-mov-ico {{ a.vigente ? '' : 'is-desfeito' }}">
                <i class="bi {{ a.vigente ? 'bi-file-earmark-text' : 'bi-x-lg' }}"></i>
            </div>
            {# Guarda obrigatória: `null|date` imprimiria HOJE. Acordo sem data mostra o traço. #}
            <div class="jp-obr-data"><div class="jp-obr-data-dia">{% if a.dataAcordo %}{{ a.dataAcordo|data }}{% else %}<span class="jp-enc-motivo d-block">{{ 'cobranca_objeto.movimentos.sem_data'|trans }}</span>{% endif %}</div></div>
            <div class="jp-obr-desc">
                {{ 'cobranca_objeto.movimentos.acordo'|trans({id: a.id ~ ''}) }}
                {# O selo de ESTADO continua sempre, e o de substituição vem AO LADO. A contábil mantém a
                   situação do acordo assumido de propósito ("Em andamento" para rastreabilidade, ou
                   "Liquidado" quando ela deu baixa) — e 20 dos 37 acordos assumidos no dado real estão
                   Cumpridos. Trocar um selo pelo outro apagaria essa informação da tela. #}
                <span class="badge {{ a.statusBadgeClass }} ms-1">{{ a.statusLabel }}</span>
                {%- if a.qtdSucessores > 0 %}
                    <span class="badge text-bg-secondary ms-1">
                        {{- a.substituidoPeloAcordoId
                            ? 'cobranca_objeto.movimentos.substituido_pelo'|trans({id: a.substituidoPeloAcordoId ~ ''})
                            : 'cobranca_objeto.movimentos.substituido_por'|trans({n: a.qtdSucessores ~ ''}) -}}
                    </span>
                {%- endif %}
                <span class="jp-obr-sub">
                    {% set motivo = a.motivoRompimento ?: a.motivoCancelamento %}
                    {% if motivo %}"{{ motivo }}" · {% endif %}
                    {{ 'cobranca_objeto.movimentos.resumo_acordo'|trans({parcelas: a.qtdParcelas ~ '', obrigacoes: a.qtdObrigacoesSubstituidas ~ ''}) }}
                    {# Os dois casos são EXCLUDENTES de propósito: um acordo desfeito devolveu as trocas ao
                       saldo, um acordo assumido tirou as parcelas dele. Como dois `if` independentes, o
                       acordo rompido E assumido exibiria as duas frases juntas, uma contradizendo a
                       outra. Hoje não existe nenhum nessa forma; a estrutura é que impede. #}
                    {%- if not a.vigente %} {{ 'cobranca_objeto.movimentos.desfeito'|trans }}
                    {%- elseif a.qtdSucessores > 0 %} {{ a.substituidoPeloAcordoId ? 'cobranca_objeto.movimentos.renegociadas_um'|trans : 'cobranca_objeto.movimentos.renegociadas_varios'|trans({n: a.qtdSucessores ~ ''}) }}{% endif %}
                </span>
            </div>
            <div class="jp-obr-valor"></div>
            <div class="jp-obr-acoes">
                <a href="{{ path('cobranca_acordo_show', {id: a.id}) }}" class="btn btn-sm jp-btn-outline">{{ 'cobranca_objeto.movimentos.abrir'|trans }}</a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
