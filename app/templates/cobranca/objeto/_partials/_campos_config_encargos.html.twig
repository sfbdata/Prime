{# Campos de override de encargos do OBJETO (spec "cascata de encargos ao vivo sem snapshot" §4,
   #9-T3) — nível 2 da cascata Carteira → Objeto → Obrigação. TODOS os 10 campos são opcionais.
   Campo vazio EXIBE, como placeholder, o valor que a carteira tem configurado (montado no
   `EditarConfiguracaoObjetoType` a partir do `ResolvedorConfigEncargos`) — no lugar do antigo selo
   "Herda da carteira", que dizia a regra sem dizer o número. Espelha o grid "Encargos por atraso" da config da carteira
   (`cobranca/carteira/_campos_config.html.twig`), mas SEM R$ (decisão #9-T3, documentada no relatório
   da T3: o objeto agrega várias obrigações, sem principal/vencimento únicos para o
   `ConversorTaxaEncargo` converter — só %/bp aqui).

   Espera no contexto: `form` (view do EditarConfiguracaoObjetoType) e `carteiraSemHonorarios` (bool —
   guarda "Menor da revisão T2": desabilita o override de honorários quando a carteira não cobra
   honorário percentual, evitando "exigível cobra honorário, split zera"). #}

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaJurosMensalBp.vars.id }}">{{ form.taxaJurosMensalBp.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.taxaJurosMensalBp) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaJurosMensalBp) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.regimeJuros.vars.id }}">{{ form.regimeJuros.vars.label }}</label>
        {{ form_widget(form.regimeJuros) }}
        {{ form_errors(form.regimeJuros) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaMultaBp.vars.id }}">{{ form.taxaMultaBp.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.taxaMultaBp) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaMultaBp) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.baseMulta.vars.id }}">{{ form.baseMulta.vars.label }}</label>
        {{ form_widget(form.baseMulta) }}
        {{ form_errors(form.baseMulta) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaCorrecaoBp.vars.id }}">{{ form.taxaCorrecaoBp.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.taxaCorrecaoBp) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaCorrecaoBp) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.baseCorrecao.vars.id }}">{{ form.baseCorrecao.vars.label }}</label>
        {{ form_widget(form.baseCorrecao) }}
        {{ form_errors(form.baseCorrecao) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.taxaHonorariosBp.vars.id }}">
            {{ form.taxaHonorariosBp.vars.label }}
        </label>
        <div class="input-group">
            {{ form_widget(form.taxaHonorariosBp, carteiraSemHonorarios ? {attr: {disabled: true}} : {}) }}
            <span class="input-group-text">%</span>
        </div>
        {{ form_errors(form.taxaHonorariosBp) }}
        {% if carteiraSemHonorarios %}
        <div class="form-text">A carteira não cobra honorários — este campo não se aplica.</div>
        {% endif %}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.baseHonorarios.vars.id }}">{{ form.baseHonorarios.vars.label }}</label>
        {{ form_widget(form.baseHonorarios) }}
        {{ form_errors(form.baseHonorarios) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.carenciaHonorariosDias.vars.id }}">{{ form.carenciaHonorariosDias.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.carenciaHonorariosDias) }}
            <span class="input-group-text">dias</span>
        </div>
        {{ form_errors(form.carenciaHonorariosDias) }}
    </div>

    <div class="col-md-6">
        <label class="form-label" for="{{ form.toleranciaJurosMultaDias.vars.id }}">{{ form.toleranciaJurosMultaDias.vars.label }}</label>
        <div class="input-group">
            {{ form_widget(form.toleranciaJurosMultaDias) }}
            <span class="input-group-text">dias</span>
        </div>
        {{ form_errors(form.toleranciaJurosMultaDias) }}
    </div>
</div>
