{% extends 'base.html.twig' %}

{% block title %}Cobranças · {{ objeto.identificacao }}{% endblock %}

{% block body %}
{# Página unificada do objeto (ajuste 2): o caso é a âncora invisível. Reusa a marcação do corpo
   operacional lendo `caso` = objeto.caso (CasoDetalheOutput).

   Ajuste 10 (redesenho): a página passou a ser organizada pelo TRABALHO, não pelas tabelas do banco.
   A ordem responde: quanto deve (cockpit) → o que exige atenção (alertas) → de quem (card da pessoa) →
   o que fazer agora (aba Cobrança: dívida + extrato). As 6 abas que espelhavam entidades Doctrine
   viraram 3 — Cobrança · Documentos · Histórico —, e a de Pessoas, que abria por padrão, virou card. #}
{% set caso = objeto.caso %}
{% set podeGerenciar = has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        {# B3: esta era a única página do módulo que perdia a subnav — o usuário caía num beco sem saída. #}
        {{ include('cobranca/_partials/_subnav.html.twig', {ativo: 'carteiras'}) }}

        <div class="d-flex align-items-center gap-2 mb-1 mt-3 flex-wrap">
            <a href="{{ path('cobranca_carteira_show', {id: objeto.carteiraId}) }}" class="btn btn-sm btn-outline-secondary" aria-label="Voltar para a carteira"><i class="bi bi-arrow-left"></i></a>
            <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-box-seam"></i>{{ objeto.identificacao }}</h1>
            <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
            {% if caso.prontoParaEncerrar %}<span class="badge text-bg-success" data-bs-toggle="tooltip" title="Saldo exigível zerado — o gestor pode encerrar (SPEC §17)">Pronto para encerrar</span>{% endif %}
            {% if podeGerenciar %}
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalRegistrarTentativa">
                    <i class="bi bi-telephone me-1"></i>Registrar contato
                </button>
                {# Judicializar/Encerrar (ações raras) saíram do dropdown `⋯` — vivem agora no cartão
                   "Ações do caso" do trilho (Ajuste 11, T3). #}
            </div>
            {% endif %}
        </div>
        <div class="text-secondary small">
            {% if objeto.descricao %}{{ objeto.descricao }} · {% endif %}
            Carteira: <a href="{{ path('cobranca_carteira_show', {id: objeto.carteiraId}) }}">{{ objeto.carteiraNome }}</a>
            {% if caso.pastaJudicialId %} · <a href="{{ path('pasta_show', {id: caso.pastaJudicialId}) }}"><i class="bi bi-folder-symlink me-1"></i>Pasta judicial</a>{% endif %}
        </div>
    </div>
</section>

<section class="content mt-3">
    <div class="container-fluid">
        <div class="cob-grid">
        <div class="cob-main">
        {# ── Hero do dinheiro (Ajuste 11): substitui o cockpit em faixa. Só os campos que o
           `CasoDetalheOutput` de fato tem — sem barra de progresso (não há valorRecuperado/totalDoCaso;
           não inventar cálculo). ──────────────────────────────────────────────────────────────── #}
        <div class="cob-hero">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="cob-hero-label" data-bs-toggle="tooltip" title="Saldo exigível: obrigações exigíveis menos pagamentos e liquidações (SPEC §10).">Total em aberto</div>
                    <div class="cob-hero-total {{ caso.saldoExigivel == 0 and not caso.encerrado ? 'saldo-zerado' : '' }}">{{ caso.saldoExigivel|centavos }}</div>
                    {% if caso.saldoVencido > 0 %}<div class="mt-1"><span class="cob-hero-venc">{{ caso.saldoVencido|centavos }}</span> <span class="cob-hero-sub">já vencido</span></div>{% endif %}
                </div>
                <div class="text-end cob-hero-sub">
                    <div class="cob-hero-label">Honorários</div>
                    <div class="fw-semibold text-white">{{ caso.formaHonorariosLabel }}{% if caso.percentualHonorarios %} ({{ caso.percentualHonorarios }}%){% endif %}</div>
                </div>
            </div>
        </div>

        {# ── Alertas (derivados, read-only — SPEC §14) ──────────────
           O alerta continua só CONTANDO o que há (invariável 28: o sistema alerta, o humano decide), mas
           agora leva ao lugar onde se resolve, em vez de ser texto morto no topo da página. #}
        {% if caso.alertas|length > 0 %}
        <div class="mb-3">
            {% for alerta in caso.alertas %}
            <div class="jp-alerta {{ alerta.tipo.badgeClass|replace({'text-bg-': 'sev-'}) }}">
                <i class="bi {{ alerta.tipo.icone }}"></i>
                <span>{{ alerta.descricao }}</span>
                {% if alerta.tipo.value in ['obrigacao_vencida', 'parcela_acordo_vencida'] %}
                <div class="jp-alerta-acoes">
                    <a href="#secao-divida" class="btn btn-sm btn-outline-secondary">Ver na dívida</a>
                </div>
                {% elseif alerta.tipo.value == 'acao_atrasada' and podeGerenciar %}
                <div class="jp-alerta-acoes">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalConcluirAcao">Concluir</button>
                </div>
                {% elseif alerta.tipo.value == 'pronto_para_encerrar' and podeGerenciar %}
                <div class="jp-alerta-acoes">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEncerrarCaso">Encerrar cobrança</button>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {# ── Abas: 6 → 3 ───────────────────────────────────────── #}
        <ul class="nav nav-tabs" id="objetoTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-cobranca" type="button">
                    <i class="bi bi-cash-coin me-1"></i>Cobrança
                </button>
            </li>
            {# `id="documentos-tab"`: o pasta-arquivos.js usa este id para restaurar a aba após o upload. #}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="documentos-tab" data-bs-toggle="tab" data-bs-target="#tab-documentos" type="button">
                    <i class="bi bi-folder me-1"></i>Documentos <span class="badge text-bg-secondary">{{ arquivosFm|length }}</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-historico" type="button">
                    <i class="bi bi-clock-history me-1"></i>Histórico <span class="badge text-bg-secondary">{{ caso.historico|length }}</span>
                </button>
            </li>
        </ul>
        <div class="tab-content border border-top-0 rounded-bottom p-3 bg-body">
            {# Cobrança: a dívida e o que já entrou — o trabalho do dia numa aba só. #}
            <div class="tab-pane fade show active" id="tab-cobranca">
                {{ include('cobranca/objeto/_partials/_divida.html.twig') }}
                {{ include('cobranca/objeto/_partials/_movimentos.html.twig') }}
            </div>

            {# Documentos (file manager religado na Onda 8C — reusa pasta-arquivos.js sem editá-lo) #}
            <div class="tab-pane fade" id="tab-documentos">
                {{ include('cobranca/caso/_documentos.html.twig') }}
            </div>

            {# Histórico (timeline — SPEC §13) #}
            <div class="tab-pane fade" id="tab-historico">
                {% if caso.historico|length > 0 %}
                <ul class="caso-timeline">
                    {% for e in caso.historico|reverse %}
                    <li class="caso-timeline-item">
                        <div class="caso-timeline-tipo">{{ e.tipoLabel }}</div>
                        <div>{{ e.descricao }}</div>
                        <div class="caso-timeline-meta">{{ e.ocorridoEm|date('d/m/Y H:i') }}{% if e.usuarioNome %} · {{ e.usuarioNome }}{% endif %}</div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}<p class="text-muted mb-0 text-center py-3">Sem eventos no histórico.</p>{% endif %}
            </div>
        </div>
        </div>

        <div class="cob-rail">
            {# ── Próxima ação: promovida a cartão de destaque no topo do trilho (Ajuste 11, T3) — o
               mesmo conteúdo/lógica do Ajuste 10 (`if caso.proximaAcao ... else`), só reenvelopado.
               Os gatilhos `#modalConcluirAcao`/`#modalDefinirAcao` continuam intactos. ── #}
            <div class="cob-proxima {{ caso.proximaAcao and caso.proximaAcao.atrasada ? 'atrasada' : '' }}">
                {% if caso.proximaAcao %}
                    <div class="cob-proxima-label d-flex align-items-center gap-2">
                        <span><i class="bi bi-flag-fill me-1"></i>Próxima ação{% if caso.proximaAcao.atrasada %} · <span class="text-warning-emphasis">atrasada</span>{% endif %}</span>
                        {% if podeGerenciar %}
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 ms-auto" data-bs-toggle="modal" data-bs-target="#modalConcluirAcao">Concluir</button>
                        {% endif %}
                    </div>
                    <div class="fw-semibold mt-2">{{ caso.proximaAcao.descricao }}</div>
                    {% if caso.proximaAcao.prazo %}<div class="small text-secondary">Prazo: {{ caso.proximaAcao.prazo|date('d/m/Y') }}{% if caso.proximaAcao.responsavelNome %} · {{ caso.proximaAcao.responsavelNome }}{% endif %}</div>{% endif %}
                {% else %}
                    <div class="cob-proxima-label">Próxima ação</div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <span class="text-secondary"><i class="bi bi-dash-circle me-1"></i>Nenhuma ação definida</span>
                        {% if podeGerenciar %}
                        <button type="button" class="btn btn-sm btn-outline-primary py-0" data-bs-toggle="modal" data-bs-target="#modalDefinirAcao">Definir</button>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# ── De quem é a dívida (era a aba "Pessoas", que abria por padrão) — sai de cima das abas
               e vai para o trilho direito. ── #}
            {{ include('cobranca/objeto/_partials/_pessoa_card.html.twig') }}

            {# ── Ações do caso: Judicializar/Encerrar saíram do dropdown `⋯` do header (Ajuste 11, T3)
               — são raras, não o trabalho do dia a dia. Mesmos gates/gatilhos de antes. ── #}
            {% if podeGerenciar %}
            <div class="cob-card p-3">
                <h6 class="mb-2">Ações do caso</h6>
                <div class="d-flex flex-column gap-2">
                    {% if can_access_module('pastas') and not caso.pastaJudicialId %}
                    <a href="#" role="button" class="cob-acao-link" data-bs-toggle="modal" data-bs-target="#modalJudicializar">
                        <i class="bi bi-bank"></i><span>Judicializar</span>
                    </a>
                    {% endif %}
                    {# Espelha o guard do servidor (`EncerrarCasoUseCase`: só encerra com saldo exigível
                       zerado). Desabilitado, o item ENSINA a condição em vez de falhar depois do clique. #}
                    {% if caso.prontoParaEncerrar %}
                    <a href="#" role="button" class="cob-acao-link text-danger" data-bs-toggle="modal" data-bs-target="#modalEncerrarCaso">
                        <i class="bi bi-flag"></i><span>Encerrar cobrança</span>
                    </a>
                    {% else %}
                    <span class="cob-acao-link is-disabled" data-bs-toggle="tooltip"
                          title="Só é possível encerrar com o total em aberto zerado. Faltam {{ caso.saldoExigivel|centavos }}.">
                        <i class="bi bi-flag"></i><span>Encerrar cobrança</span>
                    </span>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>
        </div>
    </div>
</section>

{% if has_permission('resources.cobranca.gerenciar') %}
{{ include('cobranca/caso/_acoes_modais.html.twig') }}
{% endif %}
{% if has_permission('resources.cobranca.movimentacao_financeira') and not caso.encerrado %}
{{ include('cobranca/caso/_acoes_modais_financeiro.html.twig') }}
{% endif %}

{# B5: marcador (one-shot no servidor) que reabre o modal cujo submit falhou na validação. A ação só vem
   nos modais REUTILIZÁVEIS (URL da linha), para o auto-open repor o `action` que o clique teria injetado. #}
{% if modalErroId %}<span data-modal-erro="{{ modalErroId }}"{% if modalErroAcao %} data-modal-erro-acao="{{ modalErroAcao }}"{% endif %} hidden></span>{% endif %}

{# Nova pessoa (cadastra + vincula ao objeto — gatilho no card da pessoa) #}
{% if formNovaPessoa %}
<div class="modal fade" id="modalNovaPessoa" tabindex="-1" aria-labelledby="tituloNovaPessoa" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(formNovaPessoa, {action: path('cobranca_objeto_pessoa_criar', {id: objeto.objetoId})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloNovaPessoa"><i class="bi bi-person-plus me-1"></i>Nova pessoa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(formNovaPessoa.nome) }}
                {{ form_row(formNovaPessoa.tipoVinculo) }}
                {{ form_row(formNovaPessoa.cpf) }}
                {{ form_row(formNovaPessoa.cnpj) }}
                {{ form_row(formNovaPessoa.telefone) }}
                {{ form_row(formNovaPessoa.email) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Cadastrar e vincular</button>
            </div>
            {{ form_end(formNovaPessoa) }}
        </div>
    </div>
</div>
{% endif %}

{# Vincular pessoa já existente do escritório a este objeto #}
{% if formVincular %}
<div class="modal fade" id="modalVincularPessoaObjeto" tabindex="-1" aria-labelledby="tituloVincularObjeto" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(formVincular, {action: path('cobranca_vinculo_criar', {id: objeto.objetoId})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloVincularObjeto"><i class="bi bi-link-45deg me-1"></i>Vincular pessoa existente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {{ form_row(formVincular.pessoaId) }}
                {{ form_row(formVincular.tipoVinculo) }}
                {{ form_row(formVincular.dataInicio) }}
                {{ form_row(formVincular.observacao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Vincular</button>
            </div>
            {{ form_end(formVincular) }}
        </div>
    </div>
</div>
{% endif %}

{# Encerrar vínculo (reutilizável; o botão da linha injeta a URL do vínculo via JS) #}
{% if formEncerrarVinculo %}
<div class="modal fade" id="modalEncerrarVinculo" tabindex="-1" aria-labelledby="tituloEncerrarVinculo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(formEncerrarVinculo, {attr: {id: 'formEncerrarVinculo'}}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEncerrarVinculo"><i class="bi bi-person-dash me-1"></i>Encerrar vínculo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" data-vinculo-contexto>Vínculo selecionado.</p>
                {{ form_row(formEncerrarVinculo.motivoEncerramento) }}
                {{ form_row(formEncerrarVinculo.dataFim) }}
                {{ form_row(formEncerrarVinculo.observacao) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-person-dash me-1"></i>Encerrar</button>
            </div>
            {{ form_end(formEncerrarVinculo) }}
        </div>
    </div>
</div>
{% endif %}
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/cobrancas.css') }}">
<link rel="stylesheet" href="{{ asset('css/pasta-arquivos.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof bootstrap === 'undefined') { return; }
    document.querySelectorAll('.cobrancas-page [data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });

    /* B5: a última mutação falhou na validação → reabre o modal com o digitado e o erro inline (o
       conteúdo já vem do form_row reidratado; aqui só damos o show). O marcador é consumido no servidor. */
    var marcadorErro = document.querySelector('[data-modal-erro]');
    if (marcadorErro) {
        var modalComErro = document.getElementById(marcadorErro.getAttribute('data-modal-erro'));
        if (modalComErro) {
            // Reutilizáveis: repõe o `action` da linha (o auto-open não tem clique que o injete).
            var acaoErro = marcadorErro.getAttribute('data-modal-erro-acao');
            if (acaoErro) {
                var formErro = modalComErro.querySelector('form');
                if (formErro) { formErro.setAttribute('action', acaoErro); }
            }
            bootstrap.Modal.getOrCreateInstance(modalComErro).show();
        }
    }

    /* Modal reutilizável de "editar obrigação": o botão da linha injeta a URL e pré-preenche os campos
       (valores em centavos → reais com ponto, que o CentavosType aceita no reverse). */
    var modalEditar = document.getElementById('modalEditarObrigacao');
    if (modalEditar) {
        modalEditar.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById('formEditarObrigacao');
            if (form) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
            var setVal = function (campo, valor) {
                var el = modalEditar.querySelector('[name="editar_obrigacao[' + campo + ']"]');
                if (el) { el.value = valor; }
            };
            var reais = function (centavos) { return (parseInt(centavos || '0', 10) / 100).toFixed(2); };
            setVal('descricao', botao.getAttribute('data-descricao') || '');
            setVal('referenciaExterna', botao.getAttribute('data-referencia') || '');
            setVal('vencimentoOriginal', botao.getAttribute('data-vencimento') || '');
            setVal('valorOriginal', reais(botao.getAttribute('data-valor-centavos')));
            setVal('encargosReconhecidos', reais(botao.getAttribute('data-encargos-centavos')));
            setVal('motivo', '');
        });
    }

    /* Modal reutilizável de "excluir obrigação": o botão da linha injeta a URL, o token CSRF e a descrição. */
    var modalExcluir = document.getElementById('modalExcluirObrigacao');
    if (modalExcluir) {
        modalExcluir.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById('formExcluirObrigacao');
            if (form) {
                form.setAttribute('action', botao.getAttribute('data-acao-url') || '');
                var tk = form.querySelector('[name="_token"]');
                if (tk) { tk.value = botao.getAttribute('data-token') || ''; }
            }
            var ctx = modalExcluir.querySelector('[data-obrigacao-descricao]');
            if (ctx) { ctx.textContent = botao.getAttribute('data-descricao') || ''; }
            var motivo = document.getElementById('motivoExcluirObrigacao');
            if (motivo) { motivo.value = ''; }
        });
    }

    /* Modais reutilizáveis de romper/cancelar acordo: o botão da linha injeta a URL. */
    ['modalRomperAcordo:formRomperAcordo', 'modalCancelarAcordo:formCancelarAcordo'].forEach(function (par) {
        var ids = par.split(':');
        var modal = document.getElementById(ids[0]);
        if (!modal) { return; }
        modal.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            var form = document.getElementById(ids[1]);
            if (form && botao) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
        });
    });

    /* Encerrar vínculo: o botão da linha (envolvidos, no card da pessoa) injeta a URL de ação e o contexto. */
    var modalEncerrarVinculo = document.getElementById('modalEncerrarVinculo');
    if (modalEncerrarVinculo) {
        modalEncerrarVinculo.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById('formEncerrarVinculo');
            if (form) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
            var ctx = modalEncerrarVinculo.querySelector('[data-vinculo-contexto]');
            if (ctx) { ctx.textContent = 'Vínculo: ' + (botao.getAttribute('data-vinculo-rotulo') || ''); }
        });
    }

    /* Coleção dinâmica genérica do Symfony CollectionType (prototype). Reusada por parcelas do acordo
       e alocações de pagamento/correção. */
    function initColecao(containerId, addBtnId, classeLinha, rotuloRemover) {
        var container = document.getElementById(containerId);
        var addBtn = document.getElementById(addBtnId);
        if (!container || !addBtn) { return; }
        addBtn.addEventListener('click', function () {
            var index = parseInt(container.dataset.index || '0', 10);
            var html = (container.dataset.prototype || '').replace(/__name__/g, index);
            var linha = document.createElement('div');
            linha.className = classeLinha;
            linha.innerHTML = html + '<button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">' + rotuloRemover + '</button>';
            container.appendChild(linha);
            container.dataset.index = (index + 1).toString();
        });
        container.addEventListener('click', function (e) {
            var btn = e.target.closest('.remover-linha');
            if (btn) { var linha = btn.closest('.' + classeLinha.split(' ')[0]); if (linha) { linha.remove(); } }
        });
    }

    initColecao('parcelasContainer', 'addParcela', 'parcela-linha border rounded p-2 mb-2', 'Remover');
    initColecao('alocacoesPagamentoContainer', 'addAlocacaoPagamento', 'alocacao-linha border rounded p-2 mb-2', 'Remover');
    initColecao('alocacoesCorrigirContainer', 'addAlocacaoCorrigir', 'alocacao-linha border rounded p-2 mb-2', 'Remover');

    /* Gerador de acordo inteligente (Ajuste 7): soma a seleção de obrigações, gera as parcelas pelo
       endpoint (fonte única de centavos), redistribui as não-fixadas ao editar uma parcela, e valida
       o fechamento (entrada + Σ parcelas == total) desabilitando o submit quando não fecha. O servidor
       revalida INV-B no POST — este JS é só afordância. */
    (function initGeradorAcordo() {
        var modal = document.getElementById('modalCriarAcordo');
        var container = document.getElementById('parcelasContainer');
        if (!modal || !container) { return; }
        var previaUrl = '{{ path('cobranca_acordo_previa_parcelamento') }}';
        var form = container.closest('form');
        var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
        var totalInput = modal.querySelector('input[data-acordo-total]');
        var entradaInput = modal.querySelector('input[data-acordo-entrada]');
        var totalSelDisplay = modal.querySelector('[data-acordo-total-selecionado]');
        var erroBox = modal.querySelector('[data-acordo-erro-gerador]');
        var fechamentoBox = modal.querySelector('[data-acordo-fechamento]');
        var checkboxes = Array.prototype.slice.call(modal.querySelectorAll('input[name*="obrigacoesSubstituidasIds"]'));
        var avisoPagamento = document.getElementById('avisoAcordoComPagamento');
        var dataAcordoInput = form ? form.querySelector('input[name$="[dataAcordo]"]') : null;
        var data1Input = document.getElementById('acordoData1');

        function pad2(n) { return (n < 10 ? '0' : '') + n; }
        function hojeYmd() { var t = new Date(); return t.getFullYear() + '-' + pad2(t.getMonth() + 1) + '-' + pad2(t.getDate()); }
        // "1º vencimento" sugerido = 1 mês após a data do acordo, com clamp de fim de mês (31/jan -> 28/fev).
        function umMesApos(ymd) {
            if (!ymd) { return ''; }
            var p = ymd.split('-');
            var y = parseInt(p[0], 10), m = parseInt(p[1], 10), d = parseInt(p[2], 10);
            var alvoM = m + 1, alvoY = y;
            if (alvoM > 12) { alvoM = 1; alvoY += 1; }
            var ultimoDia = new Date(alvoY, alvoM, 0).getDate();
            return alvoY + '-' + pad2(alvoM) + '-' + pad2(Math.min(d, ultimoDia));
        }
        function vencimentoSugerido() {
            return umMesApos((dataAcordoInput && dataAcordoInput.value) ? dataAcordoInput.value : hojeYmd());
        }

        function valorInputDe(row) { return row.querySelector('input[name$="[valor]"]'); }
        function linhas() { return Array.prototype.slice.call(container.querySelectorAll('.parcela-linha')); }
        // Valor de campo em pt-BR (vírgula decimal), consistente com parseCentavos e o CentavosType.
        function reaisInput(cent) { return (cent / 100).toFixed(2).replace('.', ','); }
        function somaSelecionadas() {
            return checkboxes.reduce(function (s, c) {
                return c.checked ? s + parseInt(c.getAttribute('data-valor-centavos') || '0', 10) : s;
            }, 0);
        }

        /* Ajuste 10 (spec §5.3): avisa que o valor sugerido é o REMANESCENTE quando alguma marcada já
           recebeu pagamento. Sem seleção, nada a avisar — o aviso fica escondido. */
        function atualizarAvisoPagamento() {
            if (!avisoPagamento) { return; }
            var temPagamento = checkboxes.some(function (c) {
                return c.checked && parseInt(c.getAttribute('data-alocado-centavos') || '0', 10) > 0;
            });
            avisoPagamento.classList.toggle('d-none', !temPagamento);
        }

        function atualizarFechamento() {
            var total = parseCentavos(totalInput ? totalInput.value : '');
            var entrada = parseCentavos(entradaInput ? entradaInput.value : '');
            var rows = linhas();
            // Total não informado → fluxo livre (o servidor deriva o total); não travar o submit.
            if (total <= 0) {
                if (fechamentoBox) { fechamentoBox.textContent = ''; }
                if (submitBtn) { submitBtn.disabled = false; }
                return;
            }
            var soma = entrada;
            var todasPositivas = rows.length > 0;
            rows.forEach(function (r) {
                var v = parseCentavos(valorInputDe(r).value);
                soma += v;
                if (v <= 0) { todasPositivas = false; }
            });
            var fecha = soma === total && todasPositivas;
            if (fechamentoBox) {
                fechamentoBox.classList.toggle('text-danger', !fecha);
                fechamentoBox.classList.toggle('text-success', fecha);
                fechamentoBox.textContent = fecha
                    ? 'Entrada + parcelas fecham em ' + fmtReais(total) + '.'
                    : 'Entrada + parcelas somam ' + fmtReais(soma) + ' — deve fechar em ' + fmtReais(total) + '.';
            }
            if (submitBtn) { submitBtn.disabled = !fecha; }
        }

        function redistribuir() {
            var total = parseCentavos(totalInput ? totalInput.value : '');
            var entrada = parseCentavos(entradaInput ? entradaInput.value : '');
            if (total <= 0) { atualizarFechamento(); return; }
            var rows = linhas();
            var fixas = rows.filter(function (r) { return r.dataset.fixada === '1'; });
            var naoFixas = rows.filter(function (r) { return r.dataset.fixada !== '1'; });
            var somaFixas = fixas.reduce(function (s, r) { return s + parseCentavos(valorInputDe(r).value); }, 0);
            var restante = total - entrada - somaFixas;
            if (naoFixas.length) {
                var base = Math.trunc(restante / naoFixas.length);
                var resto = restante - base * naoFixas.length;
                naoFixas.forEach(function (r, i) {
                    // D3: a primeira NÃO-fixada absorve a sobra (espelha o gerador do servidor).
                    valorInputDe(r).value = reaisInput(base + (i === 0 ? resto : 0));
                });
            }
            atualizarFechamento();
        }

        function montarLinha(index, p) {
            var html = (container.dataset.prototype || '').replace(/__name__/g, index);
            var row = document.createElement('div');
            row.className = 'parcela-linha border rounded p-2 mb-2';
            row.innerHTML = html + '<button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">Remover</button>';
            var d = row.querySelector('input[name$="[descricao]"]'); if (d) { d.value = p.descricao; }
            var v = valorInputDe(row); if (v) { v.value = reaisInput(p.valor); }
            var w = row.querySelector('input[name$="[vencimento]"]'); if (w) { w.value = p.vencimento; }
            container.appendChild(row);
        }

        function gerar() {
            var total = parseCentavos(totalInput ? totalInput.value : '');
            var entrada = parseCentavos(entradaInput ? entradaInput.value : '');
            var qtd = parseInt(document.getElementById('acordoQtdParcelas').value || '0', 10);
            var data1 = document.getElementById('acordoData1').value;
            var periodicidade = document.getElementById('acordoPeriodicidade').value;
            if (erroBox) { erroBox.textContent = ''; }
            if (total <= 0 || !data1 || qtd < 1) {
                if (erroBox) { erroBox.textContent = 'Informe o total negociado, o nº de parcelas e o 1º vencimento.'; }
                return;
            }
            var qs = 'total=' + total + '&entrada=' + entrada + '&qtd=' + qtd
                + '&data1=' + encodeURIComponent(data1) + '&periodicidade=' + encodeURIComponent(periodicidade);
            fetch(previaUrl + '?' + qs, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    if (!d || !d.ok) {
                        if (erroBox) { erroBox.textContent = (d && d.erro) ? d.erro : 'Não foi possível gerar as parcelas.'; }
                        return;
                    }
                    container.querySelectorAll('.parcela-linha').forEach(function (r) { r.remove(); });
                    d.parcelas.forEach(function (p, i) { montarLinha(i, p); });
                    container.dataset.index = d.parcelas.length.toString();
                    atualizarFechamento();
                })
                .catch(function () { if (erroBox) { erroBox.textContent = 'Falha ao gerar as parcelas.'; } });
        }

        var gerarBtn = document.getElementById('acordoGerar');
        if (gerarBtn) { gerarBtn.addEventListener('click', gerar); }

        checkboxes.forEach(function (c) {
            c.addEventListener('change', function () {
                var s = somaSelecionadas();
                if (totalSelDisplay) { totalSelDisplay.textContent = fmtReais(s); }
                // Preenche o total automaticamente enquanto o usuário não o editou à mão.
                if (totalInput && totalInput.dataset.touched !== '1') {
                    totalInput.value = s > 0 ? reaisInput(s) : '';
                }
                atualizarAvisoPagamento();
                atualizarFechamento();
            });
        });

        if (totalInput) {
            totalInput.addEventListener('input', function () { totalInput.dataset.touched = '1'; redistribuir(); });
        }
        if (entradaInput) { entradaInput.addEventListener('input', redistribuir); }

        // O "1º vencimento" nasce em 1 mês após a data do acordo e acompanha mudanças dessa data, desde
        // que o gestor não o tenha ajustado à mão (`touched`, espelha o total).
        if (data1Input && !data1Input.value) { data1Input.value = vencimentoSugerido(); }
        if (data1Input) {
            data1Input.addEventListener('input', function () { data1Input.dataset.touched = '1'; });
        }
        if (dataAcordoInput) {
            dataAcordoInput.addEventListener('change', function () {
                if (data1Input && data1Input.dataset.touched !== '1') { data1Input.value = vencimentoSugerido(); }
            });
        }

        // Editar o valor de uma parcela a FIXA; as demais se redistribuem para fechar o total.
        container.addEventListener('input', function (e) {
            var input = e.target.closest('input[name$="[valor]"]');
            if (!input) { return; }
            var row = input.closest('.parcela-linha');
            if (row) { row.dataset.fixada = '1'; }
            redistribuir();
        });

        modal.addEventListener('shown.bs.modal', atualizarFechamento);

        /* Reset SEMPRE ao fechar (espelha o `#modalRegistrarPagamento`): "Acordar" na linha e "Fazer
           acordo com estas" na barra TROCAM a seleção a cada abertura — sem limpar, o total/parcelas
           de uma negociação abandonada (Esc) sobrevivem e, se o gestor digitou o total à mão
           (`touched`), o guard de fechamento pode achar que o valor e as parcelas da seleção ANTERIOR
           fecham para a seleção NOVA (dinheiro errado). O POST é PRG (`AcordoController::criar`
           sempre redireciona), então não há estado de submit a preservar. */
        modal.addEventListener('hidden.bs.modal', function () {
            container.querySelectorAll('.parcela-linha').forEach(function (r) { r.remove(); });
            container.dataset.index = '0';
            if (totalInput) {
                totalInput.value = '';
                delete totalInput.dataset.touched;
            }
            if (entradaInput) { entradaInput.value = ''; }
            var qtdInput = document.getElementById('acordoQtdParcelas');
            if (qtdInput) { qtdInput.value = '1'; }
            // Volta ao sugerido (data do acordo + 1 mês), não a vazio — o modal reabre já preenchido.
            if (data1Input) { data1Input.value = vencimentoSugerido(); delete data1Input.dataset.touched; }
            var periodicidadeSelect = document.getElementById('acordoPeriodicidade');
            if (periodicidadeSelect) { periodicidadeSelect.selectedIndex = 0; }
            if (erroBox) { erroBox.textContent = ''; }
            if (fechamentoBox) {
                fechamentoBox.textContent = '';
                fechamentoBox.classList.remove('text-danger', 'text-success');
            }
            if (totalSelDisplay) { totalSelDisplay.textContent = 'R$ 0,00'; }
            /* A seleção DENTRO do modal também é estado velho: "Novo acordo" (botão da seção) abre o
               modal direto pelo `data-bs-toggle`, sem passar por `abrirAcordoCom` — sem limpar aqui, a
               obrigação marcada por um "Acordar" abandonado reaparece pré-selecionada e "Novo acordo"
               deixaria de significar NOVO. Seguro: o `hidden` é o FECHAMENTO; o "Acordar" da linha marca
               os checkboxes no clique seguinte, DEPOIS deste reset, então a pré-seleção continua valendo.
               Só os checkboxes do MODAL — os `.jp-check` da seção são a seleção deliberada do usuário na
               página (a barra), e apagá-la ao espiar o modal destruiria trabalho dele. */
            checkboxes.forEach(function (c) { c.checked = false; });
            // A seleção foi zerada acima: o aviso do §5.3 pertence à seleção, some junto com ela.
            atualizarAvisoPagamento();
        });
    })();

    /* Prévia ao vivo da divisão dívida/honorários + FIFO (Ajuste 6): ao digitar o valor pago, consulta
       o endpoint (fonte única da regra de centavos) e mostra a divisão; se exceder o saldo, avisa e
       desabilita o submit (no modo automático). O checkbox "Alocar manualmente" revela as alocações. */
    function parseCentavos(str) {
        if (!str) { return 0; }
        var s = String(str).trim().replace(/\s/g, '').replace(/\./g, '').replace(',', '.');
        var f = parseFloat(s);
        return isNaN(f) ? 0 : Math.round(f * 100);
    }
    function fmtReais(cent) {
        var v = (cent / 100).toFixed(2).replace('.', ',');
        return 'R$ ' + v.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }
    /* Centavos → valor de CAMPO em pt-BR (vírgula decimal), consistente com parseCentavos e o
       CentavosType. `parseCentavos` trata PONTO como separador de MILHAR: escrever "1320.00" num input
       viraria R$ 132.000,00 — bug real, já pago caro no ajuste 7. */
    function reaisInput(cent) { return (cent / 100).toFixed(2).replace('.', ','); }
    function initPreviaPagamento(body) {
        var box = body.querySelector('[data-previa-pagamento]');
        var valorInput = body.querySelector('input[name$="[valorPago]"]');
        var manualCheck = body.querySelector('input[name$="[alocarManualmente]"]');
        var manualBox = body.querySelector('[data-alocacao-manual]');
        var form = body.closest('form');
        var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
        if (!box || !valorInput) { return; }

        function toggleManual() {
            if (!manualBox) { return; }
            manualBox.classList.toggle('d-none', !(manualCheck && manualCheck.checked));
        }
        function urlPrevia() {
            return box.getAttribute('data-previa-url') || body.getAttribute('data-previa-url') || '';
        }
        /* Monta a prévia com nós de DOM e textContent — a descrição da obrigação é input livre do
           usuário; NUNCA interpolar em innerHTML (XSS). Só rótulos/valores numéricos são fixos. */
        function linhaValor(rotulo, valor) {
            var div = document.createElement('div');
            div.className = 'd-flex justify-content-between';
            var s1 = document.createElement('span'); s1.textContent = rotulo;
            var s2 = document.createElement('strong'); s2.textContent = valor;
            div.appendChild(s1); div.appendChild(s2);
            return div;
        }
        function render(d) {
            var manual = !!(manualCheck && manualCheck.checked);
            box.classList.remove('d-none', 'border-danger');
            box.textContent = '';
            box.appendChild(linhaValor('Dívida:', fmtReais(d.divida)));
            box.appendChild(linhaValor('Honorários:', fmtReais(d.honorarios)));
            if (d.excede && !manual) {
                var aviso = document.createElement('div');
                aviso.className = 'mt-1 text-danger';
                var ic = document.createElement('i'); ic.className = 'bi bi-exclamation-triangle me-1';
                aviso.appendChild(ic);
                aviso.appendChild(document.createTextNode('Excede o saldo do caso em ' + fmtReais(d.excedeEm) + '.'));
                box.appendChild(aviso);
                box.classList.add('border-danger');
                if (submitBtn) { submitBtn.disabled = true; }
            } else {
                if (submitBtn) { submitBtn.disabled = false; }
                if (!manual && d.alocacoes && d.alocacoes.length) {
                    var cap = document.createElement('div');
                    cap.className = 'mt-1 text-muted';
                    cap.textContent = 'Distribuição automática (FIFO):';
                    box.appendChild(cap);
                    var ul = document.createElement('ul');
                    ul.className = 'mb-0 ps-3 text-muted';
                    d.alocacoes.forEach(function (a) {
                        var li = document.createElement('li');
                        li.textContent = (a.descricao || 'Obrigação') + ' — ' + fmtReais(a.valor);
                        ul.appendChild(li);
                    });
                    box.appendChild(ul);
                }
            }
        }
        function atualizar() {
            var centavos = parseCentavos(valorInput.value);
            var url = urlPrevia();
            if (centavos <= 0 || !url) {
                box.classList.add('d-none');
                if (submitBtn) { submitBtn.disabled = false; }
                return;
            }
            fetch(url + '?valor=' + centavos, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) { if (d) { render(d); } else { box.classList.add('d-none'); } })
                .catch(function () { box.classList.add('d-none'); });
        }
        var timer = null;
        valorInput.addEventListener('input', function () {
            if (timer) { clearTimeout(timer); }
            timer = setTimeout(atualizar, 300);
        });
        if (manualCheck) { manualCheck.addEventListener('change', function () { toggleManual(); atualizar(); }); }
        body._previaAtualizar = atualizar;
        body._previaReset = function () {
            box.classList.add('d-none');
            box.innerHTML = '';
            if (submitBtn) { submitBtn.disabled = false; }
            toggleManual();
        };
        toggleManual();
    }
    document.querySelectorAll('[data-pagamento-modal]').forEach(initPreviaPagamento);

    var modalRegistrar = document.getElementById('modalRegistrarPagamento');
    if (modalRegistrar) {
        modalRegistrar.addEventListener('shown.bs.modal', function () {
            var body = modalRegistrar.querySelector('[data-pagamento-modal]');
            if (body && body._previaAtualizar) { body._previaAtualizar(); }
        });
    }

    /* ── Ações na própria obrigação (Ajuste 10, T5) ──────────────────────────────────────────────
       A obrigação e o pagamento dela são a mesma conversa: antes, receber UMA obrigação custava trocar
       de aba, abrir "Registrar pagamento", marcar "Alocar manualmente", adicionar alocação e caçar a
       obrigação numa lista — 6 a 7 cliques. Agora é um botão na linha. Nenhuma regra de negócio muda:
       o modal, o form e o POST são exatamente os mesmos; só chegam preenchidos. */
    (function initAcoesNaLinha() {
        var containerAloc = document.getElementById('alocacoesPagamentoContainer');

        function limparAlocacoes() {
            if (!containerAloc) { return; }
            containerAloc.querySelectorAll('.alocacao-linha').forEach(function (r) { r.remove(); });
            containerAloc.dataset.index = '0';
        }

        function adicionarAlocacao(obrigacaoId, valorCentavos) {
            if (!containerAloc) { return; }
            var index = parseInt(containerAloc.dataset.index || '0', 10);
            var html = (containerAloc.dataset.prototype || '').replace(/__name__/g, index);
            var linha = document.createElement('div');
            linha.className = 'alocacao-linha border rounded p-2 mb-2';
            linha.innerHTML = html + '<button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">Remover</button>';
            var select = linha.querySelector('[name$="[obrigacaoId]"]');
            if (select) { select.value = obrigacaoId; }
            var valor = linha.querySelector('[name$="[valor]"]');
            if (valor) { valor.value = reaisInput(valorCentavos); }
            containerAloc.appendChild(linha);
            containerAloc.dataset.index = (index + 1).toString();
        }

        /* "Receber" na linha = alocação MANUAL naquela obrigação, não FIFO: se o gestor clicou em Maio
           com Março em aberto, foi Maio que ele pediu (spec §5.1). O FIFO segue sendo o default do botão
           genérico "Registrar pagamento" da seção. */
        if (modalRegistrar && containerAloc) {
            modalRegistrar.addEventListener('show.bs.modal', function (event) {
                var botao = event.relatedTarget;
                var linha = botao ? botao.closest('.jp-obr') : null;
                var ehReceber = !!(botao && botao.getAttribute('data-acao') === 'receber' && linha);
                var valorPago = modalRegistrar.querySelector('[name$="[valorPago]"]');
                var manual = modalRegistrar.querySelector('[name$="[alocarManualmente]"]');

                /* Reset SEMPRE: o mesmo modal serve o botão genérico (FIFO) e o "Receber" da linha. Sem
                   limpar, o alvo de um clique anterior vazaria para o pagamento seguinte — e o POST é
                   PRG (redireciona), então o modal nunca precisa preservar estado de submit. */
                limparAlocacoes();
                if (valorPago) { valorPago.value = ''; }
                if (manual) { manual.checked = false; }

                if (ehReceber) {
                    var restante = parseInt(linha.getAttribute('data-valor-centavos') || '0', 10);
                    /* O BRUTO vem PRONTO do servidor (`ObrigacaoOutput::brutoSugerido`, via
                       `CalculadoraHonorarios::brutoParaRecuperar`). Na forma `acrescido_divida`,
                       `ratearPagamento` divide o valor DIGITADO: pré-preencher o restante (R$1.200)
                       devolveria dívida R$1.090,91 e a obrigação NÃO quitaria. O número certo é
                       R$1.320,00. NUNCA recalcular isso aqui — dinheiro tem uma fonte só, e ela é o PHP. */
                    var bruto = parseInt(linha.getAttribute('data-bruto-centavos') || '0', 10);
                    if (valorPago) { valorPago.value = reaisInput(bruto); }
                    if (manual) { manual.checked = true; }
                    adicionarAlocacao(botao.getAttribute('data-obrigacao-id'), restante);
                }

                /* Revela/esconde o bloco manual e recalcula a prévia ao vivo — que continua mandando:
                   o prefill é SUGESTÃO, editável, e os guards do domínio seguem intactos no POST. */
                if (manual) { manual.dispatchEvent(new Event('change')); }
            });
        }

        /* ── "Acordar": linha e seleção múltipla ──
           Ambos abrem o MESMO `#modalCriarAcordo` com os checkboxes pré-marcados — o form e o
           `AcordoCriarType` não mudam de contrato; o gerador de parcelas recalcula sozinho ao receber
           o `change`. INV-U1: parcela de acordo nunca chega aqui — nem tem checkbox nem botão (o
           template não os renderiza), porque acordo sobre acordo duplica dívida no saldo ao romper. */
        var modalAcordo = document.getElementById('modalCriarAcordo');

        function checksDaDivida() {
            return Array.prototype.slice.call(document.querySelectorAll('#secao-divida .jp-check'));
        }

        function abrirAcordoCom(ids) {
            if (!modalAcordo || typeof bootstrap === 'undefined') { return; }
            var opcoes = Array.prototype.slice.call(modalAcordo.querySelectorAll('[name*="obrigacoesSubstituidasIds"]'));
            opcoes.forEach(function (c) { c.checked = ids.indexOf(c.value) !== -1; });
            // Um `change` basta: o gerador resoma a seleção INTEIRA a cada evento.
            if (opcoes.length) { opcoes[0].dispatchEvent(new Event('change')); }
            bootstrap.Modal.getOrCreateInstance(modalAcordo).show();
        }

        var barra = document.getElementById('barraSelecaoDivida');

        function atualizarBarra() {
            if (!barra) { return; }
            var marcados = checksDaDivida().filter(function (c) { return c.checked; });
            var soma = marcados.reduce(function (s, c) {
                return s + parseInt(c.getAttribute('data-valor-centavos') || '0', 10);
            }, 0);
            barra.hidden = marcados.length === 0;
            var qtd = barra.querySelector('[data-selecao-qtd]');
            var total = barra.querySelector('[data-selecao-total]');
            if (qtd) { qtd.textContent = marcados.length.toString(); }
            // A barra soma o RESTANTE de cada linha (`data-valor-centavos`), não o valor cheio.
            if (total) { total.textContent = fmtReais(soma); }
        }

        checksDaDivida().forEach(function (c) {
            c.addEventListener('change', function () {
                var linha = c.closest('.jp-obr');
                if (linha) { linha.classList.toggle('is-selecionada', c.checked); }
                atualizarBarra();
            });
        });

        document.addEventListener('click', function (e) {
            var naLinha = e.target.closest('#secao-divida [data-acao="acordar"]');
            if (naLinha) {
                // Atalho: marca só aquela e abre o mesmo modal.
                var id = naLinha.getAttribute('data-obrigacao-id');
                checksDaDivida().forEach(function (c) {
                    c.checked = c.value === id;
                    c.dispatchEvent(new Event('change'));
                });
                abrirAcordoCom([id]);

                return;
            }

            if (e.target.closest('[data-acao="acordar-selecionadas"]')) {
                abrirAcordoCom(checksDaDivida().filter(function (c) { return c.checked; })
                    .map(function (c) { return c.value; }));

                return;
            }

            if (e.target.closest('[data-acao="limpar-selecao"]')) {
                checksDaDivida().forEach(function (c) {
                    c.checked = false;
                    c.dispatchEvent(new Event('change'));
                });
            }
        });
    })();

    /* Modal reutilizável de "corrigir pagamento": o botão da linha injeta a URL de ação e o contexto. */
    var modalCorrigir = document.getElementById('modalCorrigirPagamento');
    if (modalCorrigir) {
        modalCorrigir.addEventListener('show.bs.modal', function (event) {
            var botao = event.relatedTarget;
            if (!botao) { return; }
            var form = document.getElementById('formCorrigirPagamento');
            if (form) { form.setAttribute('action', botao.getAttribute('data-acao-url') || ''); }
            var ctx = modalCorrigir.querySelector('[data-pagamento-contexto]');
            if (ctx) {
                ctx.textContent = 'Pagamento de ' + (botao.getAttribute('data-pagamento-data') || '')
                    + ' · total ' + (botao.getAttribute('data-pagamento-total') || '');
            }
            /* A prévia da correção depende do pagamento: injeta a URL do botão na caixa e reseta. */
            var pbox = modalCorrigir.querySelector('[data-previa-pagamento]');
            if (pbox) { pbox.setAttribute('data-previa-url', botao.getAttribute('data-previa-url') || ''); }
            var body = modalCorrigir.querySelector('[data-pagamento-modal]');
            if (body && body._previaReset) { body._previaReset(); }
        });
    }

    /* Guarda dos modais REUTILIZÁVEIS: a `action` desses forms é injetada pelo botão da linha ao abrir.
       Se o modal for exibido SEM esse contexto (reabertura programática, restauração de bfcache/back),
       a `action` fica vazia e o form postaria na própria página (rota só-GET → 405). Sem alvo definido,
       bloqueia o submit — a ação só é válida com um item selecionado. */
    ['formCorrigirPagamento', 'formEditarObrigacao', 'formExcluirObrigacao', 'formRomperAcordo', 'formCancelarAcordo', 'formEncerrarVinculo'].forEach(function (id) {
        var f = document.getElementById(id);
        if (!f) { return; }
        f.addEventListener('submit', function (e) {
            if (!f.getAttribute('action')) { e.preventDefault(); }
        });
    });
});
</script>

{# File-manager de documentos (Onda 8C): reusa o public/js/pasta-arquivos.js SEM editá-lo. O helper
   window.enviarArquivoComProgresso é dependência externa do JS (upload via XHR) e precisa existir global. #}
{% if has_permission('resources.cobranca.gerenciar') %}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js" crossorigin="anonymous"></script>
<script>
// Envia 1 arquivo via XHR, reportando progresso — contrato idêntico ao das Pastas (resolve com {success:true}).
window.enviarArquivoComProgresso = function (file, opts) {
    return new Promise(function (resolve, reject) {
        const fd = new FormData();
        fd.append('arquivo', file);
        fd.append('_token', opts.csrf);
        fd.append('categoria', opts.categoria || '');
        fd.append('descricao', opts.descricao || '');
        if (opts.secaoId) fd.append('secao_id', opts.secaoId);
        fd.append('reduzir_tamanho', opts.reduzir ? '1' : '0');

        const xhr = new XMLHttpRequest();
        xhr.open('POST', opts.url);
        xhr.upload.addEventListener('progress', function (ev) {
            if (ev.lengthComputable && typeof opts.onProgress === 'function') {
                opts.onProgress(Math.round((ev.loaded / ev.total) * 100));
            }
        });
        xhr.upload.addEventListener('load', function () {
            if (typeof opts.onComprimindo === 'function') opts.onComprimindo();
        });
        xhr.addEventListener('load', function () {
            let data = null;
            try { data = JSON.parse(xhr.responseText); } catch (_) {}
            if (xhr.status >= 200 && xhr.status < 300 && data && data.success) {
                resolve(data);
            } else {
                reject(new Error((data && data.error) ? data.error : 'Erro ao enviar o arquivo.'));
            }
        });
        xhr.addEventListener('error', function () { reject(new Error('Erro de comunicação.')); });
        xhr.send(fd);
    });
};
</script>
<script src="{{ asset('js/pasta-arquivos.js') }}"></script>
{% endif %}
{% endblock %}
