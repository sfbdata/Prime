{% extends 'base.html.twig' %}

{% block title %}Cobranças · {{ objeto.identificacao }}{% endblock %}

{% block body %}
{# Página unificada do objeto (ajuste 2): o caso é a âncora invisível. Reusa a marcação do corpo
   operacional lendo `caso` = objeto.caso (CasoDetalheOutput).

   Ajuste 10 (redesenho): a página passou a ser organizada pelo TRABALHO, não pelas tabelas do banco.
   A ordem responde: quanto deve (cockpit) → o que exige atenção (alertas) → de quem (card da pessoa) →
   o que fazer agora (aba Cobrança: dívida + extrato). As 6 abas que espelhavam entidades Doctrine
   viraram 3 — Cobrança · Documentos · Histórico —, e a de Pessoas, que abria por padrão, virou card. #}
{% set caso = objeto.caso %}
{% set podeGerenciar = has_permission('resources.cobranca.gerenciar') and not caso.encerrado %}
{# A resolução do vínculo da cobrada atual mudou de lugar junto com a função: agora vive dentro do
   partial `_responsaveis.html.twig`, que é quem precisa dela. #}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        {# B3: esta era a única página do módulo que perdia a subnav — o usuário caía num beco sem saída. #}
        {{ include('cobranca/_partials/_subnav.html.twig', {ativo: 'carteiras'}) }}

        {# ── Cabeçalho redesenhado (spec `cobranca-objeto-show-cabecalho-responsaveis.md` §1) ──────────
           Duas colunas a partir de 992px (`col-lg-*`), empilhando abaixo disso: identidade + dinheiro à
           esquerda, prescrição + ações à direita. O CSS de acabamento é da Etapa 7; a estrutura já se
           sustenta na grade do Bootstrap para não haver uma janela em que a página fique quebrada. #}
        <div class="cob-cab row g-3 mt-3">
            <div class="col-12 col-lg-7 cob-cab-identidade">
                {# Trilha de DOIS níveis (§1.1). O `Cond. Top Life` da maquete (o cliente da carteira)
                   saiu por decisão do dono: a hierarquia real do sistema é Carteira › Unidade. Este link
                   é também o caminho de volta — por isso a seta solta que existia aqui saiu, em vez de
                   duplicar o mesmo destino a 2cm de distância. #}
                <nav class="cob-cab-trilha small" aria-label="Trilha de navegação">
                    <a href="{{ path('cobranca_carteira_show', {id: objeto.carteiraId}) }}">Carteira {{ objeto.carteiraNome }}</a>
                    <span class="cob-cab-trilha-sep" aria-hidden="true">›</span>
                    <span class="cob-cab-trilha-atual">Unidade {{ objeto.identificacao }}</span>
                </nav>

                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-box-seam"></i>{{ objeto.identificacao }}</h1>
                    <span class="badge {{ caso.statusBadgeClass }}">{{ caso.statusLabel }}</span>
                    {% if caso.prontoParaEncerrar %}<span class="badge text-bg-success" data-bs-toggle="tooltip" title="Saldo exigível zerado — o gestor pode encerrar (SPEC §17)">Pronto para encerrar</span>{% endif %}

                    {# ── Setas ‹ › entre unidades da MESMA carteira (§1.5) ──
                       A ordem é `identificacao ASC, id ASC`, decidida no repositório: a ordem da listagem
                       (`atualizadoEm DESC`) muda sozinha a cada registro e a mesma seta levaria a lugares
                       diferentes a cada visita. Ponta da lista → `null` no DTO → seta desabilitada; o
                       template não recalcula vizinhança nenhuma. #}
                    <div class="cob-cab-nav btn-group btn-group-sm ms-auto" role="group" aria-label="Navegar entre unidades da carteira">
                        {% if objeto.objetoAnteriorId %}
                        <a href="{{ path('cobranca_objeto_show', {id: objeto.objetoAnteriorId}) }}"
                           class="btn btn-outline-secondary" data-nav="anterior"
                           data-bs-toggle="tooltip" title="Unidade anterior da carteira"
                           aria-label="Unidade anterior da carteira">‹</a>
                        {% else %}
                        <span class="btn btn-outline-secondary disabled" data-nav="anterior" aria-disabled="true"
                              data-bs-toggle="tooltip" title="Esta é a primeira unidade da carteira">‹</span>
                        {% endif %}
                        {% if objeto.objetoProximoId %}
                        <a href="{{ path('cobranca_objeto_show', {id: objeto.objetoProximoId}) }}"
                           class="btn btn-outline-secondary" data-nav="proximo"
                           data-bs-toggle="tooltip" title="Próxima unidade da carteira"
                           aria-label="Próxima unidade da carteira">›</a>
                        {% else %}
                        <span class="btn btn-outline-secondary disabled" data-nav="proximo" aria-disabled="true"
                              data-bs-toggle="tooltip" title="Esta é a última unidade da carteira">›</span>
                        {% endif %}
                    </div>
                </div>

                {# Linha meta (§1.1). `Matrícula` da maquete NÃO entra: o sistema tem `referenciaExterna`,
                   que é genérica e nem sempre é matrícula — decisão do dono. #}
                <div class="cob-cab-meta text-secondary small">
                    {% if objeto.descricao %}{{ objeto.descricao }} · {% endif %}
                    <span data-meta="obrigacoes-em-aberto">{{ caso.obrigacoesEmAbertoQtd }} {{ caso.obrigacoesEmAbertoQtd == 1 ? 'obrigação' : 'obrigações' }} em aberto</span>
                    {% if caso.pastaJudicialId %} · <a href="{{ path('pasta_show', {id: caso.pastaJudicialId}) }}"><i class="bi bi-folder-symlink me-1"></i>Pasta judicial</a>{% endif %}
                </div>

                {# ── Os quatro cards que SOMAM ENTRE SI (§1.2) ────────────────────────────────────────
                   Principal + Juros e multa + Honorários = Total atualizado, por construção no
                   `MontarDetalheCasoUseCase` (é dinheiro: soma-se onde há teste, nunca no Twig).

                   ⚠️ `totalAtualizadoEmAberto` é o valor BRUTO — principal + encargos + honorários das
                   obrigações em aberto, SEM abater o que já foi recebido. Não é o `saldoExigivel` da
                   linha fina abaixo, que é líquido de pagamentos e é quem governa o encerramento. São
                   contas diferentes com resultados diferentes, e as duas ficam na tela de propósito.
                   Trocar uma pela outra aqui faz o gestor conferir o número errado. #}
                <div class="cob-cab-cards mt-3">
                    <div class="cob-cab-card" data-card="principal">
                        <span class="cob-cab-card-rot">Principal</span>
                        <span class="cob-cab-card-val">{{ caso.totalPrincipalEmAberto|centavos }}</span>
                    </div>
                    <div class="cob-cab-card" data-card="encargos">
                        <span class="cob-cab-card-rot" data-bs-toggle="tooltip" title="Juros, multa e correção monetária das obrigações em aberto.">Juros e multa</span>
                        <span class="cob-cab-card-val">{{ caso.totalEncargosEmAberto|centavos }}</span>
                    </div>
                    <div class="cob-cab-card" data-card="honorarios">
                        <span class="cob-cab-card-rot">Honorários</span>
                        <span class="cob-cab-card-val">{{ caso.honorariosEmAberto|centavos }}</span>
                    </div>
                    <div class="cob-cab-card is-total" data-card="total">
                        <span class="cob-cab-card-rot" data-bs-toggle="tooltip" title="Valor bruto das obrigações em aberto (principal + encargos + honorários), antes de abater pagamentos.">Total atualizado</span>
                        <span class="cob-cab-card-val">{{ caso.totalAtualizadoEmAberto|centavos }}</span>
                        {% if caso.totaisAtualizadosEm %}
                        <span class="cob-cab-card-nota">atualizado em {{ caso.totaisAtualizadosEm|date('d/m/Y') }}</span>
                        {% endif %}
                    </div>
                </div>

                {# Linha fina com os DOIS valores que o cabeçalho já mostrava (§1.2). `Total em aberto` é o
                   saldo exigível, líquido de pagamentos — é ele que governa o botão `Encerrar cobrança`. #}
                <div class="cob-resumo mt-2">
                    <div class="cob-resumo-item">
                        <span class="cob-resumo-label" data-bs-toggle="tooltip" title="Saldo exigível: obrigações exigíveis menos pagamentos e liquidações (SPEC §10).">Total em aberto</span>
                        <span class="cob-resumo-valor {{ caso.saldoExigivel == 0 and not caso.encerrado ? 'saldo-zerado' : '' }}">{{ caso.saldoExigivel|centavos }}</span>
                    </div>
                    <div class="cob-resumo-item">
                        <span class="cob-resumo-label">Total vencido</span>
                        <span class="cob-resumo-valor {{ caso.saldoVencido > 0 ? 'is-vencido' : '' }}">{{ caso.saldoVencido|centavos }}</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5 cob-cab-lateral">
                {# ── Prescrição (§1.3): o elemento dominante do cabeçalho ──────────────────────────────
                   `caso.prescricao` é `null` quando não há obrigação em aberto — e aí a caixa nem nasce,
                   porque não há o que prescrever. A severidade, o prazo e os dias vêm prontos do
                   `CalculadoraPrescricao`; o template só escolhe a cor e a frase. #}
                {% if caso.prescricao %}
                {% set presc = caso.prescricao %}
                {% set sevClasse = {'esgotada': 'sev-danger', 'critica': 'sev-danger', 'atencao': 'sev-warning'}[presc.severidade]|default('sev-info') %}
                <div class="cob-presc {{ sevClasse }}" data-severidade="{{ presc.severidade }}">
                    <div class="cob-presc-topo">
                        <i class="bi {{ presc.esgotada ? 'bi-x-octagon' : 'bi-hourglass-split' }}"></i>
                        <span class="cob-presc-rotulo">Prescrição</span>
                    </div>
                    <div class="cob-presc-destaque">
                        {% if presc.esgotada %}
                            Prazo esgotado em {{ presc.prazoLimite|date('d/m/Y') }}
                        {% else %}
                            Faltam {{ presc.diasRestantes }} {{ presc.diasRestantes == 1 ? 'dia' : 'dias' }}
                        {% endif %}
                    </div>
                    <div class="cob-presc-detalhe small">
                        Competência mais antiga em aberto: <strong>{{ presc.obrigacaoDescricao }}</strong>,
                        vencida em {{ presc.vencimentoMaisAntigo|date('d/m/Y') }}.
                        Prazo de {{ presc.prazoAnos }} anos → limite em {{ presc.prazoLimite|date('d/m/Y') }}.
                    </div>
                    {# Aviso OBRIGATÓRIO (§1.3): o sistema conta dias, não emite parecer. Sem esta linha a
                       tela sugere uma certeza jurídica que o cálculo não tem — ele desconhece interrupção
                       e suspensão do prazo. Não remova sem ler a nota da `CalculadoraPrescricao`. #}
                    <div class="cob-presc-aviso small">
                        <i class="bi bi-info-circle me-1"></i>Estimativa a partir do vencimento mais antigo em aberto.
                        Não considera marcos de interrupção ou suspensão — confira antes de ajuizar.
                    </div>
                    {# Mesmo mecanismo `data-abrir-aba` dos alertas do topo: o alvo mora dentro de um pane
                       oculto, e navegador nenhum rola até elemento invisível. #}
                    <a href="#secao-divida" data-abrir-aba="divida" class="btn btn-sm btn-outline-secondary cob-presc-link">Ver competência</a>
                </div>
                {% endif %}

                {# ── Barra de ações (§1.4) ─────────────────────────────────────────────────────────────
                   `Simular acordo` e `Planilha atualizada` NÃO EXISTEM no sistema: entram desabilitados
                   com tooltip dizendo isso, em vez de virarem links que quebram. O dono decide depois o
                   que fazem. Tooltip em elemento `disabled` não dispara — daí o `<span>` de fora, mesmo
                   padrão que o `Encerrar cobrança` desabilitado já usava. Os três pontinhos da maquete
                   saíram: não há o que colocar neles. #}
                <div class="cob-cab-acoes mt-3 d-flex gap-2 flex-wrap">
                    {% if podeGerenciar %}
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalRegistrarTentativa">
                        <i class="bi bi-telephone me-1"></i>Registrar contato
                    </button>
                    {% endif %}
                    <span class="d-inline-block" data-bs-toggle="tooltip" title="Ainda não tem função — será definida com o gestor.">
                        <button type="button" class="btn btn-sm btn-outline-secondary is-disabled" data-acao="simular-acordo" disabled>
                            <i class="bi bi-calculator me-1"></i>Simular acordo
                        </button>
                    </span>
                    <span class="d-inline-block" data-bs-toggle="tooltip" title="Ainda não tem função — será definida com o gestor.">
                        <button type="button" class="btn btn-sm btn-outline-secondary is-disabled" data-acao="planilha-atualizada" disabled>
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Planilha atualizada
                        </button>
                    </span>
                    {# Ações de SITUAÇÃO (raras) seguem no cabeçalho, junto do status que elas mudam —
                       mesmos gates e mesmos modais de sempre. #}
                    {% if podeGerenciar %}
                        {% if can_access_module('pastas') and not caso.pastaJudicialId %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalJudicializar">
                            <i class="bi bi-bank me-1"></i>Judicializar
                        </button>
                        {% endif %}
                        {# Espelha o guard do servidor (`EncerrarCasoUseCase`: só encerra com saldo exigível
                           zerado). Desabilitado, o botão ENSINA a condição em vez de falhar após o clique. #}
                        {% if caso.prontoParaEncerrar %}
                        <button type="button" class="btn btn-sm btn-outline-danger cob-acao-encerrar" data-bs-toggle="modal" data-bs-target="#modalEncerrarCaso">
                            <i class="bi bi-flag me-1"></i>Encerrar cobrança
                        </button>
                        {% else %}
                        <span class="d-inline-block" data-bs-toggle="tooltip"
                              title="Só é possível encerrar com o total em aberto zerado. Faltam {{ caso.saldoExigivel|centavos }}.">
                            <button type="button" class="btn btn-sm btn-outline-secondary cob-acao-encerrar is-disabled" disabled>
                                <i class="bi bi-flag me-1"></i>Encerrar cobrança
                            </button>
                        </span>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content mt-3">
    <div class="container-fluid">
        {# O hero do dinheiro (Ajuste 11) subiu para o cabeçalho como `.cob-resumo` (SPEC UX §6.1) e o
           bloco de honorários virou a aba Honorários. `Editar configuração de encargos` continua sendo
           ação do contexto financeiro — agora dentro da aba Dívida (SPEC UX §14.1).

           Alertas e barra de atividades ficam FORA da grade de 2 colunas, em largura total. Dentro da
           coluna principal (≈740px em 1280) as 9 opções quebravam em três linhas — exatamente a "quebra
           desorganizada" que a SPEC §6.4 proíbe. Em largura total elas cabem numa linha só, e a SPEC §6.2
           pede a barra "logo abaixo do cabeçalho" de qualquer forma. #}

        {# ── Alertas (derivados, read-only — SPEC §14) ──────────────
           O alerta continua só CONTANDO o que há (invariável 28: o sistema alerta, o humano decide), mas
           agora leva ao lugar onde se resolve, em vez de ser texto morto no topo da página. #}
        {% if caso.alertas|length > 0 %}
        <div class="mb-3">
            {% for alerta in caso.alertas %}
            <div class="jp-alerta {{ alerta.tipo.badgeClass|replace({'text-bg-': 'sev-'}) }}">
                <i class="bi {{ alerta.tipo.icone }}"></i>
                <span>{{ alerta.descricao }}</span>
                {% if alerta.tipo.value in ['obrigacao_vencida', 'parcela_acordo_vencida'] %}
                <div class="jp-alerta-acoes">
                    {# `#secao-divida` mora DENTRO da aba Dívida. Antes da reorganização a seção estava
                       sempre na página e o link rolava até ela; agora a aba nasce oculta, e navegador
                       nenhum rola até elemento invisível — o botão virava clique morto. O
                       `data-abrir-aba` faz o JS ativar a aba antes de rolar. O `href` continua sendo o
                       alvo da rolagem (e o destino natural se o JS não rodar). #}
                    <a href="#secao-divida" data-abrir-aba="divida" class="btn btn-sm btn-outline-secondary">Ver na dívida</a>
                </div>
                {% elseif alerta.tipo.value == 'acao_atrasada' and podeGerenciar %}
                <div class="jp-alerta-acoes">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalConcluirAcao">Concluir</button>
                </div>
                {% elseif alerta.tipo.value == 'pronto_para_encerrar' and podeGerenciar %}
                <div class="jp-alerta-acoes">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEncerrarCaso">Encerrar cobrança</button>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {# ── Barra de atividades (SPEC UX §6.2) ─────────────────────────────────────────────────────
           Uma região só reúne o que antes estava espalhado entre abas, cabeçalho, trilho e card da
           pessoa. Dois comportamentos convivem: item de CONTEÚDO troca o painel (aba Bootstrap); item de
           AÇÃO abre o modal/collapse que já existia. Nenhuma rota, modal ou permissão mudou — só o lugar
           do gatilho. Ordem e rótulos vêm da SPEC; `id="objetoTabs"` é preservado porque o JS do `?aba=`
           e o `pasta-arquivos.js` dependem dele. #}
        <ul class="nav nav-tabs cob-barra" id="objetoTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-cobranca" type="button">
                    <i class="bi bi-pencil-square me-1"></i>Cobrança
                </button>
            </li>
            {# `id="documentos-tab"`: o pasta-arquivos.js usa este id para restaurar a aba após o upload. #}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="documentos-tab" data-bs-toggle="tab" data-bs-target="#tab-documentos" type="button">
                    <i class="bi bi-folder me-1"></i>Documentos <span class="badge text-bg-secondary">{{ arquivosFm|length }}</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="historico-tab" data-bs-toggle="tab" data-bs-target="#tab-historico" type="button">
                    <i class="bi bi-clock-history me-1"></i>Histórico <span class="badge text-bg-secondary">{{ caso.historico|length }}</span>
                </button>
            </li>
            {# "Ficha completa" virou "Responsáveis", e agora é ÁREA DE CONTEÚDO, não link para outra
               página: a aba reúne a lista de vinculados, a troca de responsável e o acesso à ficha —
               as três coisas que antes viviam em lugares diferentes. Sem gate de capacidade, como o
               antigo "Envolvidos": ver quem responde pela unidade é leitura; as ações lá dentro
               mantêm cada uma o seu gate. #}
            <li class="nav-item cob-item-extra" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-responsaveis" type="button">
                    <i class="bi bi-people me-1"></i>Responsáveis <span class="badge text-bg-secondary">{{ objeto.vinculos|length }}</span>
                </button>
            </li>
            {# `Registrar contato` SAIU daqui: a spec do cabeçalho (§1.4) o coloca na barra de ações, junto
               das outras quatro. Mantê-lo nos dois lugares poria o MESMO gatilho do mesmo modal duas vezes
               na mesma dobra — a barra volta a ser só o que ela deve ser, áreas de CONTEÚDO. #}
            <li class="nav-item cob-item-extra" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-divida" type="button">
                    <i class="bi bi-cash-coin me-1"></i>Dívida
                </button>
            </li>
            <li class="nav-item cob-item-extra" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-honorarios" type="button">
                    <i class="bi bi-percent me-1"></i>Honorários
                </button>
            </li>

            {# Estreito (SPEC UX §6.4): Cobrança, Registrar contato, Documentos e Histórico continuam
               visíveis; o resto recolhe aqui em vez de quebrar a barra em várias linhas. O corte desceu
               para 1200px porque a barra encolheu de 9 para 7 opções (ver a medição em cobrancas.css). #}
            <li class="nav-item dropdown cob-mais d-xl-none" role="presentation">
                <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots me-1"></i>Mais ações
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button class="dropdown-item" type="button" data-bs-toggle="tab" data-bs-target="#tab-responsaveis"><i class="bi bi-people me-2"></i>Responsáveis <span class="badge text-bg-secondary">{{ objeto.vinculos|length }}</span></button></li>
                    <li><button class="dropdown-item" type="button" data-bs-toggle="tab" data-bs-target="#tab-divida"><i class="bi bi-cash-coin me-2"></i>Dívida</button></li>
                    <li><button class="dropdown-item" type="button" data-bs-toggle="tab" data-bs-target="#tab-honorarios"><i class="bi bi-percent me-2"></i>Honorários</button></li>
                </ul>
            </li>
        </ul>
        {# Coluna única: o trilho direito (card da pessoa + próxima ação) saiu, e o conteúdo passou a
           ocupar a largura toda. A dívida e o histórico são as duas coisas que mais sofriam com a
           coluna estreita. #}
        <div class="tab-content border rounded p-3 bg-body">
            {# ── Cobrança: a anotação é a atividade inicial da página (SPEC UX §7). O editor é o primeiro
               elemento útil; as anotações recentes vêm logo abaixo. O histórico completo (com os eventos
               automáticos) continua na sua própria opção. ── #}
            <div class="tab-pane fade show active" id="tab-cobranca">
                {# ── Próxima ação, compacta ── Saiu do cartão do trilho e virou uma FAIXA de uma linha
                   aqui, onde o trabalho do dia acontece. Mesmo conteúdo e mesmos gatilhos
                   (#modalConcluirAcao / #modalDefinirAcao) — só o formato mudou. ── #}
                <div class="cob-proxima-faixa {{ caso.proximaAcao and caso.proximaAcao.atrasada ? 'atrasada' : '' }}">
                    <i class="bi {{ caso.proximaAcao ? 'bi-flag-fill' : 'bi-dash-circle' }}"></i>
                    <span class="cob-proxima-rotulo">Próxima ação{% if caso.proximaAcao and caso.proximaAcao.atrasada %} · <span class="text-warning-emphasis fw-semibold">atrasada</span>{% endif %}</span>
                    {% if caso.proximaAcao %}
                        <span class="cob-proxima-texto">{{ caso.proximaAcao.descricao }}</span>
                        {% if caso.proximaAcao.prazo %}
                        <span class="cob-proxima-prazo">Prazo: {{ caso.proximaAcao.prazo|date('d/m/Y') }}{% if caso.proximaAcao.responsavelNome %} · {{ caso.proximaAcao.responsavelNome }}{% endif %}</span>
                        {% endif %}
                        {% if podeGerenciar %}
                        <button type="button" class="btn btn-sm jp-btn-accent py-0 ms-auto flex-shrink-0" data-bs-toggle="modal" data-bs-target="#modalConcluirAcao">Concluir</button>
                        {% endif %}
                    {% else %}
                        <span class="cob-proxima-texto text-secondary">Nenhuma ação definida</span>
                        {% if podeGerenciar %}
                        <button type="button" class="btn btn-sm jp-btn-outline py-0 ms-auto flex-shrink-0" data-bs-toggle="modal" data-bs-target="#modalDefinirAcao">Definir</button>
                        {% endif %}
                    {% endif %}
                </div>

                {% if podeGerenciar and not caso.encerrado and forms.registrarAnotacao is defined %}
                <div class="cob-anotacao-nova mb-4">
                    <h6 class="mb-2"><i class="bi bi-pencil-square me-1"></i>Nova anotação</h6>
                    {{ form_start(forms.registrarAnotacao, {action: path('cobranca_anotacao_registrar', {id: caso.id}), attr: {class: 'js-form-anotacao'}}) }}
                    {{ form_widget(forms.registrarAnotacao.texto) }}
                    {{ form_errors(forms.registrarAnotacao.texto) }}
                    <div class="d-flex justify-content-end mt-2">
                        <button type="submit" class="btn jp-btn-accent js-salvar-anotacao">
                            <i class="bi bi-check-lg me-1"></i>Salvar anotação
                        </button>
                    </div>
                    {{ form_end(forms.registrarAnotacao) }}
                </div>
                {% endif %}

                {# Anotações da cobrança (SPEC UX §8): só as anotações livres — eventos automáticos não
                   entram aqui, porque não são editáveis nem excluíveis.

                   Aparecem TODAS, com rolagem dentro do bloco (`.cob-anotacoes`) em vez do corte nas 10
                   mais novas que existia antes: procurar uma anotação antiga não deve exigir trocar para
                   o Histórico, onde ela some no meio dos eventos automáticos. Nada muda em consulta —
                   `EventoHistoricoRepository::doCaso` sempre trouxe o histórico inteiro; o corte era só
                   de exibição. `tabindex="0"` porque região rolável tem de ser alcançável pelo teclado. #}
                {% set anotacoes = caso.historico|filter(e => e.tipoValue == 'anotacao') %}
                <h6 class="mb-2">
                    <i class="bi bi-chat-left-text me-1"></i>Anotações
                    {% if anotacoes|length > 0 %}<span class="badge text-bg-secondary">{{ anotacoes|length }}</span>{% endif %}
                </h6>
                {% if anotacoes|length > 0 %}
                <ul class="cob-anotacoes" tabindex="0" role="region" aria-label="Anotações da cobrança">
                    {% for e in anotacoes %}
                    <li class="cob-anotacao">
                        <div class="d-flex align-items-center gap-2 cob-anotacao-topo">
                            <span class="cob-anotacao-autor">{{ e.usuarioNome|default('Sistema') }}</span>
                            <span class="cob-anotacao-data">{{ e.ocorridoEm|date('d/m/Y H:i') }}</span>
                            {% if e.editadoEm %}<span class="badge text-bg-secondary">Editada</span>{% endif %}
                            {{ include('cobranca/objeto/_partials/_anotacao_acoes.html.twig', {e: e}) }}
                        </div>
                        <div class="cob-anotacao-corpo">
                            <span class="editor-rico-conteudo"><span class="ql-editor">{{ e.descricao|texto_rico }}</span></span>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-muted mb-0 py-3">Nenhuma anotação ainda. Use o campo acima para registrar o que aconteceu.</p>
                {% endif %}
            </div>

            {# ── Dívida: a composição financeira e o que já entrou (SPEC UX §14.1) — o mesmo conteúdo de
               antes, agora com opção própria na barra. ── #}
            <div class="tab-pane fade" id="tab-divida">
                {% if podeGerenciar and formConfigEncargos %}
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-sm jp-btn-outline" data-bs-toggle="modal" data-bs-target="#modalConfigEncargosObjeto">
                        <i class="bi bi-pencil me-1"></i>Editar configuração de encargos
                    </button>
                </div>
                {% endif %}
                {{ include('cobranca/objeto/_partials/_divida.html.twig') }}
                {{ include('cobranca/objeto/_partials/_movimentos.html.twig') }}
            </div>

            {# ── Responsáveis: quem responde pela unidade, com troca de responsável e acesso à ficha ── #}
            <div class="tab-pane fade" id="tab-responsaveis">
                {{ include('cobranca/objeto/_partials/_responsaveis.html.twig') }}
            </div>

            {# ── Honorários (SPEC UX §14.2): aba só de leitura, montada com o que o sistema JÁ calcula. ── #}
            <div class="tab-pane fade" id="tab-honorarios">
                {{ include('cobranca/objeto/_partials/_honorarios.html.twig') }}
            </div>

            {# Documentos (file manager religado na Onda 8C — reusa pasta-arquivos.js sem editá-lo) #}
            <div class="tab-pane fade" id="tab-documentos">
                {{ include('cobranca/caso/_documentos.html.twig') }}
            </div>

            {# Histórico (timeline — SPEC §13): todos os eventos, na ordem de sempre. #}
            <div class="tab-pane fade" id="tab-historico">
                {% if caso.historico|length > 0 %}
                <ul class="caso-timeline">
                    {# Sem `|reverse`: a ordem vem pronta do repositório (mais recente primeiro).
                       Antes eram DOIS lugares decidindo a ordem — consulta em ASC e inversão aqui —,
                       e mexer só num deles invertia a lista sem querer. #}
                    {% for e in caso.historico %}
                    <li class="caso-timeline-item">
                        <div class="caso-timeline-tipo d-flex align-items-center gap-2">
                            <span>{{ e.tipoLabel }}</span>
                            {% if e.editadoEm %}<span class="text-muted fst-italic fw-normal">(editado)</span>{% endif %}
                            {# `editavel` vem decidido do SERVIDOR (anotação própria, dentro das 48h) — o
                               template não recalcula prazo nem compara autoria, senão tela e servidor
                               poderiam discordar. Passada a janela, os botões somem sozinhos. #}
                            {{ include('cobranca/objeto/_partials/_anotacao_acoes.html.twig', {e: e}) }}
                        </div>
                        <div>
                            {% if e.tipoValue == 'anotacao' %}
                                {# Escrita por uma pessoa no editor rico. #}
                                <span class="editor-rico-conteudo"><span class="ql-editor">{{ e.descricao|texto_rico }}</span></span>
                            {% else %}
                                {# Evento gerado pelo sistema: segue escapado.

                                   `contato_realizado` chegou a passar por `texto_rico` nesta frente e
                                   VOLTOU para `nl2br`: o discriminador do sanitizador trata qualquer
                                   texto com `<` como HTML, e relato legado em texto puro perde o trecho.
                                   Medido no sanitizador real: "cliente diz valor < 500 nao paga" sai
                                   "cliente diz valor  500 nao paga"; "e-mail <fulano@x.com> confirmado"
                                   sai "e-mail ". O dev tem 4 contatos e nenhum com `<` — amostra que não
                                   autoriza concluir nada sobre produção. #}
                                {{ e.descricao|nl2br }}
                            {% endif %}
                        </div>
                        <div class="caso-timeline-meta">{{ e.ocorridoEm|date('d/m/Y H:i') }}{% if e.usuarioNome %} · {{ e.usuarioNome }}{% endif %}</div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}<p class="text-muted mb-0 text-center py-3">Sem eventos no histórico.</p>{% endif %}
            </div>
        </div>

        {# O trilho direito acabou: o card da pessoa virou a aba Responsáveis e a próxima ação virou a
           faixa compacta no topo da aba Cobrança. "Ações do caso" (Judicializar/Encerrar) já morava no
           cabeçalho desde a reorganização anterior. #}
    </div>
</section>

