{% block javascripts %}
{{ parent() }}
{% if podeAgir %}
{{ catalogo_js('cobranca_objeto.js') }}
<script>
/* Editor de parcelas do acordo (ajuste 7, fatia 4). Mesma mecânica do gerador da criação: as linhas
   NÃO-fixadas redistribuem o restante para fechar o total; as parcelas PAGAS nascem fixadas e nunca
   são recalculadas (o servidor as congela — INV-C). Valores em pt-BR (vírgula), como o parseCentavos
   e o CentavosType esperam. O servidor revalida INV-B: este JS é só afordância. */
document.addEventListener('DOMContentLoaded', function () {
    var container = document.getElementById('parcelasEdicaoContainer');
    if (!container) { return; }
    var form = container.closest('form');
    var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
    var totalInput = document.querySelector('#modalEditarAcordo input[data-acordo-total]');
    var fechamentoBox = document.querySelector('#modalEditarAcordo [data-acordo-fechamento]');

    function parseCentavos(str) {
        if (!str) { return 0; }
        var s = String(str).trim().replace(/\s/g, '').replace(/\./g, '').replace(',', '.');
        var f = parseFloat(s);
        return isNaN(f) ? 0 : Math.round(f * 100);
    }
    function fmtReais(cent) {
        return 'R$ ' + (cent / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }
    function reaisInput(cent) { return (cent / 100).toFixed(2).replace('.', ','); }
    function valorInputDe(row) { return row.querySelector('input[name$="[valor]"]'); }
    function linhas() { return Array.prototype.slice.call(container.querySelectorAll('.parcela-linha')); }

    function atualizarFechamento() {
        var total = parseCentavos(totalInput ? totalInput.value : '');
        var rows = linhas();
        if (total <= 0) {
            if (fechamentoBox) { fechamentoBox.textContent = ''; }
            if (submitBtn) { submitBtn.disabled = false; }
            return;
        }
        var soma = 0;
        var todasPositivas = rows.length > 0;
        rows.forEach(function (r) {
            var v = parseCentavos(valorInputDe(r).value);
            soma += v;
            if (v <= 0) { todasPositivas = false; }
        });
        var fecha = soma === total && todasPositivas;
        if (fechamentoBox) {
            fechamentoBox.classList.toggle('text-danger', !fecha);
            fechamentoBox.classList.toggle('text-success', fecha);
            fechamentoBox.textContent = fecha
                ? BJ_T.t('cobranca_objeto.js.acordo.fecham_em', {total: fmtReais(total)})
                : BJ_T.t('cobranca_objeto.js.acordo.nao_fecham', {soma: fmtReais(soma), total: fmtReais(total)});
        }
        if (submitBtn) { submitBtn.disabled = !fecha; }
    }

    function redistribuir() {
        var total = parseCentavos(totalInput ? totalInput.value : '');
        if (total <= 0) { atualizarFechamento(); return; }
        var rows = linhas();
        var naoFixas = rows.filter(function (r) { return r.dataset.fixada !== '1'; });
        var somaFixas = rows.filter(function (r) { return r.dataset.fixada === '1'; })
            .reduce(function (s, r) { return s + parseCentavos(valorInputDe(r).value); }, 0);
        var restante = total - somaFixas;
        if (naoFixas.length) {
            var base = Math.trunc(restante / naoFixas.length);
            var resto = restante - base * naoFixas.length;
            naoFixas.forEach(function (r, i) {
                valorInputDe(r).value = reaisInput(base + (i === 0 ? resto : 0));
            });
        }
        atualizarFechamento();
    }

    // Adicionar linha nova (sem obrigacaoId → o servidor cria a parcela).
    var addBtn = document.getElementById('addParcelaEdicao');
    if (addBtn) {
        addBtn.addEventListener('click', function () {
            var index = parseInt(container.dataset.index || '0', 10);
            var html = (container.dataset.prototype || '').replace(/__name__/g, index);
            var row = document.createElement('div');
            row.className = 'parcela-linha border rounded p-2 mb-2';
            row.innerHTML = html + '<button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">' + BJ_T.t('cobranca_objeto.js.remover') + '</button>';
            container.appendChild(row);
            container.dataset.index = (index + 1).toString();
            atualizarFechamento();
        });
    }
    container.addEventListener('click', function (e) {
        var btn = e.target.closest('.remover-linha');
        if (!btn) { return; }
        var row = btn.closest('.parcela-linha');
        // Defesa: a travada não tem botão de remover, mas nunca deixe sumir por acidente.
        if (row && row.dataset.travada !== '1') { row.remove(); redistribuir(); }
    });
    container.addEventListener('input', function (e) {
        var input = e.target.closest('input[name$="[valor]"]');
        if (!input) { return; }
        var row = input.closest('.parcela-linha');
        if (row) { row.dataset.fixada = '1'; }
        redistribuir();
    });
    if (totalInput) { totalInput.addEventListener('input', redistribuir); }

    /* Cadeado honesto: a linha travada é reenviada intacta (o servidor conta com isso), então os
       campos ficam somente-leitura em vez de só exibirem o aviso. */
    container.querySelectorAll('.parcela-linha[data-travada="1"] input').forEach(function (input) {
        if (input.type !== 'hidden') { input.readOnly = true; }
    });

    var modal = document.getElementById('modalEditarAcordo');
    if (modal) { modal.addEventListener('shown.bs.modal', atualizarFechamento); }
});
</script>
{% endif %}
{% endblock %}
