{% extends 'base.html.twig' %}

{# ⚠️ `dataAcordo` é ANULÁVEL e `{{ null|date(...) }}` imprime a data de HOJE (verificado 17/08) —
   toda leitura dela nesta tela passa por guarda explícita. Sem isso a view inventa data sozinha, sem
   erro, e nenhum teste pega: a suíte lê HTML, e "17/08/2026" é HTML válido. #}
{% block title %}{{ 'cobranca_objeto.acordo.titulo_pagina'|trans({acordo: acordo.dataAcordo ? 'cobranca_objeto.acordo.titulo_data'|trans({data: acordo.dataAcordo|data}) : 'cobranca_objeto.acordo.titulo_sem_data'|trans}) }}{% endblock %}

{% block body %}
{# Detalhe do acordo (ajuste 7, fatia 3): leitura. Total/entrada vêm do snapshot da negociação;
   desconto/juros e o "pago" de cada parcela são DERIVADOS (invariável 20). #}
<div class="cobrancas-page">
<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <a href="{{ path('cobranca_objeto_show', {id: acordo.objetoId}) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'cobranca_objeto.acordo.voltar'|trans }}"><i class="bi bi-arrow-left"></i></a>
            <h1 class="m-0 d-flex align-items-center gap-2"><i class="bi bi-file-earmark-text"></i>{% if acordo.dataAcordo %}{{ 'cobranca_objeto.acordo.titulo_data'|trans({data: acordo.dataAcordo|data}) }}{% else %}{{ 'cobranca_objeto.acordo.titulo_sem_data'|trans }}{% endif %}</h1>
            {#- O texto depende de o acordo estar VIGENTE. Num acordo rompido/cancelado as originais
                voltaram ao saldo e são hidratadas ao vivo — falar em "sem calcular" ali seria falso, e
                contradiria o próprio aviso "Acordo desfeito" logo abaixo nesta mesma tela (achado da 4ª
                revisão: a rodada anterior consertou o ramo que governa zero linhas e deixou este). -#}
            {%- if not acordo.dataAcordo %}
            <span class="badge text-bg-warning jp-acordo-sem-data" title="{% if acordo.vigente %}{{ 'cobranca_objeto.acordo.sem_data_dica_vigente'|trans }}{% else %}{{ 'cobranca_objeto.acordo.sem_data_dica_desfeito'|trans }}{% endif %}">
                <i class="bi bi-exclamation-triangle"></i> {{ 'cobranca_objeto.acordo.sem_data'|trans }}
            </span>
            {%- endif %}
            <span class="badge {{ acordo.statusBadgeClass }}">{{ acordo.statusLabel }}</span>
            {% if acordo.estaIncompleto %}
            <span class="badge text-bg-warning" title="{{ 'cobranca_objeto.acordo.incompleto_dica'|trans }}">
                <i class="bi bi-exclamation-triangle me-1"></i>{{ (1 < acordo.parcelasFaltantes ? 'cobranca_objeto.acordo.faltam_parcelas' : 'cobranca_objeto.acordo.faltam_parcela')|trans({n: acordo.parcelasFaltantes ~ ''}) }}
            </span>
            {% endif %}
            {% if podeAgir %}
            {# Barra de ações (fatia 4): só acordo ativo, caso aberto e quem tem a capacidade. #}
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalEditarAcordo">
                    <i class="bi bi-pencil me-1"></i>{{ 'cobranca_objeto.acordo.editar'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalCumprirAcordoDetalhe">
                    <i class="bi bi-check2-all me-1"></i>{{ 'cobranca_objeto.acordo.marcar_cumprido'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalRomperAcordoDetalhe">
                    <i class="bi bi-x-octagon me-1"></i>{{ 'cobranca_objeto.acordo.romper'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#modalCancelarAcordoDetalhe">
                    <i class="bi bi-slash-circle me-1"></i>{{ 'cobranca_objeto.comum.cancelar'|trans }}
                </button>
            </div>
            {% endif %}
        </div>
        {% if acordo.motivoRompimento or acordo.motivoCancelamento %}
        <p class="text-muted small mb-0">{{ 'cobranca_objeto.acordo.motivo'|trans({motivo: acordo.motivoRompimento ?: acordo.motivoCancelamento}) }}</p>
        {% endif %}
        {% if not acordo.vigente %}
        <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>{{ 'cobranca_objeto.acordo.desfeito'|trans }}</p>
        {% endif %}
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# ── Abas: Resumo / Documentos (Ajuste #4) ─────────────────── #}
        <ul class="nav nav-tabs" id="acordoTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-acordo-resumo" type="button">
                    <i class="bi bi-info-circle me-1"></i>{{ 'cobranca_objeto.acordo.aba_resumo'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-acordo-documentos" type="button">
                    <i class="bi bi-paperclip me-1"></i>{{ 'cobranca_objeto.acordo.aba_documentos'|trans }} <span class="badge text-bg-secondary">{{ documentos|length }}</span>
                </button>
            </li>
        </ul>
        <div class="tab-content border border-top-0 rounded-bottom p-3 bg-body">
        <div class="tab-pane fade show active" id="tab-acordo-resumo">
        {# ── Resumo da negociação ── #}
        <div class="row g-2 mb-3">
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="text-muted small">{{ 'cobranca_objeto.acordo.total_negociado'|trans }}</div>
                    <div class="fs-5 fw-semibold">{{ acordo.valorTotalNegociado|centavos }}</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="text-muted small">{{ 'cobranca_objeto.acordo.entrada'|trans }}</div>
                    <div class="fs-5 fw-semibold">{% if acordo.valorEntrada > 0 %}{{ acordo.valorEntrada|centavos }}{% else %}<span class="text-muted small">{{ 'cobranca_objeto.acordo.sem_entrada'|trans }}</span>{% endif %}</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="text-muted small">{{ 'cobranca_objeto.acordo.divida_substituida'|trans }}</div>
                    {# NÃO APURÁVEL quando alguma substituída está sem encargo calculado (acordo sem data):
                       a soma sairia de resíduo de hidratação, número inventado com cara de conta. #}
                    {% if acordo.valorSubstituidas is null %}
                    <div class="fs-5 fw-semibold jp-sem-data"><span class="jp-enc-motivo">{{ 'cobranca_objeto.acordo.motivo_sem_data'|trans }}</span></div>
                    {% else %}
                    <div class="fs-5 fw-semibold">{{ acordo.valorSubstituidas|centavos }}</div>
                    {% endif %}
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body py-2">
                    {# Sem a Σ das substituídas não há desconto a declarar — e um desconto derivado de
                       resíduo teria sinal, cor e cara de conta fechada. Vira não apurável. #}
                    {% if acordo.valorDesconto is null %}
                    <div class="text-muted small">{{ 'cobranca_objeto.acordo.desconto_concedido'|trans }}</div>
                    <div class="fs-5 fw-semibold jp-sem-data"><span class="jp-enc-motivo">{{ 'cobranca_objeto.acordo.motivo_sem_data'|trans }}</span></div>
                    {% else %}
                    <div class="text-muted small">{{ (acordo.temJuros ? 'cobranca_objeto.acordo.juros_acrescidos' : 'cobranca_objeto.acordo.desconto_concedido')|trans }}</div>
                    <div class="fs-5 fw-semibold {{ acordo.temJuros ? 'text-danger' : 'text-success' }}">
                        {{ (acordo.temJuros ? -acordo.valorDesconto : acordo.valorDesconto)|centavos }}
                    </div>
                    {% endif %}
                </div></div>
            </div>
        </div>

        {# ── Parcelas ── #}
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center">
                <strong><i class="bi bi-list-ol me-1"></i>{{ 'cobranca_objeto.acordo.parcelas'|trans }}</strong>
                <span class="ms-auto text-muted small">{{ 'cobranca_objeto.acordo.pago_ate_agora'|trans({valor: acordo.totalAlocado|centavos}) }}</span>
            </div>
            <div class="card-body p-0">
                {% if acordo.parcelas|length > 0 %}
                <div class="table-responsive"><table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>{{ 'cobranca_objeto.acordo.coluna.descricao'|trans }}</th><th>{{ 'cobranca_objeto.acordo.coluna.vencimento'|trans }}</th><th class="text-end">{{ 'cobranca_objeto.acordo.coluna.valor'|trans }}</th><th class="text-end">{{ 'cobranca_objeto.acordo.coluna.pago'|trans }}</th><th class="text-center">{{ 'cobranca_objeto.acordo.coluna.situacao'|trans }}</th></tr></thead>
                    <tbody>
                    {% for p in acordo.parcelas %}
                    <tr>
                        <td>{{ p.descricao }}</td>
                        <td>{{ p.vencimento|date('d/m/Y') }}</td>
                        <td class="text-end">{{ p.valor|centavos }}</td>
                        <td class="text-end">{% if p.alocado > 0 %}{{ p.alocado|centavos }}{% else %}<span class="text-muted small">{{ 'cobranca_objeto.acordo.sem_pagamento'|trans }}</span>{% endif %}</td>
                        <td class="text-center">
                            {% if p.quitada %}<span class="badge text-bg-success">{{ 'cobranca_objeto.acordo.situacao.quitada'|trans }}</span>
                            {% elseif p.alocado > 0 %}<span class="badge text-bg-warning">{{ 'cobranca_objeto.acordo.situacao.parcial'|trans }}</span>
                            {% else %}<span class="badge text-bg-secondary">{{ 'cobranca_objeto.acordo.situacao.em_aberto'|trans }}</span>{% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                {% else %}<p class="text-muted mb-0 text-center py-3">{{ 'cobranca_objeto.acordo.nenhuma_parcela'|trans }}</p>{% endif %}
            </div>
        </div>

        {# ── Obrigações substituídas ── #}
        <div class="card">
            <div class="card-header"><strong><i class="bi bi-arrow-left-right me-1"></i>{{ 'cobranca_objeto.acordo.substituidas'|trans }}</strong></div>
            <div class="card-body p-0">
                {% if acordo.substituidas|length > 0 %}
                <div class="table-responsive"><table class="table table-sm mb-0">
                    <thead><tr><th>{{ 'cobranca_objeto.acordo.coluna.descricao'|trans }}</th><th>{{ 'cobranca_objeto.acordo.coluna.vencimento'|trans }}</th><th class="text-end">{{ 'cobranca_objeto.acordo.coluna.valor'|trans }}</th></tr></thead>
                    <tbody>
                    {% for o in acordo.substituidas %}
                    <tr>
                        <td>{{ o.descricao }}</td>
                        <td>{{ o.vencimento|date('d/m/Y') }}</td>
                        {# Não calculada: `valor` traz o PRINCIPAL (dado real), e o encargo leva o traço
                           com o motivo NA LINHA — mesmo padrão do `_divida.html.twig`. #}
                        <td class="text-end">{{ o.valor|centavos }}{% if o.encargosNaoCalculados %} <span class="jp-enc-motivo">{{ 'cobranca_objeto.acordo.motivo_sem_data'|trans }}</span>{% endif %}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                <div class="card-footer small text-muted py-2">
                    {{ 'cobranca_objeto.acordo.substituidas_nota'|trans }}
                </div>
                {% else %}<p class="text-muted mb-0 text-center py-3">{{ 'cobranca_objeto.acordo.nenhuma_substituida'|trans }}</p>{% endif %}
            </div>
        </div>
        </div>

        {# ── Documentos do acordo (Ajuste #4) ─────────────────────── #}
        <div class="tab-pane fade" id="tab-acordo-documentos">
            <div class="d-flex justify-content-end mb-2">
                {% if has_permission('resources.cobranca.gerenciar') %}
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalAdicionarDocumentoAcordo">
                    <i class="bi bi-plus-lg me-1"></i>{{ 'cobranca_objeto.acordo.documentos.adicionar'|trans }}
                </button>
                {% endif %}
            </div>
            {% if documentos|length > 0 %}
            <div class="table-responsive"><table class="table table-sm mb-0 align-middle">
                <thead><tr><th>{{ 'cobranca_objeto.acordo.documentos.coluna.data'|trans }}</th><th>{{ 'cobranca_objeto.acordo.documentos.coluna.nome'|trans }}</th><th>{{ 'cobranca_objeto.acordo.documentos.coluna.categoria'|trans }}</th><th>{{ 'cobranca_objeto.acordo.documentos.coluna.observacao'|trans }}</th><th class="text-end" style="width:110px">{{ 'cobranca_objeto.acordo.documentos.coluna.acoes'|trans }}</th></tr></thead>
                <tbody>
                {% for doc in documentos %}
                <tr>
                    <td>{{ doc.carregadoEm|date('d/m/Y H:i') }}</td>
                    <td>{{ doc.nomeOriginal }}</td>
                    <td>{{ doc.categoria.rotulo }}</td>
                    <td class="text-muted small">{{ doc.observacao ?: 'cobranca_objeto.comum.nao_informado'|trans }}</td>
                    <td class="text-end">
                        <a href="{{ path('cobranca_acordo_documento_download', {docId: doc.id}) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'cobranca_objeto.acordo.documentos.baixar'|trans }}">
                            <i class="bi bi-download"></i>
                        </a>
                        {% if has_permission('resources.cobranca.gerenciar') %}
                        <form method="post" action="{{ path('cobranca_acordo_documento_excluir', {docId: doc.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'cobranca_objeto.acordo.documentos.confirmar_excluir'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('cobranca_acordo_documento_excluir_' ~ doc.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'cobranca_objeto.acordo.documentos.excluir'|trans }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table></div>
            {% else %}<p class="text-muted mb-0 text-center py-3">{{ 'cobranca_objeto.acordo.documentos.vazio'|trans }}</p>{% endif %}
        </div>
        </div>
    </div>
</section>

{# ── Adicionar documento do acordo (Ajuste #4; form multipart puro, sem FormType) ── #}
{% if has_permission('resources.cobranca.gerenciar') %}
<div class="modal fade" id="modalAdicionarDocumentoAcordo" tabindex="-1" aria-labelledby="tituloAdicionarDocumentoAcordo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('cobranca_acordo_documento_upload', {id: acordo.id}) }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('cobranca_acordo_documento_upload_' ~ acordo.id) }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloAdicionarDocumentoAcordo"><i class="bi bi-paperclip me-1"></i>{{ 'cobranca_objeto.acordo.documentos.adicionar'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="acordoDocumentoArquivo">{{ 'cobranca_objeto.acordo.documentos.arquivo'|trans }}</label>
                        <input type="file" class="form-control" id="acordoDocumentoArquivo" name="arquivo" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="acordoDocumentoCategoria">{{ 'cobranca_objeto.acordo.documentos.categoria'|trans }}</label>
                        <select class="form-select" id="acordoDocumentoCategoria" name="categoria">
                            {% for c in categoriasAcordo %}
                            <option value="{{ c.value }}">{{ c.rotulo }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="acordoDocumentoObservacao">{{ 'cobranca_objeto.acordo.documentos.observacao'|trans }}</label>
                        <textarea class="form-control" id="acordoDocumentoObservacao" name="observacao" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>{{ 'cobranca_objeto.acordo.documentos.enviar'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

{% if podeAgir %}
{# ── Editar acordo (fatia 4): reajusta as parcelas NÃO pagas; as pagas vêm travadas ── #}
<div class="modal fade" id="modalEditarAcordo" tabindex="-1" aria-labelledby="tituloEditarAcordo" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            {{ form_start(forms.editarAcordo, {action: path('cobranca_acordo_editar', {id: acordo.id})}) }}
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarAcordo"><i class="bi bi-pencil me-1"></i>{{ 'cobranca_objeto.acordo.editar'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button>
            </div>
            <div class="modal-body" id="corpoEditarAcordo">
                <div class="row g-2">
                    <div class="col-sm-6">{{ form_row(forms.editarAcordo.valorTotalNegociado, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}</div>
                </div>
                <div class="form-text mb-2">
                    {{ 'cobranca_objeto.acordo.editar_nota'|trans }}
                </div>
                <label class="form-label">{{ 'cobranca_objeto.acordo.parcelas'|trans }}</label>
                <div id="parcelasEdicaoContainer"
                     data-prototype="{{ form_widget(forms.editarAcordo.parcelas.vars.prototype)|e('html_attr') }}"
                     data-index="{{ forms.editarAcordo.parcelas|length }}">
                    {% for linha in forms.editarAcordo.parcelas %}
                        {% set idParcela = linha.vars.value.obrigacaoId %}
                        {% set trava = parcelasTravadas[idParcela]|default(null) %}
                        <div class="parcela-linha border rounded p-2 mb-2 {{ trava ? 'bg-body-secondary' : '' }}"
                             {% if trava %}data-fixada="1" data-travada="1"{% endif %}>
                            {{ form_widget(linha) }}
                            {% if trava %}
                            <div class="small text-muted mt-1">
                                <i class="bi bi-lock me-1"></i>
                                {%- if trava.tipo == 'pagamento' %}
                                    {{ 'cobranca_objeto.acordo.trava_pagamento'|trans({valor: trava.alocado|centavos}) }}
                                {%- else %}
                                    {{ 'cobranca_objeto.acordo.trava_substituida'|trans }}
                                {%- endif %}
                            </div>
                            {% else %}
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1 remover-linha">{{ 'cobranca_objeto.acordo.remover'|trans }}</button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(forms.editarAcordo.parcelas) }}
                <button type="button" class="btn btn-sm btn-outline-secondary" id="addParcelaEdicao"><i class="bi bi-plus-lg me-1"></i>{{ 'cobranca_objeto.acordo.adicionar_parcela'|trans }}</button>
                <div class="mt-2 small" data-acordo-fechamento></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ 'cobranca_objeto.acordo.salvar_alteracoes'|trans }}</button>
            </div>
            {{ form_end(forms.editarAcordo) }}
        </div>
    </div>
</div>

{# ── Romper ── #}
<div class="modal fade" id="modalRomperAcordoDetalhe" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        {{ form_start(forms.romperAcordo, {action: path('cobranca_acordo_romper', {id: acordo.id})}) }}
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-x-octagon me-1"></i>{{ 'cobranca_objeto.acordo.romper_titulo'|trans }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button></div>
        <div class="modal-body">
            <p class="text-muted small mb-3">{{ 'cobranca_objeto.acordo.romper_texto'|trans }}</p>
            {{ form_row(forms.romperAcordo.motivo) }}
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
            <button type="submit" class="btn btn-danger"><i class="bi bi-x-octagon me-1"></i>{{ 'cobranca_objeto.acordo.romper'|trans }}</button>
        </div>
        {{ form_end(forms.romperAcordo) }}
    </div></div>
</div>

{# ── Cancelar ── #}
<div class="modal fade" id="modalCancelarAcordoDetalhe" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        {{ form_start(forms.cancelarAcordo, {action: path('cobranca_acordo_cancelar', {id: acordo.id})}) }}
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-slash-circle me-1"></i>{{ 'cobranca_objeto.acordo.cancelar_titulo'|trans }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button></div>
        <div class="modal-body">
            <p class="text-muted small mb-3">{{ 'cobranca_objeto.acordo.cancelar_texto'|trans }}</p>
            {{ form_row(forms.cancelarAcordo.motivo) }}
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.fechar'|trans }}</button>
            <button type="submit" class="btn btn-warning"><i class="bi bi-slash-circle me-1"></i>{{ 'cobranca_objeto.acordo.cancelar_titulo'|trans }}</button>
        </div>
        {{ form_end(forms.cancelarAcordo) }}
    </div></div>
</div>

{# ── Cumprir (CSRF manual, sem campos) ── #}
<div class="modal fade" id="modalCumprirAcordoDetalhe" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form method="POST" action="{{ path('cobranca_acordo_cumprir', {id: acordo.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('marcar_cumprido_' ~ acordo.id) }}">
            <div class="modal-header"><h5 class="modal-title">{{ 'cobranca_objeto.acordo.cumprir_titulo'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cobranca_objeto.comum.fechar'|trans }}"></button></div>
            <div class="modal-body">{{ 'cobranca_objeto.acordo.cumprir_texto'|trans }}</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cobranca_objeto.comum.cancelar'|trans }}</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-all me-1"></i>{{ 'cobranca_objeto.acordo.confirmar'|trans }}</button>
