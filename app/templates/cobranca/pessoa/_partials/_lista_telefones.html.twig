{# ───────────────────────────────────────────────────────────────────────────
   Lista de telefones da pessoa (spec §4/§7): linha do tempo `criadoEm ASC`, nunca perde histórico —
   "adicionar" só acrescenta, "marcar atual" só troca a flag (o item anterior permanece na lista).
   Contexto herdado do show: `pessoa` (PessoaFichaOutput) e `formTelefone` (AdicionarTelefoneType).
─────────────────────────────────────────────────────────────────────────── #}
<div class="card cobranca-card mb-3">
    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
        <span><i class="bi bi-telephone me-1"></i>Telefones <span class="badge text-bg-secondary">{{ pessoa.telefones|length }}</span></span>
        <button type="button" class="btn btn-sm jp-btn-outline" data-bs-toggle="collapse" data-bs-target="#formAdicionarTelefone" aria-expanded="false" aria-controls="formAdicionarTelefone">
            <i class="bi bi-plus-lg me-1"></i>Adicionar
        </button>
    </div>
    <div class="card-body">
        {% if pessoa.telefones|length > 0 %}
        <ul class="list-unstyled mb-0">
            {% for t in pessoa.telefones %}
            <li class="d-flex align-items-center gap-2 flex-wrap py-2{{ not loop.first ? ' border-top' : '' }}">
                <i class="bi {{ t.atual ? 'bi-telephone-fill text-success' : 'bi-telephone text-secondary' }}" aria-hidden="true"></i>
                <div class="flex-grow-1" style="min-width: 0;">
                    <a href="tel:{{ t.numero|e('url') }}">{{ t.numero }}</a>
                    <span class="small text-secondary">· desde {{ t.criadoEm|date('d/m/Y') }}</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
                    {% if t.atual %}
                        <span class="badge text-bg-success">Atual</span>
                    {% else %}
                        <form method="POST" action="{{ path('cobranca_pessoa_telefone_atual', {id: pessoa.id, itemId: t.id}) }}" data-disable-on-submit="true">
                            <input type="hidden" name="_token" value="{{ csrf_token('marcar_telefone_atual_' ~ t.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Marcar como atual</button>
                        </form>
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="jp-vazio py-3">
            <i class="bi bi-telephone"></i>
            <div class="jp-vazio-titulo">Nenhum telefone cadastrado</div>
        </div>
        {% endif %}

        <div class="collapse{{ pessoa.telefones|length == 0 ? ' show' : '' }} mt-3" id="formAdicionarTelefone">
            {{ form_start(formTelefone, {
                action: path('cobranca_pessoa_telefone_adicionar', {id: pessoa.id}),
                attr: {'data-disable-on-submit': 'true'},
            }) }}
            {{ form_row(formTelefone.numero) }}
            <div class="mt-2">
                <button type="submit" class="btn btn-sm jp-btn-accent"><i class="bi bi-check-lg me-1"></i>Salvar telefone</button>
            </div>
            {{ form_end(formTelefone) }}
        </div>
    </div>
</div>
