{# ───────────────────────────────────────────────────────────────────────────
   Lista de telefones da pessoa (spec §4/§7): linha do tempo `criadoEm ASC`, nunca perde histórico —
   "adicionar" só acrescenta, "marcar atual" só troca a flag (o item anterior permanece na lista).

   2026-07-28: entraram CORRIGIR e EXCLUIR, as ações explícitas que a §7 já previa à parte. Elas não
   contradizem o "nunca perde histórico": corrigir é para o número digitado errado, e excluir é para o
   registro que não deveria existir. Trocar de telefone continua sendo adicionar + marcar atual.
   2026-07-28 (parte 2): entraram a MÁSCARA do número e o TIPO (WhatsApp × telefone). Ver
   `_telefones_cobrada.html.twig` da aba Responsáveis — as duas telas mostram a mesma lista e seguem as
   mesmas regras (filtros `telefone_br`/`telefone_url`, `icone()` do enum, tipo em branco no legado).

   Contexto herdado do show: `pessoa` (PessoaFichaOutput) e `formTelefone` (AdicionarTelefoneType).
─────────────────────────────────────────────────────────────────────────── #}
{# Os dois tipos saem do próprio enum, não de lista repetida aqui nem de variável do controller. #}
{% set tiposDeTelefone = enum_cases('App\\Cobranca\\Enum\\TipoTelefone') %}
<div class="card cobranca-card mb-3">
    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
        <span><i class="bi bi-telephone me-1"></i>Telefones <span class="badge text-bg-secondary">{{ pessoa.telefones|length }}</span></span>
        <button type="button" class="btn btn-sm jp-btn-outline" data-bs-toggle="collapse" data-bs-target="#formAdicionarTelefone" aria-expanded="false" aria-controls="formAdicionarTelefone">
            <i class="bi bi-plus-lg me-1"></i>Adicionar
        </button>
    </div>
    <div class="card-body">
        {% if pessoa.telefones|length > 0 %}
        <ul class="list-unstyled mb-0">
            {% for t in pessoa.telefones %}
            <li class="d-flex align-items-center gap-2 flex-wrap py-2{{ not loop.first ? ' border-top' : '' }}" data-telefone="{{ t.id }}">
                {# Ícone, máscara e destino do clique saem das MESMAS regras da aba Responsáveis
                   (`_telefones_cobrada.html.twig`): filtros `telefone_br`/`telefone_url` e o `icone()`
                   do enum. Duas telas mostram a mesma lista — divergir aqui seria acidente, não escolha. #}
                {% set icone = t.tipo ? t.tipo.icone() : 'bi-telephone' %}
                {% set icone = (icone == 'bi-telephone' and t.atual) ? 'bi-telephone-fill' : icone %}
                <i class="bi {{ icone }} {{ t.atual ? 'text-success' : 'text-secondary' }}" aria-hidden="true"></i>
                <div class="flex-grow-1" style="min-width: 0;">
                    {% set destino = t.numero|telefone_url(t.tipo) %}
                    <a href="{{ destino }}"
                       {% if destino starts with 'https:' %}target="_blank" rel="noopener"{% endif %}
                       title="{{ t.tipo ? t.tipo.label() : 'Telefone' }}">{{ t.numero|telefone_br }}</a>
                    <span class="small text-secondary">· desde {{ t.criadoEm|date('d/m/Y') }}</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
                    {% if t.atual %}
                        <span class="badge text-bg-success">Atual</span>
                    {% else %}
                        <form method="POST" action="{{ path('cobranca_pessoa_telefone_atual', {id: pessoa.id, itemId: t.id}) }}" data-disable-on-submit="true">
                            <input type="hidden" name="_token" value="{{ csrf_token('marcar_telefone_atual_' ~ t.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Marcar como atual</button>
                        </form>
                    {% endif %}
                    {# Corrigir e excluir (2026-07-28): as MESMAS ações da aba Responsáveis do objeto,
                       aqui no PRG de sempre da ficha. Corrigir é para o número errado; a troca de
                       telefone da pessoa continua sendo adicionar + marcar atual, que não apaga nada. #}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="collapse" data-bs-target="#editarTelefoneFicha{{ t.id }}"
                            aria-expanded="false" aria-controls="editarTelefoneFicha{{ t.id }}"
                            data-acao="editar-telefone" aria-label="Editar telefone" title="Corrigir este número">
                        <i class="bi bi-pencil"></i>
                    </button>
                    {# `onsubmit` com confirm() nativo: a ficha não tem o modal compartilhado do `show`,
                       e aqui o número está na MESMA linha do botão — quem clica está olhando para ele.
                       O aviso diz o que a exclusão faz de diferente quando o alvo é o atual. #}
                    <form method="POST" action="{{ path('cobranca_pessoa_telefone_excluir', {id: pessoa.id, itemId: t.id}) }}"
                          data-disable-on-submit="true"
                          onsubmit="return confirm({{ (t.atual
                              ? 'Excluir ' ~ t.numero ~ '? Este é o telefone atual — o mais recente que sobrar passa a ser o atual.'
                              : 'Excluir ' ~ t.numero ~ '? Não dá para desfazer.')|json_encode }});">
                        <input type="hidden" name="_token" value="{{ csrf_token('excluir_telefone_' ~ t.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-acao="excluir-telefone" aria-label="Excluir telefone" title="Excluir este número">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
                <div class="collapse w-100" id="editarTelefoneFicha{{ t.id }}">
                    <form method="POST" action="{{ path('cobranca_pessoa_telefone_editar', {id: pessoa.id, itemId: t.id}) }}"
                          data-disable-on-submit="true" class="d-flex align-items-center gap-2 flex-wrap mt-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('editar_telefone_' ~ t.id) }}">
                        <input type="text" name="numero" value="{{ t.numero|telefone_br }}" maxlength="20"
                               inputmode="tel" data-mascara="telefone" placeholder="(00) 00000-0000"
                               class="form-control form-control-sm" style="max-width: 12rem;" aria-label="Número do telefone">
                        {# Nenhum tipo vem marcado no telefone LEGADO (tipo nulo): corrigir um dígito não
                           pode virar declaração de tipo. Sem `tipo` no POST, o UseCase não mexe nele. #}
                        <div class="btn-group btn-group-sm" role="group" aria-label="Tipo do telefone">
                            {% for opcao in tiposDeTelefone %}
                            <input type="radio" class="btn-check" name="tipo" value="{{ opcao.value }}"
                                   id="tipoTelFicha{{ t.id }}{{ opcao.value }}" autocomplete="off"
                                   {{ t.tipo == opcao ? 'checked' : '' }}>
                            <label class="btn btn-outline-secondary" for="tipoTelFicha{{ t.id }}{{ opcao.value }}">
                                <i class="bi {{ opcao.icone() }} me-1"></i>{{ opcao.label() }}
                            </label>
                            {% endfor %}
                        </div>
                        <button type="submit" class="btn btn-sm jp-btn-accent"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-bs-toggle="collapse" data-bs-target="#editarTelefoneFicha{{ t.id }}">Cancelar</button>
                    </form>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="jp-vazio py-3">
            <i class="bi bi-telephone"></i>
            <div class="jp-vazio-titulo">Nenhum telefone cadastrado</div>
        </div>
        {% endif %}

        <div class="collapse{{ pessoa.telefones|length == 0 ? ' show' : '' }} mt-3" id="formAdicionarTelefone">
            {{ form_start(formTelefone, {
                action: path('cobranca_pessoa_telefone_adicionar', {id: pessoa.id}),
                attr: {'data-disable-on-submit': 'true'},
            }) }}
            {# `form_row` traz rótulo + margem do tema; os `attr` do Form Type (máscara, inputmode)
               atravessam intactos porque aqui nada é sobrescrito — ao contrário do widget da aba. #}
            {{ form_row(formTelefone.numero) }}
            <div class="btn-group btn-group-sm" role="group" aria-label="Tipo do telefone">
                {% for opcao in formTelefone.tipo %}
                {% set caso = tiposDeTelefone|filter(c => c.value == opcao.vars.value)|first %}
                {{ form_widget(opcao, {attr: {'class': 'btn-check', 'autocomplete': 'off'}}) }}
                <label class="btn btn-outline-secondary" for="{{ opcao.vars.id }}">
                    <i class="bi {{ caso.icone() }} me-1"></i>{{ opcao.vars.label }}
                </label>
                {% endfor %}
            </div>
            <div class="mt-2">
                <button type="submit" class="btn btn-sm jp-btn-accent"><i class="bi bi-check-lg me-1"></i>Salvar telefone</button>
            </div>
            {{ form_end(formTelefone) }}
        </div>
    </div>
</div>
