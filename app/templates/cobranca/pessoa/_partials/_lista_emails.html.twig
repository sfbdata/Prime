{# ───────────────────────────────────────────────────────────────────────────
   Lista de e-mails da pessoa (spec §4/§7): linha do tempo `criadoEm ASC`, nunca perde histórico —
   "adicionar" só acrescenta, "marcar atual" só troca a flag (o item anterior permanece na lista).
   Contexto herdado do show: `pessoa` (PessoaFichaOutput) e `formEmail` (AdicionarEmailType).
─────────────────────────────────────────────────────────────────────────── #}
<div class="card cobranca-card mb-3">
    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
        <span><i class="bi bi-envelope me-1"></i>E-mails <span class="badge text-bg-secondary">{{ pessoa.emails|length }}</span></span>
        <button type="button" class="btn btn-sm jp-btn-outline" data-bs-toggle="collapse" data-bs-target="#formAdicionarEmail" aria-expanded="false" aria-controls="formAdicionarEmail">
            <i class="bi bi-plus-lg me-1"></i>Adicionar
        </button>
    </div>
    <div class="card-body">
        {% if pessoa.emails|length > 0 %}
        <ul class="list-unstyled mb-0">
            {% for m in pessoa.emails %}
            <li class="d-flex align-items-center gap-2 flex-wrap py-2{{ not loop.first ? ' border-top' : '' }}">
                <i class="bi {{ m.atual ? 'bi-envelope-fill text-success' : 'bi-envelope text-secondary' }}" aria-hidden="true"></i>
                <div class="flex-grow-1" style="min-width: 0;">
                    <a href="mailto:{{ m.email|e('url') }}">{{ m.email }}</a>
                    <span class="small text-secondary">· desde {{ m.criadoEm|date('d/m/Y') }}</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
                    {% if m.atual %}
                        <span class="badge text-bg-success">Atual</span>
                    {% else %}
                        <form method="POST" action="{{ path('cobranca_pessoa_email_atual', {id: pessoa.id, itemId: m.id}) }}" data-disable-on-submit="true">
                            <input type="hidden" name="_token" value="{{ csrf_token('marcar_email_atual_' ~ m.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Marcar como atual</button>
                        </form>
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="jp-vazio py-3">
            <i class="bi bi-envelope"></i>
            <div class="jp-vazio-titulo">Nenhum e-mail cadastrado</div>
        </div>
        {% endif %}

        <div class="collapse{{ pessoa.emails|length == 0 ? ' show' : '' }} mt-3" id="formAdicionarEmail">
            {{ form_start(formEmail, {
                action: path('cobranca_pessoa_email_adicionar', {id: pessoa.id}),
                attr: {'data-disable-on-submit': 'true'},
            }) }}
            {{ form_row(formEmail.email) }}
            <div class="mt-2">
                <button type="submit" class="btn btn-sm jp-btn-accent"><i class="bi bi-check-lg me-1"></i>Salvar e-mail</button>
            </div>
            {{ form_end(formEmail) }}
        </div>
    </div>
</div>
