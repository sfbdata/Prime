<div class="card card-outline card-warning mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-calendar-check me-2"></i>Minhas Justificativas</h3>
    </div>
    <div class="card-body p-0">
        {% if justificativas is empty %}
            <p class="text-muted small p-3 mb-0">Nenhuma justificativa enviada nesta competência.</p>
        {% else %}
            {# Agrupar por batchId para exibir dias do mesmo lote juntos #}
            {% set batches = {} %}
            {% for j in justificativas %}
                {% set batchKey = j.batchId ?? ('id_' ~ j.id) %}
                {% if batches[batchKey] is not defined %}
                    {% set batches = batches|merge({(batchKey): []}) %}
                {% endif %}
                {% set batches = batches|merge({(batchKey): batches[batchKey]|merge([j])}) %}
            {% endfor %}

            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Data(s)</th>
                        <th>Tipo</th>
                        <th>Status</th>
                        <th>Atestado</th>
                        <th>Obs. da Análise</th>
                        <th>Analisado em</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for batchKey, batch in batches %}
                        <tr>
                            <td>
                                {% for j in batch %}
                                    <span class="badge text-bg-light border text-dark me-1">{{ j.data|date('d/m/Y') }}</span>
                                {% endfor %}
                            </td>
                            <td class="small">
                                {% if batch[0].labelTipo %}
                                    <span class="badge text-bg-info text-dark">{{ batch[0].labelTipo }}</span>
                                {% endif %}
                                {% if batch[0].abonoParcial %}
                                    <span class="badge text-bg-secondary ms-1" title="Abono parcial">Parcial</span>
                                    {% if batch[0].horaInicioAbono and batch[0].horaFimAbono %}
                                        <div class="small text-muted mt-1">{{ batch[0].horaInicioAbono|date('H:i') }}–{{ batch[0].horaFimAbono|date('H:i') }}</div>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% set status = batch[0].status %}
                                {% if status == 'abonado' and batch[0].tipo == 'falta_nao_justificada' %}
                                    <span class="badge text-bg-danger"><i class="bi bi-x-circle me-1"></i>Não abonado</span>
                                {% elseif status == 'abonado' %}
                                    <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>Abonado</span>
                                {% elseif status == 'pendente' %}
                                    <span class="badge text-bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pendente</span>
                                {% else %}
                                    <span class="badge text-bg-danger"><i class="bi bi-x-circle me-1"></i>Rejeitado</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if batch[0].anexoPath %}
                                    <a href="{{ path('ponto_justificativa_anexo', {id: batch[0].id}) }}" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-paperclip"></i> Ver
                                    </a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="small text-muted">{{ batch[0].observacaoAnalise ?? '—' }}</td>
                            <td class="small text-muted">
                                {% if batch[0].dataAnalise %}
                                    {{ batch[0].dataAnalise|date('d/m/Y') }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>
                                <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Editar justificativa"
                                            data-id="{{ batch[0].id }}"
                                            data-tipo="{{ batch[0].tipo }}"
                                            data-abono-parcial="{{ batch[0].abonoParcial ? '1' : '0' }}"
                                            data-hora-inicio="{{ batch[0].horaInicioAbono ? batch[0].horaInicioAbono|date('H:i') : '' }}"
                                            data-hora-fim="{{ batch[0].horaFimAbono ? batch[0].horaFimAbono|date('H:i') : '' }}"
                                            data-csrf="{{ csrf_token('editar_justificativa_' ~ batch[0].id) }}"
                                            data-url="{{ path('ponto_justificativa_editar', {id: batch[0].id}) }}"
                                            onclick="abrirModalEditarJustificativa(this)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
