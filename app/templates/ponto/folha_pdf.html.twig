<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Folha de Ponto - {{ '%02d'|format(mes) }}/{{ ano }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
            color: #000;
            margin: 18px 20px 14px 20px;
        }

        /* ── Cabeçalho ─────────────────────────────────────── */
        .cabecalho {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
        }
        .cabecalho > tbody > tr > td {
            vertical-align: top;
            padding: 0;
        }
        .col-esq {
            width: 62%;
            padding-right: 8px;
        }
        .col-dir {
            width: 38%;
            border: 1px solid #000;
            padding: 5px 7px;
            text-align: center;
            vertical-align: middle;
        }

        .titulo-empresa {
            font-size: 10px;
            font-weight: bold;
            text-decoration: underline;
            text-transform: uppercase;
            line-height: 1.3;
        }
        .titulo-lista {
            font-size: 10px;
            font-weight: bold;
            text-decoration: underline;
            text-transform: uppercase;
            margin-bottom: 5px;
            line-height: 1.3;
        }

        .dados-trabalhador {
            width: 100%;
            border-collapse: collapse;
        }
        .dados-trabalhador td {
            padding: 1px 0;
            font-size: 10px;
            vertical-align: top;
            line-height: 1.35;
        }
        .dados-trabalhador .lbl {
            font-weight: bold;
            white-space: nowrap;
            width: 1%;
        }
        .dados-trabalhador .sep {
            white-space: nowrap;
            width: 1%;
            padding-right: 3px;
        }

        .dir-cnpj {
            font-size: 10px;
            font-weight: bold;
            margin-bottom: 2px;
        }
        .dir-nome {
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 2px;
            line-height: 1.3;
        }
        .dir-end {
            font-size: 9px;
            line-height: 1.4;
        }

        /* ── Tabela principal ───────────────────────────────── */
        table.folha {
            width: 100%;
            border-collapse: collapse;
        }
        table.folha th,
        table.folha td {
            border: 1px solid #000;
            font-size: 10px;
            text-align: center;
        }
        table.folha th {
            padding: 3px 4px;
            font-weight: bold;
            line-height: 1.3;
            vertical-align: middle;
        }
        table.folha td {
            padding: 2px 4px;
            height: 16px;
            vertical-align: middle;
        }
        table.folha td.td-ass {
            text-align: left;
        }
        table.folha th.th-ass {
            text-align: left;
        }
        table.folha .col-dia   { width: 28px; }
        table.folha .col-sem   { width: 60px; }
        table.folha .col-hora  { width: 52px; }

        tr.fim-semana td,
        tr.feriado td {
            background-color: #e8e8e8;
        }

        /* ── Rodapé ─────────────────────────────────────────── */
        .rodape {
            margin-top: 6px;
            font-size: 8px;
            color: #000;
        }
    </style>
</head>
<body>

    {# ── CABEÇALHO ─────────────────────────────────────────── #}
    <table class="cabecalho">
        <tbody>
            <tr>
                <td class="col-esq">
                    <div class="titulo-empresa">{{ nomeEmpresa }}</div>
                    <div class="titulo-lista">LISTA DE FREQUÊNCIA DE {{ inicioMes }} A {{ fimMes }}</div>
                    <table class="dados-trabalhador">
                        <tbody>
                            <tr>
                                <td class="lbl">Trabalhador</td>
                                <td class="sep">&nbsp;:&nbsp;</td>
                                <td>{{ numeroTrabalhador }} {{ nomeUsuario }}</td>
                            </tr>
                            <tr>
                                <td class="lbl">Cargo</td>
                                <td class="sep">&nbsp;:&nbsp;</td>
                                <td>{{ cargo }}</td>
                            </tr>
                            <tr>
                                <td class="lbl">CTPS</td>
                                <td class="sep">&nbsp;:&nbsp;</td>
                                <td>{{ ctps }}</td>
                            </tr>
                            <tr>
                                <td class="lbl">Série</td>
                                <td class="sep">&nbsp;:&nbsp;</td>
                                <td>{{ serie }}</td>
                            </tr>
                            <tr>
                                <td class="lbl">Descr. Jornada</td>
                                <td class="sep">&nbsp;:&nbsp;</td>
                                <td>{{ descrJornada }}</td>
                            </tr>
                            <tr>
                                <td class="lbl">Lotação</td>
                                <td class="sep">&nbsp;:&nbsp;</td>
                                <td>{{ lotacao }}</td>
                            </tr>
                        </tbody>
                    </table>
                </td>
                <td class="col-dir">
                    <div class="dir-cnpj">CNPJ : {{ cnpj }}</div>
                    <div class="dir-nome">{{ nomeEmpresa }}</div>
                    <div class="dir-end">
                        {{ enderecoLinha1 }}{% if enderecoLinha2 %}<br>{{ enderecoLinha2 }}{% endif %}
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    {# ── TABELA DE PONTO ───────────────────────────────────── #}
    <table class="folha">
        <thead>
            <tr>
                <th class="col-dia">Dia<br>Mês</th>
                <th class="col-sem">Dia da<br>Semana</th>
                <th class="col-hora">{{ horaEntrada }}<br>Entrada</th>
                <th class="col-hora">{{ horaRepouso }}<br>Repouso</th>
                <th class="col-hora">{{ horaRetorno }}<br>Retorno</th>
                <th class="col-hora">{{ horaSaida }}<br>Saída</th>
                <th class="th-ass">Justificativa</th>
            </tr>
        </thead>
        <tbody>
            {% for linha in folhaRows %}
                {% set classeRow = linha.fimSemana ? 'fim-semana' : (linha.isFeriado ? 'feriado' : '') %}
                <tr class="{{ classeRow }}">
                    <td>{{ '%02d'|format(linha.diaMes) }}</td>
                    <td>{{ linha.diaSemana }}</td>
                    <td>{{ linha.entrada }}</td>
                    <td>{{ linha.repouso }}</td>
                    <td>{{ linha.retorno }}</td>
                    <td>{{ linha.saida }}</td>
                    <td class="td-ass">
                        {% if linha.justificativa is defined and linha.justificativa is not null and linha.justificativa.status == 'abonado' %}
                            {% set j = linha.justificativa %}
                            {{ j.labelTipo }}{% if j.abonoParcial and j.horaInicioAbono and j.horaFimAbono %} (Parcial: {{ j.horaInicioAbono|date('H:i') }}–{{ j.horaFimAbono|date('H:i') }}){% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            {# linha em branco extra para folhas com menos de 31 dias, preservando layout #}
            <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
        </tbody>
    </table>

    <p class="rodape">Conforme a Portaria nº 3.626, Artigo 13 de 13/11/91, esta folha substitui o Quadro de Horário de Trabalho, inclusive o de menores.</p>

</body>
</html>
