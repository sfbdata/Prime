                    <textarea name="motivo" id="editarMotivo" rows="3" maxlength="{{ constant('App\\Ponto\\Form\\JustificativaPontoType::MOTIVO_MAXIMO') }}" class="pe-janela-campo" data-janela-motivo></textarea>
                </label>

                <label class="pe-janela-rotulo" id="editarBlocoAnexo">Substituir atestado (opcional)
                    <input type="file" name="anexo" id="editarAnexo" class="pe-janela-arquivo" accept=".pdf,.jpg,.jpeg,.png">
                    <span class="pe-janela-nota">PDF, JPEG ou PNG (máximo 10 MB)</span>
                </label>
                <div class="pe-janela-aviso" id="editarAvisoAnexoAnalisado" hidden>
                    <i class="bi bi-lock" aria-hidden="true"></i>{{ nome_da_situacao('anexo.travado') }}
                </div>
            </div>

            <div class="pe-janela-erro" data-janela-erro hidden></div>
            <div class="pe-janela-rodape">
                <button type="button" class="pe-janela-cancelar" data-janela-fechar>Cancelar</button>
                <button type="submit" class="pe-janela-acao" data-janela-enviar>Salvar alterações</button>
