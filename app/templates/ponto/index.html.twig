{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
@keyframes piscar-repouso {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
}
.repouso-disponivel-piscando {
    animation: piscar-repouso 1s ease-in-out infinite;
}
</style>
{% endblock %}

{% block title %}Ponto Eletrônico{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-sm-6">
            <h1 class="m-0">Ponto Eletrônico</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card card-primary card-outline">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">Registrar Ponto</h3>
                    {% if saldoMes is not null %}
                        {% set absAcum = saldoMes < 0 ? -saldoMes : saldoMes %}
                        <div class="text-end ms-auto">
                            <small class="text-muted d-block" style="font-size:0.7rem;">Banco de horas</small>
                            <span class="h6 fw-bold mb-0 {{ saldoMes >= 0 ? 'text-success' : 'text-danger' }}">
                                {{ saldoMes < 0 ? '-' : '+' }}{{ (absAcum // 60) }}h{{ '%02d'|format(absAcum % 60) }}m
                            </span>
                        </div>
                    {% endif %}
                </div>
                <div class="card-body text-center">
                    <div id="clock-label" class="text-muted small mb-1"></div>
                    <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                        <div id="clock" class="h1 mb-0" title="Tempo trabalhado hoje">00:00:00</div>
                    </div>

                    <div id="previsao-saida" class="text-muted small d-none mb-2" style="font-size:0.75rem;">
                        Previsão de saída: <strong id="previsao-saida-horario"></strong>
                    </div>

                    <div id="contador-repouso" class="d-none alert small mb-3 py-2 text-center">
                        <i class="bi bi-cup-hot me-1"></i>
                        Repouso: <strong id="repouso-timer">00:00:00</strong>
                        <div id="repouso-status" class="mt-1"></div>
                    </div>

                    <div id="gps-status" class="alert alert-info small mb-3">
                        <i class="bi bi-geo-alt"></i> Aguardando geolocalização
                    </div>

                    <div class="mb-3 text-start">
                        <label for="tipo-registro" class="form-label fw-semibold">Tipo de registro <span class="text-danger">*</span></label>
                        <select id="tipo-registro" class="form-select" required>
                            <option value="">Selecione...</option>
                            <option value="entrada">Entrada</option>
                            <option value="repouso">Repouso</option>
                            <option value="retorno">Retorno</option>
                            <option value="saida">Saída</option>
                        </select>
                    </div>

                    <button id="btn-bater-ponto" class="btn btn-lg btn-primary w-100" disabled>
                        <i class="bi bi-fingerprint"></i> Bater Ponto
                    </button>

                    {# Resultado da última tentativa. Fica na tela até a próxima: o `alert` do
                       navegador some quando a pessoa toca em OK e não deixa nada para conferir. #}
                    <div id="batida-aviso" class="alert small mt-2 mb-0 text-start d-none" role="alert" aria-live="polite"></div>

                    {# A lista abaixo é do momento em que a página carregou. Quando a resposta do
                       servidor não volta, mandar conferir a lista SEM atualizá-la é pior do que não
                       mandar nada: ela ainda diz "ainda não registrada" e confirma a conclusão
                       errada, levando à segunda batida. Este botão é o jeito honesto de conferir. #}
                    <button type="button" id="btn-atualizar-pagina" class="btn btn-sm btn-outline-secondary w-100 mt-2 d-none">
                        <i class="bi bi-arrow-clockwise me-1"></i> Atualizar e conferir minhas batidas
                    </button>

                    {# Batidas de hoje. A tela não mostrava NENHUMA: depois do recarregamento a
                       confirmação verde sumia e a pessoa só conferia rolando até a folha, que no
                       celular fica abaixo deste card. Era o que sustentava o "parece que registrou". #}
                    <div id="batidas-de-hoje" class="mt-3 text-start border-top pt-3">
                        <p class="text-muted fw-semibold mb-2" style="font-size:0.75rem;">
                            <i class="bi bi-list-check me-1"></i>Suas batidas de hoje
                        </p>
                        <ul class="list-unstyled mb-0">
                            {% for tipo, rotulo in {'entrada': 'Entrada', 'repouso': 'Repouso', 'retorno': 'Retorno', 'saida': 'Saída'} %}
                                {% set horario = pontoHoje[tipo]|default(null) %}
                                {% set quantas = quantasHoje[tipo]|default(0) %}
                                <li class="d-flex justify-content-between align-items-center py-1 batida-de-hoje"
                                    data-tipo="{{ tipo }}" data-registrada="{{ horario ? '1' : '0' }}" data-quantas="{{ quantas }}">
                                    <span class="small {{ horario ? '' : 'text-muted' }}">
                                        <i class="bi {{ horario ? 'bi-check-circle-fill text-success' : 'bi-circle' }} me-1"></i>{{ rotulo }}
                                        {% if quantas > 1 %}
                                            {# Duplicata precisa aparecer AQUI. É este bloco que o aviso de "sem
                                               confirmação" manda conferir antes de bater de novo. #}
                                            <span class="badge text-bg-warning ms-1">{{ quantas }} registros</span>
                                        {% endif %}
                                    </span>
                                    <span class="small fw-semibold {{ horario ? '' : 'text-muted fw-normal' }}">
                                        {{ horario ? horario : 'ainda não registrada' }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <button type="button" class="btn btn-outline-warning w-100 mt-3"
                            data-bs-toggle="modal" data-bs-target="#modalJustificativa">
                        <i class="bi bi-calendar-x me-1"></i> Justificar Falta
                    </button>
                </div>
            </div>

            {% if jornadaInfo is not null %}
                {% set horas = jornadaInfo.cargaHorariaSemanal // 60 %}
                {% set mins  = jornadaInfo.cargaHorariaSemanal % 60 %}
                <div class="card card-outline card-secondary mt-3">
                    <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-week text-secondary"></i>
                        <div class="small">
                            <span class="text-muted">Jornada semanal:</span>
                            <strong class="ms-1">{{ horas }}h{{ '%02d'|format(mins) }}m</strong>
                            <span class="badge ms-2 {{ jornadaInfo.fonte == 'personalizada' ? 'text-bg-primary' : 'text-bg-secondary' }}">
                                {{ jornadaInfo.fonte == 'personalizada' ? 'Personalizada' : 'Padrão do escritório' }}
                            </span>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-md-8">
            {% include 'ponto/_folha_table.html.twig' with {
                titulo: 'Folha de Ponto - ' ~ ('%02d'|format(mesAtual)) ~ '/' ~ anoAtual,
                folhaRows: folhaRows,
                competenciasPonto: competenciasPonto,
                competenciaSelecionada: competenciaSelecionada,
                competenciaFormAction: path('ponto_index'),
                competenciaFieldId: 'competencia-ponto-index',
                exportarFolhaHabilitado: true,
                mostrarBancoHoras: true,
                mostrarJustificativas: true,
                editarBatidasHabilitado: false,
                justificarFaltanteHabilitado: true,
                esquecimentosRegistrados: esquecimentosRegistrados,
                dataHoje: dataHoje,
                horasPagasMinutos: horasPagasMinutos,
                saldoMesMinutos: saldoMesMinutos
            } only %}

            {% include 'ponto/_justificativas_list.html.twig' with {justificativas: justificativas} only %}
        </div>
    </div>
</div>

{% include 'ponto/_justificativa_form.html.twig' with {tiposJustificativa: tiposJustificativa} only %}

{% include 'ponto/_justificativa_esquecimento_modal.html.twig' with {competenciaSelecionada: competenciaSelecionada} only %}

{# Modal: Editar justificativa pendente #}
<div class="modal fade" id="modalEditarJustificativa" tabindex="-1" aria-labelledby="modalEditarJustificativaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="formEditarJustificativa" enctype="multipart/form-data">
                <input type="hidden" name="_token" id="editarJustificativaToken">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEditarJustificativaLabel">
                        <i class="bi bi-pencil me-2"></i>Editar Justificativa
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo</label>
                        <select name="tipo" id="editarJustificativaTipo" class="form-select">
                            <option value="">Selecione...</option>
                            {% for label, valor in tiposJustificativa %}
                                <option value="{{ valor }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div id="editarBlocoRegistroEsquecido" class="d-none mb-3 p-3 border rounded bg-warning bg-opacity-10">
                        <p class="small fw-semibold mb-2"><i class="bi bi-clock-history me-1"></i>Detalhes do registro esquecido</p>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <label for="editarTipoRegEsquecido" class="form-label">Tipo de batida</label>
                                <select name="tipoRegistroEsquecido" id="editarTipoRegEsquecido" class="form-select">
                                    <option value="">Selecione...</option>
                                    <option value="entrada">Entrada</option>
                                    <option value="repouso">Repouso</option>
                                    <option value="retorno">Retorno</option>
                                    <option value="saida">Saída</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label for="editarHoraRegEsquecido" class="form-label">Horário que deveria ter sido registrado</label>
                                <input type="time" name="horaRegistroEsquecido" id="editarHoraRegEsquecido" class="form-control">
                            </div>
                        </div>
                    </div>

                    <div id="editarBlocoAbonoParcial" class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="editarAbonoParcial" name="abonoParcial" value="1">
                        <label class="form-check-label" for="editarAbonoParcial">Abono parcial (ausência dentro do expediente)</label>
                    </div>

                    <div id="editarBlocoHorario" class="d-none mb-3 p-3 border rounded bg-body-tertiary">
                        <p class="small fw-semibold mb-2"><i class="bi bi-clock me-1"></i>Período de ausência parcial</p>
                        <div class="row g-2">
                            <div class="col">
                                <label class="form-label">Saída</label>
                                <input type="time" name="horaInicioAbono" id="editarHoraInicio" class="form-control">
                            </div>
                            <div class="col">
                                <label class="form-label">Retorno</label>
                                <input type="time" name="horaFimAbono" id="editarHoraFim" class="form-control">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Substituir atestado <span class="text-muted small">(opcional)</span></label>
                        <input type="file" name="anexo" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                        <div class="form-text">PDF, JPEG ou PNG — máximo 10 MB</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Salvar alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const GPS_PRECISAO_ACEITAVEL_METROS = 90;

    // Data de hoje SEGUNDO O SERVIDOR. Fica no escopo do script inteiro porque dois trechos
    // precisam dela: o relógio, para montar os horários do dia, e a checagem de virada do dia.
    //
    // 🪤 O relógio usava `new Date().toISOString().slice(0,10)`, que é a data em UTC, combinada com
    // horário LOCAL. Das 21h à meia-noite (BRT = UTC−3) o UTC já virou o dia seguinte, a diferença
    // contra `agora` dava negativa e o contador mostrava 00:00:00 para quem estava trabalhando.
    //
    // Ainda resta o fuso DO APARELHO na montagem: `new Date(ano, mes, dia, ...)` constrói na
    // timezone do dispositivo, e o servidor roda em America/Sao_Paulo. Celular com fuso divergente
    // continua contando errado — deixou de ser o 00:00:00 óbvio e virou número plausível, que é
    // pior de notar. Fechar isso exige o servidor mandar o próprio deslocamento; não está feito.
    const [anoHoje, mesHoje, diaHoje] = JSON.parse('{{ dataHoje|json_encode|e('js') }}').split('-').map(Number);

    // Contador de tempo trabalhado no dia
    (function() {
        const pontoHoje = {{ pontoHoje|default({})|json_encode|raw }};

        const clockEl = document.getElementById('clock');
        const labelEl = document.getElementById('clock-label');

        function parseHMS(hms) {
            if (!hms) return null;
            const [hora, minuto, segundo] = hms.split(':').map(Number);
            return new Date(anoHoje, mesHoje - 1, diaHoje, hora, minuto, segundo || 0);
        }

        const tEntrada = parseHMS(pontoHoje.entrada);
        const tRepouso = parseHMS(pontoHoje.repouso);
        const tRetorno = parseHMS(pontoHoje.retorno);
        const tSaida   = parseHMS(pontoHoje.saida);

        (function() {
            const duracaoMinutos = {{ duracaoJornadaDiariaMinutos is not null ? duracaoJornadaDiariaMinutos : 'null' }};
            if (!tEntrada || tSaida || duracaoMinutos === null) return;

            const saidaPrevista = new Date(tEntrada.getTime() + duracaoMinutos * 60 * 1000);
            const hh = String(saidaPrevista.getHours()).padStart(2, '0');
            const mm = String(saidaPrevista.getMinutes()).padStart(2, '0');
            document.getElementById('previsao-saida-horario').textContent = `${hh}:${mm}`;
            document.getElementById('previsao-saida').classList.remove('d-none');
        })();

        function calcSegundosTrabalhados(agora) {
            if (!tEntrada) return 0;

            let total = 0;
            const fim1 = tRepouso || tSaida || agora;
            total += Math.max(0, fim1 - tEntrada);

            if (tRetorno) {
                const fim2 = tSaida || agora;
                total += Math.max(0, fim2 - tRetorno);
            }

            return Math.floor(total / 1000);
        }

        function formatarTempo(segundos) {
            const h = Math.floor(segundos / 3600);
            const m = Math.floor((segundos % 3600) / 60);
            const s = segundos % 60;
            return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        }

        const contadorRepousoEl = document.getElementById('contador-repouso');
        const repousoTimerEl    = document.getElementById('repouso-timer');
        const repousoStatusEl   = document.getElementById('repouso-status');
        const validacaoRepouso  = {{ validacaoRepousoHabilitada ? 'true' : 'false' }};
        const minimoRepouso     = {{ minimoMinutosRepouso }};

        function updateContadorRepouso() {
            if (!tRepouso || tRetorno || tSaida) {
                contadorRepousoEl.classList.add('d-none');
                return;
            }

            const agora   = new Date();
            const diffMs  = agora - tRepouso;
            const totalSeg = Math.floor(diffMs / 1000);

            repousoTimerEl.textContent = formatarTempo(totalSeg);
            contadorRepousoEl.classList.remove('d-none');

            if (validacaoRepouso) {
                const diffMin  = Math.floor(diffMs / 60000);
                const restante = minimoRepouso - diffMin;

                if (restante > 0) {
                    repousoStatusEl.textContent = `Retorno disponível em ${restante} min`;
                    contadorRepousoEl.className = 'alert alert-success small mb-3 py-2 text-center';
                } else {
                    repousoStatusEl.textContent = 'Retorno disponível';
                    contadorRepousoEl.className = 'alert alert-warning small mb-3 py-2 text-center repouso-disponivel-piscando';
                }
            } else {
                repousoStatusEl.textContent = '';
                contadorRepousoEl.className = 'alert alert-info small mb-3 py-2 text-center';
            }
        }

        function updateClock() {
            const agora = new Date();
            let label = '';

            if (!tEntrada) {
                clockEl.textContent = '00:00:00';
                label = 'Aguardando entrada';
            } else if (tSaida) {
                const segundos = calcSegundosTrabalhados(agora);
                clockEl.textContent = formatarTempo(segundos);
                label = 'Jornada encerrada';
            } else if (tRepouso && !tRetorno) {
                const segundos = calcSegundosTrabalhados(agora);
                clockEl.textContent = formatarTempo(segundos);
                label = 'Em repouso';
            } else {
                const segundos = calcSegundosTrabalhados(agora);
                clockEl.textContent = formatarTempo(segundos);
                label = 'Tempo trabalhado';
            }

            labelEl.textContent = label;
            updateContadorRepouso();
        }

        setInterval(updateClock, 1000);
        updateClock();
    })();

    const btnPonto = document.getElementById('btn-bater-ponto');
    const gpsStatus = document.getElementById('gps-status');
    const tipoRegistro = document.getElementById('tipo-registro');
    let currentLocation = null;
    // Flag de home office de hoje (controlada pelo servidor): quando true, a batida dispensa GPS.
    const homeOfficeHoje = {{ homeOfficeHoje ? 'true' : 'false' }};

    // Enquanto uma batida está em envio, ou já foi aceita e a página vai recarregar, o botão é do
    // envio e de mais ninguém. Sem esta trava, trocar o tipo no select durante o 1,5 s até o
    // recarregamento chamava `updateButtonState()` e reabilitava o botão — gesto natural de quem já
    // está pensando na próxima batida, e que fazia sair uma segunda antes do reload.
    let envioEmAndamento = false;

    // Marca que o dia virou com a página aberta. Serve só para avisar uma vez; NÃO entra em
    // `updateButtonState` de propósito — ver o comentário de `conferirViradaDoDia`.
    let diaVirou = false;

    // Sedes do escritório ativo, para a tela saber dizer "fora da área" ANTES do toque.
    const SEDES = JSON.parse('{{ sedesDaTela|json_encode|e('js') }}');

    function distanciaEmMetros(lat1, lon1, lat2, lon2) {
        const raioTerra = 6371000;
        const rad = (g) => g * Math.PI / 180;
        const dLat = rad(lat2 - lat1);
        const dLon = rad(lon2 - lon1);
        const a = Math.sin(dLat / 2) ** 2
            + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLon / 2) ** 2;

        return raioTerra * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    /**
     * Onde a pessoa está, em relação às sedes.
     *
     * 🔑 Três situações, não duas. `indeterminado` existe porque precisão de GPS não é enfeite: com
     * 120 m de erro e 70 m de distância o aparelho LITERALMENTE não sabe dizer se está dentro. A
     * tela trata isso como "pode tentar" e deixa o servidor decidir.
     *
     * 🔑 Esta avaliação é de propósito MAIS PERMISSIVA que a do servidor: só acusa `fora` quando a
     * distância supera o raio mesmo descontando a margem de precisão. A regra continua sendo a do
     * servidor, e divergir para o lado permissivo é seguro — divergir para o rígido transformaria
     * imprecisão de GPS em falta, que é o que não pode acontecer.
     */
    function avaliarPosicao() {
        if (!currentLocation || SEDES.length === 0) {
            return { situacao: 'indeterminado', distancia: null, sede: null };
        }

        let maisProxima = null;
        let menorDistancia = Infinity;
        let dentro = false;

        for (const sede of SEDES) {
            const distancia = distanciaEmMetros(
                currentLocation.latitude, currentLocation.longitude, sede.latitude, sede.longitude
            );
            if (distancia < menorDistancia) {
                menorDistancia = distancia;
                maisProxima = sede;
            }
            if (distancia <= sede.raio) {
                dentro = true;
            }
        }

        if (dentro) {
            return { situacao: 'dentro', distancia: menorDistancia, sede: maisProxima };
        }

        const margem = Number(currentLocation.precisaoGps) || 0;
        const certamenteFora = (menorDistancia - margem) > maisProxima.raio;

        return {
            situacao: certamenteFora ? 'fora' : 'indeterminado',
            distancia: menorDistancia,
            sede: maisProxima,
        };
    }

    function updateButtonState() {
        if (envioEmAndamento) {
            btnPonto.disabled = true;
            return;
        }
        if (homeOfficeHoje) {
            btnPonto.disabled = !tipoRegistro.value;
            return;
        }
        if (!currentLocation || avaliarPosicao().situacao === 'fora') {
            btnPonto.disabled = true;
            return;
        }
        btnPonto.disabled = !tipoRegistro.value;
    }

    tipoRegistro.addEventListener('change', updateButtonState);

    // Geolocalização obrigatória
    //
    // Guardar a posição e mexer no botão são coisas separadas de propósito: uma posição pode chegar
    // com a batida JÁ em envio (callback atrasado do leitor com prazo), e aí `updateButtonState()`
    // reabilitaria um botão que o envio desabilitou — abrindo caminho para batida duplicada. Quem
    // chega atrasado guarda a posição e atualiza o aviso; quem manda no botão é o fluxo do envio.
    function guardarPosicao(position) {
        const accuracy = position.coords.accuracy;
        currentLocation = {
            latitude: position.coords.latitude,
            longitude: position.coords.longitude,
            precisaoGps: accuracy,
        };

        // Botão desabilitado precisa DIZER o motivo e o caminho. Antes ele só ficava cinza, e a
        // pessoa fora da área nem sabia por que não conseguia bater nem o que fazer a respeito.
        const onde = avaliarPosicao();

        if (onde.situacao === 'fora') {
            gpsStatus.innerHTML = `<i class="bi bi-geo-alt-fill"></i> Você está a ${Math.round(onde.distancia)}m de <strong>${onde.sede.nome}</strong>, fora da área permitida para bater o ponto.<br>Se está em trabalho externo ou home office, peça ao gestor a liberação do dia antes de bater.`;
            gpsStatus.className = 'alert alert-danger small mb-3';
            return;
        }

        if (accuracy <= GPS_PRECISAO_ACEITAVEL_METROS) {
            gpsStatus.innerHTML = `<i class="bi bi-geo-alt-fill"></i> GPS: ${accuracy.toFixed(1)}m de precisão`;
            gpsStatus.className = 'alert alert-success small mb-3';
        } else {
            gpsStatus.innerHTML = `<i class="bi bi-exclamation-triangle"></i> GPS impreciso (${accuracy.toFixed(1)}m). O sistema ainda validará se você está dentro do raio de alguma sede.`;
            gpsStatus.className = 'alert alert-warning small mb-3';
        }
    }

    function aplicarPosicao(position) {
        guardarPosicao(position);
        updateButtonState();
    }

    function erroGps(error) {
        gpsStatus.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Permita o acesso à localização para registrar o ponto.`;
        gpsStatus.className = 'alert alert-danger small mb-3';
        btnPonto.disabled = true;
        console.log('GPS não disponível:', error.message);
    }

    // Prazo próprio para atualizar a posição antes de enviar a batida.
    //
    // `getCurrentPosition` resolve apenas pelos callbacks do navegador, e existe um estado em que
    // ele não chama nenhum dos dois: com o documento oculto (tela apagada, troca de aplicativo,
    // celular no bolso) o Android SUSPENDE a geolocalização — e aí o `timeout` da própria API
    // também não corre, porque o relógio dele é do pedido de posição. Um `await` direto nessa
    // promessa trava para sempre e a batida NUNCA chega a ser enviada: sem erro, sem aviso e sem
    // linha no banco. Foi o defeito que originou esta frente
    // (`docs/specs/ponto-batida-nao-se-perde-no-navegador.md`).
    //
    // 🔑 O ganho é sobre a SUSPENSÃO, não sobre o relógio: `setTimeout` também é do navegador, e
    // aba oculta o estrangula (e página congelada nem roda JS). A diferença é que timer estrangulado
    // volta a disparar quando a página volta, enquanto a geolocalização suspensa pode não chamar
    // callback nenhum. Por isso o invariante abaixo vale em tempo de PÁGINA RODANDO, não em tempo
    // de relógio de parede — e é por isso que existe o `LIMITE_ATRASO_ENVIO_MS` lá no envio.
    //
    // Invariante: esta função NUNCA rejeita e, com a página rodando, NUNCA demora mais que
    // `prazoMs`. É o que garante que o `fetch` da batida sempre acontece. Devolve `null` quando não
    // deu para atualizar a posição — e aí vale a que já está na mão, mesmo comportamento do antigo
    // ramo de erro.
    const GPS_PRAZO_ATUALIZACAO_MS = 5000;

    // Teto entre o toque e o envio. O caminho normal gasta no máximo o prazo do GPS acima; só
    // estoura quando a aba ficou congelada no meio. Ver a guarda no envio da batida.
    const LIMITE_ATRASO_ENVIO_MS = 60000;

    // Teto do envio em si. Sem ele, conexão pendurada deixa o botão em "Registrando..." para
    // sempre — o MESMO sintoma que o prazo do GPS resolveu, por outro caminho. `fetch` só
    // desiste sozinho quando o sistema operacional decide, o que pode não acontecer nunca.
    const ENVIO_PRAZO_MS = 15000;

    // Texto dos casos em que a resposta não voltou. Afirmar "não foi registrada" seria mentira: a
    // requisição pode ter chegado e gravado.
    //
    // 🔴 E mandar "conferir a lista aqui embaixo" também era mentira, de um jeito PIOR: a lista é
    // renderizada na carga da página e não se atualiza sozinha, então ela ainda diria "ainda não
    // registrada" e confirmaria a conclusão errada — falso com cara de verificado. Por isso o texto
    // manda ATUALIZAR primeiro, e o botão de atualizar aparece junto.
    const AVISO_SEM_CONFIRMACAO = 'Não recebemos a confirmação do servidor e a batida PODE ter sido registrada. A lista abaixo é de antes da tentativa: atualize a página e confira ANTES de apertar de novo.';

    // 🪤 Sem internet, mandar atualizar é conselho que destrói prova: o recarregamento entrega a
    // página de erro do navegador e leva junto o aviso, a lista e o estado inteiro da tela. Por isso
    // este caso tem texto próprio e NÃO oferece o botão de atualizar enquanto a conexão não voltar.
    const AVISO_SEM_REDE = 'Você está sem internet e não dá para saber se a batida saiu. NÃO feche esta tela. Quando a conexão voltar, atualize a página e confira antes de apertar de novo.';

    // Falha em que dá para afirmar que nada entrou: o servidor recusou antes de gravar.
    const AVISO_NAO_ENTROU = 'A batida não foi registrada: o servidor recusou o pedido antes de gravar. Atualize a página, entre de novo se precisar, e repita.';

    const avisoBatida = document.getElementById('batida-aviso');
    const btnAtualizarPagina = document.getElementById('btn-atualizar-pagina');

    btnAtualizarPagina.addEventListener('click', () => window.location.reload());

    // Conexão de volta depois de uma falha sem rede: aí sim atualizar resolve, então o botão
    // aparece. Sem isto a pessoa ficaria olhando um aviso que pede uma ação indisponível.
    window.addEventListener('online', function () {
        if (!avisoBatida.classList.contains('d-none') && avisoBatida.textContent === AVISO_SEM_REDE) {
            mostrarAvisoBatida('A internet voltou. Atualize a página e confira suas batidas antes de apertar de novo.', 'warning', true);
        }
    });

    // O `alert` do navegador era o único retorno de falha: some quando a pessoa toca em OK, não
    // deixa rastro na tela, e navegador nenhum o mostra em aba que não está visível. O aviso
    // agora FICA até a próxima tentativa.
    function mostrarAvisoBatida(texto, tom, oferecerAtualizar) {
        avisoBatida.textContent = texto;
        avisoBatida.className = `alert alert-${tom} small mt-2 mb-0 text-start`;
        btnAtualizarPagina.classList.toggle('d-none', !oferecerAtualizar);
    }

    function limparAvisoBatida() {
        avisoBatida.textContent = '';
        avisoBatida.className = 'alert small mt-2 mb-0 text-start d-none';
        btnAtualizarPagina.classList.add('d-none');
    }

    function liberarBotaoBatida() {
        envioEmAndamento = false;
        btnPonto.innerHTML = '<i class="bi bi-fingerprint"></i> Bater Ponto';
        updateButtonState();
    }

    // Página esquecida aberta da noite para o dia seguinte: o bloco "suas batidas de hoje" é
    // renderizado no servidor e congela. Às 08h ele mostraria a entrada de ONTEM como se fosse de
    // hoje, e a pessoa concluiria que já bateu — exatamente o defeito que esta frente existe para
    // matar, reintroduzido pelo próprio remédio. O relógio e a folha congelam junto.
    //
    // 🔑 A comparação é do aparelho CONTRA ELE MESMO, não contra a data do servidor. Uma primeira
    // versão comparava com `dataHoje` e dava ao relógio do aparelho poder de VETO: celular com fuso
    // errado (roaming, hora automática desligada) via data diferente às 21h, travava o botão, e
    // recarregar não resolvia porque a causa é o aparelho. Ficava impossível bater a saída — o
    // contrário do objetivo desta frente.
    //
    // ⚠️ Detectar só a MUDANÇA tira o veto, mas não dá pontaria: um relógio errado ANDA e cruza a
    // própria meia-noite na hora errada. Aparelho em UTC avisa às 21h BRT (falso) e depois fica
    // calado na virada real, porque `diaVirou` já saiu. Como aqui só se avisa, o custo é um alarme
    // fora de hora que o próprio recarregamento conserta.
    const DIA_DO_APARELHO_NA_CARGA = new Date().toDateString();
    const INTERVALO_CHECAGEM_DIA_MS = 30000;

    function conferirViradaDoDia() {
        if (diaVirou || new Date().toDateString() === DIA_DO_APARELHO_NA_CARGA) {
            return;
        }

        // ⚠️ AVISA, não bloqueia. Quem carimba a hora é o servidor, então bater com a página velha
        // grava certo; o risco desta tela é só a pessoa LER o dia errado e achar que já bateu.
        // Impedir a batida por causa disso seria trocar um engano por uma falta.
        diaVirou = true;
        document.getElementById('batidas-de-hoje').classList.add('opacity-50');
        mostrarAvisoBatida(
            'O dia virou com esta página aberta: a lista abaixo é de ontem. Atualize antes de conferir.',
            'warning',
            true
        );
    }

    setInterval(conferirViradaDoDia, INTERVALO_CHECAGEM_DIA_MS);

    function lerPosicaoComPrazo(prazoMs) {
        return new Promise((resolve) => {
            let jaRespondeu = false;
            const responder = (valor) => {
                if (jaRespondeu) return;
                jaRespondeu = true;
                resolve(valor);
            };

            const prazo = setTimeout(() => responder(null), prazoMs);

            // Posição que chega DEPOIS do prazo não serve mais para esta batida (já respondemos),
            // mas serve para a próxima: guardá-la evita a página aberta o dia todo ficar presa na
            // posição da carga. `guardarPosicao` também acerta o aviso de precisão — sem isso a
            // tela seguiria anunciando 12 m enquanto a próxima batida sairia com 800 m.
            //
            // 🔑 Ordem importa: responde ANTES de guardar. Nada depois de `responder` pode impedir
            // o envio — se `guardarPosicao` lançasse antes dele, com o prazo já cancelado, a
            // promessa nunca resolveria e o travamento voltaria pela porta dos fundos.
            const guardarEResponder = (position) => {
                clearTimeout(prazo);
                responder(position);
                try {
                    guardarPosicao(position);
                } catch (erro) {
                    console.log('Não consegui guardar a posição para a próxima batida:', erro);
                }
            };

            try {
                if (!("geolocation" in navigator)) {
                    clearTimeout(prazo);
                    responder(null);
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    guardarEResponder,
                    () => { clearTimeout(prazo); responder(null); },
                    { enableHighAccuracy: true, timeout: prazoMs }
                );
            } catch (erro) {
                // Lançamento SÍNCRONO (extensão de privacidade que stuba a API, WebView de MDM):
                // sem este catch a promessa rejeitaria e o botão travaria — o sintoma original.
                clearTimeout(prazo);
                responder(null);
            }
        });
    }

    if (homeOfficeHoje) {
        gpsStatus.innerHTML = `<i class="bi bi-house-laptop"></i> Home Office hoje — o ponto será registrado sem exigir localização.`;
        gpsStatus.className = 'alert alert-info small mb-3';
        updateButtonState();
    } else if ("geolocation" in navigator) {
        navigator.geolocation.getCurrentPosition(
            aplicarPosicao,
            (error) => {
                // Fallback sem alta precisão caso o primeiro tente atingir timeout
                navigator.geolocation.getCurrentPosition(aplicarPosicao, erroGps, { timeout: 10000 });
            },
            { enableHighAccuracy: true, timeout: 10000 }
        );
    } else {
        gpsStatus.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Seu navegador não suporta geolocalização.`;
        gpsStatus.className = 'alert alert-danger small mb-3';
    }

    // Modal de editar justificativa
    window.abrirModalEditarJustificativa = function(btn) {
        const form = document.getElementById('formEditarJustificativa');
        form.action = btn.dataset.url;
        document.getElementById('editarJustificativaToken').value = btn.dataset.csrf;

        const tipo = btn.dataset.tipo || '';
        document.getElementById('editarJustificativaTipo').value = tipo;

        const isEsquecimento = tipo === 'esquecimento_registro';
        document.getElementById('editarBlocoRegistroEsquecido').classList.toggle('d-none', !isEsquecimento);
        document.getElementById('editarTipoRegEsquecido').value = btn.dataset.tipoRegEsquecido || '';
        document.getElementById('editarHoraRegEsquecido').value = btn.dataset.horaRegEsquecido || '';

        const abonoParcial = btn.dataset.abonoParcial === '1' && !isEsquecimento;
        const checkAbono = document.getElementById('editarAbonoParcial');
        checkAbono.checked = abonoParcial;
        document.getElementById('editarBlocoAbonoParcial').classList.toggle('d-none', isEsquecimento);
        document.getElementById('editarBlocoHorario').classList.toggle('d-none', !abonoParcial);
        document.getElementById('editarHoraInicio').value = btn.dataset.horaInicio || '';
        document.getElementById('editarHoraFim').value = btn.dataset.horaFim || '';

        new bootstrap.Modal(document.getElementById('modalEditarJustificativa')).show();
    };

    document.getElementById('editarJustificativaTipo').addEventListener('change', function() {
        const isEsquecimento = this.value === 'esquecimento_registro';
        document.getElementById('editarBlocoRegistroEsquecido').classList.toggle('d-none', !isEsquecimento);
        document.getElementById('editarBlocoAbonoParcial').classList.toggle('d-none', isEsquecimento);
        if (isEsquecimento) {
            document.getElementById('editarAbonoParcial').checked = false;
            document.getElementById('editarBlocoHorario').classList.add('d-none');
            document.getElementById('editarTipoRegEsquecido').value = '';
            document.getElementById('editarHoraRegEsquecido').value = '';
        }
    });

    document.getElementById('editarAbonoParcial').addEventListener('change', function() {
        document.getElementById('editarBlocoHorario').classList.toggle('d-none', !this.checked);
    });

    // Botão de Bater Ponto
    btnPonto.addEventListener('click', async function() {
        if (!tipoRegistro.value) {
            mostrarAvisoBatida('Selecione o tipo de registro (Entrada, Repouso, Retorno ou Saída).', 'warning');
            return;
        }

        if (!homeOfficeHoje && !currentLocation) {
            mostrarAvisoBatida('A localização é obrigatória para registrar o ponto.', 'warning');
            return;
        }

        limparAvisoBatida();
        envioEmAndamento = true;
        btnPonto.disabled = true;
        btnPonto.innerHTML = '<i class="bi bi-hourglass-split"></i> Registrando...';

        // `performance.now()` e nao `Date.now()`: e relogio monotonico de tempo decorrido.
        // Acerto de relogio do aparelho para tras mascararia o congelamento que esta guarda
        // existe para pegar; para a frente descartaria batida legitima.
        const momentoDoToque = performance.now();
        const payload = { tipo: tipoRegistro.value };

        if (!homeOfficeHoje) {
            let latitude = currentLocation.latitude;
            let longitude = currentLocation.longitude;
            let precisaoGps = currentLocation.precisaoGps;

            // Atualizar a posição é uma MELHORIA, nunca uma condição para enviar: sem o prazo
            // próprio de `lerPosicaoComPrazo`, esta espera trava o envio inteiro (ver o comentário
            // dela). Não atualizou, segue com a posição que ligou o botão.
            const position = await lerPosicaoComPrazo(GPS_PRAZO_ATUALIZACAO_MS);
            if (position) {
                latitude = position.coords.latitude;
                longitude = position.coords.longitude;
                precisaoGps = position.coords.accuracy;
                currentLocation = { latitude, longitude, precisaoGps };
            } else {
                console.log('Não foi possível atualizar o GPS a tempo; usando a última posição conhecida.');
            }

            payload.latitude = latitude;
            payload.longitude = longitude;
            payload.precisaoGps = precisaoGps;
        }

        // O servidor carimba a batida com a hora de CHEGADA da requisição
        // (`PontoController::batida` → `setDataHora(new \DateTime())`); o payload não leva o
        // instante do toque. Se a aba foi congelada e o envio só sair minutos depois, a batida
        // entraria com a hora errada e com cara de certa. Num módulo de risco ALTO, dado errado
        // silencioso é pior que ausência visível — então aqui NÃO se envia: devolve o botão e
        // manda repetir, que é o comportamento que a pessoa já conhecia.
        if (performance.now() - momentoDoToque > LIMITE_ATRASO_ENVIO_MS) {
            mostrarAvisoBatida(
                'Demorou demais para enviar e a hora da batida ficaria errada. Aperte de novo com a tela ligada.',
                'danger'
            );
            liberarBotaoBatida();
            return;
        }

        // `sucesso` existe por causa do `finally`: no caminho bom o botão fica desabilitado de
        // propósito até a página recarregar, senão ele volta a clicável por 1,5 s e aceita uma
        // segunda batida do mesmo tipo.
        let sucesso = false;
        const abortoDoEnvio = new AbortController();
        const prazoDoEnvio  = setTimeout(() => abortoDoEnvio.abort(), ENVIO_PRAZO_MS);

        try {
            const response = await fetch('{{ path('ponto_batida') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload),
                signal: abortoDoEnvio.signal
            });

            // Resposta que não é JSON (sessão expirada devolve a tela de login, erro do servidor
            // devolve HTML) quebrava no `.json()` e caía no catch como "erro de conexão", que é
            // diagnóstico errado e manda a pessoa tentar de novo sem sair do lugar.
            let data = null;
            try {
                data = await response.json();
            } catch (erroDeLeitura) {
                data = null;
            }

            if (response.ok && data && data.success) {
                sucesso = true;
                mostrarAvisoBatida(data.message, 'success');
                setTimeout(() => window.location.reload(), 1500);
            } else if (data && data.message) {
                mostrarAvisoBatida(data.message, 'danger');
            } else if (response.status === 401 || response.status === 403 || response.redirected) {
                // Recusa de regra vem com JSON e foi tratada no ramo acima. Chegar aqui com 401/403
                // é sessão expirada ou token de segurança inválido: nesses o servidor barra ANTES
                // de gravar, então dá para afirmar que a batida não entrou.
                mostrarAvisoBatida(AVISO_NAO_ENTROU, 'danger', true);
            } else {
                mostrarAvisoBatida(AVISO_SEM_CONFIRMACAO, 'danger', true);
            }
        } catch (error) {
            // 🔑 Aqui o navegador NÃO SABE se a batida entrou. O aborto cancela só o lado de cá: a
            // requisição já saiu e o servidor pode ter gravado antes de a resposta se perder. Dizer
            // "não foi registrada" e mandar repetir produzia batida duplicada, e o servidor não tem
            // guarda de duplicata (`PontoController::batida` só valida repouso e interjornada).
            // Por isso o aviso manda CONFERIR o bloco de hoje, que é logo abaixo e mostra inclusive
            // quantos registros existem de cada tipo.
            // `navigator.onLine` só é confiável quando diz FALSO (o sistema sabe que não há rota).
            // Usá-lo para ESCONDER o botão é seguro; usá-lo para afirmar que há internet não seria.
            const semRede = navigator.onLine === false;
            mostrarAvisoBatida(semRede ? AVISO_SEM_REDE : AVISO_SEM_CONFIRMACAO, 'danger', !semRede);
            console.error('Erro ao registrar ponto:', error);
        } finally {
            clearTimeout(prazoDoEnvio);
            if (!sucesso) {
                liberarBotaoBatida();
            }
        }
    });
</script>
{% endblock %}
