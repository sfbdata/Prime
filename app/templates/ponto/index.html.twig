        {% include 'ponto/_tela_cheia.html.twig' with {cercaValendo: geoLigado and not homeOfficeHoje} only %}
    {% endif %}

    {# E8: aviso flutuante (P80, L266), já no documento para o leitor de tela anunciar a troca. `data-aviso-na-carga` é o
       aviso que o servidor deixou para esta tela, com o tom (`data-aviso-na-carga-tom`): "Enviado para aprovação do
       gestor." depois do envio da justificativa, "Justificativa abonada." ou "Justificativa recusada." depois da análise
       e o resultado do abono em lote da Equipe. O `PontoController::index` o lê antes do layout para não aparecer também
       no topo da página. #}
    <div id="ponto-aviso-flutuante" class="pe-flutuante" role="status" hidden
         {%- if avisoFlutuante %} data-aviso-na-carga="{{ avisoFlutuante.texto|e('html_attr') }}" data-aviso-na-carga-tom="{{ avisoFlutuante.tom|e('html_attr') }}"{% endif %}></div>
</div>

<script src="{{ asset('js/ponto-batida.js') }}"></script>
{# E8: o aviso flutuante, os sons e a tela cheia vêm antes do script da tela, que os usa. #}
<script src="{{ asset('js/ponto-aviso-flutuante.js') }}"></script>
<script src="{{ asset('js/ponto-sons.js') }}"></script>
<script src="{{ asset('js/ponto-tela-cheia.js') }}"></script>
{# Abas de gestão (E5 e E6): o carregador do painel ouve a aba antes de o js/ponto-abas.js avisar que ela abriu. #}
<script src="{{ asset('js/ponto-paineis.js') }}"></script>
<script src="{{ asset('js/ponto-equipe.js') }}"></script>
<script src="{{ asset('js/ponto-configuracoes.js') }}"></script>
<script src="{{ asset('js/ponto-configuracoes-sedes.js') }}"></script>
<script src="{{ asset('js/ponto-auditoria.js') }}"></script>
<script src="{{ asset('js/ponto-fila.js') }}"></script>
<script src="{{ asset('js/ponto-abas.js') }}"></script>
<script src="{{ asset('js/ponto-janelas.js') }}"></script>
<script>
    // Limite entre "Localização confirmada" e "GPS impreciso" (P9, valor do desenho). Só muda o texto da caixa: quem
    // decide se a batida passa é a cerca, com a margem da precisão (`PontoBatida.avaliarPosicao`), e o servidor.
    const GPS_PRECISAO_ACEITAVEL_METROS = 50;

    // Data de hoje SEGUNDO O SERVIDOR. Fica no escopo do script inteiro porque dois trechos
    // precisam dela: o relógio, para montar os horários do dia, e a checagem de virada do dia.
    //
    // 🪤 O relógio usava `new Date().toISOString().slice(0,10)`, que é a data em UTC, combinada com
    // horário LOCAL. Das 21h à meia-noite (BRT = UTC−3) o UTC já virou o dia seguinte, a diferença
    // contra `agora` dava negativa e o contador mostrava 00:00:00 para quem estava trabalhando.
    //
    // Ainda resta o fuso DO APARELHO na montagem: `new Date(ano, mes, dia, ...)` constrói na
    // timezone do dispositivo, e o servidor roda em America/Sao_Paulo. Celular com fuso divergente
    // continua contando errado — deixou de ser o 00:00:00 óbvio e virou número plausível, que é
    // pior de notar. Fechar isso exige o servidor mandar o próprio deslocamento; não está feito.
    const [anoHoje, mesHoje, diaHoje] = JSON.parse('{{ dataHoje|json_encode|e('js') }}').split('-').map(Number);

    // Troca o estado do dia que o relógio usa (entrada, repouso, retorno, saída) e redesenha situação, relógio, aviso do
    // intervalo e da saída e excedente. A tela chama depois da batida, com o `data-ponto-do-dia` que o servidor entregou
    // (spec ponto-atualiza-sem-recarregar). Antes, o estado era `const` lido uma vez na carga.
    let aplicarPontoDoDia = function () {};
    // E8: a saída do dia ainda falta, pelo relógio e pela página (o relógio a põe; ver `checarLembreteDeSaida`).
    let saidaAindaPendente = function () { return true; };
    // E8: a página terminou de montar (posta no fim do script). Antes disso, `confirmadasDaPagina` ainda não existe.
    let paginaMontada = false;

    // Hora do SERVIDOR (D9): hora feita no navegador é falsificável, e o celular pode estar com o relógio ou o fuso
    // errados. O servidor manda o instante em que montou a página (`data-agora-ms`), o fuso dele e a próxima
    // meia-noite nesse fuso (`data-proxima-virada-ms`). Aqui fica só o deslocamento entre esse instante e a chegada da
    // resposta; somado ao relógio do aparelho, a hora anda. Do aparelho entra só o tempo que PASSOU: o fuso e a hora
    // dele não entram. Serve a hora oficial do cartão (P5) e a virada do dia (`conferirViradaDoDia`).
    const horaOficialEl = document.getElementById('ponto-hora-oficial');
    const FUSO_DO_SERVIDOR = (horaOficialEl && horaOficialEl.dataset.fuso) || undefined;
    const PROXIMA_VIRADA_MS = horaOficialEl ? Number(horaOficialEl.dataset.proximaViradaMs) : NaN;
    let deslocamentoDoServidor = null;

    function agoraNoServidorMs() {
        return deslocamentoDoServidor === null ? null : Date.now() + deslocamentoDoServidor;
    }

    function sincronizarComOServidor(agoraMs, chegadaMs) {
        if (Number.isFinite(agoraMs) && agoraMs > 0) {
            deslocamentoDoServidor = agoraMs - chegadaMs;
        }
        desenharHoraOficial();
    }

    function formatoNoFusoDoServidor(opcoes) {
        try {
            return new Intl.DateTimeFormat('pt-BR', Object.assign({ timeZone: FUSO_DO_SERVIDOR }, opcoes));
        } catch (erro) {
            return new Intl.DateTimeFormat('pt-BR', opcoes);
        }
    }

    const FORMATO_HORA_OFICIAL = formatoNoFusoDoServidor({ hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
    const FORMATO_DATA_OFICIAL = formatoNoFusoDoServidor({ weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });

    // E8: as funções da tela, cada uma Global E Escritório (`PontoController::index`). `ponto-animacao`: o resultado do
    // toque na tela cheia (desligada, no aviso flutuante); `ponto-sons`: o som do resultado e o botão de som;
    // `ponto-lembrete`: a saída prevista e o lembrete quando ela passa. Declaradas antes do relógio, que usa o lembrete
    // já na carga.
    const ANIMACAO_LIGADA = {{ animacaoLigada ? 'true' : 'false' }};
    const SONS_LIGADOS = {{ sonsLigados ? 'true' : 'false' }};
    const LEMBRETE_LIGADO = {{ lembreteLigado ? 'true' : 'false' }};
    if (window.PontoSons) {
        window.PontoSons.configurar({ ligados: SONS_LIGADOS });
    }
    // Fechada a tela cheia (Concluir, Esc, 10 s), o foco vai ao título do cartão, e não ao "Bater Ponto" já liberado:
    // um Enter logo depois registraria o próximo tipo.
    if (window.PontoTelaCheia) {
        window.PontoTelaCheia.configurar({ focoAoFechar: () => document.getElementById('ponto-registrar-titulo') });
    }

    // Aviso flutuante (P80): devolve false sem o módulo (arquivo que não carregou), e quem chama decide o que fazer.
    function avisarFlutuante(texto, tom) {
        if (!window.PontoAvisoFlutuante) {
            return false;
        }
        window.PontoAvisoFlutuante.mostrar(texto, tom);

        return true;
    }

    // E8 (P83; desenho L454 e `checarLembrete` L437 e L454): uma vez por dia, quando passa da saída prevista sem a saída
    // batida, o lembrete toca o "plim" (com os sons valendo e sem o mudo), mostra o aviso âmbar e manda a notificação do
    // navegador, se ela já foi permitida (o pedido é feito no toque, `PontoBatida.pedirPermissaoDeNotificacao`). "Uma vez
    // por dia" é por aparelho: fica no `localStorage` (por pessoa, escritório e dia do servidor), para recarregar a
    // página não repetir o lembrete; sem armazenamento, vale enquanto a página está aberta.
    const AVISO_LEMBRETE_DE_SAIDA = 'Passou do horário previsto. Não esqueça de registrar a saída.';
    const FORMATO_DIA_DO_LEMBRETE = formatoNoFusoDoServidor({ day: '2-digit', month: '2-digit', year: 'numeric' });
    let lembreteDadoNoDia = '';

    function dispararLembreteDeSaida() {
        if (!LEMBRETE_LIGADO) {
            return;
        }
        const agoraMs = agoraNoServidorMs();
        const dia = FORMATO_DIA_DO_LEMBRETE.format(new Date(agoraMs === null ? Date.now() : agoraMs));
        const caixaDaPessoa = document.getElementById('ponto-fila');
        const chave = 'bj-ponto-lembrete:' + (caixaDaPessoa ? caixaDaPessoa.dataset.usuarioId + ':' + caixaDaPessoa.dataset.escritorioId : '');
        if (lembreteDadoNoDia === dia) {
            return;
        }
        // A saída já marcada na página (a guardada na fila sem internet; a confirmada com a busca da tela falhando) não
        // pede lembrete, e o dia não fica marcado: o relógio só a recebe quando a busca da tela volta.
        if (saidaBatidaNaPagina()) {
            return;
        }
        lembreteDadoNoDia = dia;
        try {
            if (localStorage.getItem(chave) === dia) {
                return;
            }
            localStorage.setItem(chave, dia);
        } catch (erro) {
            /* Sem armazenamento: o lembrete vale enquanto a página está aberta. */
        }
        // O plim e o aviso âmbar esperam a tela cheia do registro fechar (e a janela aberta no lugar dela) e saem juntos
        // (o plim não toca por cima dela). Na saída conferem de novo se a saída ainda falta: ela pode ter sido batida
        // nessa validação.
        depoisDaTelaCheia(() => {
            if (!saidaAindaPendente()) {
                return;
            }
            if (window.PontoSons) {
                window.PontoSons.liberar();
                window.PontoSons.ok();
            }
            avisarFlutuante(AVISO_LEMBRETE_DE_SAIDA, 'lembrete');
        });
        try {
            if (window.Notification && Notification.permission === 'granted') {
                new Notification('BlueJus Ponto', { body: 'Não esqueça de registrar a saída.' });
            }
        } catch (erro) {
            /* Navegador que só notifica pelo service worker (Chrome do Android): fica o aviso na tela. */
        }
    }

    function desenharHoraOficial() {
        const horaEl = document.getElementById('ponto-hora-oficial-hora');
        const dataEl = document.getElementById('ponto-hora-oficial-data');
        const agoraMs = agoraNoServidorMs();
        if (!horaEl || !dataEl) {
            return;
        }
        if (agoraMs === null) {
            horaEl.textContent = '--:--:--';
            return;
        }
        horaEl.textContent = FORMATO_HORA_OFICIAL.format(new Date(agoraMs));
        dataEl.textContent = FORMATO_DATA_OFICIAL.format(new Date(agoraMs));
    }

    // Página que voltou do cache pelo botão Voltar traz o instante de antes: a hora some ("--:--:--") até buscar a
    // página de novo, em vez de mostrar uma hora velha como oficial.
    function sincronizarNaCarga() {
        const navegacao = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || null;
        const doCache = !!navegacao && navegacao.type === 'back_forward' && navegacao.transferSize === 0;
        if (!horaOficialEl || (doCache && !window.PontoBatida)) {
            return;
        }
        if (!doCache) {
            const chegada = navegacao && navegacao.responseStart > 0 ? performance.timeOrigin + navegacao.responseStart : Date.now();
            sincronizarComOServidor(Number(horaOficialEl.dataset.agoraMs), chegada);
            return;
        }
        window.PontoBatida.buscarTelaDoPonto(window.location.href).then((novo) => {
            const nova = novo.getElementById('ponto-hora-oficial');
            sincronizarComOServidor(Number(nova && nova.dataset.agoraMs), Date.now());
        }).catch(() => desenharHoraOficial());
    }

    sincronizarNaCarga();
    setInterval(desenharHoraOficial, 1000);
    desenharHoraOficial();

    // Contador de tempo trabalhado no dia
    (function() {
        const clockEl = document.getElementById('clock');
        const labelEl = document.getElementById('clock-label');

        function parseHMS(hms) {
            if (!hms) return null;
            const [hora, minuto, segundo] = hms.split(':').map(Number);
            return new Date(anoHoje, mesHoje - 1, diaHoje, hora, minuto, segundo || 0);
        }

        let tEntrada = null;
        let tRepouso = null;
        let tRetorno = null;
        let tSaida   = null;

        // Duração da escala de hoje, da entrada à saída (conta o almoço); null sem entrada ou saída na escala.
        const duracaoMinutos = {{ duracaoJornadaDiariaMinutos is not null ? duracaoJornadaDiariaMinutos : 'null' }};

        function definirPontoDoDia(pontoHoje) {
            tEntrada = parseHMS(pontoHoje.entrada);
            tRepouso = parseHMS(pontoHoje.repouso);
            tRetorno = parseHMS(pontoHoje.retorno);
            tSaida   = parseHMS(pontoHoje.saida);
            // P14: a faixa da última pendência é só de antes da entrada do dia. Ela vem do servidor e não entra
            // na troca depois da batida; com a entrada batida, some aqui.
            const faixaDaPendencia = document.getElementById('ponto-ultima-pendencia');
            if (faixaDaPendencia && tEntrada) {
                faixaDaPendencia.classList.add('d-none');
            }
        }

        definirPontoDoDia(JSON.parse(clockEl.dataset.pontoDoDia || '{}'));

        // Tempo trabalhado do dia, com a mesma conta da folha (`CalculadoraJornada::calcularMinutosDaEscolha`):
        // com intervalo válido (retorno depois do repouso), os dois trechos; sem ele, o span da entrada até a
        // saída (ou agora). Ao vivo, em repouso sem retorno, para no repouso. Antes, o retorno sem repouso
        // somava o trecho do retorno por cima do span (13 h na tela contra 9 h na folha). Serve o relógio e o
        // contador de horas excedentes.
        function calcSegundosTrabalhados(agora) {
            if (!tEntrada) return 0;
            const fim = tSaida || agora;
            const intervaloValido = tRepouso && tRetorno && tRetorno > tRepouso;
            // Par invertido com a saída batida (saída antes da entrada, repouso antes da entrada ou saída antes
            // do retorno): a folha deixa o dia incompleto e conta 0 (`CalculadoraJornada::parInvertido`).
            if (tSaida && (tSaida < tEntrada || (intervaloValido && (tRepouso < tEntrada || tSaida < tRetorno)))) return 0;
            let total;
            if (intervaloValido) {
                total = Math.max(0, tRepouso - tEntrada) + Math.max(0, fim - tRetorno);
            } else if (tRepouso && !tRetorno && !tSaida) {
                total = Math.max(0, tRepouso - tEntrada);
            } else {
                total = Math.max(0, fim - tEntrada);
            }

            return Math.floor(total / 1000);
        }

        function formatarTempo(segundos) {
            const h = Math.floor(segundos / 3600);
            const m = Math.floor((segundos % 3600) / 60);
            const s = segundos % 60;
            return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        }

        // Horas excedentes: trabalhado (a conta da folha, acima) menos a meta do dia. Abaixo da meta ou com
        // meta 0, escondido. Pausa no intervalo e fica parado depois da saída, como o relógio.
        const excedenteEl      = document.getElementById('excedente-hoje');
        const excedenteValorEl = document.getElementById('excedente-hoje-valor');
        const metaDiaMinutos   = excedenteEl ? (Number(excedenteEl.getAttribute('data-meta-dia-minutos')) || 0) : 0;

        function formatarHorasMinutos(segundos) {
            const h = Math.floor(segundos / 3600);
            const m = Math.floor((segundos % 3600) / 60);
            return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
        }

        function updateExcedente(agora) {
            if (!excedenteEl || !excedenteValorEl) return;
            const excedente = calcSegundosTrabalhados(agora) - metaDiaMinutos * 60;
            if (metaDiaMinutos > 0 && excedente >= 60) {
                excedenteValorEl.textContent = '+' + formatarHorasMinutos(excedente);
                excedenteEl.classList.remove('d-none');
                return;
            }
            excedenteEl.classList.add('d-none');
        }

        // P12 (desenho, decisão do dono de 09/11/2026): o aviso do dia no cartão. Em repouso, o tempo do intervalo ao
        // vivo, quanto falta para o mínimo do escritório e a saída prevista; depois da entrada, a saída prevista e o
        // lembrete quando ela passa.
        // Usa a mesma hora do aparelho que o relógio; a regra do intervalo continua no servidor.
        const avisoDiaEl = document.getElementById('ponto-aviso-dia');
        // O mínimo do aviso vem do servidor já com a chave do escritório: 0 com a validação do repouso desligada.
        const minimoRepousoMinutos = avisoDiaEl ? (Number(avisoDiaEl.dataset.intervaloMinimoMinutos) || 0) : 0;

        function formatarMinimo(minutos) {
            const h = Math.floor(minutos / 60);
            const m = minutos % 60;
            if (h === 0) return m + 'min';

            return m === 0 ? h + 'h' : h + 'h' + String(m).padStart(2, '0');
        }

        // Sem meta (feriado, dia fora da escala), sem previsão nem lembrete de saída, antes ou depois do repouso. Antes
        // do repouso batido, a conta do sistema: entrada + duração da escala de hoje, com o almoço da escala (a 1h do
        // protótipo é valor de exemplo). Com o intervalo batido: entrada + meta do dia + o intervalo batido. Sem ele (em
        // repouso; decisão do Coordenador de 09/11/2026), coerente com a de antes do repouso: sem escala, nenhuma; com
        // ela, entrada + meta + o maior entre o intervalo já feito até `agora` e o piso. O piso é o maior entre o mínimo
        // que o servidor aplica (o da Jornada do escritório com a validação do repouso ligada; 0 desligada) e o almoço da
        // escala (duração menos meta), com ou sem almoço. Escala 08-12/14-18 (meta 480, mínimo 60): 18:00 antes e no
        // começo do repouso, 18:10 com 2h10 de repouso. Escala de 8h sem almoço e mínimo 60 ligado: 17:00 até 1h de
        // repouso. Quem chama no repouso passa `agora`, a cada tique do relógio. No repouso com a meta já coberta até
        // ele (decisão do Coordenador de 09/11/2026), nenhuma: o aviso mostra só o intervalo (dc L771), em vez de uma
        // hora já passada que andava com o relógio. Depois do retorno, a conta do intervalo batido dá uma hora fixa e o
        // aviso segue "Passou da saída prevista".
        function saidaPrevista(agora) {
            if (!tEntrada || metaDiaMinutos <= 0) return null;
            if (!tRepouso) {
                return duracaoMinutos === null ? null : new Date(tEntrada.getTime() + duracaoMinutos * 60000);
            }
            if (tRetorno && tRetorno > tRepouso) {
                return new Date(tEntrada.getTime() + metaDiaMinutos * 60000 + (tRetorno - tRepouso));
            }
            if (tRepouso - tEntrada >= metaDiaMinutos * 60000) return null;
            if (duracaoMinutos === null) return null;
            const almocoDaEscalaMs = Math.max(0, duracaoMinutos - metaDiaMinutos) * 60000;
            const pisoMs = Math.max(minimoRepousoMinutos * 60000, almocoDaEscalaMs);
            const feitoMs = agora && !tRetorno && !tSaida ? agora - tRepouso : 0;

            return new Date(tEntrada.getTime() + metaDiaMinutos * 60000 + Math.max(feitoMs, pisoMs));
        }

        // Redesenha só quando o texto muda (o relógio chama a cada segundo). Texto e ícone via DOM, sem innerHTML.
        function mostrarAvisoDoDia(tom, icone, texto) {
            if (!avisoDiaEl) return;
            const chave = texto ? tom + '|' + texto : '';
            if (avisoDiaEl.dataset.chave === chave) return;
            avisoDiaEl.dataset.chave = chave;
            if (!texto) {
                avisoDiaEl.classList.add('d-none');
                return;
            }
            const iconeEl = document.createElement('i');
            iconeEl.className = 'bi ' + icone;
            iconeEl.setAttribute('aria-hidden', 'true');
            const textoEl = document.createElement('span');
            textoEl.className = 'pe-caixa-texto';
            textoEl.textContent = texto;
            avisoDiaEl.replaceChildren(iconeEl, textoEl);
            avisoDiaEl.className = 'pe-caixa pe-caixa--' + tom;
        }

        function formatarHoraDoDia(data) {
            return String(data.getHours()).padStart(2, '0') + ':' + String(data.getMinutes()).padStart(2, '0');
        }

        function atualizarAvisoDoDia(agora) {
            // Em repouso: o tempo do intervalo ao vivo, em HH:MM:SS, durante todo o repouso, com ou sem a validação do
            // repouso (função do sistema que volta: o contador do repouso de antes da E1). O tique é o do relógio
            // (`updateClock`, a cada segundo); o início é a hora da batida de repouso que o cartão já tem. Com a
            // validação, também o mínimo do escritório. E a saída prevista, quando houver (também função que volta).
            if (tRepouso && !tRetorno && !tSaida) {
                const decorrido = Math.max(0, Math.floor((agora - tRepouso) / 1000));
                const emIntervaloHa = formatarTempo(decorrido);
                const previstaNoRepouso = saidaPrevista(agora);
                const saida = previstaNoRepouso ? ' Saída prevista às ' + formatarHoraDoDia(previstaNoRepouso) + '.' : '';
                if (minimoRepousoMinutos <= 0) {
                    mostrarAvisoDoDia('info', 'bi-hourglass-split', 'Intervalo em andamento há ' + emIntervaloHa + '.' + saida);
                    return;
                }
                const minimo = formatarMinimo(minimoRepousoMinutos);
                const restante = minimoRepousoMinutos * 60 - decorrido;
                if (restante > 0) {
                    // Arredondado para cima, no minuto: 17min50s dá 00:18, e os últimos 59 s dão 00:01, nunca 00:00.
                    const faltaEmMinutos = Math.ceil(restante / 60);
                    mostrarAvisoDoDia('info', 'bi-hourglass-split', 'Intervalo em andamento há ' + emIntervaloHa + '. O mínimo de ' + minimo + ' se completa em ' + formatarHorasMinutos(faltaEmMinutos * 60) + '.' + saida);
                    return;
                }
                mostrarAvisoDoDia('success', 'bi-check-circle', 'Intervalo mínimo de ' + minimo + ' cumprido. Em intervalo há ' + emIntervaloHa + '.' + saida);
                return;
            }
            // E8 (P83): com a função `ponto-lembrete` desligada, sem "Saída prevista" e sem o lembrete (aviso, som e
            // notificação).
            if (!LEMBRETE_LIGADO) {
                mostrarAvisoDoDia('', '', '');
                return;
            }
            const previsao = tSaida ? null : saidaPrevista();
            if (!previsao) {
                mostrarAvisoDoDia('', '', '');
                return;
            }
            const hora = formatarHoraDoDia(previsao);
            if (agora > previsao) {
                mostrarAvisoDoDia('warning', 'bi-bell', 'Passou da saída prevista (' + hora + '). Não esqueça de registrar a saída.');
                return;
            }
            mostrarAvisoDoDia('info', 'bi-bell', 'Saída prevista às ' + hora + '.');
        }

        // E8 (desenho L437 e L454, `checarLembrete`): o lembrete de saída é conferido pelo relógio, a cada segundo, fora
        // da escolha do aviso do dia: dispara também em repouso sem retorno, quando a caixa mostra o intervalo.
        function checarLembreteDeSaida(agora) {
            if (!LEMBRETE_LIGADO || !tEntrada || tSaida) return;
            const previsao = saidaPrevista();
            if (previsao && agora > previsao) {
                dispararLembreteDeSaida();
            }
        }

        // O lembrete que esperou a tela cheia: a saída batida nessa validação já está na página antes de o relógio saber
        // (`saidaBatidaNaPagina`); o relógio só a recebe quando a busca da tela volta.
        saidaAindaPendente = function () {
            return LEMBRETE_LIGADO && !!tEntrada && !tSaida && !saidaBatidaNaPagina();
        };

        function updateClock() {
            const agora = new Date();
            let label = '';

            if (!tEntrada) {
                clockEl.textContent = '00:00:00';
                label = 'Aguardando entrada';
            } else if (tSaida) {
                const segundos = calcSegundosTrabalhados(agora);
                clockEl.textContent = formatarTempo(segundos);
                label = 'Jornada encerrada';
            } else if (tRepouso && !tRetorno) {
                const segundos = calcSegundosTrabalhados(agora);
                clockEl.textContent = formatarTempo(segundos);
                label = 'Em repouso';
            } else {
                const segundos = calcSegundosTrabalhados(agora);
                clockEl.textContent = formatarTempo(segundos);
                label = 'Em jornada';
            }

            labelEl.textContent = label;
            atualizarAvisoDoDia(agora);
            checarLembreteDeSaida(agora);
            updateExcedente(agora);
        }

        setInterval(updateClock, 1000);
        updateClock();

        aplicarPontoDoDia = function (pontoHoje) {
            definirPontoDoDia(pontoHoje);
            updateClock();
        };
    })();

    const btnPonto = document.getElementById('btn-bater-ponto');
    const gpsStatus = document.getElementById('gps-status');
    const tipoRegistro = document.getElementById('tipo-registro');
    let currentLocation = null;
    // Flag de home office de hoje (controlada pelo servidor): quando true, a batida dispensa GPS.
    const homeOfficeHoje = {{ homeOfficeHoje ? 'true' : 'false' }};
    // E7: a geolocalização desligada (pelo Master ou pelo escritório) também dispensa a posição e a cerca; o servidor
    // decide do mesmo jeito na batida. Sem ela a batida não vira home office.
    const geoLigado = {{ geoLigado ? 'true' : 'false' }};
    const dispensaLocalizacao = homeOfficeHoje || !geoLigado;

    // Enquanto uma batida está em envio, ou já foi aceita e a página vai recarregar, o botão é do
    // envio e de mais ninguém. Sem esta trava, trocar o tipo (nos botões dos tipos) durante o 1,5 s até o
    // recarregamento chamava `updateButtonState()` e reabilitava o botão — gesto natural de quem já
    // está pensando na próxima batida, e que fazia sair uma segunda antes do reload.
    let envioEmAndamento = false;

    // Marca que o dia virou com a página aberta. Serve só para avisar uma vez; NÃO entra em
    // `updateButtonState` de propósito — ver o comentário de `conferirViradaDoDia`.
    let diaVirou = false;

    // Sedes do escritório ativo, para a tela saber dizer "fora da área" ANTES do toque.
    const SEDES = JSON.parse('{{ sedesDaTela|json_encode|e('js') }}');
    // E12 (P74): o escritório permite o trabalho externo (`data-trabalho-externo` da caixa da fila). Aqui em cima porque
    // a caixa da localização (`mostrarForaDaArea`) o usa, e ela é chamada do retorno do GPS.
    const TRABALHO_EXTERNO_PERMITIDO = (document.getElementById('ponto-fila') || { dataset: {} }).dataset.trabalhoExterno === '1';

    // Declarados AQUI, e não junto do resto do fluxo de envio, porque `guardarPosicao` os usa e é
    // chamada de callback de GPS. `const` não é içado: a ordem só não quebrava por acidente de o
    // callback ser assíncrono, e um refactor deixaria a tela morrer na carga.
    const avisoBatida = document.getElementById('batida-aviso');
    const btnAtualizarPagina = document.getElementById('btn-atualizar-pagina');
    // Botão redondo da caixa da localização (desenho): refaz a busca. Fica ausente no home office.
    const btnAtualizarGps = document.getElementById('btn-gps-atualizar');

    /**
     * Quem manda no botão "Atualizar e conferir" quando a cerca e um aviso discordam.
     *
     * 🔴 **Só UM aviso veta: o de sem rede.** Ele é o único que protege prova — recarregar sem
     * conexão entrega a página de erro do navegador e leva junto o aviso e os horários de hoje nos
     * botões dos tipos, que são a única pista de que a batida pode ter entrado.
     *
     * 🪤 A primeira versão vetava por QUALQUER aviso na tela, e isso criou tela sem saída: pessoa em
     * situação indeterminada aperta → o servidor recusa com 403 e mensagem → o aviso fica → depois a
     * posição piora e a cerca escreve "peça a liberação e ATUALIZE esta página" → mas o botão de
     * atualizar seguia vetado pelo aviso da recusa. Botão de bater cinza, botão de atualizar
     * escondido, e a instrução mandando fazer o que não dá. Os avisos de tipo não escolhido, sem
     * localização, envio atrasado e recusa do servidor não têm prova nenhuma a proteger: neles o
     * servidor barrou antes de gravar, ou nada chegou a ser enviado.
     *
     * O envio em andamento também tranca: um clique com a requisição em voo recarrega no meio dela.
     */
    function cercaMandaNoBotaoAtualizar() {
        return !envioEmAndamento && avisoBatida.textContent !== AVISO_SEM_REDE;
    }

    // A avaliação da cerca (`avaliarPosicao`), o leitor de posição com prazo, os prazos e o envio
    // com a classificação da resposta moram em `public/js/ponto-batida.js` (`window.PontoBatida`),
    // carregado antes deste script: o atalho do ponto no cabeçalho usa as mesmas funções, e a regra
    // não pode divergir entre as duas portas. Aqui fica só o que depende dos elementos desta tela.

    // O botão só fica cinza durante o envio (~1,5 s, com "Registrando..." escrito nele), que é o
    // único caso em que a pessoa acabou de ver o sistema responder e a trava impede batida
    // duplicada. Nenhum impedimento de REGRA desabilita mais: tipo não escolhido, falta de posição
    // e cerca são verificados no clique (ver o handler de `btnPonto`), cada um com sua mensagem em
    // `#batida-aviso`. A cerca continua bloqueando o envio — o que mudou foi só o feedback.
    //
    // P7 (decisão do dono de 09/11/2026): a segunda e última trava é o dia COMPLETO. Com os quatro tipos de hoje
    // batidos não há o que registrar, e o botão vira "Jornada de hoje concluída", cinza e sem clique. Não é
    // impedimento de regra (tipo, posição, cerca): esses continuam respondendo ao toque.
    function updateButtonState() {
        const concluida = jornadaConcluida();
        btnPonto.disabled = envioEmAndamento || concluida;
        btnPonto.classList.toggle('pe-bater--concluida', concluida);
    }

    // Dia completo: nenhum dos quatro tipos de hoje livre. Na virada do dia os tipos voltam livres
    // (`zerarTiposNaVirada`), e o dia completo de ontem deixa de travar o botão.
    function jornadaConcluida() {
        const tipos = document.getElementById('ponto-tipos');

        return !!tipos && tipos.querySelector('button[role="radio"]:not(:disabled)') === null;
    }

    const ROTULOS_TIPO = { entrada: 'Entrada', repouso: 'Repouso', retorno: 'Retorno', saida: 'Saída' };
    // A digital do desenho vem no HTML do botão; o rótulo redesenhado reaproveita o mesmo SVG.
    const ICONE_DIGITAL = (btnPonto.querySelector('svg') || { outerHTML: '' }).outerHTML;

    function rotuloBotaoBatida() {
        if (jornadaConcluida()) {
            return ICONE_DIGITAL + 'Jornada de hoje concluída';
        }
        const nome = ROTULOS_TIPO[tipoRegistro.value];
        return ICONE_DIGITAL + 'Bater Ponto' + (nome ? ': ' + nome : '');
    }

    function atualizarRotuloBotao() {
        // Durante o envio o botão é do envio: sobrescrever aqui apagaria o "Registrando...".
        if (envioEmAndamento) {
            return;
        }
        btnPonto.innerHTML = rotuloBotaoBatida();
    }

    tipoRegistro.addEventListener('change', function() {
        updateButtonState();
        atualizarRotuloBotao();
        marcarTipoEscolhido();
    });

    // P6 (desenho): os quatro tipos são botões de rádio (`role="radio"`, como no desenho) que escrevem no
    // `#tipo-registro` escondido, que continua sendo o valor que o envio lê. Clique e teclado são delegados ao
    // contêiner porque a lista é trocada depois de cada batida (`atualizarTelaDoPonto`). Tipo já batido hoje vem
    // desabilitado do servidor (P7) e não responde.
    function marcarTipoEscolhido() {
        const botoes = Array.from(document.querySelectorAll('#ponto-tipos > button[role="radio"]'));
        botoes.forEach((botao) => {
            botao.setAttribute('aria-checked', botao.dataset.tipo === tipoRegistro.value ? 'true' : 'false');
        });
        // Tabindex móvel do grupo de rádio: só o marcado entra no Tab; sem marcado, o primeiro tipo livre.
        const livres = botoes.filter((botao) => !botao.disabled);
        const daVez = livres.find((botao) => botao.dataset.tipo === tipoRegistro.value) || livres[0];
        botoes.forEach((botao) => botao.setAttribute('tabindex', botao === daVez ? '0' : '-1'));
    }

    function escolherTipo(botao) {
        tipoRegistro.value = botao.dataset.tipo;
        tipoRegistro.dispatchEvent(new Event('change'));
    }

    const grupoDoTipo = document.getElementById('ponto-tipo');
    grupoDoTipo.addEventListener('click', function (evento) {
        const botao = evento.target.closest('button[role="radio"]');
        if (!botao || botao.disabled) {
            return;
        }
        escolherTipo(botao);
    });

    // Teclado (o desenho é omisso; vale o grupo de rádio do navegador): as setas andam entre os tipos LIVRES, dando
    // a volta, e já escolhem. Tipo batido (desabilitado) fica fora, como fica fora do clique.
    const PASSO_DA_SETA = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
    grupoDoTipo.addEventListener('keydown', function (evento) {
        const passo = PASSO_DA_SETA[evento.key];
        const atual = evento.target.closest('button[role="radio"]');
        if (!passo || !atual) {
            return;
        }
        const livres = Array.from(document.querySelectorAll('#ponto-tipos > button[role="radio"]:not(:disabled)'));
        const posicao = livres.indexOf(atual);
        if (posicao === -1) {
            return;
        }
        evento.preventDefault();
        const proximo = livres[(posicao + passo + livres.length) % livres.length];
        escolherTipo(proximo);
        proximo.focus();
    });

    // Liga o botão que o HTML entregou cinza. Daqui em diante só o envio o desabilita.
    updateButtonState();
    atualizarRotuloBotao();

    // Geolocalização obrigatória
    //
    // Guardar a posição e mexer no botão são coisas separadas de propósito: uma posição pode chegar
    // com a batida JÁ em envio (callback atrasado do leitor com prazo), e aí `updateButtonState()`
    // reabilitaria um botão que o envio desabilitou — abrindo caminho para batida duplicada. Quem
    // chega atrasado guarda a posição e atualiza o aviso; quem manda no botão é o fluxo do envio.
    function guardarPosicao(position) {
        const accuracy = position.coords.accuracy;
        currentLocation = {
            latitude: position.coords.latitude,
            longitude: position.coords.longitude,
            precisaoGps: accuracy,
        };

        // Botão desabilitado precisa DIZER o motivo e o caminho. Antes ele só ficava cinza, e a
        // pessoa fora da área nem sabia por que não conseguia bater nem o que fazer a respeito.
        if (!window.PontoBatida) {
            return;   // sem o módulo, a posição fica guardada e o toque avisa (AVISO_PAGINA_INCOMPLETA)
        }
        const onde = PontoBatida.avaliarPosicao(currentLocation, SEDES);

        if (onde.situacao === 'fora') {
            // E12: o "fora" é o de hoje (`avaliarPosicao`); a caixa cita a sede mais próxima, a mesma do bloco do toque.
            mostrarForaDaArea(sedeCitadaNaTela(currentLocation) || onde);
            // A liberação do dia (`homeOfficeHoje`) é decidida no servidor e só chega na carga. Se o
            // gestor conceder com a página aberta, o servidor passa a aceitar e a tela continuaria
            // cinza. O botão de atualizar é a saída, e serve também para quem quiser forçar uma
            // releitura em vez de esperar a atualização contínua.
            if (cercaMandaNoBotaoAtualizar()) {
                btnAtualizarPagina.classList.remove('d-none');
            }
            return;
        }

        if (cercaMandaNoBotaoAtualizar()) {
            btnAtualizarPagina.classList.add('d-none');
        }

        // P11 (desenho): os textos das duas situações da posição, montados por DOM.
        if (accuracy <= GPS_PRECISAO_ACEITAVEL_METROS) {
            mostrarGps('success', 'bi-geo-alt-fill', 'Localização confirmada. Precisão de ' + Math.round(accuracy) + ' m.');
            return;
        }
        mostrarGps('warning', 'bi-exclamation-triangle', 'GPS impreciso (' + Math.round(accuracy).toLocaleString('pt-BR') + ' m). O sistema ainda validará se você está dentro do raio de alguma sede.');
    }

    // Achado de auditoria interna F2: o nome da sede é digitado por alguém e chega do servidor. A mensagem é
    // montada por DOM e o nome entra só por `textContent`, nunca por `innerHTML`. O texto é o de hoje, na caixa do
    // desenho. E12 (P18): com o trabalho externo permitido no escritório, a segunda frase é a do desenho (L528), porque
    // o caminho agora é registrar como trabalho externo; sem ele, fica o pedido de liberação do dia.
    //
    // E12 (revisão): `onde` é `{ sede, distancia }` da sede CITADA, a mais próxima em metros (`sedeCitadaNaTela`), a
    // mesma de `textosDoForaDoRaio` no bloco do toque e a do servidor. Com o módulo antigo no cache (sem
    // `sedeMaisProxima`), a de `avaliarPosicao`, como antes.
    function mostrarForaDaArea(onde) {
        const nomeDaSede = document.createElement('strong');
        nomeDaSede.textContent = onde.sede.nome;
        const mensagemDaCerca = document.createElement('span');
        mensagemDaCerca.append(
            `Você está a ${Math.round(onde.distancia)}m de `,
            nomeDaSede,
            ', fora da área permitida para bater o ponto.',
            document.createElement('br'),
            TRABALHO_EXTERNO_PERMITIDO
                ? 'Aproxime-se ou informe o trabalho externo.'
                : 'Se está em trabalho externo ou home office, peça ao gestor a liberação do dia e depois atualize esta página.'
        );
        mostrarGps('danger', 'bi-geo-alt-fill', mensagemDaCerca);
    }

    function sedeCitadaNaTela(posicao) {
        return typeof PontoBatida.sedeMaisProxima === 'function' ? PontoBatida.sedeMaisProxima(posicao, SEDES) : null;
    }

    function aplicarPosicao(position) {
        guardarPosicao(position);
        updateButtonState();
    }

    // Códigos de `GeolocationPositionError`. Antes todo erro virava "Permita o acesso à
    // localização", e quem JÁ tinha permitido (o erro era posição indisponível ou demora) ia
    // procurar uma permissão que estava concedida. Spec: `docs/specs/ponto-gps-erro-que-explica.md`.
    const GPS_PERMISSAO_NEGADA = 1;
    const GPS_POSICAO_INDISPONIVEL = 2;
    const GPS_DEMOROU = 3;

    // iPad com iPadOS 13 ou mais novo se identifica como "Macintosh": a tela de toque denuncia.
    const ehCelular = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || '')
        || (/Macintosh/.test(navigator.userAgent || '') && navigator.maxTouchPoints > 1);
    const VERBO_TOQUE = ehCelular ? 'Toque' : 'Clique';

    const TEXTO_GPS_INDISPONIVEL = 'Não foi possível descobrir sua localização agora. Tente de novo; no computador, deixe o Wi-Fi ligado.';
    const TEXTO_GPS_DEMOROU = 'A busca pela sua localização demorou demais. Tente de novo; no computador, deixe o Wi-Fi ligado.';
    const TEXTO_GPS_PEDIR = 'Para registrar o ponto, o navegador precisa da sua localização. ' + VERBO_TOQUE + ' em "Permitir localização" e escolha Permitir na janela do navegador.';
    const TEXTO_GPS_SISTEMA = 'O navegador tem permissão, mas a localização do aparelho está desligada ou bloqueada para o navegador. Ligue a localização nas configurações do aparelho e ' + VERBO_TOQUE.toLowerCase() + ' em "Tentar de novo".';
    const TEXTO_GPS_API = 'A localização do navegador não está funcionando nesta tela. Tente outro navegador ou fale com o gestor.';
    const TEXTO_GPS_BLOQUEADO = 'A localização está bloqueada para este site. Para liberar:';
    const PASSOS_GPS_COMPUTADOR = [
        'Clique no ícone à esquerda do endereço do site (o cadeado ou os controles).',
        'Em Localização, escolha Permitir.',
        'Recarregue esta página.',
    ];
    // Caminho alternativo, fora da lista numerada (não é o passo seguinte).
    const OUTRO_CAMINHO_GPS_COMPUTADOR = 'No Safari do Mac: menu Safari, Ajustes, Sites, Localização, e escolha Permitir para este site.';
    const PASSOS_GPS_CELULAR = [
        'Toque no ícone à esquerda do endereço do site (o cadeado ou os controles).',
        'Toque em Permissões (ou Configurações do site) e depois em Localização.',
        'Escolha Permitir e recarregue esta página.',
    ];
    const OUTRO_CAMINHO_GPS_CELULAR = 'No iPhone ou iPad, se não aparecer: Ajustes, Privacidade e Segurança, Serviços de Localização, ligue e escolha "Ao Usar o App" para o navegador.';

    // Monta `#gps-status` por DOM, na caixa do desenho (ícone, texto e o botão redondo de atualizar):
    // texto só por `textContent` (ou um nó já montado), botão com handler próprio.
    function mostrarGps(nivel, icone, texto, extra) {
        const i = document.createElement('i');
        i.className = 'bi ' + icone;
        i.setAttribute('aria-hidden', 'true');
        const corpo = document.createElement('span');
        corpo.className = 'pe-caixa-texto';
        corpo.append(texto);
        if (extra) {
            corpo.append(extra);
        }
        gpsStatus.replaceChildren(...[i, corpo, btnAtualizarGps].filter(Boolean));
        gpsStatus.className = 'pe-caixa pe-caixa--' + nivel;
    }

    function botaoDoGps(id, rotulo, aoClicar) {
        const botao = document.createElement('button');
        botao.type = 'button';
        botao.id = id;
        botao.className = 'pe-gps-btn';
        botao.textContent = rotulo;
        botao.addEventListener('click', aoClicar);

        return botao;
    }

    function tentarGpsDeNovo() {
        mostrarGps('info', 'bi-crosshair', 'Obtendo a sua localização...');
        // Mesma guarda da carga: a API pode lançar de forma síncrona.
        try {
            iniciarGps();
        } catch (erro) {
            mostrarGps('danger', 'bi-exclamation-triangle', TEXTO_GPS_API);
            console.log('API de geolocalização lançou de forma síncrona:', erro && erro.message);
        }
    }

    function mostrarErroDeBusca(texto) {
        mostrarGps('danger', 'bi-exclamation-triangle', texto, botaoDoGps('btn-gps-tentar', 'Tentar de novo', tentarGpsDeNovo));
    }

    // Estado "prompt": o navegador ainda pergunta. O botão chama `getCurrentPosition`, que é o que
    // abre a janela de permissão.
    function mostrarPedidoDePermissao() {
        mostrarGps('warning', 'bi-geo-alt', TEXTO_GPS_PEDIR, botaoDoGps('btn-gps-permitir', 'Permitir localização', () => {
            jaPediuPeloBotao = true;
            tentarGpsDeNovo();
        }));
    }

    // Estado "denied": o navegador NÃO abre a janela de novo; só a pessoa libera nas configurações.
    function mostrarPermissaoBloqueada() {
        const lista = document.createElement('ol');
        lista.id = 'gps-passos';
        lista.className = 'pe-gps-passos';
        for (const passo of (ehCelular ? PASSOS_GPS_CELULAR : PASSOS_GPS_COMPUTADOR)) {
            const item = document.createElement('li');
            item.textContent = passo;
            lista.appendChild(item);
        }
        const outroCaminho = document.createElement('div');
        outroCaminho.className = 'pe-gps-outro';
        outroCaminho.textContent = ehCelular ? OUTRO_CAMINHO_GPS_CELULAR : OUTRO_CAMINHO_GPS_COMPUTADOR;
        const bloco = document.createElement('div');
        bloco.append(lista, outroCaminho);
        mostrarGps('danger', 'bi-exclamation-triangle', TEXTO_GPS_BLOQUEADO, bloco);
    }

    // Lê o estado da permissão uma vez e passa a ouvir a troca: quando vira "granted" (a pessoa
    // liberou no cadeado com a página aberta), a busca recomeça sozinha. O Safari antigo não tem
    // `navigator.permissions`: aí o erro 1 cai no passo a passo, que serve para os dois casos.
    let permissaoDoGps = null;
    // O clique em "Permitir localização" já pediu e o erro 1 voltou com o estado ainda em "prompt"
    // (Firefox com "Bloquear" sem lembrar, por exemplo): desenhar o mesmo botão de novo seria um
    // laço sem saída, então vai o passo a passo.
    let jaPediuPeloBotao = false;

    // `vindoDoErro`: a leitura acabou de falhar com o erro 1. Com o site em "granted" isso é o
    // aparelho bloqueando (localização do sistema desligada): tentar de novo sozinho entraria em
    // laço, então explica e deixa o botão. Na troca (`onchange`) para "granted", busca sozinha.
    function reagirAPermissao(estado, vindoDoErro) {
        if (currentLocation) {
            redesenharUltimaPosicao();

            return;
        }
        if (estado === 'granted') {
            if (vindoDoErro) {
                mostrarErroDeBusca(TEXTO_GPS_SISTEMA);

                return;
            }
            tentarGpsDeNovo();

            return;
        }
        if (estado === 'prompt' && !(vindoDoErro && jaPediuPeloBotao)) {
            mostrarPedidoDePermissao();

            return;
        }
        mostrarPermissaoBloqueada();
    }

    function explicarPermissaoNegada() {
        if (permissaoDoGps) {
            reagirAPermissao(permissaoDoGps.state, true);

            return;
        }
        if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
            mostrarPermissaoBloqueada();

            return;
        }
        navigator.permissions.query({ name: 'geolocation' }).then((status) => {
            permissaoDoGps = status;
            status.onchange = () => reagirAPermissao(status.state, false);
            reagirAPermissao(status.state, true);
        }).catch(() => mostrarPermissaoBloqueada());
    }

    // O botão redondo de atualizar (desenho) fica sempre na caixa, então "Obtendo a sua localização..."
    // também aparece com uma posição já na mão. Se a nova leitura falhar, a caixa volta à última posição.
    function redesenharUltimaPosicao() {
        guardarPosicao({ coords: {
            latitude: currentLocation.latitude,
            longitude: currentLocation.longitude,
            accuracy: currentLocation.precisaoGps,
        } });
    }

    function erroGps(error) {
        const codigo = error && error.code;
        console.log('GPS não disponível:', error && error.message);
        // O botão NÃO é desabilitado aqui: ele precisa continuar respondendo ao toque. Quem
        // aperta sem posição recebe no handler a falha "sem localização" (`mostrarFalhaDoToque`: a
        // tela cheia vermelha ou, sem ela, o aviso flutuante). Desabilitar aqui devolvia o botão
        // morto por outra porta.
        if (codigo === GPS_PERMISSAO_NEGADA) {
            explicarPermissaoNegada();

            return;
        }
        // Uma posição boa já chegou (pela atualização contínua): a falha desta leitura não apaga o
        // que já está na mão, e a caixa volta a mostrá-la em vez de ficar em "Obtendo".
        if (currentLocation) {
            redesenharUltimaPosicao();

            return;
        }
        mostrarErroDeBusca(codigo === GPS_DEMOROU ? TEXTO_GPS_DEMOROU : TEXTO_GPS_INDISPONIVEL);
    }

    // Texto dos casos em que a resposta não voltou. Afirmar "não foi registrada" seria mentira: a
    // requisição pode ter chegado e gravado.
    //
    // 🔴 E mandar conferir o que está na tela também era mentira, de um jeito PIOR: os horários nos
    // botões dos tipos vêm do servidor e só mudam depois de uma batida CONFIRMADA, então ainda diriam
    // "--:--:--" e confirmariam a conclusão errada (falso com cara de verificado). Por isso o texto
    // manda ATUALIZAR primeiro, e o botão de atualizar aparece junto.
    const AVISO_SEM_CONFIRMACAO = 'Não recebemos a confirmação do servidor e a batida PODE ter sido registrada. Os horários nos botões acima são de antes da tentativa: atualize a página e confira ANTES de apertar de novo.';

    // 🪤 Sem internet, mandar atualizar é conselho que destrói prova: o recarregamento entrega a
    // página de erro do navegador e leva junto o aviso, os horários e o estado inteiro da tela. Por isso
    // este caso tem texto próprio e NÃO oferece o botão de atualizar enquanto a conexão não voltar.
    const AVISO_SEM_REDE = 'Você está sem internet e não dá para saber se a batida saiu. NÃO feche esta tela. Quando a conexão voltar, atualize a página e confira antes de apertar de novo.';

    // Falha em que dá para afirmar que nada entrou: o servidor recusou antes de gravar.
    const AVISO_NAO_ENTROU = 'A batida não foi registrada: o servidor recusou o pedido antes de gravar. Atualize a página, entre de novo se precisar, e repita.';
    // Virada do dia com a página aberta: os botões dos tipos já começam o dia novo, mas a folha e o banco são de ontem.
    const AVISO_VIRADA_DO_DIA = 'O dia virou com esta página aberta: os botões acima já são do dia novo, mas a folha e o banco de horas ainda são de ontem. Atualize a página antes de conferir.';
    // O módulo da batida (`ponto-batida.js`) é arquivo à parte: se ele não carregou (rede, cache, bloqueador), o toque
    // responde em vez de ficar mudo.
    const AVISO_PAGINA_INCOMPLETA = 'A página não carregou por inteiro e a batida não foi enviada. Atualize a página e tente de novo.';

    btnAtualizarPagina.addEventListener('click', () => window.location.reload());

    // P14: "Regularizar" da faixa da última pendência abre o mesmo pedido de esquecimento do "+" da folha. Com o mês
    // da pendência aberto, clica no "+" desta página; em outro mês, vai ao link que o abre na carga
    // (`?esquecimento=`, o mesmo da lista de pendências).
    const btnRegularizar = document.getElementById('btn-regularizar-pendencia');
    if (btnRegularizar) {
        btnRegularizar.addEventListener('click', function () {
            const alvo = document.querySelector('[data-esquecimento-dia="' + this.dataset.dia + '"][data-esquecimento-campo="' + this.dataset.tipo + '"]');
            if (alvo) {
                alvo.scrollIntoView({ block: 'center' });
                alvo.click();
                return;
            }
            window.location.href = this.dataset.url;
        });
    }

    // Conexão de volta depois de uma falha sem rede: aí sim atualizar resolve, então o botão
    // aparece. Sem isto a pessoa ficaria olhando um aviso que pede uma ação indisponível.
    window.addEventListener('online', function () {
        if (!avisoBatida.classList.contains('d-none') && avisoBatida.textContent === AVISO_SEM_REDE) {
            mostrarAvisoBatida('A internet voltou. Atualize a página e confira suas batidas antes de apertar de novo.', 'warning', true);
        }
    });

    // O `alert` do navegador era o único retorno de falha: some quando a pessoa toca em OK, não
    // deixa rastro na tela, e navegador nenhum o mostra em aba que não está visível. O aviso
    // agora FICA até a próxima tentativa.
    function mostrarAvisoBatida(texto, tom, oferecerAtualizar, origem) {
        avisoBatida.textContent = texto;
        // Caixa do desenho no tom do aviso (P11); os textos e o botão de conferir são os de hoje.
        avisoBatida.className = `pe-caixa pe-caixa--${tom} pe-aviso-batida`;
        // E14: de onde veio o aviso. `rodada` é o de uma rodada da fila (enviadas, recusa), o único que outra rodada pode
        // trocar; `guardada` é o do toque que foi para a fila. Os outros ficam, e as linhas da fila entram abaixo deles
        // (`escreverAvisoDaFila`).
        avisoBatida.dataset.origem = origem || '';
        btnAtualizarPagina.classList.toggle('d-none', !oferecerAtualizar);
    }

    // A batida entrou e o servidor mandou avisos (spec ponto-esquecimento-nao-trava R6): pendência em outro escritório
    // ou interjornada contada de uma saída vinda de esquecimento. Não é erro: a confirmação fica, os avisos vêm abaixo
    // com o link de cada um, e a página não recarrega sozinha (o botão de atualizar fica oferecido) para dar tempo de ler.
    function mostrarSucessoComAvisos(texto, avisos) {
        mostrarAvisoBatida(texto, 'warning', true);
        avisos.forEach((aviso) => {
            const linha = document.createElement('div');
            linha.className = 'pe-aviso-linha';
            const icone = document.createElement('i');
            icone.className = 'bi bi-exclamation-triangle';
            icone.setAttribute('aria-hidden', 'true');
            linha.append(icone, document.createTextNode(String(aviso.texto || '')));
            if (typeof aviso.link === 'string' && aviso.link.startsWith('/') && !aviso.link.startsWith('//') && aviso.rotulo) {
                const link = document.createElement('a');
                link.href = aviso.link;
                link.className = 'pe-aviso-link';
                link.textContent = String(aviso.rotulo);
                linha.appendChild(link);
            }
            avisoBatida.appendChild(linha);
        });
    }

    function limparAvisoBatida() {
        avisoBatida.textContent = '';
        avisoBatida.className = 'pe-caixa pe-aviso-batida d-none';
        avisoBatida.dataset.origem = '';
        btnAtualizarPagina.classList.add('d-none');
    }

    // E12 (P18; desenho L381, L382, L385 e L528): o bloco "fora do raio" (título, detalhe e, com `trabalhoExterno`
    // true, o botão "Registrar como trabalho externo"), escrito DENTRO de `alvo`. Hoje o alvo é `#batida-aviso`; a tela
    // vermelha da E8 reaproveita este bloco mudando só o alvo. `foraDoRaio` é `{ titulo, detalhe, trabalhoExterno }`, a
    // forma da resposta do servidor e a de `PontoBatida.textosDoForaDoRaio`. Todo texto entra por `textContent`: o
    // detalhe traz o nome da sede, que é digitado por alguém. `tipo` é o da batida que falhou (desenho L824, `ctx.t`):
    // é ele que vai como trabalho externo, e não o que estiver escolhido quando a pessoa tocar em "Registrar".
    function mostrarForaDoRaio(alvo, foraDoRaio, tipo) {
        const titulo = document.createElement('b');
        titulo.className = 'pe-fora-titulo';
        titulo.textContent = foraDoRaio.titulo;
        const detalhe = document.createElement('span');
        detalhe.className = 'pe-fora-detalhe';
        detalhe.textContent = foraDoRaio.detalhe;
        const partes = [titulo, detalhe];
        if (foraDoRaio.trabalhoExterno === true) {
            const botao = document.createElement('button');
            botao.type = 'button';
            botao.className = 'pe-fora-externo';
            botao.setAttribute('data-trabalho-externo', '');
            const icone = document.createElement('i');
            icone.className = 'bi bi-briefcase';
            icone.setAttribute('aria-hidden', 'true');
            botao.append(icone, 'Registrar como trabalho externo');
            botao.addEventListener('click', () => abrirJanelaDoTrabalhoExterno(botao, tipo));
            partes.push(botao);
        }
        alvo.replaceChildren(...partes);
    }

    // A avaliação local de `fora` nos textos do desenho, com a sede mais próxima da posição (como o servidor). As funções
    // vêm do módulo; sem elas (módulo antigo no cache do navegador), sai só o título, sem o botão, em vez de lançar no
    // meio do toque.
    function foraDoRaioDaTela(posicao) {
        if (typeof PontoBatida.textosDoForaDoRaio === 'function') {
            return PontoBatida.textosDoForaDoRaio(posicao, SEDES, TRABALHO_EXTERNO_PERMITIDO);
        }

        return { titulo: 'Você está fora do raio permitido', detalhe: '', trabalhoExterno: false };
    }

    function foraDoRaioDaResposta(data) {
        return typeof PontoBatida.foraDoRaioDaResposta === 'function' ? PontoBatida.foraDoRaioDaResposta(data) : null;
    }

    // Janela "Trabalho externo" (E12, desenho L766, L289 e L808) na moldura das janelas do Ponto (`PontoAbas`). Esc, o
    // "x" e "Cancelar" fecham pela moldura.
    const JANELA_DO_TRABALHO_EXTERNO = 'ponto-janela-externo';
    // O local e o motivo digitados ficam guardados NA PÁGINA até a batida externa entrar ou ir para a fila sem
    // internet: fechar a janela, uma resposta que não confirma ou a recusa do texto não apagam o que a pessoa escreveu.
    let textoDoTrabalhoExterno = '';
    // O tipo da batida que falhou (desenho L824, `ctx.t`), posto ao abrir a janela: é o que vai no envio.
    let tipoDoTrabalhoExterno = null;
    // E8: a janela aberta no lugar da tela cheia (a do trabalho externo, pela tela vermelha ou quando a batida externa
    // volta sozinha, e a "Antes de registrar" da E11) segura a espera dela; isto a solta (`soltarQuandoAJanelaFechar`).
    let soltarAEsperaDaJanela = function () {};
    // Os dois porquês de o envio não sair pelo caminho externo (o botão de bater ocupado ou o dia completo) e o da fila
    // antiga (ponto-fila.js de antes da E12 no cache do navegador), que guardaria a batida sem a marca e sem o texto.
    const AVISO_EXTERNO_EM_ANDAMENTO = 'Um registro ainda está em andamento. Espere a resposta e registre o trabalho externo de novo.';
    const AVISO_EXTERNO_DIA_COMPLETO = 'Não há registro livre hoje. O trabalho externo não foi enviado.';
    const AVISO_EXTERNO_SEM_FILA = 'Sem internet, o trabalho externo não pôde ser guardado. Tente de novo quando a conexão voltar.';
    // As recusas do servidor ao local e ao motivo (`TrabalhoExternoDaBatida`, 422): voltam para a linha de erro da janela.
    const RECUSAS_DO_TEXTO_EXTERNO = ['Informe o local e o motivo.', 'O local e o motivo podem ter até 500 caracteres.'];

    // Abre a janela da batida `tipo` com o texto guardado e o foco no campo; `erro`, quando há, vai na linha de erro.
    function abrirJanelaDoTrabalhoExterno(origem, tipo, erro) {
        if (!window.PontoAbas) {
            mostrarAvisoBatida(AVISO_PAGINA_INCOMPLETA, 'danger', true);
            return;
        }
        const fundo = window.PontoAbas.abrirJanela(JANELA_DO_TRABALHO_EXTERNO, origem);
        if (!fundo) {
            return;
        }
        tipoDoTrabalhoExterno = tipo || tipoRegistro.value;
        const campo = fundo.querySelector('[data-externo-motivo]');
        campo.value = textoDoTrabalhoExterno;
        if (erro) {
            window.PontoAbas.mostrarErro(fundo, erro);
        }
        campo.focus();
    }

    // E8: a janela "Trabalho externo" aberta no lugar da tela cheia (pelo botão da tela vermelha ou pela batida externa
    // que volta) e a "Antes de registrar" (E11) devolvem o foco ao título do cartão quando fecham: no "Bater Ponto", um
    // Enter bateria o tipo sugerido.
    function origemDaJanelaExterna() {
        return document.getElementById('ponto-registrar-titulo') || btnPonto;
    }

    // E8: o alerta de horário, o aviso flutuante, o som e o aviso do lembrete e a recarga de segurança, que esperavam a
    // tela cheia fechar, esperam também a janela do Ponto aberta no lugar dela (`id`: a do trabalho externo ou a "Antes
    // de registrar"), até ela fechar por qualquer caminho. `soltar` é a função do `segurar()` de js/ponto-tela-cheia.js
    // (null: nada a segurar). O "Registrar" e o "Registrar assim mesmo" soltam antes de refazer o toque (a validação nova
    // abre, e a espera segue até ela fechar); "Cancelar", "Aguardar", o "x" e Esc soltam pelo `hidden` da janela. Sem a
    // janela aberta ou sem o observador, solta já. Pelos dois caminhos, uma espera anterior ainda presa sai junto com
    // esta (nunca fica presa para sempre) e a guardada volta a vazia, se ainda for esta (a corrente não cresce no dia); a
    // soltura vale uma vez.
    function soltarQuandoAJanelaFechar(id, soltar) {
        if (typeof soltar !== 'function') {
            return;
        }
        const fundo = document.getElementById(id);
        if (!fundo || fundo.hidden || typeof MutationObserver !== 'function') {
            soltar();
            return;
        }
        const anterior = soltarAEsperaDaJanela;
        const soltarEsta = function () {
            vigia.disconnect();
            if (soltarAEsperaDaJanela === soltarEsta) {
                soltarAEsperaDaJanela = function () {};
            }
            anterior();
            soltar();
        };
        const vigia = new MutationObserver(function () {
            if (fundo.hidden) {
                soltarEsta();
            }
        });
        soltarAEsperaDaJanela = soltarEsta;
        vigia.observe(fundo, { attributes: true, attributeFilter: ['hidden'] });
    }

    // E8: a janela aberta pelo botão "Registrar como trabalho externo" da tela vermelha, segurando a espera (`segurar`).
    function abrirJanelaExternaDaTelaCheia(tipo, segurar) {
        abrirJanelaDoTrabalhoExterno(origemDaJanelaExterna(), tipo);
        if (typeof segurar === 'function') {
            soltarQuandoAJanelaFechar(JANELA_DO_TRABALHO_EXTERNO, segurar());
        }
    }

    // A batida externa com certeza não entrou (atrasada, que nem saiu; recusada antes de gravar; ou o servidor recusou o
    // texto): a janela volta com o texto guardado, o tipo da batida e o porquê. Sem confirmação e sem rede, não volta: a
    // batida pode ter entrado, e um "Registrar" novo, com outro `idEnvio`, a duplicaria. Também não volta por cima de
    // outra janela do Ponto aberta. Nos dois casos o texto fica guardado, e a janela aberta pelo botão vem com ele.
    function reabrirTrabalhoExterno(payload, porque) {
        if (payload.trabalhoExterno !== true || haJanelaDoPontoAberta()) {
            return;
        }
        abrirJanelaDoTrabalhoExterno(origemDaJanelaExterna(), payload.tipo, porque);
    }

    // E12 + E8: o fora do raio do toque (o local, pela avaliação da tela, ou a recusa do servidor com `foraDoRaio`,
    // inclusive o GPS impreciso). Com a tela cheia, a tela vermelha com o título e o detalhe e, com `trabalhoExterno`
    // true, o botão "Registrar como trabalho externo" do desenho (L385: maleta, borda branca, entre "Tentar novamente" e
    // "Fechar"); ele fecha a tela cheia e abre a janela para o tipo que falhou. Sem a tela cheia (função
    // `ponto-animacao` desligada), o bloco da E12 na caixa de hoje: o aviso flutuante não leva botão. `externo` é o do
    // toque (a batida externa recusada de novo fora do raio), para o "Tentar novamente".
    function mostrarForaDoRaioDoToque(foraDoRaio, tipo, externo) {
        if (!telaCheiaVale()) {
            tocarResultado('erro');
            mostrarAvisoBatida('', 'danger');
            mostrarForaDoRaio(avisoBatida, foraDoRaio, tipo);
            return;
        }
        const botoes = [];
        if (foraDoRaio.trabalhoExterno === true) {
            botoes.push({
                texto: 'Registrar como trabalho externo',
                icone: 'bi-briefcase',
                classe: 'pe-tc-btn--externo',
                // O foco volta ao título do cartão quando a janela fecha (não ao "Bater Ponto", revisão da E8), e o alerta
                // de horário que esperava a tela cheia espera também a janela.
                aoClicar: (evento, segurar) => abrirJanelaExternaDaTelaCheia(tipo, segurar),
            });
        }
        mostrarFalhaDoToque(tipo, foraDoRaio.titulo, foraDoRaio.detalhe, botoes, externo);
    }

    // E12 + E8: a batida externa que com certeza não entrou (atrasada, recusada antes de gravar ou com o texto recusado)
    // não vai para a tela vermelha: a validação fecha sem resultado, a caixa diz o porquê (com o "Atualizar" quando ele
    // ajuda) e a janela reabre com o texto guardado, como na E12. A ordem importa: a tela cheia fecha ANTES de a janela
    // abrir, senão o fechamento dela levaria o foco para fora da janela. Como no botão da tela vermelha, a espera é
    // segura ANTES de a validação fechar: o alerta de horário que esperava não abre no meio, e a janela que reabre o
    // segura até fechar (sem a janela, ele sai já).
    function devolverExternoParaAJanela(payload, porque, oferecerAtualizar) {
        const tela = window.PontoTelaCheia;
        const soltar = tela && typeof tela.segurar === 'function' ? tela.segurar() : null;
        try {
            if (tela) {
                tela.fecharSeValidando();
            }
            mostrarAvisoBatida(porque, 'danger', oferecerAtualizar);
            reabrirTrabalhoExterno(payload, porque);
        } finally {
            soltarQuandoAJanelaFechar(JANELA_DO_TRABALHO_EXTERNO, soltar);
        }
    }

    // A janela aberta pelo `PontoAbas` (o `janelaAberta` de js/ponto-abas.js, que o módulo não expõe) é a única
    // `.pe-janela-fundo` sem `hidden`: ele tira o `hidden` ao abrir e o põe ao fechar.
    function haJanelaDoPontoAberta() {
        return document.querySelector('.pe-janela-fundo:not([hidden])') !== null;
    }

    // E12: a fila antiga (ponto-fila.js de antes da E12, no cache do navegador) guardaria a batida externa sem a marca e
    // sem o texto, e ela sairia depois como batida comum.
    function filaAntigaParaOExterno(payload) {
        return payload.trabalhoExterno === true && filaDisponivel() && window.PontoFila.LEVA_TRABALHO_EXTERNO !== true;
    }

    const campoDoTrabalhoExterno = document.querySelector('#' + JANELA_DO_TRABALHO_EXTERNO + ' [data-externo-motivo]');
    if (campoDoTrabalhoExterno) {
        campoDoTrabalhoExterno.addEventListener('input', function () {
            textoDoTrabalhoExterno = campoDoTrabalhoExterno.value;
        });
    }

    // "Registrar": sem o local e o motivo, a frase do desenho fica na janela; com eles, a janela fecha e a batida que
    // falhou sai como trabalho externo (`registrarComoTrabalhoExterno`).
    const botaoRegistrarExterno = document.querySelector('#' + JANELA_DO_TRABALHO_EXTERNO + ' [data-externo-registrar]');
    if (botaoRegistrarExterno) {
        botaoRegistrarExterno.addEventListener('click', function () {
            const fundo = document.getElementById(JANELA_DO_TRABALHO_EXTERNO);
            const campo = fundo.querySelector('[data-externo-motivo]');
            textoDoTrabalhoExterno = campo.value;
            const motivo = campo.value.trim();
            if (motivo === '') {
                window.PontoAbas.mostrarErro(fundo, 'Informe o local e o motivo.');
                campo.focus();
                return;
            }
            window.PontoAbas.fecharJanela();
            soltarAEsperaDaJanela();
            registrarComoTrabalhoExterno(motivo, tipoDoTrabalhoExterno);
        });
    }

    // O envio do trabalho externo é o MESMO do botão de bater (fila sem internet, prazo, avisos, atualização da tela):
    // o tipo e o motivo ficam aqui só durante o clique no botão, que o handler lê antes do primeiro `await`, e saem logo
    // depois. É um toque novo: o handler faz outro `idEnvio`. Botão desabilitado (envio em andamento ou o dia completo)
    // não emite clique: o porquê vai na caixa do resultado, e o texto fica guardado.
    let trabalhoExternoDoToque = null;

    function registrarComoTrabalhoExterno(motivo, tipo) {
        if (btnPonto.disabled) {
            mostrarAvisoBatida(envioEmAndamento ? AVISO_EXTERNO_EM_ANDAMENTO : AVISO_EXTERNO_DIA_COMPLETO, 'warning');
            return;
        }
        trabalhoExternoDoToque = { tipo: tipo || tipoRegistro.value, motivo };
        try {
            btnPonto.focus();
            btnPonto.click();
        } finally {
            trabalhoExternoDoToque = null;
        }
    }

    // E8 (P79, P80): o resultado do toque. Com a função `ponto-animacao` valendo, a validação em tela cheia abre no toque
    // e o resultado sai nela, no tempo do desenho (js/ponto-tela-cheia.js); desligada, o resultado é o aviso flutuante,
    // com o som e a vibração. O que não tem resultado certo (sem rede, sem confirmação, batida guardada, servidor que
    // recusou antes de gravar) fecha a validação e fica na caixa de hoje, com o botão de conferir (P11 b). O gênero segue
    // o tipo (decisão do dono, corrige o desenho): "Entrada registrada", "Repouso registrado".
    const TIPO_MASCULINO = { repouso: true, retorno: true };
    const TITULO_SEM_LOCALIZACAO = 'Não foi possível obter a sua localização';
    const DETALHE_SEM_LOCALIZACAO = 'Ative o GPS do aparelho, permita a localização no navegador e tente de novo.';
    const AVISO_ATRASADO = 'Demorou demais para enviar e a hora da batida ficaria errada. Aperte de novo com a tela ligada.';
    // A batida que já tinha entrado com o mesmo envio (`data.jaRegistrada`): o texto do sistema (`EnvioDaBatida`).
    const AVISO_JA_REGISTRADA = '{{ constant('App\\Ponto\\Service\\EnvioDaBatida::MENSAGEM_JA_REGISTRADA')|e('js') }}';
    // E15 (desenho L533): o fim do aviso do sucesso sem a tela cheia, quando a batida tem comprovante.
    const AVISO_COMPROVANTE_NA_ABA = 'Comprovante na aba Comprovantes.';

    function rotuloDoTipo(tipo) {
        return Object.prototype.hasOwnProperty.call(ROTULOS_TIPO, tipo) ? ROTULOS_TIPO[tipo] : String(tipo);
    }

    function registradoDoTipo(tipo) {
        return TIPO_MASCULINO[tipo] === true ? 'registrado' : 'registrada';
    }

    function horaOficialAgora() {
        const agoraMs = agoraNoServidorMs();

        return FORMATO_HORA_OFICIAL.format(new Date(agoraMs === null ? Date.now() : agoraMs));
    }

    function dataExtensoAgora() {
        const agoraMs = agoraNoServidorMs();

        return FORMATO_DATA_OFICIAL.format(new Date(agoraMs === null ? Date.now() : agoraMs));
    }

    function telaCheiaVale() {
        return ANIMACAO_LIGADA && !!window.PontoTelaCheia && window.PontoTelaCheia.disponivel();
    }

    // Roda `fn` quando a tela cheia fechar; já, com ela fechada ou sem ela.
    function depoisDaTelaCheia(fn) {
        if (window.PontoTelaCheia && typeof window.PontoTelaCheia.quandoFechar === 'function') {
            window.PontoTelaCheia.quandoFechar(fn);
            return;
        }
        fn();
    }

    function tocarResultado(resultado) {
        if (window.PontoSons) {
            window.PontoSons.resultado(resultado);
        }
    }

    // "Validando {Tipo}", com a hora oficial e a data por extenso.
    function iniciarValidacaoDoToque(tipo) {
        if (telaCheiaVale()) {
            window.PontoTelaCheia.validar({ rotulo: rotuloDoTipo(tipo), hora: horaOficialAgora(), dataExt: dataExtensoAgora() });
        }
    }

    // A batida entrou. O texto sai do que o servidor gravou (`data.tipo` e `data.hora`); sem eles, o tipo do toque e a
    // hora oficial de agora. Os avisos do servidor que vêm com o sucesso (pendência em outro escritório, interjornada)
    // continuam na caixa de hoje, com o link de cada um (`mostrarSucessoComAvisos`, no toque). A que já tinha entrado com
    // o mesmo envio (`data.jaRegistrada`) traz o texto do sistema na linha de baixo da tela cheia, no lugar de
    // "Registrado no sistema" (sem a tela cheia, no aviso flutuante). E15: com o comprovante na resposta
    // (`data.comprovante`), a tela cheia mostra o código e "Baixar comprovante" (desenho L365 e L368); sem ela, o aviso
    // diz onde ele está, como o desenho (L533): "{Tipo} registrada às {hora}. Comprovante na aba Comprovantes.".
    function mostrarBatidaRegistrada(tipoDoToque, dados) {
        const gravada = dados || {};
        const tipo = typeof gravada.tipo === 'string' && Object.prototype.hasOwnProperty.call(ROTULOS_TIPO, gravada.tipo) ? gravada.tipo : tipoDoToque;
        const horaDaBatida = typeof gravada.hora === 'string' && gravada.hora ? gravada.hora : horaOficialAgora();
        const jaRegistrada = gravada.jaRegistrada === true;
        const comprovante = comprovanteDaBatida(gravada);
        if (telaCheiaVale()) {
            window.PontoTelaCheia.ok({ rotulo: rotuloDoTipo(tipo), hora: horaDaBatida, dataExt: dataExtensoAgora(), met: jaRegistrada ? AVISO_JA_REGISTRADA : '', comprovante: comprovante });
            return;
        }
        tocarResultado('ok');
        const texto = jaRegistrada ? AVISO_JA_REGISTRADA : rotuloDoTipo(tipo) + ' ' + registradoDoTipo(tipo) + ' às ' + horaDaBatida + (comprovante ? '. ' + AVISO_COMPROVANTE_NA_ABA : '.');
        if (!avisarFlutuante(texto, 'ok')) {
            mostrarAvisoBatida(texto, 'success');
        }
    }

    // E15: o comprovante da batida que entrou (`data.comprovante`, PontoController::dadosDaBatida), ou null. A tela cheia
    // confere de novo a url antes de pô-la no link.
    function comprovanteDaBatida(gravada) {
        const comprovante = gravada.comprovante;
        if (!comprovante || typeof comprovante !== 'object' || typeof comprovante.codigo !== 'string' || comprovante.codigo === '' || typeof comprovante.url !== 'string' || comprovante.url === '') {
            return null;
        }

        return { codigo: comprovante.codigo, url: comprovante.url };
    }

    // A batida NÃO entrou e dá para afirmar isso (recusa do servidor, envio atrasado, sem localização): a tela vermelha,
    // com "Tentar novamente" (refaz o toque do mesmo tipo) e "Fechar". `botoes` são os botões a mais da tela vermelha
    // (o "Registrar como trabalho externo" do fora do raio, `mostrarForaDoRaioDoToque`: `[{ texto, icone, classe,
    // aoClicar }]`, ver js/ponto-tela-cheia.js). `externo` é o `{ tipo, motivo }` do toque de trabalho externo (E12), ou
    // null: com ele, o "Tentar novamente" refaz a batida EXTERNA, nunca uma comum no lugar dela. Sem a tela cheia:
    // "{Tipo} não registrada: {título}." no aviso flutuante vermelho.
    function mostrarFalhaDoToque(tipo, titulo, detalhe, botoes, externo) {
        if (telaCheiaVale()) {
            if (window.PontoTelaCheia.fase() === '') {
                iniciarValidacaoDoToque(tipo);
            }
            window.PontoTelaCheia.erro({
                titulo: titulo,
                detalhe: detalhe || '',
                botoes: Array.isArray(botoes) ? botoes : [],
                aoTentar: () => tentarDeNovo(tipo, externo || null),
            });
            return;
        }
        tocarResultado('erro');
        const texto = rotuloDoTipo(tipo) + ' não ' + registradoDoTipo(tipo) + ': ' + String(titulo || '').replace(/[.\s]+$/, '') + '.';
        if (!avisarFlutuante(texto, 'erro')) {
            mostrarAvisoBatida(String(titulo || '') + (detalhe ? ' ' + detalhe : ''), 'danger');
        }
    }

    // "Tentar novamente": o mesmo tipo e o toque de novo (com todas as checagens do toque). O tipo que falhou e já não
    // está livre (entrou por outra via: outra aba, a fila, o atalho do cabeçalho) não é enviado: a tela cheia já fechou e
    // o aviso flutuante diz "{Tipo} já registrado(a).". Mandar o toque aqui bateria o PRÓXIMO tipo, sugerido no botão.
    // E12: a batida externa (`externo`) volta como externa, com o mesmo local e motivo, num toque novo (outro `idEnvio`:
    // ela certamente não entrou). Nunca vira uma batida comum.
    function tentarDeNovo(tipo, externo) {
        const botao = document.querySelector('#ponto-tipos > button[role="radio"][data-tipo="' + tipo + '"]');
        if (!botao || botao.disabled) {
            avisarFlutuante(rotuloDoTipo(tipo) + ' já ' + registradoDoTipo(tipo) + '.', 'ok');
            return;
        }
        if (externo) {
            registrarComoTrabalhoExterno(externo.motivo, tipo);
            return;
        }
        if (tipoRegistro.value !== tipo) {
            escolherTipo(botao);
        }
        btnPonto.click();
    }

    function liberarBotaoBatida() {
        envioEmAndamento = false;
        btnPonto.innerHTML = rotuloBotaoBatida();
        updateButtonState();
        // E14: o resultado da fila que chegou durante o envio do toque entra agora, abaixo do aviso dele.
        soltarResultadoDaFilaEmEspera();
    }

    // Página esquecida aberta da noite para o dia seguinte: os horários dos tipos são renderizados no
    // servidor e congelam. Às 08h eles mostrariam a entrada de ONTEM como se fosse de hoje, e a pessoa
    // concluiria que já bateu. O relógio e a folha congelam junto.
    //
    // 🔑 A virada é a do SERVIDOR (decisão de 09/11/2026, desenho 16): o instante dele na carga mais o
    // tempo que passou, contra a próxima meia-noite no fuso dele (`PROXIMA_VIRADA_MS`). A primeira versão
    // comparava o dia do aparelho com `dataHoje` e dava ao relógio do celular poder de veto; a segunda
    // comparava o aparelho com ele mesmo, e um aparelho em fuso errado cruzava a própria meia-noite na
    // hora errada (alarme falso às 21h BRT, silêncio na virada real). Agora a hora e o fuso do aparelho
    // não entram, só o tempo que passou. E continua sem veto: a virada avisa e libera, nunca trava.
    const INTERVALO_CHECAGEM_DIA_MS = 30000;

    function diaVirouNoServidor() {
        const agoraMs = agoraNoServidorMs();

        return agoraMs !== null && Number.isFinite(PROXIMA_VIRADA_MS) && agoraMs >= PROXIMA_VIRADA_MS;
    }

    // Na virada, o cartão começa o dia novo como no desenho: os quatro tipos livres, sem horário ("--:--:--") e
    // sem a duplicata de ontem. A trava do P7 sai junto, porque o tipo batido ontem está livre hoje. Só LIBERA,
    // nunca trava: o `updateButtonState` do fim tira o "dia completo" de ontem e o botão volta a responder.
    function zerarTiposNaVirada() {
        document.querySelectorAll('#ponto-tipos > button[role="radio"]').forEach((botao) => {
            botao.disabled = false;
            botao.classList.remove('pe-tipo-btn--feito');
            botao.dataset.registrada = '0';
            botao.dataset.quantas = '0';
            botao.querySelectorAll('.pe-tipo-dup').forEach((duplicata) => duplicata.remove());
            const hora = botao.querySelector('.pe-tipo-hora');
            if (hora) {
                hora.textContent = '--:--:--';
            }
        });
        updateButtonState();
        // E14: as batidas guardadas do dia novo (tocadas sem internet depois da meia-noite do servidor) não estão livres.
        // A remarcação mora aqui, na função que troca os tipos, e não em quem a chama (ver `aplicarGuardadasNaTela`).
        aplicarGuardadasNaTela();
    }

    function primeiroTipoLivre() {
        const livre = document.querySelector('#ponto-tipos > button[role="radio"]:not(:disabled)');

        return livre ? livre.dataset.tipo : '';
    }

    function conferirViradaDoDia() {
        if (diaVirou || !diaVirouNoServidor()) {
            return;
        }

        // ⚠️ AVISA, não bloqueia. Quem carimba a hora é o servidor, então bater com a página velha
        // grava certo; o risco desta tela é só a pessoa LER o dia errado e achar que já bateu.
        // Impedir a batida por causa disso seria trocar um engano por uma falta.
        diaVirou = true;
        zerarTiposNaVirada();
        aplicarPontoDoDia({});

        // A sugestão foi calculada no servidor, para ONTEM, e agora está velha. Quem esqueceu a saída
        // ontem encontraria "Bater Ponto: Saída" de manhã: um toque gravaria `saida` no dia novo e,
        // pior, a interjornada de 11 h do servidor (`PontoController::batida`) passaria a RECUSAR a
        // entrada dele pelo resto da manhã. O dia novo começa pelo primeiro tipo livre, como no
        // desenho: "Bater Ponto: Entrada".
        tipoRegistro.value = primeiroTipoLivre();
        atualizarRotuloBotao();
        marcarTipoEscolhido();

        // 🪤 Terceiro cliente do botão de atualizar, e o mais fácil de esquecer. Sem esta saída,
        // quem bateu sem rede e deixou a página aberta até a virada do dia tinha o
        // `AVISO_SEM_REDE` SUBSTITUÍDO por este texto, e o botão de atualizar reaparecia — ainda
        // sem rede. Recarregar ali apaga a única pista de que a batida pode ter entrado.
        if (avisoBatida.textContent === AVISO_SEM_REDE) {
            return;
        }

        mostrarAvisoBatida(AVISO_VIRADA_DO_DIA, 'warning', true);
    }

    setInterval(conferirViradaDoDia, INTERVALO_CHECAGEM_DIA_MS);

    // Pede a posição e liga a atualização contínua. Chamada na carga, no "Tentar de novo", no
    // "Permitir localização" e quando a permissão vira "granted" com a página aberta (o watch de
    // quem estava bloqueado já morreu, por isso é refeito).
    let idDoWatch = null;
    // Cada busca ganha um número; o erro de uma busca antiga (dois cliques seguidos em "Tentar de
    // novo", com o pedido anterior ainda correndo até 20 s) não troca o aviso da busca nova.
    let tentativaDoGps = 0;

    function iniciarGps() {
        const estaTentativa = ++tentativaDoGps;
        const erroDestaTentativa = (error) => {
            if (estaTentativa === tentativaDoGps) {
                erroGps(error);
            }
        };
        navigator.geolocation.getCurrentPosition(
            aplicarPosicao,
            (error) => {
                // Permissão negada não melhora sem alta precisão: explica na hora.
                if (error && error.code === GPS_PERMISSAO_NEGADA) {
                    erroDestaTentativa(error);

                    return;
                }
                // Fallback sem alta precisão caso o primeiro tente atingir timeout
                navigator.geolocation.getCurrentPosition(aplicarPosicao, erroDestaTentativa, { timeout: 10000 });
            },
            { enableHighAccuracy: true, timeout: 10000 }
        );

        // 🔴 A posição precisa CONTINUAR chegando, não só a da carga.
        //
        // Desde que o botão passou a bloquear por raio, decidir com a leitura da carga vira armadilha:
        // quem abre a tela no caminho, a 300 m do escritório, fica com o botão travado e continua
        // travado depois de chegar, porque nada busca posição nova. Não havia caminho de recuperação
        // na tela — nem botão, nem instrução para recarregar. Seria o defeito desta frente de volta
        // por outra porta: a pessoa sem conseguir registrar e sem saber por quê.
        //
        // `watchPosition` resolve na raiz: a posição se atualiza sozinha enquanto a pessoa se
        // desloca, e o botão destrava quando ela chega. De quebra, a batida deixa de depender da
        // leitura feita no clique, que é o que travava antes da Frente 1.
        if (idDoWatch !== null) {
            navigator.geolocation.clearWatch(idDoWatch);
        }
        idDoWatch = navigator.geolocation.watchPosition(
            aplicarPosicao,
            // Erro aqui só vai ao console: trocar o aviso por causa de uma leitura ruim no meio do
            // dia assustaria quem está no escritório com uma posição boa na mão.
            (error) => console.log('Atualização contínua de GPS falhou:', error && error.message),
            { enableHighAccuracy: true, maximumAge: 30000 }
        );
    }

    if (btnAtualizarGps) {
        btnAtualizarGps.addEventListener('click', tentarGpsDeNovo);
    }

    if (dispensaLocalizacao) {
        // P19 (fica): a caixa do home office já vem pronta do servidor, no tom informativo do desenho. Com a
        // geolocalização desligada (E7) não há caixa nem pedido de posição.
        updateButtonState();
    } else if ("geolocation" in navigator) {
        // A API pode lancar de forma SINCRONA (extensao de privacidade que a stuba, WebView de MDM).
        // Sem este try o script morre aqui, ANTES de registrar o handler do botao: a tela fica com
        // um botao que nao faz nada e sem erro nenhum na cara da pessoa.
        try {
            iniciarGps();
        } catch (erro) {
            // Diagnóstico PRÓPRIO: mandar "permita o acesso à localização" aqui é mentira, e a
            // pessoa vai procurar uma permissão que está concedida. A causa é a API ter lançado.
            mostrarGps('danger', 'bi-exclamation-triangle', TEXTO_GPS_API);
            // Idem `erroGps`: quem impede responde no clique, não apagando o botão.
            console.log('API de geolocalização lançou de forma síncrona:', erro && erro.message);
        }
    } else {
        mostrarGps('danger', 'bi-exclamation-triangle', 'Seu navegador não suporta geolocalização.');
    }

    // Botão de Bater Ponto
    // Depois da batida, a tela se atualiza SEM recarregar (spec ponto-atualiza-sem-recarregar): recarregar zerava a
    // liberação de áudio do navegador, e o toque seguinte do alerta (retorno, saída) ficava esperando um clique que
    // não vem com a pessoa longe do computador. A tela busca o próprio HTML e troca só o que a batida muda; os
    // números são os do servidor, os mesmos que a recarga mostraria. Tudo ou nada: falta uma região, o dia mudou ou
    // a resposta não é a tela, nada é trocado e quem chamou decide o plano B (recarregar, como antes).
    // `ponto-tipos` (P6 e P8, desenho de 09/11/2026) é a lista dos quatro tipos com a hora de cada um: substitui o
    // antigo quadro "Suas batidas de hoje". O `#tipo-registro` escondido fica fora dela e recebe o valor novo abaixo.
    // E3: o painel das pendências e a aba dele (o número) estão no cartão de abas; a aba aberta vai no endereço
    // (js/ponto-abas.js), então a tela buscada volta na mesma aba.
    // E17: o painel do Banco de Horas troca junto com o número do topo (`ponto-banco-horas`): os dois saem do mesmo
    // cálculo e nunca divergem depois da batida.
    const REGIOES_TROCADAS = ['ponto-tipos', 'ponto-banco-horas', 'ponto-aba-pendencias', 'ponto-regiao-pendencias', 'ponto-painel-banco'];

    // E14: cada busca da tela ganha um número no INÍCIO, e só a resposta da busca mais nova iniciada é trocada. Uma mais
    // velha que chega depois (a da fila e a do toque correndo juntas, ou depois de uma mais nova que falhou) é
    // descartada: trocar por ela voltaria a tela para trás e devolveria livre o tipo que acabou de ser batido.
    let ultimaBuscaDaTela = 0;

    async function atualizarTelaDoPonto() {
        const estaBusca = ++ultimaBuscaDaTela;
        // A busca mora no módulo, com prazo próprio: a tela não tem `fetch` sem prazo (BatidaNaoTravaNoGpsTest).
        const novo = await window.PontoBatida.buscarTelaDoPonto(window.location.href);
        if (estaBusca < ultimaBuscaDaTela) {
            // Descartada, a tela fica como está; a batida que o servidor confirmou nesta página continua marcada
            // (`confirmadasDaPagina`), mesmo que a busca mais nova falhe depois.
            aplicarGuardadasNaTela();
            return;
        }

        const relogioNovo = novo.getElementById('clock');
        const relogio = document.getElementById('clock');
        if (!relogioNovo || relogioNovo.dataset.dia !== relogio.dataset.dia) {
            throw new Error('O dia da tela mudou: recarregar.');
        }
        const trocas = REGIOES_TROCADAS.map((id) => [document.getElementById(id), novo.getElementById(id)]);
        // Da folha, só o cartão (E2: a `section.pe-folha`): o formulário do mês, o modal de pré-visualização e o script
        // dele ficam como estão, com os listeners.
        const folha = document.querySelector('#ponto-regiao-folha > section.pe-folha');
        const folhaNova = novo.querySelector('#ponto-regiao-folha > section.pe-folha');
        trocas.push([folha, folhaNova]);
        // E15: a contagem da aba Comprovantes e a lista dela, só quando a aba existe nas duas telas (comprovante ligado).
        ['ponto-aba-comprovantes', 'ponto-comprovantes-lista'].forEach((id) => { const par = [document.getElementById(id), novo.getElementById(id)]; if (par[0] && par[1]) { trocas.push(par); } });
        const tipoNovo = novo.getElementById('tipo-registro');
        if (!tipoNovo || trocas.some(([atual, nova]) => !atual || !nova)) {
            throw new Error('A tela do ponto veio sem uma das regiões: recarregar.');
        }

        // Lido antes da primeira troca: um JSON que não lê lança aqui, com a tela ainda intacta (tudo ou nada).
        const pontoDoDiaNovo = relogioNovo.dataset.pontoDoDia || '{}';
        const pontoDoDia = JSON.parse(pontoDoDiaNovo);

        trocas.forEach(([atual, nova]) => atual.replaceWith(document.importNode(nova, true)));
        // A tela do servidor volta a mandar: as batidas confirmadas antes desta busca começar já estão nela.
        confirmadasDaPagina = confirmadasDaPagina.filter((confirmada) => confirmada.depoisDaBusca >= estaBusca);
        relogio.dataset.pontoDoDia = pontoDoDiaNovo;
        aplicarPontoDoDia(pontoDoDia);
        tipoRegistro.value = tipoNovo.value;
        // E14: a tela do servidor não conhece a fila deste aparelho. Sem esta remarcação, o tipo guardado voltaria livre
        // e poderia virar a sugestão do botão (batida em dobro). Mora aqui, e não em cada chamador.
        aplicarGuardadasNaTela();
    }

    // A batida do toque que o servidor aceitou (o tipo e o corpo da resposta, com a hora gravada em `data.hora`), para a
    // tela marcá-la quando a atualização depois dela falha (ver `atualizarDepoisDaBatida`).
    let batidaAceita = null;

    function marcarBatidaAceitaNaTela() {
        const aceita = batidaAceita;
        batidaAceita = null;
        if (aceita) {
            const botao = Array.from(document.querySelectorAll('#ponto-tipos > button[role="radio"]')).find((b) => b.dataset.tipo === aceita.tipo);
            if (botao && !botao.disabled) {
                const gravada = aceita.resposta && aceita.resposta.data ? aceita.resposta.data.hora : null;
                const agoraMs = agoraNoServidorMs();
                const hora = typeof gravada === 'string' && gravada !== '' ? gravada : FORMATO_HORA_OFICIAL.format(new Date(agoraMs === null ? Date.now() : agoraMs));
                marcarTipoComoBatido(botao, hora);
            }
        }
        acertarSugestaoDoBotao();
    }

    // `recarregarSeFalhar`: o caminho sem avisos recarrega como antes. Com avisos, não (dá tempo de ler): o tipo aceito
    // fica marcado na tela como batido, a sugestão anda e o botão é solto, com o "Atualizar" oferecido. Antes o botão
    // ficava travado com a trava do envio presa para sempre, e o resultado da fila nunca entrava (revisão da E14).
    async function atualizarDepoisDaBatida(recarregarSeFalhar) {
        try {
            await atualizarTelaDoPonto();
        } catch (erro) {
            console.error('Falha ao atualizar a tela depois da batida:', erro);
            if (!recarregarSeFalhar) {
                marcarBatidaAceitaNaTela();
                liberarBotaoBatida();
            }
            if (recarregarSeFalhar) {
                // E8: a recarga espera a tela cheia fechar; não corta a confirmação do toque.
                setTimeout(() => depoisDaTelaCheia(() => window.location.reload()), 1500);
            }
            return;
        }
        liberarBotaoBatida();
    }

    // Fila sem internet (E14, P20; desenho L127, L438 e L546). A batida feita sem internet fica guardada, cifrada, neste
    // aparelho (`public/js/ponto-fila.js`, `window.PontoFila`) e é enviada quando a internet volta: ao abrir a tela, no
    // evento `online` e a cada minuto enquanto houver batida guardada. Vale a hora do aparelho no toque, e o mesmo
    // identificador do envio torna seguro mandar de novo. Sem a fila (página fora de contexto seguro, navegador sem
    // IndexedDB, módulo que não carregou), a tela faz o que fazia: o aviso de sem rede.
    const caixaDaFila = document.getElementById('ponto-fila');
    const FILA_USUARIO_ID = caixaDaFila ? Number(caixaDaFila.dataset.usuarioId) : 0;
    const FILA_ESCRITORIO_ID = caixaDaFila ? Number(caixaDaFila.dataset.escritorioId) : 0;
    const FILA_INTERVALO_MS = 60000;
    // Quanto um toque com internet espera a rodada da fila que vai antes dele (`rodarFilaAntesDoToque`). Somado ao prazo
    // do GPS (5 s), fica longe do limite de 60 s da guarda de atraso do envio.
    const FILA_PRAZO_ANTES_DO_TOQUE_MS = 10000;
    const URL_DA_BATIDA = '{{ path('ponto_batida') }}';
    const URL_DA_SINCRONIZACAO = '{{ path('ponto_fila_sincronizada') }}';
    // Dois textos para a batida guardada: o aparelho sabe que está sem internet (`navigator.onLine === false`), ou diz
    // que tem rede e o envio ficou sem resposta (prazo estourado, servidor fora). No segundo, "Sem internet" mandaria a
    // pessoa olhar um sinal que está bom.
    const AVISO_GUARDADA_SEM_INTERNET = 'Sem internet. A batida ficou guardada neste aparelho e será enviada quando a internet voltar.';
    const AVISO_GUARDADA_SEM_CONEXAO = 'Sem conexão com o servidor. A batida ficou guardada neste aparelho e será enviada sozinha quando a conexão voltar.';
    const AVISO_FILA_ENVIADA = 'Batidas sem internet enviadas.';
    // A hora e o dia da batida guardada são os do aparelho no toque, mostrados no fuso do servidor, como a hora oficial.
    const FORMATO_HORA_DA_FILA = formatoNoFusoDoServidor({ hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const FORMATO_DIA_E_MES_DA_FILA = formatoNoFusoDoServidor({ day: '2-digit', month: '2-digit' });
    const FORMATO_DIA_DA_FILA = formatoNoFusoDoServidor({ day: '2-digit', month: '2-digit', year: 'numeric' });
    const DIA_DA_TELA = String(diaHoje).padStart(2, '0') + '/' + String(mesHoje).padStart(2, '0') + '/' + anoHoje;
    let filaTemPendentes = false;
    // As guardadas desta pessoa neste escritório (pendentes e retidas por 409), da última leitura da fila. Só
    // `lerEstadoDaFila` troca a lista; é dela que a tela remarca os tipos depois de cada troca.
    let guardadasDaPagina = [];
    // E8: as batidas do toque que o servidor confirmou nesta página (o tipo e a hora de `data.tipo` e `data.hora`, o dia
    // da tela e o número da última busca da tela no aceite). A tela as remarca em todo desenho dos tipos, como as
    // guardadas (`aplicarGuardadasNaTela`): uma busca descartada (outra mais nova passou à frente) ou que falhou não
    // devolve livre o tipo recém-batido, e o próximo toque não vira batida em dobro. Cada uma sai quando uma busca
    // iniciada DEPOIS do aceite é aplicada: aí a tela do servidor já a tem e volta a mandar no estado.
    let confirmadasDaPagina = [];
    // As leituras do estado da fila andam uma depois da outra (ver `lerEstadoDaFila`).
    let leituraDaFila = Promise.resolve();
    // O que a fila tem a dizer e ainda não foi mostrado: as enviadas de uma rodada (`rodadaDaFila`) e as recusas de uma
    // leitura nova (`lerEstadoDaFila`). Sai por `entregarResultadoDaFila`; com uma batida do toque em andamento, espera
    // o toque terminar (`liberarBotaoBatida`) e entra abaixo do aviso dele. Nunca é reagendado.
    let resultadoDaFilaEmEspera = null;
    // As recusas já entregues à tela nesta página (mostradas ou esperando o toque): uma leitura nova não as entrega de
    // novo. Elas só saem da loja das recusas depois de mostradas (`avisarResultadoDaFila`).
    const recusasNaTela = new Set();
    // A rodada em curso nesta página: o minuto, o `online` e o toque dividem a mesma, em vez de cada um esperar à toa.
    let rodadaDaFilaEmCurso = null;

    function filaDisponivel() {
        return !!window.PontoFila && window.PontoFila.disponivel() && FILA_USUARIO_ID > 0 && FILA_ESCRITORIO_ID > 0;
    }

    // A caixa do desenho: "Sem internet: N batida(s) aguardando envio." e, quando há, a linha das guardadas em outro
    // escritório (inclusive as que voltaram 409 aqui). Some com as duas em zero. Texto só por `textContent`.
    function desenharCaixaDaFila(contagem) {
        if (!caixaDaFila || !contagem) {
            return;
        }
        const pendentesEl = document.getElementById('ponto-fila-pendentes');
        const outroEl = document.getElementById('ponto-fila-outro-escritorio');
        filaTemPendentes = contagem.pendentes > 0;
        pendentesEl.textContent = 'Sem internet: ' + contagem.pendentes + ' batida(s) aguardando envio.';
        pendentesEl.classList.toggle('d-none', contagem.pendentes === 0);
        outroEl.textContent = contagem.emOutroEscritorio + ' batida(s) guardada(s) sem internet em outro escritório. Entre nele para enviar.';
        outroEl.classList.toggle('d-none', contagem.emOutroEscritorio === 0);
        caixaDaFila.classList.toggle('d-none', contagem.pendentes === 0 && contagem.emOutroEscritorio === 0);
    }

    // 🔑 O ÚNICO lugar que monta o estado da página a partir da fila: a lista `guardadasDaPagina` (os tipos marcados),
    // a caixa e `filaTemPendentes` (que liga o envio de cada minuto). Sempre de uma leitura NOVA do IndexedDB, pedida
    // depois de cada gravação e de cada rodada; nunca do retrato que a rodada tirou no começo dela. Com o retrato, uma
    // batida guardada no meio da rodada ficava de fora: o tipo voltava livre, a caixa sumia e o envio de cada minuto
    // parava. As leituras andam uma depois da outra: a última pedida é a última aplicada e vê a última gravação.
    // As recusas também saem daqui: as novas (ainda não entregues nesta página) entram na espera do resultado, para
    // quem pediu a leitura entregar (`entregarResultadoDaFila`, ou o fim do toque). Nunca rejeita.
    //
    // `gravada`: a entrada que o toque acabou de guardar. Sem leitura logo depois de gravá-la (`estado` devolveu null),
    // o tipo dela é marcado direto e o envio de cada minuto fica ligado, até a próxima leitura boa, que troca a lista
    // inteira. Sem isto, o tipo ficava livre e o botão era solto com a batida na fila: batida em dobro.
    function lerEstadoDaFila(gravada) {
        const leitura = leituraDaFila.then(async () => {
            if (!filaDisponivel()) {
                return;
            }
            const estado = await window.PontoFila.estado(FILA_USUARIO_ID, FILA_ESCRITORIO_ID);
            if (!estado) {
                if (gravada && !guardadasDaPagina.some((entrada) => entrada.idEnvio === gravada.idEnvio)) {
                    guardadasDaPagina = guardadasDaPagina.concat([gravada]);
                    filaTemPendentes = true;
                    aplicarGuardadasNaTela();
                }
                return;
            }
            guardadasDaPagina = estado.entradas;
            desenharCaixaDaFila(estado);
            aplicarGuardadasNaTela();
            const novas = (Array.isArray(estado.recusas) ? estado.recusas : []).filter((recusa) => !recusasNaTela.has(recusa.idEnvio));
            if (novas.length > 0) {
                novas.forEach((recusa) => recusasNaTela.add(recusa.idEnvio));
                resultadoDaFilaEmEspera = juntarPartesDaFila(resultadoDaFilaEmEspera, { enviadas: 0, recusadas: novas });
            }
        }).catch((erro) => {
            console.error('Falha ao ler as batidas guardadas:', erro);
        });
        leituraDaFila = leitura;

        return leitura;
    }

    // O dia da tela: o da carga; depois da virada (página aberta de um dia para o outro), o de agora no servidor.
    function diaDaTelaAgora() {
        if (!diaVirou) {
            return DIA_DA_TELA;
        }
        const agoraMs = agoraNoServidorMs();

        return agoraMs === null ? null : FORMATO_DIA_DA_FILA.format(new Date(agoraMs));
    }

    // O P7 da E1 num tipo: verde, sem clique e com a hora.
    function marcarTipoComoBatido(botao, horaTexto) {
        botao.disabled = true;
        botao.classList.add('pe-tipo-btn--feito');
        botao.dataset.registrada = '1';
        const hora = botao.querySelector('.pe-tipo-hora');
        if (hora) {
            hora.textContent = horaTexto;
        }
    }

    // A sugestão do botão nunca fica num tipo sem clique (batido ou guardado): anda para o primeiro livre, como depois
    // de uma batida aceita; com os quatro feitos, o botão vira "Jornada de hoje concluída".
    function acertarSugestaoDoBotao() {
        const escolhido = Array.from(document.querySelectorAll('#ponto-tipos > button[role="radio"]')).find((b) => b.dataset.tipo === tipoRegistro.value);
        if (escolhido && escolhido.disabled) {
            tipoRegistro.value = primeiroTipoLivre();
        }
        marcarTipoEscolhido();
        atualizarRotuloBotao();
        updateButtonState();
    }

    // 🔑 O P7 da E1 para as batidas guardadas desta página (pendentes e retidas por 409): o tipo fica verde, sem clique e
    // com a hora do toque, para a pessoa não bater de novo o que já está na fila; depois, a sugestão do botão é acertada.
    // Chamada pelas próprias funções que trocam os tipos (`atualizarTelaDoPonto`, `zerarTiposNaVirada`) e pela fila:
    // a tela buscada no servidor não conhece a fila, e um chamador esquecido devolveria o tipo guardado livre (batida
    // em dobro). Só as do dia da tela, no fuso do servidor.
    function aplicarGuardadasNaTela() {
        const dia = diaDaTelaAgora();
        const botoes = Array.from(document.querySelectorAll('#ponto-tipos > button[role="radio"]'));
        guardadasDaPagina.forEach((entrada) => {
            try {
                const quando = new Date(entrada.horaAparelho);
                const botao = botoes.find((b) => b.dataset.tipo === entrada.tipo);
                if (!botao || botao.disabled || dia === null || FORMATO_DIA_DA_FILA.format(quando) !== dia) {
                    return;
                }
                marcarTipoComoBatido(botao, FORMATO_HORA_OFICIAL.format(quando));
                botao.dataset.guardada = '1';
            } catch (erro) {
                console.error('Falha ao marcar a batida guardada na tela:', erro);
            }
        });
        // E8: as confirmadas pelo servidor que a tela ainda não mostra (busca descartada ou que falhou). Só as do dia.
        confirmadasDaPagina.forEach((confirmada) => {
            const botao = botoes.find((b) => b.dataset.tipo === confirmada.tipo);
            if (botao && !botao.disabled && dia !== null && confirmada.dia === dia) {
                marcarTipoComoBatido(botao, confirmada.hora);
            }
        });
        acertarSugestaoDoBotao();
    }

    // E8: a saída do dia já está na página, antes de o relógio saber: marcada no botão do tipo (a da tela, a guardada na
    // fila) ou confirmada pelo servidor (`confirmadasDaPagina`). O relógio chama o lembrete já na carga, antes de
    // `confirmadasDaPagina` ser declarada: até `paginaMontada`, só o botão (a lista ainda está vazia de todo jeito).
    function saidaBatidaNaPagina() {
        const botao = document.querySelector('#ponto-tipos > button[role="radio"][data-tipo="saida"]');
        if (botao && botao.dataset.registrada === '1') {
            return true;
        }
        if (!paginaMontada) {
            return false;
        }
        const dia = diaDaTelaAgora();

        return confirmadasDaPagina.some((confirmada) => confirmada.tipo === 'saida' && confirmada.dia === dia);
    }

    // E8: registra a batida que o servidor confirmou (ver `confirmadasDaPagina`). Uma por tipo: a nova troca a velha.
    function registrarBatidaConfirmada(tipoDoToque, dados) {
        const gravada = dados || {};
        const tipo = typeof gravada.tipo === 'string' && Object.prototype.hasOwnProperty.call(ROTULOS_TIPO, gravada.tipo) ? gravada.tipo : tipoDoToque;
        const confirmada = {
            tipo: tipo,
            hora: typeof gravada.hora === 'string' && gravada.hora !== '' ? gravada.hora : horaOficialAgora(),
            dia: diaDaTelaAgora(),
            depoisDaBusca: ultimaBuscaDaTela,
        };
        confirmadasDaPagina = confirmadasDaPagina.filter((outra) => outra.tipo !== tipo).concat([confirmada]);
    }

    // Guarda a batida do toque na fila, com o MESMO identificador e a MESMA hora do toque. Devolve false quando não
    // deu (sem fila, sem identificador, erro do IndexedDB): quem chama segue o caminho de antes.
    //
    // E12: a batida externa só vai para a fila que leva a marca e o texto (`PontoFila.LEVA_TRABALHO_EXTERNO`). Com a fila
    // antiga, sem internet ANTES do envio: não guarda, avisa e devolve true (nada mais é tentado neste toque; o texto
    // fica na página). Depois de um envio sem resposta, o toque nem chega aqui (`filaAntigaParaOExterno` no handler).
    // Guardada, o texto guardado na página sai.
    async function guardarNaFila(payload) {
        if (!payload.idEnvio || !filaDisponivel()) {
            return false;
        }
        if (filaAntigaParaOExterno(payload)) {
            mostrarAvisoBatida(AVISO_EXTERNO_SEM_FILA, 'danger');
            return true;
        }
        const entrada = Object.assign({}, payload, { usuarioId: FILA_USUARIO_ID, escritorioId: FILA_ESCRITORIO_ID });
        if (!(await window.PontoFila.guardar(entrada))) {
            return false;
        }
        if (payload.trabalhoExterno === true) {
            textoDoTrabalhoExterno = '';
        }
        // Sem rede, o botão de atualizar NÃO aparece (como no `AVISO_SEM_REDE`): recarregar sem conexão leva a tela.
        // Origem própria (`guardada`): o resultado de uma rodada nunca troca este aviso, só acrescenta abaixo dele.
        const aviso = navigator.onLine === false ? AVISO_GUARDADA_SEM_INTERNET : AVISO_GUARDADA_SEM_CONEXAO;
        mostrarAvisoBatida(aviso, 'info', false, 'guardada');
        // Gravou: o estado sai de uma leitura nova (o tipo do toque fica marcado antes de o botão ser solto). Sem
        // leitura, o tipo do toque é marcado direto (`gravada`).
        await lerEstadoDaFila(entrada);

        return true;
    }

    // Depois da fila, a tela se atualiza pelo caminho de depois da batida (`atualizarTelaDoPonto`, que já remarca as
    // guardadas que sobraram). Falhou: fica como está, sem recarga sozinha.
    async function atualizarDepoisDaFila() {
        try {
            await atualizarTelaDoPonto();
        } catch (erro) {
            console.error('Falha ao atualizar a tela depois de enviar as batidas guardadas:', erro);
        }
        // Uma batida do toque começou no meio: o botão é dela, e é ela quem atualiza a tela e o libera.
        if (envioEmAndamento) {
            return;
        }
        liberarBotaoBatida();
    }

    // Excluir a justificativa (E3, js/ponto-abas.js) tira a linha na hora. A Folha (o selo do dia e o "+" do esquecimento)
    // e as pendências mudam junto e vêm pelo caminho de depois da batida, sem recarregar a página. O botão da batida não é
    // tocado. Com um toque enviando (GPS, fila, POST), o toque é dono da tela até terminar e a busca dele atualiza tudo:
    // - aqui não começa outra busca, que ficaria mais nova que a do toque e a faria ser descartada (se a do toque já tinha
    //   saído antes da exclusão, o selo do dia fica até a próxima busca; nada de batida em dobro);
    // - falhou: o mesmo plano B da batida (recarregar), porque esta busca pode ter passado à frente da de uma batida, e o
    //   tipo recém-batido ficaria livre na tela. Mas não com um toque enviando na hora: a recarga cortaria o envio, e a
    //   batida poderia sumir sem ir para a fila (o molde do `if (envioEmAndamento)` da fila).
    document.addEventListener('ponto:justificativa-excluida', () => {
        if (envioEmAndamento) {
            return;
        }
        atualizarTelaDoPonto().catch((erro) => {
            console.error('Falha ao atualizar a tela depois de excluir a justificativa:', erro);
            setTimeout(() => {
                if (envioEmAndamento) {
                    return;
                }
                window.location.reload();
            }, 1500);
        });
    });

    // Recusa definitiva, com o tipo e o dia, porque a batida pode ter sido guardada até 72 h antes.
    function linhaDaRecusaDaFila(recusa) {
        const quando = new Date(recusa.horaAparelho);
        const tipo = Object.prototype.hasOwnProperty.call(ROTULOS_TIPO, recusa.tipo) ? ROTULOS_TIPO[recusa.tipo] : String(recusa.tipo);

        return 'Batida de ' + tipo + ' de ' + FORMATO_DIA_E_MES_DA_FILA.format(quando) + ' às ' + FORMATO_HORA_DA_FILA.format(quando)
            + ' guardada sem internet não foi registrada: ' + recusa.mensagem;
    }

    function juntarPartesDaFila(antes, depois) {
        if (!antes) {
            return depois;
        }

        return { enviadas: antes.enviadas + depois.enviadas, recusadas: antes.recusadas.concat(depois.recusadas) };
    }

    // 🔑 Nunca apaga um aviso que já está na tela (sem confirmação, sucesso com avisos, recusa do toque, batida guardada
    // do toque) nem mexe no botão "Atualizar": as linhas da fila entram abaixo dele. Só o aviso de uma rodada anterior
    // (`data-origem="rodada"`) é trocado, porque ficou velho; mesmo aí o botão fica como estava.
    function escreverAvisoDaFila(linhas, tom) {
        if (linhas.length === 0) {
            return;
        }
        const avisoNaTela = !avisoBatida.classList.contains('d-none') && avisoBatida.textContent !== '';
        let resto = linhas;
        if (!avisoNaTela || avisoBatida.dataset.origem === 'rodada') {
            mostrarAvisoBatida(linhas[0], tom, !btnAtualizarPagina.classList.contains('d-none'), 'rodada');
            resto = linhas.slice(1);
        }
        resto.forEach((texto) => {
            const linha = document.createElement('div');
            linha.className = 'pe-aviso-linha';
            linha.textContent = texto;
            avisoBatida.appendChild(linha);
        });
    }

    // O que a rodada fez vira linhas no aviso. "Batidas sem internet enviadas." (desenho) só quando a fila esvaziou, e
    // isso vem do estado da página (a leitura nova de `lerEstadoDaFila`), não da rodada: o aviso e a caixa nunca se
    // contradizem. Recusa definitiva: uma linha por batida. Mostradas (e só depois), as recusas saem da loja delas: uma
    // recarga antes disto as mostra na carga seguinte, em vez de perdê-las.
    function avisarResultadoDaFila(parte) {
        const linhas = [];
        // E8: "Batidas sem internet enviadas." é o aviso flutuante do desenho (L438); sem o módulo, vai à caixa. Com a caixa
        // mostrando a batida guardada do toque, a linha entra também nela, abaixo do aviso (E14: nunca troca, só
        // acrescenta), para a caixa não seguir dizendo "guardada" de uma batida que já foi. As recusas ficam na caixa (P11 b).
        if (parte.enviadas > 0 && !filaTemPendentes) {
            const flutuou = avisarFlutuante(AVISO_FILA_ENVIADA, 'ok');
            if (!flutuou || avisoBatida.dataset.origem === 'guardada') {
                linhas.push(AVISO_FILA_ENVIADA);
            }
        }
        parte.recusadas.forEach((recusa) => linhas.push(linhaDaRecusaDaFila(recusa)));
        const tom = parte.recusadas.length === 0 ? 'success' : (parte.enviadas > 0 ? 'warning' : 'danger');
        escreverAvisoDaFila(linhas, tom);
        if (parte.recusadas.length > 0 && typeof window.PontoFila.apagarRecusas === 'function') {
            window.PontoFila.apagarRecusas(parte.recusadas.map((recusa) => recusa.idEnvio));
        }
    }

    function concluirResultadoDaFila(parte) {
        avisarResultadoDaFila(parte);
        if (parte.enviadas > 0 || parte.recusadas.length > 0) {
            atualizarDepoisDaFila();
        }
    }

    // Da rodada, só as enviadas (`null`: não rodou). As recusas e o estado da página já vieram da leitura nova, em
    // `rodadaDaFila`; tudo sai junto, num aviso só.
    function mostrarResultadoDaFila(resultado) {
        if (resultado && resultado.enviadas > 0) {
            resultadoDaFilaEmEspera = juntarPartesDaFila(resultadoDaFilaEmEspera, { enviadas: resultado.enviadas, recusadas: [] });
        }
        entregarResultadoDaFila();
    }

    // Entrega o que espera (enviadas e recusas). Uma batida do toque em andamento: o botão, o aviso e a atualização da
    // tela são dela, e o resultado espera ela terminar (`soltarResultadoDaFilaEmEspera`, no fim de `liberarBotaoBatida`),
    // sem reagendar nada.
    function entregarResultadoDaFila() {
        if (envioEmAndamento) {
            return;
        }
        soltarResultadoDaFilaEmEspera();
    }

    function soltarResultadoDaFilaEmEspera() {
        if (!resultadoDaFilaEmEspera) {
            return;
        }
        const parte = resultadoDaFilaEmEspera;
        resultadoDaFilaEmEspera = null;
        concluirResultadoDaFila(parte);
    }

    // A rodada que enviou batidas avisa o servidor, para o evento "Sincronização" da trilha (E14, dc L438). O servidor
    // confere cada envio contra as batidas da pessoa que vieram da fila e não conta duas vezes a mesma. Sem esperar e
    // sem aviso na tela: as batidas já entraram (cada uma com a marca " · sem internet" na trilha); uma falha aqui só
    // deixa o evento da rodada de fora, e vai para o console.
    function avisarSincronizacao(resultado) {
        if (!resultado || !Array.isArray(resultado.idsEnviados) || resultado.idsEnviados.length === 0
            || !window.PontoBatida || typeof window.PontoBatida.avisarSincronizacaoDaFila !== 'function') {
            return;
        }
        window.PontoBatida.avisarSincronizacaoDaFila(URL_DA_SINCRONIZACAO, resultado.idsEnviados);
    }

    // Uma rodada da fila. A trava de uma execução por vez é a do módulo (`PontoFila.enviarPendentes`); aqui a rodada em
    // curso é compartilhada, para o toque poder esperar a que já estava correndo. Nunca rejeita.
    function rodadaDaFila() {
        if (!rodadaDaFilaEmCurso) {
            rodadaDaFilaEmCurso = (async () => {
                try {
                    const resultado = await window.PontoFila.enviarPendentes(URL_DA_BATIDA, FILA_USUARIO_ID, FILA_ESCRITORIO_ID);
                    // O evento da auditoria sai primeiro: as batidas já foram enviadas, e uma falha na leitura ou no aviso
                    // da tela não pode perdê-lo. Ele não espera a resposta e nunca lança.
                    avisarSincronizacao(resultado);
                    // Rodou ou não (outra aba enviando), a fila pode ter mudado: o estado da página e as recusas vêm de
                    // uma leitura nova, feita agora. Da rodada, só as enviadas (para o aviso).
                    await lerEstadoDaFila();
                    mostrarResultadoDaFila(resultado);
                } catch (erro) {
                    console.error('Falha na rodada das batidas guardadas:', erro);
                } finally {
                    rodadaDaFilaEmCurso = null;
                }
            })();
        }

        return rodadaDaFilaEmCurso;
    }

    // Sem rede sabida ou com uma batida do toque em envio, nem tenta: o próximo disparo (o `online` ou o minuto
    // seguinte) tenta de novo. A rodada que vai antes de um toque é a de `rodarFilaAntesDoToque`.
    async function enviarFila() {
        if (!filaDisponivel() || navigator.onLine === false || envioEmAndamento) {
            return;
        }
        await rodadaDaFila();
    }

    // Antes de um toque com internet, as guardadas pendentes desta página vão primeiro: uma rodada, esperada até
    // `FILA_PRAZO_ANTES_DO_TOQUE_MS`. Passou do prazo, o toque segue e a rodada termina sozinha.
    async function rodarFilaAntesDoToque() {
        if (!filaTemPendentes || navigator.onLine === false || !filaDisponivel()) {
            return;
        }
        let prazo = null;
        try {
            await Promise.race([
                rodadaDaFila(),
                new Promise((resolve) => { prazo = setTimeout(resolve, FILA_PRAZO_ANTES_DO_TOQUE_MS); }),
            ]);
        } finally {
            clearTimeout(prazo);
        }
    }

    // Na carga: primeiro a limpeza (LGPD, aparelho compartilhado; ver `PontoFila.limpar`), com o agora do SERVIDOR: o
    // relógio do aparelho pulando para a frente apagaria batida de menos de 72 h. Sem ele (`null`), a limpeza só tira as
    // que não abrem. Depois o estado (as guardadas de hoje aparecem como batidas, a caixa conta), as recusas que ficaram
    // na loja sem ser mostradas (uma recarga no meio da rodada, por exemplo), e o envio.
    async function iniciarFila() {
        if (!filaDisponivel()) {
            return;
        }
        if (typeof window.PontoFila.limpar === 'function') {
            await window.PontoFila.limpar(agoraNoServidorMs());
        }
        await lerEstadoDaFila();
        entregarResultadoDaFila();
        enviarFila();
    }

    window.addEventListener('online', enviarFila);
    setInterval(() => { if (filaTemPendentes) { enviarFila(); } }, FILA_INTERVALO_MS);

    // O identificador do envio vem do módulo (`PontoBatida.novoIdDeEnvio`, E13). Sem a função (módulo antigo no cache
    // do navegador), a batida sai sem ele, como antes, em vez de lançar com o botão já travado no envio.
    function idDoEnvio() {
        return typeof PontoBatida.novoIdDeEnvio === 'function' ? PontoBatida.novoIdDeEnvio() : undefined;
    }

    // E11 (P21; desenho L288, L457 a L461 e L807): a janela "Antes de registrar". O servidor avalia o intervalo, a
    // interjornada e o descanso semanal com os mínimos da Jornada do escritório e, quando a batida sai da regra, devolve o
    // alerta SEM gravar. "Registrar assim mesmo" toca no botão de novo com a confirmação: a batida é a mesma do alerta
    // (o tipo e o `idEnvio`; nada foi gravado nele), a hora do aparelho e a posição são as da confirmação. "Aguardar", o
    // "x" e o Esc fecham sem registrar (a moldura é a das janelas da tela, `window.PontoAbas`). Texto por textContent.
    const janelaDoAlerta = document.getElementById('ponto-janela-alerta');
    let alertaEmEspera = null;
    let confirmacaoDoAlerta = null;

    function abrirAntesDeRegistrar(texto, payload) {
        const fundo = janelaDoAlerta && window.PontoAbas ? window.PontoAbas.abrirJanela('ponto-janela-alerta', origemDaJanelaExterna()) : null;
        if (!fundo) {
            mostrarAvisoBatida(texto, 'warning');   // sem a moldura (script fora), ao menos o alerta; nada foi gravado
            return;
        }
        alertaEmEspera = { tipo: payload.tipo, idEnvio: payload.idEnvio };
        // E12: a batida de trabalho externo volta externa, com o mesmo motivo. Sem isso, o "Registrar assim mesmo" iria
        // como batida comum, que a cerca recusa fora do raio.
        if (payload.trabalhoExterno === true) {
            alertaEmEspera.externo = { tipo: payload.tipo, motivo: payload.motivoTrabalhoExterno };
        }
        fundo.querySelector('[data-alerta-texto]').textContent = String(texto);
        fundo.querySelector('.pe-janela-cancelar').focus();   // o foco na saída segura: Enter não registra sem querer
    }

    // E8 + E11: a janela "Antes de registrar" abre no lugar da validação em tela cheia. A validação fecha ANTES (o foco vai
    // ao título do cartão e a janela o leva ao "Aguardar"), segurando a espera dela: o alerta de horário, o aviso
    // flutuante, o lembrete e a recarga só saem quando a janela fechar (`soltarQuandoAJanelaFechar`). Sem a moldura, o
    // alerta vai à caixa de hoje e a espera sai já.
    function mostrarAntesDeRegistrar(texto, payload) {
        const tela = window.PontoTelaCheia;
        const soltar = tela && typeof tela.segurar === 'function' ? tela.segurar() : null;
        try {
            if (tela) {
                tela.fecharSeValidando();
            }
            abrirAntesDeRegistrar(texto, payload);
        } finally {
            soltarQuandoAJanelaFechar('ponto-janela-alerta', soltar);
        }
    }

    // Lida pelo toque antes da primeira espera (o `click()` abaixo roda o handler até lá): a confirmação vale só para
    // este toque e não sobra para o próximo.
    function aplicarConfirmacaoDoAlerta(payload) {
        if (confirmacaoDoAlerta) {
            payload.tipo = confirmacaoDoAlerta.tipo;
            payload.idEnvio = confirmacaoDoAlerta.idEnvio;
            payload.confirmarAlerta = true;
        }
        confirmacaoDoAlerta = null;
    }

    // Botão cinza na hora do "Registrar assim mesmo" (outro envio no meio, ou o dia completou com a janela aberta): o
    // click() num botão desabilitado não dispara nada e a confirmação sumia calada. O aviso da batida diz que não saiu.
    const AVISO_ALERTA_DURANTE_ENVIO = 'A batida não foi registrada: outro registro estava sendo enviado. Espere terminar e toque no botão de novo.';
    const AVISO_ALERTA_DIA_CONCLUIDO = 'A batida não foi registrada: a jornada de hoje já está concluída.';

    if (janelaDoAlerta) {
        janelaDoAlerta.querySelector('[data-alerta-registrar]').addEventListener('click', function () {
            const batida = alertaEmEspera;
            alertaEmEspera = null;
            window.PontoAbas.fecharJanela();
            soltarAEsperaDaJanela();   // E8: antes do toque refeito, que abre a validação nova (e a espera segue nela)
            if (!batida) {
                return;
            }
            if (btnPonto.disabled) {
                mostrarAvisoBatida(envioEmAndamento ? AVISO_ALERTA_DURANTE_ENVIO : AVISO_ALERTA_DIA_CONCLUIDO, 'warning');
                return;
            }
            confirmacaoDoAlerta = batida;
            trabalhoExternoDoToque = batida.externo || null;   // E12: lido pelo toque como o da janela do trabalho externo
            btnPonto.click();
            confirmacaoDoAlerta = null;
            trabalhoExternoDoToque = null;
        });
    }

    btnPonto.addEventListener('click', async function() {
        if (!window.PontoBatida) {
            mostrarAvisoBatida(AVISO_PAGINA_INCOMPLETA, 'danger', true);
            return;
        }
        // E12: o tipo e o motivo do trabalho externo, quando o toque veio da janela (`registrarComoTrabalhoExterno`).
        // Lidos aqui, antes de qualquer `await`, porque a janela os apaga assim que o clique volta. Null no toque comum.
        const externo = trabalhoExternoDoToque;
        // Ainda no gesto, antes de qualquer `await`: a janelinha do alerta do ponto (navegador minimizado) precisa da
        // permissão, e o Chrome esconde o pedido feito sem clique.
        window.PontoBatida.pedirPermissaoDeNotificacao();
        // E8: o som do resultado também precisa do gesto (o `AudioContext` nasce ou volta aqui). O do alerta de horário
        // (js/ponto-alerta-som.js) é outro e continua liberado pela primeira interação com a página.
        if (window.PontoSons) {
            window.PontoSons.liberar();
        }
        if (!tipoRegistro.value) {
            mostrarAvisoBatida('Selecione o tipo de registro (Entrada, Repouso, Retorno ou Saída).', 'warning');
            return;
        }

        // P10 (b): sem a posição, a tela vermelha do desenho; a caixa da localização, acima, continua com o passo a passo.
        // E12: no toque do trabalho externo, o tipo é o da batida que falhou, e o "Tentar novamente" a refaz externa.
        if (!dispensaLocalizacao && !currentLocation) {
            mostrarFalhaDoToque(externo !== null ? externo.tipo : tipoRegistro.value, TITULO_SEM_LOCALIZACAO, DETALHE_SEM_LOCALIZACAO, [], externo);
            return;
        }

        // A cerca impede o ENVIO, e agora diz isso onde a pessoa lê o resultado da batida. Antes
        // ela só deixava o botão cinza e escrevia em `#gps-status`, no topo do card: quem tocava no
        // botão não recebia resposta nenhuma. O texto de `#gps-status` continua, para informar
        // ANTES do toque; este responde AO toque.
        if (!dispensaLocalizacao) {
            const onde = PontoBatida.avaliarPosicao(currentLocation, SEDES);
            // E12 (P18): o toque de trabalho externo não para aqui; o servidor decide.
            if (externo === null && onde.situacao === 'fora') {
                // E12 (P18, desenho L528): o título, o detalhe (a sede mais próxima) e, com a opção do escritório, o botão
                // do trabalho externo para o tipo deste toque, na tela vermelha da E8 (sem ela, na caixa). Nada é enviado.
                mostrarForaDoRaioDoToque(foraDoRaioDaTela(currentLocation), tipoRegistro.value, null);
                return;
            }
        }

        limparAvisoBatida();
        envioEmAndamento = true;
        btnPonto.disabled = true;
        btnPonto.innerHTML = '<i class="bi bi-hourglass-split"></i> Registrando...';

        // `performance.now()` e nao `Date.now()`: e relogio monotonico de tempo decorrido.
        // Acerto de relogio do aparelho para tras mascararia o congelamento que esta guarda
        // existe para pegar; para a frente descartaria batida legitima.
        const momentoDoToque = performance.now();
        // E13: a hora do aparelho no TOQUE (epoch em ms), que o servidor guarda só como informação (a batida normal
        // vale pela hora de chegada), e o identificador único do envio, feito aqui uma vez só: é o mesmo em toda nova
        // tentativa desta batida, e o servidor não grava duas vezes o mesmo.
        const horaAparelho = Date.now();
        const payload = { tipo: tipoRegistro.value, idEnvio: idDoEnvio(), horaAparelho };
        // E12: o corpo de sempre com o tipo da batida que falhou, a marca e o motivo. Sem internet, vai para a fila com eles.
        if (externo !== null) {
            payload.tipo = externo.tipo;
            payload.trabalhoExterno = true;
            payload.motivoTrabalhoExterno = externo.motivo;
        }
        aplicarConfirmacaoDoAlerta(payload);   // E11: "Registrar assim mesmo" refaz a batida do alerta
        // E8 (P79): a validação em tela cheia abre já no toque, antes da posição e do envio, com o tipo que vale (o do
        // alerta confirmado, quando é o "Registrar assim mesmo").
        iniciarValidacaoDoToque(payload.tipo);

        if (!dispensaLocalizacao) {
            let latitude = currentLocation.latitude;
            let longitude = currentLocation.longitude;
            let precisaoGps = currentLocation.precisaoGps;

            // Atualizar a posição é uma MELHORIA, nunca uma condição para enviar: sem o prazo
            // próprio de `PontoBatida.lerPosicaoComPrazo`, esta espera trava o envio inteiro (ver o
            // comentário dela no módulo). Não atualizou, segue com a posição que ligou o botão.
            // Posição que chega, dentro ou fora do prazo, também vai para `guardarPosicao`.
            const position = await PontoBatida.lerPosicaoComPrazo(PontoBatida.GPS_PRAZO_ATUALIZACAO_MS, guardarPosicao);
            if (position) {
                latitude = position.coords.latitude;
                longitude = position.coords.longitude;
                precisaoGps = position.coords.accuracy;
                currentLocation = { latitude, longitude, precisaoGps };
            } else {
                console.log('Não foi possível atualizar o GPS a tempo; usando a última posição conhecida.');
            }

            payload.latitude = latitude;
            payload.longitude = longitude;
            payload.precisaoGps = precisaoGps;
        }

        // `sucesso` existe por causa do `finally`: no caminho bom o botão fica desabilitado de
        // propósito até a tela se atualizar (`atualizarDepoisDaBatida`), senão ele volta a clicável
        // antes da sugestão nova e aceita uma segunda batida do mesmo tipo.
        let sucesso = false;

        try {
            // E14: com batida guardada nesta página, a fila vai antes, para as batidas chegarem ao servidor na ordem em que
            // aconteceram. Uma rodada só, com prazo; se a fila continuar pendente (sem rede, "tentar depois"), este toque
            // segue o caminho dele: sem internet vai para a fila, com internet é enviado.
            await rodarFilaAntesDoToque();

            // E14: o aparelho sabe que está sem internet, então nem tenta o envio. A batida vai para a fila com a
            // posição lida acima (o GPS funciona sem internet). Sem fila, segue o envio de sempre e o aviso de sem rede.
            if (navigator.onLine === false && await guardarNaFila(payload)) {
                return;
            }

            // O envio, o prazo dele, a guarda de atraso (`LIMITE_ATRASO_ENVIO_MS`: envio que sairia
            // com a hora errada NÃO sai) e a leitura da resposta moram no módulo. Aqui a
            // classificação vira o aviso desta tela; o porquê de cada caso está em `enviarBatida`.
            const resultado = await PontoBatida.enviarBatida('{{ path('ponto_batida') }}', payload, momentoDoToque);

            // E12: a batida externa saiu e ficou sem resposta, e a fila antiga não a guardaria inteira. Ela pode ter
            // entrado: nada de convite a repetir. Sem internet, o aviso de sem rede, sem o botão de atualizar (ver
            // `AVISO_SEM_REDE`); com internet, o de sem confirmação, com o "Conferir" (P11 b).
            if (resultado.falhaDeRede && filaAntigaParaOExterno(payload)) {
                const semRede = resultado.tipo === 'sem_rede';
                mostrarAvisoBatida(semRede ? AVISO_SEM_REDE : AVISO_SEM_CONFIRMACAO, 'danger', !semRede);
                return;
            }

            // E14: o envio falhou sem resposta (a rede caiu no meio, o prazo estourou). A batida vai para a fila com o
            // MESMO identificador e a MESMA hora do toque: se ela tiver entrado, o servidor responde que já estava.
            if (resultado.falhaDeRede && await guardarNaFila(payload)) {
                return;
            }

            // E11: a batida saiu da regra de intervalo e o servidor não gravou; a janela pergunta (P21).
            if (resultado.tipo === 'recusa' && resultado.data && typeof resultado.data.alerta === 'string') {
                mostrarAntesDeRegistrar(resultado.data.alerta, payload);
                return;
            }

            if (resultado.tipo === 'atrasado') {
                // Nada foi enviado: dá para afirmar que não entrou. E12 + E8: a batida externa volta para a janela, com o
                // texto guardado e o porquê, sem a tela vermelha; a comum vai para a tela vermelha.
                if (payload.trabalhoExterno === true) {
                    devolverExternoParaAJanela(payload, AVISO_ATRASADO, false);
                } else {
                    mostrarFalhaDoToque(payload.tipo, AVISO_ATRASADO, '');
                }
            } else if (resultado.tipo === 'sucesso') {
                sucesso = true;
                batidaAceita = { tipo: payload.tipo, resposta: resultado.data };
                registrarBatidaConfirmada(payload.tipo, resultado.data && resultado.data.data);
                const avisos = Array.isArray(resultado.data && resultado.data.avisos) ? resultado.data.avisos : [];
                const dadosDaBatida = (resultado.data && resultado.data.data) || {};
                mostrarBatidaRegistrada(payload.tipo, dadosDaBatida);
                if (avisos.length > 0) {
                    mostrarSucessoComAvisos(resultado.mensagem, avisos);
                }
                // Sem `await`: um erro da atualização não pode cair no `catch` abaixo, que diria "sem confirmação"
                // de uma batida que o servidor confirmou.
                atualizarDepoisDaBatida(avisos.length === 0);
                // E12: a batida externa entrou; o texto guardado na página sai.
                if (payload.trabalhoExterno === true) {
                    textoDoTrabalhoExterno = '';
                }
            } else if (resultado.tipo === 'recusa') {
                // E12 + E8: fora do raio (403) ou GPS impreciso (422) trazem `foraDoRaio`: a tela vermelha com o título, o
                // detalhe e, com `trabalhoExterno` true, o botão do trabalho externo para o tipo deste envio (sem a tela
                // cheia, o bloco da E12 na caixa). A recusa do local e do motivo devolve a batida externa à janela, com a
                // frase do servidor. As outras recusas: a mensagem do servidor é o título da tela vermelha, sem detalhe.
                const foraDoRaio = foraDoRaioDaResposta(resultado.data);
                if (foraDoRaio) {
                    mostrarForaDoRaioDoToque(foraDoRaio, payload.tipo, externo);
                } else if (payload.trabalhoExterno === true && resultado.status === 422 && RECUSAS_DO_TEXTO_EXTERNO.includes(resultado.mensagem)) {
                    devolverExternoParaAJanela(payload, resultado.mensagem, false);
                } else {
                    mostrarFalhaDoToque(payload.tipo, resultado.mensagem, '', [], externo);
                }
            } else if (resultado.tipo === 'nao_entrou') {
                // E8: fica na caixa, com o "Atualizar" (a sessão pode ter vencido). E12: a externa volta também para a janela.
                if (payload.trabalhoExterno === true) {
                    devolverExternoParaAJanela(payload, AVISO_NAO_ENTROU, true);
                } else {
                    mostrarAvisoBatida(AVISO_NAO_ENTROU, 'danger', true);
                }
            } else if (resultado.tipo === 'sem_rede') {
                // Sem rede, o botão de atualizar NÃO aparece (ver `AVISO_SEM_REDE`). Chega aqui só sem fila: com ela, a
                // batida já teria sido guardada acima. E12: a janela do trabalho externo NÃO volta sozinha (a batida pode
                // ter entrado); o texto fica guardado na página.
                mostrarAvisoBatida(AVISO_SEM_REDE, 'danger', false);
            } else {
                // `sem_confirmacao`: a batida PODE ter entrado, então nunca se afirma que não entrou.
                // E12: a janela do trabalho externo NÃO volta sozinha: um "Registrar" novo sairia com outro `idEnvio` e
                // poderia duplicar a batida. Fica o "Conferir" desta caixa (P11 b); o texto continua guardado na página,
                // e a janela aberta pelo botão vem com ele.
                mostrarAvisoBatida(AVISO_SEM_CONFIRMACAO, 'danger', true);
            }
        } catch (erro) {
            // O `catch` que o envio tinha antes da extração: erro da própria tela nunca vira silêncio, e o aviso
            // nunca afirma que a batida não entrou.
            console.error('Falha ao tratar a resposta da batida:', erro);
            mostrarAvisoBatida(AVISO_SEM_CONFIRMACAO, 'danger', true);
        } finally {
            // E8: sem resultado para a tela cheia (sem rede, sem confirmação, guardada, recusa antes de gravar), a
            // validação fecha e a resposta fica na caixa de hoje.
            if (window.PontoTelaCheia) {
                window.PontoTelaCheia.fecharSeValidando();
            }
            if (!sucesso) {
                liberarBotaoBatida();
            }
        }
    });

    // E8: daqui em diante, tudo do script já foi declarado (`saidaBatidaNaPagina` lê `confirmadasDaPagina`).
    paginaMontada = true;
    // E14: por último, com a tela inteira já montada (a atualização depois do envio usa as regiões declaradas acima).
    iniciarFila();
</script>
{% endblock %}
