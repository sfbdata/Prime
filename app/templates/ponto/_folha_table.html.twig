{#
    Folha de Ponto no molde do desenho 16 (etapa E2, spec docs/specs/ponto-desenho-0811.md; decisões de 09/11/2026).
    Dois lugares a usam: a /ponto do colaborador (com o filtro do P25, `somenteDiasComBatida`) e a ficha do colaborador
    (P60, fica: o mesmo molde com TODOS os dias do mês). Valores em public/css/ponto-eletronico.css; as classes do
    desenho ganham o prefixo da tela: bjpT = pe-tab, resp = pe-resp, bjpLin = pe-lin, bjpMais = pe-mais, bjpSm = pe-sm,
    bjpPl = pe-pl, bjpVazia = pe-vazia, larga = pe-larga, toda = pe-toda.

    O que o sistema tem e o desenho não mostra fica, no estilo do desenho: o selo da jornada na barra (ficha), "Ver PDF"
    e "Baixar XLSX" (P89 e P88), "A conferir" e "Home Office" (P28), "Não abonada" e o horário do abono parcial (P31),
    o feriado trabalhado, a dica do "Registro incompleto", o sinal de registro em outro escritório, as batidas fora da
    conta do gestor e os totais do mês (P32). Nada aqui calcula saldo: os números são os do FolhaPontoBuilder.
#}
{% import 'ponto/_folha_macros.html.twig' as folha %}
{% set competenciaParts = competenciaSelecionada|default('') ? competenciaSelecionada|split('-') : [] %}
{% set exportarAnoResolved = exportarAno is defined ? exportarAno : (competenciaParts|length == 2 ? competenciaParts[0] : null) %}
{% set exportarMesResolved = exportarMes is defined ? exportarMes : (competenciaParts|length == 2 ? competenciaParts[1] : null) %}
{% set exportarFolhaHabilitado = exportarFolhaHabilitado|default(false) %}
{% set exportarFolhaParametros = exportarFolhaParametros|default({}) %}
{% set mostrarBancoHoras = mostrarBancoHoras|default(false) %}
{% set mostrarJustificativas = mostrarJustificativas|default(false) %}
{% set editarBatidasHabilitado = editarBatidasHabilitado|default(false) %}
{# P43 (E10): na própria ficha de quem não é primário nem Master os botões somem; esta linha diz por quê. #}
{% set avisoSemCorrecao = avisoSemCorrecao|default(null) %}
{% set editarBatidasRotaAdd = editarBatidasRotaAdd|default('') %}
{# E10 (plano-e10-ponto §4): na ficha, a hora leva à página "Ajustar batida", o "x" abre a janela "Desconsiderar batida"
   (#modalDesconsiderarBatida, da ficha) e a linha "Desconsideradas:" traz o "Restaurar" (#modalRestaurarBatida). #}
{% set editarBatidasRotaAjustar = editarBatidasRotaAjustar|default('') %}
{% set editarBatidasRotaDesconsiderar = editarBatidasRotaDesconsiderar|default('') %}
{% set editarBatidasRotaRestaurar = editarBatidasRotaRestaurar|default('') %}
{# As batidas que o gestor tirou da conta, por dia ('Y-m-d'): só a ficha passa. #}
{% set desconsideradasPorDia = desconsideradasPorDia|default({}) %}
{% set editarBatidasParametros = editarBatidasParametros|default({}) %}
{% set jornadaInfo = jornadaInfo|default(null) %}
{# Ficha do admin: dias em que a pessoa bateu em OUTRO escritório com o ponto daqui aberto (spec
   ponto-esquecimento-nao-trava R8). Só o sinal, sem dizer qual escritório; só na tela, como o "Registro incompleto". #}
{% set diasComRegistroEmOutroEscritorio = diasComRegistroEmOutroEscritorio|default({}) %}
{# Atalho do colaborador: "+" na batida faltante abre o modal de Esquecimento de Registro.
   Inerte por padrão: quem não passa os parâmetros não ganha o atalho. #}
{% set justificarFaltanteHabilitado = justificarFaltanteHabilitado|default(false) %}
{% set esquecimentosRegistrados = esquecimentosRegistrados|default({}) %}
{# Dias com esquecimento pendente: o "Em análise" da coluna Justificativa, mesmo quando outra justificativa vence o dia. #}
{% set esquecimentosEmAnalise = esquecimentosEmAnalise|default({}) %}
{# Sem dataHoje o atalho não aparece: o default é fail-closed de propósito, para que esquecer de
   passá-lo não faça a regra de "nada de hoje nem de dia futuro" sumir em silêncio. #}
{% set dataHoje = dataHoje|default(null) %}
{# "Em andamento" é só de leitura: na ficha (que não passa dataHoje) vale o dia do servidor. #}
{% set hojeDaFolha = dataHoje ?? 'now'|date('Y-m-d') %}
{# P25 (decisão de 09/11/2026): a /ponto mostra só os dias com batida (e o feriado com horas), como o desenho. O dia
   que some continua no saldo: o "Saldo mês" de cada linha e os totais vêm do motor, que conta todos os dias. #}
{% set somenteDiasComBatida = somenteDiasComBatida|default(false) %}
{# A /ponto já carrega o CSS no <head>; a ficha do colaborador não, e o recebe aqui. Sem `|default(true)`: o filtro
   trocaria o `false` explícito da /ponto pelo padrão. #}
{% set carregarCssDaFolha = carregarCssDaFolha is defined ? carregarCssDaFolha : true %}
{% set campoCompetenciaId = competenciaFieldId|default('competencia') %}
{% set totalDeColunas = 6 + (mostrarBancoHoras ? 3 : 0) + (mostrarJustificativas ? 1 : 0) %}
{% set rotulosBatida = {entrada: 'Entrada', repouso: 'Repouso', retorno: 'Retorno', saida: 'Saída'} %}
{% set nomesDaSemana = {1: 'Segunda', 2: 'Terça', 3: 'Quarta', 4: 'Quinta', 5: 'Sexta', 6: 'Sábado', 7: 'Domingo'} %}
{# Motivos de um dia ambíguo (`BatidasEscolhidas::MARCA_*`). A marca não muda número: avisa que há
   batida a corrigir. Ver docs/specs/ponto-folha-uma-batida-por-tipo.md §9.3 e §9.9. #}
{% set motivosAConferir = {
    entradas_distintas: 'mais de uma entrada',
    repousos_distintos: 'mais de um repouso',
    retornos_distintos: 'mais de um retorno',
    saidas_distintas: 'mais de uma saída',
    retorno_antes_do_repouso: 'retorno antes do repouso'
} %}
{# E10: o dia que só tem batida desconsiderada também fica, para a linha "Desconsideradas" trazer o Restaurar. #}
{% set linhasDaFolha = somenteDiasComBatida
    ? folhaRows|filter(l => (l.entrada ~ l.repouso ~ l.retorno ~ l.saida) != '' or (l.isFeriado|default(false) and (l.minutosTrabalhadosDia ?? 0) > 0) or desconsideradasPorDia[l.chaveDia] is defined)
    : folhaRows %}

{% if carregarCssDaFolha %}
<link rel="stylesheet" href="{{ asset('css/ponto-eletronico.css') }}">
{% endif %}
<section class="pe-folha" data-screen-label="Folha de Ponto">
    <div class="pe-folha-barra">
        <i class="bi bi-table" aria-hidden="true"></i>
        <span class="pe-folha-titulo">{{ titulo }}</span>
        {# A lista é filha da barra, como no desenho; o formulário que ela envia mora fora (atributo `form`). #}
        {% if competenciasPonto is defined and competenciasPonto is not empty and competenciaFormAction is defined %}
            <select id="{{ campoCompetenciaId }}" name="competencia" form="{{ campoCompetenciaId }}-form" class="pe-folha-mes"
                    aria-label="Competência" onchange="this.form.submit()">
                {% for competencia in competenciasPonto %}
                    <option value="{{ competencia.valor }}" {% if competencia.valor == competenciaSelecionada %}selected{% endif %}>{{ competencia.label }}</option>
                {% endfor %}
            </select>
        {% endif %}
        {% if jornadaInfo is not null %}
            {% set horasDaJornada = jornadaInfo.cargaHorariaSemanal // 60 %}
            {% set minutosDaJornada = jornadaInfo.cargaHorariaSemanal % 60 %}
            <span class="pe-folha-jornada" title="Carga horária semanal vigente"><i class="bi bi-calendar-week" aria-hidden="true"></i>{{ horasDaJornada }}h{{ '%02d'|format(minutosDaJornada) }}m/sem ({{ jornadaInfo.fonte == 'personalizada' ? 'Personalizada' : 'Padrão do escritório' }})</span>
        {% endif %}
        <span class="pe-folha-espaco"></span>
        {% if exportarFolhaHabilitado and exportarAnoResolved and exportarMesResolved %}
            {% set urlPdf       = path('ponto_exportar_pdf',  exportarFolhaParametros|merge({ano: exportarAnoResolved, mes: exportarMesResolved})) %}
            {% set urlPdfInline = path('ponto_exportar_pdf',  exportarFolhaParametros|merge({ano: exportarAnoResolved, mes: exportarMesResolved, inline: 1})) %}
            {% set urlXlsx      = path('ponto_exportar_xlsx', exportarFolhaParametros|merge({ano: exportarAnoResolved, mes: exportarMesResolved})) %}
            {% set nomePdf = 'Folha de Ponto ' ~ ('%02d'|format(exportarMesResolved)) ~ '/' ~ exportarAnoResolved ~ '.pdf' %}
            {# P89 e P88 (ficam): ver o PDF antes de baixar e a planilha. P87: "Baixar PDF" baixa direto, por último. #}
            <button type="button" class="pe-folha-btn" data-bs-toggle="modal" data-bs-target="#modalPreviewFolhaPonto"
                    data-url="{{ urlPdfInline }}" data-download="{{ urlPdf }}" data-nome="{{ nomePdf }}">
                <i class="bi bi-eye" aria-hidden="true"></i>Ver PDF
            </button>
            <button type="button" class="pe-folha-btn" data-folha-baixar="{{ urlXlsx }}">
                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>Baixar XLSX
            </button>
            <button type="button" class="pe-folha-btn" data-folha-baixar="{{ urlPdf }}">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>Baixar PDF
            </button>
        {% endif %}
    </div>
    {% if avisoSemCorrecao %}
        <p class="small text-muted px-3 pt-2 mb-0" data-folha-sem-correcao>{{ avisoSemCorrecao }}</p>
    {% endif %}

    <div class="pe-folha-rolagem">
        <table class="pe-tab pe-resp">
            <thead>
                <tr>
                    <th>Dia</th>
                    <th>Semana</th>
                    <th>Entrada</th>
                    <th>Repouso</th>
                    <th>Retorno</th>
                    <th>Saída</th>
                    {% if mostrarBancoHoras %}
                        <th title="Horas trabalhadas no dia">Trabalhado</th>
                        <th title="Saldo do dia (positivo = extra, negativo = falta)">Saldo dia</th>
                        <th title="Saldo acumulado no mês, dia a dia">Saldo mês</th>
                    {% endif %}
                    {% if mostrarJustificativas %}
                        <th>Justificativa</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for linha in linhasDaFolha %}
                    {# Pelo alvo, não pelo id do registro: a batida incluída pelo gestor (E10) não tem registro. #}
                    {% set diaTemBatida = (linha.entradaAlvo ?? null) is not null
                        or (linha.repousoAlvo ?? null) is not null
                        or (linha.retornoAlvo ?? null) is not null
                        or (linha.saidaAlvo   ?? null) is not null %}
                    {% set ehFeriado = linha.isFeriado|default(false) %}
                    <tr class="pe-lin" data-chave-dia="{{ linha.chaveDia }}">
                        <td class="pe-larga"><b>{{ linha.diaMes }}</b></td>
                        <td class="pe-larga">{{ nomesDaSemana[linha.chaveDia|date('N')] }}
                            {%- if ehFeriado and diaTemBatida %}
                                <span class="pe-tag pe-tag--info pe-tag--extra" title="{{ linha.nomeFeriado }}"><i class="bi bi-calendar-event" aria-hidden="true"></i>Feriado</span>
                            {%- endif %}
                            {%- if linha.homeOffice|default(false) %}
                                <span class="pe-tag pe-tag--info pe-tag--extra" title="Batida em home office"><i class="bi bi-house-laptop" aria-hidden="true"></i>Home Office</span>
                            {%- endif %}
                            {# E14: alguma batida do dia veio da fila do aparelho, guardada sem internet (a hora é a do aparelho). #}
                            {%- if linha.semInternet|default(false) %}
                                <span class="pe-tag pe-tag--info pe-tag--extra" title="Batida enviada sem internet: vale a hora do aparelho."><i class="bi bi-wifi-off" aria-hidden="true"></i>Sem internet</span>
                            {%- endif %}
                            {# E12: alguma batida do dia entrou como trabalho externo, fora do raio das sedes (vai para a análise do gestor). #}
                            {%- if linha.trabalhoExterno|default(false) %}
                                <span class="pe-tag pe-tag--info pe-tag--extra" title="Batida registrada como trabalho externo, fora do raio das sedes."><i class="bi bi-briefcase" aria-hidden="true"></i>Trabalho externo</span>
                            {%- endif %}
                            {# Dia ambíguo: a conta segue a escolha de sempre (a primeira de cada tipo, a última saída) e NÃO é
                               reinterpretada; quem resolve é um humano corrigindo a batida. Só aqui, na tela do colaborador e
                               na ficha do admin; o PDF e o XLSX assinados não anunciam pendência. #}
                            {%- if linha.aConferir|default([]) is not empty %}
                                <span class="pe-tag pe-tag--alerta pe-tag--extra a-conferir"
                                      data-a-conferir="{{ linha.aConferir|join(' ') }}"
                                      data-bs-toggle="tooltip"
                                      title="Batidas a conferir: {{ linha.aConferir|map(m => motivosAConferir[m] ?? m)|join(', ') }}. A folha conta a primeira batida de cada tipo e a última saída; as outras ficam fora da conta até serem corrigidas."><i class="bi bi-question-circle" aria-hidden="true"></i>A conferir</span>
                            {%- endif %}
                            {# As batidas que ficaram fora da conta, para o gestor corrigir pela ficha. #}
                            {% if editarBatidasHabilitado and linha.batidasDesconsideradas|default([]) is not empty %}
                                <span class="pe-folha-sub batidas-desconsideradas">
                                    Fora da conta:
                                    {% for desconsiderada in linha.batidasDesconsideradas %}
                                        {% if desconsiderada.alvo|default(null) %}
                                            {% set rotuloForaDaConta = rotulosBatida[desconsiderada.tipo] ?? desconsiderada.tipo %}
                                            <span class="pe-folha-celula">
                                                <a href="{{ path(editarBatidasRotaAjustar, editarBatidasParametros|merge({alvo: desconsiderada.alvo, competencia: competenciaSelecionada})) }}"
                                                   class="pe-folha-hora batida-desconsiderada" data-registro-id="{{ desconsiderada.id }}" data-alvo="{{ desconsiderada.alvo }}" title="Ajustar batida">
                                                    {{ rotuloForaDaConta }} {{ desconsiderada.hora }}
                                                </a>
                                                {{ _self.desconsiderar(editarBatidasRotaDesconsiderar, editarBatidasParametros, desconsiderada.alvo, desconsiderada.cabeca|default(null), rotuloForaDaConta ~ ' ' ~ desconsiderada.hora ~ ' de ' ~ linha.chaveDia|date('d/m/Y')) }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </span>
                            {% endif %}
                            {# E10: as batidas que o gestor tirou da conta neste dia, com o "Restaurar". A que saiu pela análise
                               da justificativa não se restaura pela ficha (decisão A): fica sem o botão, com o porquê na dica. #}
                            {% if editarBatidasHabilitado and desconsideradasPorDia[linha.chaveDia] is defined %}
                                <span class="pe-folha-sub batidas-fora-por-ajuste">
                                    Desconsideradas:
                                    {% for fora in desconsideradasPorDia[linha.chaveDia] %}
                                        {% set rotuloFora = rotulosBatida[fora.tipo] ?? fora.tipo %}
                                        <span class="pe-folha-celula batida-fora-por-ajuste" data-ajuste-id="{{ fora.ajusteId }}"
                                              title="{{ fora.pelaAnalise ? constant('App\\Ponto\\Exception\\AjusteDeBatidaRecusadoException::MENSAGEM_LIGADA_A_JUSTIFICATIVA') : 'Desconsiderada por ' ~ fora.por ~ ' em ' ~ fora.em ~ '. Registro original preservado.' }}">
                                            {{ rotuloFora }} {{ fora.hora }}
                                            {% if not fora.pelaAnalise %}
                                                <button type="button" class="pe-mais pe-mais--restaurar" title="Restaurar batida" aria-label="Restaurar batida"
                                                        data-bs-toggle="modal" data-bs-target="#modalRestaurarBatida"
                                                        data-acao="{{ path(editarBatidasRotaRestaurar, editarBatidasParametros|merge({ajusteId: fora.ajusteId})) }}"
                                                        data-token="{{ csrf_token('ponto_restaurar_' ~ fora.ajusteId) }}"
                                                        data-batida="{{ rotuloFora }} {{ fora.hora }} de {{ fora.dia|date('d/m/Y') }}"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                            {% endif %}
                                        </span>
                                    {% endfor %}
                                </span>
                            {% endif %}
                        </td>

                        {% for tipoInfo in [
                            {campo: 'entrada', alvo: linha.entradaAlvo ?? null, cabeca: linha.entradaCabeca ?? null, ajuste: linha.entradaAjuste ?? null},
                            {campo: 'repouso', alvo: linha.repousoAlvo ?? null, cabeca: linha.repousoCabeca ?? null, ajuste: linha.repousoAjuste ?? null},
                            {campo: 'retorno', alvo: linha.retornoAlvo ?? null, cabeca: linha.retornoCabeca ?? null, ajuste: linha.retornoAjuste ?? null},
                            {campo: 'saida',   alvo: linha.saidaAlvo   ?? null, cabeca: linha.saidaCabeca   ?? null, ajuste: linha.saidaAjuste   ?? null}
                        ] %}
                            {% set horario = attribute(linha, tipoInfo.campo) %}
                            {% set rotulo = rotulosBatida[tipoInfo.campo] %}
                            {# E10 (desenho L154 e L749): a batida ajustada leva a marca "aj" depois da hora, com quem ajustou e quando. #}
                            {% set dicaDoAjuste = tipoInfo.ajuste ? 'Ajustado por ' ~ tipoInfo.ajuste.por ~ ' em ' ~ tipoInfo.ajuste.em ~ '. Registro original preservado.' : null %}
                            <td data-r="{{ rotulo }}">
                                {%- if editarBatidasHabilitado -%}
                                    {%- if tipoInfo.alvo -%}
                                        <span class="pe-folha-celula">
                                            <a href="{{ path(editarBatidasRotaAjustar, editarBatidasParametros|merge({alvo: tipoInfo.alvo, competencia: competenciaSelecionada})) }}"
                                               class="pe-folha-hora" title="Ajustar batida">{{ horario }}</a>
                                            {%- if dicaDoAjuste %} <span class="pe-pl pe-aj" title="{{ dicaDoAjuste }}" aria-label="{{ dicaDoAjuste }}">aj</span>{% endif %}
                                            {{ _self.desconsiderar(editarBatidasRotaDesconsiderar, editarBatidasParametros, tipoInfo.alvo, tipoInfo.cabeca, rotulo ~ ' ' ~ horario ~ ' de ' ~ linha.chaveDia|date('d/m/Y')) }}
                                        </span>
                                    {%- else -%}
                                        <button type="button" class="pe-mais" title="Incluir {{ rotulo|lower }}" aria-label="Incluir {{ rotulo|lower }}"
                                                onclick="abrirModalAddBatida('{{ tipoInfo.campo }}', '{{ linha.chaveDia }}')"><i class="bi bi-plus-circle" aria-hidden="true"></i></button>
                                    {%- endif -%}
                                {%- elseif tipoInfo.alvo is not null -%}
                                    {{ horario }}
                                    {%- if dicaDoAjuste %} <span class="pe-pl pe-aj" title="{{ dicaDoAjuste }}" aria-label="{{ dicaDoAjuste }}">aj</span>{% endif %}
                                {#- P30 (a), decisão de 09/11/2026: "+" em qualquer dia passado da folha; feriado fica sem ele (no
                                    desenho, um traço; aqui, a célula vazia). Hoje também tem o "+": função do sistema que volta
                                    (regra 2; spec ponto-atalho-esquecimento-registro: "esqueci de bater a entrada hoje de manhã" é
                                    o caso mais comum do atalho). Ficam do sistema: dia antes do início da contagem (uma batida ali
                                    moveria a contagem), dia sem batida nenhuma e a batida que já tem esquecimento pedido ou
                                    abonado (sem duplicata, hoje inclusive); este último mostra "Em análise" na coluna Justificativa. -#}
                                {%- elseif justificarFaltanteHabilitado
                                    and esquecimentosRegistrados[linha.chaveDia ~ '|' ~ tipoInfo.campo] is not defined
                                    and diaTemBatida
                                    and not ehFeriado
                                    and not linha.antesDoPrimeiroRegistro|default(false)
                                    and dataHoje is not null and linha.chaveDia <= dataHoje -%}
                                    <button type="button" class="pe-mais"
                                            title="Enviar registro de esquecimento: {{ rotulo }}"
                                            aria-label="Enviar registro de esquecimento: {{ rotulo }}"
                                            data-esquecimento-dia="{{ linha.chaveDia }}"
                                            data-esquecimento-campo="{{ tipoInfo.campo }}"
                                            data-esquecimento-rotulo="{{ rotulo }}"><i class="bi bi-plus-circle" aria-hidden="true"></i></button>
                                {%- endif -%}
                            </td>
                        {% endfor %}

                        {% if mostrarBancoHoras %}
                            {% set trabalhou = linha.minutosTrabalhadosDia is not null and linha.minutosTrabalhadosDia > 0 %}
                            <td{% if not trabalhou %} class="pe-vazia"{% endif %} data-r="Trabalhado">
                                {%- if trabalhou %}{{ folha.horas(linha.minutosTrabalhadosDia) }}{% endif -%}
                            </td>
                            {{ include('ponto/_folha_saldo_dia.html.twig', {
                                linha: linha,
                                diaTemBatida: diaTemBatida,
                                hojeDaFolha: hojeDaFolha,
                                registroEmOutroEscritorio: diasComRegistroEmOutroEscritorio[linha.chaveDia] is defined
                            }, with_context = false) }}
                            {# Dia em andamento (hoje sem saída, E17): o acumulado até ontem, como o desenho (L157); no dia 1º, nada. #}
                            {% set acumulado = linha.saldoAcumulado ?? linha.saldoAcumuladoAteOntem|default(null) %}
                            <td class="pe-sm{{ acumulado is null ? ' pe-vazia' : (acumulado < 0 ? ' pe-cor--neg' : (acumulado > 0 ? ' pe-cor--pos' : ' pe-cor--zero')) }}" data-r="Saldo mês">
                                {%- if acumulado is not null %}{{ folha.saldo(acumulado) }}{% endif -%}
                            </td>
                        {% endif %}

                        {% if mostrarJustificativas %}
                            {{ include('ponto/_folha_justificativa.html.twig', {
                                j: linha.justificativa ?? null,
                                emAnalise: esquecimentosEmAnalise[linha.chaveDia] is defined
                            }, with_context = false) }}
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ totalDeColunas }}" class="pe-toda pe-folha-vazia">Nenhuma batida nesta competência.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Bloco de totais do rodapé (spec §7; P32, fica): sem ele o colaborador vê o saldo do mês na última célula
       da coluna "Saldo mês", a linha de horas pagas logo abaixo, e nenhuma soma; teria de
       fazer a conta de cabeça num número que é salário.

       `saldoMesMinutos` vem PRONTO dos dois controllers que incluem este partial
       (PontoController::index e TenantController::editUserRole): nos dois, a conta do banco para a competência, sem as
       horas pagas (E17), e não a última linha que a tela mostra. O filtro do P25 não muda o número, e a soma da folha
       é o banco. Nunca é null: o mês sem batida mostra as faltas dele (zero só sem dia contado), e a soma continua
       existindo justamente no mês em que só há o lançamento. O `is not null` abaixo é só uma guarda.

       ⚠️ O RÓTULO DA 3ª LINHA É "Total do mês", NÃO "banco de horas", e a distinção não é estética.
       `saldoMesMinutos` é o saldo DAQUELE MÊS (`buildRows` faz o acumulado nascer em zero no dia 1º),
       então esta soma é o resultado do mês com o ajuste manual, e NÃO o banco acumulado. Quem mostra
       o banco acumulado nesta mesma página é o "Banco de horas" da barra do cartão Registrar Ponto (vindo de
       `BancoDeHorasPorLotes`). Chamar as duas coisas de "banco de horas" colocava dois números
       diferentes lado a lado: 100h pagas em dinheiro e quitadas com um lançamento de -6000 deixavam o
       card em "+0h00m" (certo) e este rodapé em "-100h00m", cobrando de volta o que acabou de ser
       pago, a MESMA cobrança indevida que fez o dono reverter a soma no bloco assinado do PDF
       (spec §7). Se for renomear de volta, leia antes a decisão do dono na spec §7. #}
    {% if horasPagasMinutos is defined and horasPagasMinutos != 0 %}
        {% set saldoMesMinutos = saldoMesMinutos is defined and saldoMesMinutos is not null ? saldoMesMinutos : 0 %}
        {% set totalMesMinutos = saldoMesMinutos + horasPagasMinutos %}
        <div class="pe-folha-totais">
            <div class="pe-folha-total">
                <span class="pe-folha-total-rotulo">Saldo do mês</span>
                <b class="pe-folha-total-valor {{ saldoMesMinutos < 0 ? 'pe-cor--neg' : (saldoMesMinutos > 0 ? 'pe-cor--pos' : 'pe-cor--zero') }}">{{ saldoMesMinutos < 0 ? '-' : (saldoMesMinutos > 0 ? '+' : '') }}{{ folha.horas(saldoMesMinutos) }}</b>
            </div>
            <div class="pe-folha-total">
                <span class="pe-folha-total-rotulo">Horas pagas</span>
                <b class="pe-folha-total-valor {{ horasPagasMinutos < 0 ? 'pe-cor--neg' : 'pe-cor--pos' }}">{{ horasPagasMinutos < 0 ? '-' : '+' }}{{ folha.horas(horasPagasMinutos) }}</b>
            </div>
            <div class="pe-folha-total pe-folha-total--soma">
                <span class="pe-folha-total-rotulo">Total do mês</span>
                <b class="pe-folha-total-valor {{ totalMesMinutos < 0 ? 'pe-cor--neg' : (totalMesMinutos > 0 ? 'pe-cor--pos' : 'pe-cor--zero') }}">{{ totalMesMinutos < 0 ? '-' : (totalMesMinutos > 0 ? '+' : '') }}{{ folha.horas(totalMesMinutos) }}</b>
            </div>
        </div>
    {% endif %}
</section>

{% if competenciasPonto is defined and competenciasPonto is not empty and competenciaFormAction is defined %}
{# O formulário da lista do mês (GET ?competencia=): fora do cartão, para a lista ficar filha direta da barra. #}
<form id="{{ campoCompetenciaId }}-form" method="get" action="{{ competenciaFormAction }}" hidden></form>
{% endif %}

{% if exportarFolhaHabilitado %}
<div class="modal fade" id="modalPreviewFolhaPonto" tabindex="-1" aria-labelledby="modalPreviewFolhaPontoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="modalPreviewFolhaPontoLabel">
                    <i class="bi bi-eye me-1"></i> <span id="previewFolhaNome"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="min-height: 75vh;">
                <div id="previewFolhaConteudo" class="w-100 h-100"></div>
            </div>
            <div class="modal-footer py-2">
                <a id="previewFolhaDownload" href="#" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i> Baixar
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    // "Baixar PDF" e "Baixar XLSX" (P87 e P88): a resposta vem como anexo, então ir até ela baixa sem sair da tela.
    // Delegado no documento: depois da batida a /ponto troca a folha inteira e os botões novos continuam funcionando.
    document.addEventListener('click', function (e) {
        var botao = e.target.closest('[data-folha-baixar]');
        if (botao) {
            window.location.href = botao.dataset.folhaBaixar;
        }
    });

    var modal = document.getElementById('modalPreviewFolhaPonto');
    if (!modal) { return; }

    // "Ver PDF" (P89, fica): o PDF dentro da janela, com o botão de baixar.
    modal.addEventListener('show.bs.modal', function (e) {
        var btn = e.relatedTarget;
        var conteudo = document.getElementById('previewFolhaConteudo');
        var quadro = document.createElement('iframe');

        document.getElementById('previewFolhaNome').textContent = btn.dataset.nome;
        document.getElementById('previewFolhaDownload').href = btn.dataset.download;
        quadro.src = btn.dataset.url;
        quadro.className = 'w-100 border-0';
        quadro.style.height = '78vh';
        quadro.title = btn.dataset.nome;
        conteudo.replaceChildren(quadro);
    });

    modal.addEventListener('hide.bs.modal', function () {
        document.getElementById('previewFolhaConteudo').replaceChildren();
    });
}());
</script>
{% endif %}

{# O "x" da batida na ficha (E10): abre a janela "Desconsiderar batida" da ficha com o endereço, o token por intenção e
   a cabeça que a folha mostrou (vazia na batida nunca ajustada); o motivo é digitado lá. #}
{% macro desconsiderar(rota, parametros, alvo, cabeca, batida) %}
    <button type="button" class="pe-mais pe-mais--excluir" title="Desconsiderar batida" aria-label="Desconsiderar batida"
            data-bs-toggle="modal" data-bs-target="#modalDesconsiderarBatida"
            data-acao="{{ path(rota, parametros|merge({alvo: alvo})) }}"
            data-token="{{ csrf_token('ponto_desconsiderar_' ~ alvo) }}"
            data-cabeca="{{ cabeca }}"
            data-batida="{{ batida }}"><i class="bi bi-x-circle" aria-hidden="true"></i></button>
{% endmacro %}
