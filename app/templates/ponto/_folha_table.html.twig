{% set competenciaParts = competenciaSelecionada|default('') ? competenciaSelecionada|split('-') : [] %}
{% set exportarAnoResolved = exportarAno is defined ? exportarAno : (competenciaParts|length == 2 ? competenciaParts[0] : null) %}
{% set exportarMesResolved = exportarMes is defined ? exportarMes : (competenciaParts|length == 2 ? competenciaParts[1] : null) %}
{% set exportarFolhaHabilitado = exportarFolhaHabilitado|default(false) %}
{% set exportarFolhaParametros = exportarFolhaParametros|default({}) %}
{% set mostrarBancoHoras = mostrarBancoHoras|default(false) %}
{% set mostrarJustificativas = mostrarJustificativas|default(false) %}
{% set editarBatidasHabilitado = editarBatidasHabilitado|default(false) %}
{% set editarBatidasRotaAdd = editarBatidasRotaAdd|default('') %}
{% set editarBatidasRotaEdit = editarBatidasRotaEdit|default('') %}
{% set editarBatidasRotaDelete = editarBatidasRotaDelete|default('') %}
{% set editarBatidasParametros = editarBatidasParametros|default({}) %}
{% set jornadaInfo = jornadaInfo|default(null) %}
{# Atalho do colaborador: "+" na batida faltante abre o modal de Esquecimento de Registro.
   Inerte por padrão — quem não passa os parâmetros renderiza exatamente o HTML de antes. #}
{% set justificarFaltanteHabilitado = justificarFaltanteHabilitado|default(false) %}
{% set esquecimentosRegistrados = esquecimentosRegistrados|default({}) %}
{# Sem dataHoje o atalho não aparece: o default é fail-closed de propósito, para que esquecer de
   passá-lo não faça a regra de "nada de dia futuro" sumir em silêncio. #}
{% set dataHoje = dataHoje|default(null) %}
{% set rotulosBatida = {entrada: 'Entrada', repouso: 'Repouso', retorno: 'Retorno', saida: 'Saída'} %}

<div class="card card-outline card-info mb-3">
    <div class="card-header d-flex align-items-center gap-2 flex-wrap">
        <h3 class="card-title mb-0">{{ titulo }}</h3>

        {% if jornadaInfo is not null %}
            {% set horas = jornadaInfo.cargaHorariaSemanal // 60 %}
            {% set mins  = jornadaInfo.cargaHorariaSemanal % 60 %}
            <span class="badge text-bg-light border text-secondary small ms-1" title="Carga horária semanal vigente">
                <i class="bi bi-calendar-week me-1"></i>{{ horas }}h{{ '%02d'|format(mins) }}m/sem
                <span class="ms-1 {{ jornadaInfo.fonte == 'personalizada' ? 'text-primary' : 'text-secondary' }}">
                    ({{ jornadaInfo.fonte == 'personalizada' ? 'Personalizada' : 'Padrão do escritório' }})
                </span>
            </span>
        {% endif %}

        {% if competenciasPonto is defined and competenciasPonto is not empty and competenciaFormAction is defined %}
            <form method="get" action="{{ competenciaFormAction }}" class="d-flex align-items-center gap-2">
                <label for="{{ competenciaFieldId|default('competencia') }}" class="mb-0 small text-muted">Mês</label>
                <select
                    id="{{ competenciaFieldId|default('competencia') }}"
                    name="competencia"
                    class="form-select form-select-sm"
                    onchange="this.form.submit()"
                >
                    {% for competencia in competenciasPonto %}
                        <option value="{{ competencia.valor }}" {% if competencia.valor == competenciaSelecionada %}selected{% endif %}>{{ competencia.label }}</option>
                    {% endfor %}
                </select>
            </form>
        {% endif %}

        {% if exportarFolhaHabilitado and exportarAnoResolved and exportarMesResolved %}
            {% set urlPdf      = path('ponto_exportar_pdf',  exportarFolhaParametros|merge({ano: exportarAnoResolved, mes: exportarMesResolved})) %}
            {% set urlPdfInline = path('ponto_exportar_pdf', exportarFolhaParametros|merge({ano: exportarAnoResolved, mes: exportarMesResolved, inline: 1})) %}
            {% set urlXlsx     = path('ponto_exportar_xlsx', exportarFolhaParametros|merge({ano: exportarAnoResolved, mes: exportarMesResolved})) %}
            {% set nomePdf  = 'Folha de Ponto ' ~ ('%02d'|format(exportarMesResolved)) ~ '/' ~ exportarAnoResolved ~ '.pdf' %}
            {% set nomeXlsx = 'Folha de Ponto ' ~ ('%02d'|format(exportarMesResolved)) ~ '/' ~ exportarAnoResolved ~ '.xlsx' %}
            <div class="btn-group ms-auto">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-eye me-1"></i>Visualizar / Exportar
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button type="button" class="dropdown-item"
                                data-bs-toggle="modal" data-bs-target="#modalPreviewFolhaPonto"
                                data-url="{{ urlPdfInline }}"
                                data-download="{{ urlPdf }}"
                                data-nome="{{ nomePdf }}"
                                data-mime="application/pdf">
                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i>PDF
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item"
                                data-bs-toggle="modal" data-bs-target="#modalPreviewFolhaPonto"
                                data-url=""
                                data-download="{{ urlXlsx }}"
                                data-nome="{{ nomeXlsx }}"
                                data-mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
                            <i class="bi bi-file-earmark-spreadsheet text-success me-2"></i>XLSX
                        </button>
                    </li>
                </ul>
            </div>
        {% endif %}
    </div>

    <div class="card-body p-0">
        {% if competenciasPonto is defined and competenciasPonto is empty %}
            <p class="text-muted small p-3 mb-0">Nenhum registro de ponto encontrado.</p>
        {% elseif folhaRows is empty %}
            <p class="text-muted small p-3 mb-0">Não há batidas para a competência selecionada.</p>
        {% else %}
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Dia do Mês</th>
                        <th>Dia da Semana</th>
                        <th>Entrada</th>
                        <th>Repouso</th>
                        <th>Retorno</th>
                        <th>Saída</th>
                        {% if mostrarBancoHoras %}
                            <th title="Horas trabalhadas no dia">Trabalhado</th>
                            <th title="Saldo do dia (positivo = extra, negativo = falta)">Saldo Dia</th>
                            <th title="Saldo acumulado no mês">Banco de Horas</th>
                        {% endif %}
                        {% if mostrarJustificativas %}
                            <th>Justificativa</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for linha in folhaRows %}
                        <tr class="{{ linha.isFeriado|default(false) ? 'table-warning' : (linha.fimSemana ? 'table-secondary' : '') }}">
                            <td>{{ linha.diaMes }}</td>
                            <td>
                                {% if linha.isFeriado|default(false) %}
                                    <span class="text-warning-emphasis fw-semibold">{{ linha.diaSemana }}</span>
                                {% else %}
                                    {{ linha.diaSemana }}
                                {% endif %}
                                {% if linha.homeOffice|default(false) %}
                                    <span class="badge text-bg-info text-dark ms-1" title="Batida em home office">
                                        <i class="bi bi-house-laptop"></i> Home Office
                                    </span>
                                {% endif %}
                            </td>

                            {# O atalho "+" só vale para dia que JÁ tem alguma batida (esqueceu uma das
                               quatro). Dia sem batida nenhuma só está na folha por causa da própria
                               justificativa — tipicamente atestado ou folga já abonados; oferecer "+" ali
                               convidaria a criar batida num dia fechado, que pode virar hora extra. #}
                            {% set diaTemBatida = (linha.entradaId ?? null) is not null
                                or (linha.repousoId ?? null) is not null
                                or (linha.retornoId ?? null) is not null
                                or (linha.saidaId   ?? null) is not null %}

                            {# Macro para célula editável #}
                            {% for tipoInfo in [
                                {campo: 'entrada', id: linha.entradaId ?? null},
                                {campo: 'repouso', id: linha.repousoId ?? null},
                                {campo: 'retorno', id: linha.retornoId ?? null},
                                {campo: 'saida',   id: linha.saidaId   ?? null}
                            ] %}
                                <td class="text-nowrap">
                                    {% set horario = attribute(linha, tipoInfo.campo) %}
                                    {% if editarBatidasHabilitado %}
                                        <div class="d-flex align-items-center gap-1">
                                            {% if tipoInfo.id %}
                                                <a href="{{ path(editarBatidasRotaEdit, editarBatidasParametros|merge({registroId: tipoInfo.id, competencia: competenciaSelecionada})) }}"
                                                   class="text-body text-decoration-none" title="Editar batida">
                                                    {{ horario }}
                                                </a>
                                                <form method="post"
                                                      action="{{ path(editarBatidasRotaDelete, editarBatidasParametros|merge({registroId: tipoInfo.id})) }}"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Excluir esta batida?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_ponto_' ~ tipoInfo.id) }}">
                                                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger" title="Excluir batida">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 text-secondary"
                                                        title="Adicionar {{ tipoInfo.campo }}"
                                                        onclick="abrirModalAddBatida('{{ tipoInfo.campo }}', '{{ linha.chaveDia }}')">
                                                    <i class="bi bi-plus-circle"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% elseif justificarFaltanteHabilitado and tipoInfo.id is null %}
                                        {% set chaveEsquecimento = linha.chaveDia ~ '|' ~ tipoInfo.campo %}
                                        {% if esquecimentosRegistrados[chaveEsquecimento] is defined %}
                                            <span class="text-warning" title="Esquecimento desta batida já justificado">
                                                <i class="bi bi-hourglass-split"></i>
                                            </span>
                                        {% elseif diaTemBatida
                                            and not linha.fimSemana|default(false)
                                            and not linha.isFeriado|default(false)
                                            and not linha.antesDoPrimeiroRegistro|default(false)
                                            and (dataHoje is not null and linha.chaveDia <= dataHoje) %}
                                            <button type="button"
                                                    class="btn btn-link btn-sm p-0 text-secondary"
                                                    title="Esqueci de registrar a {{ rotulosBatida[tipoInfo.campo] }} deste dia"
                                                    data-esquecimento-dia="{{ linha.chaveDia }}"
                                                    data-esquecimento-campo="{{ tipoInfo.campo }}"
                                                    data-esquecimento-rotulo="{{ rotulosBatida[tipoInfo.campo] }}">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>
                                        {% endif %}
                                    {% else %}
                                        {{ horario }}
                                    {% endif %}
                                </td>
                            {% endfor %}

                            {% if mostrarBancoHoras %}
                                <td class="text-nowrap">
                                    {% if linha.minutosTrabalhadosDia is not null and linha.minutosTrabalhadosDia > 0 %}
                                        {{ (linha.minutosTrabalhadosDia // 60) }}h{{ '%02d'|format(linha.minutosTrabalhadosDia % 60) }}m
                                    {% endif %}
                                </td>
                                <td class="text-nowrap fw-semibold">
                                    {% if linha.saldoDia is not null %}
                                        {% set absSaldo = linha.saldoDia < 0 ? -linha.saldoDia : linha.saldoDia %}
                                        {% if linha.saldoDia > 0 %}
                                            <span class="text-success">+{{ (absSaldo // 60) }}h{{ '%02d'|format(absSaldo % 60) }}m</span>
                                        {% elseif linha.saldoDia < 0 %}
                                            <span class="text-danger">-{{ (absSaldo // 60) }}h{{ '%02d'|format(absSaldo % 60) }}m</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td class="text-nowrap fw-semibold">
                                    {% if linha.saldoAcumulado is not null %}
                                        {% set absAcum = linha.saldoAcumulado < 0 ? -linha.saldoAcumulado : linha.saldoAcumulado %}
                                        {% if linha.saldoAcumulado > 0 %}
                                            <span class="text-success">+{{ (absAcum // 60) }}h{{ '%02d'|format(absAcum % 60) }}m</span>
                                        {% elseif linha.saldoAcumulado < 0 %}
                                            <span class="text-danger">-{{ (absAcum // 60) }}h{{ '%02d'|format(absAcum % 60) }}m</span>
                                        {% else %}
                                            <span class="text-muted">0h</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                            {% endif %}

                            {% if mostrarJustificativas %}
                                <td>
                                    {% if linha.justificativa is defined and linha.justificativa is not null %}
                                        {% set j = linha.justificativa %}
                                        {% if j.status == 'abonado' and j.tipo == 'falta_nao_justificada' %}
                                            <span class="badge text-bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>Não abonada
                                            </span>
                                            {% if j.labelTipo %}
                                                <div class="small text-muted mt-1">{{ j.labelTipo }}</div>
                                            {% endif %}
                                        {% elseif j.status == 'abonado' %}
                                            <span class="badge text-bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Abonada
                                            </span>
                                            {% if j.labelTipo %}
                                                <div class="small text-muted mt-1">{{ j.labelTipo }}</div>
                                            {% endif %}
                                            {% if j.abonoParcial and j.horaInicioAbono and j.horaFimAbono %}
                                                <div class="small text-muted">{{ j.horaInicioAbono|date('H:i') }}–{{ j.horaFimAbono|date('H:i') }}</div>
                                            {% endif %}
                                        {% elseif j.status == 'pendente' %}
                                            <span class="badge text-bg-warning text-dark">
                                                <i class="bi bi-hourglass-split me-1"></i>Pendente
                                            </span>
                                            {% if j.labelTipo %}
                                                <div class="small text-muted mt-1">{{ j.labelTipo }}</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge text-bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>Rejeitada
                                            </span>
                                            {% if j.labelTipo %}
                                                <div class="small text-muted mt-1">{{ j.labelTipo }}</div>
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {# Bloco de totais do rodapé (spec §7): sem ele o colaborador vê o saldo do mês na última célula
       da coluna "Banco de Horas", a linha de horas pagas logo abaixo, e nenhuma soma — teria de
       fazer a conta de cabeça num número que é salário.

       `saldoMesMinutos` vem PRONTO dos dois controllers que incluem este partial
       (PontoController::index e TenantController::editUserRole); `null` = nenhuma linha com saldo
       apurado (mês sem batida), tratado como zero para que a soma continue existindo justamente no
       mês em que só há o lançamento. #}
    {% if horasPagasMinutos is defined and horasPagasMinutos != 0 %}
        {% set saldoMesMinutos = saldoMesMinutos is defined and saldoMesMinutos is not null ? saldoMesMinutos : 0 %}
        {% set totalBancoMinutos = saldoMesMinutos + horasPagasMinutos %}
        {% set absSaldoMes = saldoMesMinutos < 0 ? -saldoMesMinutos : saldoMesMinutos %}
        {% set absHp = horasPagasMinutos < 0 ? -horasPagasMinutos : horasPagasMinutos %}
        {% set absTotal = totalBancoMinutos < 0 ? -totalBancoMinutos : totalBancoMinutos %}
        <div class="px-3 py-2 border-top small">
            <div class="ms-auto" style="max-width: 24rem;">
                <div class="d-flex justify-content-between gap-3">
                    <span class="text-muted">Saldo do mês</span>
                    <span class="fw-semibold {{ saldoMesMinutos < 0 ? 'text-danger' : (saldoMesMinutos > 0 ? 'text-success' : 'text-muted') }}">
                        {{ saldoMesMinutos < 0 ? '-' : (saldoMesMinutos > 0 ? '+' : '') }}{{ (absSaldoMes // 60) }}h{{ '%02d'|format(absSaldoMes % 60) }}m
                    </span>
                </div>
                <div class="d-flex justify-content-between gap-3">
                    <span class="text-muted">Horas pagas</span>
                    <span class="fw-semibold {{ horasPagasMinutos < 0 ? 'text-danger' : 'text-success' }}">
                        {{ horasPagasMinutos < 0 ? '-' : '+' }}{{ (absHp // 60) }}h{{ '%02d'|format(absHp % 60) }}m
                    </span>
                </div>
                <div class="d-flex justify-content-between gap-3 border-top mt-1 pt-1">
                    <span class="text-muted">Saldo do banco de horas</span>
                    <span class="fw-bold {{ totalBancoMinutos < 0 ? 'text-danger' : (totalBancoMinutos > 0 ? 'text-success' : 'text-muted') }}">
                        {{ totalBancoMinutos < 0 ? '-' : (totalBancoMinutos > 0 ? '+' : '') }}{{ (absTotal // 60) }}h{{ '%02d'|format(absTotal % 60) }}m
                    </span>
                </div>
            </div>
        </div>
    {% endif %}
</div>

{% if exportarFolhaHabilitado %}
<div class="modal fade" id="modalPreviewFolhaPonto" tabindex="-1" aria-labelledby="modalPreviewFolhaPontoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="modalPreviewFolhaPontoLabel">
                    <i class="bi bi-eye me-1"></i> <span id="previewFolhaNome"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="min-height: 75vh;">
                <div id="previewFolhaConteudo" class="w-100 h-100"></div>
            </div>
            <div class="modal-footer py-2">
                <a id="previewFolhaDownload" href="#" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i> Baixar
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var modal = document.getElementById('modalPreviewFolhaPonto');
    if (!modal) { return; }

    modal.addEventListener('show.bs.modal', function (e) {
        var btn      = e.relatedTarget;
        var url      = btn.dataset.url;
        var download = btn.dataset.download;
        var nome     = btn.dataset.nome;
        var mime     = btn.dataset.mime;

        document.getElementById('previewFolhaNome').textContent = nome;
        document.getElementById('previewFolhaDownload').href = download;
        document.getElementById('previewFolhaConteudo').innerHTML = '';

        if (mime === 'application/pdf' && url) {
            document.getElementById('previewFolhaConteudo').innerHTML =
                '<iframe src="' + url + '" class="w-100 border-0" style="height:78vh;" title="' + nome + '"></iframe>';
        } else {
            document.getElementById('previewFolhaConteudo').innerHTML =
                '<div class="p-5 text-center text-muted w-100">' +
                '<i class="bi bi-file-earmark-spreadsheet display-1 d-block mb-3 text-success"></i>' +
                '<p class="mb-1 fw-semibold">' + nome + '</p>' +
                '<p class="small mb-4">Pré-visualização não disponível para planilhas.</p>' +
                '<a href="' + download + '" class="btn btn-success">' +
                '<i class="bi bi-download me-1"></i> Baixar XLSX' +
                '</a></div>';
        }
    });

    modal.addEventListener('hide.bs.modal', function () {
        document.getElementById('previewFolhaConteudo').innerHTML = '';
    });
}());
</script>
{% endif %}
