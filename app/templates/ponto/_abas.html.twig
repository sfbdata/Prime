{#
    Cartão de abas da coluna da direita, logo abaixo da Folha (E3, desenho 16 L166 a L191, ordem da L758): "Pendências"
    (P37, primeira e aberta ao entrar), "Minhas Justificativas" (P39), "Comprovantes" (E15, só com o comprovante
    ligado: `comprovantesVisiveis`) e "Banco de Horas" (E17: `bancoDeHoras`, nulo até a etapa entrar). As abas das
    etapas seguintes (Equipe, Auditoria, Configurações) entram depois do Banco de Horas, nessa ordem.

    As duas abas vêm prontas do servidor; a troca é no navegador (js/ponto-abas.js), sem recarregar, e grava a aba no
    endereço (`?aba=justificativas`): a busca da tela depois da batida e a troca do mês voltam na mesma aba. O painel das
    pendências e a aba dele (o número) são regiões trocadas depois da batida (REGIOES_TROCADAS no index).

    Recebe: pendencias, justificativas, abaAberta (uma de PontoController::ABAS_DO_CARTAO), podeAnalisarAPropria,
    competenciaSelecionada (a volta da exclusão reabre a aba no mesmo mês), comprovantesVisiveis e comprovantes (E15)
    e bancoDeHoras (E17).
#}
{% set comprovantesVisiveis = comprovantesVisiveis|default(false) %}
{% set bancoDeHoras = bancoDeHoras|default(null) %}
{# A aba pedida que não está desenhada (Comprovantes desligado, Banco antes da E17) abre Pendências: sempre há uma aberta. #}
{% set abaAberta = (abaAberta == 'comprovantes' and not comprovantesVisiveis) or (abaAberta == 'banco' and bancoDeHoras is null) ? 'pendencias' : abaAberta %}
<section class="pe-abas" data-screen-label="Registros e comprovantes"
         data-url-volta="{{ path('ponto_index', {competencia: competenciaSelecionada, aba: 'justificativas'}) }}">
    <div class="pe-abas-barra" role="tablist" aria-label="Registros e comprovantes">
        <button type="button" role="tab" class="pe-aba" id="ponto-aba-pendencias" data-aba="pendencias"
                aria-controls="ponto-regiao-pendencias" aria-selected="{{ abaAberta == 'pendencias' ? 'true' : 'false' }}" tabindex="{{ abaAberta == 'pendencias' ? '0' : '-1' }}">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Pendências
            {%- if pendencias|length > 0 %}<span class="pe-aba-num pe-aba-num--pend">{{ pendencias|length }}</span>{% endif -%}
        </button>
        <button type="button" role="tab" class="pe-aba" id="ponto-aba-justificativas" data-aba="justificativas"
                aria-controls="ponto-painel-justificativas" aria-selected="{{ abaAberta == 'justificativas' ? 'true' : 'false' }}" tabindex="{{ abaAberta == 'justificativas' ? '0' : '-1' }}">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>Minhas Justificativas
            {%- if justificativas|length > 0 %}<span class="pe-aba-num">{{ justificativas|length }}</span>{% endif -%}
        </button>
        {% if comprovantesVisiveis %}
        <button type="button" role="tab" class="pe-aba" id="ponto-aba-comprovantes" data-aba="comprovantes"
                aria-controls="ponto-painel-comprovantes" aria-selected="{{ abaAberta == 'comprovantes' ? 'true' : 'false' }}" tabindex="{{ abaAberta == 'comprovantes' ? '0' : '-1' }}">
            <i class="bi bi-receipt" aria-hidden="true"></i>Comprovantes
            {%- if comprovantes|default([])|length > 0 %}<span class="pe-aba-num">{{ comprovantes|length }}</span>{% endif -%}
        </button>
        {% endif %}
        {% if bancoDeHoras is not null %}
        <button type="button" role="tab" class="pe-aba" id="ponto-aba-banco" data-aba="banco"
                aria-controls="ponto-painel-banco" aria-selected="{{ abaAberta == 'banco' ? 'true' : 'false' }}" tabindex="{{ abaAberta == 'banco' ? '0' : '-1' }}">
            <i class="bi bi-piggy-bank" aria-hidden="true"></i>Banco de Horas
        </button>
        {% endif %}
    </div>
    <div class="pe-abas-painel" role="tabpanel" id="ponto-regiao-pendencias" aria-labelledby="ponto-aba-pendencias"{{ abaAberta == 'pendencias' ? '' : ' hidden' }}>
        {% include 'ponto/_abas_pendencias.html.twig' with {pendencias: pendencias} only %}
    </div>
    <div class="pe-abas-painel" role="tabpanel" id="ponto-painel-justificativas" aria-labelledby="ponto-aba-justificativas"{{ abaAberta == 'justificativas' ? '' : ' hidden' }}>
        {% include 'ponto/_abas_justificativas.html.twig' with {justificativas: justificativas, podeAnalisarAPropria: podeAnalisarAPropria} only %}
    </div>
    {% if comprovantesVisiveis %}
    <div class="pe-abas-painel" role="tabpanel" id="ponto-painel-comprovantes" aria-labelledby="ponto-aba-comprovantes"{{ abaAberta == 'comprovantes' ? '' : ' hidden' }}>
        {% include 'ponto/_abas_comprovantes.html.twig' with {comprovantes: comprovantes|default([])} only %}
    </div>
    {% endif %}
    {% if bancoDeHoras is not null %}
    <div class="pe-abas-painel" role="tabpanel" id="ponto-painel-banco" aria-labelledby="ponto-aba-banco"{{ abaAberta == 'banco' ? '' : ' hidden' }}>
        {% include 'ponto/_abas_banco.html.twig' with {bancoDeHoras: bancoDeHoras} only %}
    </div>
    {% endif %}
</section>
