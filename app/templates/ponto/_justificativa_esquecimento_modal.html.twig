{#
    Janela "Registro de esquecimento" (E4 do desenho 16, P46; moldura L269 a L318, corpo L275 a L279). Abre pelo "+"
    da folha, pelo "Enviar registro de esquecimento" da aba Pendências e pelo "Regularizar" da faixa (todos passam pelo
    "+", js/ponto-janelas.js). Data e batida vêm do "+" clicado: a pessoa escreve o horário (com segundos, como o
    desenho) e o motivo. Envia pela mesma rota da janela "Justificar falta" (ponto_justificativa_nova).

    O aviso "Enviado para aprovação do gestor." é o aviso flutuante do desenho, depois do envio (P80, E8); a dica que
    ficava dentro da janela antiga saiu.

    Recebe `competenciaSelecionada` e `abaAberta` (a aba para onde a janela volta).
#}
<div class="pe-janela-fundo" id="ponto-janela-esquecimento" hidden>
    <form class="pe-janela" role="dialog" aria-modal="true" aria-label="Registro de esquecimento"
          method="post" action="{{ path('ponto_justificativa_nova') }}" data-janela-form="esquecimento" novalidate>
        <input type="hidden" name="justificativa_ponto[_token]" value="{{ csrf_token('justificativa_ponto') }}">
        <input type="hidden" name="justificativa_ponto[tipo]" value="esquecimento_registro">
        <input type="hidden" name="justificativa_ponto[datas]" id="esquecimentoData">
        <input type="hidden" name="justificativa_ponto[tipoRegistroEsquecido]" id="esquecimentoCampo">
        <input type="hidden" name="competencia" value="{{ competenciaSelecionada }}">
        {# A aba aberta (o ponto-abas.js a acompanha): ao enviar, a tela volta nela (L768). #}
        <input type="hidden" name="aba" value="{{ abaAberta|default('pendencias') }}" data-aba-da-volta>

        <div class="pe-janela-topo">
            <i class="bi bi-plus-circle" aria-hidden="true"></i><b class="pe-janela-titulo">Registro de esquecimento</b>
            <button type="button" class="pe-janela-fechar" aria-label="Fechar" data-janela-fechar><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>

        <div class="pe-janela-corpo">
            <div class="pe-janela-info" id="esquecimentoResumo" data-janela-info></div>
            <label class="pe-janela-rotulo">Horário
                <input type="time" step="1" name="justificativa_ponto[horaRegistroEsquecido]" id="esquecimentoHora" class="pe-janela-entrada">
            </label>
            <label class="pe-janela-rotulo">Motivo
                <textarea name="justificativa_ponto[motivo]" rows="3" maxlength="{{ constant('App\\Ponto\\Form\\JustificativaPontoType::MOTIVO_MAXIMO') }}" class="pe-janela-campo" data-janela-motivo></textarea>
            </label>
        </div>

        <div class="pe-janela-erro" data-janela-erro hidden></div>
        <div class="pe-janela-rodape">
            <button type="button" class="pe-janela-cancelar" data-janela-fechar>Cancelar</button>
            <button type="submit" class="pe-janela-acao" data-janela-enviar>Enviar</button>
        </div>
    </form>
</div>

<script>
(function () {
    function formatarData(chaveDia) {
        var partes = chaveDia.split('-');

        return partes[2] + '/' + partes[1] + '/' + partes[0];
    }

    // Vindo do "Regularizar ponto de ontem" do cabeçalho (`?esquecimento=AAAA-MM-DD:saida`, decisão do dono 19/10): abre
    // o MESMO "+" da folha para aquele dia e batida. Se ele não existir (alguma condição do atalho falha), nada abre:
    // a regra de quando o "+" aparece continua só aqui na folha.
    // Só depois do carregamento: o js/ponto-janelas.js, que abre a janela pelo "+", vem no fim da página.
    function abrirPedidoDoLink() {
        var pedido = /^(\d{4}-\d{2}-\d{2}):(entrada|repouso|retorno|saida)$/.exec(new URLSearchParams(window.location.search).get('esquecimento') || '');
        if (!pedido) { return; }
        var alvo = document.querySelector('[data-esquecimento-dia="' + pedido[1] + '"][data-esquecimento-campo="' + pedido[2] + '"]');
        var url = new URL(window.location.href);
        url.searchParams.delete('esquecimento');
        window.history.replaceState(null, '', url.toString());
        if (alvo) { alvo.scrollIntoView({ block: 'center' }); alvo.click(); return; }
        if (window.bjAviso) { window.bjAviso('Não há pedido de esquecimento a fazer para ' + formatarData(pedido[1]) + ': confira a folha abaixo.'); }
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', abrirPedidoDoLink); } else { abrirPedidoDoLink(); }
}());
</script>
