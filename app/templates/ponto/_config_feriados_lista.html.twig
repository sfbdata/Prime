{#
    Lista "Feriados do escritório" (desenho 16, L258): data em negrito, nome, a marca "Todo ano" (P72, sistema, fica),
    a abrangência e o "x" de remover. Devolvida também pelas rotas de cadastrar e remover, para a tela trocar a lista.

    Recebe `feriadosDoPonto` (list<FeriadoDoPontoOutput>).
#}
{% for feriado in feriadosDoPonto %}
    <div class="pe-fer-lin">
        <b>{{ feriado.data }}</b>
        <span class="pe-fer-nome">{{ feriado.nome }}</span>
        {% if feriado.recorrente %}<span class="pe-fer-marca"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Todo ano</span>{% endif %}
        <span class="pe-fer-abrangencia">{{ feriado.abrangencia }}</span>
        <button type="button" class="pe-fer-remover" aria-label="Remover feriado" data-feriado-remover data-url="{{ path('ponto_configuracoes_feriado_remover', {id: feriado.id}) }}" data-info="{{ feriado.data }}: {{ feriado.nome }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
{% else %}
    <div class="pe-fer-vazio">Nenhum feriado cadastrado.</div>
{% endfor %}
