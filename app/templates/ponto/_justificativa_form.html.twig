{#
    Janela "Justificar falta" (E4 do desenho 16, P44; moldura L269 a L318, corpo L280 a L285). Abre pelo "Justificar
    falta" do rodapé do cartão Registrar Ponto (js/ponto-janelas.js). Moldura, rótulos e botões do desenho; Esc fecha,
    clicar fora não fecha, o erro fica na linha do desenho entre o corpo e o rodapé.

    Do desenho: "Data da falta" (com hoje já marcado), "Motivo" (obrigatório, menos no tipo "Esquecimento de Registro",
    pedido do dono de 16/11/2026) e "Atestado ou documento (opcional)".
    Ficam do sistema, nos componentes do desenho (P45): vários dias de uma vez (o calendário no lugar da data única), os
    45 tipos nos 6 grupos (`<optgroup>` com os rótulos do sistema: o desenho não tem o campo), o bloco do esquecimento,
    o abono parcial com horário e o anexo PDF, JPG ou PNG até 10 MB (o `accept` é o do servidor, não o `image/*` do
    protótipo). As recusas que só o servidor faz (dia futuro, batida já registrada) voltam no aviso do topo da página.

    Só a /ponto usa esta janela. A ficha do colaborador continua com _justificativa_calendario e _justificativa_campos.

    Recebe: tiposJustificativa (['Grupo' => ['Rótulo' => 'valor']], TipoJustificativa::asGroupedChoices),
    competenciaSelecionada, dataHoje (AAAA-MM-DD, do servidor) e abaAberta (a aba para onde a janela volta).
#}
<div class="pe-janela-fundo" id="ponto-janela-justificar" hidden>
    <form class="pe-janela" role="dialog" aria-modal="true" aria-label="{{ 'ponto_pendencias.justificativa.form.titulo'|trans }}" id="form-justificativa"
          method="post" action="{{ path('ponto_justificativa_nova') }}" enctype="multipart/form-data"
          data-janela-form="justificar" novalidate>
        <input type="hidden" name="justificativa_ponto[_token]" value="{{ csrf_token('justificativa_ponto') }}">
        <input type="hidden" name="competencia" value="{{ competenciaSelecionada }}">
        {# A aba aberta (o ponto-abas.js a acompanha): ao enviar, a tela volta nela (L768). #}
        <input type="hidden" name="aba" value="{{ abaAberta|default('pendencias') }}" data-aba-da-volta>
        <input type="hidden" name="justificativa_ponto[datas]" id="just-datas" data-just-datas>

        <div class="pe-janela-topo">
            <i class="bi bi-calendar-check" aria-hidden="true"></i><b class="pe-janela-titulo">{{ 'ponto_pendencias.justificativa.form.titulo'|trans }}</b>
            <button type="button" class="pe-janela-fechar" aria-label="{{ 'ponto_pendencias.justificativa.form.fechar'|trans }}" data-janela-fechar><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>

        <div class="pe-janela-corpo">
            <div class="pe-janela-rotulo" role="group" aria-labelledby="just-cal-rotulo">
                <span id="just-cal-rotulo">{{ 'ponto_pendencias.justificativa.form.data_falta'|trans }}</span>
                <div class="pe-cal" data-just-calendario data-hoje="{{ dataHoje }}">
                    <div class="pe-cal-barra">
                        <button type="button" class="pe-cal-seta" aria-label="{{ 'ponto_pendencias.justificativa.form.mes_anterior'|trans }}" data-cal-anterior><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                        <span class="pe-cal-mes" data-cal-mes aria-live="polite"></span>
                        <button type="button" class="pe-cal-seta" aria-label="{{ 'ponto_pendencias.justificativa.form.mes_seguinte'|trans }}" data-cal-seguinte><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                    <div class="pe-cal-grade" data-cal-grade></div>
                    <div class="pe-cal-escolhidos">{{ 'ponto_pendencias.justificativa.form.dias_selecionados'|trans }} <b data-cal-escolhidos>{{ 'ponto_pendencias.justificativa.form.nenhum'|trans }}</b></div>
                </div>
            </div>

            <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.tipo'|trans }}
                <select name="justificativa_ponto[tipo]" class="pe-janela-select" id="just-tipo" data-just-tipo>
                    <option value="">{{ 'ponto_pendencias.justificativa.form.selecione_tipo'|trans }}</option>
                    {% for grupo, tipos in tiposJustificativa %}
                        <optgroup label="{{ grupo }}">
                            {% for label, value in tipos %}
                                <option value="{{ value }}">{{ label }}</option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select>
            </label>

            <div class="pe-janela-aviso" data-just-nao-justificada hidden>
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>{{ 'ponto_pendencias.justificativa.form.nao_just_antes'|trans }} <strong>{{ 'ponto_pendencias.justificativa.form.nao_just_destaque'|trans }}</strong> {{ 'ponto_pendencias.justificativa.form.nao_just_depois'|trans }}
            </div>

            <div class="pe-janela-par" data-just-esquecido hidden>
                <span class="pe-janela-par-titulo">{{ 'ponto_pendencias.justificativa.form.esquecido'|trans }}</span>
                <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.tipo_batida'|trans }}
                    <select name="justificativa_ponto[tipoRegistroEsquecido]" class="pe-janela-select" data-just-esquecido-tipo>
                        <option value="">{{ 'ponto_pendencias.justificativa.form.selecione'|trans }}</option>
                        <option value="entrada">{{ 'ponto_pendencias.justificativa.batida_entrada'|trans }}</option>
                        <option value="repouso">{{ 'ponto_pendencias.justificativa.batida_repouso'|trans }}</option>
                        <option value="retorno">{{ 'ponto_pendencias.justificativa.batida_retorno'|trans }}</option>
                        <option value="saida">{{ 'ponto_pendencias.justificativa.batida_saida'|trans }}</option>
                    </select>
                </label>
                <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.horario'|trans }}
                    <input type="time" step="1" name="justificativa_ponto[horaRegistroEsquecido]" class="pe-janela-entrada" data-just-esquecido-hora>
                </label>
            </div>

            <label class="pe-janela-marca" data-just-abono>
                <input type="checkbox" name="justificativa_ponto[abonoParcial]" value="1" data-just-abono-marca>
                <span>{{ 'ponto_pendencias.justificativa.form.abono'|trans }}<span class="pe-janela-nota">{{ 'ponto_pendencias.justificativa.form.abono_nota'|trans }}</span></span>
            </label>

            <div class="pe-janela-par" data-just-abono-horario hidden>
                <span class="pe-janela-par-titulo">{{ 'ponto_pendencias.justificativa.form.periodo_parcial'|trans }}</span>
                <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.saida_atestado'|trans }}
                    <input type="time" name="justificativa_ponto[horaInicioAbono]" class="pe-janela-entrada" data-just-abono-inicio>
                </label>
                <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.retorno_atestado'|trans }}
                    <input type="time" name="justificativa_ponto[horaFimAbono]" class="pe-janela-entrada" data-just-abono-fim>
                </label>
            </div>

            <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.motivo'|trans }}
                <textarea name="justificativa_ponto[motivo]" rows="3" maxlength="{{ constant('App\\Ponto\\Form\\JustificativaPontoType::MOTIVO_MAXIMO') }}" class="pe-janela-campo" data-janela-motivo></textarea>
            </label>

            <label class="pe-janela-rotulo">{{ 'ponto_pendencias.justificativa.form.atestado'|trans }}
                <input type="file" name="justificativa_ponto[anexo]" accept=".pdf,.jpg,.jpeg,.png" class="pe-janela-arquivo" data-just-anexo>
                <span class="pe-janela-nota">{{ 'ponto_pendencias.justificativa.form.formatos'|trans }}</span>
            </label>
        </div>

        <div class="pe-janela-erro" data-janela-erro hidden></div>
        <div class="pe-janela-rodape">
            <button type="button" class="pe-janela-cancelar" data-janela-fechar>{{ 'ponto_pendencias.justificativa.cancelar'|trans }}</button>
            <button type="submit" class="pe-janela-acao" data-janela-enviar>{{ 'ponto_pendencias.justificativa.form.enviar'|trans }}</button>
        </div>
    </form>
</div>
