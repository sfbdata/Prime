{#
  Janela do alerta de horário do ponto eletrônico (a ida ao intervalo, a volta dele, o fim da jornada...). Incluída em
  base.html.twig, em TODA página, para quem tem o módulo ponto e jornada no escritório: não só na /ponto.

  E8: na moldura de janela do desenho 16 (L269 a L273: fundo azul escuro, janela de 480px, barra azul com o título e o
  "x", corpo e rodapé; o corpo é o da janela de alerta, L288, e o ícone do título é o dela, L766), no lugar do modal do
  Bootstrap. Mesmos textos e funções de antes: o "x" e o Esc (desenho L440) fecham e marcam o alerta do dia como visto;
  "Ir para o Ponto Eletrônico" leva à /ponto e também marca; clicar fora não fecha (antes, `data-bs-backdrop="static"`).
  O CSS vem junto (css/ponto-alerta-janela.css), porque a janela aparece onde o ponto-eletronico.css não carrega.

  Continua com o id `modalAlertaPonto`, o `data-perfil-sons` e a classe `show` enquanto aberta: o som do alerta
  (js/ponto-alerta-som.js) lê os dois e só toca com o aviso aberto. Os avisos globais que esperam um modal fechar
  (aviso de espaço, gênero, prêmio do Contribua, revisão do Meu Perfil) procuram também `#modalAlertaPonto.show`, e a
  janela dispara `hidden.bs.modal` ao fechar. Com a tela cheia do registro aberta (/ponto), a janela espera ela fechar.
#}
<link rel="stylesheet" href="{{ asset('css/ponto-alerta-janela.css') }}">

{#- "Sons de alerta" do Meu Perfil (perfil_sons()): com "0" o som do alerta (ida ao intervalo, volta dele e fim da jornada) não toca. #}
<div class="pe-alerta-ponto pe-janela-fundo" id="modalAlertaPonto" data-perfil-sons="{{ perfil_sons() ? '1' : '0' }}" hidden>
    <div class="pe-janela" role="dialog" aria-modal="true" aria-labelledby="modalAlertaPontoLabel" tabindex="-1" data-alerta-ponto-janela>
        <div class="pe-janela-topo">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i><b class="pe-janela-titulo" id="modalAlertaPontoLabel">Registro de Ponto</b>
            <button type="button" class="pe-janela-fechar" aria-label="Fechar aviso" data-alerta-ponto-fechar><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="pe-alerta-ponto-corpo">
            <p id="alertaPontoMensagem"></p>
            <p class="pe-alerta-ponto-nota" id="alertaPontoHorario"></p>
        </div>
        <div class="pe-janela-rodape">
            <a href="{{ path('ponto_index') }}" class="pe-janela-acao" id="btnIrParaPonto">Ir para o Ponto Eletrônico</a>
        </div>
    </div>
</div>

<script src="{{ asset('js/ponto-alerta-som.js') }}" defer></script>
<script nonce="{{ csp_nonce() }}">
(function () {
    'use strict';

    var POLLING_INTERVALO_MS  = 60000;
    var ENDPOINT              = '{{ path('ponto_alerta_horario') }}';
    var STORAGE_PREFIX        = 'alerta_ponto_';
    var modalEl               = document.getElementById('modalAlertaPonto');
    var janelaEl              = modalEl ? modalEl.querySelector('[data-alerta-ponto-janela]') : null;
    var focoAntes             = null;
    var tituloOriginal        = document.title;
    var intervaloPiscarTitulo = null;
    var piscarAtivo           = false;

    // ── Storage ──────────────────────────────────────────────────────────────

    function getChaveStorage(tipo) {
        var hoje = new Date();
        var data = hoje.getFullYear()
            + '-' + String(hoje.getMonth() + 1).padStart(2, '0')
            + '-' + String(hoje.getDate()).padStart(2, '0');
        return STORAGE_PREFIX + data + '_' + tipo;
    }

    function jaFoiDispensado(tipo) {
        try {
            return localStorage.getItem(getChaveStorage(tipo)) === '1';
        } catch (e) {
            return false;
        }
    }

    function marcarComoDispensado(tipo) {
        try {
            localStorage.setItem(getChaveStorage(tipo), '1');
            limparChavesAntigas();
        } catch (e) {}
    }

    function limparChavesAntigas() {
        try {
            var limite = new Date();
            limite.setDate(limite.getDate() - 2);
            var prefixoLimite = STORAGE_PREFIX + limite.getFullYear()
                + '-' + String(limite.getMonth() + 1).padStart(2, '0')
                + '-' + String(limite.getDate()).padStart(2, '0');
            Object.keys(localStorage).forEach(function (chave) {
                if (chave.startsWith(STORAGE_PREFIX) && chave < prefixoLimite) {
                    localStorage.removeItem(chave);
                }
            });
        } catch (e) {}
    }

    // ── Título piscando (fallback para abas sem foco) ─────────────────────────

    function iniciarPiscarTitulo(mensagem) {
        if (piscarAtivo) return;
        piscarAtivo = true;
        var alternado = false;
        intervaloPiscarTitulo = setInterval(function () {
            document.title = alternado ? tituloOriginal : '🔔 ' + mensagem;
            alternado = !alternado;
        }, 1000);
    }

    function pararPiscarTitulo() {
        piscarAtivo = false;
        clearInterval(intervaloPiscarTitulo);
        intervaloPiscarTitulo = null;
        document.title = tituloOriginal;
    }

    // ── Janela (moldura do desenho, sem o modal do Bootstrap) ─────────────────
    // A classe `show` acompanha a janela aberta: o som do alerta (ponto-alerta-som.js) só toca com ela.

    function janelaAberta() {
        return !!modalEl && !modalEl.hidden;
    }

    // A tela cheia do registro (/ponto, js/ponto-tela-cheia.js) aberta: a janela não abre por cima dela.
    function telaCheiaAberta() {
        var tela = window.PontoTelaCheia;
        return !!tela && typeof tela.fase === 'function' && typeof tela.quandoFechar === 'function' && tela.fase() !== '';
    }

    function abrirJanela() {
        if (!modalEl) return;
        if (telaCheiaAberta()) {
            window.PontoTelaCheia.quandoFechar(abrirJanela);
            return;
        }
        if (!janelaAberta()) {
            focoAntes = document.activeElement;
        }
        modalEl.hidden = false;
        modalEl.classList.add('show');
        if (janelaEl) janelaEl.focus();
    }

    // O "x" e o Esc: para de piscar e marca o alerta do dia como visto (como o `hidden.bs.modal` de antes). O evento
    // `hidden.bs.modal` (com bolha) solta quem esperava a janela fechar para abrir o próprio aviso.
    function fecharJanela() {
        if (!janelaAberta()) return;
        modalEl.hidden = true;
        modalEl.classList.remove('show');
        pararPiscarTitulo();
        if (modalEl._tipoAtual) {
            marcarComoDispensado(modalEl._tipoAtual);
        }
        if (focoAntes && document.contains(focoAntes) && typeof focoAntes.focus === 'function') {
            focoAntes.focus();
        }
        focoAntes = null;
        modalEl.dispatchEvent(new Event('hidden.bs.modal', { bubbles: true }));
    }

    // O foco não sai da janela com Tab (aria-modal), nem quando outro aviso tomou o foco por baixo dela.
    function prenderFoco(evento) {
        var focaveis = Array.prototype.slice.call(modalEl.querySelectorAll('a[href], button:not([disabled])'));
        if (focaveis.length === 0) return;
        var primeiro = focaveis[0];
        var ultimo   = focaveis[focaveis.length - 1];
        var ativo    = document.activeElement;
        if (!modalEl.contains(ativo) || ativo === janelaEl) {
            evento.preventDefault();
            (evento.shiftKey ? ultimo : primeiro).focus();
        } else if (evento.shiftKey && ativo === primeiro) {
            evento.preventDefault();
            ultimo.focus();
        } else if (!evento.shiftKey && ativo === ultimo) {
            evento.preventDefault();
            primeiro.focus();
        }
    }

    if (modalEl) {
        modalEl.addEventListener('click', function (evento) {
            if (evento.target.closest('[data-alerta-ponto-fechar]')) {
                fecharJanela();
            }
        });

        // "Ir para o Ponto Eletrônico": marca o alerta do dia como visto e segue o link.
        var btnIr = document.getElementById('btnIrParaPonto');
        if (btnIr) {
            btnIr.addEventListener('click', function () {
                if (modalEl._tipoAtual) {
                    marcarComoDispensado(modalEl._tipoAtual);
                }
                pararPiscarTitulo();
            });
        }

        // Com a janela aberta, o Esc fecha só ela, como o "x" (desenho L440), e o Tab fica nela. Na captura, antes dos
        // outros atalhos da página: o Esc não chega ao que está por baixo (as janelas da /ponto fecham no Esc).
        document.addEventListener('keydown', function (evento) {
            if (!janelaAberta()) return;
            if (evento.key === 'Escape') {
                evento.stopPropagation();
                fecharJanela();
            } else if (evento.key === 'Tab') {
                evento.stopPropagation();
                prenderFoco(evento);
            }
        }, true);

        // Um modal do Bootstrap aberto por baixo puxa de volta o foco que sai dele (focusin no document): o foco
        // dentro desta janela não chega lá.
        modalEl.addEventListener('focusin', function (evento) {
            evento.stopPropagation();
        });
    }

    // ── Web Notifications API ─────────────────────────────────────────────────

    function solicitarPermissaoNotificacao(callback) {
        if (!('Notification' in window)) {
            callback(false);
            return;
        }
        if (Notification.permission === 'granted') {
            callback(true);
            return;
        }
        if (Notification.permission === 'denied') {
            callback(false);
            return;
        }
        Notification.requestPermission().then(function (permissao) {
            callback(permissao === 'granted');
        });
    }

    function dispararNotificacaoNativa(dados) {
        solicitarPermissaoNotificacao(function (permitido) {
            if (!permitido) return;
            var notif = new Notification('Registro de Ponto', {
                // Retorno e saída chegam sem horário configurado: sem ele, a linha "Horário:" sairia vazia.
                body:    dados.mensagem + (dados.horario ? '\nHorário: ' + dados.horario : ''),
                icon:    '/icons/icon-192x192.png',
                // Com o tipo na tag: retorno e saída chegam sem horário e, com a mesma tag, um substituía o outro.
                tag:     'alerta-ponto-' + dados.tipo + '-' + (dados.horario || ''),
                requireInteraction: true
            });
            notif.addEventListener('click', function () {
                window.focus();
                notif.close();
                abrirJanela();
            });
        });
    }

    // ── Exibição principal ────────────────────────────────────────────────────

    // O alerta que chega com a tela cheia do registro aberta espera ela fechar (o som, a notificação e a janela); um só
    // fica esperando, o mais novo.
    var alertaEmEspera = null;

    function exibirAlerta(dados) {
        if (!modalEl) return;
        if (jaFoiDispensado(dados.tipo)) return;
        if (telaCheiaAberta()) {
            var pedir = alertaEmEspera === null;
            alertaEmEspera = dados;
            if (pedir) {
                window.PontoTelaCheia.quandoFechar(function () {
                    var esperando = alertaEmEspera;
                    alertaEmEspera = null;
                    if (esperando) exibirAlerta(esperando);
                });
            }
            return;
        }

        var elMensagem = document.getElementById('alertaPontoMensagem');
        var elHorario  = document.getElementById('alertaPontoHorario');
        if (elMensagem) elMensagem.textContent = dados.mensagem;
        if (elHorario) {
            elHorario.textContent = dados.horario ? 'Horário configurado: ' + dados.horario : '';
        }

        modalEl._tipoAtual = dados.tipo;

        // Notificação nativa (pisca ícone na barra de tarefas do SO)
        dispararNotificacaoNativa(dados);

        // Título piscando como fallback (funciona sem permissão)
        iniciarPiscarTitulo(dados.mensagem);

        // Som da ida ao intervalo, da volta dele e do fim da jornada (ponto-alerta-som.js): só "repouso",
        // "retorno" e "saida", cada um com seu toque; respeita "Sons de alerta" do Meu Perfil e, bloqueado pelo navegador, fica só a janela.
        if (window.BJSomDoAlertaDePonto) {
            window.BJSomDoAlertaDePonto.tocar(dados.tipo, modalEl);
        }

        // Para de piscar se o usuário voltar para a aba
        document.addEventListener('visibilitychange', function pararAoFocar() {
            if (!document.hidden) {
                pararPiscarTitulo();
                document.removeEventListener('visibilitychange', pararAoFocar);
            }
        });

        abrirJanela();
    }

    // ── Polling ───────────────────────────────────────────────────────────────

    // Pede JSON (com a sessão vencida, o servidor responde 401 e o pedido não vira destino do login) e para de
    // sondar no 401.
    var intervaloPolling = null;

    function verificarAlerta() {
        fetch(ENDPOINT, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
            .then(function (r) {
                if (r.status === 401 && intervaloPolling !== null) {
                    clearInterval(intervaloPolling);
                    intervaloPolling = null;
                }
                if (!r.ok) return null;
                return r.json();
            })
            .then(function (dados) {
                if (dados && dados.alertar === true) {
                    exibirAlerta(dados);
                }
            })
            .catch(function (e) {
                console.debug('Alerta ponto:', e);
            });
    }

    document.addEventListener('DOMContentLoaded', function () {
        verificarAlerta();
        intervaloPolling = setInterval(verificarAlerta, POLLING_INTERVALO_MS);
    });
}());
</script>
