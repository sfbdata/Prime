{#
    Seção "Feriados do escritório" da aba Configurações (desenho 16, L256 a L258; spec ponto-desenho-0811.md, E6: P71
    com o desvio da E6, P72, D4 e D21). Só para quem gere as configurações do escritório (GestaoDoPonto::FERIADOS).
    Comportamento em js/ponto-configuracoes-sedes.js.

    - Abrangência: "Todas as sedes" e as lotações do escritório (desvio do P71: o feriado vale para quem tem aquela
      lotação; o desenho casa a sede com a lotação da pessoa).
    - "Repete todo ano" (P72, sistema, fica), marcada como na página "Feriados e Folgas".
    - Sem data ou nome: aviso do desenho. Remover pede confirmação (D4; o desenho remove na hora).

    Recebe `lotacoesDoPonto` (list<Lotacao>) e `feriadosDoPonto` (list<FeriadoDoPontoOutput>).
#}
{{ catalogo_js('ponto_config.js') }}
<section class="pe-sf-secao" aria-labelledby="ponto-feriados-titulo" data-pc-feriados>
    <b class="pe-fer-titulo" id="ponto-feriados-titulo">{{ 'ponto_config.feriados.titulo'|trans }}</b>
    <div class="pe-fer-texto">{{ 'ponto_config.feriados.texto'|trans }}</div>
    <form class="pe-fer-form" method="post" action="{{ path('ponto_configuracoes_feriado_criar') }}" data-pc-feriado-form novalidate>
        <label class="pe-fer-rotulo">{{ 'ponto_config.feriados.data'|trans }}<input class="pe-sf-campo" type="date" name="data"></label>
        <label class="pe-fer-rotulo">{{ 'ponto_config.feriados.nome'|trans }}<input class="pe-sf-campo" name="nome" maxlength="255" autocomplete="off"></label>
        <label class="pe-fer-rotulo">{{ 'ponto_config.feriados.abrangencia'|trans }}<select class="pe-sf-campo" name="abrangencia">
            <option value="">{{ 'ponto_config.feriados.todas_sedes'|trans }}</option>
            {% for lotacao in lotacoesDoPonto %}
                <option value="{{ lotacao.id }}">{{ lotacao.nome }}</option>
            {% endfor %}
        </select></label>
        <label class="pe-fer-repete"><input type="checkbox" name="recorrente" value="1" checked>{{ 'ponto_config.feriados.repete'|trans }}</label>
        <button type="submit" class="pe-fer-adicionar">{{ 'ponto_config.feriados.adicionar'|trans }}</button>
    </form>
    <div class="pe-fer-lista" data-pc-feriados-lista>
        {{ include('ponto/_config_feriados_lista.html.twig') }}
    </div>

    <div class="pe-janela-fundo" id="ponto-janela-remover-feriado" hidden data-pc-sf-janela>
        <div class="pe-janela" role="dialog" aria-modal="true" aria-label="{{ 'ponto_config.feriados.remover_titulo'|trans }}">
            <div class="pe-janela-topo">
                <i class="bi bi-calendar-x" aria-hidden="true"></i><b class="pe-janela-titulo">{{ 'ponto_config.feriados.remover_titulo'|trans }}</b>
                <button type="button" class="pe-janela-fechar" aria-label="{{ 'ponto_config.feriados.fechar'|trans }}" data-pc-sf-fechar><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="pe-janela-corpo">
                <div class="pe-janela-info" data-pc-sf-info></div>
                <div class="pe-janela-texto">{{ 'ponto_config.feriados.remover_texto'|trans }}</div>
            </div>
            <div class="pe-janela-erro" data-pc-sf-erro hidden></div>
            <div class="pe-janela-rodape">
                <button type="button" class="pe-janela-cancelar" data-pc-sf-fechar>{{ 'ponto_config.feriados.cancelar'|trans }}</button>
                <button type="button" class="pe-janela-acao" data-pc-sf-confirmar="feriado">{{ 'ponto_config.feriados.remover'|trans }}</button>
            </div>
        </div>
    </div>
</section>
