{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.titulo'|trans }}{% endblock %}

{# `db-body` no <body>: pinta o fundo da página do desenho (degradê do topo)
   sem sangria de margem negativa — mesmo gancho que a tela da pasta usa. #}
{% block body_class %}db-body{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
{# Visual aprovado do Dashboard — desenho em docs/design/ (01 - Dashboard 1.2.2.dc.html).
   Tudo escopado em .db-page/.db-body; o estilo não vem mais inline daqui. #}
<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{# Painel BlueJus Intelligence (botão no cabeçalho + painel lateral), escopado em .db-page. #}
<link rel="stylesheet" href="{{ asset('css/dashboard-inteligencia.css') }}">
<link rel="stylesheet" href="{{ asset('css/dashboard-perfil-pessoa.css') }}">
{# Janelas flutuantes (DASH-020): moram no <body>, fora da região que o XHR troca. #}
<link rel="stylesheet" href="{{ asset('css/dashboard-janelas.css') }}">
{# "Zerar" das colunas (DASH-014): menu do botão direito, confirmação, aviso e toast do desenho. #}
<link rel="stylesheet" href="{{ asset('css/dashboard-zerar.css') }}">
<link rel="stylesheet" href="{{ asset('css/dashboard-relatorio.css') }}">
{# Meta de pastas do mês (DASH-016): barra no card Pastas criadas, editor e menu do botão direito. #}
<link rel="stylesheet" href="{{ asset('css/dashboard-meta.css') }}">
{% endblock %}

{% block body %}
{# Estilo pessoal do menu ⋮ (PreferenciasDoDashboardOutput, do usuário LOGADO neste escritório):
   as classes saem do servidor já no HTML, para a página abrir no estilo da pessoa sem piscar. O
   `.db-page` fica FORA da região que o XHR troca, então as classes sobrevivem a cada filtro. O
   dashboard-preferencias.js lê o estado de `data-preferencias` e grava pelo endpoint.
   `data-ia-avancado-escolhido`: o usuário já gravou o Modo avançado? Se não, ligar pede a
   confirmação "Ativar Modo Avançado?" (só na primeira vez).
   `data-perfil-sons`: "Sons de alerta" do Meu Perfil (perfil_sons()); com "0" o calendário do
   dashboard-filtros.js fica mudo, mesmo com `dashboard.sons` ligado. #}
{# Rótulo de cada coluna que aceita "Zerar" (DASH-014), para o menu do botão direito: as fixas e as
   métricas extras do catálogo. Montado fora da tag porque a seta de função do Twig quebraria o atributo. #}
{% set zerarRotulos = {
    metas: 'dashboard.tabela.total_metas'|trans, metas_ativas: 'dashboard.tabela.metas_ativas'|trans,
    metas_vencidas: 'dashboard.tabela.metas_vencidas'|trans, prazos: 'dashboard.tabela.prazos_proximos'|trans,
    demandas: 'dashboard.tabela.total_demandas'|trans, demandas_ativas: 'dashboard.tabela.demandas_ativas'|trans,
    pastas_criadas: 'dashboard.tabela.pastas_criadas'|trans,
}|merge(constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::CATALOGO')|map(c => c.rotulo)) %}
<section class="db-page{{ preferencias.classesCss() != '' ? ' ' ~ preferencias.classesCss() : '' }}"
         data-perfil-sons="{{ perfil_sons() ? '1' : '0' }}"
         data-preferencias="{{ preferencias.paraArray()|json_encode|e('html_attr') }}"
         data-preferencias-endpoint="{{ path('dashboard_preferencias_salvar') }}"
         data-ia-avancado-escolhido="{{ preferencias.iaAvancadoEscolhido ? 'sim' : 'nao' }}"
         data-db-zerar-pode="{{ podeZerar ? '1' : '0' }}"
         data-db-zerar-rotulos="{{ zerarRotulos|json_encode|e('html_attr') }}"
         data-db-zerar-url="{{ path('dashboard_zerar') }}"
         data-db-zerar-desfazer-url="{{ path('dashboard_zerar_desfazer') }}"
         data-db-zerar-pedir-url="{{ path('dashboard_zerar_pedir') }}"
         data-db-meta-pode="{{ podeMeta ? '1' : '0' }}"
         data-db-meta-url="{{ path('dashboard_meta_pastas_definir') }}"
         data-db-meta-remover-url="{{ path('dashboard_meta_pastas_remover') }}">
    {% set respOpcoes = [] %}
    {% for u in responsaveis %}
        {% set respOpcoes = respOpcoes|merge([{ valor: u.id, label: u.nome }]) %}
    {% endfor %}
    {% set cargoOpcoes = [] %}
    {% for c in cargos %}
        {% set cargoOpcoes = cargoOpcoes|merge([{ valor: c, label: c }]) %}
    {% endfor %}
    {# "Sem cargo" por último, como no desenho, e só quando há colaborador ativo sem cargo
       (o controller decide em `existeSemCargo`). O valor é a constante do UseCase. #}
    {% if existeSemCargo|default(false) %}
        {% set cargoOpcoes = cargoOpcoes|merge([{ valor: cargoSemValor, label: 'dashboard.sem_cargo'|trans }]) %}
    {% endif %}

    {# Cabeçalho do PDF (só na impressão): período e filtros do momento. O servidor
       escreve o estado da carga; o dashboard.js reescreve no `beforeprint`, porque os
       filtros mudam por XHR sem recarregar a casca. #}
    {% set fmtDe  = filtros.data_de|default('') %}
    {% set fmtAte = filtros.data_ate|default('') %}
    {% set respNome = 'dashboard.filtros.todos_responsaveis'|trans %}
    {% for o in respOpcoes %}
        {% if (o.valor ~ '') == filtros.responsavel|default('') %}{% set respNome = o.label %}{% endif %}
    {% endfor %}
    {% set cargoNome = filtros.cargo|default('') == '' ? 'dashboard.filtros.todos_cargos'|trans
        : (filtros.cargo == cargoSemValor|default('') ? 'dashboard.sem_cargo'|trans : filtros.cargo) %}

    {# Ordem do desenho: título → filtros → cards → tabela. O título fica DENTRO do
       root para dividir a primeira linha do flex com o "Atualizado às", que mora no
       fragmento (renova a cada XHR); a posição de cada bloco é dada por `order` no CSS.
       `data-ft-rotulo-limpar`: opção do filtro-tabela.js para o texto do botão (desenho). #}
    <div data-filtro-root data-filtro-endpoint="{{ path('dashboard_index') }}" data-ft-rotulo-limpar="{{ 'dashboard.filtros.limpar'|trans }}">
        <div class="db-print-cabecalho">
            <div class="db-print-cabecalho-esq">
                <div class="db-print-marca">{{ 'dashboard.impressao.marca'|trans }}</div>
                <div class="db-print-titulo">{{ 'dashboard.impressao.titulo'|trans }}</div>
                <div class="db-print-filtros">{{ 'dashboard.impressao.periodo'|trans }} <span class="db-print-periodo">{{ 'dashboard.impressao.intervalo'|trans({de: fmtDe != '' ? fmtDe|split('-')|reverse|join('/') : 'dashboard.impressao.inicio'|trans, ate: fmtAte != '' ? fmtAte|split('-')|reverse|join('/') : 'dashboard.impressao.hoje'|trans}) }}</span> · <span class="db-print-facetas">{{ respNome }} · {{ cargoNome }}{{ filtros.busca|default('')|trim != '' ? ' · ' ~ 'dashboard.impressao.busca'|trans({termo: filtros.busca|trim}) : '' }}</span></div>
            </div>
            <div class="db-print-gerado">{{ 'dashboard.impressao.gerado_em'|trans }} <span class="db-print-quando">{{ 'dashboard.impressao.data_as_hora'|trans({data: 'now'|data, hora: 'now'|hora}) }}</span><br>{{ 'dashboard.impressao.por'|trans({nome: app.user.fullName}) }}</div>
        </div>

        {# O texto vive num <span>: a revelação (clip-path) e o brilho ficam nele, e o
           símbolo que rola por cima pode sair da caixa do texto sem ser cortado. #}
        <h1 class="db-titulo"><span class="db-titulo-texto">{{ 'dashboard.titulo'|trans }}</span><img class="db-titulo-simbolo" src="{{ asset('images/logo/bluejus_simbolo.svg') }}" alt="" aria-hidden="true"></h1>

        <div class="db-filtro-wrap">
        {# Segmentado de período (Este mês · 60 dias · 90 dias · Este ano). Preenche os
           campos data_de/data_ate do parcial (.js-filtro-campo) com datas reais e dispara
           `change`; o filtro-tabela.js recarrega como se o usuário tivesse digitado.
           As quatro faixas são calculadas AQUI (servidor) e vão em data-de/data-ate: o
           dashboard.js só lê os atributos. Ativo = as duas datas batem com os campos.
           Período padrão (decisão do dono, spec dashboard-parte-1): sem datas na URL, o
           controller abre em Este mês; "Limpar filtros" volta para ele (dashboard.js).
           Faixas do desenho VS 25.10.26 (L1707, L3118-3121): Este mês vai do dia 1º ao
           ÚLTIMO dia do mês (o mesmo PeriodoDoDashboard::esteMes do controller); 60 e 90
           dias contam hoje incluído (hoje − 59 e hoje − 89 até hoje); Este ano, 1º/jan até hoje. #}
        {% set hoje = 'now'|date('Y-m-d') %}
        {% set periodos = [
            { chave: 'mes', rotulo: 'dashboard.periodo.este_mes'|trans, de: 'now'|date('Y-m-01'), ate: 'last day of this month'|date('Y-m-d') },
            { chave: 'd60', rotulo: 'dashboard.periodo.d60'|trans,  de: '-59 days'|date('Y-m-d'), ate: hoje },
            { chave: 'd90', rotulo: 'dashboard.periodo.d90'|trans,  de: '-89 days'|date('Y-m-d'), ate: hoje },
            { chave: 'ano', rotulo: 'dashboard.periodo.este_ano'|trans, de: 'now'|date('Y-01-01'), ate: hoje },
        ] %}
        <div class="db-seg db-seg--sem-js" role="group" aria-label="{{ 'dashboard.periodo.rotulo'|trans }}">
            <span class="db-seg-ind" aria-hidden="true"></span>
            {% for p in periodos %}
                {% set ativo = filtros.data_de|default('') == p.de and filtros.data_ate|default('') == p.ate %}
                <button type="button" class="db-seg-btn{{ ativo ? ' is-ativo' : '' }}"
                        data-periodo="{{ p.chave }}" data-de="{{ p.de }}" data-ate="{{ p.ate }}"
                        aria-pressed="{{ ativo ? 'true' : 'false' }}">{{ p.rotulo }}</button>
            {% endfor %}
        </div>
        {# A busca de colaborador mora no cabeçalho da tabela (desenho), mas o campo que o
           filtro-tabela.js lê (FormData, chip "Busca", "Limpar filtros") tem de estar DENTRO
           do form: ele é renderizado aqui e escondido pelo CSS; o campo visível no cabeçalho
           (.db-busca, no fragmento) só espelha o valor para ele — ver dashboard.js. #}
        {{ include('_partials/_filtro_barra.html.twig', {
            mostrar_busca: true,
            busca_placeholder: 'dashboard.filtros.buscar_colaborador'|trans,
            filtros: filtros,
            facetas: [
                { name: 'data_de', rotulo: 'dashboard.filtros.de'|trans, tipo: 'date' },
                { name: 'data_ate', rotulo: 'dashboard.filtros.ate'|trans, tipo: 'date' },
                { name: 'responsavel', rotulo: 'dashboard.filtros.responsavel'|trans, tipo: 'select', opcoes: respOpcoes },
                { name: 'cargo', rotulo: 'dashboard.filtros.cargo'|trans, tipo: 'select', opcoes: cargoOpcoes }
            ]
        }) }}

        {# Controles próprios do desenho (F13/F14): calendário De/Até e selects de Responsável
           (foto ou iniciais + cargo) e Cargo (ícone + "N pessoas"). Eles NÃO são campos do
           form: cada escolha é escrita no controle nativo do parcial acima (mesmo `name`) e
           dispara `change` — o filtro-tabela.js segue lendo só o form. Sem JS, este bloco
           fica escondido (`db-fp--sem-js`) e os nativos continuam visíveis e utilizáveis;
           com JS, o dashboard-filtros.js troca os papéis (os nativos saem da vista e do Tab). #}
        {% set respSel = filtros.responsavel|default('') %}
        {% set cargoSel = filtros.cargo|default('') %}
        {% set nPessoas = responsaveis|length %}
        <div class="db-fp db-fp--sem-js" data-db-filtros>
            <div class="db-fp-datas">
                {% for cal in [
                    { name: 'data_de', rotulo: 'dashboard.filtros.de'|trans, aria: 'dashboard.filtros.data_inicial'|trans },
                    { name: 'data_ate', rotulo: 'dashboard.filtros.ate'|trans, aria: 'dashboard.filtros.data_final'|trans },
                ] %}
                    {% set valor = filtros[cal.name]|default('') %}
                    {% if not loop.first %}<span class="db-fp-ate" aria-hidden="true">{{ 'dashboard.filtros.ate_separador'|trans }}</span>{% endif %}
                    <div class="db-cal" data-db-cal="{{ cal.name }}">
                        <button type="button" class="db-cal-btn{{ valor == '' ? ' is-vazio' : '' }}"
                                aria-haspopup="dialog" aria-expanded="false"
                                aria-controls="db-cal-{{ cal.name }}-painel"
                                aria-label="{{ cal.aria }}: {{ valor != '' ? valor|split('-')|reverse|join('/') : 'dashboard.filtros.sem_data'|trans }}">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <span class="db-cal-rotulo">{{ valor != '' ? valor|split('-')|reverse|join('/') : 'dashboard.filtros.dd_mm_aaaa'|trans }}</span>
                        </button>
                        <div class="db-cal-painel" id="db-cal-{{ cal.name }}-painel" role="dialog"
                             aria-modal="false" aria-label="{{ 'dashboard.filtros.escolher'|trans({campo: cal.aria|lower}) }}" hidden></div>
                    </div>
                {% endfor %}
            </div>

            <span class="db-fp-div" aria-hidden="true"></span>

            {# Responsável — "Todos" + cada colaborador ativo do escritório (as mesmas opções
               do <select> nativo). Avatar: foto quando existe, senão o boneco (bi-person-fill) num
               dos 6 tons pastel do dc 1.2.2 (AV_TONS, índice (id - 1) % 6), não o degradê da tabela. #}
            {% set respAtual = { nome: 'dashboard.filtros.todos_responsaveis'|trans, foto: null, iniciais: '', av: null } %}
            {% set respItens = [] %}
            {% for u in responsaveis %}
                {% set partes = u.nome|split(' ')|filter(p => p != '') %}
                {% set item = {
                    valor: u.id ~ '',
                    nome: u.nome,
                    sub: u.cargo is not empty ? u.cargo : 'dashboard.sem_cargo'|trans,
                    foto: u.foto,
                    iniciais: partes|slice(0, 2)|map(p => p|slice(0, 1))|join|upper,
                    av: (u.id - 1) % 6,
                } %}
                {% set respItens = respItens|merge([item]) %}
                {% if item.valor == respSel %}{% set respAtual = item %}{% endif %}
            {% endfor %}
            <div class="db-dd db-dd--resp" data-db-dd="responsavel" data-db-dd-busca>
                <button type="button" class="db-dd-btn" aria-haspopup="listbox" aria-expanded="false"
                        aria-controls="db-dd-responsavel-lista" aria-label="{{ 'dashboard.filtros.responsavel'|trans }}: {{ respAtual.nome }}">
                    <span class="db-dd-av db-dd-av--btn">
                        {% if respAtual.av is null %}
                            <span class="db-dd-av-ico db-dd-tom--todos"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                        {% elseif respAtual.foto %}
                            <img class="db-dd-av-foto" src="{{ path('app_profile_foto_serve', {nome: respAtual.foto}) }}" alt=""
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                            <span class="db-dd-av-ini db-dd-tom--p{{ respAtual.av }}" style="display:none"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                        {% else %}
                            <span class="db-dd-av-ini db-dd-tom--p{{ respAtual.av }}"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                        {% endif %}
                    </span>
                    <span class="db-dd-btn-nome">{{ respAtual.nome }}</span>
                    <i class="bi bi-chevron-down db-dd-chev" aria-hidden="true"></i>
                </button>
                <div class="db-dd-painel" hidden>
                    <div class="db-dd-busca">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="text" class="db-dd-busca-input" placeholder="{{ 'dashboard.filtros.buscar_pessoa'|trans }}" aria-label="{{ 'dashboard.filtros.buscar_pessoa'|trans }}"
                               autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="true"
                               aria-controls="db-dd-responsavel-lista">
                    </div>
                    <div class="db-dd-lista" id="db-dd-responsavel-lista" role="listbox" aria-label="{{ 'dashboard.filtros.responsavel'|trans }}" tabindex="-1">
                        <div class="db-dd-op" role="option" id="db-dd-responsavel-op-todos" data-valor=""
                             data-nome="{{ 'dashboard.filtros.todos_responsaveis'|trans }}" aria-selected="{{ respSel == '' ? 'true' : 'false' }}">
                            <span class="db-dd-av"><span class="db-dd-av-ico db-dd-tom--todos"><i class="bi bi-people-fill" aria-hidden="true"></i></span></span>
                            <span class="db-dd-op-txt">
                                <span class="db-dd-op-nome">{{ 'dashboard.filtros.todos_responsaveis'|trans }}</span>
                                <span class="db-dd-op-sub">{{ nPessoas }} {{ nPessoas == 1 ? 'dashboard.filtros.pessoa'|trans : 'dashboard.filtros.pessoas'|trans }}</span>
                            </span>
                            <i class="bi bi-check2 db-dd-check" aria-hidden="true"></i>
                        </div>
                        {% for it in respItens %}
                            <div class="db-dd-op" role="option" id="db-dd-responsavel-op-{{ it.valor }}" data-valor="{{ it.valor }}"
                                 data-nome="{{ it.nome }}" aria-selected="{{ it.valor == respSel ? 'true' : 'false' }}">
                                <span class="db-dd-av db-dd-av--pessoa">
                                    {% if it.foto %}
                                        <img class="db-dd-av-foto" src="{{ path('app_profile_foto_serve', {nome: it.foto}) }}" alt="" loading="lazy"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                                        <span class="db-dd-av-ini db-dd-tom--p{{ it.av }}" style="display:none"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                                    {% else %}
                                        <span class="db-dd-av-ini db-dd-tom--p{{ it.av }}"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                                    {% endif %}
                                </span>
                                <span class="db-dd-op-txt">
                                    <span class="db-dd-op-nome">{{ it.nome }}</span>
                                    <span class="db-dd-op-sub{{ it.sub == 'dashboard.sem_cargo'|trans ? ' is-sem-cargo' : '' }}">{{ it.sub }}</span>
                                </span>
                                <i class="bi bi-check2 db-dd-check" aria-hidden="true"></i>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="db-dd-vazio" hidden>{{ 'dashboard.filtros.nenhum_resultado'|trans }}</div>
                </div>
            </div>

            {# Cargo — "Todos" + cada cargo com a quantidade de colaboradores ativos (contagem
               do controller) e "Sem cargo" por último, só quando existe (mesma regra do nativo).
               Ícone pelo nome do cargo (mapa visual do desenho; o nome é livre no sistema). #}
            {% set cargoItens = [] %}
            {% for c in cargos %}
                {% set cl = c|lower %}
                {% set n = contagemCargo[c]|default(0) %}
                {% set cargoItens = cargoItens|merge([{
                    valor: c,
                    nome: c,
                    sub: n ~ ' ' ~ (n == 1 ? 'dashboard.filtros.pessoa'|trans : 'dashboard.filtros.pessoas'|trans),
                    icone: ('sóci' in cl or 'soci' in cl) ? 'bi-award'
                        : ('advog' in cl) ? 'bi-briefcase'
                        : ('estagi' in cl) ? 'bi-mortarboard'
                        : ('paraleg' in cl) ? 'bi-journal-text'
                        : ('financ' in cl) ? 'bi-cash-coin'
                        : 'bi-person-badge',
                    tom: 'cargo',
                }]) %}
            {% endfor %}
            {% if existeSemCargo|default(false) %}
                {% set n = contagemSemCargo|default(0) %}
                {% set cargoItens = cargoItens|merge([{
                    valor: cargoSemValor, nome: 'dashboard.sem_cargo'|trans,
                    sub: n ~ ' ' ~ (n == 1 ? 'dashboard.filtros.pessoa'|trans : 'dashboard.filtros.pessoas'|trans),
                    icone: 'bi-dash-circle', tom: 'sem',
                }]) %}
            {% endif %}
            {% set cargoAtual = { nome: 'dashboard.filtros.todos_cargos'|trans, icone: 'bi-grid-fill', tom: 'todos' } %}
            {% for it in cargoItens %}
                {% if it.valor == cargoSel %}{% set cargoAtual = it %}{% endif %}
            {% endfor %}
            <div class="db-dd db-dd--cargo" data-db-dd="cargo">
                <button type="button" class="db-dd-btn" aria-haspopup="listbox" aria-expanded="false"
                        aria-controls="db-dd-cargo-lista" aria-label="{{ 'dashboard.filtros.cargo'|trans }}: {{ cargoAtual.nome }}">
                    <span class="db-dd-av db-dd-av--btn">
                        <span class="db-dd-av-ico db-dd-tom--{{ cargoAtual.tom }}"><i class="bi {{ cargoAtual.icone }}" aria-hidden="true"></i></span>
                    </span>
                    <span class="db-dd-btn-nome">{{ cargoAtual.nome }}</span>
                    <i class="bi bi-chevron-down db-dd-chev" aria-hidden="true"></i>
                </button>
                <div class="db-dd-painel" hidden>
                    <div class="db-dd-lista" id="db-dd-cargo-lista" role="listbox" aria-label="{{ 'dashboard.filtros.cargo'|trans }}" tabindex="-1">
                        <div class="db-dd-op" role="option" id="db-dd-cargo-op-todos" data-valor=""
                             data-nome="{{ 'dashboard.filtros.todos_cargos'|trans }}" aria-selected="{{ cargoSel == '' ? 'true' : 'false' }}">
                            <span class="db-dd-av"><span class="db-dd-av-ico db-dd-tom--todos"><i class="bi bi-grid-fill" aria-hidden="true"></i></span></span>
                            <span class="db-dd-op-txt"><span class="db-dd-op-nome">{{ 'dashboard.filtros.todos_cargos'|trans }}</span></span>
                            <i class="bi bi-check2 db-dd-check" aria-hidden="true"></i>
                        </div>
                        {% for it in cargoItens %}
                            <div class="db-dd-op" role="option" id="db-dd-cargo-op-{{ loop.index }}" data-valor="{{ it.valor }}"
                                 data-nome="{{ it.nome }}" aria-selected="{{ it.valor == cargoSel ? 'true' : 'false' }}">
                                <span class="db-dd-av"><span class="db-dd-av-ico db-dd-tom--{{ it.tom }}"><i class="bi {{ it.icone }}" aria-hidden="true"></i></span></span>
                                <span class="db-dd-op-txt">
                                    <span class="db-dd-op-nome">{{ it.nome }}</span>
                                    <span class="db-dd-op-sub">{{ it.sub }}</span>
                                </span>
                                <i class="bi bi-check2 db-dd-check" aria-hidden="true"></i>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        </div>

        <div data-filtro-resultado>
            {{ include('dashboard/_resultado.html.twig') }}
            {# BlueJus Intelligence: dentro da região que recarrega, para a leitura seguir o
               filtro (o XHR do controller devolve os dois parciais nesta mesma ordem). #}
            {{ include('dashboard/_inteligencia.html.twig') }}
        </div>

        {# Exportar PDF: impressão do navegador (A4 paisagem, @media print no CSS),
           com o nome do arquivo sugerido pelo document.title (dashboard.js). #}
        <div class="db-acoes">
            <button type="button" class="db-btn-pdf js-db-exportar-pdf" title="{{ 'dashboard.exportar_pdf_titulo'|trans }}"><i class="bi bi-file-earmark-arrow-down"></i>{{ 'dashboard.exportar_pdf'|trans }}</button>
        </div>

        <div class="db-print-rodape">{{ 'dashboard.impressao.rodape'|trans }}</div>
    </div>

    {# ── Menu ⋮ "Opções da tabela" (desenho 1.2.2, "Opções da tabela" e "Personalização por
       usuário") ─────────────────────────────────────────────────────────────────────────
       O lugar dele é o cabeçalho da tabela, ao lado da lupa — mas o cabeçalho vive no fragmento
       que o XHR troca. Por isso o menu nasce AQUI, fora do fragmento e escondido (`hidden`), e o
       dashboard-preferencias.js o move para dentro do `.db-table-header` e o recoloca a cada
       recarga (o mesmo nó: o estado aberto/fechado e os ouvintes sobrevivem). Sem JS ele fica
       escondido: o estilo gravado continua valendo pelas classes do `.db-page`.
       Só o que o sistema suporta de verdade: densidade, sons (do calendário e do campeão, como no
       README do desenho), animações, setas, colunas visíveis e "Adicionar coluna" (as métricas com
       lastro do ColunasExtrasDoDashboard). Fora (decisão do dono ou sem lastro): "Pastas
       concluídas" (a pasta não tem situação "concluída"), zerar relatório. #}
    {% set prefColunas = [
        { chave: 'cargo',           rotulo: 'dashboard.tabela.cargo'|trans },
        { chave: 'metas',           rotulo: 'dashboard.tabela.total_metas'|trans },
        { chave: 'metas_ativas',    rotulo: 'dashboard.tabela.metas_ativas'|trans },
        { chave: 'metas_vencidas',  rotulo: 'dashboard.tabela.metas_vencidas'|trans },
        { chave: 'prazos',          rotulo: 'dashboard.tabela.prazos_proximos'|trans },
        { chave: 'demandas',        rotulo: 'dashboard.tabela.total_demandas'|trans },
        { chave: 'demandas_ativas', rotulo: 'dashboard.tabela.demandas_ativas'|trans },
        { chave: 'pastas_criadas',  rotulo: 'dashboard.tabela.pastas_criadas'|trans },
    ] %}
    {% set prefOcultas = preferencias.colunasOcultas %}
    {% set prefNumVisiveis = prefColunas|filter(c => c.chave != 'cargo' and c.chave not in prefOcultas)|length %}
    {% set animLigadas = preferencias.animacoes == 'ligadas' %}
    {% set setasLigadas = preferencias.setas == 'ligadas' %}
    {% set sonsLigados = preferencias.sons == 'ligados' %}
    {# Extras: as ligadas primeiro, na ordem da tabela; depois as outras do catálogo (escondidas
       em "Colunas", visíveis em "Adicionar coluna"). O JS reordena e troca o `hidden` a cada
       escolha, sem recarregar a página. #}
    {% set extrasCatalogo = constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::CATALOGO') %}
    {% set prefExtras = preferencias.colunasExtras %}
    {% set prefExtrasOrdem = prefExtras|merge(extrasCatalogo|keys|filter(k => k not in prefExtras)) %}
    <div class="db-pref" data-db-pref hidden>
        <button type="button" class="db-pref-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="db-pref-menu"
                title="{{ 'dashboard.pref.opcoes_da_tabela'|trans }}" aria-label="{{ 'dashboard.pref.opcoes_da_tabela'|trans }}"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
        <div class="db-pref-menu" id="db-pref-menu" role="menu" aria-label="{{ 'dashboard.pref.opcoes_da_tabela'|trans }}" hidden>
            <div class="db-pref-faixa">
                <i class="bi bi-person-check" aria-hidden="true"></i>
                <span class="db-pref-faixa-txt">{{ 'dashboard.pref.ajustes_salvos_para'|trans }} <b>{{ app.user.fullName }}</b></span>
            </div>

            <div class="db-pref-secao">{{ 'dashboard.pref.meu_estilo'|trans }}</div>
            <div class="db-pref-linha">
                <i class="bi bi-distribute-vertical db-pref-ico" aria-hidden="true"></i>
                <span class="db-pref-rotulo">{{ 'dashboard.pref.densidade'|trans }}</span>
                <div class="db-pref-seg" role="group" aria-label="{{ 'dashboard.pref.densidade'|trans }}">
                    {% for op in [{ valor: 'confortavel', rotulo: 'dashboard.pref.normal'|trans }, { valor: 'compacta', rotulo: 'dashboard.pref.compacta'|trans }] %}
                        <button type="button" class="db-pref-seg-btn" role="menuitemradio"
                                aria-checked="{{ preferencias.densidade == op.valor ? 'true' : 'false' }}"
                                data-pref-chave="dashboard.densidade" data-pref-valor="{{ op.valor }}">{{ op.rotulo }}</button>
                    {% endfor %}
                </div>
            </div>
            {# Sons: entre Densidade e Animações (dc L655-659). Liga/desliga o som do calendário. #}
            <button type="button" class="db-pref-item" role="menuitemcheckbox" aria-checked="{{ sonsLigados ? 'true' : 'false' }}"
                    data-pref-chave="dashboard.sons" data-pref-liga="ligados" data-pref-desliga="desligados">
                <i class="bi bi-volume-up db-pref-ico" aria-hidden="true"></i>
                <span class="db-pref-rotulo">{{ 'dashboard.pref.sons'|trans }}</span>
                <span class="db-pref-sw" aria-hidden="true"><span class="db-pref-sw-bola"></span></span>
            </button>
            <button type="button" class="db-pref-item" role="menuitemcheckbox" aria-checked="{{ animLigadas ? 'true' : 'false' }}"
                    data-pref-chave="dashboard.animacoes" data-pref-liga="ligadas" data-pref-desliga="reduzidas">
                <i class="bi bi-stars db-pref-ico" aria-hidden="true"></i>
                <span class="db-pref-rotulo">{{ 'dashboard.pref.animacoes'|trans }}</span>
                <span class="db-pref-sw" aria-hidden="true"><span class="db-pref-sw-bola"></span></span>
            </button>

            <div class="db-pref-div" aria-hidden="true"></div>
            <div class="db-pref-secao">{{ 'dashboard.pref.exibicao'|trans }}</div>
            <button type="button" class="db-pref-item" role="menuitemcheckbox" aria-checked="{{ setasLigadas ? 'true' : 'false' }}"
                    data-pref-chave="dashboard.setas" data-pref-liga="ligadas" data-pref-desliga="desligadas">
                <i class="bi bi-arrow-up-right db-pref-ico db-pref-ico--sm" aria-hidden="true"></i>
                <span class="db-pref-rotulo">{{ 'dashboard.pref.setas'|trans }}</span>
                <span class="db-pref-sw" aria-hidden="true"><span class="db-pref-sw-bola"></span></span>
            </button>

            <div class="db-pref-div" aria-hidden="true"></div>
            <div class="db-pref-secao db-pref-secao--cols">
                <span>{{ 'dashboard.pref.colunas'|trans }}</span>
                <button type="button" class="db-pref-mostrar" data-pref-mostrar-todas{% if prefOcultas is empty %} hidden{% endif %}>{{ 'dashboard.pref.mostrar_todas'|trans }}</button>
            </div>
            <div class="db-pref-fixa">
                <i class="bi bi-lock" aria-hidden="true"></i>
                <span class="db-pref-fixa-nome">{{ 'dashboard.tabela.colaborador'|trans }}</span>
                <span class="db-pref-fixa-tag">{{ 'dashboard.pref.fixa'|trans }}</span>
            </div>
            {% for c in prefColunas %}
                {% set visivel = c.chave not in prefOcultas %}
                {# A última numérica visível não pode sair (o desenho trava a caixa). #}
                {% set ultima = visivel and c.chave != 'cargo' and prefNumVisiveis == 1 %}
                <button type="button" class="db-pref-item db-pref-col" role="menuitemcheckbox"
                        aria-checked="{{ visivel ? 'true' : 'false' }}"{% if ultima %} aria-disabled="true"{% endif %}
                        data-pref-coluna="{{ c.chave }}">
                    <span class="db-pref-caixa" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    <span class="db-pref-rotulo">{{ c.rotulo }}</span>
                </button>
            {% endfor %}
            {# Extra ligada aparece aqui como "(extra)", marcada; desmarcar REMOVE a coluna da
               tabela (desenho: colsOpcoes → salvarPrefs({ extras: extras.filter(...) })). #}
            <div class="db-pref-extras-ativas" data-pref-extras-ativas>
            {% for k in prefExtrasOrdem %}
                <button type="button" class="db-pref-item db-pref-col" role="menuitemcheckbox" aria-checked="true"
                        data-pref-extra-remover="{{ k }}"{% if k not in prefExtras %} hidden{% endif %}>
                    <span class="db-pref-caixa" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    <span class="db-pref-rotulo">{{ 'dashboard.pref.coluna_extra'|trans({rotulo: extrasCatalogo[k].rotulo}) }}</span>
                </button>
            {% endfor %}
            </div>

            <div class="db-pref-div" aria-hidden="true"></div>
            <div class="db-pref-secao db-pref-secao--add">
                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                <span>{{ 'dashboard.pref.adicionar_coluna'|trans }}</span>
            </div>
            {% for k, c in extrasCatalogo %}
                <button type="button" class="db-pref-item db-pref-add" role="menuitem" title="{{ c.ajuda }}"
                        data-pref-extra-adicionar="{{ k }}"{% if k in prefExtras %} hidden{% endif %}>
                    <span class="db-pref-add-mais" aria-hidden="true"><i class="bi bi-plus-lg"></i></span>
                    <span class="db-pref-add-txt">
                        <span class="db-pref-add-rotulo">{{ c.rotulo }}</span>
                        <span class="db-pref-add-ajuda">{{ c.ajuda }}</span>
                    </span>
                </button>
            {% endfor %}
            <div class="db-pref-add-vazio" data-pref-extras-todas{% if prefExtras|length < extrasCatalogo|length %} hidden{% endif %}>{{ 'dashboard.pref.todas_na_tabela'|trans }}</div>
            {# "Zerar relatório de todos" (desenho: `comZerarTodosOn`): só para quem pode zerar e com a
               coluna Relatório na tabela (o dashboard-zerar.js acompanha a coluna entrar e sair). #}
            {% if podeZerar %}
            <div class="db-pref-zerar-grupo" data-db-zerar-todos-grupo{% if 'relatorio' not in prefExtras %} hidden{% endif %}>
                <div class="db-pref-div" aria-hidden="true"></div>
                <button type="button" class="db-pref-item db-pref-zerar" role="menuitem" data-db-zerar-todos="relatorio">
                    <i class="bi bi-chat-left-text db-pref-zerar-ico" aria-hidden="true"></i>
                    <span class="db-pref-add-txt">
                        <span class="db-pref-zerar-rotulo">{{ 'dashboard.pref.zerar_relatorio_todos'|trans }}</span>
                        <span class="db-pref-add-ajuda">{{ 'dashboard.pref.zerar_relatorio_todos_sub'|trans }}</span>
                    </span>
                </button>
            </div>
            {% endif %}

            <div class="db-pref-div" aria-hidden="true"></div>
            <button type="button" class="db-pref-item db-pref-restaurar" role="menuitem" data-pref-restaurar>
                <i class="bi bi-arrow-counterclockwise db-pref-ico db-pref-ico--sm" aria-hidden="true"></i>
                <span>{{ 'dashboard.pref.restaurar'|trans }}</span>
            </button>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
{# Janelas flutuantes (DASH-020): componente usado pelo histórico dos cards. #}
{{ catalogo_js('dashboard.js') }}
<script src="{{ asset('js/dashboard-janelas.js') }}"></script>
{# Botão direito num card: janela "Histórico" (DASH-017), sobre o componente acima. #}
<script src="{{ asset('js/dashboard-historico.js') }}"></script>
{# Troféu (fanfarra no hover) e cartão do colaborador (botão direito no nome), sobre as janelas. #}
<script src="{{ asset('js/dashboard-campeao.js') }}"></script>
{# Depois do motor de filtro: a contagem dos cards observa a região que ele recarrega. #}
<script src="{{ asset('js/dashboard.js') }}"></script>
{# Selects e calendário próprios da barra de filtros: escrevem nos nativos do parcial. #}
<script src="{{ asset('js/dashboard-filtros.js') }}"></script>
{# Menu ⋮ da tabela Desempenho: move o .db-pref para o cabeçalho da tabela e grava o estilo. #}
<script src="{{ asset('js/dashboard-preferencias.js') }}"></script>
{# Marcas dos alertas da Central de Inteligência (Resolvido, Ignorar, Aplicar). #}
<script src="{{ asset('js/dashboard-inteligencia.js') }}"></script>
<script src="{{ asset('js/dashboard-perfil-pessoa.js') }}"></script>
{# Modal "Ver relatório" da coluna Relatório (PR-D): antes do Zerar, que chama window.DbRelatorio. #}
{{ catalogo_js('dashboard.relatorio.js') }}
<script src="{{ asset('js/dashboard-relatorio.js') }}"></script>
{# "Zerar" das colunas (DASH-014): botão direito no cabeçalho ou no número da coluna. #}
<script src="{{ asset('js/dashboard-zerar.js') }}"></script>
{# Meta de pastas do mês (DASH-016): editor do lápis e menu do botão direito no card Pastas criadas. #}
<script src="{{ asset('js/dashboard-meta.js') }}"></script>
{% endblock %}
