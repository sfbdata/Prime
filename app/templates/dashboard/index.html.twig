{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<style>
/* ── Dashboard — estrutura (sem overrides de tipografia) ─────────── */
.db-stat-card {
    background: #fff;
    border: 1px solid #e8eaf0;
    border-radius: 12px;
    padding: 1.4rem 1.5rem 1.3rem;
    box-shadow: 0 1px 3px rgba(15,20,40,.04), 0 4px 14px rgba(15,20,40,.06);
    transition: box-shadow .18s ease, transform .18s ease;
    height: 100%;
}
.db-stat-card:hover {
    box-shadow: 0 2px 6px rgba(15,20,40,.06), 0 8px 24px rgba(15,20,40,.10);
    transform: translateY(-2px);
}
.db-stat-icon {
    width: 38px; height: 38px;
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
    margin-bottom: .95rem;
    flex-shrink: 0;
}
.db-icon-metas    { background: #ecfdf5; color: #16a34a; }
.db-icon-urgentes { background: #fef2f2; color: #dc2626; }
.db-icon-global   { background: #eff6ff; color: #2563eb; }
.db-stat-number {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: .35rem;
}

/* ── Progress bar interno (card Meta Global) ───────────────────── */
.db-prog-track {
    height: 5px;
    background: #f3f4f6;
    border-radius: 99px;
    overflow: hidden;
    margin-top: .85rem;
}
.db-prog-fill {
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, #60a5fa, #2563eb);
    transition: width .5s ease;
}

/* ── Seção da tabela ───────────────────────────────────────────── */
.db-table-card {
    background: #fff;
    border: 1px solid #e8eaf0;
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,20,40,.04), 0 4px 14px rgba(15,20,40,.06);
    overflow: hidden;
}
.db-table-header {
    padding: .85rem 1.25rem;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: .45rem;
}
.db-table thead th {
    padding: .75rem 1rem;
    border-bottom: 1px solid #f3f4f6;
    border-top: none;
    white-space: nowrap;
    background: #fafbfc;
}
.db-table tbody td {
    padding: .75rem 1rem;
    border-bottom: 1px solid #f7f8fa;
    vertical-align: middle;
}
.db-table tbody tr:last-child td { border-bottom: none; }
.db-table tbody tr:hover td { background: #fafbff; }
.db-empty {
    padding: 2.5rem 1rem;
    text-align: center;
}
.db-empty i { font-size: 1.8rem; display: block; margin-bottom: .5rem; }
</style>

<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">
            <i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard
        </h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        {# ── Cards de métricas ─────────────────────────────────── #}
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="db-stat-card">
                    <div class="db-stat-icon db-icon-metas">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div class="db-stat-number">{{ dashboard.totalMetasAtivas }}</div>
                    <div class="text-secondary">Metas Ativas</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="db-stat-card">
                    <div class="db-stat-icon db-icon-urgentes">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="db-stat-number">{{ dashboard.demandasUrgentes }}</div>
                    <div class="text-secondary">Demandas Urgentes</div>
                </div>
            </div>
            <div class="col-sm-12 col-lg-4">
                <div class="db-stat-card">
                    <div class="db-stat-icon db-icon-global">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="db-stat-number">{{ dashboard.metaGlobalPercent }}%</div>
                    <div class="text-secondary">Meta Global</div>
                    <div class="db-prog-track">
                        <div class="db-prog-fill" style="width: {{ dashboard.metaGlobalPercent }}%"></div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Tabela por advogado ────────────────────────────────── #}
        <div class="db-table-card">
            <div class="db-table-header">
                <i class="bi bi-people"></i>
                <span>Desempenho por Advogado</span>
            </div>
            {% if dashboard.porAdvogado is not empty %}
            <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                <label for="filtroCargo" class="form-label mb-0 text-muted small">Cargo:</label>
                <select id="filtroCargo" class="form-select form-select-sm w-auto">
                    <option value="">Todos os cargos</option>
                    <option value="__sem_cargo__">Sem cargo</option>
                </select>
            </div>
            {% endif %}
            <div class="table-responsive">
                {% if dashboard.porAdvogado is empty %}
                <div class="db-empty text-secondary">
                    <i class="bi bi-people"></i>
                    Nenhum advogado com dados no período.
                </div>
                {% else %}
                <table id="tabelaColaboradores" class="table db-table mb-0">
                    <thead>
                        <tr>
                            <th>Advogado</th>
                            <th>Cargo</th>
                            <th class="text-center">Total Metas</th>
                            <th class="text-center">Metas Ativas</th>
                            <th class="text-center">Metas Vencidas</th>
                            <th class="text-center">Prazos Próximos</th>
                            <th class="text-center">Total Demandas</th>
                            <th class="text-center">Demandas Ativas</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for linha in dashboard.porAdvogado %}
                        <tr data-cargo="{{ linha.cargoNome|default('')|e('html_attr') }}">
                            <td class="fw-medium">{{ linha.nomeAdvogado }}</td>
                            <td class="text-muted">{{ linha.cargoNome ?? '—' }}</td>
                            <td class="text-center">{{ linha.totalMetas }}</td>
                            <td class="text-center">{{ linha.metasAtivas }}</td>
                            <td class="text-center">
                                {% if linha.metasVencidas > 0 %}
                                    <span class="badge text-bg-danger">{{ linha.metasVencidas }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if linha.prazosProximos > 0 %}
                                    <span class="badge text-bg-warning">{{ linha.prazosProximos }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-center">{{ linha.totalDemandas }}</td>
                            <td class="text-center">{{ linha.demandasAtivas }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
            </div>
        </div>

    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var select = document.getElementById('filtroCargo');
    if (!select) return;

    var tabela = document.getElementById('tabelaColaboradores');
    var linhas = tabela.querySelectorAll('tbody tr[data-cargo]');

    var cargosVistos = {};
    linhas.forEach(function (tr) {
        var cargo = tr.dataset.cargo;
        if (cargo && !cargosVistos[cargo]) {
            cargosVistos[cargo] = true;
            var opt = document.createElement('option');
            opt.value = cargo;
            opt.textContent = cargo;
            select.insertBefore(opt, select.querySelector('[value="__sem_cargo__"]'));
        }
    });

    select.addEventListener('change', function () {
        var val = this.value;
        linhas.forEach(function (tr) {
            if (!val) {
                tr.style.display = '';
            } else if (val === '__sem_cargo__') {
                tr.style.display = tr.dataset.cargo === '' ? '' : 'none';
            } else {
                tr.style.display = tr.dataset.cargo === val ? '' : 'none';
            }
        });
    });
});
</script>
{% endblock %}
