{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{# `db-body` no <body>: pinta o fundo da página do desenho (degradê do topo)
   sem sangria de margem negativa — mesmo gancho que a tela da pasta usa. #}
{% block body_class %}db-body{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/filtro-tabela.css') }}">
{# Visual aprovado do Dashboard — desenho em docs/design/ (01 - Dashboard 1.2.2.dc.html).
   Tudo escopado em .db-page/.db-body; o estilo não vem mais inline daqui. #}
<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{# Painel BlueJus Intelligence (botão no cabeçalho + painel lateral), escopado em .db-page. #}
<link rel="stylesheet" href="{{ asset('css/dashboard-inteligencia.css') }}">
{% endblock %}

{% block body %}
<section class="db-page">
    {% set respOpcoes = [] %}
    {% for u in responsaveis %}
        {% set respOpcoes = respOpcoes|merge([{ valor: u.id, label: u.nome }]) %}
    {% endfor %}
    {% set cargoOpcoes = [] %}
    {% for c in cargos %}
        {% set cargoOpcoes = cargoOpcoes|merge([{ valor: c, label: c }]) %}
    {% endfor %}
    {# "Sem cargo" por último, como no desenho, e só quando há colaborador ativo sem cargo
       (o controller decide em `existeSemCargo`). O valor é a constante do UseCase. #}
    {% if existeSemCargo|default(false) %}
        {% set cargoOpcoes = cargoOpcoes|merge([{ valor: cargoSemValor, label: 'Sem cargo' }]) %}
    {% endif %}

    {# Cabeçalho do PDF (só na impressão): período e filtros do momento. O servidor
       escreve o estado da carga; o dashboard.js reescreve no `beforeprint`, porque os
       filtros mudam por XHR sem recarregar a casca. #}
    {% set fmtDe  = filtros.data_de|default('') %}
    {% set fmtAte = filtros.data_ate|default('') %}
    {% set respNome = 'Todos os responsáveis' %}
    {% for o in respOpcoes %}
        {% if (o.valor ~ '') == filtros.responsavel|default('') %}{% set respNome = o.label %}{% endif %}
    {% endfor %}
    {% set cargoNome = filtros.cargo|default('') == '' ? 'Todos os cargos'
        : (filtros.cargo == cargoSemValor|default('') ? 'Sem cargo' : filtros.cargo) %}

    {# Ordem do desenho: título → filtros → cards → tabela. O título fica DENTRO do
       root para dividir a primeira linha do flex com o "Atualizado às", que mora no
       fragmento (renova a cada XHR); a posição de cada bloco é dada por `order` no CSS.
       `data-ft-rotulo-limpar`: opção do filtro-tabela.js para o texto do botão (desenho). #}
    <div data-filtro-root data-filtro-endpoint="{{ path('dashboard_index') }}" data-ft-rotulo-limpar="Limpar filtros">
        <div class="db-print-cabecalho">
            <div class="db-print-cabecalho-esq">
                <div class="db-print-marca">BlueJus · Dashboard</div>
                <div class="db-print-titulo">Relatório de desempenho</div>
                <div class="db-print-filtros">Período <span class="db-print-periodo">{{ fmtDe != '' ? fmtDe|split('-')|reverse|join('/') : 'início' }} a {{ fmtAte != '' ? fmtAte|split('-')|reverse|join('/') : 'hoje' }}</span> · <span class="db-print-facetas">{{ respNome }} · {{ cargoNome }}</span></div>
            </div>
            <div class="db-print-gerado">Gerado em <span class="db-print-quando">{{ 'now'|date('d/m/Y') }} às {{ 'now'|date('H:i') }}</span><br>por {{ app.user.fullName }}</div>
        </div>

        {# O texto vive num <span>: a revelação (clip-path) e o brilho ficam nele, e o
           símbolo que rola por cima pode sair da caixa do texto sem ser cortado. #}
        <h1 class="db-titulo"><span class="db-titulo-texto">Dashboard</span><img class="db-titulo-simbolo" src="{{ asset('images/logo/bluejus_simbolo.svg') }}" alt="" aria-hidden="true"></h1>

        <div class="db-filtro-wrap">
        {# Segmentado de período (Este mês · 60 dias · 90 dias · Este ano). Preenche os
           campos data_de/data_ate do parcial (.js-filtro-campo) com datas reais e dispara
           `change`; o filtro-tabela.js recarrega como se o usuário tivesse digitado.
           As quatro faixas são calculadas AQUI (servidor) e vão em data-de/data-ate: o
           dashboard.js só lê os atributos. Ativo = as duas datas batem com os campos.
           O período padrão NÃO muda (decisão do dono pendente): sem datas, nenhum botão
           fica ativo. `data_ate` é sempre hoje; só o começo varia. #}
        {% set hoje = 'now'|date('Y-m-d') %}
        {% set periodos = [
            { chave: 'mes', rotulo: 'Este mês', de: 'now'|date('Y-m-01') },
            { chave: 'd60', rotulo: '60 dias',  de: '-60 days'|date('Y-m-d') },
            { chave: 'd90', rotulo: '90 dias',  de: '-90 days'|date('Y-m-d') },
            { chave: 'ano', rotulo: 'Este ano', de: 'now'|date('Y-01-01') },
        ] %}
        <div class="db-seg db-seg--sem-js" role="group" aria-label="Período">
            <span class="db-seg-ind" aria-hidden="true"></span>
            {% for p in periodos %}
                {% set ativo = filtros.data_de|default('') == p.de and filtros.data_ate|default('') == hoje %}
                <button type="button" class="db-seg-btn{{ ativo ? ' is-ativo' : '' }}"
                        data-periodo="{{ p.chave }}" data-de="{{ p.de }}" data-ate="{{ hoje }}"
                        aria-pressed="{{ ativo ? 'true' : 'false' }}">{{ p.rotulo }}</button>
            {% endfor %}
        </div>
        {# A busca de colaborador mora no cabeçalho da tabela (desenho), mas o campo que o
           filtro-tabela.js lê (FormData, chip "Busca", "Limpar filtros") tem de estar DENTRO
           do form: ele é renderizado aqui e escondido pelo CSS; o campo visível no cabeçalho
           (.db-busca, no fragmento) só espelha o valor para ele — ver dashboard.js. #}
        {{ include('_partials/_filtro_barra.html.twig', {
            mostrar_busca: true,
            busca_placeholder: 'Buscar colaborador',
            filtros: filtros,
            facetas: [
                { name: 'data_de', rotulo: 'De', tipo: 'date' },
                { name: 'data_ate', rotulo: 'Até', tipo: 'date' },
                { name: 'responsavel', rotulo: 'Responsável', tipo: 'select', opcoes: respOpcoes },
                { name: 'cargo', rotulo: 'Cargo', tipo: 'select', opcoes: cargoOpcoes }
            ]
        }) }}
        </div>

        <div data-filtro-resultado>
            {{ include('dashboard/_resultado.html.twig') }}
            {# BlueJus Intelligence: dentro da região que recarrega, para a leitura seguir o
               filtro (o XHR do controller devolve os dois parciais nesta mesma ordem). #}
            {{ include('dashboard/_inteligencia.html.twig') }}
        </div>

        {# Exportar PDF: impressão do navegador (A4 paisagem, @media print no CSS),
           com o nome do arquivo sugerido pelo document.title (dashboard.js). #}
        <div class="db-acoes">
            <button type="button" class="db-btn-pdf js-db-exportar-pdf" title="Exportar relatório em PDF"><i class="bi bi-file-earmark-arrow-down"></i>Exportar PDF</button>
        </div>

        <div class="db-print-rodape">Documento gerado pelo BlueJus para uso interno do escritório.</div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/filtro-tabela.js') }}"></script>
{# Depois do motor de filtro: a contagem dos cards observa a região que ele recarrega. #}
<script src="{{ asset('js/dashboard.js') }}"></script>
{% endblock %}
