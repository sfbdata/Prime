{# ───────────────────────────────────────────────────────────────────────────
   Colunas extras da tabela Desempenho ("Adicionar coluna" do menu ⋮; desenho
   01 - Dashboard 1.2.2, constante EXTRAS). O catálogo e as fórmulas moram no
   servidor (App\Dashboard\Preferencia\ColunasExtrasDoDashboard e
   ObterDadosDashboardUseCase); aqui só a forma do número:
     soma → "12" · pct → "75%" · dias → "4d" (fmtExtra do desenho).
   Valor null = não há o que medir (taxa sem meta, tempo sem meta concluída com
   data): "—", nunca um número inventado.

   Número clicável só onde a lista de destino conta a MESMA coisa (regra B12):
     - Pastas urgentes > 0 abre o Acervo geral com prioridade urgente da pessoa (o
       mesmo destino do "ver pastas" do card Demandas urgentes);
     - Metas concluídas > 0 e Em revisão > 0 abrem /tarefas/equipe com status
       `concluidas` / `em_revisao`, a pessoa e o período (DASH-008: o critério da
       lista é o da coluna — TarefaRepository::findMetasDaEquipePaginado).
   As outras extras não têm lista que bata: taxa (%) e tempo médio (dias) não são
   contagem de itens, e a agenda não filtra por pessoa. Ficam como número simples.
─────────────────────────────────────────────────────────────────────────── #}
{% macro valor(chave, valor, userId = null, quem = '', periodoLink = {}) %}
{%- set catalogo = constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::CATALOGO') -%}
{%- set tipo = catalogo[chave].tipo -%}
{%- if valor is null -%}
    <span class="db-num db-num--vazio" title="Sem dado no período">—</span>
{%- else -%}
    {%- set texto = tipo == 'pct' ? valor ~ '%' : (tipo == 'dias' ? valor ~ 'd' : valor) -%}
    {%- if userId is not null and chave == 'pastas_urgentes' and valor > 0 -%}
        <a class="db-num db-num-link" href="{{ path('expediente_index', { painel: 'acervo-geral', prioridade: 'urgente', responsavel: userId }|merge(periodoLink)) }}" title="Abrir: Expediente · pastas urgentes de {{ quem }}" aria-label="Abrir: Expediente · pastas urgentes de {{ quem }}">{{ texto }}</a>
    {%- elseif userId is not null and chave == 'metas_concluidas' and valor > 0 -%}
        <a class="db-num db-num-link" href="{{ path('tarefa_equipe', { status: 'concluidas', responsavel: userId }|merge(periodoLink)) }}" title="Abrir: Metas concluídas de {{ quem }}" aria-label="Abrir: Metas concluídas de {{ quem }}">{{ texto }}</a>
    {%- elseif userId is not null and chave == 'metas_revisao' and valor > 0 -%}
        <a class="db-num db-num-link" href="{{ path('tarefa_equipe', { status: 'em_revisao', responsavel: userId }|merge(periodoLink)) }}" title="Abrir: Metas em revisão de {{ quem }}" aria-label="Abrir: Metas em revisão de {{ quem }}">{{ texto }}</a>
    {%- elseif valor == 0 -%}
        <span class="db-num db-num--zero">{{ texto }}</span>
    {%- else -%}
        <span class="db-num">{{ texto }}</span>
    {%- endif -%}
{%- endif -%}
{% endmacro %}

{# title do cabeçalho: a ajuda do desenho e, quando há, a ressalva da métrica. #}
{% macro titulo(chave) %}
{%- set catalogo = constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::CATALOGO') -%}
{%- set c = catalogo[chave] -%}
{{- c.ajuda ~ (c.nota != '' ? ' · ' ~ c.nota : '') -}}
{% endmacro %}
