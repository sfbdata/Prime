{# ───────────────────────────────────────────────────────────────────────────
   Perfil individual da pessoa no painel BlueJus Intelligence (fragmento HTML por XHR).
   Desenho: 01 - Dashboard - VS 25.10.26, "← Equipe" (L787-789), perfil de desempenho (L1098-1190) e
   montagem em L2431-2480. Por regras fixas sobre os números reais da tabela Desempenho: o que o desenho
   calcula com dado de exemplo e o sistema não registra (cumprimento de prazo, chip de situação) não é
   renderizado. Matriz, correlação, hipótese, fatores, "O que isso pode causar?" e plano vêm de regras
   fixas sobre números reais (AnaliseDaPessoa). "Criar acompanhamento" grava um registro próprio do
   escritório (spec painel-acompanhamento-redistribuir, fatia A; confirmação em <dialog>, sem tarefa
   avulsa, sem texto livre); "Redistribuir" ainda não existe (fatia B).
   Quem monta é o PerfilDaPessoaDoDashboardController; o dashboard-perfil-pessoa.js injeta este bloco no
   painel e troca o título. Estilo em public/css/dashboard-perfil-pessoa.css (escopo .db-page).
─────────────────────────────────────────────────────────────────────────── #}
{% set periodoLink = { data_de: filtros.data_de|default(''), data_ate: filtros.data_ate|default('') }|filter(v => v != '') %}
{% set partes = perfil.nome|split(' ')|filter(p => p != '') %}
{% set iniciais = partes|slice(0, 2)|map(p => p|slice(0, 1))|join|upper %}
{% set acomp = perfil.acompanhamento %}
{% set emAcomp = perfil.emAcompanhamento %}
{# Precedência do chip: Em acompanhamento (ou Revisar acompanhamento, se venceu), depois Analisado, depois Pendente. #}
{% set status = emAcomp ? (acomp.vencido ? 'acomp_vencido' : 'acomp') : (perfil.status ?? 'pendente') %}
<div class="db-pf" data-pf data-titulo="{{ 'dashboard.pessoa.titulo'|trans({nome: perfil.nome}) }}" data-url-marca="{{ path('dashboard_inteligencia_pessoa_marcar', {id: perfil.userId}) }}"
     data-url-acomp-criar="{{ path('dashboard_inteligencia_pessoa_acomp_criar', {id: perfil.userId}) }}"
     data-url-acomp-renovar="{{ path('dashboard_inteligencia_pessoa_acomp_renovar', {id: perfil.userId}) }}"
     data-url-acomp-encerrar="{{ path('dashboard_inteligencia_pessoa_acomp_encerrar', {id: perfil.userId}) }}"
     data-acomp-aberto="{{ emAcomp ? '1' : '0' }}" data-acomp-vencido="{{ emAcomp and acomp.vencido ? '1' : '0' }}"
     data-txt-criado="{{ 'dashboard.pessoa.acomp.criado'|trans({nome: perfil.primeiroNome}) }}"
     data-txt-renovado="{{ 'dashboard.pessoa.acomp.renovado'|trans({nome: perfil.primeiroNome}) }}"
     data-txt-encerrado="{{ 'dashboard.pessoa.acomp.encerrado'|trans({nome: perfil.primeiroNome}) }}"
     data-txt-erro-acomp="{{ 'dashboard.pessoa.acomp.erro'|trans }}">
    <div class="db-pf-cab">
        {% if perfil.fotoUrl %}
            <img src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}" alt="" class="db-avatar db-avatar-img db-pf-avatar" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
            <span class="collab-avatar-inicial db-avatar db-avatar--{{ perfil.userId % 9 }} db-pf-avatar" style="display:none">{{ iniciais }}</span>
        {% else %}
            <span class="collab-avatar-inicial db-avatar db-avatar--{{ perfil.userId % 9 }} db-pf-avatar">{{ iniciais }}</span>
        {% endif %}
        <div class="db-pf-quem">
            <div class="db-pf-rotulo">{{ 'dashboard.pessoa.rotulo'|trans }}</div>
            <div class="db-pf-nome">{{ perfil.nome }}</div>
            <div class="db-pf-cargo">{{ perfil.cargo ?? 'dashboard.sem_cargo'|trans }} · {{ 'dashboard.pessoa.periodo_selecionado'|trans }}</div>
        </div>
    </div>

    <div class="db-pf-metricas">
        {% for m in perfil.metricas %}
            {% set rotulo = ('dashboard.pessoa.metrica.' ~ m.chave)|trans %}
            <div class="db-pf-metrica" data-metrica="{{ m.chave }}">
                <div class="db-pf-metrica-k">{{ rotulo }}</div>
                <div class="db-pf-metrica-v">
                    {%- if m.valor is null -%}
                        <span class="db-pf-sem-dado">{{ 'dashboard.pessoa.sem_dado'|trans }}</span>
                    {%- elseif m.temLink -%}
                        <a href="{{ path('tarefa_equipe', { status: m.statusDoLink, responsavel: perfil.userId }|merge(m.comPeriodo ? periodoLink : {})) }}" title="{{ 'dashboard.pessoa.abrir_lista'|trans({rotulo: rotulo, nome: perfil.nome}) }}">{{ m.valor }}{{ m.porcentagem ? '%' : '' }}</a>
                    {%- else -%}
                        {{ m.valor }}{{ m.porcentagem ? '%' : '' }}
                    {%- endif -%}
                </div>
            </div>
        {% endfor %}
    </div>

    {% set analise = perfil.analise %}
    {% if analise %}
    <section class="db-pf-secao" data-pf-matriz>
        <div class="db-pf-secao-cab"><span class="db-pf-secao-t">{{ 'dashboard.pessoa.matriz.titulo'|trans }}</span></div>
        <div class="db-pf-matriz">
            {% for x in analise.matriz %}
                <div class="db-pf-matriz-linha" data-matriz="{{ x.chave }}"><span class="db-pf-matriz-k">{{ ('dashboard.pessoa.matriz.eixo.' ~ x.chave)|trans }}</span><span class="db-pf-matriz-v db-pf-matriz-v--{{ x.tom }}">{{ ('dashboard.pessoa.matriz.estado.' ~ x.estado)|trans }}</span></div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <section class="db-pf-secao db-pf-comp" data-pf-comp>
        <div class="db-pf-secao-cab">
            <span class="db-pf-secao-t">{{ 'dashboard.pessoa.comparacao.titulo'|trans }}</span>
            {% if perfil.comparacoes %}<button type="button" class="db-pf-link" data-pf-comparar aria-expanded="false">{{ 'dashboard.pessoa.comparacao.comparar'|trans }}</button>{% endif %}
        </div>
        {% for c in perfil.comparacoes %}
            {% set v = c.variacao %}
            {% set tom = v is null or v == 0 or c.sentido == 'neutro' ? 'neutro' : ((v > 0) == (c.sentido == 'sobe_ruim') ? 'ruim' : 'bom') %}
            <div class="db-pf-comp-linha" data-comparacao="{{ c.chave }}">
                <span class="db-pf-comp-k">{{ ('dashboard.pessoa.comparacao.' ~ c.chave)|trans }}</span>
                <span class="db-pf-comp-barras">
                    <span class="db-pf-barra db-pf-barra--atual" style="width:{{ c.atual > 0 ? max(3, (c.atual / c.maior * 100)|round) : 0 }}%"></span>
                    <span class="db-pf-barra db-pf-barra--anterior" style="width:{{ c.anterior > 0 ? max(3, (c.anterior / c.maior * 100)|round) : 0 }}%"></span>
                </span>
                <span class="db-pf-comp-d db-pf-comp-d--{{ tom }}" title="{{ 'dashboard.pessoa.comparacao.de_para'|trans({anterior: c.anterior, atual: c.atual}) }}">{{ v is null ? (c.atual > 0 ? 'dashboard.pessoa.comparacao.novo'|trans : '0%') : (v > 0 ? '+' : (v < 0 ? '−' : '')) ~ (v|abs) ~ '%' }}</span>
            </div>
        {% else %}
            <div class="db-pf-vazio">{{ 'dashboard.pessoa.comparacao.sem_base'|trans }}</div>
        {% endfor %}
        {% if perfil.comparacoes %}<div class="db-pf-legenda" data-pf-legenda hidden>{{ 'dashboard.pessoa.comparacao.legenda'|trans }}</div>{% endif %}
    </section>

    <section class="db-pf-secao">
        <div class="db-pf-secao-cab"><span class="db-pf-secao-t">{{ 'dashboard.pessoa.diagnostico'|trans }}</span></div>
        {% for texto in perfil.motivos %}
            <div class="db-pf-motivo"><span class="db-pf-tag db-pf-tag--observado">{{ 'dashboard.pessoa.observado'|trans }}</span><span>{{ texto }}</span></div>
        {% endfor %}
        {% for l in analise ? analise.leituras : [] %}
            <div class="db-pf-motivo" data-leitura="{{ l.tipo }}"><span class="db-pf-tag db-pf-tag--{{ l.tipo }}">{{ ('dashboard.pessoa.etiqueta.' ~ l.tipo)|trans }}</span><span>{{ l.texto }}</span></div>
        {% endfor %}
        {% if analise %}<div class="db-pf-legenda">{{ 'dashboard.pessoa.por_regras_fixas'|trans }}</div>{% endif %}
    </section>

    {% if analise and analise.fatores %}
    <section class="db-pf-secao" data-pf-fatores>
        <div class="db-pf-secao-cab"><span class="db-pf-secao-t">{{ 'dashboard.pessoa.fatores'|trans }}</span></div>
        {% for f in analise.fatores %}
            <div class="db-pf-motivo"><span class="db-pf-tag db-pf-tag--observado">{{ 'dashboard.pessoa.etiqueta.observado'|trans }}</span><span>{{ f }}</span></div>
        {% endfor %}
    </section>
    {% endif %}

    {% if analise and analise.impactos %}
    <section class="db-pf-impacto" data-pf-impacto>
        <div class="db-pf-impacto-t">{{ 'dashboard.pessoa.impacto.titulo'|trans }}<span class="db-pf-impacto-tag">{{ 'dashboard.pessoa.impacto.tag'|trans }}</span></div>
        {% for i in analise.impactos %}<div class="db-pf-impacto-i">→ {{ i }}</div>{% endfor %}
    </section>
    {% endif %}

    {% if analise and analise.plano %}
    <section class="db-pf-plano" data-pf-plano>
        <div class="db-pf-secao-cab"><span class="db-pf-secao-t">{{ 'dashboard.pessoa.plano.titulo'|trans }}</span></div>
        {% for k in ['problema', 'causa', 'acao', 'responsavel', 'revisao', 'sucesso'] %}
            <div class="db-pf-plano-linha" data-plano="{{ k }}"><span class="db-pf-plano-k">{{ ('dashboard.pessoa.plano.' ~ k)|trans }}</span><span>{{ analise.plano[k] }}</span></div>
        {% endfor %}
        <div class="db-pf-legenda">{{ 'dashboard.pessoa.plano.aviso'|trans }}</div>
    </section>
    {% endif %}

    <details class="db-pf-porque">
        <summary><i class="bi bi-question-circle" aria-hidden="true"></i>{{ 'dashboard.pessoa.por_que'|trans }}</summary>
        <div class="db-pf-porque-corpo">
            <div>{{ 'dashboard.pessoa.por_que_texto'|trans }}</div>
            <div class="db-pf-porque-h">{{ 'dashboard.pessoa.dados_considerados'|trans }}</div>
            {% for d in perfil.dados %}<div>→ {{ d }}</div>{% endfor %}
            <div class="db-pf-porque-h">{{ 'dashboard.pessoa.limites'|trans }}</div>
            {% for l in perfil.limites %}<div>→ {{ l }}</div>{% endfor %}
        </div>
    </details>

    <div class="db-pf-acoes">
        {% set recebidas = perfil.metricas|first %}
        {% if recebidas.temLink %}
            <a class="db-pf-btn" href="{{ path('tarefa_equipe', { status: 'todas', responsavel: perfil.userId }|merge(periodoLink)) }}">{{ 'dashboard.pessoa.ver_tarefas'|trans }}</a>
        {% endif %}
        {# Desenho L2441: "Criar acompanhamento" é o botão primário (azul); os demais, cinza. Enquanto há um aberto, vira "Encerrar". #}
        <button type="button" class="db-pf-btn db-pf-btn--primario" data-pf-acomp-abrir="criar"{{ emAcomp ? ' hidden' : '' }}>{{ 'dashboard.pessoa.acomp.criar'|trans }}</button>
        <button type="button" class="db-pf-btn" data-pf-acomp-abrir="renovar"{{ emAcomp ? '' : ' hidden' }}>{{ 'dashboard.pessoa.acomp.renovar'|trans }}</button>
        <button type="button" class="db-pf-btn" data-pf-acomp-encerrar{{ emAcomp ? '' : ' hidden' }}>{{ 'dashboard.pessoa.acomp.encerrar'|trans }}</button>
        <button type="button" class="db-pf-btn" data-pf-marcar="analisado" aria-pressed="{{ perfil.status == 'analisado' ? 'true' : 'false' }}">{{ 'dashboard.pessoa.marcar_analisado'|trans }}</button>
        <span class="db-pf-estado">
            <span class="db-pf-revisao" data-pf-revisao data-txt="{{ 'dashboard.pessoa.acomp.revisar_ate'|trans({data: '{data}'}) }}"{{ emAcomp ? '' : ' hidden' }}>{% if emAcomp %}{{ 'dashboard.pessoa.acomp.revisar_ate'|trans({data: acomp.revisarEm.format('d/m')}) }}{% endif %}</span>
            <span class="db-pf-status db-pf-status--{{ status|replace({'_vencido': ''}) }}" data-pf-status data-rotulo-analisado="{{ 'dashboard.pessoa.status.analisado'|trans }}" data-rotulo-pendente="{{ 'dashboard.pessoa.status.pendente'|trans }}" data-rotulo-acomp="{{ 'dashboard.pessoa.status.acomp'|trans }}" data-rotulo-acomp-vencido="{{ 'dashboard.pessoa.status.acomp_vencido'|trans }}" data-marca="{{ perfil.status ?? '' }}">{{ ('dashboard.pessoa.status.' ~ status)|trans }}</span>
        </span>
    </div>
    <div class="db-pf-aviso-acomp" data-pf-aviso-acomp role="status" hidden></div>

    <div class="db-pf-retorno">
        <span class="db-pf-retorno-pergunta">{{ 'dashboard.pessoa.feedback.pergunta'|trans }}</span>
        {% for k in ['sim', 'nao', 'parcial'] %}
            <button type="button" class="db-pf-btn db-pf-btn--mini" data-pf-marcar="{{ k }}" aria-pressed="{{ perfil.feedback == k ? 'true' : 'false' }}">{{ ('dashboard.pessoa.feedback.' ~ k)|trans }}</button>
        {% endfor %}
    </div>

    {# Confirmação (spec: nada é criado sem este clique). <dialog> modal sobe à camada de topo, acima do popover do painel. #}
    <dialog class="db-pf-dlg" data-pf-dlg aria-labelledby="dbPfDlgTitulo" data-titulo-criar="{{ 'dashboard.pessoa.acomp.dialogo_criar'|trans }}" data-titulo-renovar="{{ 'dashboard.pessoa.acomp.dialogo_renovar'|trans }}" data-botao-criar="{{ 'dashboard.pessoa.acomp.confirmar_criar'|trans }}" data-botao-renovar="{{ 'dashboard.pessoa.acomp.confirmar_renovar'|trans }}">
        <div class="db-pf-dlg-topo"><i class="bi bi-calendar-check" aria-hidden="true"></i><b id="dbPfDlgTitulo" data-pf-dlg-titulo>{{ 'dashboard.pessoa.acomp.dialogo_criar'|trans }}</b><button type="button" class="db-pf-dlg-x" data-pf-dlg-fechar aria-label="{{ 'dashboard.pessoa.acomp.fechar'|trans }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <div class="db-pf-dlg-corpo">
            <div class="db-pf-dlg-pessoa">{{ perfil.nome }}</div>
            <div class="db-pf-dlg-texto">{{ 'dashboard.pessoa.acomp.explicacao'|trans({nome: perfil.nome}) }}</div>
            <fieldset class="db-pf-dlg-prazo">
                <legend>{{ 'dashboard.pessoa.acomp.prazo'|trans }}</legend>
                {% for dias in [1, 2, 7] %}
                    <label><input type="radio" name="prazo_dias" value="{{ dias }}"{{ dias == 7 ? ' checked' : '' }}> {{ ('dashboard.pessoa.acomp.prazo_' ~ dias)|trans }}</label>
                {% endfor %}
            </fieldset>
            <div class="db-pf-dlg-erro" data-pf-dlg-erro role="alert" hidden></div>
        </div>
        <div class="db-pf-dlg-rodape">
            <button type="button" class="db-pf-btn" data-pf-dlg-fechar>{{ 'dashboard.pessoa.acomp.cancelar'|trans }}</button>
            <button type="button" class="db-pf-btn db-pf-btn--primario" data-pf-dlg-confirmar>{{ 'dashboard.pessoa.acomp.confirmar_criar'|trans }}</button>
        </div>
    </dialog>
</div>
