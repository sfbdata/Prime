{# ───────────────────────────────────────────────────────────────────────────
   Perfil individual da pessoa no painel BlueJus Intelligence (fragmento HTML por XHR).
   Desenho: 01 - Dashboard - VS 25.10.26, "← Equipe" (L787-789), perfil de desempenho (L1098-1190) e
   montagem em L2431-2480. Por regras fixas sobre os números reais da tabela Desempenho: o que o desenho
   calcula com dado de exemplo e o sistema não registra (cumprimento de prazo, situação, matriz,
   correlação, hipótese, fatores, plano de ação) não é renderizado. Os botões "Criar acompanhamento" e
   "Redistribuir" também não: não há tela de tarefa avulsa nem de redistribuição para recebê-los.
   Quem monta é o PerfilDaPessoaDoDashboardController; o dashboard-perfil-pessoa.js injeta este bloco no
   painel e troca o título. Estilo em public/css/dashboard-perfil-pessoa.css (escopo .db-page).
─────────────────────────────────────────────────────────────────────────── #}
{% set periodoLink = { data_de: filtros.data_de|default(''), data_ate: filtros.data_ate|default('') }|filter(v => v != '') %}
{% set partes = perfil.nome|split(' ')|filter(p => p != '') %}
{% set iniciais = partes|slice(0, 2)|map(p => p|slice(0, 1))|join|upper %}
{% set status = perfil.status ?? 'pendente' %}
<div class="db-pf" data-pf data-titulo="{{ 'dashboard.pessoa.titulo'|trans({nome: perfil.nome}) }}" data-url-marca="{{ path('dashboard_inteligencia_pessoa_marcar', {id: perfil.userId}) }}">
    <div class="db-pf-cab">
        {% if perfil.fotoUrl %}
            <img src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}" alt="" class="db-avatar db-avatar-img db-pf-avatar" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
            <span class="collab-avatar-inicial db-avatar db-avatar--{{ perfil.userId % 9 }} db-pf-avatar" style="display:none">{{ iniciais }}</span>
        {% else %}
            <span class="collab-avatar-inicial db-avatar db-avatar--{{ perfil.userId % 9 }} db-pf-avatar">{{ iniciais }}</span>
        {% endif %}
        <div class="db-pf-quem">
            <div class="db-pf-rotulo">{{ 'dashboard.pessoa.rotulo'|trans }}</div>
            <div class="db-pf-nome">{{ perfil.nome }}</div>
            <div class="db-pf-cargo">{{ perfil.cargo ?? 'dashboard.sem_cargo'|trans }} · {{ 'dashboard.pessoa.periodo_selecionado'|trans }}</div>
        </div>
    </div>

    <div class="db-pf-metricas">
        {% for m in perfil.metricas %}
            {% set rotulo = ('dashboard.pessoa.metrica.' ~ m.chave)|trans %}
            <div class="db-pf-metrica" data-metrica="{{ m.chave }}">
                <div class="db-pf-metrica-k">{{ rotulo }}</div>
                <div class="db-pf-metrica-v">
                    {%- if m.valor is null -%}
                        <span class="db-pf-sem-dado">{{ 'dashboard.pessoa.sem_dado'|trans }}</span>
                    {%- elseif m.temLink -%}
                        <a href="{{ path('tarefa_equipe', { status: m.statusDoLink, responsavel: perfil.userId }|merge(m.comPeriodo ? periodoLink : {})) }}" title="{{ 'dashboard.pessoa.abrir_lista'|trans({rotulo: rotulo, nome: perfil.nome}) }}">{{ m.valor }}{{ m.porcentagem ? '%' : '' }}</a>
                    {%- else -%}
                        {{ m.valor }}{{ m.porcentagem ? '%' : '' }}
                    {%- endif -%}
                </div>
            </div>
        {% endfor %}
    </div>

    <section class="db-pf-secao db-pf-comp" data-pf-comp>
        <div class="db-pf-secao-cab">
            <span class="db-pf-secao-t">{{ 'dashboard.pessoa.comparacao.titulo'|trans }}</span>
            {% if perfil.comparacoes %}<button type="button" class="db-pf-link" data-pf-comparar aria-expanded="false">{{ 'dashboard.pessoa.comparacao.comparar'|trans }}</button>{% endif %}
        </div>
        {% for c in perfil.comparacoes %}
            {% set v = c.variacao %}
            {% set tom = v is null or v == 0 or c.sentido == 'neutro' ? 'neutro' : ((v > 0) == (c.sentido == 'sobe_ruim') ? 'ruim' : 'bom') %}
            <div class="db-pf-comp-linha" data-comparacao="{{ c.chave }}">
                <span class="db-pf-comp-k">{{ ('dashboard.pessoa.comparacao.' ~ c.chave)|trans }}</span>
                <span class="db-pf-comp-barras">
                    <span class="db-pf-barra db-pf-barra--atual" style="width:{{ c.atual > 0 ? max(3, (c.atual / c.maior * 100)|round) : 0 }}%"></span>
                    <span class="db-pf-barra db-pf-barra--anterior" style="width:{{ c.anterior > 0 ? max(3, (c.anterior / c.maior * 100)|round) : 0 }}%"></span>
                </span>
                <span class="db-pf-comp-d db-pf-comp-d--{{ tom }}" title="{{ 'dashboard.pessoa.comparacao.de_para'|trans({anterior: c.anterior, atual: c.atual}) }}">{{ v is null ? (c.atual > 0 ? 'dashboard.pessoa.comparacao.novo'|trans : '0%') : (v > 0 ? '+' : (v < 0 ? '−' : '')) ~ (v|abs) ~ '%' }}</span>
            </div>
        {% else %}
            <div class="db-pf-vazio">{{ 'dashboard.pessoa.comparacao.sem_base'|trans }}</div>
        {% endfor %}
        {% if perfil.comparacoes %}<div class="db-pf-legenda" data-pf-legenda hidden>{{ 'dashboard.pessoa.comparacao.legenda'|trans }}</div>{% endif %}
    </section>

    <section class="db-pf-secao">
        <div class="db-pf-secao-cab"><span class="db-pf-secao-t">{{ 'dashboard.pessoa.diagnostico'|trans }}</span></div>
        {% for texto in perfil.motivos %}
            <div class="db-pf-motivo"><span class="db-pf-tag db-pf-tag--observado">{{ 'dashboard.pessoa.observado'|trans }}</span><span>{{ texto }}</span></div>
        {% endfor %}
    </section>

    <details class="db-pf-porque">
        <summary><i class="bi bi-question-circle" aria-hidden="true"></i>{{ 'dashboard.pessoa.por_que'|trans }}</summary>
        <div class="db-pf-porque-corpo">
            <div>{{ 'dashboard.pessoa.por_que_texto'|trans }}</div>
            <div class="db-pf-porque-h">{{ 'dashboard.pessoa.dados_considerados'|trans }}</div>
            {% for d in perfil.dados %}<div>→ {{ d }}</div>{% endfor %}
            <div class="db-pf-porque-h">{{ 'dashboard.pessoa.limites'|trans }}</div>
            {% for l in perfil.limites %}<div>→ {{ l }}</div>{% endfor %}
        </div>
    </details>

    <div class="db-pf-acoes">
        {% set recebidas = perfil.metricas|first %}
        {% if recebidas.temLink %}
            <a class="db-pf-btn" href="{{ path('tarefa_equipe', { status: 'todas', responsavel: perfil.userId }|merge(periodoLink)) }}">{{ 'dashboard.pessoa.ver_tarefas'|trans }}</a>
        {% endif %}
        <button type="button" class="db-pf-btn" data-pf-marcar="analisado" aria-pressed="{{ perfil.status == 'analisado' ? 'true' : 'false' }}">{{ 'dashboard.pessoa.marcar_analisado'|trans }}</button>
        <span class="db-pf-status db-pf-status--{{ status }}" data-pf-status data-rotulo-analisado="{{ 'dashboard.pessoa.status.analisado'|trans }}" data-rotulo-pendente="{{ 'dashboard.pessoa.status.pendente'|trans }}">{{ ('dashboard.pessoa.status.' ~ status)|trans }}</span>
    </div>

    <div class="db-pf-retorno">
        <span class="db-pf-retorno-pergunta">{{ 'dashboard.pessoa.feedback.pergunta'|trans }}</span>
        {% for k in ['sim', 'nao', 'parcial'] %}
            <button type="button" class="db-pf-btn db-pf-btn--mini" data-pf-marcar="{{ k }}" aria-pressed="{{ perfil.feedback == k ? 'true' : 'false' }}">{{ ('dashboard.pessoa.feedback.' ~ k)|trans }}</button>
        {% endfor %}
    </div>
</div>
