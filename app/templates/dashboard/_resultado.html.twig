{# ───────────────────────────────────────────────────────────────────────────
   Fragmento trocável do Dashboard (dentro de [data-filtro-resultado]).
   Cards de KPI + tabela por advogado, recalculados a cada filtro pelo motor
   public/js/filtro-tabela.js.
─────────────────────────────────────────────────────────────────────────── #}
{# ── "Atualizado às" ────────────────────────────────────────────────────────
   Mora no fragmento de propósito: cada XHR renova a hora. No flex do root ele
   fica na primeira linha, ao lado do título (order 0 no CSS da casca). #}
<div class="db-atualizado">
    <span class="db-atualizado-ponto"><span class="db-atualizado-anel"></span><span class="db-atualizado-nucleo"></span></span>
    <span>{{ 'dashboard.atualizado_as'|trans({hora: 'now'|hora}) }}</span>
</div>

{# ── Cards de métricas ──────────────────────────────────────────────────────
   Quatro cards na ordem do desenho: Pastas criadas · Metas ativas · Demandas
   urgentes · Meta global batida. Cada card entra por um WRAPPER (a animação de
   entrada não pode ficar no próprio card, senão trava o transform do hover).
   Sem glifo: o desenho VS 25.10.26 tirou os quatro SVGs (fica o halo com o anel no
   canto). `data-tip` é a dica do card (dc L2816-2819), que some depois de 3 passagens
   do mouse em cada card (dashboard.js, localStorage 'bj-dica-paineis').
   O número final já vem no HTML e em `data-alvo`: funciona sem JS; com JS,
   dashboard.js conta de 0 até ele (desligado em prefers-reduced-motion).
   Três cards trazem link para a lista que o número conta (DASH-006): Pastas
   criadas ("ver pastas", Acervo geral filtrado pelo criador), Metas ativas
   ("ver metas", /tarefas/equipe no escopo do card) e Demandas urgentes ("ver
   pastas"). Cada link leva os filtros que o card usa — e só esses —, para a
   lista bater com o número (DashboardCardsVerParidadeTest). #}
{% import 'dashboard/_tendencia.html.twig' as tend %}
{% import 'dashboard/_extras.html.twig' as extra %}
{% import 'dashboard/_inteligencia.html.twig' as iaui %}
{# Colunas extras ligadas pelo usuário ("Adicionar coluna"), na ordem da tabela: entram depois
   de Pastas criadas, no cabeçalho, em cada linha, no Total e no card do celular. #}
{% set extras = dashboard.colunasExtras %}
{% set extrasCatalogo = constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::CATALOGO') %}
{# Extras com tendência => sentido do macro tend.tendencia ('alta', 'baixa' ou 'fila'). Em revisão e
   Pastas urgentes comparam o estoque de hoje com a foto diária (ESTOQUE_COM_FOTO); concluídas, taxa
   e tempo médio ficam sem seta (DASH-010b). Motivo em ColunasExtrasDoDashboard::TENDENCIA. #}
{% set extrasTendencia = constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::TENDENCIA') %}
{% set extrasEstoque = constant('App\\Dashboard\\Preferencia\\ColunasExtrasDoDashboard::ESTOQUE_COM_FOTO') %}
{# Período do painel para os links "ir para o serviço": some quando o painel está sem
   período (o destino então lista sem recorte de data, como as contagens). #}
{% set periodoLink = { data_de: filtros.data_de|default(''), data_ate: filtros.data_ate|default('') }|filter(v => v != '') %}
{% set pct = dashboard.metaGlobalPercent %}
{# Botão direito num card abre a janela "Histórico" dele (DASH-017, public/js/dashboard-historico.js):
   `data-historico-url` é o endpoint GET do card. Pastas criadas tem série; os outros três mostram
   na janela por que ainda não têm (dependem da foto diária). #}
<div class="db-cards-row">

    <div class="db-card-wrap db-card-wrap--esq">
        <div class="db-stat-card db-stat-card--pastas" data-historico="pastas" data-historico-url="{{ path('dashboard_historico', { card: 'pastas' }) }}"{% if dashboard.metaDePastas is not null and podeMeta|default(false) %}
             data-db-meta-valor="{{ dashboard.metaDePastas.meta ?? 0 }}" data-db-meta-desde="{{ dashboard.metaDePastas.desde }}"
             data-db-meta-mes="{{ dashboard.metaDePastas.mes }}" data-db-meta-uteis="{{ dashboard.metaDePastas.diasUteisTotal }}"{% endif %} data-dica="3" data-tip="{{ 'dashboard.dicas_cards.pastas_criadas'|trans }}">
            <div class="db-card-glow"></div>
            <div class="db-card-grid"></div>
            <div class="db-card-linha"></div>
            <div class="db-card-base"></div>
            <div class="db-card-halo"><div class="db-card-anel"></div></div>
            <div class="db-card-corpo">
                <div class="db-card-rotulo-wrap"><span class="db-card-rotulo db-card-rotulo--1">{{ 'dashboard.cards.pastas_criadas'|trans }}</span></div>
                <div class="db-card-valor-linha">
                    <div class="db-stat-num" data-card="pastas" data-alvo="{{ dashboard.totalPastasCriadas }}">{{ dashboard.totalPastasCriadas }}</div>
                    {# "ver pastas": o card soma a coluna Pastas criadas, isto é, as pastas abertas
                       por colaborador ATIVO do escritório (e do cargo, se filtrado), sem lápide,
                       no período. No Acervo isso é `criado_por=equipe` (`equipe:<cargo>` com
                       cargo). Com responsável filtrado o card é a linha dele: `criado_por=<id>`,
                       o mesmo destino do número da linha. Responsável que não vira linha (fora do
                       cargo escolhido, ou id que não é número) deixa o card em 0 e a lista não
                       bateria com ele: aí o link não sai. Com "Zerar" ativo na coluna Pastas
                       criadas (DASH-014), também não: a lista não conta a partir do corte. #}
                    {% set respCard  = filtros.responsavel|default('') %}
                    {% set cargoCard = filtros.cargo|default('')|trim %}
                    {% set pastasQuery = null %}
                    {% if respCard == '' %}
                        {% set pastasQuery = { painel: 'acervo-geral', criado_por: cargoCard != '' ? 'equipe:' ~ cargoCard : 'equipe' }|merge(periodoLink) %}
                    {% elseif respCard matches '/^[1-9][0-9]*$/' and dashboard.totalPastasCriadas > 0 %}
                        {% set pastasQuery = { painel: 'acervo-geral', criado_por: respCard }|merge(periodoLink) %}
                    {% endif %}
                    {% if pastasQuery is not null and 'pastas_criadas' not in dashboard.zeramentos|keys %}
                        <a class="db-card-ver" href="{{ path('expediente_index', pastasQuery) }}" title="{{ 'dashboard.cards.abrir_pastas_criadas'|trans }}">{{ 'dashboard.cards.ver_pastas'|trans }}<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    {% endif %}
                </div>
                {# Sem legenda: o desenho mostra só o rótulo e o número neste card. Abaixo do número, a meta
                   de pastas do mês (DASH-016; só no mês inteiro, sem responsável nem cargo). #}
                {% if dashboard.metaDePastas is not null %}
                    {% include 'dashboard/_meta_pastas.html.twig' with { meta: dashboard.metaDePastas, podeMeta: podeMeta|default(false) } only %}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="db-card-wrap db-card-wrap--sobe1">
        <div class="db-stat-card db-stat-card--metas" data-historico="metas" data-historico-url="{{ path('dashboard_historico', { card: 'metas' }) }}" data-dica="0" data-tip="{{ 'dashboard.dicas_cards.metas_ativas'|trans }}">
            <div class="db-card-glow"></div>
            <div class="db-card-grid"></div>
            <div class="db-card-linha"></div>
            <div class="db-card-base"></div>
            <div class="db-card-halo"><div class="db-card-anel"></div></div>
            <div class="db-card-corpo">
                <div class="db-card-rotulo-wrap"><span class="db-card-rotulo db-card-rotulo--2">{{ 'dashboard.cards.metas_ativas'|trans }}</span></div>
                <div class="db-card-valor-linha">
                    <div class="db-stat-num" data-card="metas" data-alvo="{{ dashboard.totalMetasAtivas }}">{{ dashboard.totalMetasAtivas }}</div>
                    {# "ver metas": /tarefas/equipe no escopo do CARD (`escopo=card`), que conta
                       como countMetasAtivas — toda meta não concluída do escritório no período,
                       com o responsável quando filtrado. O cargo não vai: o card não o usa. #}
                    {% set metasQuery = { status: 'ativas', escopo: 'card' }
                        |merge(filtros.responsavel|default('') != '' ? { responsavel: filtros.responsavel } : {})
                        |merge(periodoLink) %}
                    <a class="db-card-ver" href="{{ path('tarefa_equipe', metasQuery) }}" title="{{ 'dashboard.cards.abrir_metas_ativas'|trans }}">{{ 'dashboard.cards.ver_metas'|trans }}<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="db-card-legenda db-card-legenda--hover">{{ 'dashboard.cards.legenda_metas_ativas'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="db-card-wrap db-card-wrap--sobe2">
        <div class="db-stat-card db-stat-card--urgentes" data-historico="urgentes" data-historico-url="{{ path('dashboard_historico', { card: 'urgentes' }) }}" data-dica="1" data-tip="{{ 'dashboard.dicas_cards.demandas_urgentes'|trans }}">
            <div class="db-card-glow"></div>
            <div class="db-card-grid"></div>
            <div class="db-card-linha"></div>
            <div class="db-card-base"></div>
            <div class="db-card-halo"><div class="db-card-anel"></div></div>
            <div class="db-card-corpo">
                <div class="db-card-rotulo-wrap"><span class="db-card-rotulo db-card-rotulo--3">{{ 'dashboard.cards.demandas_urgentes'|trans }}</span></div>
                <div class="db-card-valor-linha">
                    <div class="db-stat-num db-stat-num--urgente" data-card="urgentes" data-alvo="{{ dashboard.demandasUrgentes }}">{{ dashboard.demandasUrgentes }}</div>
                    {# "ver pastas": Acervo geral do Expediente com prioridade urgente. Leva o
                       período (o card conta com período) e o responsável quando o painel está
                       filtrado por ele, para a lista bater com o número. #}
                    {% set urgQuery = { painel: 'acervo-geral', prioridade: 'urgente' }
                        |merge(filtros.responsavel|default('') != '' ? { responsavel: filtros.responsavel } : {})
                        |merge(periodoLink) %}
                    <a class="db-card-ver" href="{{ path('expediente_index', urgQuery) }}" title="{{ 'dashboard.cards.abrir_pastas_urgentes'|trans }}">{{ 'dashboard.cards.ver_pastas'|trans }}<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="db-card-legenda db-card-legenda--hover">{{ 'dashboard.cards.legenda_urgentes'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="db-card-wrap db-card-wrap--dir">
        <div class="db-stat-card db-stat-card--global" data-historico="global" data-historico-url="{{ path('dashboard_historico', { card: 'global' }) }}" data-dica="2" data-tip="{{ 'dashboard.dicas_cards.meta_global'|trans }}">
            <div class="db-card-glow"></div>
            <div class="db-card-grid"></div>
            <div class="db-card-linha"></div>
            <div class="db-card-base"></div>
            <div class="db-card-halo"><div class="db-card-anel"></div></div>
            <div class="db-card-corpo">
                <div class="db-card-rotulo-wrap"><span class="db-card-rotulo db-card-rotulo--4">{{ 'dashboard.cards.meta_global_batida'|trans }}</span></div>
                <div class="db-card-valor-linha db-card-valor-linha--pct">
                    <div class="db-stat-num" data-card="global" data-alvo="{{ pct }}">{{ pct }}</div>
                    <div class="db-stat-pct">%</div>
                </div>
                <div class="db-barra" style="--db-pct:{{ pct }}%">
                    <div class="db-barra-marca" style="left:25%"></div>
                    <div class="db-barra-marca" style="left:50%"></div>
                    <div class="db-barra-marca" style="left:75%"></div>
                    <div class="db-barra-fill"><div class="db-barra-brilho"></div></div>
                </div>
                <div class="db-card-legenda">
                    <span class="db-card-legenda-num">{{ dashboard.metasConcluidas }}</span> {{ 'dashboard.cards.legenda_global_de'|trans }}
                    <span class="db-card-legenda-num">{{ dashboard.metasTotal }}</span> {{ 'dashboard.cards.legenda_global_metas_concluidas'|trans }}
                </div>
            </div>
        </div>
    </div>

</div>

{# ── Tabela "Desempenho" ──────────────────────────────────────────────────────
   Continua uma TABLE: a ordenação (th[data-ordenar] + filtro-tabela.js) e os
   testes dependem dela. A linha de Total vive no TFOOT — nunca no TBODY,
   que é onde os testes contam colaboradores. As somas são feitas aqui com
   |reduce sobre as linhas já filtradas (período, responsável, cargo). #}
{% set linhas = dashboard.porAdvogado %}
{% set qtd = linhas|length %}
<div class="db-table-card">
    <div class="db-table-header">
        <span class="db-table-titulo">{{ 'dashboard.tabela.titulo'|trans }}</span>
        <span class="db-contador" title="{{ qtd == 1 ? 'dashboard.tabela.um_colaborador'|trans : 'dashboard.tabela.n_colaboradores'|trans({n: qtd ~ ''}) }}" aria-label="{{ qtd == 1 ? 'dashboard.tabela.um_colaborador'|trans : 'dashboard.tabela.n_colaboradores'|trans({n: qtd ~ ''}) }}"><i class="bi bi-people-fill"></i><span class="db-contador-num">{{ qtd }}</span></span>
        {# Busca de colaborador recolhida (desenho): só a lupa; ao clicar abre para 260px com
           o campo focado; fecha ao sair se vazio; Esc limpa e fecha. Este campo NÃO tem
           `name`: quem vai na query é o `.js-filtro-busca` escondido no form da casca, que o
           dashboard.js mantém igual a este. O nó é reaproveitado entre recargas (o foco e
           o cursor sobrevivem ao XHR). Fica fora do `if` de linhas vazias: sem resultado,
           ainda dá para apagar a busca. #}
        {% set buscaAtual = filtros.busca|default('') %}
        <div class="db-busca{{ buscaAtual != '' ? ' is-aberta' : '' }}">
            <button type="button" class="db-busca-lupa js-db-busca-abrir" title="{{ 'dashboard.filtros.buscar_colaborador'|trans }}" aria-label="{{ 'dashboard.filtros.buscar_colaborador'|trans }}"><i class="bi bi-search" aria-hidden="true"></i></button>
            <input type="text" class="db-busca-input js-db-busca" placeholder="{{ 'dashboard.filtros.buscar_colaborador'|trans }}" aria-label="{{ 'dashboard.filtros.buscar_colaborador'|trans }}" autocomplete="off" value="{{ buscaAtual }}" tabindex="{{ buscaAtual != '' ? '0' : '-1' }}">
        </div>
    </div>
    {# Celular (< 768px): lista de cards com as mesmas linhas; a tabela abaixo segue no DOM. #}
    {{ include('dashboard/_desempenho_cards.html.twig') }}
    <div class="table-responsive db-table-scroll">
        {# Sem linhas a tabela continua com a linha de cabeçalhos (desenho); o aviso de
           vazio fica DEPOIS dela, fora do <tbody>, porque os testes contam
           `table > tbody > tr` como gente. #}
        {# Mais de 8 numéricas (as 7 + 2 extras ou mais): mínimo de 52px por coluna e, se
           ainda não couber, rolagem com Colaborador fixa (desenho, "Adicionar coluna"). #}
        {# `data-db-zeramentos`: os cortes ativos do "Zerar" (DASH-014), para o menu do botão direito
           da coluna (public/js/dashboard-zerar.js) mostrar "Contando desde" e "Desfazer zeramentos". #}
        <table class="table db-table mb-0{{ 2 <= extras|length ? ' db-table--larga' : '' }}" data-db-zeramentos="{{ dashboard.zeramentos|json_encode|e('html_attr') }}">
            <thead>
                {# Ordenação por clique no cabeçalho (padrão Expediente): o th leva `data-ordenar`,
                   o motor filtro-tabela.js grava nos hidden ordenar/direcao do form e recarrega o
                   fragmento. A classe asc/desc pinta a coluna ordenada e vira o chevron (CSS na casca). #}
                {# Mesmo critério do UseCase (e do _desempenho_cards): coluna vazia ou
                   desconhecida = Total metas decrescente, já pintada desde a abertura. #}
                {% set ordPedido = filtros.ordenar|default('') %}
                {% set ordValida = ordPedido in ['advogado', 'cargo', 'metas', 'metas_ativas', 'metas_vencidas', 'prazos', 'demandas', 'demandas_ativas', 'pastas_criadas'] or ordPedido in extras %}
                {% set ordCol = ordValida ? ordPedido : 'metas' %}
                {% set ordDir = ordValida and filtros.direcao|default('') == 'asc' ? 'asc' : 'desc' %}
                <tr>
                    <th class="sortable db-th-colab{{ ordCol == 'advogado' ? ' ' ~ ordDir : '' }}" data-ordenar="advogado">{{ 'dashboard.tabela.colaborador'|trans }} <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="sortable db-th-cargo{{ ordCol == 'cargo' ? ' ' ~ ordDir : '' }}" data-ordenar="cargo" data-coluna="cargo">{{ 'dashboard.tabela.cargo'|trans }} <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="sortable text-center db-th-num{{ ordCol == 'metas' ? ' ' ~ ordDir : '' }}" data-ordenar="metas" data-coluna="metas" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.total_metas'|trans }}</th>
                    <th class="sortable text-center db-th-num{{ ordCol == 'metas_ativas' ? ' ' ~ ordDir : '' }}" data-ordenar="metas_ativas" data-coluna="metas_ativas" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.metas_ativas'|trans }}</th>
                    <th class="sortable text-center db-th-num{{ ordCol == 'metas_vencidas' ? ' ' ~ ordDir : '' }}" data-ordenar="metas_vencidas" data-coluna="metas_vencidas" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.metas_vencidas'|trans }}</th>
                    <th class="sortable text-center db-th-num{{ ordCol == 'prazos' ? ' ' ~ ordDir : '' }}" data-ordenar="prazos" data-coluna="prazos" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.prazos_proximos'|trans }}</th>
                    <th class="sortable text-center db-th-num{{ ordCol == 'demandas' ? ' ' ~ ordDir : '' }}" data-ordenar="demandas" data-coluna="demandas" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.total_demandas'|trans }}</th>
                    <th class="sortable text-center db-th-num{{ ordCol == 'demandas_ativas' ? ' ' ~ ordDir : '' }}" data-ordenar="demandas_ativas" data-coluna="demandas_ativas" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.demandas_ativas'|trans }}</th>
                    {# Por quem ABRIU a pasta (criadoPor) — as duas colunas acima são por responsável. #}
                    <th class="sortable text-center db-th-num{{ ordCol == 'pastas_criadas' ? ' ' ~ ordDir : '' }}" data-ordenar="pastas_criadas" data-coluna="pastas_criadas" title="{{ 'dashboard.zerar.th_titulo'|trans }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ 'dashboard.tabela.pastas_criadas'|trans }}</th>
                    {% for k in extras %}
                    <th class="sortable text-center db-th-num db-th-extra{{ ordCol == k ? ' ' ~ ordDir : '' }}" data-ordenar="{{ k }}" data-coluna="{{ k }}" data-extra title="{{ extra.titulo(k) }} · {{ 'dashboard.zerar.th_titulo'|trans|lower }}"><i class="bi bi-chevron-expand sort-icon"></i> {{ extrasCatalogo[k].rotulo }}</th>
                    {% endfor %}
                </tr>
            </thead>
            {% if linhas is not empty %}
            <tbody>
                {% for linha in linhas %}
                {# avatar: uma das 9 cores do desenho, escolhida pelo id (estável entre recargas) #}
                {% set av = linha.userId % 9 %}
                {% set partes = linha.nomeAdvogado|split(' ')|filter(p => p != '') %}
                {% set iniciais = partes|slice(0, 2)|map(p => p|slice(0, 1))|join|upper %}
                {# Abaixo de 1100px o desenho mostra "Samuel F." (primeiro nome + inicial do
                   último); o CSS troca um pelo outro e o completo segue no title. #}
                {% set nomeCurto = partes|length > 1 ? partes|first ~ ' ' ~ (partes|last)|slice(0, 1) ~ '.' : linha.nomeAdvogado %}
                {# ícone do cargo: mapa visual do desenho; o nome do cargo é livre no sistema #}
                {% set cargoLower = (linha.cargoNome ?? '')|lower %}
                {% set cargoIcone = linha.cargoNome is null ? 'bi-dash-circle'
                    : ('sóci' in cargoLower or 'soci' in cargoLower) ? 'bi-award'
                    : ('advog' in cargoLower) ? 'bi-briefcase'
                    : ('estagi' in cargoLower) ? 'bi-mortarboard'
                    : ('paraleg' in cargoLower) ? 'bi-journal-text'
                    : ('financ' in cargoLower) ? 'bi-cash-coin'
                    : 'bi-person-badge' %}
                {# Troféu (spec dashboard-parte-1): só na linha do campeão, que o UseCase escolhe entre TODOS
                   os colaboradores ativos, antes da busca e dos filtros. O hover da linha anima o troféu
                   (CSS) e toca a fanfarra (dashboard-campeao.js). #}
                {% set campeao = dashboard.campeaoId is not null and linha.userId == dashboard.campeaoId %}
                <tr data-db-pessoa="{{ linha.userId }}"{% if campeao %} class="db-tr-campeao" data-db-campeao{% endif %}>
                    <td class="db-td-colab">
                        {# Botão direito no nome: cartão do colaborador (ranking), janela flutuante. #}
                        <div class="db-colab" data-db-colab-url="{{ path('dashboard_colaborador_ranking', {id: linha.userId}) }}"
                             data-db-colab-nome="{{ linha.nomeAdvogado }}" data-db-colab-av="{{ av }}"
                             title="{{ 'dashboard.tabela.botao_direito_desempenho'|trans({nome: linha.nomeAdvogado}) }}">
                            {% if linha.fotoUrl %}
                                <img src="{{ path('app_profile_foto_serve', {nome: linha.fotoUrl}) }}"
                                     alt="{{ linha.nomeAdvogado }}"
                                     class="db-avatar db-avatar-img"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                                <span class="collab-avatar-inicial db-avatar db-avatar--{{ av }}" style="display:none">{{ iniciais }}</span>
                            {% else %}
                                <span class="collab-avatar-inicial db-avatar db-avatar--{{ av }}">{{ iniciais }}</span>
                            {% endif %}
                            <span class="db-colab-nome" title="{{ linha.nomeAdvogado }}"><span class="db-nome-completo">{{ linha.nomeAdvogado }}</span><span class="db-nome-curto">{{ nomeCurto }}</span></span>
                            {% if campeao %}<i class="bi bi-trophy-fill db-trofeu" title="{{ 'dashboard.tabela.trofeu_titulo'|trans }}" aria-label="{{ 'dashboard.tabela.trofeu_rotulo'|trans }}"></i>{% endif %}
                            {# Análise individual (dc L720): abre o painel BlueJus Intelligence na pessoa (dashboard-perfil-pessoa.js). Quem não é Master nem primário vê o botão bloqueado, com o texto do desenho. #}
                            {% if podeAnalisarPessoa|default(false) %}
                                <button type="button" class="db-pf-abrir" data-pf-abrir data-url="{{ path('dashboard_inteligencia_pessoa', {id: linha.userId}) }}" title="{{ 'dashboard.pessoa.abrir_analise'|trans({nome: linha.nomeAdvogado}) }}" aria-label="{{ 'dashboard.pessoa.abrir_analise'|trans({nome: linha.nomeAdvogado}) }}">{{ iaui.estrela(15) }}</button>
                            {% else %}
                                <button type="button" class="db-pf-abrir" disabled aria-disabled="true" title="{{ 'dashboard.pessoa.bloqueado'|trans }}" aria-label="{{ 'dashboard.pessoa.bloqueado'|trans }}">{{ iaui.estrela(15) }}</button>
                            {% endif %}
                        </div>
                    </td>
                    <td class="db-td-cargo" data-coluna="cargo">
                        <span class="db-cargo{{ linha.cargoNome is null ? ' db-cargo--vazio' : '' }}"><i class="bi {{ cargoIcone }}"></i><span>{{ linha.cargoNome ?? 'dashboard.sem_cargo'|trans }}</span></span>
                    </td>
                    {# Números de METAS e de PASTAS > 0 são links para a lista que eles contam,
                       já filtrada pela pessoa (e pelo período, quando a métrica usa período).
                       Zero não é link. Vencidas e prazos próximos são relativos a hoje: o link
                       vai sem período, como a contagem. #}
                    {% set quem = linha.nomeAdvogado %}
                    {% set qPessoa = { responsavel: linha.userId } %}
                    {# "Zerar" (DASH-014): coluna com corte para esta pessoa não vira link (a lista não conta a
                       partir do corte, regra B12) nem ganha seta (o período anterior é de antes do corte). #}
                    {% set zr = linha.colunasZeradas %}
                    {% set comSeta = linha.totalMetasAnterior is not null %}
                    <td class="text-center db-td-num" data-coluna="metas"><span class="db-cel{{ comSeta ? ' db-cel--seta' : '' }}">
                        {%- if linha.totalMetas > 0 and 'metas' not in zr -%}
                            <a class="db-num db-num-link" href="{{ path('tarefa_equipe', { status: 'todas' }|merge(qPessoa)|merge(periodoLink)) }}" title="{{ 'dashboard.tabela.abrir_metas'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_metas'|trans({nome: quem}) }}">{{ linha.totalMetas }}</a>
                        {%- elseif linha.totalMetas > 0 -%}
                            <span class="db-num">{{ linha.totalMetas }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.totalMetas, 'metas' in zr ? null : linha.totalMetasAnterior, 'seta') -}}
                    </span></td>
                    <td class="text-center db-td-num" data-coluna="metas_ativas">
                        {% set antE = 'metas_ativas' in zr ? null : (linha.estoque.anterior.metas_ativas ?? null) %}
                        <span class="db-cel{{ antE is not null ? ' db-cel--seta' : '' }}">
                        {%- if linha.metasAtivas > 0 and 'metas_ativas' not in zr -%}
                            <a class="db-num db-num-link" href="{{ path('tarefa_equipe', { status: 'ativas' }|merge(qPessoa)|merge(periodoLink)) }}" title="{{ 'dashboard.tabela.abrir_metas_ativas'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_metas_ativas'|trans({nome: quem}) }}">{{ linha.metasAtivas }}</a>
                        {%- elseif linha.metasAtivas > 0 -%}
                            <span class="db-num">{{ linha.metasAtivas }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.estoque.atual.metas_ativas ?? 0, antE, 'seta', 'fila') -}}
                    </span></td>
                    {# Vencidas e Prazos: seta comparando com a foto de data_de − 1 desta pessoa
                       (cair é bom: sentido 'baixa'). Sem foto dela naquele dia, sem seta. #}
                    {% set comSetaVenc = linha.metasVencidasAnterior is not null %}
                    {% set comSetaPraz = linha.prazosProximosAnterior is not null %}
                    <td class="text-center db-td-num" data-coluna="metas_vencidas"><span class="db-cel{{ comSetaVenc ? ' db-cel--seta' : '' }}">
                        {%- if linha.metasVencidas > 0 and 'metas_vencidas' not in zr -%}
                            <a class="db-pill db-pill--venc db-num-link" href="{{ path('tarefa_equipe', { status: 'vencidas' }|merge(qPessoa)) }}" title="{{ 'dashboard.tabela.abrir_metas_vencidas'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_metas_vencidas'|trans({nome: quem}) }}"><span class="db-pill-dot"></span>{{ linha.metasVencidas }}</a>
                        {%- elseif linha.metasVencidas > 0 -%}
                            <span class="db-num">{{ linha.metasVencidas }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.metasVencidas, 'metas_vencidas' in zr ? null : linha.metasVencidasAnterior, 'seta', 'baixa') -}}
                    </span></td>
                    <td class="text-center db-td-num" data-coluna="prazos"><span class="db-cel{{ comSetaPraz ? ' db-cel--seta' : '' }}">
                        {%- if linha.prazosProximos > 0 and 'prazos' not in zr -%}
                            <a class="db-pill db-pill--praz db-num-link" href="{{ path('tarefa_equipe', { status: 'prazo_proximo' }|merge(qPessoa)) }}" title="{{ 'dashboard.tabela.abrir_prazo_proximo'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_prazo_proximo'|trans({nome: quem}) }}"><span class="db-pill-dot"></span>{{ linha.prazosProximos }}</a>
                        {%- elseif linha.prazosProximos > 0 -%}
                            <span class="db-num">{{ linha.prazosProximos }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.prazosProximos, 'prazos' in zr ? null : linha.prazosProximosAnterior, 'seta', 'baixa') -}}
                    </span></td>
                    <td class="text-center db-td-num" data-coluna="demandas"><span class="db-cel{{ comSeta ? ' db-cel--seta' : '' }}">
                        {%- if linha.totalDemandas > 0 and 'demandas' not in zr -%}
                            <a class="db-num db-num-link" href="{{ path('expediente_index', { painel: 'acervo-geral' }|merge(qPessoa)|merge(periodoLink)) }}" title="{{ 'dashboard.tabela.abrir_pastas'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_pastas'|trans({nome: quem}) }}">{{ linha.totalDemandas }}</a>
                        {%- elseif linha.totalDemandas > 0 -%}
                            <span class="db-num">{{ linha.totalDemandas }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.totalDemandas, 'demandas' in zr ? null : linha.totalDemandasAnterior, 'seta') -}}
                    </span></td>
                    <td class="text-center db-td-num" data-coluna="demandas_ativas">
                        {% set antE = 'demandas_ativas' in zr ? null : (linha.estoque.anterior.demandas_ativas ?? null) %}
                        <span class="db-cel{{ antE is not null ? ' db-cel--seta' : '' }}">
                        {%- if linha.demandasAtivas > 0 and 'demandas_ativas' not in zr -%}
                            <a class="db-num db-num-link" href="{{ path('expediente_index', { painel: 'acervo-geral' }|merge(qPessoa)|merge({ status: 'ativo' })|merge(periodoLink)) }}" title="{{ 'dashboard.tabela.abrir_pastas_ativas'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_pastas_ativas'|trans({nome: quem}) }}">{{ linha.demandasAtivas }}</a>
                        {%- elseif linha.demandasAtivas > 0 -%}
                            <span class="db-num">{{ linha.demandasAtivas }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.estoque.atual.demandas_ativas ?? 0, antE, 'seta', 'fila') -}}
                    </span></td>
                    {# Por quem ABRIU a pasta: o link filtra por criado_por, sem responsável. #}
                    <td class="text-center db-td-num" data-coluna="pastas_criadas"><span class="db-cel{{ comSeta ? ' db-cel--seta' : '' }}">
                        {%- if linha.pastasCriadas > 0 and 'pastas_criadas' not in zr -%}
                            <a class="db-num db-num-link" href="{{ path('expediente_index', { painel: 'acervo-geral', criado_por: linha.userId }|merge(periodoLink)) }}" title="{{ 'dashboard.tabela.abrir_pastas_criadas'|trans({nome: quem}) }}" aria-label="{{ 'dashboard.tabela.abrir_pastas_criadas'|trans({nome: quem}) }}">{{ linha.pastasCriadas }}</a>
                        {%- elseif linha.pastasCriadas > 0 -%}
                            <span class="db-num">{{ linha.pastasCriadas }}</span>
                        {%- else -%}
                            <span class="db-num db-num--zero">0</span>
                        {%- endif -%}
                        {{- tend.tendencia(linha.pastasCriadas, 'pastas_criadas' in zr ? null : linha.pastasCriadasAnterior, 'seta') -}}
                    </span></td>
                    {# Extras com tendência: seta igual à das colunas fixas (período anterior de
                       mesma duração, mesma fórmula). Sem o que medir num dos lados (taxa sem
                       meta, tempo sem conclusão com data), espaço da seta reservado e vazio. #}
                    {% for k in extras %}
                    {% set sentidoX = extrasTendencia[k] ?? null %}
                    {% set comSetaX = sentidoX is not null and k in linha.extrasAnteriores|keys %}
                    {% set atualX = linha.extras[k] ?? null %}
                    {% set antX = k in zr ? null : (linha.extrasAnteriores[k] ?? null) %}
                    {# Estoque com seta pela foto (Em revisão, Pastas urgentes): o atual é o estoque de hoje, não o da célula. #}
                    {% set estX = extrasEstoque[k] ?? null %}
                    {% set antE = estX is not null and k not in zr ? (linha.estoque.anterior[k] ?? null) : null %}
                    <td class="text-center db-td-num db-td-extra" data-coluna="{{ k }}">
                        {%- if comSetaX -%}
                            <span class="db-cel db-cel--seta">
                                {{- extra.valor(k, atualX, k in zr ? null : linha.userId, quem, periodoLink, linha.userId) -}}
                                {%- if atualX is not null and antX is not null -%}
                                    {{- tend.tendencia(atualX, antX, 'seta', sentidoX) -}}
                                {%- else -%}
                                    <span class="db-seta db-seta--vazia" aria-hidden="true"></span>
                                {%- endif -%}
                            </span>
                        {%- elseif antE is not null -%}
                            <span class="db-cel db-cel--seta">
                                {{- extra.valor(k, atualX, k in zr ? null : linha.userId, quem, periodoLink) -}}
                                {{- tend.tendencia(linha.estoque.atual[k] ?? 0, antE, 'seta', estX.sentido) -}}
                            </span>
                        {%- else -%}
                            {{- extra.valor(k, atualX, k in zr ? null : linha.userId, quem, periodoLink, linha.userId) -}}
                        {%- endif -%}
                    </td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </tbody>
            {# Linha de Total: soma de cada coluna das linhas visíveis. Como diz a nota de rodapé,
               pode passar do total do card (meta com vários responsáveis conta para cada um). #}
            {% set tMetas   = linhas|reduce((c, l) => c + l.totalMetas, 0) %}
            {% set tAtivas  = linhas|reduce((c, l) => c + l.metasAtivas, 0) %}
            {% set tVenc    = linhas|reduce((c, l) => c + l.metasVencidas, 0) %}
            {% set tPraz    = linhas|reduce((c, l) => c + l.prazosProximos, 0) %}
            {% set tDem     = linhas|reduce((c, l) => c + l.totalDemandas, 0) %}
            {% set tDemA    = linhas|reduce((c, l) => c + l.demandasAtivas, 0) %}
            {% set tCriadas = linhas|reduce((c, l) => c + l.pastasCriadas, 0) %}
            {# Tendência do Total: anteriores somados das MESMAS linhas visíveis (servidor). Os
               números do Total não são link: a soma conta duas vezes a meta com dois
               responsáveis, e a lista de destino não. #}
            {% set tAnt = dashboard.totaisAnteriores %}
            {% set tEst = dashboard.totaisEstoque %}
            {# Coluna com algum "Zerar" ativo: o Total não compara com o período anterior (espaçador no lugar da pílula). #}
            {% set zc = dashboard.zeramentos|keys %}
            {# Toda célula do Total empilha número + pílula (desenho). Vencidas e Prazos só
               ganham pílula quando existe a foto de data_de − 1 (valor anterior não nulo);
               Metas/Demandas ativas não têm tendência (bases diferentes da foto). Sem pílula,
               com período ativo, um espaçador invisível do tamanho dela deixa os 7 números na
               mesma altura. Sem período não há pílula. #}
            {% set antVenc    = tAnt is null or 'metas_vencidas' in zc ? null : tAnt.metas_vencidas %}
            {% set antPraz    = tAnt is null or 'prazos' in zc ? null : tAnt.prazos %}
            <tfoot>
                <tr class="db-total-row">
                    <th scope="row" class="db-td-colab">
                        <div class="db-colab">
                            <span class="db-total-rotulo">{{ 'dashboard.tabela.total'|trans }}</span>
                        </div>
                    </th>
                    <td class="db-td-cargo" data-coluna="cargo"></td>
                    <td class="text-center db-td-num" data-coluna="metas"><span class="db-total-cel"><span class="db-total-num">{{ tMetas }}</span>{% if tAnt is not null and 'metas' in zc %}<span class="db-total-espaco" aria-hidden="true"></span>{% else %}{{ tend.tendencia(tMetas, tAnt is null ? null : tAnt.metas, 'pilula') }}{% endif %}</span></td>
                    <td class="text-center db-td-num" data-coluna="metas_ativas"><span class="db-total-cel"><span class="db-total-num">{{ tAtivas }}</span>{% set antE = tEst is null or 'metas_ativas' in zc ? null : tEst.anterior.metas_ativas %}{% if antE is not null %}{{ tend.tendencia(tEst.atual.metas_ativas, antE, 'pilula', 'fila') }}{% elseif tAnt is not null %}<span class="db-total-espaco" aria-hidden="true"></span>{% endif %}</span></td>
                    <td class="text-center db-td-num" data-coluna="metas_vencidas"><span class="db-total-cel"><span class="db-total-num db-total-num--venc">{{ tVenc }}</span>{% if antVenc is not null %}{{ tend.tendencia(tVenc, antVenc, 'pilula', 'baixa') }}{% elseif tAnt is not null %}<span class="db-total-espaco" aria-hidden="true"></span>{% endif %}</span></td>
                    <td class="text-center db-td-num" data-coluna="prazos"><span class="db-total-cel"><span class="db-total-num db-total-num--praz">{{ tPraz }}</span>{% if antPraz is not null %}{{ tend.tendencia(tPraz, antPraz, 'pilula', 'baixa') }}{% elseif tAnt is not null %}<span class="db-total-espaco" aria-hidden="true"></span>{% endif %}</span></td>
                    <td class="text-center db-td-num" data-coluna="demandas"><span class="db-total-cel"><span class="db-total-num">{{ tDem }}</span>{% if tAnt is not null and 'demandas' in zc %}<span class="db-total-espaco" aria-hidden="true"></span>{% else %}{{ tend.tendencia(tDem, tAnt is null ? null : tAnt.demandas, 'pilula') }}{% endif %}</span></td>
                    <td class="text-center db-td-num" data-coluna="demandas_ativas"><span class="db-total-cel"><span class="db-total-num">{{ tDemA }}</span>{% set antE = tEst is null or 'demandas_ativas' in zc ? null : tEst.anterior.demandas_ativas %}{% if antE is not null %}{{ tend.tendencia(tEst.atual.demandas_ativas, antE, 'pilula', 'fila') }}{% elseif tAnt is not null %}<span class="db-total-espaco" aria-hidden="true"></span>{% endif %}</span></td>
                    <td class="text-center db-td-num" data-coluna="pastas_criadas"><span class="db-total-cel"><span class="db-total-num">{{ tCriadas }}</span>{% if tAnt is not null and 'pastas_criadas' in zc %}<span class="db-total-espaco" aria-hidden="true"></span>{% else %}{{ tend.tendencia(tCriadas, tAnt is null ? null : tAnt.pastas_criadas, 'pilula') }}{% endif %}</span></td>
                    {# Extras: o Total vem pronto do servidor (soma; % e dias pela base inteira).
                       Só "Pastas concluídas" é link (macro extra.total); os demais não são. As com tendência ganham a
                       pílula (Total anterior pela mesma regra, sobre as mesmas linhas); as
                       outras, o espaçador. #}
                    {% set tAntX = dashboard.totaisExtrasAnteriores %}
                    {% for k in extras %}
                    {% set tx = dashboard.totaisExtras[k] ?? null %}
                    {% set tipoX = extrasCatalogo[k].tipo %}
                    {% set sentidoX = extrasTendencia[k] ?? null %}
                    {% set antTx = tAntX is null or k in zc ? null : (tAntX[k] ?? null) %}
                    <td class="text-center db-td-num db-td-extra" data-coluna="{{ k }}"><span class="db-total-cel">{% set estX = extrasEstoque[k] ?? null %}{% set antE = estX is not null and tEst is not null and k not in zc ? (tEst.anterior[k] ?? null) : null %}{{ extra.total(k, tx is null ? 'dashboard.extras.sem_dado'|trans : (tipoX == 'pct' ? tx ~ '%' : (tipoX == 'dias' ? 'dashboard.extras.valor_dias'|trans({n: tx ~ ''}) : tx)), tx, linhas, filtros.cargo|default(''), filtros.busca|default('') != '' or k in zc, periodoLink) }}{% if sentidoX is not null and tx is not null and antTx is not null %}{{ tend.tendencia(tx, antTx, 'pilula', sentidoX) }}{% elseif antE is not null %}{{ tend.tendencia(tEst.atual[k], antE, 'pilula', estX.sentido) }}{% elseif tAnt is not null %}<span class="db-total-espaco" aria-hidden="true"></span>{% endif %}</span></td>
                    {% endfor %}
                </tr>
            </tfoot>
            {% endif %}
        </table>
        {% if linhas is empty %}
        <div class="db-empty">
            <i class="bi bi-people"></i>
            {{ 'dashboard.tabela.vazio'|trans }}
        </div>
        {% endif %}
    </div>
    <div class="db-nota">
        <i class="bi bi-info-circle"></i>
        <span>{{ 'dashboard.tabela.nota'|trans }}</span>
    </div>
</div>
