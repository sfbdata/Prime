{% extends 'base.html.twig' %}

{% import _self as auditHelper %}

{% macro formatAuditValue(value) %}
    {% if value is same as(null) %}
        -
    {% elseif value is same as(true) %}
        true
    {% elseif value is same as(false) %}
        false
    {% elseif value is iterable %}
        {{ value|json_encode }}
    {% else %}
        {{ value }}
    {% endif %}
{% endmacro %}

{% macro actionBadgeClass(action) %}
    {% if action == 'create' %}
        text-bg-success
    {% elseif action == 'update' %}
        text-bg-primary
    {% elseif action == 'delete' %}
        text-bg-danger
    {% else %}
        text-bg-secondary
    {% endif %}
{% endmacro %}

{% macro entityRef(item) %}
    {% if item is iterable %}
        {% set label = item.label ?? null %}
        {% set className = item.class is defined ? (item.class|split('\\')|last) : 'auditoria.entidade'|trans %}
        {% set id = item.id ?? null %}
        {% if label %}
            {{ label }}
        {% else %}
            {{ className }}
            {% if id %} #{{ id }}{% endif %}
        {% endif %}
    {% else %}
        -
    {% endif %}
{% endmacro %}

{% block title %}{{ 'auditoria.titulo'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0">{{ 'auditoria.titulo'|trans }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# Filtros #}
        <div class="card card-outline card-primary mb-3">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-funnel me-1"></i> {{ 'auditoria.filtros'|trans }}</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-bs-toggle="collapse" data-bs-target="#filtrosAudit">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                </div>
            </div>
            <div class="collapse show" id="filtrosAudit">
                <div class="card-body">
                    <form method="get" action="{{ path('audit_log_index') }}">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="entity" class="form-label">{{ 'auditoria.entidade'|trans }}</label>
                                <select id="entity" name="entity" class="form-control select2-filter">
                                    <option value="">{{ 'auditoria.todas'|trans }}</option>
                                    {% for option in entityOptions %}
                                        <option value="{{ option.value }}" {{ filters.entity == option.value ? 'selected' : '' }}>{{ option.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="user" class="form-label">{{ 'auditoria.usuario'|trans }}</label>
                                <select id="user" name="user" class="form-control select2-filter">
                                    <option value="">{{ 'auditoria.todos'|trans }}</option>
                                    {% for option in userOptions %}
                                        <option value="{{ option.value }}" {{ filters.user == option.value ? 'selected' : '' }}>{{ option.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="date_from" class="form-label">{{ 'auditoria.data_inicial'|trans }}</label>
                                <input type="date" id="date_from" name="date_from" class="form-control" value="{{ filters.date_from }}">
                            </div>
                            <div class="col-md-2">
                                <label for="date_to" class="form-label">{{ 'auditoria.data_final'|trans }}</label>
                                <input type="date" id="date_to" name="date_to" class="form-control" value="{{ filters.date_to }}">
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search me-1"></i> {{ 'auditoria.filtrar'|trans }}
                                </button>
                                <a href="{{ path('audit_log_index') }}" class="btn btn-secondary">
                                    <i class="bi bi-x-lg me-1"></i> {{ 'auditoria.limpar'|trans }}
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted"><i class="bi bi-list-ul me-1"></i> {{ 'auditoria.resultados_pagina'|trans({n: auditLogs|length ~ ''}) }}{% if pagination.total_items is defined %} {{ 'auditoria.resultados_total'|trans({total: pagination.total_items ~ ''}) }}{% endif %}</span>
        </div>

        <div class="card">
            <div class="card-body table-responsive p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th><i class="bi bi-clock me-1"></i> {{ 'auditoria.col_data_hora'|trans }}</th>
                            <th><i class="bi bi-person me-1"></i> {{ 'auditoria.usuario'|trans }}</th>
                            <th><i class="bi bi-box me-1"></i> {{ 'auditoria.entidade'|trans }}</th>
                            <th><i class="bi bi-activity me-1"></i> {{ 'auditoria.col_acao'|trans }}</th>
                            <th><i class="bi bi-card-text me-1"></i> {{ 'auditoria.col_resumo'|trans }}</th>
                            <th><i class="bi bi-eye me-1"></i> {{ 'auditoria.col_alteracoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in auditLogs %}
                            {% set payload = log.changes ?? {} %}
                            {% set diff = payload.diff ?? payload %}
                            {# Cadeado (spec pasta-cadeado D4): linha de pasta oculta para quem lê sai sem o conteúdo. #}
                            {% set ocultaPeloCadeado = (ocultasPeloCadeado ?? {})[log.id] is defined %}
                            {% if ocultaPeloCadeado %}{% set diff = {} %}{% endif %}
                            {% set context = payload.context ?? payload._meta ?? {} %}
                            {% set detailId = 'audit-detail-' ~ log.id %}
                            <tr>
                                <td>
                                    <div>{{ log.createdAt|date('d/m/Y H:i:s') }}</div>
                                </td>
                                <td>
                                    {% if log.actorEmail %}
                                        <div>{{ log.actorEmail }}</div>
                                        <small class="text-muted">{{ 'auditoria.id_usuario'|trans({id: (log.actorUserId ?? '-') ~ ''}) }}</small>
                                    {% elseif log.actorUserId %}
                                        {{ 'auditoria.id_usuario'|trans({id: log.actorUserId ~ ''}) }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {{ log.entityClass|split('\\')|last }}
                                    {% if log.entityId %}
                                        <span class="text-muted">#{{ log.entityId }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge {{ auditHelper.actionBadgeClass(log.action) }}">{{ log.action|upper }}</span>
                                </td>
                                <td>
                                    {% if log.action == 'update' and diff.changes is defined and diff.changes is iterable and diff.changes|length > 0 %}
                                        {{ 'auditoria.campos_alterados'|trans({n: diff.changes|length ~ ''}) }}
                                    {% elseif log.action == 'create' and diff.after is defined and diff.after is iterable and diff.after|length > 0 %}
                                        {{ 'auditoria.campos_inicializados'|trans({n: diff.after|length ~ ''}) }}
                                    {% elseif log.action == 'delete' and diff.before is defined and diff.before is iterable and diff.before|length > 0 %}
                                        {{ 'auditoria.campos_removidos'|trans({n: diff.before|length ~ ''}) }}
                                    {% elseif ocultaPeloCadeado %}
                                        <i class="bi bi-lock me-1" aria-hidden="true"></i>{{ 'auditoria.pasta_trancada'|trans }}
                                    {% else %}
                                        {{ 'auditoria.sem_diff'|trans }}
                                    {% endif %}
                                </td>
                                <td class="text-nowrap">
                                    <button
                                        class="btn-action btn-action-view"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#{{ detailId }}"
                                        aria-expanded="false"
                                        aria-controls="{{ detailId }}"
                                        title="{{ 'auditoria.ver_detalhes'|trans }}"
                                        aria-label="{{ 'auditoria.ver_detalhes_log'|trans }}"
                                    ><i class="bi bi-eye"></i></button>
                                    {% if podeDesfazerMap[log.id] is defined and podeDesfazerMap[log.id] %}
                                        <form method="post" action="{{ path('audit_log_desfazer', {id: log.id}) }}"
                                              onsubmit="return confirm('{{ 'auditoria.confirmar_desfazer'|trans|e('js') }}');"
                                              style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('audit_desfazer_' ~ log.id) }}">
                                            <button class="btn-action btn-action-delete ms-1" type="submit" title="{{ 'auditoria.desfazer'|trans }}">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr class="collapse" id="{{ detailId }}">
                                <td colspan="6" class="bg-body-tertiary">
                                    <div class="p-2">
                                        <div class="small text-muted mb-2">
                                            {% if context.route is defined %}{{ 'auditoria.rota'|trans }} <strong>{{ context.route }}</strong> | {% endif %}
                                            {{ 'auditoria.ip'|trans }} <strong>{{ log.ipAddress ?? context.ip ?? '-' }}</strong>
                                        </div>

                                        {% if log.action == 'update' and diff.changes is defined and diff.changes is iterable and diff.changes|length > 0 %}
                                            <ul class="mb-0 ps-3">
                                                {% if diff.association_events is defined and diff.association_events is iterable and diff.association_events|length > 0 %}
                                                    {% for event in diff.association_events %}
                                                        <li>
                                                            {% set ownerClass = event.owner.class ?? '' %}
                                                            {% set relatedClass = event.related.class ?? '' %}
                                                            {% set relatedId = event.related.id ?? null %}

                                                            {% if event.operation == 'remove' %}
                                                                {{ auditHelper.entityRef(event.owner ?? null) }} {{ 'auditoria.evento.removido_de'|trans({campo: event.field ?? ('auditoria.evento.associacao'|trans)}) }} {{ auditHelper.entityRef(event.related ?? null) }}.
                                                            {% elseif event.operation == 'add' %}
                                                                {{ auditHelper.entityRef(event.owner ?? null) }} {{ 'auditoria.evento.associado_em'|trans({campo: event.field ?? ('auditoria.evento.associacao'|trans)}) }} {{ auditHelper.entityRef(event.related ?? null) }}.
                                                            {% else %}
                                                                {{ 'auditoria.evento.alterada_entre'|trans }} {{ auditHelper.entityRef(event.owner ?? null) }} {{ 'auditoria.evento.e'|trans }} {{ auditHelper.entityRef(event.related ?? null) }}.
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                {% endif %}

                                                {% for field, fieldDiff in diff.changes %}
                                                    {% if '[+:' not in field and '[-:' not in field %}
                                                        <li>
                                                            <strong>{{ field }}</strong>:
                                                            <span class="text-decoration-line-through text-muted">{{ auditHelper.formatAuditValue(fieldDiff.from ?? null) }}</span>
                                                            <span class="mx-1">→</span>
                                                            <span class="fw-semibold text-primary">{{ auditHelper.formatAuditValue(fieldDiff.to ?? null) }}</span>
                                                        </li>
                                                    {% endif %}
                                                {% endfor %}
                                            </ul>
                                        {% elseif log.action == 'create' and diff.after is defined and diff.after is iterable and diff.after|length > 0 %}
                                            <ul class="mb-0 ps-3">
                                                {% for field, value in diff.after %}
                                                    <li>
                                                        <strong>{{ field }}</strong>:
                                                        <span class="text-decoration-line-through text-muted">-</span>
                                                        <span class="mx-1">→</span>
                                                        <span class="fw-semibold text-success">{{ auditHelper.formatAuditValue(value) }}</span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% elseif log.action == 'delete' and diff.before is defined and diff.before is iterable and diff.before|length > 0 %}
                                            <ul class="mb-0 ps-3">
                                                {% for field, value in diff.before %}
                                                    <li>
                                                        <strong>{{ field }}</strong>:
                                                        <span class="text-decoration-line-through text-danger">{{ auditHelper.formatAuditValue(value) }}</span>
                                                        <span class="mx-1">→</span>
                                                        <span class="fw-semibold">-</span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                            <span class="text-muted">{{ 'auditoria.sem_alteracoes'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">{{ 'auditoria.nenhum_registro'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if pagination.total_pages > 1 %}
            {% set pageWindow = 3 %}
            {% set startPage = pagination.current_page - pageWindow %}
            {% set endPage = pagination.current_page + pageWindow %}
            {% if startPage < 1 %}
                {% set startPage = 1 %}
            {% endif %}
            {% if endPage > pagination.total_pages %}
                {% set endPage = pagination.total_pages %}
            {% endif %}

            <nav aria-label="{{ 'auditoria.paginacao'|trans }}" class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item {{ pagination.current_page <= 1 ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('audit_log_index', filters|merge({'page': pagination.current_page - 1})) }}">{{ 'auditoria.anterior'|trans }}</a>
                    </li>

                    {% for pageNumber in startPage..endPage %}
                        <li class="page-item {{ pageNumber == pagination.current_page ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('audit_log_index', filters|merge({'page': pageNumber})) }}">{{ pageNumber }}</a>
                        </li>
                    {% endfor %}

                    <li class="page-item {{ pagination.current_page >= pagination.total_pages ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('audit_log_index', filters|merge({'page': pagination.current_page + 1})) }}">{{ 'auditoria.proxima'|trans }}</a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ catalogo_js('auditoria.js') }}
<script>
$(document).ready(function() {
    $('.select2-filter').select2({
        placeholder: BJ_T.t('auditoria.js.selecione'),
        allowClear: true,
        width: '100%'
    });
});
</script>
{% endblock %}