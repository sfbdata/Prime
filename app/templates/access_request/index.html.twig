{% extends 'base.html.twig' %}

{% block title %}{{ 'access_request.titulo'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-key me-2"></i>{{ 'access_request.titulo_pendentes'|trans }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'warning') }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% if requests is empty %}
            <div class="alert alert-info">
                <i class="bi bi-check-circle me-2"></i>{{ 'access_request.nenhuma'|trans }}
            </div>
        {% else %}
            <div class="card">
                <div class="card-body table-responsive p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th><i class="bi bi-person me-1"></i> {{ 'access_request.col_solicitante'|trans }}</th>
                                <th><i class="bi bi-box me-1"></i> {{ 'access_request.col_recurso'|trans }}</th>
                                <th><i class="bi bi-hash me-1"></i> {{ 'access_request.col_id'|trans }}</th>
                                <th><i class="bi bi-lightning me-1"></i> {{ 'access_request.col_acao'|trans }}</th>
                                <th><i class="bi bi-clock me-1"></i> {{ 'access_request.col_solicitado_em'|trans }}</th>
                                <th><i class="bi bi-gear me-1"></i> {{ 'access_request.col_decisao'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for req in requests %}
                                <tr>
                                    <td>
                                        <strong>{{ req.user.fullName }}</strong>
                                        <div class="text-muted small">{{ req.user.email }}</div>
                                    </td>
                                    <td>
                                        <span class="badge text-bg-secondary">{{ req.resourceType }}</span>
                                    </td>
                                    <td class="text-muted">#{{ req.resourceId }}</td>
                                    <td>
                                        <span class="badge
                                            {{ req.action == 'view'   ? 'text-bg-info' :
                                               (req.action == 'edit'   ? 'text-bg-warning' :
                                               (req.action == 'delete' ? 'text-bg-danger' : 'text-bg-secondary')) }}">
                                            {{ req.action }}
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        {{ req.requestedAt|data_hora }}
                                        {% if req.description %}
                                            <div class="mt-1 text-dark" title="{{ req.description }}">
                                                <i class="bi bi-chat-text me-1 text-muted"></i>
                                                <em>{{ req.description|length > 80 ? req.description|slice(0, 80) ~ '…' : req.description }}</em>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {# ── Formulário de aprovação ── #}
                                        <button type="button"
                                                class="btn btn-sm btn-success me-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalApprove{{ req.id }}">
                                            <i class="bi bi-check-lg me-1"></i>{{ 'access_request.aprovar'|trans }}
                                        </button>

                                        {# ── Formulário de negação ── #}
                                        <form method="post"
                                              action="{{ path('app_access_request_deny', {id: req.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('{{ 'access_request.confirmar_negar'|trans({nome: req.user.fullName, recurso: req.resourceType, id: req.resourceId ~ ''})|e('js') }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('deny_request_' ~ req.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg me-1"></i>{{ 'access_request.negar'|trans }}
                                            </button>
                                        </form>

                                        {# ── Modal de aprovação com seleção de ações ── #}
                                        <div class="modal fade" id="modalApprove{{ req.id }}" tabindex="-1" aria-labelledby="modalApproveLabel{{ req.id }}" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="post" action="{{ path('app_access_request_approve', {id: req.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_request_' ~ req.id) }}">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="modalApproveLabel{{ req.id }}">
                                                                <i class="bi bi-key me-2"></i>{{ 'access_request.modal_titulo'|trans }}
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="mb-2">
                                                                {{ 'access_request.solicitante'|trans }} <strong>{{ req.user.fullName }}</strong><br>
                                                                {{ 'access_request.recurso'|trans }} <strong>{{ req.resourceType }} #{{ req.resourceId }}</strong>
                                                            </p>
                                                            <p class="text-muted small mb-3">
                                                                {{ 'access_request.instrucao'|trans }}
                                                            </p>
                                                            <div class="form-check mb-2">
                                                                <input class="form-check-input" type="checkbox" name="canView" value="1" id="canView{{ req.id }}" checked>
                                                                <label class="form-check-label" for="canView{{ req.id }}">
                                                                    <span class="badge text-bg-info me-1">view</span> {{ 'access_request.visualizar'|trans }}
                                                                </label>
                                                            </div>
                                                            <div class="form-check mb-2">
                                                                <input class="form-check-input" type="checkbox" name="canEdit" value="1" id="canEdit{{ req.id }}">
                                                                <label class="form-check-label" for="canEdit{{ req.id }}">
                                                                    <span class="badge text-bg-warning me-1">edit</span> {{ 'access_request.editar'|trans }}
                                                                </label>
                                                            </div>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="canDelete" value="1" id="canDelete{{ req.id }}">
                                                                <label class="form-check-label" for="canDelete{{ req.id }}">
                                                                    <span class="badge text-bg-danger me-1">delete</span> {{ 'comum.excluir'|trans }}
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'comum.cancelar'|trans }}</button>
                                                            <button type="submit" class="btn btn-success">
                                                                <i class="bi bi-check-lg me-1"></i>{{ 'access_request.confirmar_aprovacao'|trans }}
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}
