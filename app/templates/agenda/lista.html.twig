{% extends 'base.html.twig' %}

{% block title %}{{ 'agenda.lista.titulo'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0"><i class="bi bi-list-ul me-2"></i>{{ 'agenda.lista.titulo'|trans }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('agenda_index') }}" class="btn btn-outline-primary">
                <i class="bi bi-calendar3 me-1"></i> {{ 'agenda.lista.ver_calendario'|trans }}
            </a>
            <a href="{{ path('agenda_novo') }}" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i> {{ 'agenda.lista.novo_evento'|trans }}
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        {# Filtros #}
        <div class="card card-outline card-primary mb-3">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-funnel me-1"></i> {{ 'agenda.lista.filtros'|trans }}</h3>
            </div>
            <div class="card-body">
                <form method="GET" action="{{ path('agenda_lista') }}">
                    {# DASH-009: o filtro de status não pode largar a pessoa nem o período. #}
                    {% if filtroPessoa is defined %}
                        <input type="hidden" name="responsavel" value="{{ filtroPessoa.responsavel }}">
                        {% if filtroPessoa.data_de != '' %}<input type="hidden" name="data_de" value="{{ filtroPessoa.data_de }}">{% endif %}
                        {% if filtroPessoa.data_ate != '' %}<input type="hidden" name="data_ate" value="{{ filtroPessoa.data_ate }}">{% endif %}
                    {% endif %}
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="filter_status" class="form-label">{{ 'agenda.comum.status'|trans }}</label>
                            <select id="filter_status" name="status" class="form-control">
                                <option value="">{{ 'agenda.lista.status_todos'|trans }}</option>
                                <option value="agendado" {% if statusFiltro == 'agendado' %}selected{% endif %}>{{ 'agenda.lista.status_agendado'|trans }}</option>
                                <option value="concluido" {% if statusFiltro == 'concluido' %}selected{% endif %}>{{ 'agenda.lista.status_concluido'|trans }}</option>
                                <option value="cancelado" {% if statusFiltro == 'cancelado' %}selected{% endif %}>{{ 'agenda.lista.status_cancelado'|trans }}</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i> {{ 'agenda.lista.filtrar'|trans }}
                            </button>
                            <a href="{{ path('agenda_lista') }}" class="btn btn-secondary">
                                <i class="bi bi-x-lg me-1"></i> {{ 'agenda.lista.limpar'|trans }}
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted" data-agenda-total="{{ eventos|length }}"><i class="bi bi-calendar-event me-1"></i> {{ 'agenda.lista.encontrados'|trans({total: eventos|length ~ ''}) }}
                {%- if filtroPessoa is defined %}
                    <span data-agenda-filtro-pessoa> {{ 'agenda.lista.na_agenda_de'|trans({nome: filtroPessoa.nome ?? 'agenda.lista.pessoa_nao_encontrada'|trans}) }}
                    {%- if filtroPessoa.data_de != '' or filtroPessoa.data_ate != '' %} · {{ filtroPessoa.data_de != '' ? 'agenda.lista.periodo_de'|trans({data: filtroPessoa.data_de|data}) : '' }}{{ filtroPessoa.data_ate != '' ? ' ' ~ 'agenda.lista.periodo_ate'|trans({data: filtroPessoa.data_ate|data}) : '' }}{% endif %}
                    · {{ 'agenda.lista.filtro_criadora_ou_participante'|trans }} "{{ 'agenda.lista.filtro_somente_para_mim'|trans }}"
                    {#- SEC-016: só os que VOCÊ pode ver — "Para Todos" com participantes é do criador e
                        dos participantes. Por isso o total pode ser menor que o número do Dashboard. #}
                    · {{ 'agenda.lista.filtro_so_os_que_voce_ve'|trans }}</span>
                {%- endif -%}
            </span>
        </div>

        <div class="card">
            <div class="card-body table-responsive p-0">
                {% if eventos|length > 0 %}
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th><i class="bi bi-card-heading me-1"></i> {{ 'agenda.comum.titulo'|trans }}</th>
                            <th><i class="bi bi-calendar-event me-1"></i> {{ 'agenda.comum.inicio'|trans }}</th>
                            <th><i class="bi bi-calendar-check me-1"></i> {{ 'agenda.comum.fim'|trans }}</th>
                            <th><i class="bi bi-geo-alt me-1"></i> {{ 'agenda.comum.local'|trans }}</th>
                            <th><i class="bi bi-flag me-1"></i> {{ 'agenda.comum.status'|trans }}</th>
                            <th><i class="bi bi-person me-1"></i> {{ 'agenda.lista.criador'|trans }}</th>
                            <th><i class="bi bi-people me-1"></i> {{ 'agenda.comum.participantes'|trans }}</th>
                            <th><i class="bi bi-gear me-1"></i> {{ 'agenda.comum.acoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for evento in eventos %}
                        <tr data-agenda-evento="{{ evento.id }}">
                            <td>
                                <span class="badge" style="background-color: {{ evento.cor }};">&nbsp;</span>
                                {{ evento.titulo }}
                                {% if evento.diaInteiro %}
                                    <small class="text-muted">{{ 'agenda.lista.dia_inteiro'|trans }}</small>
                                {% endif %}
                            </td>
                            <td>{{ evento.dataInicio|data_hora }}</td>
                            <td>{{ evento.dataFim|data_hora }}</td>
                            <td>{{ evento.local ?: '-' }}</td>
                            <td>
                                <span class="badge {{ evento.statusBadgeClass }}">{{ evento.statusLabel }}</span>
                            </td>
                            <td>{{ evento.criador.fullName }}</td>
                            <td>
                                {% if evento.participantes|length > 0 %}
                                    {{ 'agenda.lista.pessoas'|trans({total: evento.participantes|length ~ ''}) }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="acoes-grupo">
                                    <a href="{{ path('agenda_show', {id: evento.id}) }}"
                                       class="btn-action btn-action-view"
                                       title="{{ 'agenda.lista.visualizar_evento'|trans }}"
                                       aria-label="{{ 'agenda.lista.visualizar_evento'|trans }}">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('agenda_editar', {id: evento.id}) }}"
                                       class="btn-action btn-action-edit"
                                       title="{{ 'agenda.comum.editar_evento'|trans }}"
                                       aria-label="{{ 'agenda.comum.editar_evento'|trans }}">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    {% if evento.status != 'cancelado' %}
                                    <form method="POST" action="{{ path('agenda_cancelar', {id: evento.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancelar' ~ evento.id) }}">
                                        <button type="submit"
                                                class="btn-action btn-action-delete"
                                                title="{{ 'agenda.lista.cancelar_evento'|trans }}"
                                                aria-label="{{ 'agenda.lista.cancelar_evento'|trans }}"
                                                onclick="return confirm('{{ 'agenda.lista.cancelar_confirmar'|trans|e('js') }}')">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% else %}
                <div class="p-3">
                    <div class="alert alert-info mb-0"><i class="bi bi-info-circle me-1"></i> {{ 'agenda.lista.nenhum_evento'|trans }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
