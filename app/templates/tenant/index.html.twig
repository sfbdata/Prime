{% extends 'base.html.twig' %}

{% block title %}{{ 'escritorio.lista.titulo_pagina'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">{{ 'escritorio.lista.titulo'|trans }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body table-responsive p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'escritorio.lista.id'|trans }}</th>
                            <th>{{ 'escritorio.lista.nome'|trans }}</th>
                            <th>{{ 'escritorio.lista.criado_em'|trans }}</th>
                            <th>{{ 'escritorio.lista.status'|trans }}</th>
                            <th>{{ 'escritorio.lista.acoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for tenant in tenants %}
                        <tr>
                            <td>{{ tenant.id }}</td>
                            <td>{{ tenant.name }}</td>
                            <td>{{ tenant.createdAt|data_hora }}</td>
                            <td>{{ (tenant.isActive ? 'escritorio.lista.ativo' : 'escritorio.lista.inativo')|trans }}</td>
                            <td>
                                {% if can_administer('admin.tenant.settings.manage') and current_tenant() and current_tenant().id == tenant.id %}
                                    <a href="{{ path('app_tenant_edit', {'tenantId': tenant.id}) }}"
                                       class="btn-action btn-action-edit"
                                       title="{{ 'escritorio.lista.editar'|trans({termo: 'termos.escritorio'|trans}) }}"
                                       aria-label="{{ 'escritorio.lista.editar'|trans({termo: 'termos.escritorio'|trans}) }}">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% else %}
                                    <span class="text-muted">{{ 'escritorio.lista.sem_permissoes'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
{% endblock %}
