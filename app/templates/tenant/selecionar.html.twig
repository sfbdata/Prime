{% extends 'base.html.twig' %}

{% block title %}Selecionar escritório{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 600px">
    <div class="text-center mb-4">
        <h3>Selecione um escritório</h3>
        {% if vinculos|length > 0 %}
            <p class="text-muted">Você tem acesso a {{ vinculos|length }} escritório(s).</p>
        {% endif %}
    </div>

    {% if vinculos is empty %}
        {% set convites_escritorio = convites|default([])|filter(c => c.tenant is not null) %}
        {% if convites_escritorio is empty %}
            <div class="alert alert-warning text-center">
                <i class="bi bi-building-x d-block fs-3 mb-2"></i>
                Você ainda não faz parte de nenhum escritório.<br>
                <small class="text-muted">Peça a um administrador para te convidar.</small>
            </div>
        {% else %}
            <p class="text-center text-muted mb-3">
                <i class="bi bi-envelope-paper me-1"></i>
                Você tem {{ convites_escritorio|length }} convite(s) pendente(s):
            </p>
            {% for convite in convites_escritorio %}
                <a href="{{ path('auth_aceite_convite', {token: convite.token}) }}"
                   class="card mb-2 text-decoration-none text-body">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-building fs-4 text-primary"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">{{ convite.tenant.name }}</div>
                            {% if convite.tenantRole %}
                                <small class="text-muted">{{ convite.tenantRole.name }}</small>
                            {% endif %}
                        </div>
                        <span class="btn btn-sm btn-outline-primary">Ver convite</span>
                    </div>
                </a>
            {% endfor %}
        {% endif %}
    {% else %}
        {% for vinculo in vinculos %}
            <form method="post" action="{{ path('tenant_selecionar') }}" class="mb-3">
                <input type="hidden" name="tenant_id" value="{{ vinculo.tenant.id }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('tenant_selecionar') }}">
                <button type="submit" class="btn btn-outline-primary w-100 text-start p-3">
                    <strong>{{ vinculo.tenant.name }}</strong>
                    {% if vinculo.tenantRole %}
                        <br><small class="text-muted">{{ vinculo.tenantRole.name }}</small>
                    {% endif %}
                </button>
            </form>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
