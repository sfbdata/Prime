{% extends 'base.html.twig' %}

{% block title %}{{ 'escritorio.usuarios.titulo_pagina'|trans }}{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <h1 class="m-0">{{ 'escritorio.usuarios.titulo'|trans({nome: tenant.name}) }}</h1>
        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalJornadaTenant"
                    data-tenant-id="{{ tenant.id }}"
                    data-jornada-url="{{ path('app_jornada_tenant_get', {id: tenant.id}) }}">
                <i class="bi bi-clock-history me-1"></i> {{ 'escritorio.usuarios.jornada'|trans }}
            </button>
            <a href="{{ path('app_tenant_show', {tenantId: tenant.id}) }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> {{ 'escritorio.usuarios.voltar'|trans }}
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body table-responsive p-0">
                <table class="table table-hover mb-0" id="tabelaUsuarios">
                    <thead class="table-light">
                        <tr>
                            <th class="sortable ps-3" data-col="0" style="width:80px"><i class="bi bi-hash me-1"></i>{{ 'escritorio.usuarios.codigo'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="sortable" data-col="1"><i class="bi bi-person me-1"></i>{{ 'escritorio.usuarios.nome'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="sortable" data-col="2"><i class="bi bi-envelope me-1"></i>{{ 'escritorio.usuarios.email'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="sortable" data-col="3"><i class="bi bi-shield-check me-1"></i>{{ 'escritorio.usuarios.perfil'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th><i class="bi bi-key me-1"></i>{{ 'escritorio.usuarios.acessos'|trans }}</th>
                            <th class="sortable" data-col="5"><i class="bi bi-calendar-plus me-1"></i>{{ 'escritorio.usuarios.criado_em'|trans }} <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th><i class="bi bi-gear me-1"></i>{{ 'escritorio.usuarios.acoes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            {% set ut = userTenantByUserId[user.id] ?? null %}
                            {% set userAccesses = accessByUser[user.id] ?? [] %}
                            <tr>
                                <td class="align-middle ps-3 text-muted fw-semibold" style="font-size:.82rem;">{{ ut ? ut.codigoFuncionario ?? 'escritorio.usuarios.nao_informado'|trans : 'escritorio.usuarios.nao_informado'|trans }}</td>
                                <td class="align-middle">{{ user.fullName }}</td>
                                <td class="align-middle">{{ user.email }}</td>
                                <td class="align-middle">
                                    {% if ut and ut.tenantRole %}
                                        <span class="badge text-bg-secondary">{{ ut.tenantRole.nomeExibido }}</span>
                                    {% else %}
                                        <span class="text-muted">{{ 'escritorio.usuarios.nao_informado'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="align-middle">
                                    {% if userAccesses is empty %}
                                        <span class="text-muted small">{{ 'escritorio.usuarios.nenhum'|trans }}</span>
                                    {% else %}
                                        <button
                                            class="btn btn-sm btn-outline-secondary"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#accesses-{{ user.id }}"
                                            aria-expanded="false">
                                            <i class="bi bi-unlock me-1"></i>
                                            {{ 'escritorio.usuarios.itens'|trans({n: userAccesses|length, qtd: userAccesses|length ~ ''}) }}
                                        </button>
                                        <div class="collapse mt-2" id="accesses-{{ user.id }}">
                                            <ul class="list-unstyled mb-0 small">
                                                {% for ra in userAccesses %}
                                                    {% set label = resourceLabels[ra.resourceType][ra.resourceId] ?? (ra.resourceType ~ ' #' ~ ra.resourceId) %}
                                                    <li class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="badge bg-body-tertiary text-body-secondary border text-capitalize">{{ ra.resourceType }}</span>
                                                        <span>{{ label }}</span>
                                                        <span class="ms-1">
                                                            {% if ra.canView %}
                                                                <span class="badge text-bg-info" title="{{ 'escritorio.usuarios.ver_dica'|trans }}">{{ 'escritorio.usuarios.ver'|trans }}</span>
                                                            {% endif %}
                                                            {% if ra.canEdit %}
                                                                <span class="badge text-bg-warning text-dark" title="{{ 'escritorio.usuarios.editar'|trans }}">{{ 'escritorio.usuarios.editar'|trans }}</span>
                                                            {% endif %}
                                                            {% if ra.canDelete %}
                                                                <span class="badge text-bg-danger" title="{{ 'escritorio.usuarios.excluir'|trans }}">{{ 'escritorio.usuarios.excluir'|trans }}</span>
                                                            {% endif %}
                                                        </span>
                                                        {% if ra.grantedBy %}
                                                            <span class="text-muted" title="{{ 'escritorio.usuarios.concedido_por'|trans }}">
                                                                <i class="bi bi-person-check"></i> {{ ra.grantedBy.fullName }}
                                                            </span>
                                                        {% endif %}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="align-middle text-muted" style="font-size:.82rem;">{{ user.createdAt|data_hora }}</td>
                                <td class="align-middle">
                                    <a href="{{ path('app_tenant_user_edit_role', {tenantId: tenant.id, id: user.id}) }}"
                                       class="btn btn-sm btn-outline-primary"
                                       title="{{ 'escritorio.usuarios.editar_dica'|trans }}"
                                       aria-label="{{ 'escritorio.usuarios.editar_dica'|trans }}">
                                        <i class="bi bi-pencil me-1"></i> {{ 'escritorio.usuarios.editar'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center">{{ 'escritorio.usuarios.vazio'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

<style>
#tabelaUsuarios thead th {
    white-space: nowrap;
    vertical-align: middle;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bs-secondary-color);
    border-bottom: 2px solid var(--bs-border-color);
    padding: 10px 8px;
}
#tabelaUsuarios tbody td {
    vertical-align: middle;
    font-size: 0.85rem;
    padding: 8px 8px;
    border-bottom: 1px solid var(--bs-border-color);
}
#tabelaUsuarios tbody tr:last-child td { border-bottom: none; }
#tabelaUsuarios tbody tr:hover { background: var(--bs-secondary-bg); }
.sortable { cursor: pointer; user-select: none; }
.sortable:hover { background-color: rgba(0,0,0,0.04); }
.sort-icon { font-size: 0.68em; opacity: 0.35; flex-shrink: 0; vertical-align: middle; margin-left: 2px; }
.sortable.asc .sort-icon, .sortable.desc .sort-icon { opacity: 1; color: #0d6efd; }
.sortable.asc .sort-icon::before { content: "\F148"; }
.sortable.desc .sort-icon::before { content: "\F128"; }
</style>

<script>
(function () {
    function iniciarOrdenacaoTabela() {
        var table = document.getElementById('tabelaUsuarios');
        if (!table) return;
        var headers = table.querySelectorAll('th.sortable');
        var tbody = table.querySelector('tbody');

        function ordenarPorColuna(col, direcao) {
            headers.forEach(function (h) { h.classList.remove('asc', 'desc'); });
            var headerAtivo = table.querySelector('th.sortable[data-col="' + col + '"]');
            if (headerAtivo) headerAtivo.classList.add(direcao);
            var rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aVal = (a.cells[col] ? a.cells[col].textContent.trim() : '').toLowerCase();
                var bVal = (b.cells[col] ? b.cells[col].textContent.trim() : '').toLowerCase();
                return direcao === 'asc'
                    ? aVal.localeCompare(bVal, 'pt-BR')
                    : bVal.localeCompare(aVal, 'pt-BR');
            });
            rows.forEach(function (row) { tbody.appendChild(row); });
        }

        headers.forEach(function (header) {
            header.addEventListener('click', function () {
                var col = parseInt(this.dataset.col);
                var isAsc = this.classList.contains('asc');
                ordenarPorColuna(col, isAsc ? 'desc' : 'asc');
            });
        });

        /* Ordenação padrão: Código (coluna 0) crescente */
        ordenarPorColuna(0, 'asc');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            iniciarOrdenacaoTabela();
        });
    } else {
        iniciarOrdenacaoTabela();
    }
}());
</script>
    </div>
</section>

{% include 'tenant/_modal_jornada_tenant.html.twig' %}
{% endblock %}
