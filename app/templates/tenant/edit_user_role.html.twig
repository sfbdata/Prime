{% extends 'base.html.twig' %}

{% block title %}Editar Permissões{% endblock %}

{% block body %}
<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0"><i class="bi bi-shield-lock me-2"></i>Editar Permissões — {{ user.fullName }}</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                <ul class="nav nav-tabs mb-3" id="editUserTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-perfil-btn" data-bs-toggle="tab" data-bs-target="#tab-perfil" type="button" role="tab">
                            <i class="bi bi-person me-1"></i>Perfil e Senha
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-dados-pessoais-btn" data-bs-toggle="tab" data-bs-target="#tab-dados-pessoais" type="button" role="tab">
                            <i class="bi bi-person-vcard me-1"></i>Dados Pessoais
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-acessos-btn" data-bs-toggle="tab" data-bs-target="#tab-acessos" type="button" role="tab">
                            <i class="bi bi-unlock me-1"></i>Acessos Específicos
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-escala-btn" data-bs-toggle="tab" data-bs-target="#tab-escala" type="button" role="tab">
                            <i class="bi bi-clock me-1"></i>Jornada Personalizada
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-home-office-btn" data-bs-toggle="tab" data-bs-target="#tab-home-office" type="button" role="tab">
                            <i class="bi bi-house-laptop me-1"></i>Home Office
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-ponto-btn" data-bs-toggle="tab" data-bs-target="#tab-ponto" type="button" role="tab">
                            <i class="bi bi-calendar-check me-1"></i>Batidas de Ponto
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-justificativas-btn" data-bs-toggle="tab" data-bs-target="#tab-justificativas" type="button" role="tab">
                            <i class="bi bi-calendar-x me-1"></i>Justificativas
                            {% set qtdPendentes = justificativas|filter(j => j.status == 'pendente')|length %}
                            {% if qtdPendentes > 0 %}
                                <span class="badge text-bg-warning text-dark ms-1">{{ qtdPendentes }}</span>
                            {% endif %}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-horas-pagas-btn" data-bs-toggle="tab" data-bs-target="#tab-horas-pagas" type="button" role="tab">
                            <i class="bi bi-cash-coin me-1"></i>Horas pagas
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="editUserTabsContent">

                    {# Aba: Perfil e Senha #}
                    <div class="tab-pane fade show active" id="tab-perfil" role="tabpanel">
                        <div class="card card-outline card-primary mb-3">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="bi bi-person me-2"></i>{{ user.fullName }}
                                    <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline text-secondary" data-bs-toggle="modal" data-bs-target="#modalEditarNome" title="Alterar nome">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </h3>
                            </div>
                            <div class="card-body">
                                {{ form_start(form) }}
                                    <div class="mb-4">
                                        {{ form_label(form.codigoFuncionario, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                        {{ form_widget(form.codigoFuncionario) }}
                                        <div class="form-text text-muted">Gerado automaticamente. Pode ser editado (letras e números).</div>
                                        {{ form_errors(form.codigoFuncionario) }}
                                    </div>

                                    <div class="mb-4">
                                        {{ form_label(form.tenantRole, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                        {{ form_widget(form.tenantRole) }}
                                        {{ form_errors(form.tenantRole) }}
                                    </div>

                                    <div class="mb-4">
                                        {{ form_label(form.cargo, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                        {{ form_widget(form.cargo) }}
                                        <div class="form-text text-muted">Usado na folha de ponto.</div>
                                        {{ form_errors(form.cargo) }}
                                    </div>

                                    <div class="mb-4">
                                        {{ form_label(form.lotacao, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                        {{ form_widget(form.lotacao) }}
                                        <div class="form-text text-muted">Usado na folha de ponto.</div>
                                        {{ form_errors(form.lotacao) }}
                                    </div>

                                    <div class="mb-4">
                                        {{ form_label(form.dataAdmissao, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                        {{ form_widget(form.dataAdmissao) }}
                                        <div class="form-text text-muted">Usado na folha de ponto.</div>
                                        {{ form_errors(form.dataAdmissao) }}
                                    </div>

                                    <hr class="my-4">

                                    <h6 class="mb-3"><i class="bi bi-key me-1"></i>Alterar Senha (opcional)</h6>
                                    <p class="text-muted small">Preencha os campos abaixo apenas se desejar alterar a senha.</p>

                                    <div class="mb-3">
                                        {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.newPassword.first) }}
                                    </div>

                                    <div class="mb-3">
                                        {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.newPassword.second) }}
                                    </div>

                                    {{ form_errors(form.newPassword) }}
                            </div>
                            <div class="card-footer">
                                <div class="d-flex gap-2 justify-content-between align-items-center">
                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="btn btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalConfirmarRemocao">
                                            <i class="bi bi-person-x me-1"></i>Remover do escritório
                                        </button>
                                        <a href="{{ path('app_tenant_users', {tenantId: tenantId}) }}" class="btn btn-outline-secondary">
                                            <i class="bi bi-arrow-left me-1"></i>Voltar
                                        </a>
                                    </div>
                                    <button class="btn btn-primary">
                                        <i class="bi bi-check-lg me-1"></i>Salvar
                                    </button>
                                </div>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>

                    {# Aba: Dados Pessoais #}
                    <div class="tab-pane fade" id="tab-dados-pessoais" role="tabpanel">
                        <div class="card card-outline card-info mb-3">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-person-vcard me-2"></i>Dados Pessoais</h3>
                            </div>
                            {{ form_start(formDadosPessoais, {action: path('app_tenant_user_dados_pessoais', {tenantId: tenantId, id: user.id})}) }}
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-12">
                                        {{ form_row(formDadosPessoais.nomeCompleto, {label_attr: {class: 'form-label fw-bold'}}) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(formDadosPessoais.cpf, {label_attr: {class: 'form-label fw-bold'}}) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(formDadosPessoais.dataNascimento, {label_attr: {class: 'form-label fw-bold'}}) }}
                                    </div>
                                    <div class="col-8">
                                        {{ form_row(formDadosPessoais.ctps, {label_attr: {class: 'form-label fw-bold'}}) }}
                                    </div>
                                    <div class="col-4">
                                        {{ form_row(formDadosPessoais.serie, {label_attr: {class: 'form-label fw-bold'}}) }}
                                    </div>
                                </div>
                                {{ form_rest(formDadosPessoais) }}
                            </div>
                            <div class="card-footer d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Salvar Dados Pessoais
                                </button>
                            </div>
                            {{ form_end(formDadosPessoais) }}
                        </div>
                    </div>

                    {# Aba: Acessos específicos por item #}
                    <div class="tab-pane fade" id="tab-acessos" role="tabpanel">
                        <div class="card card-outline card-secondary mb-3">
                            <div class="card-header">
                                <h3 class="card-title"><i class="bi bi-unlock me-2"></i>Acessos específicos por item</h3>
                            </div>
                            <div class="card-body p-0">
                                {% if userAccesses is empty %}
                                    <p class="text-muted small p-3 mb-0">Nenhum acesso específico concedido a este usuário.</p>
                                {% else %}
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Tipo</th>
                                                <th>Item</th>
                                                <th>Permissões</th>
                                                <th>Concedido por</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for ra in userAccesses %}
                                                {% set label = resourceLabels[ra.resourceType][ra.resourceId] ?? (ra.resourceType ~ ' #' ~ ra.resourceId) %}
                                                <tr>
                                                    <td class="align-middle">
                                                        <span class="badge bg-body-tertiary text-body-secondary border text-capitalize">{{ ra.resourceType }}</span>
                                                    </td>
                                                    <td class="align-middle">{{ label }}</td>
                                                    <td class="align-middle">
                                                        {% if ra.canView %}
                                                            <span class="badge text-bg-info me-1">Ver</span>
                                                        {% endif %}
                                                        {% if ra.canEdit %}
                                                            <span class="badge text-bg-warning text-dark me-1">Editar</span>
                                                        {% endif %}
                                                        {% if ra.canDelete %}
                                                            <span class="badge text-bg-danger me-1">Excluir</span>
                                                        {% endif %}
                                                    </td>
                                                    <td class="align-middle small text-muted">
                                                        {% if ra.grantedBy %}
                                                            {{ ra.grantedBy.fullName }}
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </td>
                                                    <td class="align-middle text-end">
                                                        <form method="POST"
                                                              action="{{ path('app_tenant_user_resource_access_remove', {tenantId: tenantId, userId: user.id, raId: ra.id}) }}"
                                                              onsubmit="return confirm('Remover este acesso específico?')">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('remove_resource_access_' ~ ra.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remover acesso">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Aba: Jornada Personalizada #}
                    <div class="tab-pane fade" id="tab-escala" role="tabpanel">
                        {% include 'tenant/_jornada_colaborador_tab.html.twig' with {
                            tenantId: tenantId,
                            user: user,
                            userHasCustomEscala: userHasCustomEscala
                        } only %}
                    </div>

                    {# Aba: Home Office #}
                    <div class="tab-pane fade" id="tab-home-office" role="tabpanel">
                        {% include 'tenant/_home_office_tab.html.twig' with {
                            tenantId: tenantId,
                            user: user
                        } only %}
                    </div>

                    {# Aba: Batidas de Ponto #}
                    <div class="tab-pane fade" id="tab-ponto" role="tabpanel">
                        {% include 'ponto/_folha_table.html.twig' with {
                            titulo: 'Batidas de ponto' ~ (
                                mesCompetenciaPonto and anoCompetenciaPonto
                                    ? ' - ' ~ ('%02d'|format(mesCompetenciaPonto)) ~ '/' ~ anoCompetenciaPonto
                                    : ''
                            ),
                            folhaRows: folhaRowsPonto,
                            competenciasPonto: competenciasPonto,
                            competenciaSelecionada: competenciaSelecionada,
                            competenciaFormAction: path('app_tenant_user_edit_role', {tenantId: tenantId, id: user.id}),
                            competenciaFieldId: 'competencia-ponto-user',
                            exportarFolhaHabilitado: true,
                            exportarFolhaParametros: {userId: user.id},
                            mostrarBancoHoras: true,
                            editarBatidasHabilitado: true,
                            editarBatidasRotaAdd: 'app_tenant_user_ponto_add',
                            editarBatidasRotaEdit: 'app_tenant_user_ponto_edit',
                            editarBatidasRotaDelete: 'app_tenant_user_ponto_delete',
                            editarBatidasParametros: {tenantId: tenantId, id: user.id},
                            mostrarJustificativas: true,
                            jornadaInfo: jornadaInfo,
                            horasPagasMinutos: horasPagasMinutosPonto,
                            saldoMesMinutos: saldoMesMinutosPonto
                        } only %}
                    </div>

                    {# Aba: Justificativas #}
                    <div class="tab-pane fade" id="tab-justificativas" role="tabpanel">
                        {% include 'tenant/_justificativas_tab.html.twig' with {
                            justificativas: justificativas,
                            tenantId: tenantId,
                            user: user,
                            tiposJustificativa: tiposJustificativa
                        } only %}
                    </div>

                    {# Aba: Horas pagas #}
                    <div class="tab-pane fade" id="tab-horas-pagas" role="tabpanel">
                        {% include 'tenant/_horas_pagas_tab.html.twig' with {
                            lancamentosHorasPagas: lancamentosHorasPagas,
                            tenantId: tenantId,
                            user: user
                        } only %}
                    </div>

                </div>{# /tab-content #}

            </div>
        </div>
    </div>
</section>

{# Modal: Adicionar batida manual #}
<div class="modal fade" id="modalAddBatida" tabindex="-1" aria-labelledby="modalAddBatidaLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" action="{{ path('app_tenant_user_ponto_add', {tenantId: tenantId, id: user.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('ponto_manual_add') }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalAddBatidaLabel"><i class="bi bi-plus-circle me-2"></i>Adicionar Batida</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="competencia" id="modalAddCompetencia" value="{{ competenciaSelecionada }}">
                    <div class="mb-3">
                        <label class="form-label">Data</label>
                        <input type="date" name="registro_ponto_manual[data]" id="modalAddData" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hora</label>
                        <input type="time" name="registro_ponto_manual[hora]" id="modalAddHora" class="form-control" required step="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select name="registro_ponto_manual[tipo]" id="modalAddTipo" class="form-select" required>
                            <option value="entrada">Entrada</option>
                            <option value="repouso">Repouso</option>
                            <option value="retorno">Retorno</option>
                            <option value="saida">Saída</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observação <span class="text-muted small">(opcional)</span></label>
                        <textarea name="registro_ponto_manual[observacao]" class="form-control" rows="2" placeholder="Motivo do lançamento manual"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# Modal: alterar nome do usuário #}
<div class="modal fade" id="modalEditarNome" tabindex="-1" aria-labelledby="modalEditarNomeLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" action="{{ path('app_tenant_user_edit_name', {tenantId: tenantId, id: user.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_user_name_' ~ user.id) }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEditarNomeLabel"><i class="bi bi-pencil me-2"></i>Alterar nome</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="inputFullName" class="form-label fw-bold">Nome completo</label>
                    <input type="text" class="form-control" id="inputFullName" name="fullName" value="{{ user.fullName }}" required maxlength="255" autofocus>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarRemocao" tabindex="-1" aria-labelledby="labelModalRemocao" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="labelModalRemocao">
                    <i class="bi bi-person-x me-2"></i>Remover do escritório
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="{{ path('app_tenant_user_remover', {tenantId: tenantId, userId: user.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('remover_' ~ user.id) }}">
                <div class="modal-body">
                    <div class="alert alert-warning d-flex gap-2 align-items-start mb-4">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                        <div>
                            Ao remover <strong>{{ user.fullName }}</strong>, ela perde o acesso a este escritório e
                            sai da sua lista de colaboradores. A conta dela continua existindo, e ela pode ser
                            convidada de volta — voltando sem os acessos de antes.
                        </div>
                    </div>
                    <div class="mb-1">
                        <label for="substitutoSelect" class="form-label fw-bold">
                            Quem assume o que era dela?
                            <span class="text-muted fw-normal">(opcional)</span>
                        </label>
                        <select name="substituto_id" id="substitutoSelect" class="form-select">
                            <option value="">— Deixar sem responsável —</option>
                            {% for colega in colegas %}
                                <option value="{{ colega.user.id }}">
                                    {% if colega.codigoFuncionario %}[{{ colega.codigoFuncionario }}] {% endif %}{{ colega.user.fullName }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="form-text text-muted">
                            Se selecionado, esse colaborador assumirá todas as responsabilidades ativas de quem sair.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-x me-1"></i>Remover do escritório
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Ativa a aba correta com base no query param ?tab=
        var tabMap = {
            perfil:           'tab-perfil-btn',
            'dados-pessoais': 'tab-dados-pessoais-btn',
            acessos:          'tab-acessos-btn',
            escala:           'tab-escala-btn',
            'home-office':    'tab-home-office-btn',
            ponto:            'tab-ponto-btn',
            justificativas:   'tab-justificativas-btn',
            'horas-pagas':    'tab-horas-pagas-btn',
        };
        var params = new URLSearchParams(window.location.search);
        var tabParam = params.get('tab');
        if (tabParam && tabMap[tabParam]) {
            var tabBtn = document.getElementById(tabMap[tabParam]);
            if (tabBtn) {
                new bootstrap.Tab(tabBtn).show();
            }
        }

        // Ao trocar de aba manualmente, atualiza a URL sem recarregar
        var tabEls = document.querySelectorAll('#editUserTabs [data-bs-toggle="tab"]');
        tabEls.forEach(function (tabEl) {
            tabEl.addEventListener('shown.bs.tab', function (e) {
                var tabKey = Object.keys(tabMap).find(function (k) { return tabMap[k] === e.target.id; });
                if (tabKey) {
                    var url = new URL(window.location.href);
                    url.searchParams.set('tab', tabKey);
                    history.replaceState(null, '', url.toString());
                }
            });
        });


        // Abre o modal de adicionar batida preenchendo data e tipo
        window.abrirModalAddBatida = function (tipo, chaveDia) {
            document.getElementById('modalAddData').value = chaveDia;
            document.getElementById('modalAddTipo').value = tipo;
            document.getElementById('modalAddCompetencia').value = chaveDia.substring(0, 7);
            var modal = new bootstrap.Modal(document.getElementById('modalAddBatida'));
            modal.show();
        };

    });
</script>
{% endblock %}
