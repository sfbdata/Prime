<div class="bjp-painel mb-3">
    <div class="bjp-painel-cabeca d-flex align-items-center justify-content-between">
        <h3 class="bjp-painel-titulo mb-0"><i class="bi bi-calendar-x me-2"></i>{{ 'escritorio.justificativas_tab.titulo'|trans({nome: user.fullName}) }}</h3>
        {# P43 a: `podeAnalisar` é a decisão do servidor (AnaliseDaPropriaJustificativa). Na própria, quem gere pelo
           perfil e não é primário nem Master não abona, não recusa, não volta para análise nem lança para si. #}
        {% if podeAnalisar %}
        <button type="button" class="bjp-btn bjp-btn--secundario" data-bs-toggle="modal" data-bs-target="#modalAdminNovaJustificativa">
            <i class="bi bi-plus-circle"></i>{{ 'escritorio.justificativas_tab.justificar'|trans }}
        </button>
        {% endif %}
    </div>
    {% if not podeAnalisar %}
        <p class="small text-muted px-3 pt-2 mb-0">{{ constant('App\\Ponto\\Service\\AnaliseDaPropriaJustificativa::RECUSA') }}</p>
    {% endif %}
    <div class="bjp-painel-corpo p-0">
        {% if justificativas is empty %}
            <p class="text-muted small p-3 mb-0">{{ 'escritorio.justificativas_tab.vazia'|trans }}</p>
        {% else %}
            {# Agrupar por batchId. A chave leva o prefixo "lote_": um batchId só de dígitos que cabe num inteiro viraria
               chave numérica, e o merge do Twig a renumeraria (batches[batchKey] sumiria). O batchKey só vai para os ids
               do DOM; a rota usa primeiraJust.batchId. #}
            {% set batches = {} %}
            {% for j in justificativas %}
                {% set batchKey = j.batchId is not null ? 'lote_' ~ j.batchId : 'id_' ~ j.id %}
                {% if batches[batchKey] is not defined %}
                    {% set batches = batches|merge({(batchKey): []}) %}
                {% endif %}
                {% set batches = batches|merge({(batchKey): batches[batchKey]|merge([j])}) %}
            {% endfor %}

            <div class="accordion" id="accordionJustificativas">
                {% for batchKey, batch in batches %}
                    {% set primeiraJust = batch[0] %}

                    {# Calcular quantos dias do lote estão pendentes #}
                    {% set qtdPendente = 0 %}
                    {% for j in batch %}
                        {% if j.status == 'pendente' %}{% set qtdPendente = qtdPendente + 1 %}{% endif %}
                    {% endfor %}
                    {% set hasAnyPendente = qtdPendente > 0 %}

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button {{ not hasAnyPendente ? 'collapsed' : '' }}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#batch-{{ batchKey }}"
                                    aria-expanded="{{ hasAnyPendente ? 'true' : 'false' }}">
                                <div class="d-flex align-items-center gap-2 flex-wrap w-100 me-3">
                                    <span>
                                        {% for j in batch %}
                                            <span class="bjp-etiqueta bjp-etiqueta--neutro me-1">{{ j.data|date('d/m/Y') }}</span>
                                        {% endfor %}
                                    </span>
                                    {% if hasAnyPendente and qtdPendente < batch|length %}
                                        <span class="bjp-etiqueta bjp-etiqueta--info ms-auto"><i class="bi bi-hourglass-split me-1"></i>{{ 'escritorio.justificativas_tab.analise_parcial'|trans }}</span>
                                    {% elseif primeiraJust.status == 'abonado' and primeiraJust.tipo == 'falta_nao_justificada' %}
                                        <span class="bjp-etiqueta bjp-etiqueta--critico ms-auto"><i class="bi bi-x-circle me-1"></i>{{ 'escritorio.justificativas_tab.nao_abonado'|trans }}</span>
                                    {% elseif primeiraJust.status == 'abonado' %}
                                        <span class="bjp-etiqueta bjp-etiqueta--ok ms-auto"><i class="bi bi-check-circle me-1"></i>{{ 'escritorio.justificativas_tab.abonado'|trans }}</span>
                                    {% elseif primeiraJust.status == 'pendente' %}
                                        <span class="bjp-etiqueta bjp-etiqueta--atencao ms-auto"><i class="bi bi-hourglass-split me-1"></i>{{ nome_da_situacao('situacao.pendente') }}</span>
                                    {% else %}
                                        <span class="bjp-etiqueta bjp-etiqueta--critico ms-auto"><i class="bi bi-x-circle me-1"></i>{{ nome_da_situacao('situacao.rejeitado') }}</span>
                                    {% endif %}
                                </div>
                            </button>
                        </h2>
                        <div id="batch-{{ batchKey }}" class="accordion-collapse collapse {{ hasAnyPendente ? 'show' : '' }}"
                             data-bs-parent="#accordionJustificativas">
                            <div class="accordion-body">
                                <dl class="row mb-3">
                                    <dt class="col-sm-3">{{ 'escritorio.justificativas_tab.tipo'|trans }}</dt>
                                    <dd class="col-sm-9">
                                        {% if primeiraJust.labelTipo %}
                                            <span class="bjp-etiqueta bjp-etiqueta--info">{{ primeiraJust.labelTipo }}</span>
                                        {% else %}
                                            <span class="text-muted">{{ 'escritorio.justificativas_tab.nao_informado'|trans }}</span>
                                        {% endif %}
                                        {% if primeiraJust.abonoParcial %}
                                            <span class="bjp-etiqueta bjp-etiqueta--neutro ms-1">{{ 'escritorio.justificativas_tab.abono_parcial'|trans }}</span>
                                            {% if primeiraJust.horaInicioAbono and primeiraJust.horaFimAbono %}
                                                <span class="small text-muted ms-1">
                                                    {{ 'escritorio.justificativas_tab.intervalo'|trans({inicio: primeiraJust.horaInicioAbono|date('H:i'), fim: primeiraJust.horaFimAbono|date('H:i')}) }}
                                                    ({{ primeiraJust.minutosAbonados // 60 }}h{{ '%02d'|format(primeiraJust.minutosAbonados % 60) }}m)
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    </dd>

                                    {% if primeiraJust.tipo == 'esquecimento_registro' and primeiraJust.tipoRegistroEsquecido %}
                                        <dt class="col-sm-3">{{ 'escritorio.justificativas_tab.registro_esquecido'|trans }}</dt>
                                        <dd class="col-sm-9">
                                            <span class="bjp-etiqueta bjp-etiqueta--atencao">
                                                {{ {'entrada': 'escritorio.justificativas_tab.batida_entrada'|trans, 'repouso': 'escritorio.justificativas_tab.batida_repouso'|trans, 'retorno': 'escritorio.justificativas_tab.batida_retorno'|trans, 'saida': 'escritorio.justificativas_tab.batida_saida'|trans}[primeiraJust.tipoRegistroEsquecido] ?? primeiraJust.tipoRegistroEsquecido }}
                                            </span>
                                            {% if primeiraJust.horaRegistroEsquecido %}
                                                {{ 'escritorio.justificativas_tab.as_hora'|trans({hora: primeiraJust.horaRegistroEsquecido|date('H:i')}) }}
                                            {% endif %}
                                        </dd>
                                    {% endif %}

                                    {# Ponto E4: o motivo que o colaborador escreveu na janela da /ponto (as de antes e as do gestor não têm). #}
                                    {% if primeiraJust.motivo is not empty %}
                                        <dt class="col-sm-3">{{ 'escritorio.justificativas_tab.motivo'|trans }}</dt>
                                        <dd class="col-sm-9" style="white-space: pre-line;">{{ primeiraJust.motivo }}</dd>
                                    {% endif %}

                                    <dt class="col-sm-3">{{ 'escritorio.justificativas_tab.atestado'|trans }}</dt>
                                    <dd class="col-sm-9">
                                        {% if primeiraJust.anexoPath %}
                                            <a href="{{ path('app_tenant_user_justificativa_anexo', {tenantId: tenantId, id: user.id, justificativaId: primeiraJust.id}) }}"
                                               target="_blank" class="bjp-btn bjp-btn--secundario">
                                                <i class="bi bi-paperclip"></i>{{ 'escritorio.justificativas_tab.ver_atestado'|trans }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">{{ 'escritorio.justificativas_tab.sem_atestado'|trans }}</span>
                                        {% endif %}
                                    </dd>
                                </dl>

                                {# Botão "Aprovar Todos" — só aparece quando há 2+ dias pendentes no lote #}
                                {% if qtdPendente >= 2 and podeAnalisar %}
                                    <form method="post"
                                          action="{{ path('app_tenant_user_justificativa_aprovar_todos', {tenantId: tenantId, id: user.id, batchId: primeiraJust.batchId}) }}"
                                          class="mb-3"
                                          onsubmit="return confirm('{{ 'escritorio.justificativas_tab.aprovar_todos_confirmar'|trans({qtd: qtdPendente})|e('js') }}')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('justificativa_aprovar_todos_' ~ primeiraJust.batchId) }}">
                                        <button type="submit" class="bjp-btn bjp-btn--sucesso">
                                            <i class="bi bi-check-all"></i>{{ 'escritorio.justificativas_tab.aprovar_todos'|trans({qtd: qtdPendente}) }}
                                        </button>
                                    </form>
                                {% endif %}

                                {# Cada dia do lote com seu estado individual #}
                                {% for j in batch %}
                                    <div class="border rounded p-3 mb-2 {{ j.status == 'pendente' ? 'bg-body-tertiary' : (j.status == 'abonado' ? 'bg-success bg-opacity-10' : 'bg-danger bg-opacity-10') }}">
                                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                            <strong><i class="bi bi-calendar-day me-1"></i>{{ j.data|date('d/m/Y') }}</strong>
                                            {% if j.status == 'pendente' %}
                                                <span class="bjp-etiqueta bjp-etiqueta--atencao">{{ nome_da_situacao('situacao.pendente') }}</span>
                                            {% elseif j.status == 'abonado' and j.tipo == 'falta_nao_justificada' %}
                                                <span class="bjp-etiqueta bjp-etiqueta--critico">{{ 'escritorio.justificativas_tab.nao_abonado'|trans }}</span>
                                            {% elseif j.status == 'abonado' %}
                                                <span class="bjp-etiqueta bjp-etiqueta--ok">{{ 'escritorio.justificativas_tab.abonado'|trans }}</span>
                                            {% else %}
                                                <span class="bjp-etiqueta bjp-etiqueta--critico">{{ nome_da_situacao('situacao.rejeitado') }}</span>
                                            {% endif %}
                                        </div>

                                        {% if j.status == 'pendente' %}
                                            {% if podeAnalisar %}
                                            <div class="d-flex gap-2 flex-wrap">
                                                {# Abonar #}
                                                <form method="post"
                                                      action="{{ path('app_tenant_user_justificativa_aprovar', {tenantId: tenantId, id: user.id, justificativaId: j.id}) }}"
                                                      class="d-flex gap-2 align-items-center">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('justificativa_aprovar_' ~ j.id) }}">
                                                    <input type="text" name="observacaoAnalise" class="form-control form-control-sm"
                                                           style="max-width: 220px" placeholder="{{ 'escritorio.justificativas_tab.obs_abono'|trans }}">
                                                    <button type="submit" class="bjp-btn bjp-btn--sucesso"
                                                            onclick="return confirm('{{ 'escritorio.justificativas_tab.abonar_confirmar'|trans({data: j.data|date('d/m/Y')})|e('js') }}')">
                                                        <i class="bi bi-check-lg"></i>{{ 'escritorio.justificativas_tab.abonar'|trans }}
                                                    </button>
                                                </form>

                                                {# Recusar: textos pelo ponto único do P40 (NomesDasSituacoesDaJustificativa). #}
                                                <form method="post"
                                                      action="{{ path('app_tenant_user_justificativa_rejeitar', {tenantId: tenantId, id: user.id, justificativaId: j.id}) }}"
                                                      class="d-flex gap-2 align-items-center"
                                                      data-sem-motivo="{{ nome_da_situacao('analise.sem_motivo') }}"
                                                      data-confirmar="{{ nome_da_situacao('ficha.confirmar_recusa', j.data|date('d/m/Y')) }}"
                                                      onsubmit="
                                                          var obs = this.querySelector('[name=observacaoAnalise]').value.trim();
                                                          if (!obs) { alert(this.dataset.semMotivo); return false; }
                                                          return confirm(this.dataset.confirmar);
                                                      ">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('justificativa_rejeitar_' ~ j.id) }}">
                                                    <input type="text" name="observacaoAnalise" class="form-control form-control-sm"
                                                           style="max-width: 220px" placeholder="{{ nome_da_situacao('ficha.motivo') }}" required>
                                                    <button type="submit" class="bjp-btn bjp-btn--destrutivo">
                                                        <i class="bi bi-x-lg"></i>{{ nome_da_situacao('ficha.recusar') }}
                                                    </button>
                                                </form>
                                            </div>
                                            {% endif %}
                                        {% else %}
                                            <div class="small text-muted mb-2">
                                                {{ 'escritorio.justificativas_tab.analisado_por'|trans({nome: j.analisadoPor ? j.analisadoPor.fullName : 'escritorio.justificativas_tab.usuario_nao_informado'|trans}) }}
                                                {% if j.dataAnalise %} {{ 'escritorio.justificativas_tab.em_data'|trans({data: j.dataAnalise|date('d/m/Y')}) }}{% endif %}
                                                {% if j.observacaoAnalise %}: {{ j.observacaoAnalise }}{% endif %}
                                            </div>
                                            {# Reverter para pendente. Nomes das situações pelo ponto único do P40 (NomesDasSituacoesDaJustificativa). #}
                                            {% if podeAnalisar %}
                                            <form method="post"
                                                  action="{{ path('app_tenant_user_justificativa_reverter', {tenantId: tenantId, id: user.id, justificativaId: j.id}) }}"
                                                  onsubmit="return confirm('{{ nome_da_situacao('reverter.confirmar')|e('js') }}')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('justificativa_reverter_' ~ j.id) }}">
                                                <button type="submit" class="bjp-btn bjp-btn--secundario">
                                                    <i class="bi bi-arrow-counterclockwise"></i>{{ nome_da_situacao('reverter.botao') }}
                                                </button>
                                            </form>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<div class="modal fade" id="modalAdminNovaJustificativa" tabindex="-1" aria-labelledby="modalAdminNovaJustificativaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post"
                  action="{{ path('app_tenant_user_justificativa_nova', {tenantId: tenantId, id: user.id}) }}"
                  enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_nova_justificativa_' ~ user.id) }}">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalAdminNovaJustificativaLabel">
                        <i class="bi bi-calendar-x me-2"></i>{{ 'escritorio.justificativas_tab.justificar_titulo'|trans({nome: user.fullName}) }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'escritorio.justificativas_tab.fechar'|trans }}"></button>
                </div>

                <div class="modal-body">
                    {% include 'ponto/_justificativa_calendario.html.twig' with {
                        prefixo: 'admin',
                        nomePrefixo: '',
                        idModal: 'modalAdminNovaJustificativa'
                    } only %}
                    {% include 'ponto/_justificativa_campos.html.twig' with {
                        prefixo: 'admin',
                        nomePrefixo: '',
                        idModal: 'modalAdminNovaJustificativa',
                        tiposJustificativa: tiposJustificativa,
                        textoInfoAdicional: 'escritorio.justificativas_tab.info_admin'|trans
                    } only %}
                </div>

                <div class="modal-footer">
                    <button type="button" class="bjp-btn bjp-btn--secundario" data-bs-dismiss="modal">{{ 'comum.cancelar'|trans }}</button>
                    <button type="submit" class="bjp-btn bjp-btn--secundario">
                        <i class="bi bi-send"></i>{{ 'escritorio.justificativas_tab.lancar'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
