<div class="card card-outline card-warning mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="card-title mb-0"><i class="bi bi-calendar-x me-2"></i>Justificativas de Falta — {{ user.fullName }}</h3>
        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#modalAdminNovaJustificativa">
            <i class="bi bi-plus-circle me-1"></i>Justificar Falta
        </button>
    </div>
    <div class="card-body p-0">
        {% if justificativas is empty %}
            <p class="text-muted small p-3 mb-0">Nenhuma justificativa enviada por este usuário.</p>
        {% else %}
            {# Agrupar por batchId #}
            {% set batches = {} %}
            {% for j in justificativas %}
                {% set batchKey = j.batchId ?? ('id_' ~ j.id) %}
                {% if batches[batchKey] is not defined %}
                    {% set batches = batches|merge({(batchKey): []}) %}
                {% endif %}
                {% set batches = batches|merge({(batchKey): batches[batchKey]|merge([j])}) %}
            {% endfor %}

            <div class="accordion" id="accordionJustificativas">
                {% for batchKey, batch in batches %}
                    {% set primeiraJust = batch[0] %}

                    {# Calcular quantos dias do lote estão pendentes #}
                    {% set qtdPendente = 0 %}
                    {% for j in batch %}
                        {% if j.status == 'pendente' %}{% set qtdPendente = qtdPendente + 1 %}{% endif %}
                    {% endfor %}
                    {% set hasAnyPendente = qtdPendente > 0 %}

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button {{ not hasAnyPendente ? 'collapsed' : '' }}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#batch-{{ batchKey }}"
                                    aria-expanded="{{ hasAnyPendente ? 'true' : 'false' }}">
                                <div class="d-flex align-items-center gap-2 flex-wrap w-100 me-3">
                                    <span>
                                        {% for j in batch %}
                                            <span class="badge text-bg-light border text-dark me-1">{{ j.data|date('d/m/Y') }}</span>
                                        {% endfor %}
                                    </span>
                                    {% if hasAnyPendente and qtdPendente < batch|length %}
                                        <span class="badge text-bg-info text-dark ms-auto"><i class="bi bi-hourglass-split me-1"></i>Análise parcial</span>
                                    {% elseif primeiraJust.status == 'abonado' and primeiraJust.tipo == 'falta_nao_justificada' %}
                                        <span class="badge text-bg-danger ms-auto"><i class="bi bi-x-circle me-1"></i>Não abonado</span>
                                    {% elseif primeiraJust.status == 'abonado' %}
                                        <span class="badge text-bg-success ms-auto"><i class="bi bi-check-circle me-1"></i>Abonado</span>
                                    {% elseif primeiraJust.status == 'pendente' %}
                                        <span class="badge text-bg-warning text-dark ms-auto"><i class="bi bi-hourglass-split me-1"></i>Pendente</span>
                                    {% else %}
                                        <span class="badge text-bg-danger ms-auto"><i class="bi bi-x-circle me-1"></i>Rejeitado</span>
                                    {% endif %}
                                </div>
                            </button>
                        </h2>
                        <div id="batch-{{ batchKey }}" class="accordion-collapse collapse {{ hasAnyPendente ? 'show' : '' }}"
                             data-bs-parent="#accordionJustificativas">
                            <div class="accordion-body">
                                <dl class="row mb-3">
                                    <dt class="col-sm-3">Tipo</dt>
                                    <dd class="col-sm-9">
                                        {% if primeiraJust.labelTipo %}
                                            <span class="badge text-bg-info text-dark">{{ primeiraJust.labelTipo }}</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                        {% if primeiraJust.abonoParcial %}
                                            <span class="badge text-bg-secondary ms-1">Abono Parcial</span>
                                            {% if primeiraJust.horaInicioAbono and primeiraJust.horaFimAbono %}
                                                <span class="small text-muted ms-1">
                                                    {{ primeiraJust.horaInicioAbono|date('H:i') }}–{{ primeiraJust.horaFimAbono|date('H:i') }}
                                                    ({{ primeiraJust.minutosAbonados // 60 }}h{{ '%02d'|format(primeiraJust.minutosAbonados % 60) }}m)
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    </dd>

                                    {% if primeiraJust.tipo == 'esquecimento_registro' and primeiraJust.tipoRegistroEsquecido %}
                                        <dt class="col-sm-3">Registro esquecido</dt>
                                        <dd class="col-sm-9">
                                            <span class="badge text-bg-warning text-dark">
                                                {{ {'entrada': 'Entrada', 'repouso': 'Repouso', 'retorno': 'Retorno', 'saida': 'Saída'}[primeiraJust.tipoRegistroEsquecido] ?? primeiraJust.tipoRegistroEsquecido }}
                                            </span>
                                            {% if primeiraJust.horaRegistroEsquecido %}
                                                às {{ primeiraJust.horaRegistroEsquecido|date('H:i') }}
                                            {% endif %}
                                        </dd>
                                    {% endif %}

                                    <dt class="col-sm-3">Atestado</dt>
                                    <dd class="col-sm-9">
                                        {% if primeiraJust.anexoPath %}
                                            <a href="{{ path('app_tenant_user_justificativa_anexo', {tenantId: tenantId, id: user.id, justificativaId: primeiraJust.id}) }}"
                                               target="_blank" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-paperclip me-1"></i>Visualizar atestado
                                            </a>
                                        {% else %}
                                            <span class="text-muted">Sem atestado</span>
                                        {% endif %}
                                    </dd>
                                </dl>

                                {# Botão "Aprovar Todos" — só aparece quando há 2+ dias pendentes no lote #}
                                {% if qtdPendente >= 2 %}
                                    <form method="post"
                                          action="{{ path('app_tenant_user_justificativa_aprovar_todos', {tenantId: tenantId, id: user.id, batchId: primeiraJust.batchId}) }}"
                                          class="mb-3"
                                          onsubmit="return confirm('Aprovar todos os {{ qtdPendente }} dias pendentes deste lote?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('justificativa_aprovar_todos_' ~ primeiraJust.batchId) }}">
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="bi bi-check-all me-1"></i>Aprovar Todos ({{ qtdPendente }} dias pendentes)
                                        </button>
                                    </form>
                                {% endif %}

                                {# Cada dia do lote com seu estado individual #}
                                {% for j in batch %}
                                    <div class="border rounded p-3 mb-2 {{ j.status == 'pendente' ? 'bg-light' : (j.status == 'abonado' ? 'bg-success bg-opacity-10' : 'bg-danger bg-opacity-10') }}">
                                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                            <strong><i class="bi bi-calendar-day me-1"></i>{{ j.data|date('d/m/Y') }}</strong>
                                            {% if j.status == 'pendente' %}
                                                <span class="badge text-bg-warning text-dark">Pendente</span>
                                            {% elseif j.status == 'abonado' and j.tipo == 'falta_nao_justificada' %}
                                                <span class="badge text-bg-danger">Não abonado</span>
                                            {% elseif j.status == 'abonado' %}
                                                <span class="badge text-bg-success">Abonado</span>
                                            {% else %}
                                                <span class="badge text-bg-danger">Rejeitado</span>
                                            {% endif %}
                                        </div>

                                        {% if j.status == 'pendente' %}
                                            <div class="d-flex gap-2 flex-wrap">
                                                {# Abonar #}
                                                <form method="post"
                                                      action="{{ path('app_tenant_user_justificativa_aprovar', {tenantId: tenantId, id: user.id, justificativaId: j.id}) }}"
                                                      class="d-flex gap-2 align-items-center">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('justificativa_aprovar_' ~ j.id) }}">
                                                    <input type="text" name="observacaoAnalise" class="form-control form-control-sm"
                                                           style="max-width: 220px" placeholder="Obs. abono (opcional)">
                                                    <button type="submit" class="btn btn-sm btn-success"
                                                            onclick="return confirm('Abonar justificativa de {{ j.data|date('d/m/Y') }}?')">
                                                        <i class="bi bi-check-lg me-1"></i>Abonar
                                                    </button>
                                                </form>

                                                {# Rejeitar #}
                                                <form method="post"
                                                      action="{{ path('app_tenant_user_justificativa_rejeitar', {tenantId: tenantId, id: user.id, justificativaId: j.id}) }}"
                                                      class="d-flex gap-2 align-items-center"
                                                      onsubmit="
                                                          var obs = this.querySelector('[name=observacaoAnalise]').value.trim();
                                                          if (!obs) { alert('Informe o motivo da rejeição.'); return false; }
                                                          return confirm('Rejeitar justificativa de {{ j.data|date('d/m/Y') }}?');
                                                      ">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('justificativa_rejeitar_' ~ j.id) }}">
                                                    <input type="text" name="observacaoAnalise" class="form-control form-control-sm"
                                                           style="max-width: 220px" placeholder="Motivo da rejeição (obrigatório)" required>
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-x-lg me-1"></i>Rejeitar
                                                    </button>
                                                </form>
                                            </div>
                                        {% else %}
                                            <div class="small text-muted mb-2">
                                                Analisado por {{ j.analisadoPor ? j.analisadoPor.fullName : '—' }}
                                                {% if j.dataAnalise %} em {{ j.dataAnalise|date('d/m/Y') }}{% endif %}
                                                {% if j.observacaoAnalise %} — {{ j.observacaoAnalise }}{% endif %}
                                            </div>
                                            {# Reverter para pendente #}
                                            <form method="post"
                                                  action="{{ path('app_tenant_user_justificativa_reverter', {tenantId: tenantId, id: user.id, justificativaId: j.id}) }}"
                                                  onsubmit="return confirm('Reverter esta justificativa para pendente?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('justificativa_reverter_' ~ j.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reverter para Pendente
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<div class="modal fade" id="modalAdminNovaJustificativa" tabindex="-1" aria-labelledby="modalAdminNovaJustificativaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post"
                  action="{{ path('app_tenant_user_justificativa_nova', {tenantId: tenantId, id: user.id}) }}"
                  enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_nova_justificativa_' ~ user.id) }}">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalAdminNovaJustificativaLabel">
                        <i class="bi bi-calendar-x me-2"></i>Justificar Falta — {{ user.fullName }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    {% include 'ponto/_justificativa_calendario.html.twig' with {
                        prefixo: 'admin',
                        nomePrefixo: '',
                        idModal: 'modalAdminNovaJustificativa'
                    } only %}
                    {% include 'ponto/_justificativa_campos.html.twig' with {
                        prefixo: 'admin',
                        nomePrefixo: '',
                        idModal: 'modalAdminNovaJustificativa',
                        tiposJustificativa: tiposJustificativa,
                        textoInfoAdicional: 'Justificativas lançadas pelo administrador são aprovadas automaticamente.'
                    } only %}
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-send me-1"></i>Lançar Justificativa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
