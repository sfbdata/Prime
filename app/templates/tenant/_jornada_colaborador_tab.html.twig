                        <input class="form-check-input dia-check-escala" type="checkbox" value="2">
                        <label class="form-check-label small">{{ 'escritorio.jornada_colab.dia_ter'|trans }}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input dia-check-escala" type="checkbox" value="3">
                        <label class="form-check-label small">{{ 'escritorio.jornada_colab.dia_qua'|trans }}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input dia-check-escala" type="checkbox" value="4">
                        <label class="form-check-label small">{{ 'escritorio.jornada_colab.dia_qui'|trans }}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input dia-check-escala" type="checkbox" value="5">
                        <label class="form-check-label small">{{ 'escritorio.jornada_colab.dia_sex'|trans }}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input dia-check-escala" type="checkbox" value="6">
                        <label class="form-check-label small">{{ 'escritorio.jornada_colab.dia_sab'|trans }}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input dia-check-escala" type="checkbox" value="7">
                        <label class="form-check-label small">{{ 'escritorio.jornada_colab.dia_dom'|trans }}</label>
                    </div>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <label class="form-label small">{{ 'escritorio.jornada_colab.entrada'|trans }}</label>
                    <input type="time" class="form-control form-control-sm bloco-entrada" required>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">{{ 'escritorio.jornada_colab.repouso'|trans }}</label>
                    <input type="time" class="form-control form-control-sm bloco-repouso">
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">{{ 'escritorio.jornada_colab.retorno'|trans }}</label>
                    <input type="time" class="form-control form-control-sm bloco-retorno">
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">{{ 'escritorio.jornada_colab.saida'|trans }}</label>
                    <input type="time" class="form-control form-control-sm bloco-saida" required>
                </div>
            </div>
            <div class="mt-2 text-end text-muted small">
                {{ 'escritorio.jornada_colab.carga_bloco'|trans }} <span class="bloco-carga-display fw-semibold">0:00</span>{{ 'escritorio.jornada_colab.por_dia'|trans }}
            </div>
        </div>
    </div>
</template>

{{ catalogo_js('escritorio.jornada_colab.js') }}
<script>
(function () {
    'use strict';

    const escalaUrl = {{ path('app_jornada_colaborador_get', {tenantId: tenantId, id: user.id})|json_encode|raw }};

    function parseHHMM(str) {
        if (!str) return 0;
        const parts = str.split(':');
        return parseInt(parts[0] || '0', 10) * 60 + parseInt(parts[1] || '0', 10);
    }

    function toHHMM(minutos) {
        if (minutos <= 0) return '0:00';
        const h = Math.floor(minutos / 60);
        const m = minutos % 60;
        return h + ':' + String(m).padStart(2, '0');
    }

    function calcularMinutosBloco(el) {
        const entrada = parseHHMM(el.querySelector('.bloco-entrada').value);
        const saida   = parseHHMM(el.querySelector('.bloco-saida').value);
        const repouso = parseHHMM(el.querySelector('.bloco-repouso').value);
        const retorno = parseHHMM(el.querySelector('.bloco-retorno').value);
        let total = saida - entrada;
        if (repouso > 0 && retorno > 0) total -= (retorno - repouso);
        return Math.max(0, total);
    }

    function getDiasMarcadosEscala() {
        const diasPorBloco = {};
        document.querySelectorAll('#escalaBlocos .bloco-escala').forEach((el, idx) => {
            diasPorBloco[idx] = [];
            el.querySelectorAll('.dia-check-escala:checked').forEach(cb => {
                diasPorBloco[idx].push(parseInt(cb.value, 10));
            });
        });
        return diasPorBloco;
    }

    function atualizarCheckboxesDisabledEscala() {
        const diasPorBloco = getDiasMarcadosEscala();
        document.querySelectorAll('#escalaBlocos .bloco-escala').forEach((el, idx) => {
            const meusDias = new Set(diasPorBloco[idx] || []);
            const diasDosOutros = new Set();
            Object.entries(diasPorBloco).forEach(([bIdx, dias]) => {
                if (parseInt(bIdx, 10) !== idx) dias.forEach(d => diasDosOutros.add(d));
            });
            el.querySelectorAll('.dia-check-escala').forEach(cb => {
                const dia = parseInt(cb.value, 10);
                cb.disabled = diasDosOutros.has(dia) && !meusDias.has(dia);
            });
        });
    }

    function atualizarAcumuladorEscala() {
        const cargaMeta = parseHHMM(document.getElementById('escalaCargaSemanal').value);
        let totalAcumulado = 0;

        document.querySelectorAll('#escalaBlocos .bloco-escala').forEach(el => {
            const minBloco = calcularMinutosBloco(el);
            el.querySelector('.bloco-carga-display').textContent = toHHMM(minBloco) + '/dia';
            const diasMarcados = el.querySelectorAll('.dia-check-escala:checked').length;
            totalAcumulado += minBloco * diasMarcados;
        });

        const acEl = document.getElementById('escalaTotalAcumulado');
        acEl.textContent = toHHMM(totalAcumulado) + ' / ' + (document.getElementById('escalaCargaSemanal').value || '0:00');
        const igual = cargaMeta > 0 && totalAcumulado === cargaMeta;
        acEl.className = 'fw-bold fs-5 ' + (igual ? 'text-primary' : 'text-danger');
        document.getElementById('btnSalvarEscala').disabled = !igual;
    }

    function reindexarBlocosEscala() {
        document.querySelectorAll('#escalaBlocos .bloco-escala').forEach((el, idx) => {
            el.dataset.blocoIdx = idx;
            el.querySelector('.bloco-num').textContent = idx + 1;
        });
    }

    function criarBlocoEscalaEl(dados) {
        const tmpl = document.getElementById('tmplBlocoEscala');
        const clone = tmpl.content.cloneNode(true);
        const el = clone.querySelector('.bloco-escala');

        if (dados) {
            el.querySelector('.bloco-entrada').value = dados.entrada || '';
            el.querySelector('.bloco-repouso').value = dados.repouso || '';
            el.querySelector('.bloco-retorno').value = dados.retorno || '';
            el.querySelector('.bloco-saida').value   = dados.saida   || '';
            if (dados.diasSemana) {
                dados.diasSemana.forEach(d => {
                    const cb = el.querySelector(`.dia-check-escala[value="${d}"]`);
                    if (cb) cb.checked = true;
                });
            }
        }

        el.querySelector('.btn-remover-bloco-escala').addEventListener('click', () => {
            el.remove();
            reindexarBlocosEscala();
            atualizarCheckboxesDisabledEscala();
            atualizarAcumuladorEscala();
        });

        el.querySelectorAll('input').forEach(inp => {
            inp.addEventListener('change', () => { atualizarCheckboxesDisabledEscala(); atualizarAcumuladorEscala(); });
        });
        el.querySelectorAll('.dia-check-escala').forEach(cb => {
            cb.addEventListener('change', () => { atualizarCheckboxesDisabledEscala(); atualizarAcumuladorEscala(); });
        });

        return el;
    }

    function adicionarBlocoEscala(dados) {
        const container = document.getElementById('escalaBlocos');
        if (container.querySelectorAll('.bloco-escala').length >= 7) {
            alert(BJ_T.t('escritorio.jornada_colab.js.max_blocos'));
            return;
        }
        const el = criarBlocoEscalaEl(dados || null);
        container.appendChild(el);
        reindexarBlocosEscala();
        atualizarCheckboxesDisabledEscala();
        atualizarAcumuladorEscala();
    }

    function exibirResumoTenant(jornada) {
        const resumoEl = document.getElementById('escalaResumoTenant');
        if (!jornada || (!jornada.cargaHorariaSemanal && jornada.blocos.length === 0)) {
            resumoEl.classList.add('d-none');
            return;
        }

        document.getElementById('escalaResumoCargaTenant').textContent =
            ' ' + BJ_T.t('escritorio.jornada_colab.js.semanais', {horas: toHHMM(jornada.cargaHorariaSemanal || 0)});

        document.getElementById('escalaResumoBlocosTenant').innerHTML =
            resumoDosBlocos(jornada.blocos).map(l => `<div>${l}</div>`).join('');

        resumoEl.classList.remove('d-none');
    }

    function resumoDosBlocos(blocos) {
        const diasNomes = ['', BJ_T.t('escritorio.jornada_colab.js.dia_seg'), BJ_T.t('escritorio.jornada_colab.js.dia_ter'), BJ_T.t('escritorio.jornada_colab.js.dia_qua'), BJ_T.t('escritorio.jornada_colab.js.dia_qui'), BJ_T.t('escritorio.jornada_colab.js.dia_sex'), BJ_T.t('escritorio.jornada_colab.js.dia_sab'), BJ_T.t('escritorio.jornada_colab.js.dia_dom')];
        return blocos.map(b => {
            const dias = (b.diasSemana || []).map(d => diasNomes[d] || d).join(', ');
            const horario = b.repouso
                ? BJ_T.t('escritorio.jornada_colab.js.horario_com_repouso', {entrada: b.entrada, repouso: b.repouso, retorno: b.retorno, saida: b.saida})
                : BJ_T.t('escritorio.jornada_colab.js.horario', {entrada: b.entrada, saida: b.saida});
            return BJ_T.t('escritorio.jornada_colab.js.linha_bloco', {dias: dias, horario: horario, carga: toHHMM(b.minutosBloco)});
        });
    }

    // Versões da jornada (spec ponto-jornada-vigencia §10.2). O formulário abre no modo "nova versão" com a data de
    // hoje; "Editar" no histórico carrega aquela versão, e salvar muda só ela.
    let estadoEscala = null;
    let versaoEmEdicao = null;

    function dataBr(iso) {
        const [ano, mes, dia] = iso.split('-');
        return `${dia}/${mes}/${ano}`;
    }

    function temJornadaPessoal(versao) {
        return Boolean(versao.cargaHorariaSemanal) || versao.blocos.length > 0;
    }

    function preencherFormulario(carga, blocos, valeAPartirDe, versao) {
        versaoEmEdicao = versao;
        document.getElementById('escalaCargaSemanal').value = toHHMM(carga || 2400);
        document.getElementById('escalaValeAPartirDe').value = valeAPartirDe;
        document.getElementById('escalaBlocos').innerHTML = '';
        blocos.forEach(b => adicionarBlocoEscala(b));
        document.getElementById('escalaModoTitulo').textContent = versao
            ? BJ_T.t('escritorio.jornada_colab.js.editando', {data: dataBr(versao.valeAPartirDe)})
            : BJ_T.t('escritorio.jornada_colab.js.nova_versao');
        document.getElementById('btnCancelarEdicaoEscala').classList.toggle('d-none', !versao);
        document.getElementById('escalaErro').classList.add('d-none');
        atualizarCheckboxesDisabledEscala();
        atualizarAcumuladorEscala();
    }

    // Sem versão valendo hoje, a nova versão parte da jornada do escritório (§10.2.1).
    function abrirNovaVersao() {
        const blocos = estadoEscala.versaoVigenteId ? (estadoEscala.blocos || []) : (estadoEscala.jornadaTenant?.blocos || []);
        preencherFormulario(estadoEscala.cargaHorariaSemanal, blocos, estadoEscala.hoje, null);
    }

    function editarVersao(versao) {
        preencherFormulario(versao.cargaHorariaSemanal || estadoEscala.cargaHorariaSemanal, versao.blocos, versao.valeAPartirDe, versao);
        document.getElementById('escalaModoTitulo').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function botaoDoHistorico(texto, classes, icone, aoClicar) {
        const botao = document.createElement('button');
        botao.type = 'button';
        botao.className = 'bjp-btn ' + classes;
        const i = document.createElement('i');
        i.className = 'bi ' + icone;
        botao.append(i, texto);
        botao.addEventListener('click', aoClicar);
        return botao;
    }

    function periodoDaVersao(versao) {
        let periodo;
        if (versao.valeParaTras) {
            periodo = versao.ate ? BJ_T.t('escritorio.jornada_colab.js.ate', {data: dataBr(versao.ate)}) : BJ_T.t('escritorio.jornada_colab.js.todos_os_dias');
        } else {
            periodo = versao.ate
                ? BJ_T.t('escritorio.jornada_colab.js.de_a', {de: dataBr(versao.valeAPartirDe), ate: dataBr(versao.ate)})
                : BJ_T.t('escritorio.jornada_colab.js.a_partir_de', {data: dataBr(versao.valeAPartirDe)});
        }
        if (versao.vigente) periodo += ' (' + BJ_T.t('escritorio.jornada_colab.js.atual') + ')';
        if (versao.agendada) periodo += ' (' + BJ_T.t('escritorio.jornada_colab.js.agendada') + ')';
        return periodo;
    }

    function exibirHistorico(versoes) {
        const caixa = document.getElementById('escalaHistorico');
        const linhas = document.getElementById('escalaHistoricoLinhas');
        linhas.innerHTML = '';
        caixa.classList.toggle('d-none', !versoes.some(temJornadaPessoal));

        versoes.slice().reverse().forEach(versao => {
            const periodo = document.createElement('td');
            periodo.textContent = periodoDaVersao(versao);

            const carga = document.createElement('td');
            carga.textContent = temJornadaPessoal(versao)
                ? toHHMM(versao.cargaHorariaSemanal || 0)
                : BJ_T.t('escritorio.jornada_colab.js.jornada_do_escritorio');

            const blocos = document.createElement('td');
            blocos.className = 'small text-muted';
            resumoDosBlocos(versao.blocos).forEach(texto => {
                const linha = document.createElement('div');
                linha.textContent = texto;
                blocos.appendChild(linha);
            });

            const acoes = document.createElement('td');
            acoes.className = 'text-end text-nowrap';
            acoes.appendChild(botaoDoHistorico(BJ_T.t('escritorio.jornada_colab.js.editar'), 'bjp-btn--secundario', 'bi-pencil', () => editarVersao(versao)));
            if (versoes.length > 1) {
                acoes.appendChild(botaoDoHistorico(BJ_T.t('escritorio.jornada_colab.js.excluir'), 'bjp-btn--destrutivo ms-1', 'bi-trash', ev => excluirVersao(versao, ev.currentTarget)));
            }

            const tr = document.createElement('tr');
            tr.append(periodo, carga, blocos, acoes);
            linhas.appendChild(tr);
        });
    }

    async function excluirVersao(versao, botao) {
        if (!confirm(BJ_T.t('escritorio.jornada_colab.js.excluir_confirmar', {data: dataBr(versao.valeAPartirDe)}))) return;

        botao.disabled = true;
        try {
            const resp = await fetch(escalaUrl + '/versao/' + versao.id, {
                method:  'DELETE',
                headers: { 'Accept': 'application/json' },
            });
            if (resp.ok) {
                window.location.href = window.location.pathname + '?tab=escala';
                return;
            }
            const result = await resp.json().catch(() => ({}));
            alert(result.erro || BJ_T.t('escritorio.jornada_colab.js.erro_excluir'));
        } catch (err) {
            alert(BJ_T.t('escritorio.jornada_colab.js.falha_servidor'));
        }
        botao.disabled = false;
    }

    async function carregarEscala() {
        document.getElementById('escalaLoadingMsg').classList.remove('d-none');
        document.getElementById('escalaFormContainer').classList.add('d-none');
        document.getElementById('escalaAvisoLegado').classList.add('d-none');
        document.getElementById('escalaBlocos').innerHTML = '';

        try {
            const resp = await fetch(escalaUrl, { headers: { 'Accept': 'application/json' } });
            const dados = await resp.json();
            estadoEscala = dados;

            document.getElementById('escalaAlertaHabilitado').checked = dados.alertaHabilitado !== false;

            if (dados.temCamposLegados && !dados.temBlocosUsuario) {
                document.getElementById('escalaAvisoLegado').classList.remove('d-none');
            }

            exibirResumoTenant(dados.jornadaTenant);
            exibirHistorico(dados.versoes || []);
            if ((dados.versoes || []).some(temJornadaPessoal)) {
                document.getElementById('btnLimparEscala').classList.remove('d-none');
            }
            abrirNovaVersao();

            document.getElementById('escalaLoadingMsg').classList.add('d-none');
            document.getElementById('escalaFormContainer').classList.remove('d-none');
            atualizarAcumuladorEscala();
        } catch (err) {
            document.getElementById('escalaLoadingMsg').innerHTML =
                '<p class="text-danger"></p>';
            document.querySelector('#escalaLoadingMsg p').textContent = BJ_T.t('escritorio.jornada_colab.js.erro_carregar');
        }
    }

    document.getElementById('btnAdicionarBlocoEscala').addEventListener('click', () => adicionarBlocoEscala(null));
    document.getElementById('btnCancelarEdicaoEscala').addEventListener('click', abrirNovaVersao);
    document.getElementById('escalaCargaSemanal').addEventListener('input', atualizarAcumuladorEscala);

    document.getElementById('btnSalvarEscala').addEventListener('click', async function () {
        const erroEl = document.getElementById('escalaErro');
        erroEl.classList.add('d-none');

        const cargaMin = parseHHMM(document.getElementById('escalaCargaSemanal').value);
        const alerta   = document.getElementById('escalaAlertaHabilitado').checked;
        const valeAPartirDe = document.getElementById('escalaValeAPartirDe').value;

        if (!valeAPartirDe) {
            erroEl.textContent = BJ_T.t('escritorio.jornada_colab.js.informe_data');
            erroEl.classList.remove('d-none');
            return;
        }
        // Data no passado: a folha e o saldo mudam desde a mais antiga entre a data nova e a antiga da versão.
        const desde = versaoEmEdicao && versaoEmEdicao.valeAPartirDe < valeAPartirDe ? versaoEmEdicao.valeAPartirDe : valeAPartirDe;
        if (estadoEscala && desde < estadoEscala.hoje
            && !confirm(BJ_T.t('escritorio.jornada_colab.js.recalcular_confirmar', {data: dataBr(desde)}))) {
            return;
        }

        const blocos = [];
        document.querySelectorAll('#escalaBlocos .bloco-escala').forEach(el => {
            const dias = [];
            el.querySelectorAll('.dia-check-escala:checked').forEach(cb => dias.push(parseInt(cb.value, 10)));
            blocos.push({
                diasSemana:   dias,
                entrada:      el.querySelector('.bloco-entrada').value,
                repouso:      el.querySelector('.bloco-repouso').value || '',
                retorno:      el.querySelector('.bloco-retorno').value || '',
                saida:        el.querySelector('.bloco-saida').value,
                minutosBloco: calcularMinutosBloco(el),
            });
        });

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + BJ_T.t('escritorio.jornada_colab.js.salvando');

        try {
            const resp = await fetch(escalaUrl, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body:    JSON.stringify(Object.assign(
                    { cargaHorariaSemanal: cargaMin, alertaHabilitado: alerta, blocos, valeAPartirDe },
                    versaoEmEdicao ? { versaoId: versaoEmEdicao.id } : {},
                )),
            });

            const result = await resp.json();

            if (!resp.ok) {
                erroEl.textContent = result.erro || BJ_T.t('escritorio.jornada_colab.js.erro_salvar');
                erroEl.classList.remove('d-none');
            } else {
                window.location.href = window.location.pathname + '?tab=escala';
            }
        } catch (err) {
            erroEl.textContent = BJ_T.t('escritorio.jornada_colab.js.falha_servidor');
            erroEl.classList.remove('d-none');
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-save me-1"></i>' + BJ_T.t('escritorio.jornada_colab.js.salvar');
            atualizarAcumuladorEscala();
        }
    });

    const btnLimpar = document.getElementById('btnLimparEscala');
    if (btnLimpar) {
        btnLimpar.addEventListener('click', async function () {
            if (!confirm(BJ_T.t('escritorio.jornada_colab.js.limpar_confirmar'))) return;

            this.disabled = true;

            try {
                const resp = await fetch(escalaUrl, {
                    method:  'DELETE',
                    headers: { 'Accept': 'application/json' },
                });

                if (resp.ok) {
                    window.location.href = window.location.pathname + '?tab=escala';
                } else {
                    const result = await resp.json().catch(() => ({}));
                    alert(result.erro || BJ_T.t('escritorio.jornada_colab.js.erro_limpar'));
                    this.disabled = false;
                }
            } catch (err) {
                alert(BJ_T.t('escritorio.jornada_colab.js.falha_servidor'));
                this.disabled = false;
            }
        });
    }

    // Chave "Registra ponto eletrônico": grava na hora; recusada (choque com outro escritório), volta como estava.
    const chavePonto = document.getElementById('registraPontoChave');
    if (chavePonto) {
        chavePonto.addEventListener('change', async function () {
            const erroEl = document.getElementById('registraPontoErro');
            const pedido = this.checked;
            erroEl.classList.add('d-none');
            this.disabled = true;
            try {
                const resp = await fetch(this.dataset.url, {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body:    JSON.stringify({ registraPonto: pedido }),
                });
                const result = await resp.json().catch(() => ({}));
                if (!resp.ok) {
                    this.checked = !pedido;
                    erroEl.textContent = result.erro || this.dataset.falha;
                    erroEl.classList.remove('d-none');
                }
            } catch (err) {
                this.checked = !pedido;
                erroEl.textContent = this.dataset.falha;
                erroEl.classList.remove('d-none');
            } finally {
                this.disabled = false;
            }
        });
    }

    // Carrega ao entrar na aba
    const tabEscalaBtn = document.getElementById('tab-escala-btn');
    if (tabEscalaBtn) {
        tabEscalaBtn.addEventListener('shown.bs.tab', carregarEscala);

        // Se a aba já está ativa no carregamento (ex.: ?tab=escala), carrega imediatamente
        if (tabEscalaBtn.classList.contains('active')) {
            carregarEscala();
        } else {
            // Aguarda o DOMContentLoaded, pois o script do pai pode ativar a aba
            document.addEventListener('DOMContentLoaded', function () {
                if (tabEscalaBtn.classList.contains('active')) {
                    carregarEscala();
                }
            });
        }
    }
})();
</script>
