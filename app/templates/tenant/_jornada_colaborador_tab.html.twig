        <div class="bjp-painel-corpo pb-2">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="fw-semibold text-muted small">{{ 'escritorio.jornada_colab.bloco'|trans }} <span class="bloco-num"></span></span>
                <button type="button" class="bjp-ico bjp-btn--destrutivo btn-remover-bloco-escala">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">{{ 'escritorio.jornada_colab.dias_semana'|trans }}</label>
                <div class="d-flex flex-wrap gap-2 bloco-dias">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input dia-check-escala" type="checkbox" value="1">
