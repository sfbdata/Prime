<div class="bjp-painel mb-3">
    <div class="bjp-painel-cabeca d-flex justify-content-between align-items-center">
        <h3 class="bjp-painel-titulo mb-0"><i class="bi bi-clock me-2"></i>{{ 'escritorio.jornada_colab.titulo'|trans }}</h3>
        {# Aparece também quando só há versão agendada (o JS confere o histórico ao carregar). #}
        <button type="button" class="bjp-btn bjp-btn--destrutivo{{ userHasCustomEscala ? '' : ' d-none' }}" id="btnLimparEscala">
            <i class="bi bi-arrow-counterclockwise"></i>{{ 'escritorio.jornada_colab.limpar'|trans }}
        </button>
    </div>
    <div class="bjp-painel-corpo">

        {# Chave "Registra ponto eletrônico" da pessoa NESTE escritório (spec seguranca-b-jornada §3.4) #}
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="registraPontoChave"{{ registraPonto ? ' checked' }}
                   data-url="{{ path('app_jornada_colaborador_registra_ponto', {tenantId: tenantId, id: user.id}) }}"
                   data-falha="{{ 'escritorio.editar_usuario.ponto_eletronico.falha'|trans }}">
            <label class="form-check-label fw-semibold" for="registraPontoChave">{{ 'escritorio.editar_usuario.ponto_eletronico.rotulo'|trans }}</label>
            <div class="form-text">{{ 'escritorio.editar_usuario.ponto_eletronico.ajuda'|trans }}</div>
        </div>
        <div id="registraPontoErro" class="alert alert-danger d-none" style="white-space: pre-line"></div>

        {# Aviso de jornada legada #}
        <div id="escalaAvisoLegado" class="alert alert-warning d-none">
            <i class="bi bi-exclamation-triangle me-2"></i>
            {{ 'escritorio.jornada_colab.legado'|trans }}
        </div>

        {# Resumo somente leitura da jornada do escritório #}
        <div id="escalaResumoTenant" class="alert alert-info mb-3 d-none">
            <strong><i class="bi bi-building me-1"></i>{{ 'escritorio.jornada_colab.jornada_escritorio'|trans }}</strong>
            <span id="escalaResumoCargaTenant"></span>
            <div id="escalaResumoBlocosTenant" class="mt-1 small text-muted"></div>
        </div>

        <div id="escalaLoadingMsg" class="text-center py-4">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="mt-2 text-muted">{{ 'escritorio.jornada_colab.carregando'|trans }}</p>
        </div>

        <div id="escalaFormContainer" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0" id="escalaModoTitulo">{{ 'escritorio.jornada_colab.nova_versao'|trans }}</h6>
                <button type="button" class="bjp-btn bjp-btn--discreto d-none" id="btnCancelarEdicaoEscala">{{ 'escritorio.jornada_colab.cancelar_edicao'|trans }}</button>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="escalaValeAPartirDe">{{ 'escritorio.jornada_colab.vale_a_partir'|trans }}</label>
                    <input type="date" id="escalaValeAPartirDe" class="form-control">
                    <div class="form-text">{{ 'escritorio.jornada_colab.vale_a_partir_ajuda'|trans }}</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">{{ 'escritorio.jornada_colab.carga_semanal'|trans }}</label>
                    <input type="text" id="escalaCargaSemanal" class="form-control" placeholder="40:00" maxlength="5">
                    <div class="form-text">{{ 'escritorio.jornada_colab.carga_ajuda'|trans }}</div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="escalaAlertaHabilitado">
                        <label class="form-check-label" for="escalaAlertaHabilitado">
                            {{ 'escritorio.jornada_colab.alertas'|trans }}
                        </label>
                        <div class="form-text">{{ 'escritorio.jornada_colab.alertas_ajuda'|trans }}</div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">{{ 'escritorio.jornada_colab.blocos'|trans }}</h6>
                <button type="button" class="bjp-btn bjp-btn--secundario" id="btnAdicionarBlocoEscala">
                    <i class="bi bi-plus-lg"></i>{{ 'escritorio.jornada_colab.adicionar_bloco'|trans }}
                </button>
            </div>

            <div id="escalaBlocos"></div>

            <div class="mt-3 p-3 rounded border bg-body-tertiary d-flex justify-content-between align-items-center">
                <span class="fw-semibold">{{ 'escritorio.jornada_colab.total'|trans }}</span>
                <span id="escalaTotalAcumulado" class="fw-bold fs-5">00:00 / 00:00</span>
            </div>

            <div id="escalaErro" class="alert alert-danger mt-3 d-none" style="white-space: pre-line"></div>

            {# Versões da jornada, da mais nova para a mais antiga (spec ponto-jornada-vigencia §5.2 e §10.2) #}
            <div id="escalaHistorico" class="mt-4 d-none">
                <h6 class="mb-2">{{ 'escritorio.jornada_colab.historico'|trans }}</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'escritorio.jornada_colab.col_periodo'|trans }}</th>
                                <th>{{ 'escritorio.jornada_colab.col_carga'|trans }}</th>
                                <th>{{ 'escritorio.jornada_colab.col_blocos'|trans }}</th>
                                <th class="text-end">{{ 'escritorio.jornada_colab.col_acoes'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody id="escalaHistoricoLinhas"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <div class="bjp-painel-pe d-flex justify-content-end gap-2">
        <button type="button" class="bjp-btn bjp-btn--secundario" id="btnSalvarEscala" disabled>
            <i class="bi bi-save"></i>{{ 'escritorio.jornada_colab.salvar'|trans }}
        </button>
    </div>
</div>

{# Template JS para um bloco de jornada do colaborador #}
