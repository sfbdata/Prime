<div class="bjp-painel mb-3">
    <div class="bjp-painel-cabeca d-flex justify-content-between align-items-center">
        <h3 class="bjp-painel-titulo mb-0"><i class="bi bi-house-laptop me-2"></i>{{ 'escritorio.home_office.titulo'|trans }}</h3>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="hoAtivo" checked>
            <label class="form-check-label" for="hoAtivo">{{ 'escritorio.home_office.habilitado'|trans }}</label>
        </div>
    </div>
    <div class="bjp-painel-corpo">

        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            {{ 'escritorio.home_office.explicacao_antes'|trans }} <strong>{{ 'escritorio.home_office.explicacao_destaque'|trans }}</strong>
            {{ 'escritorio.home_office.explicacao_depois'|trans }}
        </p>

        <div id="hoLoading" class="text-center py-4">
            <div class="spinner-border text-info" role="status"></div>
            <p class="mt-2 text-muted">{{ 'escritorio.home_office.carregando'|trans }}</p>
        </div>

        <div id="hoForm" class="d-none">
            <div class="mb-3">
                <label class="form-label fw-semibold">{{ 'escritorio.home_office.dias_semana'|trans }}</label>
                <div class="d-flex flex-wrap gap-2" id="hoDias">
                    {% set nomesDias = {1: 'escritorio.home_office.dia_seg'|trans, 2: 'escritorio.home_office.dia_ter'|trans, 3: 'escritorio.home_office.dia_qua'|trans, 4: 'escritorio.home_office.dia_qui'|trans, 5: 'escritorio.home_office.dia_sex'|trans, 6: 'escritorio.home_office.dia_sab'|trans, 7: 'escritorio.home_office.dia_dom'|trans} %}
                    {% for valor, nome in nomesDias %}
                        <div class="form-check form-check-inline">
                            <input class="form-check-input dia-check-ho" type="checkbox" value="{{ valor }}" id="hoDia{{ valor }}">
                            <label class="form-check-label small" for="hoDia{{ valor }}">{{ nome }}</label>
                        </div>
                    {% endfor %}
                </div>
                <div class="form-text">{{ 'escritorio.home_office.marque_todos'|trans }}</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">{{ 'escritorio.home_office.vigencia_inicio'|trans }} <span class="text-muted fw-normal small">{{ 'escritorio.home_office.opcional'|trans }}</span></label>
                    <input type="date" id="hoVigInicio" class="form-control">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">{{ 'escritorio.home_office.vigencia_fim'|trans }} <span class="text-muted fw-normal small">{{ 'escritorio.home_office.opcional'|trans }}</span></label>
                    <input type="date" id="hoVigFim" class="form-control">
                </div>
                <div class="form-text">
                    {{ 'escritorio.home_office.vig_ajuda_antes'|trans }} <strong>{{ 'escritorio.home_office.vig_ajuda_destaque'|trans }}</strong>;
                    {{ 'escritorio.home_office.vig_ajuda_depois'|trans }}
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">{{ 'escritorio.home_office.datas_avulsas'|trans }}</label>
                <div class="input-group">
                    <input type="date" id="hoDataAvulsa" class="form-control">
                    <button type="button" class="bjp-btn bjp-btn--secundario" id="hoAddData">
                        <i class="bi bi-plus-lg"></i>{{ 'escritorio.home_office.adicionar'|trans }}
                    </button>
                </div>
                <div id="hoDatasLista" class="d-flex flex-wrap gap-2 mt-2"></div>
            </div>

            <div id="hoErro" class="alert alert-danger d-none"></div>
        </div>

    </div>
    <div class="bjp-painel-pe d-flex justify-content-between gap-2">
        <button type="button" class="bjp-btn bjp-btn--destrutivo" id="hoBtnLimpar">
            <i class="bi bi-trash"></i>{{ 'escritorio.home_office.remover_config'|trans }}
        </button>
        <button type="button" class="bjp-btn bjp-btn--secundario" id="hoBtnSalvar">
            <i class="bi bi-save"></i>{{ 'escritorio.home_office.salvar'|trans }}
        </button>
    </div>
</div>

{{ catalogo_js('escritorio.home_office.js') }}
{# O texto é lido depois do fetch, que pode voltar antes do bj-traducao.js do fim do base: ele vem aqui também (ignora a segunda carga). #}
<script src="{{ asset('js/bj-traducao.js') }}"></script>
<script>
(function () {
    'use strict';

    const hoUrl = {{ path('app_home_office_get', {tenantId: tenantId, id: user.id})|json_encode|raw }};
    let datasAvulsas = [];

    function renderDatas() {
        const container = document.getElementById('hoDatasLista');
        container.innerHTML = '';
        datasAvulsas.forEach((data, idx) => {
            const chip = document.createElement('span');
            chip.className = 'badge text-bg-secondary d-inline-flex align-items-center gap-1';
            chip.textContent = data;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-close btn-close-white btn-sm';
            btn.setAttribute('aria-label', BJ_T.t('escritorio.home_office.js.remover'));
            btn.addEventListener('click', () => { datasAvulsas.splice(idx, 1); renderDatas(); });
            chip.appendChild(btn);
            container.appendChild(chip);
        });
    }

    function setDias(dias) {
        const marcados = new Set((dias || []).map(Number));
        document.querySelectorAll('.dia-check-ho').forEach(cb => {
            cb.checked = marcados.has(parseInt(cb.value, 10));
        });
    }

    function getDias() {
        const dias = [];
        document.querySelectorAll('.dia-check-ho:checked').forEach(cb => dias.push(parseInt(cb.value, 10)));
        return dias;
    }

    async function carregar() {
        document.getElementById('hoLoading').classList.remove('d-none');
        document.getElementById('hoForm').classList.add('d-none');

        try {
            const resp = await fetch(hoUrl, { headers: { 'Accept': 'application/json' } });
            const dados = await resp.json();

            document.getElementById('hoAtivo').checked = dados.ativo !== false;
            setDias(dados.diasSemana);
            document.getElementById('hoVigInicio').value = dados.vigenciaInicio || '';
            document.getElementById('hoVigFim').value = dados.vigenciaFim || '';
            datasAvulsas = (dados.datasAvulsas || []).slice();
            renderDatas();

            document.getElementById('hoLoading').classList.add('d-none');
            document.getElementById('hoForm').classList.remove('d-none');
        } catch (err) {
            document.getElementById('hoLoading').innerHTML =
                '<p class="text-danger"></p>';
            document.querySelector('#hoLoading p').textContent = BJ_T.t('escritorio.home_office.js.erro_carregar');
        }
    }

    document.getElementById('hoAddData').addEventListener('click', function () {
        const input = document.getElementById('hoDataAvulsa');
        const valor = input.value;
        if (valor && !datasAvulsas.includes(valor)) {
            datasAvulsas.push(valor);
            datasAvulsas.sort();
            renderDatas();
        }
        input.value = '';
    });

    document.getElementById('hoBtnSalvar').addEventListener('click', async function () {
        const erroEl = document.getElementById('hoErro');
        erroEl.classList.add('d-none');

        const payload = {
            diasSemana: getDias(),
            datasAvulsas: datasAvulsas,
            vigenciaInicio: document.getElementById('hoVigInicio').value || null,
            vigenciaFim: document.getElementById('hoVigFim').value || null,
            ativo: document.getElementById('hoAtivo').checked,
        };

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + BJ_T.t('escritorio.home_office.js.salvando');

        try {
            const resp = await fetch(hoUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload),
            });
            const result = await resp.json();

            if (!resp.ok) {
                erroEl.textContent = result.erro || BJ_T.t('escritorio.home_office.js.erro_salvar');
                erroEl.classList.remove('d-none');
            } else {
                window.location.href = window.location.pathname + '?tab=home-office';
            }
        } catch (err) {
            erroEl.textContent = BJ_T.t('escritorio.home_office.js.falha_servidor');
            erroEl.classList.remove('d-none');
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-save me-1"></i>' + BJ_T.t('escritorio.home_office.js.salvar');
        }
    });

    document.getElementById('hoBtnLimpar').addEventListener('click', async function () {
        if (!confirm(BJ_T.t('escritorio.home_office.js.remover_confirmar'))) return;

        this.disabled = true;
        try {
            const resp = await fetch(hoUrl, { method: 'DELETE', headers: { 'Accept': 'application/json' } });
            if (resp.ok) {
                window.location.href = window.location.pathname + '?tab=home-office';
            } else {
                alert(BJ_T.t('escritorio.home_office.js.erro_remover'));
                this.disabled = false;
            }
        } catch (err) {
            alert(BJ_T.t('escritorio.home_office.js.falha_servidor'));
            this.disabled = false;
        }
    });

    const tabBtn = document.getElementById('tab-home-office-btn');
    if (tabBtn) {
        tabBtn.addEventListener('shown.bs.tab', carregar);

        if (tabBtn.classList.contains('active')) {
            carregar();
        } else {
            document.addEventListener('DOMContentLoaded', function () {
                if (tabBtn.classList.contains('active')) {
                    carregar();
                }
            });
        }
    }
})();
</script>
