                    <label class="mp-campo"><span>{{ 'perfil.senha.nova'|trans }}</span>{{ form_widget(form_senha.senha.first, {attr: {autocomplete: 'new-password', placeholder: 'perfil.senha.nova_placeholder'|trans}}) }}</label>
                    <label class="mp-campo"><span>{{ 'perfil.senha.confirmar'|trans }}</span>{{ form_widget(form_senha.senha.second, {attr: {autocomplete: 'new-password'}}) }}</label>
