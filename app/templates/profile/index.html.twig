                </div>
                <div class="mp-modal-rodape">
                    <button type="button" class="mp-btn-cinza" data-bs-dismiss="modal">{{ 'perfil.acoes.cancelar'|trans }}</button>
                    <button type="submit" class="mp-btn-azul"><i class="bi bi-check2"></i>{{ 'perfil.acoes.salvar'|trans }}</button>
                </div>
            {{ form_end(form_senha) }}
        </div>
