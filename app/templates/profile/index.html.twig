                    {{ 'perfil.foto.salvar'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Editar dados pessoais
══════════════════════════════════════════════ #}
<div class="modal fade mp-modal" id="modalDadosPessoais" tabindex="-1" aria-labelledby="modalDadosPessoaisLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mp-modal-largo">
        <div class="modal-content">
            <div class="mp-modal-topo">
                <i class="bi bi-pencil"></i><b id="modalDadosPessoaisLabel">{{ 'perfil.editar.titulo'|trans }}</b>
                <button type="button" class="mp-modal-x" data-bs-dismiss="modal" aria-label="{{ 'perfil.acoes.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            {{ form_start(form_dados, {action: path('app_profile_dados'), attr: {id: 'formDadosPessoais', novalidate: 'novalidate'}}) }}
                {% if current_tenant() %}
                    <div class="mp-vinculo" data-mp-vinculo>
                        <span class="mp-rotulo">{{ 'perfil.editar.vinculo'|trans }}</span>
                        <div class="mp-vinculo-opcoes">
                            {% for opcao in form_dados.vinculo %}
                                <label class="mp-vinculo-op{{ opcao.vars.checked ? ' on' : '' }}{{ podeAlterarVinculo ? '' : ' travado' }}">
                                    {{ form_widget(opcao, {attr: opcao.vars.attr|merge({class: 'visually-hidden'})|merge(podeAlterarVinculo ? {} : {disabled: 'disabled'})}) }}
                                    <i class="bi {{ opcao.vars.attr['data-icone'] }}"></i>{{ opcao.vars.label }}
                                </label>
                            {% endfor %}
                        </div>
                        <span class="mp-ajuda" data-mp-vinculo-ajuda>
                            {% if podeAlterarVinculo %}
                                <i class="bi bi-info-circle"></i><span data-mp-ajuda-texto>{{ perfil.vinculo.ajuda }}</span>
                            {% else %}
                                <i class="bi bi-lock"></i><span>{{ 'perfil.editar.vinculo_travado'|trans }}</span>
                            {% endif %}
                        </span>
                    </div>
                {% else %}
                    {% do form_dados.vinculo.setRendered %}
                {% endif %}
                <div class="mp-campos">
                    <label class="mp-campo mp-campo-inteiro"><span>{{ 'perfil.editar.nome_completo'|trans }}</span>{{ form_widget(form_dados.nomeCompleto) }}</label>
                    <label class="mp-campo mp-campo-inteiro"><span>{{ 'perfil.editar.frase'|trans }}</span>{{ form_widget(form_dados.status) }}</label>
                    <label class="mp-campo"><span>{{ 'perfil.editar.telefone'|trans }}</span>{{ form_widget(form_dados.telefone) }}</label>
                    <label class="mp-campo"><span>{{ 'perfil.editar.pix_recompensa'|trans }}</span>{{ form_widget(form_dados.chavePixRecompensa, {attr: {placeholder: 'perfil.editar.pix_recompensa_placeholder'|trans}}) }}</label>
                    <label class="mp-campo"><span>{{ 'perfil.editar.cpf'|trans }}</span>{{ form_widget(form_dados.cpf, {attr: {placeholder: 'perfil.editar.cpf_placeholder'|trans}}) }}<small>{{ 'perfil.editar.cpf_ajuda'|trans }}</small></label>
                    <label class="mp-campo"><span>{{ 'perfil.editar.nascimento'|trans }}</span>{{ form_widget(form_dados.dataNascimento) }}</label>
                    <label class="mp-campo"><span>{{ 'perfil.editar.genero'|trans }}</span>{{ form_widget(form_dados.genero) }}<small>{{ 'perfil.editar.genero_ajuda'|trans }}</small></label>
                    <label class="mp-campo"><span>{{ 'perfil.editar.atuacao'|trans }}</span>{{ form_widget(form_dados.atuacao) }}{% if atuacaoSugerida|default(null) %}<small data-mp-atuacao-sugerida="{{ atuacaoSugerida.value }}"><i class="bi bi-magic"></i> {{ 'perfil.editar.atuacao_sugestao'|trans({rotulo: atuacaoSugerida.rotulo}) }} <a href="#" data-mp-usar-sugestao>{{ 'perfil.editar.atuacao_usar'|trans }}</a></small>{% endif %}</label>
                    <label class="mp-campo" data-mp-para="clt"><span>{{ 'perfil.editar.ctps'|trans }}</span>{{ form_widget(form_dados.ctps, {attr: {placeholder: ''}}) }}<small>{{ 'perfil.editar.ctps_ajuda'|trans }}</small></label>
                    <label class="mp-campo" data-mp-para="clt"><span>{{ 'perfil.editar.serie'|trans }}</span>{{ form_widget(form_dados.serie, {attr: {placeholder: ''}}) }}</label>
                    <label class="mp-campo" data-mp-para="clt"><span>{{ 'perfil.editar.data_admissao'|trans }}</span>{{ form_widget(form_dados.dataAdmissao) }}</label>
                    <label class="mp-campo" data-mp-para="pj"><span>{{ 'perfil.editar.cnpj'|trans }}</span>{{ form_widget(form_dados.cnpj) }}</label>
                    <label class="mp-campo" data-mp-para="associado pj socio estagio"><span data-mp-rotulo-inicio>{{ perfil.vinculo.rotuloInicio|upper }}</span>{{ form_widget(form_dados.contratoInicio) }}<small>{{ 'perfil.editar.contrato_inicio_ajuda'|trans }}</small></label>
                </div>
                <div class="mp-modal-rodape">
                    <button type="button" class="mp-btn-cinza" data-bs-dismiss="modal">{{ 'perfil.acoes.cancelar'|trans }}</button>
                    <button type="submit" class="mp-btn-azul"><i class="bi bi-check2"></i>{{ 'perfil.acoes.salvar'|trans }}</button>
                </div>
            {{ form_end(form_dados) }}
        </div>
    </div>
</div>

{# Revisão mensal do cadastro (desenho 07, revOn): o JS decide se mostra neste mês. #}
<div class="modal fade mp-modal" id="modalRevisao" tabindex="-1" aria-labelledby="modalRevisaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mp-modal-medio">
        <div class="modal-content">
            <div class="mp-rev-topo">
                <button type="button" class="mp-modal-x" data-bs-dismiss="modal" aria-label="{{ 'perfil.acoes.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
                <i class="bi bi-person-check"></i>
                <div class="mp-rev-titulo" id="modalRevisaoLabel">{{ 'perfil.revisao.titulo'|trans }}</div>
                <div class="mp-rev-sub">{{ 'perfil.revisao.mensal'|trans }} · {{ perfil.revisadoEm ? 'perfil.revisao.ultima_confirmacao'|trans({data: perfil.revisadoEm|data}) : 'perfil.revisao.primeira'|trans }}</div>
            </div>
            <div class="mp-rev-corpo">
                <div class="mp-texto">{{ completude.faltando is empty
                    ? 'perfil.revisao.texto_completo'|trans
                    : 'perfil.revisao.texto_faltam'|trans({itens: completude.faltando|join(', ')}) }}</div>
                <div class="mp-rev-barra"><div class="mp-barra mp-barra-azul"><div style="width: {{ completude.percentual }}%"></div></div><b>{{ completude.percentual }}%</b></div>
                <div class="mp-rev-resumo">
                    <div><span>{{ 'perfil.revisao.telefone'|trans }}</span><b>{{ perfil.telefone ?: _naoInformado }}</b></div>
                    <div><span>{{ 'perfil.revisao.vinculo'|trans }}</span><b>{{ perfil.vinculo.rotulo }}</b></div>
                    <div><span>{{ 'perfil.revisao.oab_principal'|trans }}</span><b>{{ perfil.oabNumero ? perfil.oabNumero ~ '/' ~ perfil.oabUf : 'perfil.revisao.oab_nao_informada'|trans }}</b></div>
                </div>
                <div class="mp-modal-rodape mp-rodape-solto">
                    <button type="button" class="mp-btn-cinza" data-mp-revisao-ok>{{ 'perfil.revisao.tudo_certo'|trans }}</button>
                    <button type="button" class="mp-btn-azul" data-mp-revisao-ir><i class="bi bi-pencil"></i>{{ 'perfil.revisao.atualizar'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal "Inscrição na OAB" (desenho 07, linhas 127 a 132 e ofTipos/ofTipoAj/ofPodeRemover). #}
<div class="modal fade mp-modal" id="modalOab" tabindex="-1" aria-labelledby="modalOabLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mp-modal-largo">
        <div class="modal-content">
            <div class="mp-modal-topo">
                <i class="bi bi-patch-check"></i><b id="modalOabLabel">{{ 'perfil.oab.modal.titulo'|trans }}</b>
                <button type="button" class="mp-modal-x" data-bs-dismiss="modal" aria-label="{{ 'perfil.acoes.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <form action="{{ path('app_profile_oab') }}" method="post" id="formOab" data-tem-principal="{{ inscricoesOab is empty ? '0' : '1' }}"
                  {% if erroOab %}data-reabrir="{{ erroOab|json_encode|e('html_attr') }}"{% endif %}>
                <input type="hidden" name="_token" value="{{ csrf_token('profile_oab') }}">
                <input type="hidden" name="id" value="">
                <input type="hidden" name="tipo" value="principal">
                <div class="mp-oab-form">
                    <div class="mp-campo">
                        <span>{{ 'perfil.oab.modal.tipo'|trans }}</span>
                        <div class="mp-oab-tipos" role="radiogroup">
                            <button type="button" data-mp-oab-tipo="principal" role="radio"><i class="bi bi-star-fill"></i>{{ 'perfil.oab.modal.tipo_principal'|trans }}</button>
                            <button type="button" data-mp-oab-tipo="suplementar" role="radio"><i class="bi bi-diagram-2"></i>{{ 'perfil.oab.modal.tipo_suplementar'|trans }}</button>
                        </div>
                        <small data-mp-oab-ajuda data-principal="{{ 'perfil.oab.modal.ajuda_principal'|trans }}" data-suplementar="{{ 'perfil.oab.modal.ajuda_suplementar'|trans }}"></small>
                    </div>
                    <div class="mp-oab-linha-campos">
                        <label class="mp-campo"><span>{{ 'perfil.oab.modal.numero'|trans }}</span><input type="text" name="numero" maxlength="7" inputmode="numeric" placeholder="{{ 'perfil.oab.modal.numero_placeholder'|trans }}" autocomplete="off" required></label>
                        <label class="mp-campo"><span>{{ 'perfil.oab.modal.uf'|trans }}</span>
                            <select name="uf" required>
                                <option value="">{{ 'perfil.oab.modal.uf_vazio'|trans }}</option>
                                {% for uf in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'] %}<option value="{{ uf }}">{{ uf }}</option>{% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="mp-oab-erro" data-mp-oab-erro hidden><i class="bi bi-exclamation-circle"></i> <span></span></div>
                    <button type="button" class="mp-oab-remover" data-mp-oab-remover hidden><i class="bi bi-trash"></i>{{ 'perfil.oab.modal.remover'|trans }}</button>
                </div>
                <div class="mp-modal-rodape">
                    <button type="button" class="mp-btn-cinza" data-bs-dismiss="modal">{{ 'perfil.acoes.cancelar'|trans }}</button>
                    <button type="submit" class="mp-btn-azul"><i class="bi bi-check2"></i>{{ 'perfil.acoes.salvar'|trans }}</button>
                </div>
            </form>
            <form method="post" id="formOabRemover" data-acao="{{ path('app_profile_oab_remover', {id: 0}) }}" hidden>
                <input type="hidden" name="_token" value="{{ csrf_token('profile_oab_remover') }}">
            </form>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Alterar senha
