{% extends 'base.html.twig' %}

{% block title %}Meu Perfil{% endblock %}

{% block stylesheets %}
<style>
/* ── Capa ── */
.perfil-capa {
    height: 200px;
    background: linear-gradient(135deg, #1a3a5c 0%, #2563a8 60%, #3b82d4 100%);
    border-radius: 0.5rem 0.5rem 0 0;
    position: relative;
}

/* ── Card principal ── */
.perfil-card {
    border-radius: 0.5rem;
    box-shadow: 0 2px 16px rgba(0,0,0,.10);
    overflow: visible;
    background: var(--bs-body-bg);
    margin-bottom: 1.5rem;
}

/* ── Área da foto ── */
.perfil-foto-wrap {
    position: absolute;
    bottom: -56px;
    left: 2rem;
}
.perfil-foto-btn {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 4px solid var(--bs-border-color);
    overflow: hidden;
    cursor: pointer;
    background: var(--bs-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--bs-body-color);
    transition: filter .2s;
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
    padding: 0;
}
.perfil-foto-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.perfil-foto-btn:hover .perfil-foto-overlay {
    opacity: 1;
}
.perfil-foto-overlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0,0,0,.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .2s;
    pointer-events: none;
}
.perfil-foto-overlay i {
    color: #fff;
    font-size: 1.6rem;
}

/* ── Info linha abaixo da foto ── */
.perfil-info-row {
    padding: 70px 2rem 1.25rem 2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
}
.perfil-nome {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--bs-body-color);
    line-height: 1.2;
}
.perfil-cargo-lotacao {
    font-size: .88rem;
    color: var(--bs-secondary-color);
    margin-top: .2rem;
}

/* ── Campo de status ── */
.perfil-status-wrap {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: 0 2rem 1.25rem 2rem;
    border-bottom: 1px solid var(--bs-border-color);
}
.perfil-status-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: .95rem;
    color: var(--bs-body-color);
    padding: .3rem .1rem;
    border-bottom: 2px solid transparent;
    transition: border-color .2s;
    max-width: 420px;
}
.perfil-status-input:focus {
    border-bottom-color: #2563a8;
}
.perfil-status-input::placeholder {
    color: var(--bs-secondary-color);
    font-style: italic;
}
.perfil-status-save-btn {
    display: none;
    padding: .25rem .75rem;
    font-size: .82rem;
}

/* ── Grid de dados ── */
.perfil-dados-grid {
    padding: 1.25rem 2rem 1.5rem;
}
.perfil-dado-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .5rem;
    font-size: .9rem;
    color: var(--bs-body-color);
}
.perfil-dado-item i {
    font-size: 1rem;
    color: #2563a8;
    width: 20px;
    text-align: center;
}
.perfil-dado-label {
    font-weight: 600;
    color: var(--bs-body-color);
    min-width: 110px;
}

/* ── Modal de visualização de foto ── */
.modal-foto-preview img {
    max-height: 340px;
    object-fit: contain;
    border-radius: .5rem;
}

/* ── Modal de edição de imagem (Cropper) ── */
#cropperWrap {
    width: 100%;
    height: 320px;
    background: var(--bs-body-color);
    border-radius: .5rem;
    overflow: hidden;
    position: relative;
}
#imgCropper {
    max-width: 100%;
    max-height: 100%;
    display: block;
}

/* ── Slider zoom/rotação ── */
.img-slider-wrap {
    margin-top: .75rem;
}
.img-slider-label {
    font-size: .82rem;
    color: var(--bs-secondary-color);
    margin-bottom: .25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
}
.img-slider-label i {
    font-size: .9rem;
    color: #2563a8;
}
input[type="range"].img-slider {
    width: 100%;
    accent-color: #2563a8;
    cursor: pointer;
}

/* ── Credencial OAB ── */
.perfil-oab-card {
    margin: 1.25rem 2rem 0.25rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 0.85rem;
    overflow: hidden;
    background: var(--bs-body-bg);
}
.perfil-oab-head {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.9rem 1.15rem;
    background: var(--bs-tertiary-bg);
    border-bottom: 1px solid var(--bs-border-color);
}
.perfil-oab-seal {
    width: 42px; height: 42px; flex-shrink: 0; border-radius: 11px;
    display: grid; place-items: center; color: #fff; font-size: 1.3rem;
    background: linear-gradient(135deg, #0078AA, #3b9fd4);
    box-shadow: 0 2px 8px rgba(0,120,170,.35);
}
.perfil-oab-title { font-weight: 700; line-height: 1.15; }
.perfil-oab-sub { font-size: 0.76rem; color: var(--bs-secondary-color); }
.perfil-oab-body { padding: 0.9rem 1.15rem 0.4rem; }
.perfil-oab-num { margin-bottom: 0.5rem; font-variant-numeric: tabular-nums; }
.perfil-oab-num-value { font-size: 1.5rem; font-weight: 700; letter-spacing: 0.5px; }
.perfil-oab-num-uf { font-size: 1.1rem; font-weight: 600; color: var(--bs-secondary-color); }
.perfil-oab-alert {
    display: flex; gap: 0.6rem; align-items: flex-start;
    padding: 0.65rem 0.85rem; margin-bottom: 0.5rem;
    border-radius: 0.55rem; font-size: 0.85rem;
    background: var(--bs-danger-bg-subtle);
    color: var(--bs-danger-text-emphasis);
    border: 1px solid var(--bs-danger-border-subtle);
}
.perfil-oab-alert i { margin-top: 0.1rem; }
.perfil-oab-meta { font-size: 0.8rem; color: var(--bs-secondary-color); }
.perfil-oab-actions { padding: 0.4rem 1.15rem 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
</style>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-xl-9">

        {% for msg in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# ── Card principal ── #}
        <div class="perfil-card">

            {# Capa com botão de foto #}
            <div class="perfil-capa">
                <div class="perfil-foto-wrap">
                    {# O botão abre o modal de visualização/troca de foto #}
                    <button class="perfil-foto-btn" type="button"
                            data-bs-toggle="modal" data-bs-target="#modalFotoVer"
                            title="Clique para alterar a foto">
                        {% if perfil.fotoUrl %}
                            <img id="fotoPerfilAtual"
                                 src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}"
                                 alt="Foto de perfil">
                        {% else %}
                            <div id="fotoPerfilAtual" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:linear-gradient(135deg,#1a3a5c,#2563a8);color:#fff;font-size:2.6rem;font-weight:700;">
                                {{ perfil.iniciais }}
                            </div>
                        {% endif %}
                        <span class="perfil-foto-overlay">
                            <i class="bi bi-camera-fill"></i>
                        </span>
                    </button>
                </div>
            </div>

            {# Nome e botão editar #}
            <div class="perfil-info-row">
                <div>
                    <div class="perfil-nome" id="perfilNomeExibido">
                        {{ perfil.nomeExibido }}
                    </div>
                    <div class="perfil-cargo-lotacao">
                        {% if perfil.cargo %}
                            <i class="bi bi-briefcase me-1"></i>{{ perfil.cargo }}
                        {% endif %}
                        {% if perfil.lotacao %}
                            <i class="bi bi-geo-alt ms-2 me-1"></i>{{ perfil.lotacao }}
                        {% endif %}
                    </div>
                </div>
                <button class="btn btn-outline-primary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#modalDadosPessoais">
                    <i class="bi bi-pencil me-1"></i>Editar informações
                </button>
            </div>

            {# Status editável #}
            <div class="perfil-status-wrap">
                <i class="bi bi-chat-quote text-muted" style="font-size:1.1rem"></i>
                <input type="text"
                       id="statusInput"
                       class="perfil-status-input"
                       maxlength="255"
                       placeholder="Adicione um status..."
                       value="{{ perfil.status ?? '' }}">
                <button class="btn btn-primary btn-sm perfil-status-save-btn" id="btnSalvarStatus">Salvar</button>
                <button class="btn btn-link btn-sm perfil-status-save-btn text-muted" id="btnCancelarStatus">Cancelar</button>
            </div>

            {# Dados pessoais exibidos #}
            <div class="perfil-dados-grid">
                <div class="row">
                    <div class="col-md-6">
                        <div class="perfil-dado-item">
                            <i class="bi bi-envelope"></i>
                            <span class="perfil-dado-label">E-mail</span>
                            <span>{{ perfil.email }}</span>
                        </div>
                        <div class="perfil-dado-item" id="dadoCpf" {% if not perfil.cpf %}style="display:none"{% endif %}>
                            <i class="bi bi-person-vcard"></i>
                            <span class="perfil-dado-label">CPF</span>
                            <span id="exibirCpf">{{ perfil.cpf ?? '' }}</span>
                        </div>
                        <div class="perfil-dado-item" id="dadoNascimento" {% if not perfil.dataNascimento %}style="display:none"{% endif %}>
                            <i class="bi bi-calendar3"></i>
                            <span class="perfil-dado-label">Nascimento</span>
                            <span>{{ perfil.dataNascimento ? perfil.dataNascimento|date('d/m/Y') : '' }}</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="perfil-dado-item" id="dadoCtps" {% if not perfil.ctps %}style="display:none"{% endif %}>
                            <i class="bi bi-journal-bookmark"></i>
                            <span class="perfil-dado-label">CTPS</span>
                            <span id="exibirCtps">{{ perfil.ctps ?? '' }}</span>
                        </div>
                        <div class="perfil-dado-item" id="dadoSerie" {% if not perfil.serie %}style="display:none"{% endif %}>
                            <i class="bi bi-hash"></i>
                            <span class="perfil-dado-label">Série</span>
                            <span id="exibirSerie">{{ perfil.serie ?? '' }}</span>
                        </div>
                        <div class="perfil-dado-item">
                            <i class="bi bi-calendar-check"></i>
                            <span class="perfil-dado-label">Membro desde</span>
                            <span>{{ perfil.membroDesde|date('d/m/Y') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Seção OAB — credencial profissional #}
            {% set oabStatus = perfil.oabStatus ? perfil.oabStatus.value : null %}
            <div class="perfil-oab-card mt-4">
                <div class="perfil-oab-head">
                    <div class="perfil-oab-seal"><i class="bi bi-patch-check-fill"></i></div>
                    <div class="flex-grow-1">
                        <div class="perfil-oab-title">Registro OAB</div>
                        <div class="perfil-oab-sub">Ordem dos Advogados do Brasil</div>
                    </div>
                    {% include '_oab_status.html.twig' with {status: perfil.oabStatus} only %}
                </div>
                <div class="perfil-oab-body">
                    <div class="perfil-oab-num">
                        {% if perfil.oabNumero %}
                            <span class="perfil-oab-num-value">{{ perfil.oabNumero }}</span><span class="perfil-oab-num-uf">/{{ perfil.oabUf }}</span>
                        {% else %}
                            <span class="text-secondary fst-italic">OAB não informada</span>
                        {% endif %}
                    </div>
                    {% if oabStatus == 'divergente' and perfil.oabNomeOficial %}
                        <div class="perfil-oab-alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <div><span class="text-secondary">Nome no CNA:</span> <strong>{{ perfil.oabNomeOficial }}</strong></div>
                                <div><span class="text-secondary">Informado:</span> {{ perfil.nomeExibido }}</div>
                            </div>
                        </div>
                    {% endif %}
                    {% if perfil.oabVerificadaEm %}
                        <div class="perfil-oab-meta"><i class="bi bi-clock-history me-1"></i>Verificada em {{ perfil.oabVerificadaEm|date('d/m/Y H:i') }}</div>
                    {% endif %}
                </div>
                <div class="perfil-oab-actions">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalOab">
                        <i class="bi bi-pencil me-1"></i>{{ perfil.oabNumero ? 'Editar OAB' : 'Informar OAB' }}
                    </button>
                    {% if perfil.oabNumero %}
                        <form action="{{ path('app_profile_oab_verificar') }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_oab_verificar') }}">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-repeat me-1"></i>Verificar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {# Seção Segurança — senha de acesso #}
            <div class="perfil-oab-card mt-4">
                <div class="perfil-oab-head">
                    <div class="perfil-oab-seal"><i class="bi bi-shield-lock-fill"></i></div>
                    <div class="flex-grow-1">
                        <div class="perfil-oab-title">Segurança</div>
                        <div class="perfil-oab-sub">Senha de acesso à sua conta</div>
                    </div>
                </div>
                <div class="perfil-oab-body">
                    <div class="text-secondary small">
                        Ao alterar a senha, todas as outras sessões conectadas são encerradas,
                        inclusive as que usam "manter conectado".
                    </div>
                </div>
                <div class="perfil-oab-actions">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSenha">
                        <i class="bi bi-key me-1"></i>Alterar senha
                    </button>
                </div>
            </div>

        </div>{# /perfil-card #}

    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Visualizar / Alterar foto
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalFotoVer" tabindex="-1" aria-labelledby="modalFotoVerLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFotoVerLabel">
                    <i class="bi bi-person-circle me-2"></i>Foto de perfil
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center modal-foto-preview py-4">
                {% if perfil.fotoUrl %}
                    <img id="modalFotoPreviewImg"
                         src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}"
                         alt="Foto atual" class="img-fluid mb-3"
                         style="max-height:260px;border-radius:.5rem;">
                {% else %}
                    <div id="modalFotoPreviewImg"
                         class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3"
                         style="width:160px;height:160px;background:linear-gradient(135deg,#1a3a5c,#2563a8);font-size:4rem;font-weight:700;color:#fff;">
                        {{ perfil.iniciais }}
                    </div>
                {% endif %}
            </div>
            <div class="modal-footer justify-content-center gap-2">
                <label class="btn btn-primary" style="cursor:pointer">
                    <i class="bi bi-upload me-1"></i>Alterar imagem
                    <input type="file" id="inputFotoNova" accept="image/jpeg,image/png,image/webp" hidden>
                </label>
                <button type="button" class="btn btn-outline-secondary" id="btnEditarFotoExistente"
                        {% if not perfil.fotoUrl %}style="display:none"{% endif %}>
                    <i class="bi bi-crop me-1"></i>Editar imagem
                </button>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Editar imagem (Cropper)
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalFotoEditar" tabindex="-1" aria-labelledby="modalFotoEditarLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFotoEditarLabel">
                    <i class="bi bi-crop me-2"></i>Editar imagem
                </h5>
                <button type="button" class="btn-close" id="btnFecharCropper"></button>
            </div>
            <div class="modal-body">
                <div id="cropperWrap">
                    <img id="imgCropper" src="" alt="Editar foto">
                </div>
                <div class="img-slider-wrap mt-3">
                    <div class="img-slider-label">
                        <i class="bi bi-zoom-in"></i> Zoom
                    </div>
                    <input type="range" class="img-slider" id="sliderZoom" min="0.1" max="3" step="0.01" value="1">
                </div>
                <div class="img-slider-wrap">
                    <div class="img-slider-label">
                        <i class="bi bi-arrow-repeat"></i> Rotação
                    </div>
                    <input type="range" class="img-slider" id="sliderRotacao" min="-180" max="180" step="1" value="0">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="btnCancelarCropper" type="button">Cancelar</button>
                <button class="btn btn-primary" id="btnConfirmarFoto" type="button">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinnerFoto"></span>
                    Salvar foto
                </button>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Editar dados pessoais
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalDadosPessoais" tabindex="-1" aria-labelledby="modalDadosPessoaisLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDadosPessoaisLabel">
                    <i class="bi bi-person-lines-fill me-2"></i>Informações pessoais
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="{{ path('app_profile_dados') }}" method="post" id="formDadosPessoais">
                <div class="modal-body">
                    {{ form_row(form_dados.nomeCompleto, {'attr': {'class': 'form-control'}}) }}
                    {{ form_row(form_dados.cpf, {'attr': {'class': 'form-control', 'id': 'campoCpf'}}) }}
                    {{ form_row(form_dados.dataNascimento, {'attr': {'class': 'form-control'}}) }}
                    <div class="row">
                        <div class="col-8">
                            {{ form_row(form_dados.ctps, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-4">
                            {{ form_row(form_dados.serie, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    {{ form_rest(form_dados) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Informar / editar OAB
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalOab" tabindex="-1" aria-labelledby="modalOabLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalOabLabel">
                    <i class="bi bi-patch-check me-2"></i>OAB
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="{{ path('app_profile_oab') }}" method="post" id="formOab">
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Informe seu número de inscrição e a UF. Deixe ambos em branco para remover a OAB.
                    </p>
                    <div class="row">
                        <div class="col-8">
                            {{ form_row(form_oab.oabNumero, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-4">
                            {{ form_row(form_oab.oabUf, {'attr': {'class': 'form-control text-uppercase'}}) }}
                        </div>
                    </div>
                    {{ form_rest(form_oab) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Alterar senha
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalSenha" tabindex="-1" aria-labelledby="modalSenhaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSenhaLabel">
                    <i class="bi bi-key me-2"></i>Alterar senha
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            {{ form_start(form_senha, {'attr': {'id': 'formSenha'}}) }}
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Confirme sua senha atual e escolha uma nova, com pelo menos 8 caracteres.
                    </p>
                    {{ form_row(form_senha.senhaAtual, {'attr': {'class': 'form-control', 'autocomplete': 'current-password'}}) }}
                    {{ form_row(form_senha.senha.first, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                    {{ form_row(form_senha.senha.second, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                    {{ form_rest(form_senha) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Salvar nova senha
                    </button>
                </div>
            {{ form_end(form_senha) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js" crossorigin="anonymous"></script>

<script>
(function () {
    'use strict';

    const TOKEN_STATUS = '{{ csrf_token('profile_status') }}';
    const TOKEN_FOTO   = '{{ csrf_token('profile_foto') }}';

    // ── Status editável ──
    const inputStatus  = document.getElementById('statusInput');
    const btnSalvar    = document.getElementById('btnSalvarStatus');
    const btnCancelar  = document.getElementById('btnCancelarStatus');
    let statusOriginal = inputStatus.value;

    function mostrarBotoesStatus(show) {
        btnSalvar.style.display   = show ? 'inline-block' : 'none';
        btnCancelar.style.display = show ? 'inline-block' : 'none';
    }

    inputStatus.addEventListener('focus', () => mostrarBotoesStatus(true));
    inputStatus.addEventListener('input', () => mostrarBotoesStatus(true));

    btnCancelar.addEventListener('click', () => {
        inputStatus.value = statusOriginal;
        mostrarBotoesStatus(false);
        inputStatus.blur();
    });

    btnSalvar.addEventListener('click', async () => {
        const body = new FormData();
        body.append('_token', TOKEN_STATUS);
        body.append('status', inputStatus.value);

        try {
            const res  = await fetch('{{ path('app_profile_status') }}', { method: 'POST', body });
            const data = await res.json();
            if (data.ok) {
                statusOriginal = data.status ?? '';
                inputStatus.value = statusOriginal;
                mostrarBotoesStatus(false);
                inputStatus.blur();
            } else {
                alert(data.erro ?? 'Erro ao salvar status.');
            }
        } catch {
            alert('Erro de comunicação.');
        }
    });

    // ── Foto: Cropper ──
    let cropper = null;

    const inputFoto          = document.getElementById('inputFotoNova');
    const imgCropper         = document.getElementById('imgCropper');
    const sliderZoom         = document.getElementById('sliderZoom');
    const sliderRotacao      = document.getElementById('sliderRotacao');
    const btnConfirmar       = document.getElementById('btnConfirmarFoto');
    const spinnerFoto        = document.getElementById('spinnerFoto');
    const btnFechar          = document.getElementById('btnFecharCropper');
    const btnCancelarCrop    = document.getElementById('btnCancelarCropper');
    const btnEditarExistente = document.getElementById('btnEditarFotoExistente');

    const modalVerEl    = document.getElementById('modalFotoVer');
    const modalEditarEl = document.getElementById('modalFotoEditar');
    const modalVer    = bootstrap.Modal.getInstance(modalVerEl) ?? new bootstrap.Modal(modalVerEl);
    const modalEditar = new bootstrap.Modal(modalEditarEl);

    function iniciarCropper() {
        if (cropper) { cropper.destroy(); cropper = null; }
        cropper = new Cropper(imgCropper, {
            aspectRatio: 1,
            viewMode: 1,
            dragMode: 'move',
            autoCropArea: 0.9,
            movable: true,
            zoomable: true,
            rotatable: true,
            scalable: false,
            guides: false,
            center: true,
            highlight: true,
            cropBoxMovable: false,
            cropBoxResizable: false,
            ready() { sliderZoom.value = 1; sliderRotacao.value = 0; },
        });
    }

    function abrirCropper(src) {
        imgCropper.src      = src;
        sliderZoom.value    = 1;
        sliderRotacao.value = 0;

        modalEditarEl.addEventListener('shown.bs.modal', iniciarCropper, { once: true });

        if (modalVerEl.classList.contains('show')) {
            modalVerEl.addEventListener('hidden.bs.modal', () => modalEditar.show(), { once: true });
            modalVer.hide();
        } else {
            modalEditar.show();
        }
    }

    inputFoto.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => abrirCropper(e.target.result);
        reader.readAsDataURL(file);
        this.value = '';
    });

    if (btnEditarExistente) {
        btnEditarExistente.addEventListener('click', () => {
            const imgModal = document.getElementById('modalFotoPreviewImg');
            if (imgModal && imgModal.tagName === 'IMG') {
                abrirCropper(imgModal.src);
            }
        });
    }

    sliderZoom.addEventListener('input', function () {
        if (cropper) cropper.zoomTo(parseFloat(this.value));
    });

    sliderRotacao.addEventListener('input', function () {
        if (cropper) cropper.rotateTo(parseInt(this.value, 10));
    });

    function fecharCropper() {
        modalEditar.hide();
        if (cropper) { cropper.destroy(); cropper = null; }
    }

    btnFechar.addEventListener('click', fecharCropper);
    btnCancelarCrop.addEventListener('click', fecharCropper);

    btnConfirmar.addEventListener('click', async () => {
        if (!cropper) return;

        btnConfirmar.disabled = true;
        spinnerFoto.classList.remove('d-none');

        let canvas;
        try {
            canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
        } catch (_) {
            canvas = null;
        }

        if (!canvas) {
            alert('A imagem ainda está carregando. Aguarde um instante e tente novamente.');
            btnConfirmar.disabled = false;
            spinnerFoto.classList.add('d-none');
            return;
        }

        canvas.toBlob(async (blob) => {
            if (!blob) {
                alert('Não foi possível processar a imagem. Tente novamente.');
                btnConfirmar.disabled = false;
                spinnerFoto.classList.add('d-none');
                return;
            }

            const form = new FormData();
            form.append('_token', TOKEN_FOTO);
            form.append('foto', blob, 'perfil.jpg');

            try {
                const res  = await fetch('{{ path('app_profile_foto') }}', { method: 'POST', body: form });
                const data = await res.json();

                if (data.ok) {
                    const novaUrl = data.url + '?t=' + Date.now();

                    const wrap    = document.querySelector('.perfil-foto-btn');
                    const overlay = wrap.querySelector('.perfil-foto-overlay');
                    wrap.innerHTML = '';

                    const imgEl = document.createElement('img');
                    imgEl.id  = 'fotoPerfilAtual';
                    imgEl.alt = 'Foto de perfil';
                    imgEl.src = novaUrl;
                    wrap.appendChild(imgEl);

                    const ov = document.createElement('span');
                    ov.className = 'perfil-foto-overlay';
                    ov.innerHTML = '<i class="bi bi-camera-fill"></i>';
                    wrap.appendChild(ov);

                    const previewEl = document.getElementById('modalFotoPreviewImg');
                    if (previewEl) {
                        if (previewEl.tagName === 'IMG') {
                            previewEl.src = novaUrl;
                        } else {
                            const novoPreview = document.createElement('img');
                            novoPreview.id        = 'modalFotoPreviewImg';
                            novoPreview.alt       = 'Foto atual';
                            novoPreview.className = 'img-fluid mb-3';
                            novoPreview.style.cssText = 'max-height:260px;border-radius:.5rem;';
                            novoPreview.src = novaUrl;
                            previewEl.replaceWith(novoPreview);
                        }
                    }

                    if (btnEditarExistente) btnEditarExistente.style.display = '';

                    const makeAvatarImg = () => {
                        const img = document.createElement('img');
                        img.src = novaUrl;
                        img.alt = '';
                        img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;';
                        return img;
                    };
                    const navAvatar = document.getElementById('navtopAvatar');
                    if (navAvatar) { navAvatar.textContent = ''; navAvatar.appendChild(makeAvatarImg()); }
                    const dropAvatar = document.getElementById('usuarioAvatarLg');
                    if (dropAvatar) { dropAvatar.textContent = ''; dropAvatar.appendChild(makeAvatarImg()); }

                    fecharCropper();
                } else {
                    alert(data.erro ?? 'Erro ao salvar foto.');
                }
            } catch {
                alert('Erro de comunicação.');
            } finally {
                btnConfirmar.disabled = false;
                spinnerFoto.classList.add('d-none');
            }
        }, 'image/jpeg', 0.90);
    });

    // ── Máscara CPF ──
    const campoCpf = document.getElementById('campoCpf');
    if (campoCpf) {
        campoCpf.addEventListener('input', function () {
            let v = this.value.replace(/\D/g, '').slice(0, 11);
            if (v.length > 9)      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
            else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{3})/, '$1.$2.$3');
            else if (v.length > 3) v = v.replace(/(\d{3})(\d{3})/, '$1.$2');
            this.value = v;
        });
    }

    // ── Reabrir modal de dados se houve erro de validação ──
    {% for msg in app.flashes('error') %}
    (function () {
        const m = bootstrap.Modal.getOrCreate(document.getElementById('modalDadosPessoais'));
        m.show();
    })();
    {% endfor %}
})();
</script>
{% endblock %}
