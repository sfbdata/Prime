{% extends 'base.html.twig' %}

{% block title %}{{ 'perfil.titulo'|trans }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/meu-perfil.css') }}">
<style>
/* ── Capa ── */
.perfil-capa {
    height: 200px;
    background: linear-gradient(135deg, #1a3a5c 0%, #2563a8 60%, #3b82d4 100%);
    border-radius: 0.5rem 0.5rem 0 0;
    position: relative;
}

/* ── Card principal ── */
.perfil-card {
    border-radius: 0.5rem;
    box-shadow: 0 2px 16px rgba(0,0,0,.10);
    overflow: visible;
    background: var(--bs-body-bg);
    margin-bottom: 1.5rem;
}

/* ── Área da foto ── */
.perfil-foto-wrap {
    position: absolute;
    bottom: -56px;
    left: 2rem;
}
.perfil-foto-btn {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 4px solid var(--bs-border-color);
    overflow: hidden;
    cursor: pointer;
    background: var(--bs-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--bs-body-color);
    transition: filter .2s;
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
    padding: 0;
}
.perfil-foto-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.perfil-foto-btn:hover .perfil-foto-overlay {
    opacity: 1;
}
.perfil-foto-overlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0,0,0,.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .2s;
    pointer-events: none;
}
.perfil-foto-overlay i {
    color: #fff;
    font-size: 1.6rem;
}

/* ── Info linha abaixo da foto ── */
.perfil-info-row {
    padding: 70px 2rem 1.25rem 2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
}
.perfil-nome {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--bs-body-color);
    line-height: 1.2;
}
.perfil-cargo-lotacao {
    font-size: .88rem;
    color: var(--bs-secondary-color);
    margin-top: .2rem;
}

/* ── Campo de status ── */
.perfil-status-wrap {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: 0 2rem 1.25rem 2rem;
    border-bottom: 1px solid var(--bs-border-color);
}
.perfil-status-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: .95rem;
    color: var(--bs-body-color);
    padding: .3rem .1rem;
    border-bottom: 2px solid transparent;
    transition: border-color .2s;
    max-width: 420px;
}
.perfil-status-input:focus {
    border-bottom-color: #2563a8;
}
.perfil-status-input::placeholder {
    color: var(--bs-secondary-color);
    font-style: italic;
}
.perfil-status-save-btn {
    display: none;
    padding: .25rem .75rem;
    font-size: .82rem;
}

/* ── Grid de dados ── */
.perfil-dados-grid {
    padding: 1.25rem 2rem 1.5rem;
}
.perfil-dado-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .5rem;
    font-size: .9rem;
    color: var(--bs-body-color);
}
.perfil-dado-item i {
    font-size: 1rem;
    color: #2563a8;
    width: 20px;
    text-align: center;
}
.perfil-dado-label {
    font-weight: 600;
    color: var(--bs-body-color);
    min-width: 110px;
}

/* ── Modal de visualização de foto ── */
.modal-foto-preview img {
    max-height: 340px;
    object-fit: contain;
    border-radius: .5rem;
}

/* ── Modal de edição de imagem (Cropper) ── */
#cropperWrap {
    width: 100%;
    height: 320px;
    background: var(--bs-body-color);
    border-radius: .5rem;
    overflow: hidden;
    position: relative;
}
#imgCropper {
    max-width: 100%;
    max-height: 100%;
    display: block;
}

/* ── Slider zoom/rotação ── */
.img-slider-wrap {
    margin-top: .75rem;
}
.img-slider-label {
    font-size: .82rem;
    color: var(--bs-secondary-color);
    margin-bottom: .25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
}
.img-slider-label i {
    font-size: .9rem;
    color: #2563a8;
}
input[type="range"].img-slider {
    width: 100%;
    accent-color: #2563a8;
    cursor: pointer;
}

/* ── Credencial OAB ── */
.perfil-oab-card {
    margin: 1.25rem 2rem 0.25rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 0.85rem;
    overflow: hidden;
    background: var(--bs-body-bg);
}
.perfil-oab-head {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.9rem 1.15rem;
    background: var(--bs-tertiary-bg);
    border-bottom: 1px solid var(--bs-border-color);
}
.perfil-oab-seal {
    width: 42px; height: 42px; flex-shrink: 0; border-radius: 11px;
    display: grid; place-items: center; color: #fff; font-size: 1.3rem;
    background: linear-gradient(135deg, #0078AA, #3b9fd4);
    box-shadow: 0 2px 8px rgba(0,120,170,.35);
}
.perfil-oab-title { font-weight: 700; line-height: 1.15; }
.perfil-oab-sub { font-size: 0.76rem; color: var(--bs-secondary-color); }
.perfil-oab-body { padding: 0.9rem 1.15rem 0.4rem; }
.perfil-oab-num { margin-bottom: 0.5rem; font-variant-numeric: tabular-nums; }
.perfil-oab-num-value { font-size: 1.5rem; font-weight: 700; letter-spacing: 0.5px; }
.perfil-oab-num-uf { font-size: 1.1rem; font-weight: 600; color: var(--bs-secondary-color); }
.perfil-oab-alert {
    display: flex; gap: 0.6rem; align-items: flex-start;
    padding: 0.65rem 0.85rem; margin-bottom: 0.5rem;
    border-radius: 0.55rem; font-size: 0.85rem;
    background: var(--bs-danger-bg-subtle);
    color: var(--bs-danger-text-emphasis);
    border: 1px solid var(--bs-danger-border-subtle);
}
.perfil-oab-alert i { margin-top: 0.1rem; }
.perfil-oab-meta { font-size: 0.8rem; color: var(--bs-secondary-color); }
.perfil-oab-actions { padding: 0.4rem 1.15rem 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
</style>
{% endblock %}

{% block faixa_topo %}
{# Abas do perfil (desenho "07 - Meu Perfil - VS 18.10.26", linhas 44 a 50 e 255): Convites só para o
   primário (ou o Master), como no menu do usuário; Master só para ROLE_SUPER_ADMIN. #}
{% set _ehMasterAba = is_granted('ROLE_SUPER_ADMIN') %}
<nav class="mu-abas-perfil" aria-label="{{ 'perfil.abas.rotulo'|trans }}">
    <div class="mu-abas-perfil-miolo">
        <a href="{{ path('app_profile') }}" class="mu-aba-perfil on" aria-current="page"><i class="bi bi-person"></i>{{ 'perfil.abas.meu_perfil'|trans }}</a>
        {% if current_tenant() and (eh_usuario_primario() or _ehMasterAba) %}
            <a href="{{ path('auth_gerenciar_convites') }}" class="mu-aba-perfil" data-mu-conta="conta"><i class="bi bi-envelope-paper"></i>{{ 'perfil.abas.convites'|trans }}</a>
        {% endif %}
        {% if current_tenant() %}
            <button type="button" class="mu-aba-perfil" data-mu-conta="trocar"><i class="bi bi-arrow-left-right"></i>{{ 'perfil.abas.trocar_conta'|trans }}</button>
        {% endif %}
        {% if _ehMasterAba %}
            <div class="dropdown d-flex">
                <button type="button" class="mu-aba-perfil mu-aba-perfil-master" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                    <i class="bi bi-star-fill"></i>{{ 'termos.master'|trans }}<i class="bi bi-chevron-down"></i>
                </button>
                <div class="dropdown-menu mu-master-menu" role="menu" data-sem-x="1">
                    <div class="mu-grupo-rotulo"><i class="bi bi-star-fill"></i>{{ 'perfil.abas.exclusivo_master'|trans }}</div>
                    <button type="button" class="mu-menu-x mu-menu-x-escuro" data-mu-fechar-menu aria-label="{{ 'perfil.abas.fechar_menu'|trans }}"><i class="bi bi-x-lg"></i></button>
                    {% include 'menu_usuario/_itens_master.html.twig' with {classe_item: 'dropdown-item mu-item', papel: 'menuitem'} only %}
                </div>
            </div>
        {% endif %}
    </div>
</nav>
{% endblock %}

{% block body %}
{#
    Meu Perfil (desenho "07 - Meu Perfil - VS 18.10.26", linhas 52 a 118; spec docs/specs/meu-perfil-pagina.md).
    O card da OAB continua o atual até o PR das várias inscrições.
#}
{% set _ehMaster = is_granted('ROLE_SUPER_ADMIN') %}
{% set _ehPrimario = eh_usuario_primario() %}
{% set v = perfil.vinculo %}
{% set _naoInformado = 'perfil.nao_informado'|trans %}
{% set _cpfFormatado = perfil.cpf and perfil.cpf|replace({'.': '', '-': '', ' ': ''})|length == 11
    ? perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(0, 3) ~ '.' ~ perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(3, 3) ~ '.' ~ perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(6, 3) ~ '-' ~ perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(9, 2)
    : perfil.cpf %}
{% set _campos = [
    {icone: 'bi-envelope', rotulo: 'perfil.grade.email'|trans, valor: perfil.email, copiar: true},
    {icone: v.icone, rotulo: 'perfil.grade.vinculo'|trans, valor: perfil.registraPonto ? 'perfil.grade.vinculo_bate_ponto'|trans({vinculo: v.rotulo}) : 'perfil.grade.vinculo_sem_ponto'|trans({vinculo: v.rotulo}), copiar: false},
    {icone: 'bi-person-vcard', rotulo: 'perfil.grade.cpf'|trans, valor: _cpfFormatado, copiar: true},
] %}
{% if v.value == 'clt' %}
    {% set _campos = _campos|merge([
        {icone: 'bi-journal-text', rotulo: 'perfil.grade.ctps'|trans, valor: perfil.ctps, copiar: false},
        {icone: 'bi-hash', rotulo: 'perfil.grade.serie'|trans, valor: perfil.serie, copiar: false},
        {icone: 'bi-calendar-plus', rotulo: 'perfil.grade.admissao'|trans, valor: perfil.dataAdmissao ? perfil.dataAdmissao|data : null, copiar: false},
    ]) %}
{% else %}
    {% if v.value == 'pj' %}
        {% set _campos = _campos|merge([{icone: 'bi-building', rotulo: 'perfil.grade.cnpj'|trans, valor: perfil.cnpj, copiar: true}]) %}
    {% endif %}
    {% set _campos = _campos|merge([
        {icone: v.value == 'estagio' ? 'bi-calendar-plus' : 'bi-file-earmark-text', rotulo: v.rotuloInicio, valor: perfil.contratoInicio ? perfil.contratoInicio|data : null, copiar: false},
    ]) %}
{% endif %}
{% set _campos = _campos|merge([
    {icone: 'bi-calendar3', rotulo: 'perfil.grade.nascimento'|trans, valor: perfil.dataNascimento ? perfil.dataNascimento|data : null, copiar: false},
    {icone: 'bi-calendar-check', rotulo: 'perfil.grade.membro_desde'|trans, valor: perfil.membroDesde|data, copiar: false},
    {icone: 'bi-whatsapp', rotulo: 'perfil.grade.telefone'|trans, valor: perfil.telefone, copiar: true},
]) %}

<div class="mp-pagina" id="meuPerfil"
     data-url-preferencia="{{ path('app_profile_preferencia') }}"
     data-url-revisao="{{ path('app_profile_revisao') }}"
     data-revisado-em="{{ perfil.revisadoEm ? perfil.revisadoEm|date('Y-m-d') : '' }}"
     data-usuario="{{ app.user.id }}">

    {# ── Identificação ── #}
    <section class="mp-card mp-ident" data-screen-label="Identificação">
        <div class="mp-capa">
            <span class="mp-capa-bola"></span>
            <img src="{{ asset('images/logo/bluejus-white-transparent-nav.png') }}" alt="BlueJus" class="mp-capa-logo">
        </div>
        <div class="mp-ident-linha">
            <button class="mp-avatar" type="button" data-bs-toggle="modal" data-bs-target="#modalFotoVer" title="{{ 'perfil.identificacao.trocar_foto'|trans }}" aria-label="{{ 'perfil.identificacao.trocar_foto'|trans }}">
                {% if perfil.fotoUrl %}
                    <img id="fotoPerfilAtual" src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}" alt="{{ 'perfil.identificacao.foto_alt'|trans }}">
                {% else %}
                    <span id="fotoPerfilAtual" class="mp-avatar-ini">{{ perfil.iniciais }}</span>
                {% endif %}
                <span class="mp-avatar-camera"><i class="bi bi-camera"></i></span>
            </button>
            <div class="mp-ident-texto">
                <div class="mp-nome-linha">
                    <h1 class="mp-nome" id="perfilNomeExibido">{{ perfil.nomeExibido|upper }}</h1>
                    {% if _ehMaster %}<span class="mp-selo mp-selo-master"><i class="bi bi-star-fill"></i>{{ 'termos.master'|trans|upper }}</span>{% endif %}
                    {% if current_tenant() %}<span class="mp-selo mp-selo-papel" title="{{ current_tenant().name }}">{{ _ehPrimario or _ehMaster ? 'perfil.identificacao.usuario_primario'|trans : 'termos.secundario'|trans|upper }}</span>{% endif %}
                </div>
                <div class="mp-cargo">
                    <span><i class="bi bi-briefcase"></i>{{ perfil.cargo ?: 'perfil.identificacao.cargo_nao_definido'|trans }}</span>
                    <span><i class="bi bi-geo-alt"></i>{{ perfil.lotacao ?: 'perfil.identificacao.lotacao_nao_definida'|trans }}</span>
                </div>
            </div>
            <button class="mp-btn-contorno" type="button" data-mp-editar><i class="bi bi-pencil"></i>{{ 'perfil.identificacao.editar'|trans }}</button>
        </div>
        <div class="mp-frase{{ perfil.status ? '' : ' vazia' }}"><i class="bi bi-chat-quote"></i><span>{{ perfil.status ?: 'perfil.identificacao.frase_vazia'|trans }}</span></div>

        {% if not completude.completo %}
            <div class="mp-incompleto" data-mp-incompleto>
                <span class="mp-incompleto-icone"><i class="bi bi-exclamation-triangle-fill"></i></span>
                <div class="mp-incompleto-texto">
                    <div><b>{{ 'perfil.incompleto.titulo'|trans }}</b><span class="mp-incompleto-pct">{{ 'perfil.incompleto.percentual'|trans({pct: completude.percentual}) }}</span></div>
                    <div class="mp-barra"><div style="width: {{ completude.percentual }}%"></div></div>
                    <div class="mp-falta"><span>{{ 'perfil.incompleto.falta'|trans }}</span>{% for item in completude.faltando %}<span class="mp-chip"><i class="bi bi-plus-circle"></i>{{ item }}</span>{% endfor %}</div>
                </div>
                <button class="mp-btn-laranja" type="button" data-mp-editar><i class="bi bi-pencil"></i>{{ 'perfil.incompleto.completar'|trans }}</button>
            </div>
        {% endif %}

        <div class="mp-grade">
            {% for c in _campos %}
                <div class="mp-linha">
                    <i class="bi {{ c.icone }}"></i>
                    <b>{{ c.rotulo }}</b>
                    <span class="{{ c.valor ? '' : 'vazio' }}">{{ c.valor ?: _naoInformado }}{% if c.copiar and c.valor %}<button type="button" class="mp-copiar" data-mp-copiar="{{ c.valor }}" title="{{ 'perfil.grade.copiar'|trans }}" aria-label="{{ 'perfil.grade.copiar_campo'|trans({campo: c.rotulo}) }}"><i class="bi bi-copy"></i></button>{% endif %}</span>
                </div>
            {% endfor %}
        </div>
    </section>

    {# ── Registro OAB (desenho 07, linhas 79 a 92; spec docs/specs/meu-perfil-oab-inscricoes.md) ── #}
    {% set _nSup = inscricoesOab|filter(i => not i.principal)|length %}
    <section class="mp-card mp-card-oab" data-screen-label="Registro OAB">
        <div class="mp-card-topo">
            <span class="mp-card-selo"><i class="bi bi-patch-check-fill"></i></span>
            <div class="flex-grow-1"><b>{{ 'perfil.oab.titulo'|trans }}</b><div class="mp-card-sub">{{ inscricoesOab|length > 1 ? 'perfil.oab.sub_varias'|trans({total: inscricoesOab|length, suplementares: _nSup}) : 'perfil.oab.sub_ordem'|trans }}</div></div>
            <button type="button" class="mp-btn-oab" data-mp-oab-nova title="{{ 'perfil.oab.adicionar_titulo'|trans }}"><i class="bi bi-plus-lg"></i>{{ 'perfil.oab.adicionar'|trans }}</button>
        </div>
        {% for o in inscricoesOab %}
            <button type="button" class="mp-oab-linha" data-mp-oab-editar="{{ o.id }}" data-numero="{{ o.numero }}" data-uf="{{ o.uf }}"
                    data-tipo="{{ o.principal ? 'principal' : 'suplementar' }}" data-pode-remover="{{ not o.principal and inscricoesOab|length > 1 ? '1' : '0' }}">
                <span class="mp-oab-num">
                    <span><b class="{{ o.principal ? 'grande' : '' }}">{{ o.numero }}</b><span class="mp-oab-uf">/{{ o.uf }}</span></span>
                    <small><i class="bi bi-clock"></i>{{ o.verificadaEm ? 'perfil.oab.verificada_em'|trans({data: o.verificadaEm|data_hora}) : 'perfil.oab.aguardando_validacao'|trans }}</small>
                </span>
                <span class="mp-oab-tipo {{ o.principal ? 'principal' : '' }}"><i class="bi {{ o.principal ? 'bi-star-fill' : 'bi-diagram-2' }}"></i>{{ o.principal ? 'perfil.oab.selo_principal'|trans : 'perfil.oab.selo_suplementar'|trans }}</span>
                <span class="flex-grow-1"></span>
                <span class="mp-oab-situacao {{ o.situacaoClasse }}"><i class="bi {{ o.situacaoIcone }}"></i>{{ o.situacao }}</span>
                <i class="bi bi-pencil mp-oab-lapis"></i>
            </button>
        {% else %}
            <div class="mp-oab-vazio">{{ 'perfil.oab.vazio'|trans }}</div>
        {% endfor %}
    </section>

    {# ── Preferências ── #}
    <section class="mp-card" data-screen-label="Preferências">
        <div class="mp-card-topo">
            <span class="mp-card-selo"><i class="bi bi-sliders"></i></span>
            <div><b>{{ 'perfil.preferencias.titulo'|trans }}</b><div class="mp-card-sub">{{ 'perfil.preferencias.sub'|trans }}</div></div>
        </div>
        <div class="mp-prefs">
            <button type="button" class="mp-pref" data-mu-idioma>
                <i class="bi bi-translate"></i>
                <span class="mp-pref-texto"><span>{{ 'perfil.preferencias.idioma_rotulo'|trans }}</span><small>{{ 'perfil.preferencias.idioma_sub'|trans }}</small></span>
                <span class="mp-pref-valor">{{ idioma_atual().nome }}</span><i class="bi bi-chevron-right mp-pref-seta"></i>
            </button>
            {% for p in [
                {chave: 'perfil.notificacoes', icone: 'bi-bell', rotulo: 'perfil.preferencias.notificacoes_rotulo'|trans, sub: 'perfil.preferencias.notificacoes_sub'|trans},
                {chave: 'perfil.sons', icone: 'bi-volume-up', rotulo: 'perfil.preferencias.sons_rotulo'|trans, sub: 'perfil.preferencias.sons_sub'|trans},
                {chave: 'perfil.resumo_email', icone: 'bi-envelope', rotulo: 'perfil.preferencias.resumo_email_rotulo'|trans, sub: 'perfil.preferencias.resumo_email_sub'|trans},
                {chave: 'perfil.sugestoes_despachos', icone: 'bi-lightbulb', rotulo: 'perfil.preferencias.sugestoes_despachos_rotulo'|trans, sub: 'perfil.preferencias.sugestoes_despachos_sub'|trans},
            ] %}
                <button type="button" class="mp-pref" role="switch" aria-checked="{{ preferencias[p.chave] ? 'true' : 'false' }}" data-mp-pref="{{ p.chave }}">
                    <i class="bi {{ p.icone }}"></i>
                    <span class="mp-pref-texto"><span>{{ p.rotulo }}</span><small>{{ p.sub }}</small></span>
                    <span class="mp-chave" aria-hidden="true"><span></span></span>
                </button>
            {% endfor %}
            {# D4 de Minhas Metas (Fase 4): o desenho 07 não tem; a linha segue a do "Idioma do sistema" (linha inteira
               clicável, com a seta). Confirmação do navegador (data-confirmar, menu-usuario.js) e CSRF. #}
            <form method="post" action="{{ path('app_profile_aprendizado_apagar') }}" class="mp-pref-form" data-confirmar="{{ 'perfil.preferencias.apagar_aprendizado_confirmar'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('apagar_aprendizado') }}">
                <button type="submit" class="mp-pref" data-mp-apagar-aprendizado>
                    <i class="bi bi-eraser"></i>
                    <span class="mp-pref-texto"><span>{{ 'perfil.preferencias.apagar_aprendizado_rotulo'|trans }}</span><small>{{ 'perfil.preferencias.apagar_aprendizado_sub'|trans }}</small></span>
                    <i class="bi bi-chevron-right mp-pref-seta"></i>
                </button>
            </form>
        </div>
    </section>

    {# Ponto de inclusão da frente do Contribua: bloco "Assinatura" (plano, vencimento e cancelar), porque o checkout
       do desenho 08 manda cancelar em Meu Perfil. Basta a outra frente criar o parcial. #}
    {% include 'contribua/_assinatura_no_perfil.html.twig' ignore missing %}
    {# Selo de apoiador (pilha do Contribua, f6): o parcial chama sozinho selo_apoiador(); ausente, nada aparece. #}
    {% include 'contribua/_selo_apoiador.html.twig' ignore missing %}

    {# ── Segurança ── #}
    <section class="mp-card" data-screen-label="Segurança">
        <div class="mp-card-topo">
            <span class="mp-card-selo"><i class="bi bi-shield-lock"></i></span>
            <div><b>{{ 'perfil.seguranca.titulo'|trans }}</b><div class="mp-card-sub">{{ 'perfil.seguranca.sub'|trans }}</div></div>
        </div>
        <div class="mp-seguranca">
            <div>{{ 'perfil.seguranca.aviso'|trans }}</div>
            <button class="mp-btn-azul" type="button" data-bs-toggle="modal" data-bs-target="#modalSenha"><i class="bi bi-key"></i>{{ 'perfil.seguranca.alterar_senha'|trans }}</button>
        </div>
    </section>

    {# ── Excluir conta do escritório (PR 5, docs/specs/conta-pedido-exclusao.md; desenho 07 L111-117) ──
       Só para o primário da conta (`exclusao_da_conta()` é nulo para os demais e na conta do Master). #}
    {% set _exclusao = exclusao_da_conta() %}
    {% if _exclusao %}
    <section class="mp-card mp-ex" data-screen-label="Excluir conta" id="mpExclusao"
             data-url-codigo="{{ path('conta_exclusao_codigo') }}"
             data-url-pedir="{{ path('conta_exclusao_pedir') }}"
             data-url-desistir="{{ path('conta_exclusao_desistir') }}"
             data-token="{{ csrf_token('exclusao_conta') }}">
        <div class="mp-ex-linha">
            <span class="mp-ex-selo" aria-hidden="true"><i class="bi bi-trash3"></i></span>
            <div class="mp-ex-texto">
                <b>{{ 'perfil.exclusao.titulo'|trans }}</b>
                <div class="mp-ex-sub">
                    {%- if _exclusao.pendente -%}
                        {{ 'perfil.exclusao.pendente_sub'|trans({data: _exclusao.criadoEm|data, motivo: _exclusao.motivo ?? ''}) }}
                    {%- else -%}
                        {{ 'perfil.exclusao.sub'|trans }}
                    {%- endif -%}
                </div>
            </div>
            {% if _exclusao.pendente %}
                <span class="mp-ex-pendente"><i class="bi bi-hourglass-split"></i>{{ 'perfil.exclusao.suspensa'|trans }}</span>
                <button type="button" class="mp-ex-desistir" data-mp-ex-desistir>{{ 'perfil.exclusao.desistir'|trans }}</button>
            {% else %}
                <button type="button" class="mp-ex-abrir" data-bs-toggle="modal" data-bs-target="#modalExclusaoConta"><i class="bi bi-trash3"></i>{{ 'perfil.exclusao.excluir'|trans }}</button>
            {% endif %}
        </div>
    </section>
    {% endif %}
</div>

{% if _exclusao and not _exclusao.pendente %}
{# ══ MODAL: Excluir conta em 2 etapas (desenho 07 L142-161) ══ #}
<div class="modal fade mp-ex-modal" id="modalExclusaoConta" tabindex="-1" aria-labelledby="modalExclusaoContaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="mp-ex-cab">
                <i class="bi bi-trash3" aria-hidden="true"></i>
                <b id="modalExclusaoContaTitulo">{{ 'perfil.exclusao.modal.etapa_antes'|trans }} <span data-mp-ex-etapa>1</span> {{ 'perfil.exclusao.modal.etapa_depois'|trans }}</b>
                <button type="button" class="mp-ex-fechar" data-bs-dismiss="modal" aria-label="{{ 'perfil.acoes.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="mp-ex-corpo">
                <div data-mp-ex-e1>
                    <p class="mp-ex-p">{{ 'perfil.exclusao.modal.motivo_pedido'|trans }}</p>
                    <div class="mp-ex-motivos" role="group" aria-label="{{ 'perfil.exclusao.modal.motivo_rotulo'|trans }}">
                        {#- O valor (data-mp-ex-motivo) vai ao servidor e fica em português; só o rótulo segue o idioma. #}
                        {% for motivo in [
                            {valor: 'Não uso mais', rotulo: 'perfil.exclusao.motivo.nao_uso'|trans},
                            {valor: 'Achei caro', rotulo: 'perfil.exclusao.motivo.caro'|trans},
                            {valor: 'Faltou um recurso', rotulo: 'perfil.exclusao.motivo.faltou_recurso'|trans},
                            {valor: 'Mudei de sistema', rotulo: 'perfil.exclusao.motivo.mudei_sistema'|trans},
                            {valor: 'Encerrando o escritório', rotulo: 'perfil.exclusao.motivo.encerrando'|trans},
                            {valor: 'Outro motivo', rotulo: 'perfil.exclusao.motivo.outro'|trans},
                        ] %}
                            <button type="button" class="mp-ex-motivo" aria-pressed="false" data-mp-ex-motivo="{{ motivo.valor }}">{{ motivo.rotulo }}</button>
                        {% endfor %}
                    </div>
                    <input type="text" class="mp-ex-campo" data-mp-ex-obs placeholder="{{ 'perfil.exclusao.modal.observacao'|trans }}" maxlength="300" aria-label="{{ 'perfil.exclusao.modal.observacao'|trans }}">
                    <div class="mp-ex-info"><i class="bi bi-info-circle"></i> {{ 'perfil.exclusao.modal.info_antes'|trans }} <b>{{ 'perfil.exclusao.modal.info_suspensa'|trans }}</b> {{ 'perfil.exclusao.modal.info_depois'|trans }}</div>
                </div>
                <div data-mp-ex-e2 hidden>
                    <p class="mp-ex-p">{{ 'perfil.exclusao.modal.codigo_enviado'|trans }} <b data-mp-ex-email>{{ _exclusao.email }}</b>{{ 'perfil.exclusao.modal.codigo_digite'|trans }} <b>{{ 'perfil.exclusao.modal.codigo_palavra'|trans }}</b> {{ 'perfil.exclusao.modal.codigo_confirmar'|trans }}</p>
                    <div class="mp-ex-grade">
                        <label class="mp-ex-rotulo">{{ 'perfil.exclusao.modal.codigo_rotulo'|trans }}<input type="text" class="mp-ex-campo mp-ex-codigo" data-mp-ex-codigo inputmode="numeric" maxlength="6" autocomplete="one-time-code"></label>
                        <label class="mp-ex-rotulo">{{ 'perfil.exclusao.modal.palavra_rotulo'|trans }}<input type="text" class="mp-ex-campo" data-mp-ex-palavra autocomplete="off"></label>
                    </div>
                </div>
                <div class="mp-ex-erro" data-mp-ex-erro role="alert" hidden><i class="bi bi-exclamation-circle"></i> <span></span></div>
            </div>
            <div class="mp-ex-rodape">
                <button type="button" class="mp-ex-manter" data-bs-dismiss="modal">{{ 'perfil.exclusao.modal.manter'|trans }}</button>
                <button type="button" class="mp-ex-avancar" data-mp-ex-avancar>{{ 'perfil.exclusao.modal.continuar'|trans }}</button>
            </div>
        </div>
    </div>
</div>
{% endif %}

{# ══════════════════════════════════════════════
   MODAL: Visualizar / Alterar foto
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalFotoVer" tabindex="-1" aria-labelledby="modalFotoVerLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFotoVerLabel">
                    <i class="bi bi-person-circle me-2"></i>{{ 'perfil.foto.titulo'|trans }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center modal-foto-preview py-4">
                {% if perfil.fotoUrl %}
                    <img id="modalFotoPreviewImg"
                         src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}"
                         alt="{{ 'perfil.foto.atual_alt'|trans }}" class="img-fluid mb-3"
                         style="max-height:260px;border-radius:.5rem;">
                {% else %}
                    <div id="modalFotoPreviewImg"
                         class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3"
