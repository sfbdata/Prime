{% block javascripts %}
<script src="{{ asset('js/meu-perfil.js') }}" defer></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js" crossorigin="anonymous"></script>

<script>
(function () {
    'use strict';

    const TOKEN_FOTO   = '{{ csrf_token('profile_foto') }}';

    // ── Foto: Cropper ──
    let cropper = null;

    const inputFoto          = document.getElementById('inputFotoNova');
    const imgCropper         = document.getElementById('imgCropper');
    const sliderZoom         = document.getElementById('sliderZoom');
    const sliderRotacao      = document.getElementById('sliderRotacao');
    const btnConfirmar       = document.getElementById('btnConfirmarFoto');
    const spinnerFoto        = document.getElementById('spinnerFoto');
    const btnFechar          = document.getElementById('btnFecharCropper');
    const btnCancelarCrop    = document.getElementById('btnCancelarCropper');
    const btnEditarExistente = document.getElementById('btnEditarFotoExistente');

    const modalVerEl    = document.getElementById('modalFotoVer');
    const modalEditarEl = document.getElementById('modalFotoEditar');
    const modalVer    = bootstrap.Modal.getInstance(modalVerEl) ?? new bootstrap.Modal(modalVerEl);
    const modalEditar = new bootstrap.Modal(modalEditarEl);

    function iniciarCropper() {
        if (cropper) { cropper.destroy(); cropper = null; }
        cropper = new Cropper(imgCropper, {
            aspectRatio: 1,
            viewMode: 1,
            dragMode: 'move',
            autoCropArea: 0.9,
            movable: true,
            zoomable: true,
            rotatable: true,
            scalable: false,
            guides: false,
            center: true,
            highlight: true,
            cropBoxMovable: false,
            cropBoxResizable: false,
            ready() { sliderZoom.value = 1; sliderRotacao.value = 0; },
        });
    }

    function abrirCropper(src) {
        imgCropper.src      = src;
        sliderZoom.value    = 1;
        sliderRotacao.value = 0;

        modalEditarEl.addEventListener('shown.bs.modal', iniciarCropper, { once: true });

        if (modalVerEl.classList.contains('show')) {
            modalVerEl.addEventListener('hidden.bs.modal', () => modalEditar.show(), { once: true });
            modalVer.hide();
        } else {
            modalEditar.show();
        }
    }

    inputFoto.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => abrirCropper(e.target.result);
        reader.readAsDataURL(file);
        this.value = '';
    });

    if (btnEditarExistente) {
        btnEditarExistente.addEventListener('click', () => {
            const imgModal = document.getElementById('modalFotoPreviewImg');
            if (imgModal && imgModal.tagName === 'IMG') {
                abrirCropper(imgModal.src);
            }
        });
    }

    sliderZoom.addEventListener('input', function () {
        if (cropper) cropper.zoomTo(parseFloat(this.value));
    });

    sliderRotacao.addEventListener('input', function () {
        if (cropper) cropper.rotateTo(parseInt(this.value, 10));
    });

    function fecharCropper() {
        modalEditar.hide();
        if (cropper) { cropper.destroy(); cropper = null; }
    }

    btnFechar.addEventListener('click', fecharCropper);
    btnCancelarCrop.addEventListener('click', fecharCropper);

    btnConfirmar.addEventListener('click', async () => {
        if (!cropper) return;

        btnConfirmar.disabled = true;
        spinnerFoto.classList.remove('d-none');

        let canvas;
        try {
            canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
        } catch (_) {
            canvas = null;
        }

        if (!canvas) {
            alert('A imagem ainda está carregando. Aguarde um instante e tente novamente.');
            btnConfirmar.disabled = false;
            spinnerFoto.classList.add('d-none');
            return;
        }

        canvas.toBlob(async (blob) => {
            if (!blob) {
                alert('Não foi possível processar a imagem. Tente novamente.');
                btnConfirmar.disabled = false;
                spinnerFoto.classList.add('d-none');
                return;
            }

            const form = new FormData();
            form.append('_token', TOKEN_FOTO);
            form.append('foto', blob, 'perfil.jpg');

            try {
                const res  = await fetch('{{ path('app_profile_foto') }}', { method: 'POST', body: form });
                const data = await res.json();

                if (data.ok) {
                    const novaUrl = data.url + '?t=' + Date.now();

                    const wrap    = document.querySelector('.perfil-foto-btn');
                    const overlay = wrap.querySelector('.perfil-foto-overlay');
                    wrap.innerHTML = '';

                    const imgEl = document.createElement('img');
                    imgEl.id  = 'fotoPerfilAtual';
                    imgEl.alt = 'Foto de perfil';
                    imgEl.src = novaUrl;
                    wrap.appendChild(imgEl);

                    const ov = document.createElement('span');
                    ov.className = 'perfil-foto-overlay';
                    ov.innerHTML = '<i class="bi bi-camera-fill"></i>';
                    wrap.appendChild(ov);

                    const previewEl = document.getElementById('modalFotoPreviewImg');
                    if (previewEl) {
                        if (previewEl.tagName === 'IMG') {
                            previewEl.src = novaUrl;
                        } else {
                            const novoPreview = document.createElement('img');
                            novoPreview.id        = 'modalFotoPreviewImg';
                            novoPreview.alt       = 'Foto atual';
                            novoPreview.className = 'img-fluid mb-3';
                            novoPreview.style.cssText = 'max-height:260px;border-radius:.5rem;';
                            novoPreview.src = novaUrl;
                            previewEl.replaceWith(novoPreview);
                        }
                    }

                    if (btnEditarExistente) btnEditarExistente.style.display = '';

                    const makeAvatarImg = () => {
                        const img = document.createElement('img');
                        img.src = novaUrl;
                        img.alt = '';
                        img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;';
                        return img;
                    };
                    const navAvatar = document.getElementById('navtopAvatar');
                    if (navAvatar) { navAvatar.textContent = ''; navAvatar.appendChild(makeAvatarImg()); }
                    const dropAvatar = document.getElementById('usuarioAvatarLg');
                    if (dropAvatar) { dropAvatar.textContent = ''; dropAvatar.appendChild(makeAvatarImg()); }

                    fecharCropper();
                } else {
                    alert(data.erro ?? 'Erro ao salvar foto.');
                }
            } catch {
                alert('Erro de comunicação.');
            } finally {
                btnConfirmar.disabled = false;
                spinnerFoto.classList.add('d-none');
            }
        }, 'image/jpeg', 0.90);
    });

    // ── Máscara CPF ──
    const campoCpf = document.getElementById('campoCpf');
    if (campoCpf) {
        campoCpf.addEventListener('input', function () {
            let v = this.value.replace(/\D/g, '').slice(0, 11);
            if (v.length > 9)      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
            else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{3})/, '$1.$2.$3');
            else if (v.length > 3) v = v.replace(/(\d{3})(\d{3})/, '$1.$2');
            this.value = v;
        });
    }

    // ── Reabrir modal de dados se houve erro de validação ──
    {% for msg in app.flashes('error') %}
    (function () {
        const m = bootstrap.Modal.getOrCreate(document.getElementById('modalDadosPessoais'));
        m.show();
    })();
    {% endfor %}
})();
</script>
{% endblock %}
