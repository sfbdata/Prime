                <button type="button" class="btn btn-outline-secondary" id="btnEditarFotoExistente"
                        {% if not perfil.fotoUrl %}style="display:none"{% endif %}>
                    <i class="bi bi-crop me-1"></i>{{ 'perfil.foto.editar'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Editar imagem (Cropper)
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalFotoEditar" tabindex="-1" aria-labelledby="modalFotoEditarLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFotoEditarLabel">
                    <i class="bi bi-crop me-2"></i>{{ 'perfil.foto.editar_titulo'|trans }}
                </h5>
                <button type="button" class="btn-close" id="btnFecharCropper"></button>
            </div>
            <div class="modal-body">
                <div id="cropperWrap">
                    <img id="imgCropper" src="" alt="{{ 'perfil.foto.cropper_alt'|trans }}">
                </div>
                <div class="img-slider-wrap mt-3">
                    <div class="img-slider-label">
                        <i class="bi bi-zoom-in"></i> {{ 'perfil.foto.zoom'|trans }}
                    </div>
                    <input type="range" class="img-slider" id="sliderZoom" min="0.1" max="3" step="0.01" value="1">
                </div>
