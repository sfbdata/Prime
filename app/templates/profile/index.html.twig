{% extends 'base.html.twig' %}

{% block title %}Meu Perfil{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/meu-perfil.css') }}">
<style>
/* ── Capa ── */
.perfil-capa {
    height: 200px;
    background: linear-gradient(135deg, #1a3a5c 0%, #2563a8 60%, #3b82d4 100%);
    border-radius: 0.5rem 0.5rem 0 0;
    position: relative;
}

/* ── Card principal ── */
.perfil-card {
    border-radius: 0.5rem;
    box-shadow: 0 2px 16px rgba(0,0,0,.10);
    overflow: visible;
    background: var(--bs-body-bg);
    margin-bottom: 1.5rem;
}

/* ── Área da foto ── */
.perfil-foto-wrap {
    position: absolute;
    bottom: -56px;
    left: 2rem;
}
.perfil-foto-btn {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 4px solid var(--bs-border-color);
    overflow: hidden;
    cursor: pointer;
    background: var(--bs-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--bs-body-color);
    transition: filter .2s;
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
    padding: 0;
}
.perfil-foto-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.perfil-foto-btn:hover .perfil-foto-overlay {
    opacity: 1;
}
.perfil-foto-overlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0,0,0,.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .2s;
    pointer-events: none;
}
.perfil-foto-overlay i {
    color: #fff;
    font-size: 1.6rem;
}

/* ── Info linha abaixo da foto ── */
.perfil-info-row {
    padding: 70px 2rem 1.25rem 2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
}
.perfil-nome {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--bs-body-color);
    line-height: 1.2;
}
.perfil-cargo-lotacao {
    font-size: .88rem;
    color: var(--bs-secondary-color);
    margin-top: .2rem;
}

/* ── Campo de status ── */
.perfil-status-wrap {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: 0 2rem 1.25rem 2rem;
    border-bottom: 1px solid var(--bs-border-color);
}
.perfil-status-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: .95rem;
    color: var(--bs-body-color);
    padding: .3rem .1rem;
    border-bottom: 2px solid transparent;
    transition: border-color .2s;
    max-width: 420px;
}
.perfil-status-input:focus {
    border-bottom-color: #2563a8;
}
.perfil-status-input::placeholder {
    color: var(--bs-secondary-color);
    font-style: italic;
}
.perfil-status-save-btn {
    display: none;
    padding: .25rem .75rem;
    font-size: .82rem;
}

/* ── Grid de dados ── */
.perfil-dados-grid {
    padding: 1.25rem 2rem 1.5rem;
}
.perfil-dado-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .5rem;
    font-size: .9rem;
    color: var(--bs-body-color);
}
.perfil-dado-item i {
    font-size: 1rem;
    color: #2563a8;
    width: 20px;
    text-align: center;
}
.perfil-dado-label {
    font-weight: 600;
    color: var(--bs-body-color);
    min-width: 110px;
}

/* ── Modal de visualização de foto ── */
.modal-foto-preview img {
    max-height: 340px;
    object-fit: contain;
    border-radius: .5rem;
}

/* ── Modal de edição de imagem (Cropper) ── */
#cropperWrap {
    width: 100%;
    height: 320px;
    background: var(--bs-body-color);
    border-radius: .5rem;
    overflow: hidden;
    position: relative;
}
#imgCropper {
    max-width: 100%;
    max-height: 100%;
    display: block;
}

/* ── Slider zoom/rotação ── */
.img-slider-wrap {
    margin-top: .75rem;
}
.img-slider-label {
    font-size: .82rem;
    color: var(--bs-secondary-color);
    margin-bottom: .25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
}
.img-slider-label i {
    font-size: .9rem;
    color: #2563a8;
}
input[type="range"].img-slider {
    width: 100%;
    accent-color: #2563a8;
    cursor: pointer;
}

/* ── Credencial OAB ── */
.perfil-oab-card {
    margin: 1.25rem 2rem 0.25rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 0.85rem;
    overflow: hidden;
    background: var(--bs-body-bg);
}
.perfil-oab-head {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.9rem 1.15rem;
    background: var(--bs-tertiary-bg);
    border-bottom: 1px solid var(--bs-border-color);
}
.perfil-oab-seal {
    width: 42px; height: 42px; flex-shrink: 0; border-radius: 11px;
    display: grid; place-items: center; color: #fff; font-size: 1.3rem;
    background: linear-gradient(135deg, #0078AA, #3b9fd4);
    box-shadow: 0 2px 8px rgba(0,120,170,.35);
}
.perfil-oab-title { font-weight: 700; line-height: 1.15; }
.perfil-oab-sub { font-size: 0.76rem; color: var(--bs-secondary-color); }
.perfil-oab-body { padding: 0.9rem 1.15rem 0.4rem; }
.perfil-oab-num { margin-bottom: 0.5rem; font-variant-numeric: tabular-nums; }
.perfil-oab-num-value { font-size: 1.5rem; font-weight: 700; letter-spacing: 0.5px; }
.perfil-oab-num-uf { font-size: 1.1rem; font-weight: 600; color: var(--bs-secondary-color); }
.perfil-oab-alert {
    display: flex; gap: 0.6rem; align-items: flex-start;
    padding: 0.65rem 0.85rem; margin-bottom: 0.5rem;
    border-radius: 0.55rem; font-size: 0.85rem;
    background: var(--bs-danger-bg-subtle);
    color: var(--bs-danger-text-emphasis);
    border: 1px solid var(--bs-danger-border-subtle);
}
.perfil-oab-alert i { margin-top: 0.1rem; }
.perfil-oab-meta { font-size: 0.8rem; color: var(--bs-secondary-color); }
.perfil-oab-actions { padding: 0.4rem 1.15rem 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
</style>
{% endblock %}

{% block faixa_topo %}
{# Abas do perfil (desenho "07 - Meu Perfil - VS 18.10.26", linhas 44 a 50 e 255): Convites só para o
   primário (ou o Master), como no menu do usuário; Master só para ROLE_SUPER_ADMIN. #}
{% set _ehMasterAba = is_granted('ROLE_SUPER_ADMIN') %}
<nav class="mu-abas-perfil" aria-label="Abas do perfil">
    <div class="mu-abas-perfil-miolo">
        <a href="{{ path('app_profile') }}" class="mu-aba-perfil on" aria-current="page"><i class="bi bi-person"></i>Meu Perfil</a>
        {% if current_tenant() and (eh_usuario_primario() or _ehMasterAba) %}
            <a href="{{ path('auth_gerenciar_convites') }}" class="mu-aba-perfil"><i class="bi bi-envelope-paper"></i>Convites do escritório</a>
        {% endif %}
        {% if current_tenant() %}
            <button type="button" class="mu-aba-perfil" data-mu-conta="trocar"><i class="bi bi-arrow-left-right"></i>Trocar de conta</button>
        {% endif %}
        {% if _ehMasterAba %}
            <div class="dropdown d-flex">
                <button type="button" class="mu-aba-perfil mu-aba-perfil-master" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                    <i class="bi bi-star-fill"></i>Master<i class="bi bi-chevron-down"></i>
                </button>
                <div class="dropdown-menu mu-master-menu" role="menu">
                    <div class="mu-grupo-rotulo"><i class="bi bi-star-fill"></i>EXCLUSIVO DO MASTER</div>
                    <button type="button" class="mu-menu-x mu-menu-x-escuro" data-mu-fechar-menu aria-label="Fechar menu"><i class="bi bi-x-lg"></i></button>
                    {% include 'menu_usuario/_itens_master.html.twig' with {classe_item: 'dropdown-item mu-item', papel: 'menuitem'} only %}
                </div>
            </div>
        {% endif %}
    </div>
</nav>
{% endblock %}

{% block body %}
{#
    Meu Perfil (desenho "07 - Meu Perfil - VS 18.10.26", linhas 52 a 118; spec docs/specs/meu-perfil-pagina.md).
    O card da OAB continua o atual até o PR das várias inscrições.
#}
{% set _ehMaster = is_granted('ROLE_SUPER_ADMIN') %}
{% set _ehPrimario = eh_usuario_primario() %}
{% set v = perfil.vinculo %}
{% set _naoInformado = 'Não informado' %}
{% set _cpfFormatado = perfil.cpf and perfil.cpf|replace({'.': '', '-': '', ' ': ''})|length == 11
    ? perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(0, 3) ~ '.' ~ perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(3, 3) ~ '.' ~ perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(6, 3) ~ '-' ~ perfil.cpf|replace({'.': '', '-': '', ' ': ''})|slice(9, 2)
    : perfil.cpf %}
{% set _campos = [
    {icone: 'bi-envelope', rotulo: 'E-mail', valor: perfil.email, copiar: true},
    {icone: v.icone, rotulo: 'Vínculo', valor: v.rotulo ~ (v.batePonto ? ' · bate ponto' : ' · sem ponto'), copiar: false},
    {icone: 'bi-person-vcard', rotulo: 'CPF', valor: _cpfFormatado, copiar: true},
] %}
{% if v.value == 'clt' %}
    {% set _campos = _campos|merge([
        {icone: 'bi-journal-text', rotulo: 'CTPS', valor: perfil.ctps, copiar: false},
        {icone: 'bi-hash', rotulo: 'Série', valor: perfil.serie, copiar: false},
        {icone: 'bi-calendar-plus', rotulo: 'Admissão', valor: perfil.dataAdmissao ? perfil.dataAdmissao|date('d/m/Y') : null, copiar: false},
    ]) %}
{% else %}
    {% if v.value == 'pj' %}
        {% set _campos = _campos|merge([{icone: 'bi-building', rotulo: 'CNPJ', valor: perfil.cnpj, copiar: true}]) %}
    {% endif %}
    {% set _campos = _campos|merge([
        {icone: v.value == 'estagio' ? 'bi-calendar-plus' : 'bi-file-earmark-text', rotulo: v.rotuloInicio, valor: perfil.contratoInicio ? perfil.contratoInicio|date('d/m/Y') : null, copiar: false},
    ]) %}
{% endif %}
{% set _campos = _campos|merge([
    {icone: 'bi-calendar3', rotulo: 'Nascimento', valor: perfil.dataNascimento ? perfil.dataNascimento|date('d/m/Y') : null, copiar: false},
    {icone: 'bi-calendar-check', rotulo: 'Membro desde', valor: perfil.membroDesde|date('d/m/Y'), copiar: false},
    {icone: 'bi-whatsapp', rotulo: 'Telefone', valor: perfil.telefone, copiar: true},
]) %}

<div class="mp-pagina" id="meuPerfil"
     data-url-preferencia="{{ path('app_profile_preferencia') }}"
     data-url-revisao="{{ path('app_profile_revisao') }}"
     data-revisado-em="{{ perfil.revisadoEm ? perfil.revisadoEm|date('Y-m-d') : '' }}"
     data-usuario="{{ app.user.id }}">

    {# ── Identificação ── #}
    <section class="mp-card mp-ident" data-screen-label="Identificação">
        <div class="mp-capa">
            <span class="mp-capa-bola"></span>
            <img src="{{ asset('images/logo/bluejus-white-transparent-nav.png') }}" alt="BlueJus" class="mp-capa-logo">
        </div>
        <div class="mp-ident-linha">
            <button class="mp-avatar" type="button" data-bs-toggle="modal" data-bs-target="#modalFotoVer" title="Trocar foto" aria-label="Trocar foto">
                {% if perfil.fotoUrl %}
                    <img id="fotoPerfilAtual" src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}" alt="Foto de perfil">
                {% else %}
                    <span id="fotoPerfilAtual" class="mp-avatar-ini">{{ perfil.iniciais }}</span>
                {% endif %}
                <span class="mp-avatar-camera"><i class="bi bi-camera"></i></span>
            </button>
            <div class="mp-ident-texto">
                <div class="mp-nome-linha">
                    <h1 class="mp-nome" id="perfilNomeExibido">{{ perfil.nomeExibido|upper }}</h1>
                    {% if _ehMaster %}<span class="mp-selo mp-selo-master"><i class="bi bi-star-fill"></i>MASTER</span>{% endif %}
                    {% if current_tenant() %}<span class="mp-selo mp-selo-papel">{{ _ehPrimario or _ehMaster ? 'USUÁRIO PRIMÁRIO' : 'SECUNDÁRIO' }}</span>{% endif %}
                </div>
                <div class="mp-cargo">
                    <span><i class="bi bi-briefcase"></i>{{ perfil.cargo ?: 'Cargo não definido' }}</span>
                    <span><i class="bi bi-geo-alt"></i>{{ perfil.lotacao ?: 'Lotação não definida' }}</span>
                </div>
            </div>
            <button class="mp-btn-contorno" type="button" data-mp-editar><i class="bi bi-pencil"></i>Editar informações</button>
        </div>
        <div class="mp-frase{{ perfil.status ? '' : ' vazia' }}"><i class="bi bi-chat-quote"></i><span>{{ perfil.status ?: 'Adicione uma frase ao seu perfil' }}</span></div>

        {% if not completude.completo %}
            <div class="mp-incompleto" data-mp-incompleto>
                <span class="mp-incompleto-icone"><i class="bi bi-exclamation-triangle-fill"></i></span>
                <div class="mp-incompleto-texto">
                    <div><b>Seu cadastro está incompleto</b><span class="mp-incompleto-pct">{{ completude.percentual }}% preenchido</span></div>
                    <div class="mp-barra"><div style="width: {{ completude.percentual }}%"></div></div>
                    <div class="mp-falta"><span>Falta:</span>{% for item in completude.faltando %}<span class="mp-chip"><i class="bi bi-plus-circle"></i>{{ item }}</span>{% endfor %}</div>
                </div>
                <button class="mp-btn-laranja" type="button" data-mp-editar><i class="bi bi-pencil"></i>Completar agora</button>
            </div>
        {% endif %}

        <div class="mp-grade">
            {% for c in _campos %}
                <div class="mp-linha">
                    <i class="bi {{ c.icone }}"></i>
                    <b>{{ c.rotulo }}</b>
                    <span class="{{ c.valor ? '' : 'vazio' }}">{{ c.valor ?: _naoInformado }}{% if c.copiar and c.valor %}<button type="button" class="mp-copiar" data-mp-copiar="{{ c.valor }}" title="Copiar" aria-label="Copiar {{ c.rotulo }}"><i class="bi bi-copy"></i></button>{% endif %}</span>
                </div>
            {% endfor %}
        </div>
    </section>

    {# ── Registro OAB (o card atual; várias inscrições chegam no PR seguinte) ── #}
    <section class="mp-card mp-card-oab" data-screen-label="Registro OAB">
            {# Seção OAB — credencial profissional #}
            {% set oabStatus = perfil.oabStatus ? perfil.oabStatus.value : null %}
            <div class="perfil-oab-card">
                <div class="perfil-oab-head">
                    <div class="perfil-oab-seal"><i class="bi bi-patch-check-fill"></i></div>
                    <div class="flex-grow-1">
                        <div class="perfil-oab-title">Registro OAB</div>
                        <div class="perfil-oab-sub">Ordem dos Advogados do Brasil</div>
                    </div>
                    {% include '_oab_status.html.twig' with {status: perfil.oabStatus} only %}
                </div>
                <div class="perfil-oab-body">
                    <div class="perfil-oab-num">
                        {% if perfil.oabNumero %}
                            <span class="perfil-oab-num-value">{{ perfil.oabNumero }}</span><span class="perfil-oab-num-uf">/{{ perfil.oabUf }}</span>
                        {% else %}
                            <span class="text-secondary fst-italic">OAB não informada</span>
                        {% endif %}
                    </div>
                    {% if oabStatus == 'divergente' and perfil.oabNomeOficial %}
                        <div class="perfil-oab-alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <div><span class="text-secondary">Nome no CNA:</span> <strong>{{ perfil.oabNomeOficial }}</strong></div>
                                <div><span class="text-secondary">Informado:</span> {{ perfil.nomeExibido }}</div>
                            </div>
                        </div>
                    {% endif %}
                    {% if perfil.oabVerificadaEm %}
                        <div class="perfil-oab-meta"><i class="bi bi-clock-history me-1"></i>Verificada em {{ perfil.oabVerificadaEm|date('d/m/Y H:i') }}</div>
                    {% endif %}
                </div>
                <div class="perfil-oab-actions">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalOab">
                        <i class="bi bi-pencil me-1"></i>{{ perfil.oabNumero ? 'Editar OAB' : 'Informar OAB' }}
                    </button>
                    {% if perfil.oabNumero %}
                        <form action="{{ path('app_profile_oab_verificar') }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_oab_verificar') }}">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-repeat me-1"></i>Verificar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

    </section>

    {# ── Preferências ── #}
    <section class="mp-card" data-screen-label="Preferências">
        <div class="mp-card-topo">
            <span class="mp-card-selo"><i class="bi bi-sliders"></i></span>
            <div><b>Preferências</b><div class="mp-card-sub">Valem só para você</div></div>
        </div>
        <div class="mp-prefs">
            <button type="button" class="mp-pref" data-mu-idioma>
                <i class="bi bi-translate"></i>
                <span class="mp-pref-texto"><span>Idioma do sistema</span><small>Muda todas as telas, menus e o Chat I.A</small></span>
                <span class="mp-pref-valor">Português (Brasil)</span><i class="bi bi-chevron-right mp-pref-seta"></i>
            </button>
            {% for p in [
                {chave: 'perfil.notificacoes', icone: 'bi-bell', rotulo: 'Notificações no sistema', sub: 'Sininho de prazos, metas e menções'},
                {chave: 'perfil.sons', icone: 'bi-volume-up', rotulo: 'Sons de alerta', sub: 'Toque ao receber mensagem ou alerta'},
                {chave: 'perfil.resumo_email', icone: 'bi-envelope', rotulo: 'Resumo diário por e-mail', sub: 'Prazos e metas do dia, às 8h'},
            ] %}
                <button type="button" class="mp-pref" role="switch" aria-checked="{{ preferencias[p.chave] ? 'true' : 'false' }}" data-mp-pref="{{ p.chave }}">
                    <i class="bi {{ p.icone }}"></i>
                    <span class="mp-pref-texto"><span>{{ p.rotulo }}</span><small>{{ p.sub }}</small></span>
                    <span class="mp-chave" aria-hidden="true"><span></span></span>
                </button>
            {% endfor %}
        </div>
    </section>

    {# Ponto de inclusão da frente do Contribua: bloco "Assinatura" (plano, vencimento e cancelar), porque o checkout
       do desenho 08 manda cancelar em Meu Perfil. Basta a outra frente criar o parcial. #}
    {% include 'contribua/_assinatura_no_perfil.html.twig' ignore missing %}

    {# ── Segurança ── #}
    <section class="mp-card" data-screen-label="Segurança">
        <div class="mp-card-topo">
            <span class="mp-card-selo"><i class="bi bi-shield-lock"></i></span>
            <div><b>Segurança</b><div class="mp-card-sub">Senha de acesso à sua conta</div></div>
        </div>
        <div class="mp-seguranca">
            <div>Ao alterar a senha, todas as outras sessões conectadas são encerradas, inclusive as que usam "manter conectado".</div>
            <button class="mp-btn-azul" type="button" data-bs-toggle="modal" data-bs-target="#modalSenha"><i class="bi bi-key"></i>Alterar senha</button>
        </div>
    </section>
</div>

{# ══════════════════════════════════════════════
   MODAL: Visualizar / Alterar foto
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalFotoVer" tabindex="-1" aria-labelledby="modalFotoVerLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFotoVerLabel">
                    <i class="bi bi-person-circle me-2"></i>Foto de perfil
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center modal-foto-preview py-4">
                {% if perfil.fotoUrl %}
                    <img id="modalFotoPreviewImg"
                         src="{{ path('app_profile_foto_serve', {nome: perfil.fotoUrl}) }}"
                         alt="Foto atual" class="img-fluid mb-3"
                         style="max-height:260px;border-radius:.5rem;">
                {% else %}
                    <div id="modalFotoPreviewImg"
                         class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3"
                         style="width:160px;height:160px;background:linear-gradient(135deg,#1a3a5c,#2563a8);font-size:4rem;font-weight:700;color:#fff;">
                        {{ perfil.iniciais }}
                    </div>
                {% endif %}
            </div>
            <div class="modal-footer justify-content-center gap-2">
                <label class="btn btn-primary" style="cursor:pointer">
                    <i class="bi bi-upload me-1"></i>Alterar imagem
                    <input type="file" id="inputFotoNova" accept="image/jpeg,image/png,image/webp" hidden>
                </label>
                <button type="button" class="btn btn-outline-secondary" id="btnEditarFotoExistente"
                        {% if not perfil.fotoUrl %}style="display:none"{% endif %}>
                    <i class="bi bi-crop me-1"></i>Editar imagem
                </button>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Editar imagem (Cropper)
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalFotoEditar" tabindex="-1" aria-labelledby="modalFotoEditarLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFotoEditarLabel">
                    <i class="bi bi-crop me-2"></i>Editar imagem
                </h5>
                <button type="button" class="btn-close" id="btnFecharCropper"></button>
            </div>
            <div class="modal-body">
                <div id="cropperWrap">
                    <img id="imgCropper" src="" alt="Editar foto">
                </div>
                <div class="img-slider-wrap mt-3">
                    <div class="img-slider-label">
                        <i class="bi bi-zoom-in"></i> Zoom
                    </div>
                    <input type="range" class="img-slider" id="sliderZoom" min="0.1" max="3" step="0.01" value="1">
                </div>
                <div class="img-slider-wrap">
                    <div class="img-slider-label">
                        <i class="bi bi-arrow-repeat"></i> Rotação
                    </div>
                    <input type="range" class="img-slider" id="sliderRotacao" min="-180" max="180" step="1" value="0">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="btnCancelarCropper" type="button">Cancelar</button>
                <button class="btn btn-primary" id="btnConfirmarFoto" type="button">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinnerFoto"></span>
                    Salvar foto
                </button>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Editar dados pessoais
══════════════════════════════════════════════ #}
<div class="modal fade mp-modal" id="modalDadosPessoais" tabindex="-1" aria-labelledby="modalDadosPessoaisLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mp-modal-largo">
        <div class="modal-content">
            <div class="mp-modal-topo">
                <i class="bi bi-pencil"></i><b id="modalDadosPessoaisLabel">Editar informações</b>
                <button type="button" class="mp-modal-x" data-bs-dismiss="modal" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
            </div>
            {{ form_start(form_dados, {action: path('app_profile_dados'), attr: {id: 'formDadosPessoais', novalidate: 'novalidate'}}) }}
                {% if current_tenant() %}
                    <div class="mp-vinculo" data-mp-vinculo>
                        <span class="mp-rotulo">VÍNCULO COM O ESCRITÓRIO</span>
                        <div class="mp-vinculo-opcoes">
                            {% for opcao in form_dados.vinculo %}
                                <label class="mp-vinculo-op{{ opcao.vars.checked ? ' on' : '' }}{{ podeAlterarVinculo ? '' : ' travado' }}">
                                    {{ form_widget(opcao, {attr: opcao.vars.attr|merge({class: 'visually-hidden'})|merge(podeAlterarVinculo ? {} : {disabled: 'disabled'})}) }}
                                    <i class="bi {{ opcao.vars.attr['data-icone'] }}"></i>{{ opcao.vars.label }}
                                </label>
                            {% endfor %}
                        </div>
                        <span class="mp-ajuda" data-mp-vinculo-ajuda>
                            {% if podeAlterarVinculo %}
                                <i class="bi bi-info-circle"></i><span data-mp-ajuda-texto>{{ perfil.vinculo.ajuda }}</span>
                            {% else %}
                                <i class="bi bi-lock"></i><span>Definido pelo escritório. Para alterar, fale com o usuário primário.</span>
                            {% endif %}
                        </span>
                    </div>
                {% else %}
                    {% do form_dados.vinculo.setRendered %}
                {% endif %}
                <div class="mp-campos">
                    <label class="mp-campo mp-campo-inteiro"><span>NOME COMPLETO</span>{{ form_widget(form_dados.nomeCompleto) }}</label>
                    <label class="mp-campo mp-campo-inteiro"><span>FRASE DO PERFIL</span>{{ form_widget(form_dados.status) }}</label>
                    <label class="mp-campo"><span>TELEFONE / WHATSAPP</span>{{ form_widget(form_dados.telefone) }}</label>
                    <label class="mp-campo"><span>CPF</span>{{ form_widget(form_dados.cpf, {attr: {placeholder: 'Somente números'}}) }}<small>Usado nos relatórios e estatísticas do escritório</small></label>
                    <label class="mp-campo"><span>NASCIMENTO</span>{{ form_widget(form_dados.dataNascimento) }}</label>
                    <label class="mp-campo" data-mp-para="clt"><span>CTPS</span>{{ form_widget(form_dados.ctps, {attr: {placeholder: ''}}) }}<small>Só para empregado CLT</small></label>
                    <label class="mp-campo" data-mp-para="clt"><span>SÉRIE</span>{{ form_widget(form_dados.serie, {attr: {placeholder: ''}}) }}</label>
                    <label class="mp-campo" data-mp-para="clt"><span>DATA DE ADMISSÃO</span>{{ form_widget(form_dados.dataAdmissao) }}</label>
                    <label class="mp-campo" data-mp-para="pj"><span>CNPJ (SE HOUVER)</span>{{ form_widget(form_dados.cnpj) }}</label>
                    <label class="mp-campo" data-mp-para="associado pj socio estagio"><span data-mp-rotulo-inicio>{{ perfil.vinculo.rotuloInicio|upper }}</span>{{ form_widget(form_dados.contratoInicio) }}<small>Data em que o vínculo começou</small></label>
                </div>
                <div class="mp-modal-rodape">
                    <button type="button" class="mp-btn-cinza" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="mp-btn-azul"><i class="bi bi-check2"></i>Salvar</button>
                </div>
            {{ form_end(form_dados) }}
        </div>
    </div>
</div>

{# Revisão mensal do cadastro (desenho 07, revOn): o JS decide se mostra neste mês. #}
<div class="modal fade mp-modal" id="modalRevisao" tabindex="-1" aria-labelledby="modalRevisaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mp-modal-medio">
        <div class="modal-content">
            <div class="mp-rev-topo">
                <button type="button" class="mp-modal-x" data-bs-dismiss="modal" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
                <i class="bi bi-person-check"></i>
                <div class="mp-rev-titulo" id="modalRevisaoLabel">Seu cadastro está atualizado?</div>
                <div class="mp-rev-sub">Revisão mensal · {{ perfil.revisadoEm ? 'Última confirmação: ' ~ perfil.revisadoEm|date('d/m/Y') : 'Primeira revisão do cadastro' }}</div>
            </div>
            <div class="mp-rev-corpo">
                <div class="mp-texto">{{ completude.faltando is empty
                    ? 'Confira se telefone, vínculo e documentos continuam corretos. Esses dados alimentam relatórios, estatísticas e o controle de ponto do escritório.'
                    : 'Faltam: ' ~ completude.faltando|join(', ') ~ '. Esses dados alimentam relatórios, estatísticas e o controle de ponto do escritório.' }}</div>
                <div class="mp-rev-barra"><div class="mp-barra mp-barra-azul"><div style="width: {{ completude.percentual }}%"></div></div><b>{{ completude.percentual }}%</b></div>
                <div class="mp-rev-resumo">
                    <div><span>Telefone</span><b>{{ perfil.telefone ?: 'Não informado' }}</b></div>
                    <div><span>Vínculo</span><b>{{ perfil.vinculo.rotulo }}</b></div>
                    <div><span>OAB principal</span><b>{{ perfil.oabNumero ? perfil.oabNumero ~ '/' ~ perfil.oabUf : 'Não informada' }}</b></div>
                </div>
                <div class="mp-modal-rodape mp-rodape-solto">
                    <button type="button" class="mp-btn-cinza" data-mp-revisao-ok>Está tudo certo</button>
                    <button type="button" class="mp-btn-azul" data-mp-revisao-ir><i class="bi bi-pencil"></i>Atualizar agora</button>
                </div>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════
   MODAL: Informar / editar OAB
══════════════════════════════════════════════ #}
<div class="modal fade" id="modalOab" tabindex="-1" aria-labelledby="modalOabLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalOabLabel">
