<!DOCTYPE html>
<html lang="{{ idioma_atual().value }}" dir="{{ idioma_atual().direcao }}" data-bs-theme="light"{% if animacoes_reduzidas() %} class="jp-sem-anim"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
        <meta name="color-scheme" content="light">
        {# Anti-flash: aplica o tema salvo antes do render, evitando piscar branco #}
        {% if recurso_visivel('tema') %}
        <script>
            (function () {
                try {
                    if (localStorage.getItem('tema') === 'dark') {
                        document.documentElement.setAttribute('data-bs-theme', 'dark');
                    }
                } catch (e) {}
            })();
        </script>
        {% endif %}
        {# CSRF para AJAX: token único 'ajax' + interceptador que injeta o header X-CSRF-Token
           em toda requisição same-origin de método inseguro (fetch e XMLHttpRequest/jQuery). #}
        <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
        <script>
            (function () {
                var meta = document.querySelector('meta[name="csrf-token"]');
                var token = meta ? meta.getAttribute('content') : '';
                if (!token) { return; }
                var unsafe = /^(POST|PUT|PATCH|DELETE)$/i;
                function sameOrigin(url) {
                    try { return new URL(url, window.location.origin).origin === window.location.origin; }
                    catch (e) { return true; }
                }
                if (window.fetch) {
                    var origFetch = window.fetch;
                    window.fetch = function (input, init) {
                        init = init || {};
                        var method = init.method || (input && typeof input !== 'string' && input.method) || 'GET';
                        var url = (typeof input === 'string') ? input : (input && input.url) || '';
                        if (unsafe.test(method) && sameOrigin(url)) {
                            var headers = new Headers(init.headers || (typeof input !== 'string' && input ? input.headers : null) || {});
                            if (!headers.has('X-CSRF-Token')) { headers.set('X-CSRF-Token', token); }
                            init.headers = headers;
                        }
                        return origFetch.call(this, input, init);
                    };
                }
                var origOpen = XMLHttpRequest.prototype.open;
                var origSend = XMLHttpRequest.prototype.send;
                XMLHttpRequest.prototype.open = function (method, url) {
                    this.__csrfUnsafe = unsafe.test(method || '') && sameOrigin(url || '');
                    return origOpen.apply(this, arguments);
                };
                XMLHttpRequest.prototype.send = function () {
                    if (this.__csrfUnsafe) {
                        try { this.setRequestHeader('X-CSRF-Token', token); } catch (e) {}
                    }
                    return origSend.apply(this, arguments);
                };
            })();
        </script>
        {% block head_meta %}{% endblock %}
        <title>{% block title %}BlueJus{% endblock %}</title>

        {# Favicon #}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
        <link rel="manifest" href="/site.webmanifest">

        {# Fonte do sistema: Arial, declarada no app.css (--jp-font-sans), por decisão do dono de
           19/08/2026 — os usuários não aprovaram o Source Sans 3 que entrou em 10/08. O link do
           Fontsource que ficava aqui foi removido junto: nenhuma regra pede mais essa família, e
           mantê-lo só custaria uma requisição de fonte que ninguém usa (era exatamente o que
           acontecia antes de 10/08). #}

        {# OverlayScrollbars #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" crossorigin="anonymous">

        {# Bootstrap Icons #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous">

        {# Font Awesome (for backward compatibility) #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css" crossorigin="anonymous">

        {# AdminLTE 4 #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous">

        {# Select2 #}
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" crossorigin="anonymous">

        {# App Custom Styles #}
        <link rel="stylesheet" href="/css/app.css">
        <link rel="stylesheet" href="{{ asset('css/menu-usuario.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    {#
        IMPORTANTE: NÃO colocar sidebar-collapse nem sidebar-open aqui.
        O AdminLTE detecta essas classes e interfere no nosso controle customizado.
        O sidebar é gerenciado exclusivamente pelo JS do _sidebar.html.twig.
    #}
    {# `body_class`: gancho para a página pintar o próprio fundo. Existe porque
       o redesenho da pasta usa um fundo diferente do bg-body-tertiary do resto
       do sistema, e não há como uma regra CSS subir do conteúdo até o <body>. #}
    <body class="layout-fixed sidebar-expand-lg bg-body-tertiary {% block body_class %}{% endblock %}">
        {% if app.user %}
            {# App Wrapper #}
            <div class="app-wrapper">

                {# ============================================================
                   HEADER FIXO — estilo PJe
                   ============================================================ #}
                <nav class="app-header navtop" id="mainHeader" tabindex="-1">

                    {# ── Barra principal azul ── #}
                    <div class="navtop-inner">

                        {# Lado esquerdo: toggle + brand + título da página #}
                        <div class="navtop-left">
                            {#
                                IMPORTANTE: data-lte-toggle="sidebar" REMOVIDO.
                                O AdminLTE interceptaria o clique e abriria o sidebar
                                do jeito dele. O controle é feito pelo nosso JS.
                            #}
                            <button class="sidebar-toggle-btn" id="sidebarToggleBtn"
                                    type="button"
                                    aria-label="{{ 'moldura.cabecalho.menu_lateral_alternar'|trans }}" data-tip="{{ 'moldura.cabecalho.menu_lateral_dica'|trans }}">
                                <i class="bi bi-list"></i>
                            </button>
                            <a href="{{ path('expediente_index') }}" class="navtop-brand">
                                <img src="/images/logo/bluejus-white-transparent-nav.png" alt="BlueJus" class="navtop-brand-logo" style="height:32px;">
                            </a>
                            {# Separador + título da página atual #}
                            {% set pageTitle = '' %}
                            {% set currentRoute = app.request.attributes.get('_route')|default('') %}
                            {% if currentRoute starts with 'cliente_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.clientes'|trans %}
                            {% elseif currentRoute starts with 'processo_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.processos'|trans %}
                            {% elseif currentRoute starts with 'pasta_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.pastas'|trans %}
                            {% elseif currentRoute starts with 'tarefa_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.metas'|trans %}
                            {% elseif currentRoute starts with 'agenda_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.agenda'|trans %}
                            {% elseif currentRoute starts with 'servicedesk_' or currentRoute starts with 'service_desk_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.service_desk'|trans %}
                            {% elseif currentRoute starts with 'app_tenant_role_' or currentRoute starts with 'master_' %}
                                {# Desenho 05 Perfis 1.2, L39: a barra mostra "Perfis" na lista, na edição e no perfil Master. #}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.perfis'|trans %}
                            {% elseif currentRoute starts with 'app_tenant_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.tenants'|trans %}
                            {% elseif currentRoute starts with 'audit_log_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.auditoria'|trans %}
                            {% elseif currentRoute == 'invite_user' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.convidar_usuarios'|trans %}
                            {% elseif currentRoute == 'app_profile' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.meu_perfil'|trans %}
                            {% elseif currentRoute starts with 'expediente_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.expediente'|trans %}
                            {% elseif currentRoute starts with 'cobranca_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.cobrancas'|trans %}
                            {% elseif currentRoute starts with 'contribua_' %}
                                {% set pageTitle = 'moldura.cabecalho.titulo_pagina.quem_somos_e_contribua'|trans %}
                            {% endif %}
                            {% if pageTitle %}
                                <span class="navtop-page-sep">|</span>
                                <span class="navtop-page-title">{{ pageTitle }}</span>
                            {% endif %}
                        </div>

                        {# Lado direito: notificações + fullscreen + usuário #}
                        <div class="navtop-right">

                            {# Escritório atual: abre "Trocar conta" no modal "Conta do escritório"
                               (desenho 07 - Meu Perfil, VS 18.10.26). Criar e sair do escritório moram no modal. #}
                            {% set _escritorios = meus_escritorios() %}
                            {% if current_tenant() and _escritorios|length > 0 %}
                                <div class="navtop-action">
                                    <button type="button" class="navtop-avatar-btn mu-escritorio" data-mu-conta="trocar"
                                            aria-label="{{ 'moldura.cabecalho.escritorio_trocar_conta'|trans({escritorio: current_tenant().name}) }}" {% if 'exp-body' in block('body_class') %}data-tip{% else %}title{% endif %}="{{ current_tenant().name }}">
                                        <i class="bi bi-building"></i>
                                        <span class="navtop-escritorio-nome d-none d-lg-inline">{{ current_tenant().name }}</span>
                                    </button>
                                </div>
                            {% endif %}

                            {# Ponto de inclusão de outras frentes no cabeçalho, antes do sininho. Basta criar o
                               parcial; o base não precisa mudar (dono do cabeçalho: frente menu-do-usuario). #}
                            {% include 'layout/_cabecalho_acoes.html.twig' ignore missing %}

                            {# Notificações #}
                            <div class="navtop-action dropdown">
                                <a href="#" class="navtop-action-btn"
                                   data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                   id="notificacaoDropdownToggle"
                                   aria-label="{{ 'moldura.notificacoes.rotulo'|trans }}" data-tip="{{ 'moldura.notificacoes.rotulo'|trans }}">
                                    <i class="bi bi-bell"></i>
                                    <span class="navtop-badge" id="notificacaoBadge"
                                          style="{% if notificacoesCount == 0 %}display:none;{% endif %}">
                                        {{ notificacoesCount > 9 ? '9+' : notificacoesCount }}
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow notif-dropdown"
                                     id="notificacaoDropdownMenu">
                                    {% if podeVerGestao %}
                                        <ul class="nav nav-tabs notif-tabs pt-2" role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active" type="button" role="tab"
                                                        data-categoria="pessoal" data-bs-toggle="tab" data-bs-target="#notifTabPessoal">
                                                    {{ 'moldura.notificacoes.aba_minhas'|trans }}
                                                    <span class="badge text-bg-secondary notif-tab-badge" id="notifBadgePessoal"
                                                          {% if notificacoesPessoaisCount == 0 %}style="display:none"{% endif %}>{{ notificacoesPessoaisCount }}</span>
                                                </button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" type="button" role="tab"
                                                        data-categoria="gestao" data-bs-toggle="tab" data-bs-target="#notifTabGestao">
                                                    {{ 'moldura.notificacoes.aba_gestao'|trans }}
                                                    <span class="badge text-bg-warning notif-tab-badge" id="notifBadgeGestao"
                                                          {% if notificacoesGestaoCount == 0 %}style="display:none"{% endif %}>{{ notificacoesGestaoCount }}</span>
                                                </button>
                                            </li>
                                        </ul>
                                    {% else %}
                                        <div class="notif-header">
                                            <i class="bi bi-bell me-1"></i>
                                            <span id="notificacaoCountText">{{ notificacoesCount }}</span> {{ 'moldura.notificacoes.contagem_sufixo'|trans }}
                                        </div>
                                    {% endif %}
                                    <div class="dropdown-divider m-0"></div>
                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="notifTabPessoal" role="tabpanel">
                                            <div class="notif-list" id="notifContainerPessoal" data-categoria="pessoal">
                                                {% if notificacoes|length > 0 %}
                                                    {% for notif in notificacoes %}
                                                        <a href="{{ notif.url ?? (notif.tarefa ? path('tarefa_show', {id: notif.tarefa.id}) : '#') }}"
                                                           class="dropdown-item notif-item{% if not notif.lida %} notif-unread{% endif %}">
                                                            <i class="bi {{ notif.icone }} notif-icon"></i>
                                                            <div class="notif-body">
                                                                <div class="notif-title">{{ notif.titulo }}</div>
                                                                {% if notif.mensagem and notif.mensagem != notif.titulo %}
                                                                    <div class="notif-msg">{{ notif.mensagem }}</div>
                                                                {% endif %}
                                                                <div class="notif-time">{{ notif.tempoRelativo }}</div>
                                                            </div>
                                                        </a>
                                                        <div class="dropdown-divider m-0"></div>
                                                    {% endfor %}
                                                {% else %}
                                                    <a href="#" class="dropdown-item text-center text-muted py-3">
                                                        <i class="bi bi-check-circle me-2"></i> {{ 'moldura.notificacoes.nenhuma'|trans }}
                                                    </a>
                                                {% endif %}
                                            </div>
                                        </div>
                                        {% if podeVerGestao %}
                                            <div class="tab-pane fade" id="notifTabGestao" role="tabpanel">
                                                <div class="notif-list" id="notifContainerGestao" data-categoria="gestao" data-carregado="0">
                                                    <div class="text-center text-muted py-3">
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <a href="{{ path('notificacao_index') }}" class="dropdown-item text-center notif-footer">
                                        <i class="bi bi-list-ul me-1"></i> {{ 'moldura.notificacoes.ver_todas'|trans }}
                                    </a>
                                </div>
                            </div>

                            {# Instalar App #}
                            {% if recurso_visivel('instalar') %}
                            <button type="button" id="btnInstalarApp"
                                    class="navtop-action-btn {{ recurso_marca('instalar') }}"
                                    aria-label="{{ 'moldura.cabecalho.instalar_aplicativo'|trans }}"
                                    style="display:none; background:none; border:none; cursor:pointer;">
                                <i class="bi bi-download"></i>
                            </button>
                            {% endif %}

                            {# Fullscreen #}
                            <a href="#" class="navtop-action-btn" data-lte-toggle="fullscreen"
                               aria-label="{{ 'moldura.cabecalho.tela_cheia'|trans }}" data-tip="{{ 'moldura.cabecalho.tela_cheia'|trans }}">
                                <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                                <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display:none"></i>
                            </a>

                            {# Usuário: nome, papel e avatar; o menu mora em templates/menu_usuario/_dropdown.html.twig #}
                            {% set _partesNome = app.user.fullName|trim|split(' ')|filter(p => p is not empty) %}
                            {% set _iniciais = _partesNome|length > 0
                                ? (_partesNome|first|slice(0, 1) ~ (_partesNome|length > 1 ? _partesNome|last|slice(0, 1) : ''))|upper
                                : '?' %}
                            {% set _ehMaster = is_granted('ROLE_SUPER_ADMIN') %}
                            {% set _ehPrimario = eh_usuario_primario() %}
                            <div class="navtop-action dropdown menu-usuario">
                                <a href="#" class="navtop-avatar-btn dropdown-toggle" data-mu-toggle
                                   data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                   aria-haspopup="menu" aria-label="{{ 'moldura.cabecalho.menu_usuario'|trans }}">
                                    <div class="navtop-user-info d-none d-md-flex">
                                        <span class="navtop-username">{{ app.user.fullName }}</span>
                                        {% set papelNaBarra = papel_na_barra() %}
                                        {% if papelNaBarra %}<span class="navtop-user-papel">{{ papelNaBarra }}</span>{% endif %}
                                    </div>
                                    <span class="navtop-avatar" id="navtopAvatar">
                                        {% if fotoPerfilUrl %}
                                            <img src="{{ path('app_profile_foto_serve', {nome: fotoPerfilUrl}) }}"
                                                 alt="{{ app.user.fullName }}"
                                                 style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                                        {% else %}
                                            {{ _iniciais }}
                                        {% endif %}
                                    </span>
                                </a>
                                {% include 'menu_usuario/_dropdown.html.twig' %}
                                {# Selo de presença on-line e painel (desenho 03, frente do Expediente). Fica fora do <a>
                                   para o clique no selo não abrir este menu; posição relativa a .menu-usuario. #}
                                {% include 'menu_usuario/_presenca.html.twig' ignore missing %}
                            </div>

                        </div>{# /navtop-right #}
                    </div>{# /navtop-inner #}

                    {# ── Subnav branco ── #}
                    <div class="navtop-subnav">
                        <a href="{{ path('expediente_index') }}"
                           class="navtop-subnav-link {{ app.request.attributes.get('_route') starts with 'expediente_' ? 'active' : '' }}">
                            {{ 'moldura.cabecalho.subnav.expediente'|trans }}
                        </a>
                        <a href="{{ path('demandas_index') }}"
                           class="navtop-subnav-link {{ app.request.attributes.get('_route') == 'demandas_index' ? 'active' : '' }}">
                            {{ 'moldura.cabecalho.subnav.demandas'|trans }}
                        </a>
                        {# Processos saiu daqui (16/10, pedido do dono): o cadastro mora dentro do Push
                           Processual, que acompanha as publicações por OAB e por processo cadastrado. #}
                        {% if can_access_module('tarefas') and recurso_visivel('metas') %}
                            <a href="{{ path('tarefa_minhas') }}"
                               class="navtop-subnav-link {{ recurso_marca('metas') }} {{ app.request.attributes.get('_route') starts with 'tarefa_' ? 'active' : '' }}">
                                {{ 'moldura.cabecalho.subnav.minhas_metas'|trans }}
                            </a>
                        {% endif %}
                        {% if can_access_module('agenda') %}
                            <a href="{{ path('agenda_index') }}"
                               class="navtop-subnav-link {{ app.request.attributes.get('_route') starts with 'agenda_' ? 'active' : '' }}">
                                {{ 'moldura.cabecalho.subnav.agenda'|trans }}
                            </a>
                        {% endif %}
                        {% if can_access_module('trabalho_externo') and recurso_visivel('trabalho') %}
                            <a href="{{ path('trabalho_externo_index') }}"
                               class="navtop-subnav-link {{ recurso_marca('trabalho') }} {{ app.request.attributes.get('_route') starts with 'trabalho_externo_' ? 'active' : '' }}">
                                {{ 'moldura.cabecalho.subnav.trabalho_externo'|trans }}
                            </a>
                        {% endif %}
                    </div>

                </nav>
                {# ============================================================
                   FIM HEADER
                   ============================================================ #}

                {# Sidebar #}
                {% block sidebar %}{% include '_sidebar.html.twig' %}{% endblock %}

                {# Main Content #}
                {% include '_recurso_faixa_master.html.twig' %}
                <main class="app-main" id="main" tabindex="-1">
                    {# Faixa logo abaixo do cabeçalho, na largura do conteúdo (abas do Meu Perfil). #}
                    {% block faixa_topo %}{% endblock %}
                    <div class="app-content-header">
                        <div class="container-fluid">
                            {% for label, messages in app.flashes %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                                        {{ message }}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'moldura.comum.fechar'|trans }}"></button>
                                    </div>
                                {% endfor %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="app-content">
                        <div class="container-fluid">
                            {% block body %}{% endblock %}
                        </div>
                    </div>
                </main>

            </div>{# /app-wrapper #}

            {# Alerta de ponto eletrônico #}
            {% if app.user and can_access_module('ponto') and tem_jornada_no_escritorio() %}
                {% include 'ponto/_modal_alerta_ponto.html.twig' %}
            {% endif %}

            {# Ponto de inclusão de avisos globais de outras frentes (lembretes da agenda, aviso de espaço
               do plano...): cada uma cria o próprio parcial em templates/layout/_globais/ e o lista aqui. #}
            {% include 'layout/_globais.html.twig' ignore missing %}

            {# Modais do menu do usuário (Conta do escritório, Idioma, Em preparação) #}
            {% include 'menu_usuario/_modais.html.twig' %}

            {# Central de Comunicação flutuante (lançador + janela, Designer 13/10). Componente isolado da Central (D6:
               esta é a única linha no layout); não aparece na própria /central, que já é a janela em página. #}
            {# Telas e recursos: a bolha é a chave "chat" (desenho 05 + bluejus-central.js de 18/10, data-recurso="chat"). #}
            {% if central_disponivel() and app.request.attributes.get('_route') != 'central_index' and recurso_visivel('chat') %}
                {% include 'central/_flutuante.html.twig' %}
            {% endif %}

        {% else %}
            <div class="no-sidebar">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} m-3">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
                {{ block('body') }}
            </div>
        {% endif %}

        {# Scripts #}
        <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {

                // O tema claro/escuro (chave no menu do usuário) mora em public/js/menu-usuario.js.

                // ── Polling do total no sino a cada 30 s. Pede JSON (com a sessão vencida, o servidor responde 401 e
                // o pedido não vira destino do login) e para de sondar no 401: nada de laço batendo na porta.
                let sinoParado = false;
                let sinoIntervalo = null;
                function pararSino() {
                    sinoParado = true;
                    if (sinoIntervalo !== null) { clearInterval(sinoIntervalo); sinoIntervalo = null; }
                }
                function respostaDoSino(r) {
                    if (r.status === 401) { pararSino(); throw new Error('sessao'); }
                    return r.json();
                }
                function atualizarNotificacoes() {
                    if (sinoParado) return;
                    fetch('/notificacoes/count', { headers: { Accept: 'application/json' } })
                        .then(respostaDoSino)
                        .then(data => {
                            const badge    = document.getElementById('notificacaoBadge');
                            const countTxt = document.getElementById('notificacaoCountText');
                            const n = data.count;
                            if (countTxt) countTxt.textContent = n;
                            if (badge) {
                                badge.textContent   = n > 9 ? '9+' : n;
                                badge.style.display = n > 0 ? '' : 'none';
                            }
                        })
                        .catch(e => console.log('Notificações:', e));
                }
                sinoIntervalo = setInterval(atualizarNotificacoes, 30000);

                // ── Carrega a lista de uma aba (categoria) do dropdown
                function carregarAbaNotif(categoria) {
                    const container = document.getElementById(
                        categoria === 'gestao' ? 'notifContainerGestao' : 'notifContainerPessoal'
                    );
                    if (!container || sinoParado) return;
                    fetch('/notificacoes/lista-dropdown?categoria=' + categoria, { headers: { Accept: 'application/json' } })
                        .then(respostaDoSino)
                        .then(data => {
                            if (data.html) container.innerHTML = data.html;
                            container.dataset.carregado = '1';
                            const badge = document.getElementById(
                                categoria === 'gestao' ? 'notifBadgeGestao' : 'notifBadgePessoal'
                            );
                            if (badge) {
                                badge.textContent   = data.count;
                                badge.style.display = data.count > 0 ? '' : 'none';
                            }
                        })
                        .catch(e => console.log('Dropdown notif:', e));
                }

                // ── Atualiza dropdown ao abrir (aba ativa = Minhas) e total no sino
                const dropToggle = document.getElementById('notificacaoDropdownToggle');
                if (dropToggle) {
                    dropToggle.addEventListener('show.bs.dropdown', function () {
                        carregarAbaNotif('pessoal');
                        atualizarNotificacoes();
                    });
                }

                // ── Troca de aba carrega a categoria correspondente (Gestão é preguiçosa)
                document.querySelectorAll('.notif-tabs [data-categoria]').forEach(function (btn) {
                    btn.addEventListener('shown.bs.tab', function () {
                        carregarAbaNotif(btn.dataset.categoria);
                    });
                });

                // ── Tooltip automático em células de tabela truncadas
                // Mostra o conteúdo completo ao passar o mouse, mas só quando a
                // célula está de fato cortada. Usa delegação para cobrir todas as
                // tabelas (inclusive linhas carregadas dinamicamente) sem editar
                // cada template.
                (function () {
                    function estaTruncado(el) {
                        return el.scrollWidth > el.clientWidth + 1;
                    }

                    document.addEventListener('mouseover', function (ev) {
                        var celula = ev.target.closest('table td, table th');
                        if (!celula) return;

                        // O corte pode estar num filho (span.text-truncate) ou na própria célula.
                        var alvo = ev.target.closest('.text-truncate, .text-nowrap');
                        if (!alvo || !celula.contains(alvo)) alvo = celula;

                        // Não interferir em quem já tem tooltip próprio.
                        if (alvo.closest('[data-bs-toggle="tooltip"], [data-bs-original-title]')) return;
                        if (bootstrap.Tooltip.getInstance(alvo)) return;

                        if (!estaTruncado(alvo)) return;

                        var texto = (alvo.textContent || '').trim();
                        if (!texto) return;

                        var tip = new bootstrap.Tooltip(alvo, {
                            title: texto,
                            trigger: 'hover',
                            placement: 'top',
                            container: 'body'
                        });
                        tip.show();
                    });
                })();
            });
        </script>
