{#
    Modais do menu do usuário (desenhos "03 - EXPEDIENTE" e "07 - Meu Perfil", VS 18.10.26, e
    bj-contas.js / bj-idioma.js / bj-recursos.js). Comportamento em public/js/menu-usuario.js.
      - Conta do escritório: "Abrir conta" só para o primário (ou o Master); "Trocar conta" para todos,
        carregada sob demanda de escritorio_contas.
      - Idioma: só o seletor por enquanto (decisão do dono, 19/10/2026); só o Português está ativo.
      - Em preparação: itens do Master ainda sem tela (decisão do dono, 19/10/2026).
    Recebe do base: `_ehPrimario`, `_ehMaster`.
#}
<div class="modal fade mu-modal" id="modalContaEscritorio" tabindex="-1" aria-labelledby="modalContaEscritorioTitulo" aria-hidden="true"
     data-url-contas="{{ path('escritorio_contas') }}" data-url-equipe="{{ path('escritorio_equipe') }}">
    <div class="modal-dialog modal-dialog-centered mu-modal-largo">
        <div class="modal-content">
            <div class="mu-modal-topo">
                <b id="modalContaEscritorioTitulo">{{ 'menu.usuario.conta.titulo'|trans }}</b>
                <button type="button" class="mu-modal-x" data-bs-dismiss="modal" aria-label="{{ 'menu.usuario.modal.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="mu-abas" role="tablist">
                {% if current_tenant() and (_ehPrimario or _ehMaster) %}
                    <button type="button" class="mu-aba" data-mu-aba="conta" role="tab" aria-controls="muPainelConta" aria-selected="false">{{ 'menu.usuario.conta.aba_minha_conta'|trans }}</button>
                {% endif %}
                {% if _ehPrimario or _ehMaster %}
                    <button type="button" class="mu-aba" data-mu-aba="nova" role="tab" aria-controls="muPainelNova" aria-selected="false">{{ 'menu.usuario.conta.aba_abrir_conta'|trans }}</button>
                {% endif %}
                <button type="button" class="mu-aba" data-mu-aba="trocar" role="tab" aria-controls="muPainelTrocar" aria-selected="false">{{ 'menu.usuario.conta.aba_trocar_conta'|trans }}</button>
            </div>
            <div class="mu-modal-corpo">
                {% if current_tenant() and (_ehPrimario or _ehMaster) %}
                    <div data-mu-painel="conta" id="muPainelConta" role="tabpanel" hidden>
                        <div class="mu-carregando">{{ 'menu.usuario.conta.carregando'|trans }}</div>
                    </div>
                {% endif %}
                {% if _ehPrimario or _ehMaster %}
                    <div data-mu-painel="nova" id="muPainelNova" role="tabpanel" hidden>
                        <p class="mu-texto">{{ 'menu.usuario.conta.nova_texto_antes'|trans }} <b>{{ 'menu.usuario.conta.nova_texto_destaque'|trans }}</b> {{ 'menu.usuario.conta.nova_texto_depois'|trans }}</p>
                        <div class="mu-acoes"><a href="{{ path('escritorio_criar') }}" class="mu-btn mu-btn-pri"><i class="bi bi-plus-circle"></i>{{ 'menu.usuario.conta.botao_abrir_conta'|trans }}</a></div>
                    </div>
                {% endif %}
                <div data-mu-painel="trocar" id="muPainelTrocar" role="tabpanel" hidden>
                    <div class="mu-carregando">{{ 'menu.usuario.conta.carregando'|trans }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade mu-modal" id="modalIdioma" tabindex="-1" aria-labelledby="modalIdiomaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mu-modal-medio">
        <div class="modal-content">
            <div class="mu-modal-topo">
                <b id="modalIdiomaTitulo">{{ 'menu.usuario.idioma.titulo'|trans }}</b>
                <button type="button" class="mu-modal-x" data-bs-dismiss="modal" aria-label="{{ 'menu.usuario.modal.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            </div>
            {# A lista e o liberado vêm do enum Idioma (spec idioma-do-sistema, entrega 1); o clique num idioma liberado
               grava no perfil (POST /perfil/idioma, menu-usuario.js) e recarrega. #}
            {% set idiomaAtual = idioma_atual() %}
            <div class="mu-idiomas">
                {% for idioma in idiomas() %}
                    {% set eAtual = idioma == idiomaAtual %}
                    <button type="button" class="mu-idioma{{ eAtual ? ' atual' : '' }}" {{ idioma.ativo ? '' : 'disabled' }} lang="{{ idioma.value }}" data-mu-idioma-escolher="{{ idioma.value }}">
                        <span class="mu-idioma-sigla">{{ idioma.sigla }}</span>
                        <span class="mu-idioma-nome">{{ idioma.nome }}</span>
                        {% if eAtual %}<i class="bi bi-check-lg"></i>{% elseif not idioma.ativo %}<span class="mu-idioma-breve">{{ 'menu.usuario.idioma.em_breve'|trans }}</span>{% endif %}
                    </button>
                {% endfor %}
            </div>
            <div class="mu-nota mu-nota-modal">{{ 'menu.usuario.idioma.regra'|trans }}</div>
        </div>
    </div>
</div>

<div class="modal fade mu-modal" id="modalEmPreparacao" tabindex="-1" aria-labelledby="modalEmPreparacaoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mu-modal-medio">
        <div class="modal-content mu-preparacao">
            <button type="button" class="mu-modal-x mu-modal-x-claro" data-bs-dismiss="modal" aria-label="{{ 'menu.usuario.modal.fechar'|trans }}"><i class="bi bi-x-lg"></i></button>
            <span class="mu-preparacao-icone"><i class="bi bi-tools"></i></span>
            <b class="mu-preparacao-titulo" id="modalEmPreparacaoTitulo"><span data-mu-preparacao-nome></span> {{ 'menu.usuario.preparacao.titulo_sufixo'|trans }}</b>
            <p class="mu-texto">{{ 'menu.usuario.preparacao.texto'|trans }}</p>
        </div>
    </div>
</div>

<div class="mu-aviso" id="muAviso" role="status" aria-live="polite" hidden></div>

{% include 'indicacao/_janela.html.twig' %}
