{#
    Itens "Exclusivo do Master" (desenhos "03 - EXPEDIENTE" e "07 - Meu Perfil", VS 18.10.26).
    Usado no menu do usuário e na aba "Master" do Meu Perfil; quem inclui já conferiu ROLE_SUPER_ADMIN.
    As âncoras abrem a seção certa do Painel do Master (public/js/master/painel.js lê #aba e #sec).
    Central de vagas abre o Trabalho Externo na aba de vagas (#mod=vagas, que o trabalho-externo.js lê), como no
    desenho; até ter tela ela abria "em preparação" (decisão do dono, 19/10/2026). Campanha por e-mail abre o modal
    da campanha no Trabalho Externo (#camp=1, desenho 06 l.1078).
    Variáveis: `classe_item` (classe do <a>/<button> de cada linha) e `papel` (role ARIA, opcional).
#}
{% set _painel = path('master_painel') %}
{% set _itensMaster = [
    {icone: 'bi-shield-check',  titulo: 'menu.usuario.master.painel.titulo'|trans, sub: 'menu.usuario.master.painel.sub'|trans, href: _painel ~ '#aba=painel&sec=visao'},
    {icone: 'bi-buildings',     titulo: 'menu.usuario.master.contas.titulo'|trans, sub: 'menu.usuario.master.contas.sub'|trans, href: _painel ~ '#aba=painel&sec=contas'},
    {icone: 'bi-hdd-stack',     titulo: 'menu.usuario.master.armazenamento.titulo'|trans, sub: 'menu.usuario.master.armazenamento.sub'|trans, href: _painel ~ '#aba=painel&sec=arm'},
    {icone: 'bi-journal-check', titulo: 'menu.usuario.master.auditoria.titulo'|trans, sub: 'menu.usuario.master.auditoria.sub'|trans, href: _painel ~ '#aba=painel&sec=audit'},
    {icone: 'bi-key',           titulo: 'menu.usuario.master.permissoes.titulo'|trans, sub: 'menu.usuario.master.permissoes.sub'|trans, href: _painel ~ '#aba=perm'},
    {icone: 'bi-briefcase',     titulo: 'menu.usuario.master.vagas.titulo'|trans, sub: 'menu.usuario.master.vagas.sub'|trans, href: path('trabalho_externo_index') ~ '#mod=vagas'},
    {icone: 'bi-send',          titulo: 'menu.usuario.master.campanha.titulo'|trans, sub: 'menu.usuario.master.campanha.sub'|trans, href: path('trabalho_externo_index') ~ '#camp=1'},
    {icone: 'bi-sliders',       titulo: 'menu.usuario.master.configuracoes.titulo'|trans, sub: 'menu.usuario.master.configuracoes.sub'|trans, href: _painel ~ '#aba=painel&sec=config'},
] %}
{% for item in _itensMaster %}
    {% if item.href %}
        <a href="{{ item.href }}" class="{{ classe_item }}"{% if papel is defined %} role="{{ papel }}"{% endif %} data-item-master>
    {% else %}
        <button type="button" class="{{ classe_item }}"{% if papel is defined %} role="{{ papel }}"{% endif %} data-item-master data-em-preparacao="{{ item.titulo }}">
    {% endif %}
        <i class="bi {{ item.icone }}"></i>
        <span class="mu-item-texto">
            <span class="mu-item-titulo">{{ item.titulo }}</span>
            <span class="mu-item-sub">{{ item.sub }}</span>
        </span>
    {% if item.href %}</a>{% else %}</button>{% endif %}
{% endfor %}
