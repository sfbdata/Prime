{#
    Aba "Trocar conta" do modal "Conta do escritório" (desenho bj-contas.js, VS 18.10.26).
    Carregada por GET escritorio_contas. Cada conta troca por POST em tenant_selecionar.
    "Sair deste escritório" continua aqui (vinha do seletor de escritórios do cabeçalho):
    o titular não vê o botão (D4) e o RemoverColaboradorDoEscritorioUseCase recusa mesmo assim.
    Variável: contas (MinhaContaOutput[]).
#}
<div class="mu-contas">
    {% for conta in contas %}
        <form method="post" action="{{ path('tenant_selecionar') }}" class="m-0">
            <input type="hidden" name="tenant_id" value="{{ conta.id }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('tenant_selecionar') }}">
            <button type="submit" class="mu-conta{{ conta.atual ? ' atual' : '' }}" {{ conta.atual ? 'disabled' : '' }}>
                <i class="bi bi-building"></i>
                <span class="mu-conta-texto">
                    <b>{{ conta.nome }}</b>
                    <span>{{ 'menu.usuario.trocar_conta.usuarios'|trans({n: conta.usuarios}) }}{% if conta.primarioNome %} · {{ 'menu.usuario.trocar_conta.primario'|trans({nome: conta.primarioNome}) }}{% endif %}</span>
                </span>
                {% if conta.atual %}<span class="mu-conta-atual">{{ 'menu.usuario.trocar_conta.atual'|trans }}</span>{% endif %}
            </button>
        </form>
    {% else %}
        <div class="mu-nota">{{ 'menu.usuario.trocar_conta.vazio'|trans }}</div>
    {% endfor %}
    <div class="mu-nota">{{ 'menu.usuario.trocar_conta.nota'|trans }}</div>

    {% for conta in contas|filter(c => c.atual and not c.souTitular) %}
        <form method="post" action="{{ path('escritorio_sair', {id: conta.id}) }}" class="m-0 mu-sair-conta"
              data-confirmar="{{ 'menu.usuario.trocar_conta.sair_confirmar'|trans({nome: conta.nome}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sair_' ~ conta.id) }}">
            <button type="submit" class="btn btn-link text-danger p-0"><i class="bi bi-box-arrow-left me-1"></i>{{ 'menu.usuario.trocar_conta.sair'|trans }}</button>
        </form>
    {% endfor %}
</div>
