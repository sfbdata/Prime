# Valores PADRÃO de desenvolvimento, versionados (convenção do Symfony).
#
# 🔴 Este arquivo é público no repositório: NUNCA coloque credencial real aqui.
#    Segredo de desenvolvimento → app/.env.local (ignorado pelo git; sobrescreve este arquivo).
#    Segredo de produção        → .env.prod na VPS (o build de produção apaga este arquivo).
# A guarda de segredos do pre-commit e do CI (scripts/git-hooks/verificar-segredos.py) recusa
# credencial nova em arquivo versionado.

###> symfony/framework-bundle ###
APP_ENV=dev
# Vazio de propósito: dev usa o APP_SECRET de app/.env.dev, teste o de app/.env.test e
# produção o do .env.prod. Nenhum ambiente real deve depender de um valor deste arquivo.
APP_SECRET=
APP_DEBUG=1
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Banco do container de DEV (docker-compose.yml). Usuário e senha são o valor padrão público que
# o próprio compose usa quando POSTGRES_USER e POSTGRES_PASSWORD não estão definidas — não é
# credencial real.
# A suíte também deriva daqui o banco de teste (saas → saas_test).
DATABASE_URL="pgsql://symfony:symfony@db:5432/saas"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# null:// descarta todo e-mail: em dev nada sai para caixa de ninguém. Para testar envio de
# verdade, defina MAILER_DSN em app/.env.local (de preferência um capturador local, nunca a
# conta de produção).
MAILER_DSN=null://null
MAILER_FROM="BlueJus <nao-responda@bluejus.com.br>"
# Opcional e de propósito AUSENTE aqui: sem ela o cabeçalho Reply-To é omitido (ver
# App\Shared\Email\IdentidadeDeEmail e IdentidadeDeEmailContainerTest, que prova a ausência).
# MAILER_REPLY_TO=
###< symfony/mailer ###

###> comercial ###
# Comercial e e-mails (docs/specs/comercial-e-emails.md §3.6 e §3.8). Os defaults moram em config/services.yaml
# (o build de produção apaga este arquivo); descomente só para trocar. Cota da caixa: Hostinger Business
# Standard/Premium, 3.000 por caixa em 24 h corridas. O teto conta tudo o que saiu nas últimas 24 h (inclusive os
# e-mails síncronos); o aviso do Master acende no percentual do teto.
# COMERCIAL_ENVIOS_POR_MINUTO=10
# COMERCIAL_TETO_DIARIO=2400
# COMERCIAL_AVISO_DA_COTA_PERCENTUAL=80
# Rastreio de abertura e clique: só liga com a Política de Privacidade citando o rastreio
# (PoliticaPrivacidadeVigente::CITA_RASTREIO_DE_EMAIL); sem a constante, a flag é ignorada.
# COMERCIAL_RASTREIO_LIGADO=false
# Campanhas (§8.1.2 e §8.5): a chave da instalação nasce desligada (0 recusa o "Enviar campanha" e, no worker, cancela
# as campanhas ativas; trocar exige reiniciar o worker). Teto só das campanhas em 24 h corridas; a reserva dos demais
# e-mails é a diferença para o teto total (2.400 - 1.600 = 800), e a campanha nunca a toma.
# COMERCIAL_CAMPANHAS_LIGADAS=0
# COMERCIAL_TETO_DIARIO_CAMPANHAS=1600
###< comercial ###

###> datajud ###
