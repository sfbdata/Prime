# Valores PADRÃO de desenvolvimento, versionados (convenção do Symfony).
#
# 🔴 Este arquivo é público no repositório: NUNCA coloque credencial real aqui.
#    Segredo de desenvolvimento → app/.env.local (ignorado pelo git; sobrescreve este arquivo).
#    Segredo de produção        → .env.prod na VPS (o build de produção apaga este arquivo).
# A guarda de segredos do pre-commit e do CI (scripts/git-hooks/verificar-segredos.py) recusa
# credencial nova em arquivo versionado.

###> symfony/framework-bundle ###
APP_ENV=dev
# Vazio de propósito: dev usa o APP_SECRET de app/.env.dev, teste o de app/.env.test e
# produção o do .env.prod. Nenhum ambiente real deve depender de um valor deste arquivo.
APP_SECRET=
APP_DEBUG=1
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Banco do container de DEV (docker-compose.yml). Usuário e senha são o valor padrão público que
# o próprio compose usa quando POSTGRES_USER e POSTGRES_PASSWORD não estão definidas — não é
# credencial real.
# A suíte também deriva daqui o banco de teste (saas → saas_test).
DATABASE_URL="pgsql://symfony:symfony@db:5432/saas"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# null:// descarta todo e-mail: em dev nada sai para caixa de ninguém. Para testar envio de
# verdade, defina MAILER_DSN em app/.env.local (de preferência um capturador local, nunca a
# conta de produção).
MAILER_DSN=null://null
MAILER_FROM="BlueJus <nao-responda@bluejus.com.br>"
# Opcional e de propósito AUSENTE aqui: sem ela o cabeçalho Reply-To é omitido (ver
# App\Shared\Email\IdentidadeDeEmail e IdentidadeDeEmailContainerTest, que prova a ausência).
# MAILER_REPLY_TO=
###< symfony/mailer ###

###> datajud ###
# Chave PÚBLICA da API do DataJud, divulgada pelo próprio CNJ na documentação oficial
# (https://datajud-wiki.cnj.jus.br/api-publica/acesso). Não é segredo; o CNJ pode trocá-la.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
###< datajud ###

###> djen ###
# API pública do DJEN (Diário de Justiça Eletrônico Nacional / CNJ) — consulta sem chave/token.
DJEN_BASE_URL=https://comunicaapi.pje.jus.br
###< djen ###

###> contribua/pagarme ###
# Assinatura de espaço pelo Pagar.me (adaptador App\Contribua\Gateway\Pagarme). Vazias aqui: o dono
# preenche no .env.local (dev) e na env do container (prod). O webhook não tem segredo: vem assinado em
# RSA com as chaves públicas do Pagar.me. Onde pegar: docs/specs/contribua-cartao-pagarme.md.
CONTRIBUA_PAGARME_SECRET_KEY=
CONTRIBUA_PAGARME_PUBLIC_KEY=
###< contribua/pagarme ###

###> suporte ###
# Formulário externo de atendimento, aberto pelo botão flutuante da tela de entrada (quem não
# consegue logar não alcança o ServiceDesk interno). Enquanto vazio, o botão fica na tela porém
# inerte. Defina em .env.local (dev) e na env do container (prod) — o build de prod apaga o .env.
SUPORTE_FORM_URL=
###< suporte ###

###> symfony/messenger ###
# O DEFAULT (doctrine://default?auto_setup=1) mora no parâmetro `messenger_transport_dsn_padrao`
# em config/packages/messenger.yaml — NÃO aqui. Motivo: o build de produção faz `rm .env`, então
# default nenhum deste arquivo chega em prod. Só defina a env abaixo para usar OUTRO transport.
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
###< symfony/messenger ###
