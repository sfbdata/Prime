# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_ENV=test
APP_SECRET='$ecretf0rt3st'
MAILER_DSN=null://null
# Shared Drive fictício usado pelos testes do motor de reconciliação (ReconciliarCommandTest).
GOOGLE_DRIVE_SHARED_DRIVE_ID=ROOT
# Chave de cifra (base64 de 32 bytes) só para os testes do sync — não é segredo de prod.
SYNC_CRYPTO_KEY=xPdoH8AXaeIJ0M0cWASp9JlffTg4B4tcNFajzAcA+5I=

# Assinatura de documentos (etapa 2): valor fixo só para os testes (mínimo de 32 bytes).
ASSINATURA_SEGREDO=segredo-fixo-dos-testes-da-assinatura-eletronica-0123456789
# Chave fixa da selfie da assinatura Reforçada, só para os testes (64 hexadecimais).
ASSINATURA_SELFIE_CHAVE=7465737465732d73656c6669652d626c75656a75732d6e616f2d70726f647563 # segredo:permitido (chave fictícia, só dos testes)
# Código de validação do selo da Assinatura (etapa 3): valor fixo só para os testes (mínimo de 32 bytes).
ASSINATURA_SELO_SEGREDO=selo-fixo-dos-testes-da-assinatura-etapa-3-0001 # segredo:permitido (valor fictício, só dos testes)

# Validador de PDF da Assinatura (etapa 6): vazios = não configurado; a suíte não fala com o contêiner.
ASSINATURA_VALIDADOR_URL=
ASSINATURA_VALIDADOR_TOKEN=
